/site/

# Copied in before packing for npm (scripts/prepack.mjs)
packages/*/LICENSE
packages/*/NOTICE
packages/cli/studio/
packages/cli/theme-lab/
# TanStack Router's own scratch files, made beside whatever it is run in.
.tanstack/
