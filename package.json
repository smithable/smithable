{
  "name": "smithable-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/embed.mjs && tsc -b && pnpm --filter @smithable/studio build",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "check": "pnpm lint && pnpm build && pnpm test && pnpm test:apps && pnpm test:studio",
    "schema": "pnpm build && node scripts/write-schema.mjs",
    "embed": "node scripts/embed.mjs",
    "test:apps": "node scripts/test-apps.mjs",
    "test:studio": "node scripts/test-studio.mjs",
    "test:container": "node scripts/test-container.mjs",
    "test:deploy": "node scripts/test-deploy.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@types/node": "^24.13.6",
    "axe-core": "^4.13.0",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
