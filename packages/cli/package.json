{
  "name": "smithable",
  "version": "0.0.0",
  "description": "The smithable command-line interface.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smithable/smithable.git",
    "directory": "packages/cli"
  },
  "homepage": "https://smithable.ai",
  "type": "module",
  "bin": {
    "smithable": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "LICENSE",
    "NOTICE",
    "studio",
    "theme-lab",
    "README.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@smithable/adapter-tanstack": "workspace:*",
    "@smithable/ai": "workspace:*",
    "@smithable/core": "workspace:*",
    "@smithable/index": "workspace:*",
    "node-html-parser": "^9.0.4"
  },
  "scripts": {
    "prepack": "node ../../scripts/prepack.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
