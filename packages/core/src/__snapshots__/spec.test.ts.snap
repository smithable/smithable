            "kind": "binary",
            "left": {
              "kind": "field",
              "name": "quantity",
            },
            "op": "*",
            "right": {
              "kind": "field",
              "name": "unitPrice",
            },
          },
          "name": "amount",
          "required": false,
          "type": {
            "kind": "scalar",
            "name": "money",
          },
          "unique": false,
        },
      ],
      "name": "InvoiceLine",
    },
  ],
  "navigation": [
    {
      "name": "main",
      "pages": [
        "overview",
        "invoices",
        "clients",
        "invoice-lines",
        "settings",
      ],
    },
  ],
  "pages": [
    {
      "id": "home",
      "pattern": {
        "kind": "landing",
        "sections": [
          {
            "button": "overview",
            "kind": "hero",
            "name": "hero",
          },
          {
            "kind": "features",
            "name": "features",
          },
          {
            "kind": "pricing",
            "name": "pricing",
          },
          {
            "kind": "faq",
            "name": "faq",
          },
          {
            "button": "overview",
            "kind": "callToAction",
            "name": "callToAction",
          },
        ],
      },
      "route": "/",
    },
    {
      "id": "overview",
      "pattern": {
        "items": [
          {
            "field": "total",
            "kind": "stat",
            "measure": "sum",
            "model": "Invoice",
            "name": "outstanding",
            "where": {
              "status": "sent",
            },
          },
          {
            "field": "total",
            "kind": "stat",
            "measure": "sum",
            "model": "Invoice",
            "name": "overdue",
            "where": {
              "status": "overdue",
            },
          },
          {
            "field": "total",
            "kind": "stat",
            "measure": "sum",
            "model": "Invoice",
            "name": "paid",
            "where": {
              "status": "paid",
            },
          },
          {
            "by": "issuedOn",
            "field": "total",
            "kind": "chart",
            "measure": "sum",
            "model": "Invoice",
            "name": "invoiced",
          },
          {
            "kind": "list",
            "limit": 5,
            "model": "Invoice",
            "name": "latest",
          },
        ],
        "kind": "dashboard",
      },
      "route": "/overview",
    },
    {
      "id": "invoices",
      "pattern": {
        "kind": "crud",
        "model": "Invoice",
      },
      "route": "/invoices",
    },
    {
      "id": "clients",
      "pattern": {
        "kind": "crud",
        "model": "Client",
      },
      "route": "/clients",
    },
    {
      "id": "invoice-lines",
      "pattern": {
        "kind": "crud",
        "model": "InvoiceLine",
      },
      "route": "/invoice-lines",
    },
    {
      "id": "settings",
      "pattern": {
        "kind": "settings",
        "model": "BusinessProfile",
      },
      "route": "/settings",
    },
    {
      "id": "welcome",
      "pattern": {
        "kind": "onboarding",
        "model": "BusinessProfile",
        "steps": [
          {
            "fields": [
              "businessName",
              "vatNumber",
            ],
            "name": "business",
          },
          {
            "fields": [
              "iban",
              "paymentTermDays",
            ],
            "name": "payment",
          },
        ],
      },
      "route": "/welcome",
    },
  ],
  "specVersion": "0.1",
}
`;

