{
  "actions": [
    {
      "custom": true,
      "input": [
        {
          "name": "keep",
          "required": true,
          "type": {
            "kind": "relation",
            "many": false,
            "model": "Customer",
          },
          "unique": false,
        },
        {
          "name": "duplicate",
          "required": true,
          "type": {
            "kind": "relation",
            "many": false,
            "model": "Customer",
          },
          "unique": false,
        },
      ],
      "intent": "Merge a duplicate customer record into the one we keep.",
      "name": "mergeCustomers",
      "rules": [
        {
          "text": "All orders of the duplicate move to the kept customer.",
        },
        {
          "text": "Empty fields on the kept customer are filled from the duplicate.",
        },
        {
          "text": "The duplicate is deleted afterwards.",
        },
      ],
    },
  ],
  "app": {
    "currency": "EUR",
    "description": "Lightweight CRM for a small B2B sales team.",
    "name": "Acme CRM",
    "timezone": "Europe/Mariehamn",
  },
  "extensions": {},
  "incoming": [],
  "models": [
    {
      "description": "A company we have a commercial relationship with.",
      "fields": [
        {
          "name": "name",
          "required": true,
          "type": {
            "kind": "scalar",
            "name": "string",
          },
          "unique": false,
        },
        {
          "name": "email",
          "required": false,
          "type": {
            "kind": "scalar",
            "name": "email",
          },
          "unique": true,
        },
        {
          "name": "phone",
          "required": false,
          "type": {
            "kind": "scalar",
            "name": "phone",
          },
          "unique": false,
        },
        {
          "default": "smb",
          "name": "segment",
          "required": true,
          "type": {
            "kind": "choice",
            "values": [
              "smb",
              "enterprise",
              "government",
            ],
          },
          "unique": false,
        },
        {
          "description": "Maximum outstanding balance before new orders are held.",
          "min": 0,
          "name": "creditLimit",
          "required": false,
          "type": {
            "kind": "scalar",
            "name": "money",
          },
          "unique": false,
        },
        {
          "name": "notes",
          "required": false,
          "type": {
            "kind": "scalar",
            "name": "text",
          },
          "unique": false,
        },
        {
          "name": "accountManager",
          "required": false,
          "type": {
            "kind": "relation",
            "many": false,
            "model": "User",
          },
          "unique": false,
        },
        {
          "name": "orders",
          "required": false,
          "type": {
            "kind": "relation",
            "many": true,
            "model": "Order",
          },
          "unique": false,
        },
      ],
      "name": "Customer",
      "ownedBy": "accountManager",
      "trash": true,
    },
    {
      "fields": [
        {
          "name": "number",
          "required": true,
          "type": {
            "kind": "scalar",
            "name": "string",
          },
          "unique": true,
        },
        {
          "name": "customer",
          "required": true,
          "type": {
            "kind": "relation",
            "many": false,
            "model": "Customer",
          },
          "unique": false,
        },
        {
          "default": "draft",
          "name": "status",
          "required": true,
          "type": {
            "kind": "choice",
            "values": [
              "draft",
              "placed",
              "shipped",
              "canceled",
            ],
          },
          "unique": false,
        },
        {
          "name": "total",
          "required": true,
          "type": {
            "kind": "scalar",
            "name": "money",
          },
          "unique": false,
        },
        {
          "default": "standard",
          "name": "shippingMethod",
          "required": true,
          "type": {
            "kind": "choice",
            "values": [
              "standard",
              "express",
            ],
          },
          "unique": false,
        },
        {
          "description": "Standard shipping is free above 100 EUR, otherwise 5 EUR. Express always costs 15 EUR.",
          "examples": [
            {
              "expected": 0,
              "input": {
                "shippingMethod": "standard",
                "total": 150,
              },
            },
            {
              "expected": 5,
              "input": {
                "shippingMethod": "standard",
                "total": 80,
              },
            },
            {
              "expected": 15,
              "input": {
                "shippingMethod": "express",
                "total": 150,
              },
            },
          ],
          "formula": {
            "args": [
              {
                "args": [
                  {
                    "kind": "binary",
                    "left": {
                      "kind": "field",
                      "name": "shippingMethod",
                    },
                    "op": "=",
                    "right": {
                      "kind": "text",
                      "value": "standard",
                    },
                  },
                  {
                    "kind": "binary",
                    "left": {
                      "kind": "field",
                      "name": "total",
                    },
                    "op": ">",
                    "right": {
                      "kind": "number",
                      "value": 100,
                    },
                  },
                ],
                "kind": "call",
                "name": "AND",
              },
              {
                "kind": "number",
                "value": 0,
              },
              {
                "args": [
                  {
                    "kind": "binary",
                    "left": {
                      "kind": "field",
                      "name": "shippingMethod",
                    },
                    "op": "=",
                    "right": {
                      "kind": "text",
                      "value": "express",
                    },
                  },
                  {
                    "kind": "number",
                    "value": 15,
                  },
                  {
                    "kind": "number",
                    "value": 5,
                  },
                ],
                "kind": "call",
                "name": "IF",
              },
            ],
            "kind": "call",
            "name": "IF",
          },
          "name": "shippingCost",
          "required": false,
          "type": {
            "kind": "scalar",
            "name": "money",
          },
          "unique": false,
        },
        {
          "defaultFormula": {
            "args": [],
            "kind": "call",
            "name": "NOW",
          },
          "name": "placedAt",
          "required": false,
          "type": {
            "kind": "scalar",
            "name": "datetime",
          },
          "unique": false,
        },
      ],
      "name": "Order",
      "trash": true,
    },
  ],
  "navigation": [
    {
      "name": "main",
      "pages": [
        "customers",
        "orders",
        "team",
      ],
    },
  ],
  "outgoing": [],
  "pages": [
