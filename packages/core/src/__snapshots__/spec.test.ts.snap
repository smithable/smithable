{
  "actions": [
    {
      "custom": false,
      "input": [],
      "intent": "Take the case: you become its assignee.",
      "name": "assignToMe",
      "on": "SupportCase",
      "set": [
        {
          "field": "assignee",
          "me": true,
        },
      ],
    },
    {
      "custom": false,
      "input": [],
      "intent": "Give the case to an agent, chosen from the team.",
      "name": "assignTo",
      "on": "SupportCase",
      "set": [
        {
          "asked": true,
          "field": "assignee",
        },
      ],
    },
    {
      "asksRequired": [
        "assignee",
      ],
      "custom": false,
      "input": [],
      "intent": "Someone is working on the case now; it needs an assignee.",
      "name": "startWork",
      "on": "SupportCase",
      "set": [
        {
          "field": "status",
          "value": "inProgress",
        },
      ],
      "when": {
        "status": [
          "open",
          "reopened",
        ],
      },
    },
    {
      "asksRequired": [
        "assignee",
      ],
      "custom": false,
      "input": [],
      "intent": "The customer has their answer.",
      "name": "close",
      "on": "SupportCase",
      "set": [
        {
          "field": "status",
          "value": "closed",
        },
      ],
      "when": {
        "status": [
          "open",
          "inProgress",
          "reopened",
        ],
      },
    },
    {
      "custom": false,
      "input": [],
      "intent": "The case needs more work after all.",
      "name": "reopen",
      "on": "SupportCase",
      "set": [
        {
          "field": "status",
          "value": "reopened",
        },
      ],
      "when": {
        "status": "closed",
      },
    },
  ],
  "app": {
    "currency": "EUR",
    "description": "Mail from customers, answered by the team.",
    "name": "Harbour Support",
    "timezone": "Europe/Mariehamn",
  },
  "extensions": {},
  "incoming": [
    {
      "as": "admin",
      "create": "SupportCase",
      "custom": false,
      "mail": {
        "attachments": "attachments",
        "body": "body",
        "from": "customerEmail",
        "subject": "subject",
      },
      "name": "support",
      "reply": {
        "create": "Message",
        "mail": {
          "attachments": "attachments",
          "body": "content",
          "from": "fromEmail",
        },
        "ref": "supportCase",
        "set": [
          {
            "field": "sender",
            "value": "customer",
          },
        ],
        "update": [],
      },
      "set": [
        {
          "field": "status",
          "value": "open",
        },
      ],
    },
  ],
  "models": [
    {
      "fields": [
        {
          "name": "subject",
