            "name": "date",
          },
          "unique": false,
        },
        {
          "name": "dueOn",
          "required": true,
          "type": {
            "kind": "scalar",
            "name": "date",
          },
          "unique": false,
        },
        {
          "default": "draft",
          "name": "status",
          "required": true,
          "type": {
            "kind": "choice",
            "values": [
              "draft",
              "sent",
              "paid",
              "overdue",
            ],
          },
          "unique": false,
        },
      ],
      "name": "Invoice",
      "rules": [
        {
          "text": "Invoice numbers are sequential per user, like 2026-001, 2026-002.",
        },
        {
          "text": "A sent or paid invoice can no longer be edited, only credited.",
        },
      ],
    },
  ],
  "navigation": [
    {
      "name": "main",
