        },
        {
          "defaultFormula": {
            "args": [],
            "kind": "call",
            "name": "TODAY",
          },
          "name": "issuedOn",
          "required": true,
          "type": {
            "kind": "scalar",
            "name": "date",
          },
          "unique": false,
        },
        {
          "defaultFormula": {
            "args": [
              {
                "kind": "field",
                "name": "issuedOn",
              },
              {
                "kind": "number",
                "value": 30,
              },
              {
                "kind": "text",
                "value": "day",
              },
            ],
            "kind": "call",
            "name": "DATEADD",
          },
          "name": "dueOn",
          "required": true,
          "type": {
            "kind": "scalar",
            "name": "date",
          },
          "unique": false,
        },
        {
          "default": "draft",
          "name": "status",
          "required": true,
          "type": {
            "kind": "choice",
            "values": [
              "draft",
              "sent",
              "paid",
              "overdue",
            ],
          },
          "unique": false,
        },
        {
          "name": "contract",
          "required": false,
          "type": {
            "kind": "scalar",
            "name": "file",
          },
          "unique": false,
        },
        {
          "name": "lines",
          "required": false,
          "type": {
            "kind": "relation",
            "many": true,
            "model": "InvoiceLine",
          },
          "unique": false,
        },
        {
          "formula": {
            "field": "amount",
            "kind": "aggregate",
            "list": "lines",
            "name": "SUM",
          },
          "name": "total",
          "required": false,
          "type": {
            "kind": "scalar",
            "name": "money",
          },
          "unique": false,
        },
      ],
      "name": "Invoice",
      "rules": [
        {
          "text": "Invoice numbers are sequential per user, like 2026-001, 2026-002.",
        },
        {
          "text": "A sent or paid invoice can no longer be edited, only credited.",
        },
      ],
    },
    {
      "fields": [
        {
          "name": "invoice",
          "required": true,
          "type": {
            "kind": "relation",
            "many": false,
            "model": "Invoice",
          },
          "unique": false,
        },
        {
          "name": "description",
          "required": true,
          "type": {
            "kind": "scalar",
            "name": "string",
          },
          "unique": false,
        },
        {
          "default": 1,
          "name": "quantity",
          "required": true,
          "type": {
            "kind": "scalar",
            "name": "decimal",
          },
          "unique": false,
        },
        {
          "name": "unitPrice",
          "required": true,
          "type": {
            "kind": "scalar",
            "name": "money",
          },
          "unique": false,
        },
        {
          "examples": [
            {
              "expected": 120,
              "input": {
                "quantity": 3,
                "unitPrice": 40,
              },
            },
            {
              "expected": 10,
              "input": {
                "quantity": 0.5,
                "unitPrice": 19.99,
              },
            },
          ],
          "formula": {
            "kind": "binary",
            "left": {
              "kind": "field",
              "name": "quantity",
            },
            "op": "*",
            "right": {
              "kind": "field",
              "name": "unitPrice",
            },
          },
          "name": "amount",
          "required": false,
          "type": {
            "kind": "scalar",
            "name": "money",
          },
          "unique": false,
        },
      ],
      "name": "InvoiceLine",
    },
  ],
  "navigation": [
    {
      "name": "main",
      "pages": [
        "overview",
        "invoices",
        "clients",
        "invoice-lines",
        "settings",
      ],
    },
  ],
  "outgoing": [
    {
      "name": "invoiceSent",
      "recipient": {
        "kind": "field",
        "path": [
          "client",
          "email",
        ],
        "via": "email",
      },
      "to": "mail",
      "when": {
        "action": "markSent",
        "model": "Invoice",
      },
    },
  ],
  "pages": [
    {
      "id": "home",
      "pattern": {
        "kind": "landing",
        "sections": [
          {
            "button": "overview",
            "kind": "hero",
            "name": "hero",
          },
          {
            "kind": "features",
            "name": "features",
          },
          {
            "kind": "pricing",
            "name": "pricing",
          },
          {
            "kind": "faq",
            "name": "faq",
          },
          {
            "button": "overview",
            "kind": "callToAction",
            "name": "callToAction",
          },
        ],
      },
      "route": "/",
      "sections": [
        {
          "button": "overview",
          "kind": "hero",
          "name": "hero",
        },
        {
          "kind": "features",
          "name": "features",
        },
        {
          "kind": "pricing",
          "name": "pricing",
        },
        {
          "kind": "faq",
          "name": "faq",
        },
        {
          "button": "overview",
          "kind": "callToAction",
          "name": "callToAction",
        },
      ],
    },
    {
      "id": "overview",
      "pattern": {
        "items": [
          {
            "field": "total",
            "kind": "stat",
            "measure": "sum",
            "model": "Invoice",
            "name": "outstanding",
            "where": {
              "status": "sent",
            },
          },
          {
            "field": "total",
            "kind": "stat",
            "measure": "sum",
            "model": "Invoice",
            "name": "overdue",
            "where": {
              "status": "overdue",
            },
          },
          {
            "field": "total",
            "kind": "stat",
            "measure": "sum",
            "model": "Invoice",
            "name": "paid",
            "where": {
              "status": "paid",
            },
          },
          {
            "by": "issuedOn",
            "field": "total",
            "kind": "chart",
            "measure": "sum",
            "model": "Invoice",
            "name": "invoiced",
          },
          {
            "kind": "list",
            "limit": 5,
            "model": "Invoice",
            "name": "latest",
          },
        ],
        "kind": "dashboard",
      },
      "route": "/overview",
      "sections": [
        {
          "kind": "tiles",
          "name": "dashboard",
          "own": true,
        },
      ],
    },
    {
      "actions": [
        "markSent",
        "markPaid",
      ],
      "filters": [
        "client",
        "status",
      ],
      "id": "invoices",
      "pattern": {
        "kind": "crud",
        "model": "Invoice",
      },
      "route": "/invoices",
      "sections": [
        {
          "kind": "crud",
          "model": "Invoice",
          "name": "crud",
          "own": true,
        },
      ],
    },
    {
      "id": "clients",
      "pattern": {
        "kind": "crud",
        "model": "Client",
      },
      "route": "/clients",
      "sections": [
        {
          "kind": "crud",
          "model": "Client",
          "name": "crud",
          "own": true,
        },
      ],
    },
    {
      "id": "invoice-lines",
      "pattern": {
        "kind": "crud",
        "model": "InvoiceLine",
      },
      "route": "/invoice-lines",
      "sections": [
        {
          "kind": "crud",
          "model": "InvoiceLine",
          "name": "crud",
          "own": true,
        },
      ],
    },
    {
      "id": "settings",
      "pattern": {
        "kind": "settings",
        "model": "BusinessProfile",
      },
      "route": "/settings",
      "sections": [
        {
          "kind": "settings",
          "model": "BusinessProfile",
          "name": "settings",
          "own": true,
        },
      ],
    },
    {
      "id": "welcome",
      "pattern": {
        "kind": "onboarding",
        "model": "BusinessProfile",
        "steps": [
          {
            "fields": [
              "businessName",
              "vatNumber",
            ],
            "name": "business",
          },
          {
            "fields": [
              "iban",
              "paymentTermDays",
            ],
            "name": "payment",
          },
        ],
      },
      "route": "/welcome",
      "sections": [
        {
          "kind": "onboarding",
          "model": "BusinessProfile",
          "name": "onboarding",
          "own": true,
        },
      ],
    },
  ],
  "queries": [],
  "specVersion": "0.1",
  "timers": [
    {
      "name": "markOverdue",
      "on": "Invoice",
      "run": "markOverdue",
      "schedule": {
        "kind": "record",
        "offset": {
          "amount": 7,
          "direction": "after",
          "unit": "day",
        },
        "path": [
          "dueOn",
        ],
      },
      "where": {
        "status": "sent",
      },
    },
  ],
}
`;

