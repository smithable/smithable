                    "kind": "binary",
                    "left": {
                      "kind": "field",
                      "name": "shippingMethod",
                    },
                    "op": "=",
                    "right": {
                      "kind": "text",
                      "value": "express",
                    },
                  },
                  {
                    "kind": "number",
                    "value": 15,
                  },
                  {
                    "kind": "number",
                    "value": 5,
                  },
                ],
