{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://docs.smithable.ai/schema/smithable-0.1.json",
  "title": "smithable.yml",
  "description": "Describes what a Smithable application does. See docs/spec.",
  "type": "object",
  "required": [
    "smithable",
    "app"
  ],
  "additionalProperties": false,
  "properties": {
    "smithable": {
      "description": "The spec format version.",
      "enum": [
        0.1,
        "0.1"
      ]
    },
    "app": {
      "type": "object",
      "description": "The application as a whole.",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "The application's name."
        },
        "currency": {
          "type": "string",
          "enum": [
            "AED",
            "AFN",
            "ALL",
            "AMD",
            "ANG",
            "AOA",
            "ARS",
            "AUD",
            "AWG",
            "AZN",
            "BAM",
            "BBD",
            "BDT",
            "BGN",
            "BHD",
            "BIF",
            "BMD",
            "BND",
            "BOB",
            "BRL",
            "BSD",
            "BTN",
            "BWP",
            "BYN",
            "BZD",
            "CAD",
            "CDF",
            "CHF",
            "CLP",
            "CNY",
            "COP",
            "CRC",
            "CUP",
            "CVE",
            "CZK",
            "DJF",
            "DKK",
            "DOP",
            "DZD",
            "EGP",
            "ERN",
            "ETB",
            "EUR",
            "FJD",
            "FKP",
            "GBP",
            "GEL",
            "GHS",
            "GIP",
            "GMD",
            "GNF",
            "GTQ",
            "GYD",
            "HKD",
            "HNL",
            "HTG",
            "HUF",
            "IDR",
            "ILS",
            "INR",
            "IQD",
            "IRR",
            "ISK",
            "JMD",
            "JOD",
            "JPY",
            "KES",
            "KGS",
            "KHR",
            "KMF",
            "KPW",
            "KRW",
            "KWD",
            "KYD",
            "KZT",
            "LAK",
            "LBP",
            "LKR",
            "LRD",
            "LSL",
            "LYD",
            "MAD",
            "MDL",
            "MGA",
            "MKD",
            "MMK",
            "MNT",
            "MOP",
            "MRU",
            "MUR",
            "MVR",
            "MWK",
            "MXN",
            "MYR",
            "MZN",
            "NAD",
            "NGN",
            "NIO",
            "NOK",
            "NPR",
            "NZD",
            "OMR",
            "PAB",
            "PEN",
            "PGK",
            "PHP",
            "PKR",
            "PLN",
            "PYG",
            "QAR",
            "RON",
            "RSD",
            "RUB",
            "RWF",
            "SAR",
            "SBD",
            "SCR",
            "SDG",
            "SEK",
            "SGD",
            "SHP",
            "SLE",
            "SOS",
            "SRD",
            "SSP",
            "STN",
            "SVC",
            "SYP",
            "SZL",
            "THB",
            "TJS",
            "TMT",
            "TND",
            "TOP",
            "TRY",
            "TTD",
            "TWD",
            "TZS",
            "UAH",
            "UGX",
            "USD",
            "UYU",
            "UZS",
            "VED",
            "VES",
            "VND",
            "VUV",
            "WST",
            "XAF",
            "XCD",
            "XCG",
            "XOF",
            "XPF",
            "YER",
            "ZAR",
            "ZMW",
            "ZWG"
          ],
          "description": "ISO 4217 currency code, e.g. EUR."
        },
        "timezone": {
          "type": "string",
          "description": "IANA time zone, e.g. Europe/Mariehamn."
        },
        "description": {
          "type": "string",
          "description": "What this is. Meaning for AI and developers; not shown to visitors."
        },
        "intent": {
          "type": "string",
          "description": "The outcome or experience this should achieve."
        },
        "rules": {
          "type": "array",
          "description": "Domain rules in plain language. A rule does nothing by itself until something implements it.",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "rule"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "A short name to refer to the rule by."
                  },
                  "rule": {
                    "type": "string",
                    "description": "The rule, in plain language."
                  }
                }
              }
            ]
          }
        }
      }
    },
    "models": {
      "type": "object",
      "description": "The data the application stores. Model names are PascalCase.",
      "propertyNames": {
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "fields"
        ],
        "additionalProperties": false,
        "properties": {
          "fields": {
            "type": "object",
            "description": "What a record holds: each field's name and its type.",
            "minProperties": 1,
            "propertyNames": {
              "pattern": "^[a-z][A-Za-z0-9]*$",
              "not": {
                "enum": [
                  "id",
                  "owner",
                  "createdAt",
                  "updatedAt"
                ]
              }
            },
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^\\s*(?:(?:string|text|markdown|int|decimal|money|bool|date|datetime|email|phone|url|picture|pictures|file|files)!?(?:\\s+unique)?(?:\\s*=\\s*\\S.*)?|[A-Z][A-Za-z0-9]*!?(?:\\s+unique)?|[A-Z][A-Za-z0-9]*\\[\\]|[a-z][A-Za-z0-9]*(?:\\s*\\|\\s*[a-z][A-Za-z0-9]*)+)\\s*$",
                  "description": "A type with optional \"!\" (required), \"unique\" and \"= default\", e.g. \"string!\" or \"int! = 60\". Or choices: \"draft | sent | paid\" (the first is the default)."
                },
                {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "type": "string",
                      "pattern": "^\\s*(?:(?:string|text|markdown|int|decimal|money|bool|date|datetime|email|phone|url|picture|pictures|file|files)!?|[A-Z][A-Za-z0-9]*!?|[A-Z][A-Za-z0-9]*\\[\\]|[a-z][A-Za-z0-9]*(?:\\s*\\|\\s*[a-z][A-Za-z0-9]*)+)\\s*$",
                      "description": "What the field holds: a type (string, money, date, …), another model (Customer, or Order[] for all that refer here), or choices (\"draft | sent | paid\")."
                    },
                    "required": {
                      "type": [
                        "boolean",
                        "object"
                      ],
                      "description": "A record cannot be saved without it; or a condition, e.g. { status: [inProgress, closed] }: required while the record fits it.",
                      "additionalProperties": {
                        "oneOf": [
                          {
                            "type": [
                              "string",
                              "boolean"
                            ]
                          },
                          {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        ]
                      }
                    },
                    "by": {
                      "enum": [
                        "app"
                      ],
                      "description": "app: the form never shows it; its default (a value, or ME()), an action, an incoming entry or code fills it."
                    },
                    "locked": {
                      "type": [
                        "boolean",
                        "object"
                      ],
                      "description": "true: set when the record is made, never changed after; or a condition, e.g. { status: closed }: read-only while the record fits it. An action's set may still change it.",
                      "additionalProperties": {
                        "oneOf": [
                          {
                            "type": [
                              "string",
                              "boolean"
                            ]
                          },
                          {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        ]
                      }
                    },
                    "unique": {
                      "type": "boolean",
                      "description": "No two records may hold the same value."
                    },
                    "default": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ],
                      "description": "For choices, \"none\" means no default. ME() on a field that refers to User: who makes the record."
                    },
                    "min": {
                      "type": "number",
                      "description": "The smallest number allowed; for a text, its shortest length."
                    },
                    "max": {
                      "type": "number",
                      "description": "The largest number allowed; for a text, its longest length."
                    },
                    "formula": {
                      "type": "string",
                      "description": "Computes the value, spreadsheet-style, e.g. \"quantity * unitPrice\" or \"SUM(lines.amount)\"."
                    },
                    "examples": {
                      "type": "array",
                      "description": "Inputs and the expected result of the formula; each becomes a test.",
                      "items": {
                        "type": "object",
                        "required": [
                          "input",
                          "expected"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "input": {
                            "type": "object",
                            "description": "The values of the fields the formula reads."
                          },
                          "expected": {
                            "description": "What the formula must give for them."
                          }
                        }
                      }
                    },
                    "description": {
                      "type": "string",
                      "description": "What this is. Meaning for AI and developers; not shown to visitors."
                    },
                    "intent": {
                      "type": "string",
                      "description": "The outcome or experience this should achieve."
                    },
                    "rules": {
                      "type": "array",
                      "description": "Domain rules in plain language. A rule does nothing by itself until something implements it.",
                      "items": {
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "object",
                            "required": [
                              "rule"
                            ],
                            "additionalProperties": false,
                            "properties": {
                              "id": {
                                "type": "string",
                                "description": "A short name to refer to the rule by."
                              },
                              "rule": {
                                "type": "string",
                                "description": "The rule, in plain language."
                              }
                            }
                          }
                        ]
                      }
                    }
                  }
                }
              ]
            }
          },
          "ownedBy": {
            "type": "string",
            "description": "A User field whose user owns the record, instead of its creator."
          },
          "review": {
            "oneOf": [
              {
                "type": "string",
                "enum": [
                  "all"
                ]
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            ],
            "description": "Pictures and files that wait for a reviewer before others see them: all (every picture and file field) or a list of them. A required one holds the whole record until it is approved; an optional one only the file."
          },
          "trash": {
            "type": "boolean",
            "description": "Deleted records stay in a trash for thirty days, where whoever may delete them can restore them; then they are removed for good."
          },
          "capacity": {
            "type": "object",
            "description": "At most max records per record that per refers to, e.g. { per: session, max: session.capacity }: a booking's places.",
            "required": [
              "per",
              "max"
            ],
            "additionalProperties": false,
            "properties": {
              "per": {
                "type": "string",
                "description": "A required reference of this model."
              },
              "max": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "string"
                  }
                ],
                "description": "A whole number, or a whole-number field of the referenced record, \"reference.field\"."
              },
              "where": {
                "type": "object",
                "description": "Only records with these choice or yes/no values count."
              }
            }
          },
          "description": {
            "type": "string",
            "description": "What this is. Meaning for AI and developers; not shown to visitors."
          },
          "intent": {
            "type": "string",
            "description": "The outcome or experience this should achieve."
          },
          "rules": {
            "type": "array",
            "description": "Domain rules in plain language. A rule does nothing by itself until something implements it.",
            "items": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "required": [
                    "rule"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "A short name to refer to the rule by."
                    },
                    "rule": {
                      "type": "string",
                      "description": "The rule, in plain language."
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "actions": {
      "type": "object",
      "description": "Operations of the application beyond create, edit and delete.",
      "propertyNames": {
        "pattern": "^[a-z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "type": "object",
        "description": "Custom (custom: true, with input and output) or standard (on, when, set).",
        "oneOf": [
          {
            "required": [
              "custom"
            ]
          },
          {
            "required": [
              "on"
            ],
            "anyOf": [
              {
                "required": [
                  "set"
                ]
              },
              {
                "required": [
                  "add"
                ]
              },
              {
                "required": [
                  "copy"
                ]
              }
            ]
          }
        ],
        "additionalProperties": false,
        "properties": {
          "custom": {
            "const": true,
            "description": "Implemented in src/custom/actions/."
          },
          "on": {
            "type": "string",
            "description": "A standard action: the model whose record it changes."
          },
          "when": {
            "type": "object",
            "description": "Offered and allowed only for records with these choice values (or lists of them) or yes/no values, e.g. { status: [investigating, identified] }."
          },
          "set": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "pattern": "^[a-z][A-Za-z0-9]*$"
            },
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            },
            "description": "The new values: a literal the field accepts, a formula on the record as it was, or nothing to ask the person for it, e.g. { status: canceled, cancelReason: }."
          },
          "add": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z][A-Za-z0-9]*$"
              },
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              }
            },
            "description": "Related records to create with the change, one per model that refers to this one, e.g. { IncidentUpdate: { status: resolved, at: NOW() } }."
          },
          "copy": {
            "type": [
              "object",
              "null"
            ],
            "propertyNames": {
              "pattern": "^[a-z][A-Za-z0-9]*$"
            },
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            },
            "description": "A new record from this one instead of a change: what differs, as in set (a value, a formula, ME() or nothing to ask); {} copies as is."
          },
          "with": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Lists of the model whose records a copy takes along, e.g. [lines]."
          },
          "input": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z][A-Za-z0-9]*$"
            },
            "additionalProperties": {
              "type": "string",
              "description": "Field shorthand, e.g. \"Customer!\" or \"int\"."
            },
            "description": "The values the action needs."
          },
          "output": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z][A-Za-z0-9]*$"
            },
            "additionalProperties": {
              "type": "string",
              "description": "Field shorthand, e.g. \"Customer!\" or \"int\"."
            },
            "description": "The values the action returns, if any."
          },
          "allow": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Only these roles may run the action (admins always can)."
          },
          "description": {
            "type": "string",
            "description": "What this is. Meaning for AI and developers; not shown to visitors."
          },
          "intent": {
            "type": "string",
            "description": "The outcome or experience this should achieve."
          },
          "rules": {
            "type": "array",
            "description": "Domain rules in plain language. A rule does nothing by itself until something implements it.",
            "items": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "required": [
                    "rule"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "A short name to refer to the rule by."
                    },
                    "rule": {
                      "type": "string",
                      "description": "The rule, in plain language."
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "outgoing": {
      "type": "object",
      "description": "Who is told when something happens to a record: a mail to the owner, a role or an address on the record; or a signed call to a named target.",
      "propertyNames": {
        "pattern": "^[a-z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "when",
          "to"
        ],
        "additionalProperties": false,
        "properties": {
          "when": {
            "type": "string",
            "description": "What happens: \"<Model> created\", \"<Model> changed\" or \"<Model> deleted\", or the name of a standard action, e.g. \"Booking created\" or \"resolve\"."
          },
          "where": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z][A-Za-z0-9]*$"
            },
            "additionalProperties": {
              "type": [
                "string",
                "boolean",
                "array"
              ],
              "items": {
                "type": "string"
              }
            },
            "description": "Only for records with these values, e.g. { status: confirmed }; a change counts when the record comes to fit them."
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9]*$",
            "description": "\"mail\", or the name of a target whose address and secret are settings."
          },
          "recipient": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9]*(?:\\.[a-z][A-Za-z0-9]*)?$",
            "description": "For mail: owner, a role, an email field or a field that refers to User, or one reference away (customer.email)."
          }
        }
      }
    },
    "incoming": {
      "type": "object",
      "description": "Addresses other services call (/incoming/<name>, each with its own secret): one record per call, or the call handed to code.",
      "propertyNames": {
        "pattern": "^[a-z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "create": {
            "type": "string",
            "description": "The model a call adds a record of."
          },
          "set": {
            "type": "object",
            "description": "The record's values: a literal, a formula (NOW()), or a text with {path} from the call's JSON (\"{check.name} is down\").",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "custom": {
            "const": true,
            "description": "Hand the verified call to src/custom/incoming/<name>.ts."
          },
          "signed": {
            "const": "sha256",
            "description": "A sha256 signature of the body, made with the secret."
          },
          "header": {
            "type": "string",
            "description": "The header the secret or signature comes in."
          },
          "id": {
            "type": "string",
            "description": "The call's own id, e.g. \"{event.id}\": a repeat is not acted on."
          },
          "as": {
            "type": "string",
            "description": "The role the call acts as (admin when not said)."
          },
          "mail": {
            "const": true,
            "description": "The call's body is a mail (from, to, subject, text, html, attachments)."
          },
          "fields": {
            "type": "object",
            "description": "For a mail: the fields its parts go to.",
            "additionalProperties": false,
            "properties": {
              "from": {
                "type": "string",
                "description": "An email field for the sender."
              },
              "subject": {
                "type": "string",
                "description": "A text field for the subject."
              },
              "body": {
                "type": "string",
                "description": "A text or markdown field for the mail's text."
              },
              "attachments": {
                "type": "string",
                "description": "A file or files field for its attachments."
              }
            }
          }
        }
      }
    },
    "queries": {
      "type": "object",
      "description": "Records chosen or ordered by code in src/custom/queries/.",
      "propertyNames": {
        "pattern": "^[a-z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "custom",
          "returns"
        ],
        "additionalProperties": false,
        "properties": {
          "custom": {
            "const": true,
            "description": "Implemented in src/custom/queries/."
          },
          "returns": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]*\\[\\]$",
            "description": "The records it returns, e.g. \"Customer[]\"."
          },
          "description": {
            "type": "string",
            "description": "What this is. Meaning for AI and developers; not shown to visitors."
          },
          "intent": {
            "type": "string",
            "description": "The outcome or experience this should achieve."
          },
          "rules": {
            "type": "array",
            "description": "Domain rules in plain language. A rule does nothing by itself until something implements it.",
            "items": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "required": [
                    "rule"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "A short name to refer to the rule by."
                    },
                    "rule": {
                      "type": "string",
                      "description": "The rule, in plain language."
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "pages": {
      "type": "object",
      "description": "The application's pages. Each page uses one pattern: crud, landing, dashboard, settings, onboarding, users, data, review, calendar, calculator, articles, custom or legal.",
      "propertyNames": {
        "pattern": "^[a-z][A-Za-z0-9]*(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "oneOf": [
          {
            "required": [
              "crud"
            ]
          },
          {
            "required": [
              "landing"
            ]
          },
          {
            "required": [
              "dashboard"
            ]
          },
          {
            "required": [
              "settings"
            ]
          },
          {
            "required": [
              "onboarding"
            ]
          },
          {
            "required": [
              "users"
            ]
          },
          {
            "required": [
              "data"
