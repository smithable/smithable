"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { z } from "zod";
import type * as schema from "#/db/schema";
import { allows, type Rule } from "#/kit/access";
import type { RecordUi } from "#/kit/model";
import { clientAccess, clientData } from "./client.server";
import { invoiceAccess } from "./invoice.server";
import { writeAllowed } from "#/kit/limit";
import { currentViewer } from "#/lib/viewer.server";
import { clientSchema } from "./client.schema";

export type { ClientSettable, ClientValues } from "./client.schema";

/** The viewer about to write, counted against how often one may (see src/kit/limit.ts). */
async function writer() {
  const viewer = await currentViewer();
  writeAllowed(viewer, getRequestHeaders());
  return viewer;
}

/** Client records as the kit reads them. */
export type ClientRow = typeof schema.clients.$inferSelect;

export const clientUi: RecordUi<ClientRow> = {
  model: "Client",
  label: "Client",
  pluralLabel: "Clients",
  titleField: "name",
  columns: ["name", "email", "vatNumber"],
  fields: [
    {
      name: "name",
      label: "Name",
      kind: "string",
      required: true,
      get: (row) => row.name,
    },
    {
      name: "email",
      label: "Email",
      kind: "email",
      required: true,
      get: (row) => row.email,
    },
    {
      name: "address",
      label: "Address",
      kind: "text",
      required: false,
      get: (row) => row.address,
    },
    {
      name: "vatNumber",
      label: "Vat number",
      kind: "string",
      required: false,
      get: (row) => row.vatNumber,
    },
  ],
};

/** Who may delete clients: a list's selection offers Delete by it (the server checks again). */
export const clientDeleteRule: Rule = { public: false, roles: ["admin"], owner: true };


export const listClients = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return { rows: await clientData.list(viewer), canCreate: allows(clientAccess.create, viewer) };
});

export const getClient = createServerFn()
  .validator(z.number().int())
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    const row = await clientData.get(viewer, id);
    if (!row) return null;
    return {
      row,
      canWrite: allows(clientAccess.write, viewer, row.ownerId),
      canDelete: allows(clientAccess.delete, viewer, row.ownerId),
      // Who may add to its related lists from here ("Add line" on an invoice).
      canAdd: { invoices: allows(invoiceAccess.create, viewer) },
    };
  });

/** Choices for fields that refer to a client. */
export const clientOptions = createServerFn().handler(async () =>
  clientData.options(await currentViewer()),
);

export const createClient = createServerFn({ method: "POST" })
  .validator(clientSchema)
  .handler(async ({ data }) => clientData.create(await writer(), data));

export const updateClient = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), values: clientSchema }))
  .handler(async ({ data }) => clientData.update(await writer(), data.id, data.values));

/** Deletes a client; \`together\` takes what points to it along (docs/design/delete-together.md). */
export const deleteClient = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), together: z.boolean().optional() }))
  .handler(async ({ data }) => clientData.remove(await writer(), data.id, data.together));

/** Deletes the chosen clients, all or none (at most 1,000 at once). */
export const deleteClients = createServerFn({ method: "POST" })
  .validator(z.object({ ids: z.array(z.number().int()).max(1000), together: z.boolean().optional() }))
  .handler(async ({ data }) => clientData.removeMany(await writer(), data.ids, data.together));
"
`;

