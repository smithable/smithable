"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { and, count, eq, isNull, sql, type SQL } from "drizzle-orm";
import { db } from "#/db";
import { messages } from "#/db/schema";
import { AccessDenied, check, type ModelAccess, readScope, refusal, type Viewer } from "#/kit/access";
import { afterChange, afterDelete } from "./hooks";
import type { MessageValues } from "./message";

/** Who may read, create, change and delete messages. */
export const messageAccess: ModelAccess = {
  read: { public: false, roles: ["admin"], owner: false },
  create: { public: true, roles: ["admin", "member"], owner: false },
  write: { public: false, roles: ["admin"], owner: false },
  delete: { public: false, roles: ["admin"], owner: false },
};

export const messageData = {
  /** A condition for the messages the viewer may read. */
  readable(viewer: Viewer | null) {
    const scope = readScope(messageAccess.read, viewer);
    if (scope === "all") return undefined;
    return scope === "own" && viewer ? eq(messages.ownerId, viewer.id) : sql\`false\`;
  },

  canRead(viewer: Viewer | null, id: number): boolean {
    const found = db
      .select({ id: messages.id })
      .from(messages)
      .where(and(eq(messages.id, id), messageData.readable(viewer)))
      .get();
    return found !== undefined;
  },

  /** The messages the viewer may read; \`where\` narrows them, e.g. to a search; \`limit\` keeps the newest (a data page). */
  async list(viewer: Viewer | null, where?: SQL, limit?: number) {
    if (readScope(messageAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const rows = await db.query.messages.findMany({
      where: and(messageData.readable(viewer), where),
      orderBy: (t, { desc }) => [desc(t.id)],
      limit,
    });
    return rows;
  },

  /** How many messages the viewer may read, for a data page's overview; none to read: null. */
  count(viewer: Viewer | null): number | null {
    if (readScope(messageAccess.read, viewer) === "none") return null;
    return db.select({ n: count() }).from(messages).where(messageData.readable(viewer)).get()?.n ?? 0;
  },

  async get(viewer: Viewer | null, id: number) {
    const row = await db.query.messages.findFirst({
      where: and(eq(messages.id, id), messageData.readable(viewer)),
    });
    return row ? row : null;
  },

  async create(viewer: Viewer | null, values: MessageValues) {
    check(messageAccess.create, viewer);
    // Visitors add these without an account: at most 10,000 of theirs, so a flood stops here.
    const made = db.select({ n: count() }).from(messages).where(isNull(messages.ownerId)).get();
    if (viewer === null && (made?.n ?? 0) >= 10000) throw new AccessDenied(false);
    let row: typeof messages.$inferSelect;
    try {
      row = db.insert(messages).values({ ...values, ownerId: viewer?.id ?? null }).returning().get();
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterCreate", "Message", row, viewer);
    return row;
  },

  async update(viewer: Viewer | null, id: number, values: MessageValues) {
    const row = db
      .select({ ownerId: messages.ownerId })
      .from(messages)
      .where(and(eq(messages.id, id), messageData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(messageAccess.write, viewer, row.ownerId);
    let changed: typeof messages.$inferSelect;
    const updated = values;
    try {
      changed = db.update(messages).set(updated).where(eq(messages.id, id)).returning().get();
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterUpdate", "Message", changed, viewer);
    return changed;
  },

  async remove(viewer: Viewer | null, id: number): Promise<void> {
    const row = db
      .select({ ownerId: messages.ownerId })
      .from(messages)
      .where(and(eq(messages.id, id), messageData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(messageAccess.delete, viewer, row.ownerId);
    try {
      db.delete(messages).where(eq(messages.id, id)).run();
    } catch (error) {
      throw refusal(error);
    }
    await afterDelete("Message", id, viewer);
  },
};
"
`;

