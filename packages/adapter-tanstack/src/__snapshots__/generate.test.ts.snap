"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute } from "@tanstack/react-router";
import { pageAccess, pageHead } from "#/generated/pages";
import { guardPage } from "#/kit/access";
import { LandingLayout, Hero, RecordCards } from "#/kit/Landing";
import { w } from "#/kit/words";
import { site } from "#/generated/site";
import { listComponents, componentUi } from "#/generated/component";
import { listIncidents, incidentUi } from "#/generated/incident";
import { listMaintenances, maintenanceUi } from "#/generated/maintenance";
import { Uptime } from "#/custom/sections/Uptime";
import { app } from "#/generated/app";

export const Route = createFileRoute("/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["home"], context.viewer, location.href),
  head: () => pageHead("home"),
  loader: async () => ({ components: (await listComponents()).rows, incidents: (await listIncidents()).rows, maintenances: (await listMaintenances()).rows }),
  component: HomePage,
});

function HomePage() {
  const data = Route.useLoaderData();
  const { viewer } = Route.useRouteContext();
  return (
    <LandingLayout appName={app.name} link={viewer ? { to: "/overview", label: w.openApp(app.name) } : { to: "/sign-in", label: w.signIn }} footer={{ links: [], texts: "pages.home.footer" }} site={site} viewer={viewer}>
      <Hero
          texts="pages.home.hero"
          title="Northwind Status"
          subtitle="Is it working? The state of our services, live."
          link={{ to: "/history", label: "Get started" }}
          more
        />
      <RecordCards
          texts="pages.home.services"
          id="services"
          title={componentUi.pluralLabel}
          cards={data.components.slice(0, 6).map((row) => ({
            key: row.id,
            title: String(row.name),
            text: row.description ?? undefined,
            badge: componentUi.fields.find((f) => f.name === "status")?.choices?.find((c) => c.value === row.status)?.label,
          }))}
        />
      <Uptime
          name="uptime"
          texts="pages.home.uptime"
        />
      <RecordCards
          texts="pages.home.open"
          id="open"
          title={incidentUi.pluralLabel}
          cards={data.incidents.filter((row) => ["investigating","identified","monitoring"].includes(row.status)).slice(0, 6).map((row) => ({
            key: row.id,
            title: String(row.title),
            href: \`/history/\${encodeURIComponent(String(row.id))}\`,
            badge: incidentUi.fields.find((f) => f.name === "status")?.choices?.find((c) => c.value === row.status)?.label,
          }))}
        />
      <RecordCards
          texts="pages.home.recent"
          id="recent"
          title={incidentUi.pluralLabel}
          cards={data.incidents.filter((row) => row.status === "resolved").slice(0, 5).map((row) => ({
