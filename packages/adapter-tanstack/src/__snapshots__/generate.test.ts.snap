      const groups = new Map<unknown, unknown[]>();
      for (const row of await customerData.computedRows(condition)) {
        const raw = row[split.kind === "reference" ? \`\${by}Id\` : by];
        const value = split.kind === "date" ? String(raw ?? "").slice(0, 7) || null : split.kind === "instant" ? (raw instanceof Date ? raw.toISOString().slice(0, 7) : null) : raw;
        groups.set(value, [...(groups.get(value) ?? []), row[field]]);
      }
      return named([...groups].map(([value, numbers]) => ({ value, number: amount(aggregate(numbers, how)) })).sort(most));
    }
    const key = split.kind === "date" ? sql<string>\`substr(\${split.column}, 1, 7)\` : split.kind === "instant" ? sql<string>\`strftime('%Y-%m', \${split.column} / 1000, 'unixepoch')\` : sql\`\${split.column}\`;
    const column = Object.hasOwn(NUMBERS, field) ? NUMBERS[field] : undefined;
    if (how !== "count" && !column)
      throw new BadInput(\`\${how} needs a number field: \${[...Object.keys(NUMBERS), ...COMPUTED].join(", ") || "there are none"}.\`);
    const pick = how === "count" || !column ? count() : { sum, average: avg, smallest: min, largest: max }[how](column);
    return named(
      db
        .select({ value: key, number: pick })
        .from(schema.customers)
        .where(condition)
        .groupBy(key)
        .all()
        .map((r) => ({ value: r.value, number: r.number === null ? null : amount(Number(r.number)) }))
        .sort(most),
    );
  },

  /**
   * The records that fit, with their computed fields worked out: for adding those up. At most
   * 10,000, so one call never reads a whole large table; more are refused with how to narrow them.
   */
  async computedRows(condition: SQL | undefined): Promise<Record<string, unknown>[]> {
    const rows = await db.query.customers.findMany({ where: condition, with: { accountManager: { columns: { id: true, name: true } } }, limit: 10001 });
    if (rows.length > 10000)
      throw new BadInput("More than 10,000 records to add up a computed field over: narrow them with where.");
    return rows.map((row) => row as Record<string, unknown>);
  },

  /** The customers the viewer may read whose name has the text: a few, for naming one. */
  named(viewer: Viewer | null, text: string): { id: number; title: string }[] {
    return db
      .select({ id: schema.customers.id, title: schema.customers.name })
      .from(schema.customers)
      .where(and(customerData.readable(viewer), contains([schema.customers.name], text)))
      .limit(6)
      .all()
      .map((row) => ({ id: row.id, title: String(row.title) }));
  },

  /** Every name the viewer may read (at most 2,000): the nearest when a name fits none. */
  titles(viewer: Viewer | null): string[] {
    return db
      .select({ title: schema.customers.name })
      .from(schema.customers)
      .where(customerData.readable(viewer))
      .limit(2000)
      .all()
      .map((row) => String(row.title));
  },

  /** Why \`where\` found none when it names a text no record has: the field's nearest values. */
  whyNone(viewer: Viewer | null, where: unknown): string | undefined {
    if (!where || typeof where !== "object") return undefined;
    for (const [name, v] of Object.entries(where)) {
      const field = Object.hasOwn(FILTERABLE, name) ? FILTERABLE[name] : undefined;
      if (field?.kind !== "text" || (typeof v !== "string" && typeof v !== "number")) continue;
      const values = db
        .selectDistinct({ v: sql<string>\`\${field.column}\` })
        .from(schema.customers)
        .where(and(customerData.readable(viewer), isNotNull(field.column)))
        .limit(2000)
        .all()
        .map((row) => String(row.v));
      const asked = String(v);
      if (values.length && !values.some((x) => x.toLowerCase().includes(asked.toLowerCase())))
        return \`No customer has "\${asked}" in \${name}; the nearest: \${nearest(asked, values).join(", ")}.\`;
    }
    return undefined;
  },

  /** The condition for records the viewer may read that fit \`where\` and \`search\`. */
  fitting(viewer: Viewer | null, where?: unknown, search?: string) {
    return and(
      customerData.readable(viewer),
      whereOf(FILTERABLE, where, viewer ? eq(schema.customers.accountManagerId, viewer.id) : undefined, viewer?.id, {}),
      // Every word somewhere in the texts ("ship lamp" finds "ship's lamp").
      ...wordsOf(search).map((word) => contains([schema.customers.name, schema.customers.email, schema.customers.phone, schema.customers.notes], word)),
    );
  },

  async get(viewer: Viewer | null, id: number) {
    const fetched = await db.query.customers.findFirst({
      where: and(eq(schema.customers.id, id), customerData.readable(viewer)),
      with: { accountManager: { columns: { id: true, name: true } }, orders: { where: orderData.readable(viewer) } },
    });
    const found = fetched && customerData.shownRefs(viewer, [fetched])[0];
    const row = found && { ...found, orders: found.orders.map((r) => orderData.shownTo(viewer, r)) };
    return row ? row : null;
  },

  async create(viewer: Viewer | null, values: CustomerSettable) {
    check(customerAccess.create, viewer);
    let row: typeof schema.customers.$inferSelect;
    try {
      row = db.transaction((tx) => {
        const made = tx.insert(schema.customers).values({ ...values, accountManagerId: ownerFor(viewer, values.accountManagerId) }).returning().get();
        audit(tx, viewer, { action: "created", model: "Customer", record: made.id });
        return made;
      });
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterCreate", "Customer", row, viewer);
    return row;
  },

  /** Changes the record; \`what\` names the change in the audit log (an action's name). */
  /** Changes the fields given; what names the action ("changed" for a form), frees the fields it may change although locked (its own set). */
  async update(viewer: Viewer | null, id: number, values: Partial<CustomerSettable>, what = "changed", _frees: readonly string[] = []) {
    const row = db
      .select({ accountManagerId: schema.customers.accountManagerId })
      .from(schema.customers)
      .where(and(eq(schema.customers.id, id), customerData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    // A form's change needs write on the record; an action (what names it) checked its own access
    // first, which includes the roles its grant names (docs/design/actions.md, Access).
    if (what === "changed") check(customerAccess.write, viewer, row.accountManagerId);
    let changed: typeof schema.customers.$inferSelect;
    const updated = { ...values, accountManagerId: (!!viewer && (!!viewer.system || customerAccess.write.roles.includes(viewer.role))) ? (values.accountManagerId === undefined ? row.accountManagerId : values.accountManagerId) : personOf(viewer) };
    try {
      changed = db.transaction((tx) => {
        // Read again in the change itself: a record that left the viewer's reach meanwhile is refused.
        const before = tx.select().from(schema.customers).where(and(eq(schema.customers.id, id), customerData.readable(viewer))).get();
        if (!before) throw new AccessDenied(viewer !== null);
        const after = tx.update(schema.customers).set(updated).where(eq(schema.customers.id, id)).returning().get();
        audit(tx, viewer, { action: what, model: "Customer", record: id, fields: before && changedFields(before, after, Object.keys(updated)) });
        return after;
      });
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterUpdate", "Customer", changed, viewer);
    return changed;
  },

  /** Deletes the record; \`together\` takes the records that point to it along to the trash (delete-together.md). */
  async remove(viewer: Viewer | null, id: number, together = false): Promise<void> {
    const row = db
      .select({ name: schema.customers.name, accountManagerId: schema.customers.accountManagerId })
      .from(schema.customers)
      .where(and(eq(schema.customers.id, id), customerData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(customerAccess.delete, viewer, row.accountManagerId);
    try {
      db.transaction((tx) => {
        // Read again in the change itself: a record that left the viewer's reach meanwhile is refused.
        if (!tx.select({ id: schema.customers.id }).from(schema.customers).where(and(eq(schema.customers.id, id), customerData.readable(viewer))).get())
          throw new AccessDenied(viewer !== null);
        const used = usedBy(tx, id, String(row.name ?? id));
        if (used && !together) throw new Conflict(\`in-use:\${JSON.stringify(used)}\`);
        const when = new Date();
        const gone = tx.update(schema.customers).set({ deletedAt: when, deletedBy: personOf(viewer) }).where(and(eq(schema.customers.id, id), isNull(schema.customers.deletedAt))).returning().get();
        if (gone) {
          audit(tx, viewer, { action: "trashed", model: "Customer", record: id, title: gone.name });
          if (used) {
            const tag = \`Customer:\${id}\`;
            orderData.trashWith(tx, viewer, eq(schema.orders.customerId, id), tag, when);
          }
        }
      });
    } catch (error) {
      throw refusal(error);
    }
    await afterDelete("Customer", id, viewer);
  },

  /**
   * Deletes the chosen records the viewer may delete, all or none (one still in use stops them
   * all, and is named); the others are skipped.
   */
  async removeMany(viewer: Viewer | null, ids: number[], together = false): Promise<{ deleted: number; skipped: number }> {
    const rows = db
      .select({ id: schema.customers.id, name: schema.customers.name, accountManagerId: schema.customers.accountManagerId })
      .from(schema.customers)
      .where(and(inArray(schema.customers.id, ids), customerData.readable(viewer)))
      .all()
      .filter((row) => allows(customerAccess.delete, viewer, row.accountManagerId));
    db.transaction((tx) => {
      const when = new Date();
      for (const row of rows)
        try {
          const used = usedBy(tx, row.id, String(row.name ?? row.id));
          if (used && !together) throw new Conflict(\`in-use:\${JSON.stringify(used)}\`);
          const gone = tx.update(schema.customers).set({ deletedAt: when, deletedBy: personOf(viewer) }).where(and(eq(schema.customers.id, row.id), isNull(schema.customers.deletedAt))).returning().get();
          if (gone) {
            audit(tx, viewer, { action: "trashed", model: "Customer", record: row.id, title: gone.name });
            if (used) {
              const tag = \`Customer:\${row.id}\`;
              orderData.trashWith(tx, viewer, eq(schema.orders.customerId, row.id), tag, when);
            }
          }
        } catch (error) {
          const refused = refusal(error);
          throw refused instanceof Conflict && refused.message === "in-use" ? new Conflict(\`in-use:\${row.id}\`) : refused;
        }
    });
    for (const row of rows) {
      await afterDelete("Customer", row.id, viewer);
    }
    return { deleted: rows.length, skipped: new Set(ids).size - rows.length };
  },

  /**
   * The viewer's trash (docs/design/trash.md): the customers in it they may delete, the
   * latest first, with when and by whom, kept for thirty days.
   */
  async trash(viewer: Viewer | null) {
    const rows = customerData.shownRefs(
      viewer,
      await db.query.customers.findMany({
        where: and(isNotNull(schema.customers.deletedAt), customerData.scoped(viewer)),
        with: { accountManager: { columns: { id: true, name: true } } },
        orderBy: (t) => [desc(t.deletedAt)],
        limit: 1000,
      }),
    ).filter((row) => allows(customerAccess.delete, viewer, row.accountManagerId));
    const ids = [...new Set(rows.map((row) => row.deletedBy).filter((id): id is string => Boolean(id)))];
    const people = new Map(
      db.select({ id: schema.user.id, name: schema.user.name }).from(schema.user).where(inArray(schema.user.id, ids)).all().map((p) => [p.id, p.name]),
    );
    const withCount = new Map<string, number>();
    const tags = rows.map((row) => \`Customer:\${row.id}\`);
    for (const r of db.select({ tag: schema.orders.deletedWith, n: count() }).from(schema.orders).where(inArray(schema.orders.deletedWith, tags)).groupBy(schema.orders.deletedWith).all())
      withCount.set(r.tag as string, (withCount.get(r.tag as string) ?? 0) + r.n);
    return rows.map((row) => ({ ...row, deletedByName: (row.deletedBy && people.get(row.deletedBy)) ?? null, withCount: withCount.get(\`Customer:\${row.id}\`) ?? 0 }));
  },

  /** A customer in the trash, as its page shows it read-only, with when and by whom; else nothing. */
  async trashed(viewer: Viewer | null, id: number) {
    const fetched = await db.query.customers.findFirst({
      where: and(eq(schema.customers.id, id), and(isNotNull(schema.customers.deletedAt), customerData.scoped(viewer))),
      with: { accountManager: { columns: { id: true, name: true } }, orders: { where: orderData.readable(viewer) } },
    });
    const row = fetched && customerData.shownRefs(viewer, [fetched])[0];
    if (!row || !allows(customerAccess.delete, viewer, row.accountManagerId)) return null;
    const rows = [row];
    const ids = [...new Set(rows.map((row) => row.deletedBy).filter((id): id is string => Boolean(id)))];
    const people = new Map(
      db.select({ id: schema.user.id, name: schema.user.name }).from(schema.user).where(inArray(schema.user.id, ids)).all().map((p) => [p.id, p.name]),
    );
    const shown = row;
    return {
      row: shown,
      deletedAt: row.deletedAt as Date,
      by: (row.deletedBy && people.get(row.deletedBy)) ?? null,
      until: new Date((row.deletedAt as Date).getTime() + TRASH_DAYS * DAY),
    };
  },

  /** Takes the chosen customers out of the trash, those the viewer may delete. */
  restore(viewer: Viewer | null, ids: number[]): { restored: number; skipped: number } {
    const rows = db
      .select({ id: schema.customers.id, accountManagerId: schema.customers.accountManagerId })
      .from(schema.customers)
      .where(and(inArray(schema.customers.id, ids), and(isNotNull(schema.customers.deletedAt), customerData.scoped(viewer))))
      .all().filter((row) => allows(customerAccess.delete, viewer, row.accountManagerId));
    // A unique value a live record has taken since refuses it, as it refuses a new record.
    try {
      db.transaction((tx) => {
        for (const row of rows) {
          const back = tx.update(schema.customers).set({ deletedAt: null, deletedBy: null, deletedWith: null }).where(eq(schema.customers.id, row.id)).returning().get();
          audit(tx, viewer, { action: "restored", model: "Customer", record: row.id, title: back.name });
          // What went to the trash with it comes back with it.
          orderData.restoreWith(tx, viewer, \`Customer:\${row.id}\`);
        }
      });
    } catch (error) {
      throw refusal(error);
    }
    return { restored: rows.length, skipped: new Set(ids).size - rows.length };
  },

  /** Removes the chosen customers in the trash for good, with their pictures and documents. */
  removeForGood(viewer: Viewer | null, ids: number[]): { deleted: number; skipped: number } {
    const rows = db
      .select({ id: schema.customers.id, accountManagerId: schema.customers.accountManagerId })
      .from(schema.customers)
      .where(and(inArray(schema.customers.id, ids), and(isNotNull(schema.customers.deletedAt), customerData.scoped(viewer))))
      .all().filter((row) => allows(customerAccess.delete, viewer, row.accountManagerId));
    customerData.erase(viewer, rows.map((row) => row.id));
    return { deleted: rows.length, skipped: new Set(ids).size - rows.length };
  },

  /** Deletes trashed records for good (Delete permanently, Empty trash, the daily job). */
  erase(viewer: Viewer | null, ids: number[]): void {
    if (ids.length === 0) return;
    // What is in the trash pointing to them goes first, deepest first (docs/design/delete-together.md).
    orderData.erase(viewer, db.select({ id: schema.orders.id }).from(schema.orders).where(and(isNotNull(schema.orders.deletedAt), inArray(schema.orders.customerId, ids))).all().map((r) => r.id));

    const rows = db
      .select({ id: schema.customers.id, accountManagerId: schema.customers.accountManagerId })
      .from(schema.customers)
      .where(and(inArray(schema.customers.id, ids), isNotNull(schema.customers.deletedAt)))
      .all();
    try {
      db.transaction((tx) => {
        for (const row of rows) {
          const gone = tx.delete(schema.customers).where(eq(schema.customers.id, row.id)).returning().get();
          if (gone) audit(tx, viewer, { action: "removed", model: "Customer", record: row.id, title: gone.name });
        }
      });
    } catch (error) {
      throw refusal(error);
    }
  },

  /** What has been in the trash for thirty days goes for good (once a day, see trash.server.ts). */
  purge(now = Date.now()): number {
    const old = db
      .select({ id: schema.customers.id })
      .from(schema.customers)
      .where(lt(schema.customers.deletedAt, new Date(now - TRASH_DAYS * DAY)))
      .all()
      .map((row) => row.id);
    customerData.erase(null, old);
    return old.length;
  },

  /**
   * The customers the viewer may read whose name contains the text: a search of records that
   * refer to them finds them only among these.
   */
  titled(viewer: Viewer | null, text: string): number[] {
    return db
      .select({ id: schema.customers.id })
      .from(schema.customers)
      .where(and(contains([schema.customers.name], text), customerData.readable(viewer)))
      .all()
      .map((row) => row.id);
  },

  /** Choices for fields that refer to a customer: the ones the viewer may read. */
  options(viewer: Viewer | null) {
    if (readScope(customerAccess.read, viewer) === "none") return [];
    return db
      .select({ value: schema.customers.id, label: schema.customers.name })
      .from(schema.customers)
      .where(customerData.readable(viewer))
      .orderBy(asc(schema.customers.name))
      .all();
  },
};
"
`;

