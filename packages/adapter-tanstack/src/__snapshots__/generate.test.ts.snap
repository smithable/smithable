"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, notFound, useNavigate } from "@tanstack/react-router";
import { app } from "#/generated/app";
import { pageAccess } from "#/generated/pages";
import { deleteInstructor, getInstructor, instructorSchema, instructorUi, updateInstructor } from "#/generated/instructor";
import { guardPage } from "#/kit/access";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";

export const Route = createFileRoute("/instructors/$id")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["instructors"], context.viewer, location.href),
  loader: async ({ params }) => {
    const found = await getInstructor({ data: Number(params.id) });
    if (!found) throw notFound();
    return { ...found };
  },
  component: InstructorPage,
});

function InstructorPage() {
  const { row, canWrite, canDelete } = Route.useLoaderData();
  const navigate = useNavigate();
  const back = () => navigate({ to: "/instructors" });
  return (
    <>
      <PageHeader title={row.name || \`Instructor #\${row.id}\`} />
      <ModelForm
        ui={instructorUi}
        app={app}
        schema={instructorSchema}
        initial={row}
        readOnly={!canWrite}
        submitLabel="Save changes"
        onSubmit={async (values) => {
          await updateInstructor({ data: { id: row.id, values } });
          await back();
        }}
        onCancel={back}
        onDelete={
          canDelete
            ? async () => {
                await deleteInstructor({ data: row.id });
                await back();
              }
            : undefined
        }
      />

    </>
  );
}
"
`;

