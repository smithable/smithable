import { w } from "#/kit/words";
import { site } from "#/generated/site";
import { listServices, serviceUi } from "#/generated/service";
import { listBarbers, barberUi } from "#/generated/barber";
import { app } from "#/generated/app";
import { List } from "lucide-react";

export const Route = createFileRoute("/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["home"], context.viewer, location.href),
  head: () => pageHead("home"),
  loader: async () => ({ services: (await listServices()).rows, barbers: (await listBarbers()).rows }),
  component: HomePage,
});

function HomePage() {
  const data = Route.useLoaderData();
  const { viewer } = Route.useRouteContext();
  return (
    <LandingLayout appName={app.name} link={viewer ? { to: "/appointments", label: w.openApp(app.name) } : { to: "/sign-in", label: w.signIn }} footer={{ links: [], texts: "pages.home.footer" }} site={site} viewer={viewer}>
      <Hero
          texts="pages.home.hero"
          title="Harbour Cuts"
          subtitle="Appointments with a small barbershop's barbers, booked online by their time."
          link={{ to: "/appointments", label: "Get started" }}
          more
        />
      <RecordCards
          texts="pages.home.services"
          id="services"
          title={serviceUi.pluralLabel}
          cards={data.services.slice(0, 6).map((row) => ({
            key: row.id,
            title: String(row.name),
            text: row.summary ?? undefined,
            amount: row.price == null ? undefined : new Intl.NumberFormat(undefined, { style: "currency", currency: app.currency }).format(row.price / 100),
          }))}
        />
      <RecordCards
          texts="pages.home.barbers"
          id="barbers"
          icon={List}
          title={barberUi.pluralLabel}
          cards={data.barbers.slice(0, 6).map((row) => ({
            key: row.id,
            title: String(row.name),
            picture: row.portrait ? { src: \`/files/barber/\${row.id}/portrait\`, alt: row.portrait.alt, width: row.portrait.width, height: row.portrait.height, generated: row.portrait.generated } : undefined,
            text: row.bio ?? undefined,
          }))}
        />
    </LandingLayout>
  );
}
"
`;

