"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { eq } from "drizzle-orm";
import { db } from "#/db";
import * as schema from "#/db/schema";
import { AccessDenied, allows, check, type Viewer } from "#/kit/access";
import { audit } from "#/kit/audit.server";
import { afterChange } from "#/generated/hooks";
import { taskSettable } from "#/generated/task.schema";
import { taskData } from "#/generated/task.server";
import { reopenAccess, reopenFits } from "./reopen";

type Row = NonNullable<Awaited<ReturnType<typeof taskData.get>>>;

/** The task's new values (only the fields the action sets), worked out on it as it was. */
function plan(_viewer: Viewer | null, row: Row) {
  return {
    id: row.id,
    values: taskSettable.partial().parse({
      status: "todo",
    }),

  };
}

/** Runs the "reopen" action on the task as the viewer. */
export async function runReopen(viewer: Viewer | null, id: number) {
  const row = await taskData.get(viewer, id);
  if (!row) throw new AccessDenied(viewer !== null);
  check(reopenAccess, viewer, row.ownerId);
  if (!reopenFits(row, viewer)) throw new Error("This cannot be done now.");
  const one = plan(viewer, row);
  return taskData.update(viewer, id, one.values, "reopen", ["status"]);
}

/**
 * Runs the "reopen" action on each chosen task it fits and the viewer may run it on
 * (docs/design/actions.md §9); the others are skipped. All or none: one that is refused stops
 * them all, and is named.
 */
export async function runReopenMany(viewer: Viewer | null, ids: number[]) {
  const plans: ReturnType<typeof plan>[] = [];
  // An id given twice is one record, run once.
  const unique = [...new Set(ids)];
  for (const id of unique) {
    const row = await taskData.get(viewer, id);
    if (!row || !allows(reopenAccess, viewer, row.ownerId) || !reopenFits(row, viewer)) continue;
    try {
      plans.push(plan(viewer, row));
    } catch (error) {
      const why = error instanceof Error ? error.message : String(error);
      throw new Error(\`Task "\${String(row.title ?? row.id)}": \${why}\`);
    }
  }
  const written = db.transaction((tx) => plans.map((p) => {
      const changed = tx.update(schema.tasks).set(p.values).where(eq(schema.tasks.id, p.id)).returning().get();
      audit(tx, viewer, { action: "reopen", model: "Task", record: changed.id, fields: ["status"] });
