  async get(viewer: Viewer | null, id: number) {
    const fetched = await db.query.businessProfiles.findFirst({
      where: and(eq(schema.businessProfiles.id, id), businessProfileData.readable(viewer)),
    });
    const found = fetched && businessProfileData.shownRefs(viewer, [fetched])[0];
    const row = found && shownTo(viewer, found);
