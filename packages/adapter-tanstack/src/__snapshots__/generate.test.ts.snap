  columns: ["number", "customerId", "status", "total", "shippingMethod"],
  fields: [
    {
      name: "number",
      label: "Number",
      kind: "string",
      required: true,
      get: (row) => row.number,
    },
    {
      name: "customerId",
      label: "Customer",
      kind: "relation",
      required: true,
      relation: { key: "customer", titleField: "name" },
      get: (row) => row.customer?.name ?? null,
    },
    {
