exports[`../../../examples/api/smithable.yml > file list and generated code > src/generated/access.test.ts 1`] = `
"// Generated by Smithable from smithable.yml and smithable.auth.yml. Do not edit: this file is overwritten on every change.
// For every model and role: which records a user can read, create, change and delete.
// "Own" records are owned by the user; "others" by someone else.
import { and, eq } from "drizzle-orm";
import { describe, expect, test } from "vitest";
import { db } from "#/db";
import { auditLog, user } from "#/db/schema";
import * as schema from "#/db/schema";
import { AccessDenied, type Viewer } from "#/kit/access";
import { forgetInLog, pruneAudit } from "#/kit/audit.server";
import { projectData } from "./project.server";
import { taskData } from "./task.server";
import { noteData } from "./note.server";
import { runComplete, runCompleteMany } from "./actions/complete.server";
import { runReopen, runReopenMany } from "./actions/reopen.server";

let counter = 0;
const next = () => ++counter;

/** A new signed-in user with the role. */
function signedIn(role: string): Viewer {
  const n = next();
  const viewer = { id: \`test-user-\${n}\`, name: \`Test \${role} \${n}\`, email: \`user\${n}@example.com\`, role };
  db.insert(user).values(viewer).run();
  return viewer;
}

/** Owns the records that are someone else's. */
const stranger = signedIn("member");

/** Whether the action is allowed; any other failure fails the test. */
async function can(action: () => unknown): Promise<boolean> {
  try {
    await action();
    return true;
  } catch (error) {
    if (error instanceof AccessDenied) return false;
    throw error;
  }
}

/** Whether the viewer can open the record and sees it in the list. */
async function reads(
  data: { get(viewer: never, id: number): Promise<unknown>; list(viewer: never): Promise<{ id: number }[]> },
  viewer: unknown,
  id: number,
): Promise<boolean> {
  const listed = await data.list(viewer as never).then(
    (rows) => rows.some((row) => row.id === id),
    (error) => {
      if (error instanceof AccessDenied) return false;
      throw error;
    },
  );
  return listed && (await data.get(viewer as never, id)) !== null;
}

function projectValues(_owner: string | null) {
  const n = next();
  return { name: \`Project name \${n}\`, description: null } as const;
}

function insertProject(owner: string | null, values: Record<string, unknown> = {}) {
  return db
    .insert(schema.projects)
    .values({ ...projectValues(owner), ...values, ownerId: owner })
    .returning()
    .get();
}

function taskValues(owner: string | null) {
  const n = next();
  return { title: \`Task title \${n}\`, projectId: insertProject(owner).id, status: "todo", dueDate: null, assigneeId: null, details: null } as const;
}

function insertTask(owner: string | null, values: Record<string, unknown> = {}) {
  return db
    .insert(schema.tasks)
    .values({ ...taskValues(owner), ...values, ownerId: owner })
    .returning()
    .get();
}

function noteValues(owner: string | null) {
  const n = next();
  return { title: \`Note title \${n}\`, projectId: insertProject(owner).id, body: null, attachment: null } as const;
}

function insertNote(owner: string | null, values: Record<string, unknown> = {}) {
  return db
    .insert(schema.notes)
    .values({ ...noteValues(owner), ...values, ownerId: owner })
    .returning()
    .get();
}

describe("Project", () => {
  test("admin", async () => {
    const viewer = signedIn("admin");
    const others = insertProject(stranger.id);
    const own = insertProject(viewer.id);
    expect({
      readOthers: await reads(projectData, viewer, others.id),
      readOwn: await reads(projectData, viewer, own.id),
      create: await can(() => projectData.create(viewer, projectValues(viewer.id))),
      changeOthers: await can(() => projectData.update(viewer, others.id, projectValues(stranger.id))),
      changeOwn: await can(() => projectData.update(viewer, own.id, projectValues(viewer.id))),
      deleteOthers: await can(() => projectData.remove(viewer, others.id)),
      deleteOwn: await can(() => projectData.remove(viewer, own.id)),
    }).toEqual({
      readOthers: true,
      readOwn: true,
      create: true,
      changeOthers: true,
      changeOwn: true,
      deleteOthers: true,
      deleteOwn: true,
    });
  });

  test("member", async () => {
    const viewer = signedIn("member");
