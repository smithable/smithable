exports[`../../../examples/support/smithable.yml > file list and generated code > src/generated/access.test.ts 1`] = `
"// Generated by Smithable from smithable.yml and smithable.auth.yml. Do not edit: this file is overwritten on every change.
// For every model and role: which records a user can read, create, change and delete.
// "Own" records are owned by the user; "others" by someone else.
import { and, eq } from "drizzle-orm";
import { describe, expect, test } from "vitest";
import { db } from "#/db";
import { auditLog, user } from "#/db/schema";
import * as schema from "#/db/schema";
import { AccessDenied, type Viewer } from "#/kit/access";
import { forgetInLog, pruneAudit } from "#/kit/audit.server";
import { supportCaseData } from "./support-case.server";
import { messageData } from "./message.server";
import { runAssignToMe } from "./actions/assign-to-me.server";
import { runAssignTo } from "./actions/assign-to.server";
import { runStartWork, runStartWorkMany } from "./actions/start-work.server";
import { runClose, runCloseMany } from "./actions/close.server";
import { runReopen, runReopenMany } from "./actions/reopen.server";

let counter = 0;
const next = () => ++counter;

/** A new signed-in user with the role. */
function signedIn(role: string): Viewer {
  const n = next();
  const viewer = { id: \`test-user-\${n}\`, name: \`Test \${role} \${n}\`, email: \`user\${n}@example.com\`, role };
  db.insert(user).values(viewer).run();
  return viewer;
}

/** Owns the records that are someone else's. */
const stranger = signedIn("agent");

/** Whether the action is allowed; any other failure fails the test. */
async function can(action: () => unknown): Promise<boolean> {
  try {
    await action();
    return true;
  } catch (error) {
    if (error instanceof AccessDenied) return false;
    throw error;
  }
}

/** Whether the viewer can open the record and sees it in the list. */
async function reads(
  data: { get(viewer: never, id: number): Promise<unknown>; list(viewer: never): Promise<{ id: number }[]> },
  viewer: unknown,
  id: number,
): Promise<boolean> {
  const listed = await data.list(viewer as never).then(
    (rows) => rows.some((row) => row.id === id),
    (error) => {
      if (error instanceof AccessDenied) return false;
      throw error;
    },
  );
  return listed && (await data.get(viewer as never, id)) !== null;
}

function supportCaseValues(_owner: string | null) {
  const n = next();
  return { subject: \`SupportCase subject \${n}\`, customerEmail: \`supportCase\${n}@example.com\`, status: "open", priority: 1, assigneeId: null, body: null, attachments: null } as const;
}

function insertSupportCase(owner: string | null, values: Record<string, unknown> = {}) {
  return db
    .insert(schema.supportCases)
    .values({ ...supportCaseValues(owner), ...values, ownerId: owner })
    .returning()
    .get();
}

function messageValues(owner: string | null) {
  const n = next();
  return { content: \`Message content \${n}\`, sender: "agent", agentId: null, fromEmail: null, attachments: null, supportCaseId: insertSupportCase(owner).id } as const;
}

function insertMessage(owner: string | null, values: Record<string, unknown> = {}) {
  return db
    .insert(schema.messages)
    .values({ ...messageValues(owner), ...values, ownerId: owner })
    .returning()
    .get();
}

describe("SupportCase", () => {
  test("admin", async () => {
    const viewer = signedIn("admin");
    const others = insertSupportCase(stranger.id);
    const own = insertSupportCase(viewer.id);
    expect({
      readOthers: await reads(supportCaseData, viewer, others.id),
      readOwn: await reads(supportCaseData, viewer, own.id),
      create: await can(() => supportCaseData.create(viewer, supportCaseValues(viewer.id))),
      changeOthers: await can(() => supportCaseData.update(viewer, others.id, { ...supportCaseValues(stranger.id), customerEmail: others.customerEmail })),
      changeOwn: await can(() => supportCaseData.update(viewer, own.id, { ...supportCaseValues(viewer.id), customerEmail: own.customerEmail })),
      deleteOthers: await can(() => supportCaseData.remove(viewer, others.id)),
      deleteOwn: await can(() => supportCaseData.remove(viewer, own.id)),
    }).toEqual({
      readOthers: true,
      readOwn: true,
      create: true,
      changeOthers: true,
      changeOwn: true,
      deleteOthers: true,
      deleteOwn: true,
    });
  });

  test("agent", async () => {
    const viewer = signedIn("agent");
    const others = insertSupportCase(stranger.id);
    const own = insertSupportCase(viewer.id);
    expect({
      readOthers: await reads(supportCaseData, viewer, others.id),
      readOwn: await reads(supportCaseData, viewer, own.id),
      create: await can(() => supportCaseData.create(viewer, supportCaseValues(viewer.id))),
      changeOthers: await can(() => supportCaseData.update(viewer, others.id, { ...supportCaseValues(stranger.id), customerEmail: others.customerEmail })),
      changeOwn: await can(() => supportCaseData.update(viewer, own.id, { ...supportCaseValues(viewer.id), customerEmail: own.customerEmail })),
      deleteOthers: await can(() => supportCaseData.remove(viewer, others.id)),
      deleteOwn: await can(() => supportCaseData.remove(viewer, own.id)),
    }).toEqual({
      readOthers: true,
      readOwn: true,
      create: true,
      changeOthers: true,
      changeOwn: true,
      deleteOthers: false,
      deleteOwn: true,
    });
  });

  test("a visitor who has not signed in", async () => {
    const viewer = null;
    const others = insertSupportCase(stranger.id);
    expect({
      readOthers: await reads(supportCaseData, viewer, others.id),
      readOwn: false,
      create: await can(() => supportCaseData.create(viewer, supportCaseValues(null))),
      changeOthers: await can(() => supportCaseData.update(viewer, others.id, { ...supportCaseValues(stranger.id), customerEmail: others.customerEmail })),
      changeOwn: false,
      deleteOthers: await can(() => supportCaseData.remove(viewer, others.id)),
      deleteOwn: false,
    }).toEqual({
      readOthers: false,
      readOwn: false,
      create: false,
      changeOthers: false,
      changeOwn: false,
      deleteOthers: false,
      deleteOwn: false,
    });
  });
});

