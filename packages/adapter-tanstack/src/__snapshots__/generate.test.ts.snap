/** A page of the bookings the viewer may read. */
const listBookings = createServerFn()
  .validator(listQuery)
  .handler(async ({ data }) => {
    const viewer = await currentViewer();
    return { ...(await bookingData.page(viewer, undefined, undefined, data.all ? 1 : data.page, data.all ? (viewer ? 10000 : 500) : undefined)), canCreate: allows(bookingAccess.create, viewer) };
  });
import { After as PartsAfter, Before as PartsBefore } from "./-my-bookings-parts";

export const Route = createFileRoute("/my-bookings/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["my-bookings"], context.viewer, location.href),
  head: () => pageHead("my-bookings"),
  validateSearch: (s: Search) => optional({ page: count(s.page) }),
  loaderDeps: ({ search }) => ({ page: search.page }),
  loader: ({ deps }) => listBookings({ data: { page: deps.page } }),
  component: () => (
    <>
      <PartsBefore />
      <MyBookingsPage />
      <PartsAfter />
    </>
  ),
});

function MyBookingsPage() {
  const { rows, canCreate, total, page: at, size } = Route.useLoaderData();
  const { viewer } = Route.useRouteContext();
  const navigate = useNavigate({ from: "/my-bookings/" });
  const router = useRouter();
  // The chosen rows, offered when the viewer may do something to at least one row.
  const [selected, setSelected] = useState<Set<number>>(new Set());
  const chosen = rows.filter((row) => selected.has(row.id));
  const selectable = rows.some((row) => allows(bookingDeleteRule, viewer, row.attendeeId));
  const newButton = canCreate && (
    <Link to="/my-bookings/new" className={buttonVariants()}>
      {w.newOne("booking")}
    </Link>
  );
  return (
    <>
      <PageHeader
        page="my-bookings"
        title={pageUi["my-bookings"].title}
        actions={newButton}
      />
      {selectable && (
        <SelectionBar
          count={chosen.length}
          noun={["booking", "bookings"]}
          app={app}
          titleOf={(id) => String(rows.find((row) => row.id === id)?.id ?? id)}
          actions={[]}
          deletable={chosen.filter((row) => allows(bookingDeleteRule, viewer, row.attendeeId)).length}
          onDelete={(together) => deleteBookings({ data: { ids: chosen.map((row) => row.id), together } })}
          onDone={async () => {
            setSelected(new Set());
            await router.invalidate();
          }}
          onExport={() => download(csvName(bookingUi), csvOf(bookingUi, chosen))}
        />
      )}
      <ModelTable
        ui={bookingUi}
        page="my-bookings"
        paging={{ page: at, size, total, to: (next) => navigate({ to: "/my-bookings", search: (prev) => ({ ...prev, page: next > 1 ? next : undefined }) }) }}
        app={app}
        exportRows={async () => (await listBookings({ data: { all: true } })).rows}
        rows={rows}
        selection={selectable ? { ids: selected, onChange: setSelected } : undefined}
        emptyAction={newButton || undefined}
        onOpen={(row) => navigate({ to: "/my-bookings/$id", params: { id: String(row.id) } })}
      />
    </>
  );
}
"
`;

