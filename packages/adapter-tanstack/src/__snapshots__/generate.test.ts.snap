exports[`../../../examples/kiosk/smithable.yml > file list and generated code > src/generated/access.test.ts 1`] = `
"// Generated by Smithable from smithable.yml and smithable.auth.yml. Do not edit: this file is overwritten on every change.
// For every model and role: which records a user can read, create, change and delete.
// "Own" records are owned by the user; "others" by someone else.
import { and, eq } from "drizzle-orm";
import { describe, expect, test } from "vitest";
import { db } from "#/db";
import { auditLog, user } from "#/db/schema";
import * as schema from "#/db/schema";
import { AccessDenied, type Viewer } from "#/kit/access";
import { forgetInLog, pruneAudit } from "#/kit/audit.server";
import { dishData } from "./dish.server";
import { orderData } from "./order.server";
import { orderLineData } from "./order-line.server";
import { stopData } from "./stop.server";
import { runSoldOut, runSoldOutMany } from "./actions/sold-out.server";
import { runBackOn, runBackOnMany } from "./actions/back-on.server";
import { runAccept, runAcceptMany } from "./actions/accept.server";
import { runReady, runReadyMany } from "./actions/ready.server";
import { runCollected, runCollectedMany } from "./actions/collected.server";
import { runDecline, runDeclineMany } from "./actions/decline.server";

let counter = 0;
const next = () => ++counter;

/** A new signed-in user with the role. */
function signedIn(role: string): Viewer {
  const n = next();
  const viewer = { id: \`test-user-\${n}\`, name: \`Test \${role} \${n}\`, email: \`user\${n}@example.com\`, role };
  db.insert(user).values(viewer).run();
  return viewer;
}

/** Owns the records that are someone else's. */
const stranger = signedIn("staff");

/** Whether the action is allowed; any other failure fails the test. */
async function can(action: () => unknown): Promise<boolean> {
  try {
    await action();
    return true;
  } catch (error) {
    if (error instanceof AccessDenied) return false;
    throw error;
  }
}

/** Whether the viewer can open the record and sees it in the list. */
async function reads(
  data: { get(viewer: never, id: number): Promise<unknown>; list(viewer: never): Promise<{ id: number }[]> },
  viewer: unknown,
  id: number,
): Promise<boolean> {
  const listed = await data.list(viewer as never).then(
    (rows) => rows.some((row) => row.id === id),
    (error) => {
      if (error instanceof AccessDenied) return false;
      throw error;
    },
  );
  return listed && (await data.get(viewer as never, id)) !== null;
}

function dishValues(_owner: string | null) {
  const n = next();
  return { name: \`Dish name \${n}\`, description: null, price: 1000, section: "starters", picture: null, diet: "none", allergens: null, available: null } as const;
}

function insertDish(owner: string | null, values: Record<string, unknown> = {}) {
  return db
    .insert(schema.dishes)
    .values({ ...dishValues(owner), ...values, ownerId: owner })
    .returning()
    .get();
}

function orderValues(_owner: string | null) {
  const n = next();
  return { number: n, name: \`Order name \${n}\`, phone: \`+358 40 \${1000000 + n}\`, email: null, wanted: null, note: null, status: "new", reason: null } as const;
}

function insertOrder(owner: string | null, values: Record<string, unknown> = {}) {
  return db
    .insert(schema.orders)
    .values({ ...orderValues(owner), ...values, ownerId: owner })
    .returning()
    .get();
}

function orderLineValues(owner: string | null) {
  const n = next();
  return { orderId: insertOrder(owner).id, dishId: insertDish(owner).id, quantity: n, unitPrice: 1000 } as const;
}

function insertOrderLine(owner: string | null, values: Record<string, unknown> = {}) {
  return db
    .insert(schema.orderLines)
    .values({ ...orderLineValues(owner), ...values, ownerId: owner })
    .returning()
    .get();
}

function stopValues(_owner: string | null) {
  const n = next();
  return { place: \`Stop place \${n}\`, day: "2099-01-15", hours: \`Stop hours \${n}\`, note: null } as const;
}

function insertStop(owner: string | null, values: Record<string, unknown> = {}) {
  return db
    .insert(schema.stops)
    .values({ ...stopValues(owner), ...values, ownerId: owner })
    .returning()
    .get();
}

describe("Dish", () => {
  test("admin", async () => {
    const viewer = signedIn("admin");
    const others = insertDish(stranger.id);
    const own = insertDish(viewer.id);
    expect({
      readOthers: await reads(dishData, viewer, others.id),
      readOwn: await reads(dishData, viewer, own.id),
      create: await can(() => dishData.create(viewer, dishValues(viewer.id))),
      changeOthers: await can(() => dishData.update(viewer, others.id, dishValues(stranger.id))),
      changeOwn: await can(() => dishData.update(viewer, own.id, dishValues(viewer.id))),
      deleteOthers: await can(() => dishData.remove(viewer, others.id)),
      deleteOwn: await can(() => dishData.remove(viewer, own.id)),
    }).toEqual({
      readOthers: true,
      readOwn: true,
      create: true,
      changeOthers: true,
      changeOwn: true,
      deleteOthers: true,
      deleteOwn: true,
    });
  });

  test("staff", async () => {
    const viewer = signedIn("staff");
    const others = insertDish(stranger.id);
    const own = insertDish(viewer.id);
    expect({
      readOthers: await reads(dishData, viewer, others.id),
      readOwn: await reads(dishData, viewer, own.id),
      create: await can(() => dishData.create(viewer, dishValues(viewer.id))),
      changeOthers: await can(() => dishData.update(viewer, others.id, dishValues(stranger.id))),
      changeOwn: await can(() => dishData.update(viewer, own.id, dishValues(viewer.id))),
      deleteOthers: await can(() => dishData.remove(viewer, others.id)),
      deleteOwn: await can(() => dishData.remove(viewer, own.id)),
    }).toEqual({
      readOthers: true,
      readOwn: true,
      create: true,
      changeOthers: true,
      changeOwn: true,
      deleteOthers: false,
      deleteOwn: true,
    });
  });

  test("a visitor who has not signed in", async () => {
    const viewer = null;
    const others = insertDish(stranger.id);
    expect({
      readOthers: await reads(dishData, viewer, others.id),
      readOwn: false,
      create: await can(() => dishData.create(viewer, dishValues(null))),
      changeOthers: await can(() => dishData.update(viewer, others.id, dishValues(stranger.id))),
      changeOwn: false,
      deleteOthers: await can(() => dishData.remove(viewer, others.id)),
      deleteOwn: false,
    }).toEqual({
      readOthers: true,
      readOwn: false,
      create: false,
      changeOthers: false,
      changeOwn: false,
      deleteOthers: false,
      deleteOwn: false,
    });
  });
});

