exports[`../../../examples/support/smithable.yml > file list and generated code > src/routes/cases/$id.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, notFound, useNavigate, useRouter } from "@tanstack/react-router";
import { createServerFn } from "@tanstack/react-start";
import { and, desc, eq } from "drizzle-orm";
import { db } from "#/db";
import { auditLog, user } from "#/db/schema";
import { app } from "#/generated/app";
import { pageAccess, pageHead } from "#/generated/pages";
import { deleteSupportCase, getSupportCase, supportCaseUi, updateSupportCase } from "#/generated/support-case";
import { supportCaseSchema } from "#/generated/support-case.schema";
import { assignToMe, assignToMeAccess, assignToMeFits } from "#/generated/actions/assign-to-me";
import { assignTo, assignToAccess, assignToAskOptions, assignToAskUi, assignToAsks, assignToFits } from "#/generated/actions/assign-to";
import { startWork, startWorkAccess, startWorkAskOptions, startWorkAskUi, startWorkAsks, startWorkFits } from "#/generated/actions/start-work";
import { close, closeAccess, closeAskOptions, closeAskUi, closeAsks, closeFits } from "#/generated/actions/close";
import { reopen, reopenAccess, reopenFits } from "#/generated/actions/reopen";
import { messageUi } from "#/generated/message";
import { userOptions } from "#/generated/users";
import { allows, guardPage } from "#/kit/access";
import { ActionButton } from "#/kit/ActionButton";
import { ActivityLog } from "#/kit/ActivityLog";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";
import { Overflow } from "#/kit/Overflow";
import { w } from "#/kit/words";
import { currentViewer } from "#/lib/viewer.server";
import { ModelTable } from "#/kit/ModelTable";

/** The record's lines in the audit log, newest first: administrators only, nobody else. */
const getHistory = createServerFn()
  .validator((id: number) => id)
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    if (viewer?.role !== "admin") return null;
    const people = new Map(db.select({ id: user.id, name: user.name }).from(user).all().map((p) => [p.id, p.name]));
    return db
      .select()
      .from(auditLog)
      .where(and(eq(auditLog.model, "SupportCase"), eq(auditLog.recordId, id)))
      .orderBy(desc(auditLog.id))
      .limit(50)
      .all()
      .map((r) => ({
        id: r.id,
        at: r.at,
        who: r.who === "visitor" || r.who === "the app" ? r.who : (people.get(r.who) ?? (r.who.startsWith("key:") ? w.aKey(r.who.slice(4)) : r.who.startsWith("timer:") ? w.byTimer(r.who.slice(6)) : w.aRemovedUser(r.who))),
        action: r.action,
        fields: r.fields,
        details: r.details ? Object.fromEntries(Object.entries(r.details).map(([k, v]) => [k, String(v)])) : null,
      }));
  });

export const Route = createFileRoute("/cases/$id")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["cases"], context.viewer, location.href),
  head: () => pageHead("cases"),
  loader: async ({ params }) => {
    const found = await getSupportCase({ data: Number(params.id) });
    if (!found) throw notFound();
    return { ...found, options: { assigneeId: await userOptions() }, history: await getHistory({ data: Number(params.id) }) };
  },
  component: SupportCasePage,
});

function SupportCasePage() {
  const { row, canWrite, canDelete, options, history } = Route.useLoaderData();
  const { viewer } = Route.useRouteContext();
  const navigate = useNavigate();
  const router = useRouter();
  const back = () => navigate({ to: "/cases" });
  return (
    <>
      <PageHeader
        title={row.subject || \`Support case #\${row.id}\`}
        actions={
          <Overflow>
            {allows(assignToMeAccess, viewer, row.ownerId) && assignToMeFits(row, viewer) && (
              <ActionButton
                label="Assign to me"
                concept="action:assignToMe"
                onRun={async () => {
                  await assignToMe({ data: row.id });
                  await router.invalidate();
                }}
              />
            )}
            {allows(assignToAccess, viewer, row.ownerId) && assignToFits(row, viewer) && (
              <ActionButton
                label="Assign to"
                concept="action:assignTo"
                ask={{ ui: assignToAskUi, schema: assignToAsks, initial: row, app, loadOptions: assignToAskOptions }}
                onRun={async (values) => {
                  await assignTo({ data: { id: row.id, values: values as never } });
                  await router.invalidate();
                }}
              />
            )}
            {allows(startWorkAccess, viewer, row.ownerId) && startWorkFits(row, viewer) && (
              <ActionButton
                label="Start work"
                concept="action:startWork"
                ask={{ ui: startWorkAskUi, schema: startWorkAsks, initial: row, app, loadOptions: startWorkAskOptions }}
                onRun={async (values) => {
                  await startWork({ data: { id: row.id, values: values as never } });
                  await router.invalidate();
                }}
              />
            )}
            {allows(closeAccess, viewer, row.ownerId) && closeFits(row, viewer) && (
              <ActionButton
                label="Close"
                concept="action:close"
                ask={{ ui: closeAskUi, schema: closeAsks, initial: row, app, loadOptions: closeAskOptions }}
                onRun={async (values) => {
                  await close({ data: { id: row.id, values: values as never } });
                  await router.invalidate();
                }}
              />
            )}
            {allows(reopenAccess, viewer, row.ownerId) && reopenFits(row, viewer) && (
              <ActionButton
                label="Reopen"
                concept="action:reopen"
                onRun={async () => {
                  await reopen({ data: row.id });
                  await router.invalidate();
                }}
              />
            )}
          </Overflow>
        }
      />
      <ModelForm
        key={String(row.updatedAt)}
        ui={supportCaseUi}
        app={app}
        schema={supportCaseSchema}
        initial={row}
        readOnly={!canWrite}
        options={options}
        submitLabel={w.saveChanges}
        onSubmit={async (values) => {
          await updateSupportCase({ data: { id: row.id, values } });
          await back();
        }}
        onCancel={back}
        onDelete={
          canDelete
            ? async (together?: boolean) => {
                await deleteSupportCase({ data: { id: row.id, together } });
                await back();
              }
            : undefined
        }
      />
      <section className="mt-10">
        <div className="mb-3 flex items-center justify-between gap-3">
          <h2 className="text-lg font-semibold">Messages</h2>
          
        </div>
        <ModelTable
          ui={messageUi}
          app={app}
          rows={row.messages}
          hide={["supportCaseId"]}
          emptyMessage={w.noneYet("messages")}
        />
      </section>
      {history && history.length > 0 && (
        <section className="mt-10 max-w-3xl">
          <h2 className="mb-3 text-lg font-semibold">{w.history}</h2>
          <ActivityLog lines={history} app={app} />
        </section>
      )}
    </>
  );
}
"
`;

