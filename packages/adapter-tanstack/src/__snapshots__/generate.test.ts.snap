describe("the audit log", () => {
  test("names who created, changed and deleted a record, and what changed", async () => {
    const viewer = signedIn("admin");
    const made = await serviceData.create(viewer, serviceValues(viewer.id));
    await serviceData.update(viewer, made.id, serviceValues(viewer.id));
    await serviceData.remove(viewer, made.id);
    const lines = db
      .select()
      .from(auditLog)
      .where(and(eq(auditLog.model, "Service"), eq(auditLog.recordId, made.id)))
      .all();
    expect(lines.map((l) => [l.action, l.who, l.role])).toEqual([
      ["created", viewer.id, viewer.role],
      ["changed", viewer.id, viewer.role],
      ["deleted", viewer.id, viewer.role],
    ]);
    // Only the line that deleted it keeps the record's name (its title by then); no field's
    // value is stored.
    expect(lines.map((l) => Boolean(l.title))).toEqual([false, false, true]);
    expect(JSON.stringify(lines[1]?.fields ?? [])).not.toContain(":");

    // Forget in the log: administrators only; it blanks the deleted record's name and is logged by id.
    expect(() => forgetInLog(signedIn("member"), { model: "Service", record: made.id })).toThrow(AccessDenied);
    forgetInLog(signedIn("admin"), { model: "Service", record: made.id });
    const after = db.select().from(auditLog).where(and(eq(auditLog.model, "Service"), eq(auditLog.recordId, made.id))).all();
    expect(after.map((l) => l.title)).toEqual([null, null, null]);
    const forgot = db.select().from(auditLog).where(eq(auditLog.action, "forgotten in the log")).all().at(-1);
    expect(forgot).toMatchObject({ title: null, details: { model: "Service", record: made.id } });
  });

  test("keeps the client's details and a deleted record's name 90 days, and a line 12 months", () => {
    const day = 24 * 60 * 60 * 1000;
    const line = (daysAgo: number) =>
      db
        .insert(auditLog)
        .values({ at: new Date(Date.now() - daysAgo * day), who: "test", action: "deleted", title: "Old", address: "10.0.0.1", browser: "test" })
        .returning()
        .get();
    const recent = line(10);
    const older = line(100);
    const oldest = line(400);
    pruneAudit();
    const row = (id: number) => db.select().from(auditLog).where(eq(auditLog.id, id)).get();
    expect(row(recent.id)).toMatchObject({ title: "Old", address: "10.0.0.1" });
    expect(row(older.id)).toMatchObject({ title: null, address: null, browser: null, action: "deleted" });
    expect(row(oldest.id)).toBeUndefined();
  });
});

describe("Appointment takes its barber's time", () => {
  test("the same time twice is refused", async () => {
    const viewer = signedIn("admin");
    const barberId = insertBarber(viewer.id).id;
    await appointmentData.create(viewer, { ...appointmentValues(viewer.id), barberId });
    await expect(appointmentData.create(viewer, { ...appointmentValues(viewer.id), barberId })).rejects.toThrow(/^not-free:/);
  });
});
"
`;

exports[`../../../examples/barbers/smithable.yml > file list and generated code > src/generated/actions/cancel.server.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { eq } from "drizzle-orm";
import { db } from "#/db";
import * as schema from "#/db/schema";
import { AccessDenied, allows, check, type Viewer } from "#/kit/access";
import { audit } from "#/kit/audit.server";
import { outgoing } from "#/generated/outgoing.server";
import { afterChange } from "#/generated/hooks";
import { appointmentSettable } from "#/generated/appointment.schema";
import { appointmentData } from "#/generated/appointment.server";
import { cancelAccess, cancelFits } from "./cancel";

type Row = NonNullable<Awaited<ReturnType<typeof appointmentData.get>>>;

/** The appointment's new values (only the fields the action sets), worked out on it as it was. */
function plan(_viewer: Viewer | null, row: Row) {
  return {
    id: row.id,
    values: appointmentSettable.partial().parse({
      status: "cancelled",
    }),

  };
}

/** Runs the "cancel" action on the appointment as the viewer. */
export async function runCancel(viewer: Viewer | null, id: number) {
  const row = await appointmentData.get(viewer, id);
  if (!row) throw new AccessDenied(viewer !== null);
  check(cancelAccess, viewer, row.ownerId);
  if (!cancelFits(row, viewer)) throw new Error("This cannot be done now.");
  const one = plan(viewer, row);
  return appointmentData.update(viewer, id, one.values, "cancel", ["status"]);
}

/**
 * Runs the "cancel" action on each chosen appointment it fits and the viewer may run it on
 * (docs/design/actions.md §9); the others are skipped. All or none: one that is refused stops
 * them all, and is named.
 */
export async function runCancelMany(viewer: Viewer | null, ids: number[]) {
  const plans: ReturnType<typeof plan>[] = [];
  // An id given twice is one record, run once.
  const unique = [...new Set(ids)];
  for (const id of unique) {
    const row = await appointmentData.get(viewer, id);
    if (!row || !allows(cancelAccess, viewer, row.ownerId) || !cancelFits(row, viewer)) continue;
    try {
      plans.push(plan(viewer, row));
    } catch (error) {
      const why = error instanceof Error ? error.message : String(error);
      throw new Error(\`Appointment "\${String(row.name ?? row.id)}": \${why}\`);
    }
  }
  const written = db.transaction((tx) => plans.map((p) => {
      const before = tx.select().from(schema.appointments).where(eq(schema.appointments.id, p.id)).get();
      const changed = tx.update(schema.appointments).set(p.values).where(eq(schema.appointments.id, p.id)).returning().get();
      audit(tx, viewer, { action: "cancel", model: "Appointment", record: changed.id, fields: ["status"] });
      outgoing(tx, viewer, "Appointment", "cancel", changed, before);
      const inserted = [

      ] as const;

      return { changed, inserted };
    }));
  for (const w of written) {
    await afterChange("afterUpdate", "Appointment", w.changed, viewer);

  }
  return { changed: plans.length, skipped: unique.length - plans.length };
}
"
`;

exports[`../../../examples/barbers/smithable.yml > file list and generated code > src/generated/actions/cancel.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { z } from "zod";
import type { Rule } from "#/kit/access";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { writeAllowed } from "#/kit/limit";
import { currentViewer } from "#/lib/viewer.server";
import { runCancel, runCancelMany } from "./cancel.server";

/** Who may run the "cancel" action: whoever may edit the appointment. */
export const cancelAccess: Rule = { public: false, roles: ["admin"], owner: true };

/** Whether the "cancel" action fits the appointment: it is offered and allowed only then. */
export function cancelFits(row: { status?: unknown }, _viewer: { id: string } | null): boolean {
  return ["requested","confirmed"].includes(String(row.status));
}

/** The viewer about to run it, counted against how often one may write (see src/kit/limit.ts). */
async function writer() {
  const viewer = await currentViewer();
  writeAllowed(viewer, getRequestHeaders());
  return viewer;
}

export const cancel = createServerFn({ method: "POST" })
  .validator(z.number().int())
  .handler(async ({ data }) => runCancel(await writer(), data));

/** The "cancel" action on the chosen appointments (at most 1,000 at once). */
export const cancelMany = createServerFn({ method: "POST" })
  .validator(z.object({ ids: z.array(z.number().int()).max(1000) }))
  .handler(async ({ data }) => runCancelMany(await writer(), data.ids));
"
`;

