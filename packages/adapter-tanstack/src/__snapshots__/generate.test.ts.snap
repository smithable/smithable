exports[`../../../examples/marketplace/smithable.yml > file list and generated code > src/db/schema.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { index, integer, sqliteTable, text, unique } from "drizzle-orm/sqlite-core";
import type { Picture } from "#/kit/uploads";

export const user = sqliteTable("user", {
  id: text().primaryKey(),
  name: text().notNull(),
  email: text().notNull().unique(),
  emailVerified: integer({ mode: "boolean" }).default(false).notNull(),
  image: text(),
  role: text().notNull().default("member"),
  createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
  updatedAt: integer({ mode: "timestamp_ms" })
    .notNull()
    .$defaultFn(() => new Date())
    .$onUpdate(() => new Date()),
});

export const session = sqliteTable(
  "session",
  {
    id: text().primaryKey(),
    expiresAt: integer({ mode: "timestamp_ms" }).notNull(),
    token: text().notNull().unique(),
    createdAt: integer({ mode: "timestamp_ms" }).notNull(),
    updatedAt: integer({ mode: "timestamp_ms" }).notNull(),
    ipAddress: text(),
    userAgent: text(),
    userId: text()
      .notNull()
      .references(() => user.id, { onDelete: "cascade" }),
  },
  (t) => [index("session_user_id_idx").on(t.userId)],
);

export const account = sqliteTable(
  "account",
  {
    id: text().primaryKey(),
    accountId: text().notNull(),
    providerId: text().notNull(),
    userId: text()
      .notNull()
      .references(() => user.id, { onDelete: "cascade" }),
    accessToken: text(),
    refreshToken: text(),
    idToken: text(),
    accessTokenExpiresAt: integer({ mode: "timestamp_ms" }),
    refreshTokenExpiresAt: integer({ mode: "timestamp_ms" }),
    scope: text(),
    password: text(),
    createdAt: integer({ mode: "timestamp_ms" }).notNull(),
    updatedAt: integer({ mode: "timestamp_ms" }).notNull(),
  },
  (t) => [index("account_user_id_idx").on(t.userId)],
);

export const verification = sqliteTable(
  "verification",
  {
    id: text().primaryKey(),
    identifier: text().notNull(),
    value: text().notNull(),
    expiresAt: integer({ mode: "timestamp_ms" }).notNull(),
    createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
    updatedAt: integer({ mode: "timestamp_ms" })
      .notNull()
      .$defaultFn(() => new Date())
      .$onUpdate(() => new Date()),
  },
  (t) => [index("verification_identifier_idx").on(t.identifier)],
);

export const auditLog = sqliteTable(
  "audit_log",
  {
    id: integer().primaryKey({ autoIncrement: true }),
    at: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
    trace: text(),
    /** A user's id, a key's name, "visitor", or "the app" for its own work. */
    who: text().notNull(),
    role: text(),
    address: text(),
    browser: text(),
    /** created, changed, deleted, copied, or an action's name. */
    action: text().notNull(),
    model: text(),
    recordId: integer(),
    title: text(),
    fields: text({ mode: "json" }).$type<string[]>(),
    details: text({ mode: "json" }).$type<Record<string, unknown>>(),
  },
  (t) => [index("audit_log_at").on(t.at), index("audit_log_record").on(t.model, t.recordId)],
);

export const fileReviews = sqliteTable(
  "file_reviews",
  {
    id: integer().primaryKey({ autoIncrement: true }),
    model: text().notNull(),
    recordId: integer().notNull(),
    field: text().notNull(),
    /** The stored file's name under uploads/ (src/kit/uploads.ts). */
    file: text().notNull(),
    /** pending, approved or rejected. */
    state: text().notNull().default("pending"),
    /** Why it was rejected, shown to the uploader on the record. */
    reason: text(),
    uploadedBy: text(),
    uploadedAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
    decidedBy: text(),
    decidedAt: integer({ mode: "timestamp_ms" }),
  },
  (t) => [
    index("file_reviews_record").on(t.model, t.recordId, t.state),
    index("file_reviews_state").on(t.state, t.uploadedAt),
  ],
);

export const uploads = sqliteTable(
  "uploads",
  {
    id: integer().primaryKey({ autoIncrement: true }),
    /** The stored file's name under uploads/ (src/kit/uploads.ts). */
    file: text().notNull(),
    model: text().notNull(),
    field: text().notNull(),
    /** Who uploaded it; nothing for a visitor. */
    uploader: text(),
    receipt: text().notNull(),
    at: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
  },
  (t) => [index("uploads_receipt").on(t.receipt), index("uploads_at").on(t.at)],
);

export const items = sqliteTable("items", {
  id: integer().primaryKey({ autoIncrement: true }),
  title: text().notNull(),
  photos: text({ mode: "json" }).$type<Picture[]>().notNull(),
  description: text().notNull(),
  price: integer(),
  category: text({ enum: ["furniture", "bikes", "electronics", "sports", "kids", "other"] }).notNull().default("furniture"),
  condition: text({ enum: ["likeNew", "good", "worn"] }).notNull().default("likeNew"),
  place: text(),
  available: integer({ mode: "boolean" }).default(true),
  ownerId: text().references(() => user.id, { onDelete: "set null" }),
  createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
  updatedAt: integer({ mode: "timestamp_ms" })
    .notNull()
    .$defaultFn(() => new Date())
    .$onUpdate(() => new Date()),
});

// The records people marked as favorites: each person's own, never shown to others.
export const itemsFavorites = sqliteTable(
  "items_favorites",
  {
    id: integer().primaryKey({ autoIncrement: true }),
    userId: text()
      .notNull()
      .references(() => user.id, { onDelete: "cascade" }),
    recordId: integer()
      .notNull()
      .references(() => items.id, { onDelete: "cascade" }),
    createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
  },
  (t) => [unique().on(t.userId, t.recordId)],
);
"
`;

exports[`../../../examples/marketplace/smithable.yml > file list and generated code > src/db/seed.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// Sample data for development. Run with \`pnpm db:seed\`; tables that already have rows are left alone.
import { db } from "./index";
import * as schema from "./schema";
import { samplePicture } from "#/kit/uploads";

if (db.select().from(schema.items).limit(1).all().length === 0) {
  db.insert(schema.items)
    .values([
    { title: "Item 1", photos: [samplePicture("item", 0, "A picture of Item 1")].filter((p) => p !== null), description: "A short description of Item 1.", price: 12000, category: "furniture", condition: "likeNew", place: "place 1", available: false },
    { title: "Item 2", photos: [samplePicture("item", 1, "A picture of Item 2"), samplePicture("item", 2, "A picture of Item 2")].filter((p) => p !== null), description: "A short description of Item 2.", price: 48000, category: "bikes", condition: "good", place: "place 2", available: true },
    { title: "Item 3", photos: [samplePicture("item", 2, "A picture of Item 3"), samplePicture("item", 0, "A picture of Item 3"), samplePicture("item", 1, "A picture of Item 3")].filter((p) => p !== null), description: "A short description of Item 3.", price: 125000, category: "electronics", condition: "worn", place: "place 3", available: true },
    { title: "Item 4", photos: [samplePicture("item", 0, "A picture of Item 4")].filter((p) => p !== null), description: "A short description of Item 4.", price: 230000, category: "sports", condition: "likeNew", place: "place 4", available: false },
    { title: "Item 5", photos: [samplePicture("item", 1, "A picture of Item 5"), samplePicture("item", 2, "A picture of Item 5")].filter((p) => p !== null), description: "A short description of Item 5.", price: 7500, category: "kids", condition: "good", place: "place 5", available: true },
    { title: "Item 6", photos: [samplePicture("item", 2, "A picture of Item 6"), samplePicture("item", 0, "A picture of Item 6"), samplePicture("item", 1, "A picture of Item 6")].filter((p) => p !== null), description: "A short description of Item 6.", price: 96000, category: "other", condition: "worn", place: "place 6", available: true },
    { title: "Item 7", photos: [samplePicture("item", 0, "A picture of Item 7")].filter((p) => p !== null), description: "A short description of Item 7.", price: 340000, category: "furniture", condition: "likeNew", place: "place 7", available: false },
    { title: "Item 8", photos: [samplePicture("item", 1, "A picture of Item 8"), samplePicture("item", 2, "A picture of Item 8")].filter((p) => p !== null), description: "A short description of Item 8.", price: 64000, category: "bikes", condition: "good", place: "place 8", available: true },
    ])
    .run();
}
"
`;

exports[`../../../examples/marketplace/smithable.yml > file list and generated code > src/generated/access.test.ts 1`] = `
"// Generated by Smithable from smithable.yml and smithable.auth.yml. Do not edit: this file is overwritten on every change.
// For every model and role: which records a user can read, create, change and delete.
// "Own" records are owned by the user; "others" by someone else.
import { and, eq } from "drizzle-orm";
import { describe, expect, test } from "vitest";
import { db } from "#/db";
import { auditLog, user } from "#/db/schema";
import * as schema from "#/db/schema";
import { AccessDenied, type Viewer } from "#/kit/access";
import { forgetInLog, pruneAudit } from "#/kit/audit.server";
import { receiptFor } from "#/kit/receipts.server";
import { itemData } from "./item.server";

let counter = 0;
const next = () => ++counter;

/** A new signed-in user with the role. */
function signedIn(role: string): Viewer {
  const n = next();
  const viewer = { id: \`test-user-\${n}\`, name: \`Test \${role} \${n}\`, email: \`user\${n}@example.com\`, role };
  db.insert(user).values(viewer).run();
  return viewer;
}

/** Owns the records that are someone else's. */
const stranger = signedIn("member");

/** A test file's receipt, as its upload gives one to \`by\`; none for a record put in directly. */
function receipt(by: string | null | undefined, model: string, field: string, file: string) {
  return by === undefined ? {} : { receipt: receiptFor(by, model, field, file) };
}

/** Whether the action is allowed; any other failure fails the test. */
async function can(action: () => unknown): Promise<boolean> {
  try {
    await action();
    return true;
  } catch (error) {
    if (error instanceof AccessDenied) return false;
    throw error;
  }
}

/** Whether the viewer can open the record and sees it in the list. */
async function reads(
  data: { get(viewer: never, id: number): Promise<unknown>; list(viewer: never): Promise<{ id: number }[]> },
  viewer: unknown,
  id: number,
): Promise<boolean> {
  const listed = await data.list(viewer as never).then(
    (rows) => rows.some((row) => row.id === id),
    (error) => {
      if (error instanceof AccessDenied) return false;
      throw error;
    },
  );
  return listed && (await data.get(viewer as never, id)) !== null;
}

function itemValues(_owner: string | null, by?: string | null) {
  const n = next();
  return { title: \`Item title \${n}\`, photos: [{ file: \`item/\${String(n).padStart(24, "0")}.webp\`, alt: "A test picture", width: 4, height: 3, ...receipt(by, "item", "photos", \`item/\${String(n).padStart(24, "0")}.webp\`) }].slice(), description: \`Item description \${n}\`, price: null, category: "furniture", condition: "likeNew", place: null, available: null } as const;
}

function insertItem(owner: string | null, values: Record<string, unknown> = {}) {
  return db
    .insert(schema.items)
    .values({ ...itemValues(owner), ...values, ownerId: owner })
    .returning()
    .get();
}

describe("Item", () => {
  test("admin", async () => {
    const viewer = signedIn("admin");
    const others = insertItem(stranger.id);
    const own = insertItem(viewer.id);
    expect({
      readOthers: await reads(itemData, viewer, others.id),
      readOwn: await reads(itemData, viewer, own.id),
      create: await can(() => itemData.create(viewer, itemValues(viewer.id, viewer.id))),
      changeOthers: await can(() => itemData.update(viewer, others.id, itemValues(stranger.id, viewer.id))),
      changeOwn: await can(() => itemData.update(viewer, own.id, itemValues(viewer.id, viewer.id))),
      deleteOthers: await can(() => itemData.remove(viewer, others.id)),
      deleteOwn: await can(() => itemData.remove(viewer, own.id)),
    }).toEqual({
      readOthers: true,
      readOwn: true,
      create: true,
      changeOthers: true,
      changeOwn: true,
      deleteOthers: true,
      deleteOwn: true,
    });
  });

  test("member", async () => {
    const viewer = signedIn("member");
    const others = insertItem(stranger.id);
    const own = insertItem(viewer.id);
    expect({
      readOthers: await reads(itemData, viewer, others.id),
      readOwn: await reads(itemData, viewer, own.id),
      create: await can(() => itemData.create(viewer, itemValues(viewer.id, viewer.id))),
      changeOthers: await can(() => itemData.update(viewer, others.id, itemValues(stranger.id, viewer.id))),
      changeOwn: await can(() => itemData.update(viewer, own.id, itemValues(viewer.id, viewer.id))),
      deleteOthers: await can(() => itemData.remove(viewer, others.id)),
      deleteOwn: await can(() => itemData.remove(viewer, own.id)),
    }).toEqual({
      readOthers: true,
      readOwn: true,
      create: true,
      changeOthers: false,
      changeOwn: true,
      deleteOthers: false,
      deleteOwn: true,
    });
  });

  test("a visitor who has not signed in", async () => {
    const viewer = null;
    const others = insertItem(stranger.id);
    expect({
      readOthers: await reads(itemData, viewer, others.id),
      readOwn: false,
      create: await can(() => itemData.create(viewer, itemValues(null, null))),
      changeOthers: await can(() => itemData.update(viewer, others.id, itemValues(stranger.id, null))),
      changeOwn: false,
      deleteOthers: await can(() => itemData.remove(viewer, others.id)),
      deleteOwn: false,
    }).toEqual({
      readOthers: true,
      readOwn: false,
      create: false,
      changeOthers: false,
      changeOwn: false,
      deleteOthers: false,
      deleteOwn: false,
    });
  });
});

describe("the audit log", () => {
  test("names who created, changed and deleted a record, and what changed", async () => {
    const viewer = signedIn("admin");
    const made = await itemData.create(viewer, itemValues(viewer.id, viewer.id));
    await itemData.update(viewer, made.id, itemValues(viewer.id, viewer.id));
    await itemData.remove(viewer, made.id);
    const lines = db
      .select()
      .from(auditLog)
      .where(and(eq(auditLog.model, "Item"), eq(auditLog.recordId, made.id)))
      .all();
    expect(lines.map((l) => [l.action, l.who, l.role])).toEqual([
      ["created", viewer.id, viewer.role],
      ["changed", viewer.id, viewer.role],
      ["deleted", viewer.id, viewer.role],
    ]);
    // Only the line that deleted it keeps the record's name (its title by then); no field's
    // value is stored.
    expect(lines.map((l) => Boolean(l.title))).toEqual([false, false, true]);
    expect(JSON.stringify(lines[1]?.fields ?? [])).not.toContain(":");

    // Forget in the log: administrators only; it blanks the deleted record's name and is logged by id.
    expect(() => forgetInLog(signedIn("member"), { model: "Item", record: made.id })).toThrow(AccessDenied);
    forgetInLog(signedIn("admin"), { model: "Item", record: made.id });
    const after = db.select().from(auditLog).where(and(eq(auditLog.model, "Item"), eq(auditLog.recordId, made.id))).all();
    expect(after.map((l) => l.title)).toEqual([null, null, null]);
    const forgot = db.select().from(auditLog).where(eq(auditLog.action, "forgotten in the log")).all().at(-1);
    expect(forgot).toMatchObject({ title: null, details: { model: "Item", record: made.id } });
  });

  test("keeps the client's details and a deleted record's name 90 days, and a line 12 months", () => {
    const day = 24 * 60 * 60 * 1000;
    const line = (daysAgo: number) =>
      db
        .insert(auditLog)
        .values({ at: new Date(Date.now() - daysAgo * day), who: "test", action: "deleted", title: "Old", address: "10.0.0.1", browser: "test" })
        .returning()
        .get();
    const recent = line(10);
    const older = line(100);
    const oldest = line(400);
    pruneAudit();
    const row = (id: number) => db.select().from(auditLog).where(eq(auditLog.id, id)).get();
    expect(row(recent.id)).toMatchObject({ title: "Old", address: "10.0.0.1" });
    expect(row(older.id)).toMatchObject({ title: null, address: null, browser: null, action: "deleted" });
    expect(row(oldest.id)).toBeUndefined();
  });
});
"
`;

