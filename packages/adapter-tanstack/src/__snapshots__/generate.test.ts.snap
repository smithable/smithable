export const Route = createFileRoute("/admin/class-types/$id")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["admin"], context.viewer, location.href),
  loader: async ({ params }) => {
    const found = await getClassType({ data: Number(params.id) });
    if (!found) throw notFound();
    return { ...found };
  },
  component: ClassTypePage,
});

function ClassTypePage() {
  const { row, canWrite, canDelete } = Route.useLoaderData();
  const navigate = useNavigate();
  const back = () => navigate({ to: "/admin/class-types" });
  return (
    <>
      <PageHeader title={row.name || \`Class type #\${row.id}\`} />
      <ModelForm
        ui={classTypeUi}
        app={app}
        schema={classTypeSchema}
        initial={row}
        readOnly={!canWrite}
        submitLabel="Save changes"
        onSubmit={async (values) => {
          await updateClassType({ data: { id: row.id, values } });
          await back();
        }}
        onCancel={back}
        onDelete={
          canDelete
            ? async () => {
                await deleteClassType({ data: row.id });
                await back();
              }
            : undefined
        }
      />

    </>
  );
}
"
