            search: query.get("search") ?? undefined,
            sort: query.get("sort") ?? undefined,
            limit: 10_000,
          });
          return new Response(csvOf(taskUi, items as never), {
            headers: {
              "Content-Type": "text/csv; charset=utf-8",
              "Content-Disposition": 'attachment; filename="tasks.csv"',
            },
          });
        }),
    },
  },
});
"
`;

