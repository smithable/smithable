"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createInsertSchema } from "drizzle-zod";
import { z } from "zod";
import * as schema from "#/db/schema";
import { w } from "#/kit/words";

/** What a post may be given: a form's values and what the app fills (an action's set). */
export const postSettable = createInsertSchema(schema.posts, {
  title: (s) => s.trim().min(1, w.required).max(200, w.atMostCharacters(200)),
  address: (s) => s.max(200, w.atMostCharacters(200)),
  summary: (s) => s.max(10000, w.atMostCharacters(10000)),
  cover: z.object({ file: z.string().regex(/^post\\/[a-f0-9]{24}\\.webp$/), alt: z.string().trim().max(200), width: z.int().positive(), height: z.int().positive(), generated: z.literal(true).optional(), receipt: z.string().max(64).optional() }).nullish(),
  body: (s) => s.trim().min(1, w.required).max(50000, w.atMostCharacters(50000)),
  publishedOn: (s) => s.regex(/^\\d{4}-\\d{2}-\\d{2}$/, w.enterValidDate),
}).omit({ id: true, ownerId: true, createdAt: true, updatedAt: true });
/** What a post's form sends, checked. */
export const postSchema = postSettable;

export type PostSettable = z.output<typeof postSettable>;
export type PostValues = z.output<typeof postSchema>;
"
`;

