export const incidentUpdateAccess: ModelAccess = {
  read: { public: true, roles: ["admin", "staff"], owner: false },
  create: { public: false, roles: ["admin", "staff"], owner: false },
  write: { public: false, roles: ["admin", "staff"], owner: true },
  delete: { public: false, roles: ["admin"], owner: true },
};

/** A record as the viewer gets it: who owns it only for its owner and roles that read every record. */
function shownTo<R extends { ownerId: string | null }>(viewer: Viewer | null, row: R): R {
  if (viewer && (row.ownerId === viewer.id || incidentUpdateAccess.read.roles.includes(viewer.role))) return row;
