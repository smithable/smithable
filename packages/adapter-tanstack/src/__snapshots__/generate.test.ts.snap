"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { and, asc, eq, sql, type SQL } from "drizzle-orm";
import { db } from "#/db";
import { clients } from "#/db/schema";
import { AccessDenied, check, type ModelAccess, readScope, refusal, type Viewer } from "#/kit/access";
import { contains } from "#/kit/search";
import { afterChange, afterDelete } from "./hooks";
import { invoiceData } from "./invoice.server";
import type { ClientValues } from "./client";

/** Who may read, create, change and delete clients. */
export const clientAccess: ModelAccess = {
  read: { public: false, roles: ["admin"], owner: true },
  create: { public: false, roles: ["admin", "member"], owner: false },
  write: { public: false, roles: ["admin"], owner: true },
  delete: { public: false, roles: ["admin"], owner: true },
};

export const clientData = {
  /** A condition for the clients the viewer may read. */
  readable(viewer: Viewer | null) {
    const scope = readScope(clientAccess.read, viewer);
    if (scope === "all") return undefined;
    return scope === "own" && viewer ? eq(clients.ownerId, viewer.id) : sql\`false\`;
  },

  canRead(viewer: Viewer | null, id: number): boolean {
    const found = db
      .select({ id: clients.id })
      .from(clients)
      .where(and(eq(clients.id, id), clientData.readable(viewer)))
      .get();
    return found !== undefined;
  },

  /** The clients the viewer may read; \`where\` narrows them, e.g. to a search. */
  async list(viewer: Viewer | null, where?: SQL) {
    if (readScope(clientAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const rows = await db.query.clients.findMany({
      where: and(clientData.readable(viewer), where),
      orderBy: (t, { desc }) => [desc(t.id)],
    });
    return rows;
  },

  async get(viewer: Viewer | null, id: number) {
    const row = await db.query.clients.findFirst({
      where: and(eq(clients.id, id), clientData.readable(viewer)),
      with: { invoices: { where: invoiceData.readable(viewer) } },
    });
    return row ? row : null;
  },

  async create(viewer: Viewer | null, values: ClientValues) {
    check(clientAccess.create, viewer);
    let row: typeof clients.$inferSelect;
    try {
      row = db.insert(clients).values({ ...values, ownerId: viewer?.id ?? null }).returning().get();
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterCreate", "Client", row, viewer);
    return row;
  },

  async update(viewer: Viewer | null, id: number, values: ClientValues) {
    const row = db
      .select({ ownerId: clients.ownerId })
      .from(clients)
      .where(and(eq(clients.id, id), clientData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(clientAccess.write, viewer, row.ownerId);
    let changed: typeof clients.$inferSelect;
    const updated = values;
    try {
      changed = db.update(clients).set(updated).where(eq(clients.id, id)).returning().get();
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterUpdate", "Client", changed, viewer);
    return changed;
  },

  async remove(viewer: Viewer | null, id: number): Promise<void> {
    const row = db
      .select({ ownerId: clients.ownerId })
      .from(clients)
      .where(and(eq(clients.id, id), clientData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(clientAccess.delete, viewer, row.ownerId);
    try {
      db.delete(clients).where(eq(clients.id, id)).run();
    } catch (error) {
      throw refusal(error);
    }
    await afterDelete("Client", id, viewer);
  },

  /**
   * The clients the viewer may read whose name contains the text: a search of records that
   * refer to them finds them only among these.
   */
  titled(viewer: Viewer | null, text: string): number[] {
    return db
      .select({ id: clients.id })
      .from(clients)
      .where(and(contains([clients.name], text), clientData.readable(viewer)))
      .all()
      .map((row) => row.id);
  },

  /** Choices for fields that refer to a client: the ones the viewer may read. */
  options(viewer: Viewer | null) {
    if (readScope(clientAccess.read, viewer) === "none") return [];
    return db
      .select({ value: clients.id, label: clients.name })
      .from(clients)
      .where(clientData.readable(viewer))
      .orderBy(asc(clients.name))
      .all();
  },
};
"
`;

