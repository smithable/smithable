"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, Link, useNavigate } from "@tanstack/react-router";
import { pageAccess } from "#/generated/pages";
import { guardPage, allows } from "#/kit/access";
import { createServerFn } from "@tanstack/react-start";
import { z } from "zod";
import { classTypes } from "#/db/schema";
import { classTypeAccess, classTypeData } from "#/generated/class-type.server";
import { contains } from "#/kit/search";
import { currentViewer } from "#/lib/viewer.server";
import { buttonVariants } from "#/components/ui/button";
import { app } from "#/generated/app";
import { classTypeUi } from "#/generated/class-type";
import { PageHeader } from "#/kit/AppShell";
import { ModelTable } from "#/kit/ModelTable";
import { SearchBox } from "#/kit/SearchBox";

/** The class types matching the search, among those the viewer may read. */
const searchClassTypes = createServerFn()
  .validator(z.object({ q: z.string().max(200).optional() }))
  .handler(async ({ data }) => {
    const viewer = await currentViewer();
    const where = data.q ? contains([classTypes.name, classTypes.summary, classTypes.level], data.q) : undefined;
    const rows = await classTypeData.list(viewer, where, 501);
    return {
      rows: rows.slice(0, 500),
      more: rows.length > 500,
      canCreate: allows(classTypeAccess.create, viewer),
    };
  });

export const Route = createFileRoute("/admin/class-types/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["admin"], context.viewer, location.href),
  validateSearch: z.object({ q: z.string().optional().catch(undefined) }),
  loaderDeps: ({ search }) => ({ q: search.q }),
  loader: ({ deps }) => searchClassTypes({ data: { q: deps.q } }),
  component: AdminClassTypesPage,
});

function AdminClassTypesPage() {
  const { rows, canCreate, more } = Route.useLoaderData();
  const { q } = Route.useSearch();
  const navigate = useNavigate();
  const newButton = canCreate && (
    <Link to="/admin/class-types/new" className={buttonVariants()}>
      New class type
    </Link>
  );
  return (
    <>
      <PageHeader
        title="Class types"
        actions={newButton}
      />
      <SearchBox
        value={q ?? ""}
        placeholder="Search by name, summary or level"
        onSearch={(text) => navigate({ to: "/admin/class-types", search: { q: text || undefined }, replace: true })}
      />
      {more && (
        <p className="text-sm text-muted-foreground">The newest 500 are shown; search to find the others.</p>
      )}
      <ModelTable
        ui={classTypeUi}
        app={app}
        rows={rows}
        emptyMessage={q ? \`No class types match “\${q}”.\` : undefined}
        emptyAction={newButton || undefined}
        onOpen={(row) => navigate({ to: "/admin/class-types/$id", params: { id: String(row.id) } })}
      />
    </>
  );
}
"
`;

