"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// The examples of InvoiceLine's formulas in smithable.yml.
import { describe, expect, test } from "vitest";
import { invoiceLineFormulas } from "./invoice-line.formulas";

describe("InvoiceLine.amount", () => {
  test("quantity 3, unitPrice 40 gives 120", () => {
    expect(invoiceLineFormulas.amount({ quantity: 3, unitPrice: 4000 })).toBe(12000);
  });

  test("quantity 0.5, unitPrice 19.99 gives 10", () => {
