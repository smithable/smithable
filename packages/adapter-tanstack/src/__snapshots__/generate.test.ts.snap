  name: (s) => s.trim().min(1, w.required).max(200, w.atMostCharacters(200)),
  email: z.email(w.enterValidEmail),
  message: (s) => s.trim().min(1, w.required).max(2000, w.atMostCharacters(2000)),
}).omit({ id: true, ownerId: true, createdAt: true, updatedAt: true });

