const FILTERABLE: Record<string, Filterable> = {
  incident: { kind: "reference", column: schema.incidentUpdates.incidentId, title: { table: schema.incidents, column: schema.incidents.title } },
  at: { kind: "instant", column: schema.incidentUpdates.at },
  status: { kind: "choice", column: schema.incidentUpdates.status, values: ["investigating","identified","monitoring","resolved"] },
  message: { kind: "text", column: schema.incidentUpdates.message },
