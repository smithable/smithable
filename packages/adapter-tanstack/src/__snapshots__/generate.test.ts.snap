"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { z } from "zod";
import type * as schema from "#/db/schema";
import { allows, type Rule } from "#/kit/access";
import type { RecordUi } from "#/kit/model";
import { businessProfileAccess, businessProfileData } from "./business-profile.server";
import { writeAllowed } from "#/kit/limit";
import { currentViewer } from "#/lib/viewer.server";
import { businessProfileSchema } from "./business-profile.schema";

export type { BusinessProfileSettable, BusinessProfileValues } from "./business-profile.schema";

/** The viewer about to write, counted against how often one may (see src/kit/limit.ts). */
async function writer() {
  const viewer = await currentViewer();
  writeAllowed(viewer, getRequestHeaders());
  return viewer;
}

/** BusinessProfile records as the kit reads them. */
export type BusinessProfileRow = typeof schema.businessProfiles.$inferSelect;

export const businessProfileUi: RecordUi<BusinessProfileRow> = {
  model: "BusinessProfile",
  label: "Business profile",
  pluralLabel: "Business profiles",
  titleField: "businessName",
  columns: ["businessName", "paymentTermDays", "vatNumber", "iban"],
  fields: [
    {
      name: "businessName",
      label: "Business name",
      kind: "string",
      required: true,
      get: (row) => row.businessName,
    },
    {
      name: "vatNumber",
      label: "Vat number",
      kind: "string",
      required: false,
      get: (row) => row.vatNumber,
    },
    {
      name: "iban",
      label: "Iban",
      kind: "string",
      required: false,
      get: (row) => row.iban,
    },
    {
      name: "paymentTermDays",
      label: "Payment term days",
      kind: "int",
      required: true,
      default: 30,
      get: (row) => row.paymentTermDays,
    },
    {
      name: "invoiceFooter",
      label: "Invoice footer",
      kind: "text",
      required: false,
      get: (row) => row.invoiceFooter,
    },
  ],
};

/** Who may delete business profiles: a list's selection offers Delete by it (the server checks again). */
export const businessProfileDeleteRule: Rule = { public: false, roles: ["admin"], owner: true };


export const listBusinessProfiles = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return { rows: await businessProfileData.list(viewer), canCreate: allows(businessProfileAccess.create, viewer) };
});

export const getBusinessProfile = createServerFn()
  .validator(z.number().int())
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    const row = await businessProfileData.get(viewer, id);
    if (!row) return null;
    return {
      row,
      canWrite: allows(businessProfileAccess.write, viewer, row.ownerId),
      canDelete: allows(businessProfileAccess.delete, viewer, row.ownerId),
    };
  });

export const createBusinessProfile = createServerFn({ method: "POST" })
  .validator(businessProfileSchema)
  .handler(async ({ data }) => businessProfileData.create(await writer(), data));

export const updateBusinessProfile = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), values: businessProfileSchema }))
  .handler(async ({ data }) => businessProfileData.update(await writer(), data.id, data.values));

/** Deletes a business profile; \`together\` takes what points to it along (docs/design/delete-together.md). */
export const deleteBusinessProfile = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), together: z.boolean().optional() }))
  .handler(async ({ data }) => businessProfileData.remove(await writer(), data.id, data.together));

/** Deletes the chosen business profiles, all or none (at most 1,000 at once). */
export const deleteBusinessProfiles = createServerFn({ method: "POST" })
  .validator(z.object({ ids: z.array(z.number().int()).max(1000), together: z.boolean().optional() }))
  .handler(async ({ data }) => businessProfileData.removeMany(await writer(), data.ids, data.together));
"
`;

