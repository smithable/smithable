"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { z } from "zod";
import type * as schema from "#/db/schema";
import { allows, type Rule } from "#/kit/access";
import type { RecordUi } from "#/kit/model";
import { bindPicture } from "#/kit/PictureInput";
import { barberAccess, barberData } from "./barber.server";
import { timeOffAccess } from "./time-off.server";
import { writeAllowed } from "#/kit/limit";
import { currentViewer } from "#/lib/viewer.server";
import { barberSchema } from "./barber.schema";

export type { BarberSettable, BarberValues } from "./barber.schema";

/** The viewer about to write, counted against how often one may (see src/kit/limit.ts). */
async function writer() {
  const viewer = await currentViewer();
  writeAllowed(viewer, getRequestHeaders());
  return viewer;
}

/** Barber records as the kit reads them. */
export type BarberRow = typeof schema.barbers.$inferSelect;

export const barberUi: RecordUi<BarberRow> = {
  model: "Barber",
  label: "Barber",
  pluralLabel: "Barbers",
  titleField: "name",
  columns: ["name", "portrait"],
  fields: [
    {
      name: "name",
      label: "Name",
      kind: "string",
      required: true,
      get: (row) => row.name,
    },
    {
      name: "bio",
      label: "Bio",
      kind: "text",
      required: false,
      get: (row) => row.bio,
    },
    {
      name: "portrait",
      label: "Portrait",
      kind: "picture",
      required: false,
      input: bindPicture("barber", "portrait"),
      get: (row) => row.portrait,
    },
  ],
};

/** Who may delete barbers: a list's selection offers Delete by it (the server checks again). */
export const barberDeleteRule: Rule = { public: false, roles: ["admin"], owner: true };


export const listBarbers = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return { rows: await barberData.list(viewer), canCreate: allows(barberAccess.create, viewer) };
});

export const getBarber = createServerFn()
  .validator(z.number().int())
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    const row = await barberData.get(viewer, id);
    if (!row) return null;
    return {
      row,
      canWrite: allows(barberAccess.write, viewer, row.ownerId),
      canDelete: allows(barberAccess.delete, viewer, row.ownerId),
      // Who may add to its related lists from here ("Add line" on an invoice).
      canAdd: { timeOffs: allows(timeOffAccess.create, viewer) },
    };
  });

/** Choices for fields that refer to a barber. */
export const barberOptions = createServerFn().handler(async () =>
  barberData.options(await currentViewer()),
);

export const createBarber = createServerFn({ method: "POST" })
  .validator(barberSchema)
  .handler(async ({ data }) => barberData.create(await writer(), data));

export const updateBarber = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), values: barberSchema }))
  .handler(async ({ data }) => barberData.update(await writer(), data.id, data.values));

/** Deletes a barber; \`together\` takes what points to it along (docs/design/delete-together.md). */
export const deleteBarber = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), together: z.boolean().optional() }))
  .handler(async ({ data }) => barberData.remove(await writer(), data.id, data.together));

/** Deletes the chosen barbers, all or none (at most 1,000 at once). */
export const deleteBarbers = createServerFn({ method: "POST" })
  .validator(z.object({ ids: z.array(z.number().int()).max(1000), together: z.boolean().optional() }))
  .handler(async ({ data }) => barberData.removeMany(await writer(), data.ids, data.together));
"
`;

