exports[`../../../examples/invoicing/smithable.yml > file list and generated code > src/db/schema.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { relations } from "drizzle-orm";
import { index, integer, real, sqliteTable, text, unique } from "drizzle-orm/sqlite-core";
import type { StoredFile } from "#/kit/uploads";

export const user = sqliteTable("user", {
  id: text().primaryKey(),
  name: text().notNull(),
  email: text().notNull().unique(),
  emailVerified: integer({ mode: "boolean" }).default(false).notNull(),
  image: text(),
  role: text().notNull().default("member"),
  createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
  updatedAt: integer({ mode: "timestamp_ms" })
    .notNull()
    .$defaultFn(() => new Date())
    .$onUpdate(() => new Date()),
});

export const session = sqliteTable(
  "session",
  {
    id: text().primaryKey(),
    expiresAt: integer({ mode: "timestamp_ms" }).notNull(),
    token: text().notNull().unique(),
    createdAt: integer({ mode: "timestamp_ms" }).notNull(),
    updatedAt: integer({ mode: "timestamp_ms" }).notNull(),
    ipAddress: text(),
    userAgent: text(),
    userId: text()
      .notNull()
      .references(() => user.id, { onDelete: "cascade" }),
  },
  (t) => [index("session_user_id_idx").on(t.userId)],
);

export const account = sqliteTable(
  "account",
  {
    id: text().primaryKey(),
    accountId: text().notNull(),
    providerId: text().notNull(),
    userId: text()
      .notNull()
      .references(() => user.id, { onDelete: "cascade" }),
    accessToken: text(),
    refreshToken: text(),
    idToken: text(),
    accessTokenExpiresAt: integer({ mode: "timestamp_ms" }),
    refreshTokenExpiresAt: integer({ mode: "timestamp_ms" }),
    scope: text(),
    password: text(),
    createdAt: integer({ mode: "timestamp_ms" }).notNull(),
    updatedAt: integer({ mode: "timestamp_ms" }).notNull(),
  },
  (t) => [index("account_user_id_idx").on(t.userId)],
);

export const verification = sqliteTable(
  "verification",
  {
    id: text().primaryKey(),
    identifier: text().notNull(),
    value: text().notNull(),
    expiresAt: integer({ mode: "timestamp_ms" }).notNull(),
    createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
    updatedAt: integer({ mode: "timestamp_ms" })
      .notNull()
      .$defaultFn(() => new Date())
      .$onUpdate(() => new Date()),
  },
  (t) => [index("verification_identifier_idx").on(t.identifier)],
);

export const auditLog = sqliteTable(
  "audit_log",
  {
    id: integer().primaryKey({ autoIncrement: true }),
    at: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
    trace: text(),
    /** A user's id, a key's name, "visitor", or "the app" for its own work. */
    who: text().notNull(),
    role: text(),
    address: text(),
    browser: text(),
    /** created, changed, deleted, copied, or an action's name. */
    action: text().notNull(),
    model: text(),
    recordId: integer(),
    title: text(),
    fields: text({ mode: "json" }).$type<string[]>(),
    details: text({ mode: "json" }).$type<Record<string, unknown>>(),
  },
  (t) => [index("audit_log_at").on(t.at), index("audit_log_record").on(t.model, t.recordId)],
);

export const uploads = sqliteTable(
  "uploads",
  {
    id: integer().primaryKey({ autoIncrement: true }),
    /** The stored file's name under uploads/ (src/kit/uploads.ts). */
    file: text().notNull(),
    model: text().notNull(),
    field: text().notNull(),
    /** Who uploaded it; nothing for a visitor. */
    uploader: text(),
    receipt: text().notNull(),
    at: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
  },
  (t) => [index("uploads_receipt").on(t.receipt), index("uploads_at").on(t.at)],
);

export const outgoingMail = sqliteTable(
  "outgoing_mail",
  {
    id: integer().primaryKey({ autoIncrement: true }),
    createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
    /** The outgoing entry's name in smithable.yml. */
    entry: text().notNull(),
    model: text().notNull(),
    recordId: integer().notNull(),
    to: text().notNull(),
    subject: text().notNull(),
    text: text().notNull(),
    tries: integer().notNull().default(0),
    nextAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
    sentAt: integer({ mode: "timestamp_ms" }),
    /** Given up after a day of tries; "Send again" in Activity clears it. */
    failedAt: integer({ mode: "timestamp_ms" }),
    error: text(),
  },
  (t) => [index("outgoing_mail_due").on(t.sentAt, t.failedAt, t.nextAt)],
);

export const outgoingCall = sqliteTable(
  "outgoing_call",
  {
    id: integer().primaryKey({ autoIncrement: true }),
    createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
    entry: text().notNull(),
    model: text().notNull(),
    recordId: integer().notNull(),
    /** The target's name; its address and secret are OUTGOING_<TARGET>_URL and _SECRET. */
    target: text().notNull(),
    body: text().notNull(),
    tries: integer().notNull().default(0),
    nextAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
    sentAt: integer({ mode: "timestamp_ms" }),
    failedAt: integer({ mode: "timestamp_ms" }),
    /** The answer's status, or why there was none. */
    status: integer(),
    error: text(),
  },
  (t) => [index("outgoing_call_due").on(t.sentAt, t.failedAt, t.nextAt)],
);

export const businessProfiles = sqliteTable("business_profiles", {
  id: integer().primaryKey({ autoIncrement: true }),
  businessName: text().notNull(),
  vatNumber: text(),
  iban: text(),
  paymentTermDays: integer().notNull().default(30),
  invoiceFooter: text(),
  ownerId: text().references(() => user.id, { onDelete: "set null" }),
  createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
  updatedAt: integer({ mode: "timestamp_ms" })
    .notNull()
    .$defaultFn(() => new Date())
    .$onUpdate(() => new Date()),
});

export const clients = sqliteTable("clients", {
  id: integer().primaryKey({ autoIncrement: true }),
  name: text().notNull(),
  email: text().notNull(),
  address: text(),
  vatNumber: text(),
  ownerId: text().references(() => user.id, { onDelete: "set null" }),
  createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
  updatedAt: integer({ mode: "timestamp_ms" })
    .notNull()
    .$defaultFn(() => new Date())
    .$onUpdate(() => new Date()),
});

// Records are private to their owner, so unique values are unique per owner.
export const invoices = sqliteTable(
  "invoices",
  {
    id: integer().primaryKey({ autoIncrement: true }),
    number: text().notNull(),
    clientId: integer().notNull().references(() => clients.id, { onDelete: "restrict" }),
    issuedOn: text().notNull(),
    dueOn: text().notNull(),
    status: text({ enum: ["draft", "sent", "paid", "overdue"] }).notNull().default("draft"),
    contract: text({ mode: "json" }).$type<StoredFile>(),
    total: integer(),
    ownerId: text().references(() => user.id, { onDelete: "set null" }),
    createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
    updatedAt: integer({ mode: "timestamp_ms" })
      .notNull()
      .$defaultFn(() => new Date())
      .$onUpdate(() => new Date()),
  },
  (t) => [unique().on(t.ownerId, t.number)],
);

export const invoiceLines = sqliteTable("invoice_lines", {
  id: integer().primaryKey({ autoIncrement: true }),
  invoiceId: integer().notNull().references(() => invoices.id, { onDelete: "restrict" }),
  description: text().notNull(),
  quantity: real().notNull().default(1),
  unitPrice: integer().notNull(),
  amount: integer(),
  ownerId: text().references(() => user.id, { onDelete: "set null" }),
  createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
  updatedAt: integer({ mode: "timestamp_ms" })
    .notNull()
    .$defaultFn(() => new Date())
    .$onUpdate(() => new Date()),
});

export const clientsRelations = relations(clients, ({ many }) => ({
  invoices: many(invoices),
}));

export const invoicesRelations = relations(invoices, ({ one, many }) => ({
  client: one(clients, { fields: [invoices.clientId], references: [clients.id] }),
  lines: many(invoiceLines),
}));

export const invoiceLinesRelations = relations(invoiceLines, ({ one }) => ({
  invoice: one(invoices, { fields: [invoiceLines.invoiceId], references: [invoices.id] }),
}));
"
`;

