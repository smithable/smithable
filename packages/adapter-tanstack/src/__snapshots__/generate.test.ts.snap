/** What a client may be given: a form's values and what the app fills (an action's set). */
export const clientSettable = createInsertSchema(schema.clients, {
  name: (s) => s.trim().min(1, w.required).max(200, w.atMostCharacters(200)),
  email: z.email(w.enterValidEmail),
  address: (s) => s.max(10000, w.atMostCharacters(10000)),
  vatNumber: (s) => s.max(200, w.atMostCharacters(200)),
}).omit({ id: true, ownerId: true, createdAt: true, updatedAt: true });
/** What a client's form sends, checked. */
export const clientSchema = clientSettable;

export type ClientSettable = z.output<typeof clientSettable>;
export type ClientValues = z.output<typeof clientSchema>;
"
`;

