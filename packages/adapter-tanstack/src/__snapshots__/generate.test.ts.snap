import { createFileRoute, notFound, useNavigate } from "@tanstack/react-router";
import { app } from "#/generated/app";
import { pageAccess } from "#/generated/pages";
import { deleteInvoiceLine, getInvoiceLine, invoiceLineSchema, invoiceLineUi, updateInvoiceLine } from "#/generated/invoice-line";
import { invoiceOptions } from "#/generated/invoice";
import { guardPage } from "#/kit/access";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";

export const Route = createFileRoute("/invoice-lines/$id")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["invoice-lines"], context.viewer, location.href),
  loader: async ({ params }) => {
    const found = await getInvoiceLine({ data: Number(params.id) });
    if (!found) throw notFound();
    return { ...found, options: { invoiceId: await invoiceOptions() } };
  },
  component: InvoiceLinePage,
});

function InvoiceLinePage() {
  const { row, canWrite, canDelete, options } = Route.useLoaderData();
  const navigate = useNavigate();
  const back = () => navigate({ to: "/invoice-lines" });
  return (
    <>
      <PageHeader title={row.description || \`Invoice line #\${row.id}\`} />
      <ModelForm
        ui={invoiceLineUi}
        app={app}
        schema={invoiceLineSchema}
        initial={row}
        readOnly={!canWrite}
        options={options}
        submitLabel="Save changes"
        onSubmit={async (values) => {
          await updateInvoiceLine({ data: { id: row.id, values } });
          await back();
        }}
        onCancel={back}
        onDelete={
          canDelete
            ? async () => {
                await deleteInvoiceLine({ data: row.id });
                await back();
              }
            : undefined
        }
      />

    </>
  );
}
"
`;

