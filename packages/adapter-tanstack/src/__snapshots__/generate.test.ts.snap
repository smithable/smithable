exports[`../../../examples/booking/smithable.yml > file list and generated code > src/routes/index.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute } from "@tanstack/react-router";
import { pageAccess } from "#/generated/pages";
import { guardPage } from "#/kit/access";
import { LandingLayout, Hero, RecordCards, Section, CallToAction, Contact } from "#/kit/Landing";
import { site } from "#/generated/site";
import { listClassTypes } from "#/generated/class-type";
import { listPosts } from "#/generated/post";
import { Calendar, BookOpen } from "lucide-react";
import { Calculator } from "#/kit/Calculator";
import { homeEstimateCalculatorUi } from "#/generated/home-estimate-calculator";
import { app } from "#/generated/app";
import { createMessage, messageSchema, messageUi } from "#/generated/message";
import { ModelForm } from "#/kit/ModelForm";

export const Route = createFileRoute("/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["home"], context.viewer, location.href),
  loader: async () => ({ classTypes: (await listClassTypes()).rows, posts: (await listPosts()).rows }),
  component: HomePage,
});

function HomePage() {
  const data = Route.useLoaderData();
  const { viewer } = Route.useRouteContext();
  return (
    <LandingLayout appName="Stillwater Yoga" link={viewer ? { to: "/schedule", label: "Open Stillwater Yoga" } : { to: "/sign-in", label: "Sign in" }} footer={{ links: [], texts: "pages.home.footer" }} site={site}>
      <Hero
          texts="pages.home.hero"
          title="Stillwater Yoga"
          subtitle="Class schedule and online booking for a small yoga studio."
          link={{ to: "/schedule", label: "Get started" }}
          shortcuts={[{ to: "/schedule", label: "Schedule", icon: Calendar }, { to: "/blog", label: "Blog", icon: BookOpen }]}
          more
        />
      <RecordCards
          texts="pages.home.classes"
          id="classes"
          title="Class types"
          cards={data.classTypes.slice(0, 6).map((row) => ({
            key: row.id,
            title: String(row.name),
            text: row.summary ?? undefined,
            badge: ({ beginner: "Beginner", allLevels: "All levels", advanced: "Advanced" } as Record<string, string>)[row.level],
          }))}
        />
      <Section
          texts="pages.home.estimate"
          id="estimate"
        >
          <Calculator ui={homeEstimateCalculatorUi} app={app} />
        </Section>
      <CallToAction
          texts="pages.home.callToAction"
          title="Ready to get started?"
          link={{ to: "/schedule", label: "Get started" }}
        />
      <RecordCards
          texts="pages.home.news"
          id="news"
          icon={BookOpen}
          title="Posts"
          cards={data.posts.slice(0, 6).map((row) => ({
            key: row.id,
            title: String(row.title),
            href: \`/blog/\${encodeURIComponent(row.address || String(row.id))}\`,
            picture: row.cover ? { src: \`/files/post/\${row.id}/cover\`, alt: row.cover.alt, width: row.cover.width, height: row.cover.height } : undefined,
            text: row.summary ?? undefined,
            badge: ({ draft: "Draft", published: "Published" } as Record<string, string>)[row.status],
          }))}
        />
      <Contact
          texts="pages.home.contact"
          form={(sent, human) => (
            <ModelForm
              ui={messageUi}
              app={app}
              schema={messageSchema}
              submitLabel="Send"
              onSubmit={async (values) => {
                if (human()) await createMessage({ data: values });
                sent();
              }}
            />
          )}
        />
    </LandingLayout>
  );
}
"
`;

