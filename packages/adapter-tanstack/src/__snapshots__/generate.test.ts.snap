"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { z } from "zod";
import { mergeCustomers as implementation } from "#/custom/actions/merge-customers";
import { customerData } from "#/generated/customer.server";
import { AccessDenied, check, type Rule, type Viewer } from "#/kit/access";
import type { ModelUi } from "#/kit/model";
import { currentViewer } from "#/lib/viewer.server";

/** Who may run the "mergeCustomers" action. */
export const mergeCustomersAccess: Rule = { public: false, roles: ["admin"], owner: false };

/** What the "mergeCustomers" action needs. */
export const mergeCustomersInput = z.object({
  keep: z.number().int(),
  duplicate: z.number().int(),
});

export type MergeCustomersInput = z.infer<typeof mergeCustomersInput>;

/** What the "mergeCustomers" action returns. */
export type MergeCustomersOutput = void;

export const mergeCustomersUi: ModelUi = {
  label: "Merge customers",
  pluralLabel: "Merge customers",
  titleField: "id",
  columns: [],
  fields: [
    {
      name: "keep",
      label: "Keep",
      kind: "relation",
      required: true,
      relation: { key: "keep", titleField: "name" },
    },
    {
      name: "duplicate",
      label: "Duplicate",
      kind: "relation",
      required: true,
      relation: { key: "duplicate", titleField: "name" },
    },
  ],
};

export const mergeCustomers = createServerFn({ method: "POST" })
  .validator(mergeCustomersInput)
  .handler(async ({ data }) => {
    const viewer = await currentViewer();
    check(mergeCustomersAccess, viewer);
    if (data.keep != null && !customerData.canRead(viewer, data.keep)) throw new AccessDenied(true);
    if (data.duplicate != null && !customerData.canRead(viewer, data.duplicate)) throw new AccessDenied(true);
    // The implementation may take the viewer too, e.g. to use the data functions as them.
    const run: (input: MergeCustomersInput, viewer: Viewer | null) => Promise<MergeCustomersOutput> = implementation;
    return run(data, viewer);
  });
"
`;

