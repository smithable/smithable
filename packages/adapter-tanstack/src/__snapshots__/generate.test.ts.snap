"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, useNavigate } from "@tanstack/react-router";
import { createInvoice, invoiceSchema, invoiceUi } from "#/generated/invoice";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";

export const Route = createFileRoute("/invoices/new")({ component: NewInvoicePage });

function NewInvoicePage() {
  const navigate = useNavigate();
  const back = () => navigate({ to: "/invoices" });
  return (
    <>
      <PageHeader title="New invoice" />
      <ModelForm
        ui={invoiceUi}
        schema={invoiceSchema}
        submitLabel="Create invoice"
        onSubmit={async (values) => {
          await createInvoice({ data: values });
          await back();
        }}
        onCancel={back}
      />
    </>
  );
}
"
