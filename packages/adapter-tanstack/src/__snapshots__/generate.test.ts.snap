"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createInsertSchema } from "drizzle-zod";
import { z } from "zod";
import * as schema from "#/db/schema";
import { w } from "#/kit/words";

/** What a post's form sends, checked. */
export const postSchema = createInsertSchema(schema.posts, {
  title: (s) => s.trim().min(1, w.required).max(200, w.atMostCharacters(200)),
  address: (s) => s.max(200, w.atMostCharacters(200)),
  summary: (s) => s.max(10000, w.atMostCharacters(10000)),
  cover: z.object({ file: z.string().regex(/^post\\/[a-f0-9]{24}\\.webp$/), alt: z.string().trim().max(200), width: z.int().positive(), height: z.int().positive(), generated: z.literal(true).optional(), receipt: z.string().max(64).optional() }).nullish(),
  body: (s) => s.trim().min(1, w.required).max(50000, w.atMostCharacters(50000)),
  publishedOn: (s) => s.regex(/^\\d{4}-\\d{2}-\\d{2}$/, w.enterValidDate),
}).omit({ id: true, ownerId: true, createdAt: true, updatedAt: true });

export type PostValues = z.output<typeof postSchema>;
"
`;

exports[`../../../examples/booking/smithable.yml > file list and generated code > src/generated/post.server.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { type AnyColumn, and, asc, avg, count, desc, eq, inArray, isNotNull, max, min, or, sql, sum, type SQL } from "drizzle-orm";
import { db } from "#/db";
import * as schema from "#/db/schema";
import { AccessDenied, allows, check, Conflict, type ModelAccess, personOf, readScope, type Viewer } from "#/kit/access";
import { audit, changedFields } from "#/kit/audit.server";
import { refusal } from "#/kit/log.server";
import { contains } from "#/kit/search";
import { BadInput } from "#/kit/refusal";
import { aggregate, type Filterable, sortOf, whereOf, wordsOf } from "#/kit/where";
import { deletePicture } from "#/kit/uploads";
import { acceptFiles } from "#/kit/receipts.server";
import { afterChange, afterDelete } from "./hooks";
import type { PostValues } from "./post";

/** Who may read, create, change and delete posts. */
export const postAccess: ModelAccess = {
  read: { public: true, roles: ["admin"], owner: true, where: { status: "published" } },
  create: { public: false, roles: ["admin"], owner: false },
  write: { public: false, roles: ["admin"], owner: true },
  delete: { public: false, roles: ["admin"], owner: true },
};

/** A record as the viewer gets it: who owns it only for its owner and roles that read every record. */
function shownTo<R extends { ownerId: string | null }>(viewer: Viewer | null, row: R): R {
  if (viewer && (row.ownerId === viewer.id || postAccess.read.roles.includes(viewer.role))) return row;
  return { ...row, ownerId: null };
}


/** What \`where\` may name, and how: the stored fields, by kind. */
const FILTERABLE: Record<string, Filterable> = {
  title: { kind: "text", column: schema.posts.title },
  address: { kind: "text", column: schema.posts.address },
  summary: { kind: "text", column: schema.posts.summary },
  body: { kind: "text", column: schema.posts.body },
  publishedOn: { kind: "date", column: schema.posts.publishedOn },
  status: { kind: "choice", column: schema.posts.status, values: ["draft","published"] },
};

/** What the records can be sorted by. */
const SORTABLE = { id: schema.posts.id, title: schema.posts.title, address: schema.posts.address, summary: schema.posts.summary, body: schema.posts.body, publishedOn: schema.posts.publishedOn, status: schema.posts.status, createdAt: schema.posts.createdAt };

/** The number fields \`measure\` adds up; amounts are stored in cents. */
const NUMBERS: Record<string, AnyColumn> = {  };
const MONEY: string[] = [];

/** Computed number fields \`measure\` adds up from the records themselves. */
const COMPUTED: string[] = [];

/** The titles of the referenced records \`measureBy\` splits by, to name its groups. */
function titlesOf(_viewer: Viewer | null, _by: string, _ids: number[]): Map<unknown, string> {
  switch (_by) {
    default:
      return new Map();
  }
}

/** What \`measureBy\` may split by: choices, yes/no, references, and dates by month. */
const BY: string[] = ["publishedOn","status"];


/** Each picture or document new to the record must come with the receipt its upload gave the viewer (src/kit/receipts.server.ts); the receipts are not kept. */
function checkFiles(viewer: Viewer | null, values: PostValues, before?: Record<string, unknown>): PostValues {
  return {
    ...values,
    ...("cover" in values ? { cover: acceptFiles(viewer, "post", "cover", values.cover, before?.cover) } : {}),
  };
}

export const postData = {
  shownTo,
  /** The rows with each reference to a record the viewer may not read set to nothing: a related record's title is shown only to who may read it (only its id stays). */
  shownRefs<R extends Record<string, unknown>>(_viewer: Viewer | null, rows: R[]): R[] {
    return rows;
  },

  /** Whether a stored picture or document is on any record (the trash too): a file no record has may go. */
  uses(file: string): boolean {
    return !!db.select({ id: schema.posts.id }).from(schema.posts).where(sql\`\${schema.posts.cover} like \${\`%"file":"\${file}"%\`}\`).get();
  },

  /** A condition for the posts the viewer may read. */
  readable(viewer: Viewer | null) {
    const scope = readScope(postAccess.read, viewer);
    if (scope === "all") return undefined;
    if (scope === "public") return and(eq(schema.posts.status, "published"));
    return scope === "own" && viewer ? or(eq(schema.posts.ownerId, viewer.id), and(eq(schema.posts.status, "published"))) : sql\`false\`;
  },

  canRead(viewer: Viewer | null, id: number): boolean {
    const found = db
      .select({ id: schema.posts.id })
      .from(schema.posts)
      .where(and(eq(schema.posts.id, id), postData.readable(viewer)))
      .get();
    return found !== undefined;
  },

  /** The posts the viewer may read; \`where\` narrows them, e.g. to a search; \`limit\` keeps the newest (a data page). */
  async list(viewer: Viewer | null, where?: SQL, limit?: number) {
    if (readScope(postAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const found = postData.shownRefs(viewer, await db.query.posts.findMany({
      where: and(postData.readable(viewer), where),
      orderBy: (t, { desc }) => [desc(t.id)],
      limit,
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return rows;
  },

  /**
   * A page of the posts the viewer may read that fit \`where\`, newest first (or in
   * \`order\`), and how many fit in all: for a list page. A page past the end is the last one.
   */
  async page(viewer: Viewer | null, where?: SQL, order?: SQL, page = 1, size = 50) {
    if (readScope(postAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = and(postData.readable(viewer), where);
    const total = db.select({ n: count() }).from(schema.posts).where(condition).get()?.n ?? 0;
    const at = Math.min(Math.max(1, Math.trunc(page)), Math.max(1, Math.ceil(total / size)));
    const found = postData.shownRefs(viewer, await db.query.posts.findMany({
      where: condition,
      orderBy: (t, { desc }) => [...(order ? [order] : []), desc(t.id)],
      limit: size,
      offset: (at - 1) * size,
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return { rows: rows, total, page: at, size };
  },

  /**
   * The posts the viewer may read that fit \`where\` and \`search\`, in \`sort\`'s order (else newest
   * first), a page of them and how many there are: for the API and the assistants' tools.
   */
  async find(
    viewer: Viewer | null,
    options: { where?: unknown; search?: string; sort?: string; limit?: number; offset?: number } = {},
  ) {
    if (readScope(postAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = postData.fitting(viewer, options.where, options.search);
    const order = sortOf(SORTABLE, options.sort);
    const total = db.select({ n: count() }).from(schema.posts).where(condition).get()?.n ?? 0;
    const found = postData.shownRefs(viewer, await db.query.posts.findMany({
      where: condition,
      orderBy: (t, { desc }) => [...(order ? [order] : []), desc(t.id)],
      limit: options.limit ?? 100,
      offset: options.offset ?? 0,
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return { items: rows, total };
  },

  /**
   * A number from the posts the viewer may read that fit \`where\`: how many, or the sum,
   * average, smallest or largest of a number field.
   */
  async measure(
    viewer: Viewer | null,
    how: "count" | "sum" | "average" | "smallest" | "largest",
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<number | null> {
    if (readScope(postAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = postData.fitting(viewer, options.where, options.search);
    if (how === "count")
      return db.select({ n: count() }).from(schema.posts).where(condition).get()?.n ?? 0;
    const field = options.field ?? "";
    const money = MONEY.includes(field);
    if (COMPUTED.includes(field)) {
      const rows = await postData.computedRows(condition);
      const value = aggregate(rows.map((row) => row[field]), how);
      return value === null ? null : money ? value / 100 : value;
    }
    const column = NUMBERS[field];
    if (!column)
      throw new BadInput(
        \`\${how} needs a number field: \${[...Object.keys(NUMBERS), ...COMPUTED].join(", ") || "there are none"}.\`,
      );
    const pick = { sum, average: avg, smallest: min, largest: max }[how];
    const value = db.select({ v: pick(column) }).from(schema.posts).where(condition).get()?.v;
    if (value === null || value === undefined) return null;
    return money ? Number(value) / 100 : Number(value);
  },

  /** Which record holds the smallest or largest value of a number field (the first of a tie). */
  async holder(
    viewer: Viewer | null,
    how: "smallest" | "largest",
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<{ id: number; title: string } | null> {
    const condition = postData.fitting(viewer, options.where, options.search);
    const field = options.field ?? "";
    if (COMPUTED.includes(field)) {
      let best: Record<string, unknown> | undefined;
      for (const row of await postData.computedRows(condition)) {
        const v = row[field];
        if (typeof v !== "number") continue;
        if (!best || (how === "largest" ? v > (best[field] as number) : v < (best[field] as number))) best = row;
      }
      return best ? { id: best.id as number, title: String(best.title) } : null;
    }
    const column = NUMBERS[field];
    if (!column) return null;
    const row = db
      .select({ id: schema.posts.id, title: schema.posts.title })
      .from(schema.posts)
      .where(and(condition, isNotNull(column)))
      .orderBy(how === "largest" ? desc(column) : asc(column), asc(schema.posts.id))
      .limit(1)
      .get();
    return row ? { id: row.id, title: String(row.title) } : null;
  },

  /**
   * The same number per value of a field (a choice, yes/no, a reference) or per month of a date:
   * \`[{ value, number }]\`, the most first.
   */
  async measureBy(
    viewer: Viewer | null,
    how: "count" | "sum" | "average" | "smallest" | "largest",
    by: string,
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<{ value: unknown; title?: string; number: number | null }[]> {
    if (readScope(postAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const split = FILTERABLE[by];
    if (!split || split.kind === "text" || split.kind === "number" || split.kind === "money")
      throw new BadInput(\`There is no field "\${by}" to split by. Fields: \${BY.join(", ")}.\`);
    const field = options.field ?? "";
    const money = MONEY.includes(field);
    const condition = postData.fitting(viewer, options.where, options.search);
    const amount = (n: number | null) => (n === null ? null : money ? n / 100 : n);
    const most = (a: { number: number | null }, b: { number: number | null }) => (b.number ?? 0) - (a.number ?? 0);
    // A reference's groups carry the referenced record's title beside its id.
    const named = (rows: { value: unknown; number: number | null }[]) => {
      if (split.kind !== "reference") return rows;
      const titles = titlesOf(viewer, by, rows.map((r) => r.value).filter((v): v is number => typeof v === "number"));
      return rows.map((r) => (titles.has(r.value) ? { value: r.value, title: titles.get(r.value), number: r.number } : r));
    };
    if (COMPUTED.includes(field)) {
      // Each record's month or value, then the computed numbers added up per group.
      const groups = new Map<unknown, unknown[]>();
      for (const row of await postData.computedRows(condition)) {
        const raw = row[split.kind === "reference" ? \`\${by}Id\` : by];
        const value = split.kind === "date" ? String(raw ?? "").slice(0, 7) || null : split.kind === "instant" ? (raw instanceof Date ? raw.toISOString().slice(0, 7) : null) : raw;
        groups.set(value, [...(groups.get(value) ?? []), row[field]]);
      }
      return named([...groups].map(([value, numbers]) => ({ value, number: amount(aggregate(numbers, how)) })).sort(most));
    }
    const key = split.kind === "date" ? sql<string>\`substr(\${split.column}, 1, 7)\` : split.kind === "instant" ? sql<string>\`strftime('%Y-%m', \${split.column} / 1000, 'unixepoch')\` : sql\`\${split.column}\`;
    const column = NUMBERS[field];
    if (how !== "count" && !column)
      throw new BadInput(\`\${how} needs a number field: \${[...Object.keys(NUMBERS), ...COMPUTED].join(", ") || "there are none"}.\`);
    const pick = how === "count" || !column ? count() : { sum, average: avg, smallest: min, largest: max }[how](column);
    return named(
      db
        .select({ value: key, number: pick })
        .from(schema.posts)
        .where(condition)
        .groupBy(key)
        .all()
        .map((r) => ({ value: r.value, number: r.number === null ? null : amount(Number(r.number)) }))
        .sort(most),
    );
  },

  /**
   * The records that fit, with their computed fields worked out: for adding those up. At most
   * 10,000, so one call never reads a whole large table; more are refused with how to narrow them.
   */
  async computedRows(condition: SQL | undefined): Promise<Record<string, unknown>[]> {
    const rows = await db.query.posts.findMany({ where: condition, limit: 10001 });
    if (rows.length > 10000)
      throw new BadInput("More than 10,000 records to add up a computed field over: narrow them with where.");
    return rows.map((row) => row as Record<string, unknown>);
  },

  /** The posts the viewer may read whose title has the text: a few, for naming one. */
  named(viewer: Viewer | null, text: string): { id: number; title: string }[] {
    return db
      .select({ id: schema.posts.id, title: schema.posts.title })
      .from(schema.posts)
      .where(and(postData.readable(viewer), contains([schema.posts.title], text)))
      .limit(6)
      .all()
      .map((row) => ({ id: row.id, title: String(row.title) }));
  },

  /** The condition for records the viewer may read that fit \`where\` and \`search\`. */
  fitting(viewer: Viewer | null, where?: unknown, search?: string) {
    return and(
      postData.readable(viewer),
      whereOf(FILTERABLE, where, viewer ? eq(schema.posts.ownerId, viewer.id) : undefined, viewer?.id, {}),
      // Every word somewhere in the texts ("ship lamp" finds "ship's lamp").
      ...wordsOf(search).map((word) => contains([schema.posts.title, schema.posts.address, schema.posts.summary, schema.posts.body], word)),
    );
  },

  /** How many posts the viewer may read, for a data page's overview; none to read: null. */
  count(viewer: Viewer | null): number | null {
    if (readScope(postAccess.read, viewer) === "none") return null;
    return db.select({ n: count() }).from(schema.posts).where(postData.readable(viewer)).get()?.n ?? 0;
  },

  async get(viewer: Viewer | null, id: number) {
    const fetched = await db.query.posts.findFirst({
      where: and(eq(schema.posts.id, id), postData.readable(viewer)),
    });
    const found = fetched && postData.shownRefs(viewer, [fetched])[0];
    const row = found && shownTo(viewer, found);
    return row ? row : null;
  },

  async create(viewer: Viewer | null, values: PostValues) {
    check(postAccess.create, viewer);
    values = checkFiles(viewer, values);
    let row: typeof schema.posts.$inferSelect;
    try {
      row = db.transaction((tx) => {
        const made = tx.insert(schema.posts).values({ ...values, ownerId: personOf(viewer) }).returning().get();
        audit(tx, viewer, { action: "created", model: "Post", record: made.id });
        return made;
      });
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterCreate", "Post", row, viewer);
    return row;
  },

  /** Changes the record; \`what\` names the change in the audit log (an action's name). */
  async update(viewer: Viewer | null, id: number, values: PostValues, what = "changed") {
    const row = db
      .select({ ownerId: schema.posts.ownerId, cover: schema.posts.cover })
      .from(schema.posts)
      .where(and(eq(schema.posts.id, id), postData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(postAccess.write, viewer, row.ownerId);
    values = checkFiles(viewer, values, db.select({ cover: schema.posts.cover }).from(schema.posts).where(eq(schema.posts.id, id)).get());
    let changed: typeof schema.posts.$inferSelect;
    const updated = values;
    try {
      changed = db.transaction((tx) => {
        const before = tx.select().from(schema.posts).where(eq(schema.posts.id, id)).get();
        const after = tx.update(schema.posts).set(updated).where(eq(schema.posts.id, id)).returning().get();
        audit(tx, viewer, { action: what, model: "Post", record: id, fields: before && changedFields(before, after, Object.keys(updated)) });
        return after;
      });
    } catch (error) {
      throw refusal(error);
    }
    if (row.cover && row.cover.file !== changed.cover?.file) deletePicture(row.cover, !!db.select({ id: schema.posts.id }).from(schema.posts).where(sql\`\${schema.posts.cover} like \${\`%"file":"\${row.cover.file}"%\`}\`).get());
    await afterChange("afterUpdate", "Post", changed, viewer);
    return changed;
  },

  /** Deletes the record; \`together\` takes the records that point to it along to the trash (delete-together.md). */
  async remove(viewer: Viewer | null, id: number, _together = false): Promise<void> {
    const row = db
      .select({ ownerId: schema.posts.ownerId, cover: schema.posts.cover })
      .from(schema.posts)
      .where(and(eq(schema.posts.id, id), postData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(postAccess.delete, viewer, row.ownerId);
    try {
      db.transaction((tx) => {
        const gone = tx.delete(schema.posts).where(eq(schema.posts.id, id)).returning().get();
        if (gone) {
          audit(tx, viewer, { action: "deleted", model: "Post", record: id, title: gone.title });
        }
      });
    } catch (error) {
      throw refusal(error);
    }
    if (row.cover && row.cover.file !== undefined) deletePicture(row.cover, !!db.select({ id: schema.posts.id }).from(schema.posts).where(sql\`\${schema.posts.cover} like \${\`%"file":"\${row.cover.file}"%\`}\`).get());
    await afterDelete("Post", id, viewer);
  },

  /**
   * Deletes the chosen records the viewer may delete, all or none (one still in use stops them
   * all, and is named); the others are skipped.
   */
  async removeMany(viewer: Viewer | null, ids: number[], _together = false): Promise<{ deleted: number; skipped: number }> {
    const rows = db
      .select({ id: schema.posts.id, ownerId: schema.posts.ownerId, cover: schema.posts.cover })
      .from(schema.posts)
      .where(and(inArray(schema.posts.id, ids), postData.readable(viewer)))
      .all()
      .filter((row) => allows(postAccess.delete, viewer, row.ownerId));
    db.transaction((tx) => {
      for (const row of rows)
        try {
          const gone = tx.delete(schema.posts).where(eq(schema.posts.id, row.id)).returning().get();
          if (gone) {
            audit(tx, viewer, { action: "deleted", model: "Post", record: row.id, title: gone.title });
          }
        } catch (error) {
          const refused = refusal(error);
          throw refused instanceof Conflict && refused.message === "in-use" ? new Conflict(\`in-use:\${row.id}\`) : refused;
        }
    });
    for (const row of rows) {
      if (row.cover && row.cover.file !== undefined) deletePicture(row.cover, !!db.select({ id: schema.posts.id }).from(schema.posts).where(sql\`\${schema.posts.cover} like \${\`%"file":"\${row.cover.file}"%\`}\`).get());
      await afterDelete("Post", row.id, viewer);
    }
    return { deleted: rows.length, skipped: new Set(ids).size - rows.length };
  },
};
"
`;

exports[`../../../examples/booking/smithable.yml > file list and generated code > src/generated/post.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { z } from "zod";
import type * as schema from "#/db/schema";
import { allows, type Rule } from "#/kit/access";
import type { RecordUi } from "#/kit/model";
import { MarkdownEditor, MarkdownText } from "#/kit/Markdown";
import { bindPicture } from "#/kit/PictureInput";
import { postAccess, postData } from "./post.server";
import { writeAllowed } from "#/kit/limit";
import { currentViewer } from "#/lib/viewer.server";
import { postSchema } from "./post.schema";

export type { PostValues } from "./post.schema";

/** The viewer about to write, counted against how often one may (see src/kit/limit.ts). */
async function writer() {
  const viewer = await currentViewer();
  writeAllowed(viewer, getRequestHeaders());
  return viewer;
}

/** Post records as the kit reads them. */
export type PostRow = typeof schema.posts.$inferSelect;

export const postUi: RecordUi<PostRow> = {
  model: "Post",
  label: "Post",
  pluralLabel: "Posts",
  titleField: "title",
  descriptionField: "summary",
  columns: ["title", "cover", "status", "address", "publishedOn"],
  fields: [
    {
      name: "title",
      label: "Title",
      kind: "string",
      required: true,
      get: (row) => row.title,
    },
    {
      name: "address",
      label: "Address",
      kind: "string",
      required: false,
      get: (row) => row.address,
    },
    {
      name: "summary",
      label: "Summary",
      kind: "text",
      required: false,
      get: (row) => row.summary,
    },
    {
      name: "cover",
      label: "Cover",
      kind: "picture",
      required: false,
      input: bindPicture("post", "cover"),
      get: (row) => row.cover,
    },
    {
      name: "body",
      label: "Body",
      kind: "markdown",
      required: true,
      input: MarkdownEditor,
      view: MarkdownText,
      get: (row) => row.body,
    },
    {
      name: "publishedOn",
      label: "Published on",
      kind: "date",
      required: false,
      get: (row) => row.publishedOn,
    },
    {
      name: "status",
      label: "Status",
      kind: "choice",
      required: true,
      choices: [{ value: "draft", label: "Draft" }, { value: "published", label: "Published" }],
      default: "draft",
      get: (row) => row.status,
    },
  ],
};

/** Who may delete posts: a list's selection offers Delete by it (the server checks again). */
export const postDeleteRule: Rule = { public: false, roles: ["admin"], owner: true };


export const listPosts = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return { rows: await postData.list(viewer), canCreate: allows(postAccess.create, viewer) };
});

export const getPost = createServerFn()
  .validator(z.number().int())
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    const row = await postData.get(viewer, id);
    if (!row) return null;
    return {
      row,
      canWrite: allows(postAccess.write, viewer, row.ownerId),
      canDelete: allows(postAccess.delete, viewer, row.ownerId),
    };
  });

export const createPost = createServerFn({ method: "POST" })
  .validator(postSchema)
  .handler(async ({ data }) => postData.create(await writer(), data));

export const updatePost = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), values: postSchema }))
  .handler(async ({ data }) => postData.update(await writer(), data.id, data.values));

/** Deletes a post; \`together\` takes what points to it along (docs/design/delete-together.md). */
export const deletePost = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), together: z.boolean().optional() }))
  .handler(async ({ data }) => postData.remove(await writer(), data.id, data.together));

/** Deletes the chosen posts, all or none (at most 1,000 at once). */
export const deletePosts = createServerFn({ method: "POST" })
  .validator(z.object({ ids: z.array(z.number().int()).max(1000), together: z.boolean().optional() }))
  .handler(async ({ data }) => postData.removeMany(await writer(), data.ids, data.together));
"
`;

