"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// The standard actions offered on a incident, for programs with a key.
import { createFileRoute } from "@tanstack/react-router";
import { incidentToApi } from "#/generated/api.server";
import { runResolve } from "#/generated/actions/resolve.server";
import { apiCall, NotFound } from "#/kit/api.server";

export const Route = createFileRoute("/api/v1/incidents/$id/actions/$action")({
  server: {
    handlers: {
      POST: ({ request, params }) =>
        apiCall(request, async (viewer) => {
          const id = Number(params.id);
          switch (params.action) {
            case "resolve":
              return incidentToApi(await runResolve(viewer, id));
            default:
              throw new NotFound(\`There is no action "\${params.action}" here.\`);
          }
        }),
    },
  },
});
"
`;

exports[`../../../examples/status/smithable.yml > file list and generated code > src/routes/api/v1/incidents/$id.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// One incident for programs with a key: read, change (the fields given) or delete it.
import { createFileRoute } from "@tanstack/react-router";
import { incidentFromApi, incidentToApi } from "#/generated/api.server";
import { incidentData } from "#/generated/incident.server";
import { NotFound, apiCall, openApiCall } from "#/kit/api.server";

const found = async (viewer: Parameters<typeof incidentData.get>[0], id: string) => {
  const row = await incidentData.get(viewer, Number(id));
  if (!row) throw new NotFound("No such incident, or not one this key may read.");
  return row;
};

export const Route = createFileRoute("/api/v1/incidents/$id")({
  server: {
    handlers: {
      GET: ({ request, params }) => openApiCall(request, async (viewer) => incidentToApi(await found(viewer, params.id))),
      PATCH: ({ request, params }) =>
        apiCall(request, async (viewer, body) => {
          const row = await found(viewer, params.id);
          return incidentToApi(await incidentData.update(viewer, row.id, incidentFromApi(body, row) as never));
        }),
      DELETE: ({ request, params }) =>
        apiCall(request, async (viewer) => {
          const row = await found(viewer, params.id);
          // ?together=true takes the records that point to it along (docs/design/delete-together.md).
          await incidentData.remove(viewer, row.id, new URL(request.url).searchParams.get("together") === "true");
        }),
    },
  },
});
"
`;

