"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { type AnyColumn, and, asc, avg, count, desc, eq, inArray, isNotNull, isNull, lt, max, min, sql, sum, type SQL } from "drizzle-orm";
import { db } from "#/db";
import * as schema from "#/db/schema";
import { AccessDenied, allows, check, Conflict, type ModelAccess, personOf, readScope, type Viewer } from "#/kit/access";
import { audit, changedFields } from "#/kit/audit.server";
import { refusal } from "#/kit/log.server";
import { contains } from "#/kit/search";
import { BadInput } from "#/kit/refusal";
import { aggregate, type Filterable, nearest, sortOf, whereOf, wordsOf } from "#/kit/where";
import { afterChange, afterDelete } from "./hooks";
import { orderData } from "./order.server";
import { orderUi } from "./order";
import { customerUi, type CustomerSettable } from "./customer";
import "./trash.server";

/** A transaction, as the group's functions are called inside one (docs/design/delete-together.md). */
type Tx = Parameters<Parameters<typeof db.transaction>[0]>[0];

/**
 * What points to a customer (docs/design/delete-together.md): the records that would go with it
 * to the trash, by model, and those that would show no customer; nothing when nothing does.
 */
function usedBy(tx: Tx, id: number, title: string) {
  const pointing: { model: string; from: string; label: string; plural: string; depth: number; count: number | null }[] = [
    { model: "Order", label: orderUi.label, plural: orderUi.pluralLabel, from: "Customer", depth: 1, count: tx.select({ n: count() }).from(schema.orders).where(and(eq(schema.orders.customerId, id), isNull(schema.orders.deletedAt))).get()?.n ?? 0 },
  ];
  // A deeper member is named when its parent has records ("and what belongs to them").
  const with_: typeof pointing = [];
  for (const e of pointing)
    if (e.count === null ? with_.some((p) => p.model === e.from) : e.count > 0) with_.push(e);
  if (!with_.length) return undefined;
  const loose = [] as { model: string; label: string; plural: string; count: number }[];
  return { id, title, model: "Customer", label: customerUi.label, with: with_, loose, together: true, missing: [] };
}

/** Who may read, create, change and delete customers. */
export const customerAccess: ModelAccess = {
  read: { public: false, roles: ["admin", "sales"], owner: false },
  create: { public: false, roles: ["admin", "sales"], owner: false },
  write: { public: false, roles: ["admin", "sales"], owner: true },
  delete: { public: false, roles: ["admin"], owner: true },
};


/** What \`where\` may name, and how: the stored fields, by kind. */
const FILTERABLE: Record<string, Filterable> = {
  name: { kind: "text", column: schema.customers.name },
  email: { kind: "text", column: schema.customers.email },
  phone: { kind: "text", column: schema.customers.phone },
  segment: { kind: "choice", column: schema.customers.segment, values: ["smb","enterprise","government"] },
  creditLimit: { kind: "money", column: schema.customers.creditLimit },
  notes: { kind: "text", column: schema.customers.notes },
  accountManager: { kind: "reference", column: schema.customers.accountManagerId, title: { table: schema.user, column: schema.user.name } },
};

/** What the records can be sorted by. */
const SORTABLE = { id: schema.customers.id, name: schema.customers.name, email: schema.customers.email, phone: schema.customers.phone, segment: schema.customers.segment, creditLimit: schema.customers.creditLimit, notes: schema.customers.notes, createdAt: schema.customers.createdAt };

/** The number fields \`measure\` adds up; amounts are stored in cents. */
const NUMBERS: Record<string, AnyColumn> = { creditLimit: schema.customers.creditLimit };
const MONEY: string[] = ["creditLimit"];

/** Computed number fields \`measure\` adds up from the records themselves. */
const COMPUTED: string[] = [];

/** The titles of the referenced records \`measureBy\` splits by, to name its groups. */
function titlesOf(_viewer: Viewer | null, _by: string, _ids: number[]): Map<unknown, string> {
  switch (_by) {
    default:
      return new Map();
  }
}

/** What \`measureBy\` may split by: choices, yes/no, references, and dates by month. */
const BY: string[] = ["segment","accountManager"];


/**
 * Whose record it is: anyone's for a role that may change everyone's, otherwise the viewer's
 * own, whatever the form sent.
 */
function ownerFor(viewer: Viewer | null, given: string | null | undefined): string | null {
  if ((!!viewer && (!!viewer.system || customerAccess.write.roles.includes(viewer.role)))) return given ?? personOf(viewer);
  return personOf(viewer);
}

/** How long a record stays in the trash, and the most a trash view shows. */
const TRASH_DAYS = 30;
const DAY = 24 * 60 * 60 * 1000;
export const customerData = {
  /** The rows with each reference to a record the viewer may not read set to nothing: a related record's title is shown only to who may read it (only its id stays). */
  shownRefs<R extends Record<string, unknown>>(_viewer: Viewer | null, rows: R[]): R[] {
    return rows;
  },

  /** A condition for the customers the viewer may read. */
  readable(viewer: Viewer | null) {
    // What is in the trash is gone to every reader (docs/design/trash.md).
    return and(isNull(schema.customers.deletedAt), customerData.scoped(viewer));
  },

  /** The records the viewer may read by the read rule, the trashed ones too. */
  scoped(viewer: Viewer | null) {
    const scope = readScope(customerAccess.read, viewer);
    if (scope === "all") return undefined;
    return scope === "own" && viewer ? eq(schema.customers.accountManagerId, viewer.id) : sql\`false\`;
  },

  canRead(viewer: Viewer | null, id: number): boolean {
    const found = db
      .select({ id: schema.customers.id })
      .from(schema.customers)
      .where(and(eq(schema.customers.id, id), customerData.readable(viewer)))
      .get();
    return found !== undefined;
  },

  /** The customers the viewer may read; \`where\` narrows them, e.g. to a search. */
  async list(viewer: Viewer | null, where?: SQL) {
    if (readScope(customerAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const rows = customerData.shownRefs(viewer, await db.query.customers.findMany({
      where: and(customerData.readable(viewer), where),
      with: { accountManager: { columns: { id: true, name: true } } },
      orderBy: (t, { desc }) => [desc(t.id)],
    }));
    return rows;
  },

  /**
   * A page of the customers the viewer may read that fit \`where\`, newest first (or in
   * \`order\`), and how many fit in all: for a list page. A page past the end is the last one.
   */
  async page(viewer: Viewer | null, where?: SQL, order?: SQL, page = 1, size = 50) {
    if (readScope(customerAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = and(customerData.readable(viewer), where);
    const total = db.select({ n: count() }).from(schema.customers).where(condition).get()?.n ?? 0;
    const at = Math.min(Math.max(1, Math.trunc(page)), Math.max(1, Math.ceil(total / size)));
    const rows = customerData.shownRefs(viewer, await db.query.customers.findMany({
      where: condition,
      with: { accountManager: { columns: { id: true, name: true } } },
      orderBy: (t, { desc }) => [...(order ? [order] : []), desc(t.id)],
      limit: size,
      offset: (at - 1) * size,
    }));
    return { rows: rows, total, page: at, size };
  },

  /**
   * The customers the viewer may read that fit \`where\` and \`search\`, in \`sort\`'s order (else newest
   * first), a page of them and how many there are: for the API and the assistants' tools.
   */
  async find(
    viewer: Viewer | null,
    options: { where?: unknown; search?: string; sort?: string; limit?: number; offset?: number } = {},
  ) {
    if (readScope(customerAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = customerData.fitting(viewer, options.where, options.search);
    const order = sortOf(SORTABLE, options.sort);
    const total = db.select({ n: count() }).from(schema.customers).where(condition).get()?.n ?? 0;
    const rows = customerData.shownRefs(viewer, await db.query.customers.findMany({
      where: condition,
      with: { accountManager: { columns: { id: true, name: true } } },
      orderBy: (t, { desc }) => [...(order ? [order] : []), desc(t.id)],
      limit: options.limit ?? 100,
      offset: options.offset ?? 0,
    }));
    return { items: rows, total };
  },

  /**
   * A number from the customers the viewer may read that fit \`where\`: how many, or the sum,
   * average, smallest or largest of a number field.
