exports[`../../../examples/booking/smithable.yml > file list and generated code > src/generated/session.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { eq } from "drizzle-orm";
import { createInsertSchema } from "drizzle-zod";
import { z } from "zod";
import { db } from "#/db";
import { sessions } from "#/db/schema";
import type { ModelUi } from "#/kit/model";

export const sessionUi: ModelUi = {
  label: "Session",
  pluralLabel: "Sessions",
  titleField: "id",
  columns: ["classTypeId", "instructorId", "startsAt", "capacity"],
  fields: [
    {
      name: "classTypeId",
      label: "Class type",
      kind: "relation",
      required: true,
      relation: { key: "classType", titleField: "name" },
    },
    {
      name: "instructorId",
      label: "Instructor",
      kind: "relation",
      required: true,
      relation: { key: "instructor", titleField: "name" },
    },
    { name: "startsAt", label: "Starts at", kind: "datetime", required: true },
    {
      name: "capacity",
      label: "Capacity",
      kind: "int",
      required: true,
      default: 12,
    },
  ],
};

export const sessionSchema = createInsertSchema(sessions).omit({ id: true, createdAt: true, updatedAt: true });

export const listSessions = createServerFn().handler(() =>
  db.query.sessions.findMany({
    with: { classType: { columns: { id: true, name: true } }, instructor: { columns: { id: true, name: true } } },
    orderBy: (t, { desc }) => [desc(t.id)],
  }),
);

export const getSession = createServerFn()
  .validator(z.number().int())
  .handler(async ({ data: id }) => {
    const row = await db.query.sessions.findFirst({
      with: { classType: { columns: { id: true, name: true } }, instructor: { columns: { id: true, name: true } } },
      where: (t, { eq }) => eq(t.id, id),
    });
    return row ? row : null;
  });

export const createSession = createServerFn({ method: "POST" })
  .validator(sessionSchema)
  .handler(({ data }) => db.insert(sessions).values(data).returning().get());

export const updateSession = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), values: sessionSchema }))
  .handler(({ data }) =>
    db.update(sessions).set(data.values).where(eq(sessions.id, data.id)).returning().get(),
  );

export const deleteSession = createServerFn({ method: "POST" })
  .validator(z.number().int())
  .handler(({ data: id }) => {
    db.delete(sessions).where(eq(sessions.id, id)).run();
  });
"
`;

exports[`../../../examples/booking/smithable.yml > file list and generated code > src/routes/__root.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createRootRoute, HeadContent, Scripts } from "@tanstack/react-router";
import { app } from "#/generated/app";
import { AppShell, type MenuUi } from "#/kit/AppShell";
import appCss from "#/styles.css?url";

const menus: MenuUi[] = [
  {
    name: "main",
    items: [
      { to: "/sessions", label: "Sessions" },
      { to: "/class-types", label: "Class types" },
      { to: "/instructors", label: "Instructors" },
    ],
  },
];

export const Route = createRootRoute({
  head: () => ({
    meta: [
      { charSet: "utf-8" },
      { name: "viewport", content: "width=device-width, initial-scale=1" },
      { title: app.name },
    ],
    links: [
      { rel: "stylesheet", href: appCss },
      { rel: "icon", href: "/favicon.svg", type: "image/svg+xml" },
    ],
  }),
  shellComponent: RootDocument,
});

function RootDocument({ children }: { children: React.ReactNode }) {
  return (
    <html lang="en">
      <head>
        <HeadContent />
      </head>
      <body>
        <AppShell appName={app.name} menus={menus}>
          {children}
        </AppShell>
        <Scripts />
      </body>
    </html>
  );
}
"
`;

exports[`../../../examples/booking/smithable.yml > file list and generated code > src/routes/class-types/$id.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, notFound, useNavigate } from "@tanstack/react-router";
import { app } from "#/generated/app";
import { classTypeSchema, classTypeUi, deleteClassType, getClassType, updateClassType } from "#/generated/class-type";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";

export const Route = createFileRoute("/class-types/$id")({
  loader: async ({ params }) => {
    const row = await getClassType({ data: Number(params.id) });
    if (!row) throw notFound();
    return { row };
  },
  component: ClassTypePage,
});

function ClassTypePage() {
  const { row } = Route.useLoaderData();
  const navigate = useNavigate();
  const back = () => navigate({ to: "/class-types" });
  return (
    <>
      <PageHeader title={row.name || \`Class type #\${row.id}\`} />
      <ModelForm
        ui={classTypeUi}
        app={app}
        schema={classTypeSchema}
        initial={row}
        submitLabel="Save changes"
        onSubmit={async (values) => {
          await updateClassType({ data: { id: row.id, values } });
          await back();
        }}
        onCancel={back}
        onDelete={async () => {
          await deleteClassType({ data: row.id });
          await back();
        }}
      />

    </>
  );
}
"
`;

