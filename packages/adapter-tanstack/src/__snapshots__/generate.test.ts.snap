/** What a booking may be given: a form's values and what the app fills (an action's set). */
export const bookingSettable = createInsertSchema(schema.bookings).omit({ id: true, createdAt: true, updatedAt: true });
/** What a booking's form sends, checked. */
export const bookingSchema = bookingSettable;

export type BookingSettable = z.output<typeof bookingSettable>;
export type BookingValues = z.output<typeof bookingSchema>;
"
