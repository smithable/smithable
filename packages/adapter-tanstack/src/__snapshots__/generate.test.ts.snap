exports[`../../../examples/booking/smithable.yml > file list and generated code > src/generated/class-type.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { eq } from "drizzle-orm";
import { createInsertSchema } from "drizzle-zod";
import { z } from "zod";
import { db } from "#/db";
import { classTypes } from "#/db/schema";
import type { ModelUi } from "#/kit/model";

export const classTypeUi: ModelUi = {
  label: "Class type",
  pluralLabel: "Class types",
  titleField: "name",
  columns: ["name", "level", "durationMinutes"],
  fields: [
    { name: "name", label: "Name", kind: "string", required: true },
    { name: "summary", label: "Summary", kind: "text", required: false },
    {
      name: "level",
      label: "Level",
      kind: "choice",
      required: true,
      choices: [
        { value: "beginner", label: "Beginner" },
        { value: "allLevels", label: "All levels" },
        { value: "advanced", label: "Advanced" },
      ],
      default: "allLevels",
    },
    {
      name: "durationMinutes",
      label: "Duration minutes",
      kind: "int",
      required: true,
      default: 60,
    },
  ],
};

export const classTypeSchema = createInsertSchema(classTypes, {
  name: (s) => s.trim().min(1, "Required"),
}).omit({ id: true, createdAt: true, updatedAt: true });

export const listClassTypes = createServerFn().handler(() =>
  db.query.classTypes.findMany({
    orderBy: (t, { desc }) => [desc(t.id)],
  }),
);

export const getClassType = createServerFn()
  .validator(z.number().int())
  .handler(async ({ data: id }) => {
    const row = await db.query.classTypes.findFirst({
      where: (t, { eq }) => eq(t.id, id),
    });
    return row ? row : null;
  });

/** Choices for fields that refer to a class type. */
export const classTypeOptions = createServerFn().handler(() =>
  db
    .select({ value: classTypes.id, label: classTypes.name })
    .from(classTypes)
    .orderBy(classTypes.name)
    .all(),
);

export const createClassType = createServerFn({ method: "POST" })
  .validator(classTypeSchema)
  .handler(({ data }) => db.insert(classTypes).values(data).returning().get());

export const updateClassType = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), values: classTypeSchema }))
  .handler(({ data }) =>
    db.update(classTypes).set(data.values).where(eq(classTypes.id, data.id)).returning().get(),
  );

export const deleteClassType = createServerFn({ method: "POST" })
  .validator(z.number().int())
  .handler(({ data: id }) => {
    db.delete(classTypes).where(eq(classTypes.id, id)).run();
  });
"
`;

