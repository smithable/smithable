exports[`../../../examples/invoicing/smithable.yml > file list and generated code > tests/smoke.spec.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { expect, type Page, test } from "@playwright/test";

/** Opens a page and fails on any error in the browser, e.g. a script the policy blocked. */
async function visit(page: Page, route: string) {
  const errors: string[] = [];
  page.on("pageerror", (e) => errors.push(e.message));
  page.on("console", (m) => m.type() === "error" && errors.push(m.text()));
  await page.goto(route);
  await page.waitForLoadState("networkidle");
  await expect(page.locator("h1").first()).toBeVisible();
  expect(errors).toEqual([]);
}

test("Home opens for a visitor", async ({ page }) => {
  await visit(page, "/");
});
test("Overview needs sign-in", async ({ page }) => {
  await page.goto("/overview");
  await expect(page).toHaveURL(/sign-in/);
});
test("Invoices needs sign-in", async ({ page }) => {
  await page.goto("/invoices");
  await expect(page).toHaveURL(/sign-in/);
});
test("Clients needs sign-in", async ({ page }) => {
  await page.goto("/clients");
  await expect(page).toHaveURL(/sign-in/);
});
test("Invoice lines needs sign-in", async ({ page }) => {
  await page.goto("/invoice-lines");
  await expect(page).toHaveURL(/sign-in/);
});
test("Settings needs sign-in", async ({ page }) => {
  await page.goto("/settings");
  await expect(page).toHaveURL(/sign-in/);
});
test("Welcome needs sign-in", async ({ page }) => {
  await page.goto("/welcome");
  await expect(page).toHaveURL(/sign-in/);
});

test.describe("signed in as admin", () => {
  test.beforeEach(async ({ page }) => {
    await page.goto("/sign-in");
    await page.waitForLoadState("networkidle");
    await page.getByRole("button", { name: "Sign in as admin" }).click();
    await page.waitForURL((url) => url.pathname !== "/sign-in");
  });

  test("Overview opens", async ({ page }) => {
    await visit(page, "/overview");
  });
  test("Invoices opens", async ({ page }) => {
    await visit(page, "/invoices");
  });
  test("Clients opens", async ({ page }) => {
    await visit(page, "/clients");
  });
  test("Invoice lines opens", async ({ page }) => {
    await visit(page, "/invoice-lines");
  });
  test("Settings opens", async ({ page }) => {
    await visit(page, "/settings");
  });
  test("Welcome opens", async ({ page }) => {
    await visit(page, "/welcome");
  });
});

test.describe("signed in as member", () => {
  test.beforeEach(async ({ page }) => {
    await page.goto("/sign-in");
    await page.waitForLoadState("networkidle");
    await page.getByRole("button", { name: "Sign in as member" }).click();
    await page.waitForURL((url) => url.pathname !== "/sign-in");
  });

  test("Overview opens", async ({ page }) => {
    await visit(page, "/overview");
  });
  test("Invoices opens", async ({ page }) => {
    await visit(page, "/invoices");
  });
  test("Clients opens", async ({ page }) => {
    await visit(page, "/clients");
  });
  test("Invoice lines opens", async ({ page }) => {
    await visit(page, "/invoice-lines");
  });
  test("Settings opens", async ({ page }) => {
    await visit(page, "/settings");
  });
  test("Welcome opens", async ({ page }) => {
    await visit(page, "/welcome");
  });
});
"
`;

