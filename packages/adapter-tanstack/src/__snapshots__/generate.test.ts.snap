exports[`../../../examples/kiosk/smithable.yml > file list and generated code > src/generated/dish.server.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { and, asc, count, eq, inArray, sql, type SQL } from "drizzle-orm";
import { db } from "#/db";
import * as schema from "#/db/schema";
import { AccessDenied, allows, check, Conflict, type ModelAccess, personOf, readScope, type Viewer } from "#/kit/access";
import { audit, changedFields } from "#/kit/audit.server";
import { refusal } from "#/kit/log.server";
import { contains } from "#/kit/search";
import { deletePicture } from "#/kit/uploads";
import { acceptFiles } from "#/kit/receipts.server";
import { afterChange, afterDelete } from "./hooks";
import { orderLineUi } from "./order-line";
import { dishUi, type DishSettable } from "./dish";

/** A transaction, as the group's functions are called inside one (docs/design/delete-together.md). */
type Tx = Parameters<Parameters<typeof db.transaction>[0]>[0];

/**
 * What points to a dish (docs/design/delete-together.md): the records that would go with it
 * to the trash, by model, and those that would show no dish; nothing when nothing does.
 */
function usedBy(tx: Tx, id: number, title: string) {
  const pointing: { model: string; from: string; label: string; plural: string; depth: number; count: number | null }[] = [
    { model: "OrderLine", label: orderLineUi.label, plural: orderLineUi.pluralLabel, from: "Dish", depth: 1, count: tx.select({ n: count() }).from(schema.orderLines).where(and(eq(schema.orderLines.dishId, id))).get()?.n ?? 0 },
  ];
  // A deeper member is named when its parent has records ("and what belongs to them").
  const with_: typeof pointing = [];
  for (const e of pointing)
    if (e.count === null ? with_.some((p) => p.model === e.from) : e.count > 0) with_.push(e);
  if (!with_.length) return undefined;
  const loose = [] as { model: string; label: string; plural: string; count: number }[];
  return { id, title, model: "Dish", label: dishUi.label, with: with_, loose, together: false, missing: [dishUi.label, orderLineUi.label] };
}

/** Who may read, create, change and delete dishes. */
export const dishAccess: ModelAccess = {
  read: { public: true, roles: ["admin", "staff"], owner: false },
  create: { public: false, roles: ["admin", "staff"], owner: false },
  write: { public: false, roles: ["admin", "staff"], owner: true },
  delete: { public: false, roles: ["admin"], owner: true },
};

/** A record as the viewer gets it: who owns it only for its owner and roles that read every record. */
function shownTo<R extends { ownerId: string | null }>(viewer: Viewer | null, row: R): R {
  if ((viewer && row.ownerId === viewer.id) || (!!viewer && (!!viewer.system || dishAccess.read.roles.includes(viewer.role)))) return row;
  return { ...row, ownerId: null };
}



/** Each picture or document new to the record must come with the receipt its upload gave the viewer (src/kit/receipts.server.ts); the receipts are not kept. */
function checkFiles<V extends Partial<DishSettable>>(viewer: Viewer | null, values: V, before?: Record<string, unknown>): V {
  return {
    ...values,
    ...("picture" in values ? { picture: acceptFiles(viewer, "dish", "picture", values.picture, before?.picture) } : {}),
  };
}

export const dishData = {
  shownTo,
  /** The rows with each reference to a record the viewer may not read set to nothing: a related record's title is shown only to who may read it (only its id stays). */
  shownRefs<R extends Record<string, unknown>>(_viewer: Viewer | null, rows: R[]): R[] {
    return rows;
  },

  /** Whether a stored picture or document is on any record (the trash too): a file no record has may go. */
  uses(file: string): boolean {
    return !!db.select({ id: schema.dishes.id }).from(schema.dishes).where(sql\`\${schema.dishes.picture} like \${\`%"file":"\${file}"%\`}\`).get();
  },

  /** A condition for the dishes the viewer may read. */
  readable(viewer: Viewer | null) {
    const scope = readScope(dishAccess.read, viewer);
    if (scope === "all") return undefined;
    return scope === "own" && viewer ? eq(schema.dishes.ownerId, viewer.id) : sql\`false\`;
  },

  canRead(viewer: Viewer | null, id: number): boolean {
    const found = db
      .select({ id: schema.dishes.id })
      .from(schema.dishes)
      .where(and(eq(schema.dishes.id, id), dishData.readable(viewer)))
      .get();
    return found !== undefined;
  },

  /** The dishes the viewer may read; \`where\` narrows them, e.g. to a search. */
  async list(viewer: Viewer | null, where?: SQL) {
    if (readScope(dishAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const found = dishData.shownRefs(viewer, await db.query.dishes.findMany({
      where: and(dishData.readable(viewer), where),
      orderBy: (t, { desc }) => [desc(t.id)],
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return rows;
  },

  /**
   * A page of the dishes the viewer may read that fit \`where\`, newest first (or in
   * \`order\`), and how many fit in all: for a list page. A page past the end is the last one.
   */
  async page(viewer: Viewer | null, where?: SQL, order?: SQL, page = 1, size = 50) {
    if (readScope(dishAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = and(dishData.readable(viewer), where);
    const total = db.select({ n: count() }).from(schema.dishes).where(condition).get()?.n ?? 0;
    const at = Math.min(Math.max(1, Math.trunc(page)), Math.max(1, Math.ceil(total / size)));
    const found = dishData.shownRefs(viewer, await db.query.dishes.findMany({
      where: condition,
      orderBy: (t, { desc }) => [...(order ? [order] : []), desc(t.id)],
      limit: size,
      offset: (at - 1) * size,
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return { rows: rows, total, page: at, size };
  },

  async get(viewer: Viewer | null, id: number) {
    const fetched = await db.query.dishes.findFirst({
      where: and(eq(schema.dishes.id, id), dishData.readable(viewer)),
    });
    const found = fetched && dishData.shownRefs(viewer, [fetched])[0];
    const row = found && shownTo(viewer, found);
    return row ? row : null;
  },

  async create(viewer: Viewer | null, values: DishSettable) {
    check(dishAccess.create, viewer);
    values = checkFiles(viewer, values);
    let row: typeof schema.dishes.$inferSelect;
    try {
      row = db.transaction((tx) => {
        const made = tx.insert(schema.dishes).values({ ...values, ownerId: personOf(viewer) }).returning().get();
        audit(tx, viewer, { action: "created", model: "Dish", record: made.id });
        return made;
      });
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterCreate", "Dish", row, viewer);
    return row;
  },

  /** Changes the record; \`what\` names the change in the audit log (an action's name). */
  /** Changes the fields given; what names the action ("changed" for a form), frees the fields it may change although locked (its own set). */
  async update(viewer: Viewer | null, id: number, values: Partial<DishSettable>, what = "changed", _frees: readonly string[] = []) {
    const row = db
      .select({ ownerId: schema.dishes.ownerId, picture: schema.dishes.picture })
      .from(schema.dishes)
      .where(and(eq(schema.dishes.id, id), dishData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    // A form's change needs write on the record; an action (what names it) checked its own access
    // first, which includes the roles its grant names (docs/design/actions.md, Access).
    if (what === "changed") check(dishAccess.write, viewer, row.ownerId);
    values = checkFiles(viewer, values, db.select({ picture: schema.dishes.picture }).from(schema.dishes).where(eq(schema.dishes.id, id)).get());
    let changed: typeof schema.dishes.$inferSelect;
    const updated = values;
    try {
      changed = db.transaction((tx) => {
        // Read again in the change itself: a record that left the viewer's reach meanwhile is refused.
        const before = tx.select().from(schema.dishes).where(and(eq(schema.dishes.id, id), dishData.readable(viewer))).get();
        if (!before) throw new AccessDenied(viewer !== null);
        const after = tx.update(schema.dishes).set(updated).where(eq(schema.dishes.id, id)).returning().get();
        audit(tx, viewer, { action: what, model: "Dish", record: id, fields: before && changedFields(before, after, Object.keys(updated)) });
        return after;
      });
    } catch (error) {
      throw refusal(error);
    }
    if (row.picture && row.picture.file !== changed.picture?.file) deletePicture(row.picture, !!db.select({ id: schema.dishes.id }).from(schema.dishes).where(sql\`\${schema.dishes.picture} like \${\`%"file":"\${row.picture.file}"%\`}\`).get());
    await afterChange("afterUpdate", "Dish", changed, viewer);
    return changed;
  },

  /** Deletes the record; \`together\` takes the records that point to it along to the trash (delete-together.md). */
  async remove(viewer: Viewer | null, id: number, _together = false): Promise<void> {
    const row = db
      .select({ name: schema.dishes.name, ownerId: schema.dishes.ownerId, picture: schema.dishes.picture })
      .from(schema.dishes)
      .where(and(eq(schema.dishes.id, id), dishData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(dishAccess.delete, viewer, row.ownerId);
    try {
      db.transaction((tx) => {
        // Read again in the change itself: a record that left the viewer's reach meanwhile is refused.
        if (!tx.select({ id: schema.dishes.id }).from(schema.dishes).where(and(eq(schema.dishes.id, id), dishData.readable(viewer))).get())
          throw new AccessDenied(viewer !== null);
        const used = usedBy(tx, id, String(row.name ?? id));
        if (used) throw new Conflict(\`in-use:\${JSON.stringify(used)}\`);
        const gone = tx.delete(schema.dishes).where(eq(schema.dishes.id, id)).returning().get();
        if (gone) {
          audit(tx, viewer, { action: "deleted", model: "Dish", record: id, title: gone.name });
        }
      });
    } catch (error) {
      throw refusal(error);
    }
    if (row.picture && row.picture.file !== undefined) deletePicture(row.picture, !!db.select({ id: schema.dishes.id }).from(schema.dishes).where(sql\`\${schema.dishes.picture} like \${\`%"file":"\${row.picture.file}"%\`}\`).get());
    await afterDelete("Dish", id, viewer);
  },

  /**
   * Deletes the chosen records the viewer may delete, all or none (one still in use stops them
   * all, and is named); the others are skipped.
   */
  async removeMany(viewer: Viewer | null, ids: number[], _together = false): Promise<{ deleted: number; skipped: number }> {
    const rows = db
      .select({ id: schema.dishes.id, name: schema.dishes.name, ownerId: schema.dishes.ownerId, picture: schema.dishes.picture })
      .from(schema.dishes)
      .where(and(inArray(schema.dishes.id, ids), dishData.readable(viewer)))
      .all()
      .filter((row) => allows(dishAccess.delete, viewer, row.ownerId));
    db.transaction((tx) => {
      for (const row of rows)
        try {
          const used = usedBy(tx, row.id, String(row.name ?? row.id));
          if (used) throw new Conflict(\`in-use:\${JSON.stringify(used)}\`);
          const gone = tx.delete(schema.dishes).where(eq(schema.dishes.id, row.id)).returning().get();
          if (gone) {
            audit(tx, viewer, { action: "deleted", model: "Dish", record: row.id, title: gone.name });
          }
        } catch (error) {
          const refused = refusal(error);
          throw refused instanceof Conflict && refused.message === "in-use" ? new Conflict(\`in-use:\${row.id}\`) : refused;
        }
    });
    for (const row of rows) {
      if (row.picture && row.picture.file !== undefined) deletePicture(row.picture, !!db.select({ id: schema.dishes.id }).from(schema.dishes).where(sql\`\${schema.dishes.picture} like \${\`%"file":"\${row.picture.file}"%\`}\`).get());
      await afterDelete("Dish", row.id, viewer);
    }
    return { deleted: rows.length, skipped: new Set(ids).size - rows.length };
  },

  /**
   * The dishes the viewer may read whose name contains the text: a search of records that
   * refer to them finds them only among these.
   */
  titled(viewer: Viewer | null, text: string): number[] {
    return db
      .select({ id: schema.dishes.id })
      .from(schema.dishes)
      .where(and(contains([schema.dishes.name], text), dishData.readable(viewer)))
      .all()
      .map((row) => row.id);
  },

  /** Choices for fields that refer to a dish: the ones the viewer may read. */
  options(viewer: Viewer | null) {
    if (readScope(dishAccess.read, viewer) === "none") return [];
    return db
      .select({ value: schema.dishes.id, label: schema.dishes.name })
      .from(schema.dishes)
      .where(dishData.readable(viewer))
      .orderBy(asc(schema.dishes.name))
      .all();
  },
};
"
`;

