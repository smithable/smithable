exports[`../../../examples/barbers/smithable.yml > file list and generated code > src/generated/hooks.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// Where the app reacts to changes: after a record is created, changed or deleted, and once a
// day. Your reactions go in src/custom/hooks.ts (send an email, update another record, call a
// service); a plugin's in its own hooks file. A hook runs on the server, in the request that
// made the change and with the viewer who made it, after the change is saved; a hook that
// throws fails that request. Daily jobs run in production, a day after the server started.
import type * as schema from "#/db/schema";
import type { Viewer } from "#/kit/access";
import { log } from "#/kit/log.server";
import * as custom from "#/custom/hooks";

export type Hook<Row> = (row: Row, viewer: Viewer | null) => void | Promise<void>;

/** Each model's record as it is stored. */
export interface Rows {
  Service: typeof schema.services.$inferSelect;
  Barber: typeof schema.barbers.$inferSelect;
  TimeOff: typeof schema.timeOffs.$inferSelect;
  Appointment: typeof schema.appointments.$inferSelect;
}

export interface Hooks {
  /** After a record is created, by model. */
  afterCreate?: { [M in keyof Rows]?: Hook<Rows[M]> };
  /** After a record is changed, with its new values. */
  afterUpdate?: { [M in keyof Rows]?: Hook<Rows[M]> };
  /** After a record is deleted; only its id is left. */
  afterDelete?: { [M in keyof Rows]?: Hook<{ id: number }> };
  /** Once a day. */
  daily?: (() => void | Promise<void>)[];
}

// Read when a hook runs, not when this module loads: custom code may import the data functions,
// which import this file.
const sources = (): Hooks[] => [custom.hooks];

export async function afterChange<M extends keyof Rows>(
  event: "afterCreate" | "afterUpdate",
  model: M,
  row: Rows[M],
  viewer: Viewer | null,
): Promise<void> {
  for (const source of sources()) {
    // One model's hook at a time: TypeScript cannot narrow the lookup by a generic key.
    const hook = source[event]?.[model] as Hook<Rows[M]> | undefined;
    await hook?.(row, viewer);
  }
}

export async function afterDelete<M extends keyof Rows>(
  model: M,
  id: number,
  viewer: Viewer | null,
): Promise<void> {
  for (const source of sources()) {
    const hook = source.afterDelete?.[model] as Hook<{ id: number }> | undefined;
    await hook?.({ id }, viewer);
  }
}

/** Every daily job, in order; a failing one is reported and the rest still run. */
export async function runDaily(): Promise<void> {
  for (const source of sources())
    for (const job of source.daily ?? []) {
      try {
        await job();
      } catch (error) {
        log.error("A daily job failed", { error });
      }
    }
}

// In production, once a day, starting a day after the server started (pnpm start). The timer
// never keeps the process alive by itself, so the server still stops when asked to.
if (import.meta.env.SSR && import.meta.env.PROD) {
  const day = 24 * 60 * 60 * 1000;
  const tick = () => setTimeout(() => runDaily().finally(tick), day).unref();
  tick();
}
"
`;

exports[`../../../examples/barbers/smithable.yml > file list and generated code > src/generated/outgoing.server.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { eq, type SQL } from "drizzle-orm";
import type { SQLiteColumn, SQLiteTable } from "drizzle-orm/sqlite-core";
import type { db } from "#/db";
import * as schema from "#/db/schema";
import { app } from "#/generated/app";
import type { Viewer } from "#/kit/access";
import { formatValue } from "#/kit/format";
import { counts } from "#/kit/outgoing";
import { type Happening, queueMail, type Recipient } from "#/kit/outgoing.server";

type Tx = Pick<typeof db, "select" | "insert">;
type Row = Record<string, unknown>;

/** One column of the record with the id, inside the transaction. */
function one(tx: Tx, table: SQLiteTable, id: SQLiteColumn, column: SQLiteColumn, value: unknown): unknown {
  if (value == null) return undefined;
  return tx.select({ v: column }).from(table).where(eq(id, value)).get()?.v;
}

/** The users that fit, with their addresses. */
function people(tx: Tx, where: SQL): Recipient[] {
  return tx.select({ id: schema.user.id, email: schema.user.email }).from(schema.user).where(where).all();
}

/** Each model's record as a mail shows it: the subject, its fields, its page. */
const SHOWN: Record<string, (tx: Tx, r: Row) => Omit<Happening, "entry" | "model" | "record">> = {
  "Appointment": (tx, r) => ({
    subject: \`Appointment: \${String(r.name ?? r.id)}\`,
    fields: [
      ["Service", String(one(tx, schema.services, schema.services.id, schema.services.name, r.serviceId) ?? "—")],
      ["Barber", String(one(tx, schema.barbers, schema.barbers.id, schema.barbers.name, r.barberId) ?? "—")],
      ["Starts at", formatValue({ name: "startsAt", label: "Starts at", kind: "datetime", required: false }, r.startsAt, app)],
      ["Name", formatValue({ name: "name", label: "Name", kind: "string", required: false }, r.name, app)],
      ["Phone", formatValue({ name: "phone", label: "Phone", kind: "phone", required: false }, r.phone, app)],
      ["Note", formatValue({ name: "note", label: "Note", kind: "text", required: false }, r.note, app)],
      ["Status", formatValue({
  name: "status",
  label: "Status",
  kind: "choice",
  required: false,
  choices: [
    { value: "requested", label: "Requested" },
    { value: "confirmed", label: "Confirmed" },
    { value: "cancelled", label: "Cancelled" },
  ],
}, r.status, app)],
    ],
    link: \`/appointments/\${r.id}\`,
  }),
};

/** The entries of smithable.yml's outgoing section, with their texts. */
const ENTRIES: {
  name: string;
  model: string;
  when: string;
  fits?: (r: Row) => boolean;
  /** For a change: only one of these fields changing counts. */
  fields?: string[];
  subject?: string;
  text?: string;
  to?: (tx: Tx, r: Row) => Recipient[];
}[] = [
  {
    name: "appointmentRequested",
    model: "Appointment",
    when: "created",
    to: (tx, _r) => people(tx, eq(schema.user.role, "admin")),
  },
  {
    name: "appointmentMade",
    model: "Appointment",
    when: "created",
    to: (tx, r) => r.ownerId == null ? [] : people(tx, eq(schema.user.id, String(r.ownerId))),
  },
  {
    name: "appointmentConfirmed",
    model: "Appointment",
    when: "confirm",
    to: (tx, r) => r.ownerId == null ? [] : people(tx, eq(schema.user.id, String(r.ownerId))),
  },
];

/**
 * Queues what a change asks for, in its transaction: \`what\` is created, changed, deleted or the
 * action's name; \`record\` the record after (a deleted one as it was), \`before\` before a change.
 */
export function outgoing(tx: Tx, viewer: Viewer | null, model: string, what: string, record: Row, before?: Row): void {
  for (const entry of ENTRIES) {
    if (entry.model !== model || !counts(entry.when, what, entry.fits, record, before, entry.fields)) continue;
    const shown = SHOWN[model]?.(tx, record);
    if (!shown || !entry.to) continue;
    queueMail(
      tx,
      viewer,
      { ...shown, ...(entry.subject ? { subject: entry.subject } : {}), ...(entry.text ? { text: entry.text } : {}), entry: entry.name, model, record: record.id as number },
      entry.to(tx, record),
      entry.when === "created",
    );
  }
}
"
`;

