"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, notFound, useNavigate } from "@tanstack/react-router";
import { app } from "#/generated/app";
import { pageAccess } from "#/generated/pages";
import { deleteInstructor, getInstructor, instructorUi, updateInstructor } from "#/generated/instructor";
import { instructorSchema } from "#/generated/instructor.schema";
import { guardPage } from "#/kit/access";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";
import { w } from "#/kit/words";

export const Route = createFileRoute("/admin/instructors/$id")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["admin"], context.viewer, location.href),
  head: () => ({ meta: [{"title":"Admin · Stillwater Yoga"}] }),
  loader: async ({ params }) => {
    const found = await getInstructor({ data: Number(params.id) });
    if (!found) throw notFound();
    return { ...found };
  },
  component: InstructorPage,
});

function InstructorPage() {
  const { row, canWrite, canDelete } = Route.useLoaderData();
  const navigate = useNavigate();
  const back = () => navigate({ to: "/admin/instructors" });
  return (
    <>
      <PageHeader title={row.name || \`Instructor #\${row.id}\`} />
      <ModelForm
        key={String(row.updatedAt)}
        ui={instructorUi}
        app={app}
        schema={instructorSchema}
        initial={row}
        readOnly={!canWrite}
        submitLabel={w.saveChanges}
        onSubmit={async (values) => {
          await updateInstructor({ data: { id: row.id, values } });
          await back();
        }}
        onCancel={back}
        onDelete={
          canDelete
            ? async (together?: boolean) => {
                await deleteInstructor({ data: { id: row.id, together } });
                await back();
              }
            : undefined
        }
      />

    </>
  );
}
"
`;

exports[`../../../examples/booking/smithable.yml > file list and generated code > src/routes/admin/instructors/index.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, Link, useNavigate } from "@tanstack/react-router";
import { pageAccess } from "#/generated/pages";
import { guardPage, allows } from "#/kit/access";
import { createServerFn } from "@tanstack/react-start";
import * as schema from "#/db/schema";
import { instructorAccess, instructorData } from "#/generated/instructor.server";
import { contains } from "#/kit/search";
import { currentViewer } from "#/lib/viewer.server";
import { type Search, listQuery, optional, text } from "#/kit/params";
import { buttonVariants } from "#/components/ui/button";
import { app } from "#/generated/app";
import { instructorUi } from "#/generated/instructor";
import { w } from "#/kit/words";
import { PageHeader } from "#/kit/AppShell";
import { ModelTable } from "#/kit/ModelTable";
import { SearchBox } from "#/kit/SearchBox";
import { Users } from "lucide-react";

/** The instructors matching the search, among those the viewer may read. */
const searchInstructors = createServerFn()
  .validator(listQuery)
  .handler(async ({ data }) => {
    const viewer = await currentViewer();
    const where = data.q ? contains([schema.instructors.name, schema.instructors.bio], data.q) : undefined;
    const rows = await instructorData.list(viewer, where, 501);
    return {
      rows: rows.slice(0, 500),
      more: rows.length > 500,
      canCreate: allows(instructorAccess.create, viewer),
    };
  });

export const Route = createFileRoute("/admin/instructors/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["admin"], context.viewer, location.href),
  head: () => ({ meta: [{"title":"Admin · Stillwater Yoga"}] }),
  validateSearch: (s: Search) => optional({ q: text(s.q) }),
  loaderDeps: ({ search }) => ({ q: search.q }),
  loader: ({ deps }) => searchInstructors({ data: { q: deps.q } }),  component: AdminInstructorsPage,
});

function AdminInstructorsPage() {
  const { rows, canCreate, more } = Route.useLoaderData();
  const { q } = Route.useSearch();
  const navigate = useNavigate();
  const newButton = canCreate && (
    <Link to="/admin/instructors/new" className={buttonVariants()}>
      {w.newOne("instructor")}
    </Link>
  );
  return (
    <>
      <PageHeader
        title="Instructors"
        actions={newButton}
      />
      <SearchBox
        value={q ?? ""}
        placeholder="Search by name or bio"
        onSearch={(text) => navigate({ to: "/admin/instructors", search: { q: text || undefined }, replace: true, resetScroll: false })}
      />
      {more && (
        <p className="text-sm text-muted-foreground">The newest 500 are shown; search to find the others.</p>
      )}
      <ModelTable
        ui={instructorUi}
        app={app}
        rows={rows}
        icon={Users}
        emptyMessage={q ? \`No instructors match “\${q}”.\` : undefined}
        emptyAction={newButton || undefined}
        onOpen={(row) => navigate({ to: "/admin/instructors/$id", params: { id: String(row.id) } })}
      />
    </>
  );
}
"
`;

