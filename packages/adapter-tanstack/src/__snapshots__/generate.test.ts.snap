exports[`../../../examples/invoicing/smithable.yml > file list and generated code > src/generated/client.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { eq } from "drizzle-orm";
import { createInsertSchema } from "drizzle-zod";
import { z } from "zod";
import { db } from "#/db";
import { clients } from "#/db/schema";
import type { ModelUi } from "#/kit/model";

export const clientUi: ModelUi = {
  label: "Client",
  pluralLabel: "Clients",
  titleField: "name",
  columns: ["name", "email", "vatNumber"],
  fields: [
    { name: "name", label: "Name", kind: "string", required: true },
    { name: "email", label: "Email", kind: "email", required: true },
    { name: "address", label: "Address", kind: "text", required: false },
    { name: "vatNumber", label: "Vat number", kind: "string", required: false },
  ],
};

export const clientSchema = createInsertSchema(clients, {
  name: (s) => s.trim().min(1, "Required"),
  email: z.email("Enter a valid email address"),
}).omit({ id: true, createdAt: true, updatedAt: true });

export const listClients = createServerFn().handler(() =>
  db.query.clients.findMany({
    orderBy: (t, { desc }) => [desc(t.id)],
  }),
);

export const getClient = createServerFn()
  .validator(z.number().int())
  .handler(async ({ data: id }) => {
    const row = await db.query.clients.findFirst({
      with: { invoices: true },
      where: (t, { eq }) => eq(t.id, id),
    });
    return row ? row : null;
  });

/** Choices for fields that refer to a client. */
export const clientOptions = createServerFn().handler(() =>
  db
    .select({ value: clients.id, label: clients.name })
    .from(clients)
    .orderBy(clients.name)
    .all(),
);

export const createClient = createServerFn({ method: "POST" })
  .validator(clientSchema)
  .handler(({ data }) => db.insert(clients).values(data).returning().get());

export const updateClient = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), values: clientSchema }))
  .handler(({ data }) =>
    db.update(clients).set(data.values).where(eq(clients.id, data.id)).returning().get(),
  );

export const deleteClient = createServerFn({ method: "POST" })
  .validator(z.number().int())
  .handler(({ data: id }) => {
    db.delete(clients).where(eq(clients.id, id)).run();
  });
"
`;

exports[`../../../examples/invoicing/smithable.yml > file list and generated code > src/generated/invoice.formulas.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { F } from "#/kit/formula";
import { invoiceLineFormulas } from "./invoice-line.formulas";

type Row = Record<string, unknown>;

/** Computed fields of Invoice, on records as stored (money in cents). */
export const invoiceFormulas = {
  total: (r: Row): number => F.toCents(F.SUM(F.list(r.lines).map((x1) => F.fromCents(invoiceLineFormulas.amount(x1))))),
};

/** Values suggested when a Invoice is created. */
export const invoiceDefaults = {
  issuedOn: (_r: Row): string => F.TODAY(),
  dueOn: (r: Row): string => F.DATEADD(F.d(r.issuedOn), 30, "day"),
};

/** The record with its computed fields. */
export function withInvoiceFormulas<T extends Row>(row: T): T & { total: number } {
  return { ...row, total: invoiceFormulas.total(row) };
}
"
`;

exports[`../../../examples/invoicing/smithable.yml > file list and generated code > src/generated/invoice.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { eq } from "drizzle-orm";
import { createInsertSchema } from "drizzle-zod";
import { z } from "zod";
import { db } from "#/db";
import { invoices } from "#/db/schema";
import type { ModelUi } from "#/kit/model";
import { invoiceDefaults, withInvoiceFormulas } from "./invoice.formulas";

export const invoiceUi: ModelUi = {
  label: "Invoice",
  pluralLabel: "Invoices",
  titleField: "number",
  columns: ["number", "clientId", "issuedOn", "dueOn", "status"],
  fields: [
    { name: "number", label: "Number", kind: "string", required: true },
    {
      name: "clientId",
      label: "Client",
      kind: "relation",
      required: true,
      relation: { key: "client", titleField: "name" },
    },
    { name: "issuedOn", label: "Issued on", kind: "date", required: true },
    { name: "dueOn", label: "Due on", kind: "date", required: true },
    {
      name: "status",
      label: "Status",
      kind: "choice",
      required: true,
      choices: [
        { value: "draft", label: "Draft" },
        { value: "sent", label: "Sent" },
        { value: "paid", label: "Paid" },
        { value: "overdue", label: "Overdue" },
      ],
      default: "draft",
    },
    {
      name: "total",
      label: "Total",
      kind: "money",
      required: false,
      computed: true,
    },
  ],
  compute: withInvoiceFormulas,
  defaults: invoiceDefaults,
};

export const invoiceSchema = createInsertSchema(invoices, {
  number: (s) => s.trim().min(1, "Required"),
  issuedOn: (s) => s.regex(/^\\d{4}-\\d{2}-\\d{2}$/, "Enter a valid date"),
  dueOn: (s) => s.regex(/^\\d{4}-\\d{2}-\\d{2}$/, "Enter a valid date"),
}).omit({ id: true, createdAt: true, updatedAt: true });

export const listInvoices = createServerFn().handler(async () =>
  (await db.query.invoices.findMany({
    with: { client: { columns: { id: true, name: true } }, lines: true },
    orderBy: (t, { desc }) => [desc(t.id)],
  })).map(withInvoiceFormulas),
);

export const getInvoice = createServerFn()
  .validator(z.number().int())
  .handler(async ({ data: id }) => {
    const row = await db.query.invoices.findFirst({
      with: { client: { columns: { id: true, name: true } }, lines: true },
      where: (t, { eq }) => eq(t.id, id),
    });
    return row ? withInvoiceFormulas(row) : null;
  });

/** Choices for fields that refer to a invoice. */
export const invoiceOptions = createServerFn().handler(() =>
  db
    .select({ value: invoices.id, label: invoices.number })
    .from(invoices)
    .orderBy(invoices.number)
    .all(),
);

export const createInvoice = createServerFn({ method: "POST" })
  .validator(invoiceSchema)
  .handler(({ data }) => db.insert(invoices).values(data).returning().get());

export const updateInvoice = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), values: invoiceSchema }))
  .handler(({ data }) =>
    db.update(invoices).set(data.values).where(eq(invoices.id, data.id)).returning().get(),
  );

export const deleteInvoice = createServerFn({ method: "POST" })
  .validator(z.number().int())
  .handler(({ data: id }) => {
    db.delete(invoices).where(eq(invoices.id, id)).run();
  });
"
`;

