import { Package } from "lucide-react";

/** The items matching the search and the filters, among those the viewer may read. */
const searchItems = createServerFn()
  .validator(listQuery)
  .handler(async ({ data }) => {
    const viewer = await currentViewer();
    const where = and(
      undefined,
      eq(schema.items.ownerId, viewer?.id ?? ""),
    );
    return {
      ...(await itemData.page(viewer, where, undefined, data.all ? 1 : data.page, data.all ? (viewer ? 10000 : 500) : undefined)),
      canCreate: allows(itemAccess.create, viewer),
      options: {  },
    };
  });

export const Route = createFileRoute("/my-items/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["myItems"], context.viewer, location.href),
  head: () => ({ meta: [{"title":"My items · Torget"}] }),
  validateSearch: (s: Search) => optional({ q: text(s.q), sort: text(s.sort), page: count(s.page) }),
  loaderDeps: ({ search }) => search,
  loader: ({ deps: { q, sort, page, ...f } }) => searchItems({ data: { q, sort, f, page } }),
  // While a search or filter loads, the page stays (and its controls keep their focus).
  pendingMs: Number.POSITIVE_INFINITY,
  gcTime: 0,
  component: MyItemsPage,
});

function MyItemsPage() {
  const { rows, canCreate, total, page: at, size } = Route.useLoaderData();
  const { q, sort, page: _page, ...values } = Route.useSearch();
  const { viewer } = Route.useRouteContext();
  const navigate = useNavigate({ from: "/my-items/" });
  const router = useRouter();
  // The chosen rows, offered when the viewer may do something to at least one row.
  const [selected, setSelected] = useState<Set<number>>(new Set());
  const chosen = rows.filter((row) => selected.has(row.id));
  const selectable = rows.some((row) => allows(itemDeleteRule, viewer, row.ownerId));
  const newButton = canCreate && (
    <Link to="/my-items/new" className={buttonVariants()}>
      {w.newOne("item")}
    </Link>
  );
  return (
    <>
      <PageHeader
        page="myItems"
        title="My items"
        actions={newButton}
      />
      {selectable && (
        <SelectionBar
          count={chosen.length}
          noun={["item", "items"]}
          app={app}
          titleOf={(id) => String(rows.find((row) => row.id === id)?.title ?? id)}
          actions={[]}
          deletable={chosen.filter((row) => allows(itemDeleteRule, viewer, row.ownerId)).length}
          onDelete={(together) => deleteItems({ data: { ids: chosen.map((row) => row.id), together } })}
          onDone={async () => {
            setSelected(new Set());
            await router.invalidate();
          }}
          onExport={() => download(csvName(itemUi), csvOf(itemUi, chosen))}
        />
      )}
      <ModelTable
        ui={itemUi}
        page="myItems"
        paging={{ page: at, size, total, to: (next) => navigate({ to: "/my-items", search: (prev) => ({ ...prev, page: next > 1 ? next : undefined }) }) }}
        app={app}
        exportRows={async () => (await searchItems({ data: { q, sort, f: values, all: true } })).rows}
        rows={rows}
        icon={Package}
        selection={selectable ? { ids: selected, onChange: setSelected } : undefined}
        emptyMessage={q || Object.values(values).some(Boolean) ? "No items match the search and filters." : undefined}
        emptyAction={newButton || undefined}
        onOpen={(row) => navigate({ to: "/my-items/$id", params: { id: String(row.id) } })}
      />
    </>
  );
}
"
`;

