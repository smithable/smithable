"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, Link, useNavigate, useRouter } from "@tanstack/react-router";
import { pageAccess, pageUi, pageHead } from "#/generated/pages";
import { guardPage, allows } from "#/kit/access";
import { createServerFn } from "@tanstack/react-start";
import { instructorAccess, instructorData } from "#/generated/instructor.server";
import { currentViewer } from "#/lib/viewer.server";
import { type Search, count, listQuery, optional } from "#/kit/params";
import { buttonVariants } from "#/components/ui/button";
import { useState } from "react";
import { SelectionBar } from "#/kit/SelectionBar";
import { csvName, csvOf, download } from "#/kit/csv";
import { deleteInstructors, instructorDeleteRule, instructorUi } from "#/generated/instructor";
import { app } from "#/generated/app";
import { w } from "#/kit/words";
import { PageHeader } from "#/kit/AppShell";
import { ModelTable } from "#/kit/ModelTable";
import { Users } from "lucide-react";

/** A page of the instructors the viewer may read. */
const listInstructors = createServerFn()
  .validator(listQuery)
  .handler(async ({ data }) => {
    const viewer = await currentViewer();
    return { ...(await instructorData.page(viewer, undefined, undefined, data.all ? 1 : data.page, data.all ? (viewer ? 10000 : 500) : undefined)), canCreate: allows(instructorAccess.create, viewer) };
  });

export const Route = createFileRoute("/instructors/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["instructors"], context.viewer, location.href),
  head: () => pageHead("instructors"),
  validateSearch: (s: Search) => optional({ page: count(s.page) }),
  loaderDeps: ({ search }) => ({ page: search.page }),
  loader: ({ deps }) => listInstructors({ data: { page: deps.page } }),
  component: InstructorsPage,
});

function InstructorsPage() {
  const { rows, canCreate, total, page: at, size } = Route.useLoaderData();
  const { viewer } = Route.useRouteContext();
  const navigate = useNavigate({ from: "/instructors/" });
  const router = useRouter();
  // The chosen rows, offered when the viewer may do something to at least one row.
  const [selected, setSelected] = useState<Set<number>>(new Set());
  const chosen = rows.filter((row) => selected.has(row.id));
  const selectable = rows.some((row) => allows(instructorDeleteRule, viewer, row.ownerId));
  const newButton = canCreate && (
    <Link to="/instructors/new" className={buttonVariants()}>
      {w.newOne("instructor")}
    </Link>
  );
  return (
    <>
      <PageHeader
        page="instructors"
        title={pageUi["instructors"].title}
        actions={newButton}
      />
      {selectable && (
        <SelectionBar
          count={chosen.length}
          noun={["instructor", "instructors"]}
          app={app}
          titleOf={(id) => String(rows.find((row) => row.id === id)?.name ?? id)}
          actions={[]}
          deletable={chosen.filter((row) => allows(instructorDeleteRule, viewer, row.ownerId)).length}
          onDelete={(together) => deleteInstructors({ data: { ids: chosen.map((row) => row.id), together } })}
          onDone={async () => {
            setSelected(new Set());
            await router.invalidate();
          }}
          onExport={() => download(csvName(instructorUi), csvOf(instructorUi, chosen))}
        />
      )}
      <ModelTable
        ui={instructorUi}
        page="instructors"
        paging={{ page: at, size, total, to: (next) => navigate({ to: "/instructors", search: (prev) => ({ ...prev, page: next > 1 ? next : undefined }) }) }}
        app={app}
        exportRows={async () => (await listInstructors({ data: { all: true } })).rows}
        rows={rows}
        icon={Users}
        selection={selectable ? { ids: selected, onChange: setSelected } : undefined}
        emptyAction={newButton || undefined}
        onOpen={(row) => navigate({ to: "/instructors/$id", params: { id: String(row.id) } })}
      />
    </>
  );
}
"
`;

