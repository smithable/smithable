exports[`../../../examples/booking/smithable.yml > file list and generated code > src/generated/booking.server.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { and, count, eq, ne, sql, type SQL } from "drizzle-orm";
import { db } from "#/db";
import { bookings, sessions } from "#/db/schema";
import { AccessDenied, check, Conflict, type ModelAccess, readScope, refusal, type Viewer } from "#/kit/access";
import { afterChange, afterDelete } from "./hooks";
import { sessionData } from "./session.server";
import type { BookingValues } from "./booking";

/** Who may read, create, change and delete bookings. */
export const bookingAccess: ModelAccess = {
  read: { public: false, roles: ["admin"], owner: true },
  create: { public: false, roles: ["admin", "member"], owner: false },
  write: { public: false, roles: ["admin"], owner: true },
  delete: { public: false, roles: ["admin"], owner: true },
};

/** Checks that the viewer may read the records the values refer to. */
function checkReferences(viewer: Viewer | null, values: BookingValues): void {
  if (values.sessionId != null && !sessionData.canRead(viewer, values.sessionId))
    throw new AccessDenied(viewer !== null);
}

export const bookingData = {
  /** A condition for the bookings the viewer may read. */
  readable(viewer: Viewer | null) {
    const scope = readScope(bookingAccess.read, viewer);
    if (scope === "all") return undefined;
    return scope === "own" && viewer ? eq(bookings.ownerId, viewer.id) : sql\`false\`;
  },

  canRead(viewer: Viewer | null, id: number): boolean {
    const found = db
      .select({ id: bookings.id })
      .from(bookings)
      .where(and(eq(bookings.id, id), bookingData.readable(viewer)))
      .get();
    return found !== undefined;
  },

  /** The bookings the viewer may read; \`where\` narrows them, e.g. to a search; \`limit\` keeps the newest (a data page). */
  async list(viewer: Viewer | null, where?: SQL, limit?: number) {
    if (readScope(bookingAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const rows = await db.query.bookings.findMany({
      where: and(bookingData.readable(viewer), where),
      with: { session: { columns: { id: true } } },
      orderBy: (t, { desc }) => [desc(t.id)],
      limit,
    });
    return rows;
  },

  /** How many bookings the viewer may read, for a data page's overview; none to read: null. */
  count(viewer: Viewer | null): number | null {
    if (readScope(bookingAccess.read, viewer) === "none") return null;
    return db.select({ n: count() }).from(bookings).where(bookingData.readable(viewer)).get()?.n ?? 0;
  },

  /** How many of a session's places are taken, and how many it has: numbers only, never whose. */
  places(sessionId: number): { taken: number; max: number } {
    const taken = db.select({ n: count() }).from(bookings).where(and(eq(bookings.sessionId, sessionId))).get()?.n ?? 0;
    return { taken, max: (db.select({ n: sessions.capacity }).from(sessions).where(eq(sessions.id, sessionId)).get()?.n ?? 0) };
  },

  /** The viewer's own booking for a session, if they have one. */
  mine(viewer: Viewer, sessionId: number): number | undefined {
    return db.select({ id: bookings.id }).from(bookings).where(and(eq(bookings.sessionId, sessionId), eq(bookings.ownerId, viewer.id))).get()?.id;
  },

  async get(viewer: Viewer | null, id: number) {
    const row = await db.query.bookings.findFirst({
      where: and(eq(bookings.id, id), bookingData.readable(viewer)),
      with: { session: { columns: { id: true } } },
    });
    return row ? row : null;
  },

  async create(viewer: Viewer | null, values: BookingValues) {
    check(bookingAccess.create, viewer);
    checkReferences(viewer, values);
    let row: typeof bookings.$inferSelect;
    try {
      // The count and the insert in one transaction: two people cannot both take the last place.
      row = db.transaction((tx) => {
      const taken = tx.select({ n: count() }).from(bookings).where(and(eq(bookings.sessionId, values.sessionId))).get()?.n ?? 0;
      if (taken >= (tx.select({ n: sessions.capacity }).from(sessions).where(eq(sessions.id, values.sessionId)).get()?.n ?? 0)) throw new Conflict("full");
        return tx.insert(bookings).values({ ...values, ownerId: viewer?.id ?? null }).returning().get();
      });
    } catch (error) {
      throw error instanceof Conflict ? error : refusal(error);
    }
    await afterChange("afterCreate", "Booking", row, viewer);
    return row;
  },

  async update(viewer: Viewer | null, id: number, values: BookingValues) {
    const row = db
      .select({ ownerId: bookings.ownerId })
      .from(bookings)
      .where(and(eq(bookings.id, id), bookingData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(bookingAccess.write, viewer, row.ownerId);
    checkReferences(viewer, values);
    let changed: typeof bookings.$inferSelect;
    const updated = values;
    try {
      changed = db.transaction((tx) => {
      const taken = tx.select({ n: count() }).from(bookings).where(and(eq(bookings.sessionId, values.sessionId), ne(bookings.id, id))).get()?.n ?? 0;
      if (taken >= (tx.select({ n: sessions.capacity }).from(sessions).where(eq(sessions.id, values.sessionId)).get()?.n ?? 0)) throw new Conflict("full");
        return tx.update(bookings).set(updated).where(eq(bookings.id, id)).returning().get();
      });
    } catch (error) {
      throw error instanceof Conflict ? error : refusal(error);
    }
    await afterChange("afterUpdate", "Booking", changed, viewer);
    return changed;
  },

  async remove(viewer: Viewer | null, id: number): Promise<void> {
    const row = db
      .select({ ownerId: bookings.ownerId })
      .from(bookings)
      .where(and(eq(bookings.id, id), bookingData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(bookingAccess.delete, viewer, row.ownerId);
    try {
      db.delete(bookings).where(eq(bookings.id, id)).run();
    } catch (error) {
      throw refusal(error);
    }
    await afterDelete("Booking", id, viewer);
  },
};
"
`;

