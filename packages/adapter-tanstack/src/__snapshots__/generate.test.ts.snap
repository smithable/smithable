describe("the markSent action", () => {
  test("admin", async () => {
    const viewer = signedIn("admin");
    const others = insertInvoice(stranger.id, {"status":"draft"});
    const own = insertInvoice(viewer.id, {"status":"draft"});
    expect({
      others: await can(() => runMarkSent(viewer, others.id)),
      own: await can(() => runMarkSent(viewer, own.id)),
    }).toEqual({ others: true, own: true });
  });

  test("member", async () => {
    const viewer = signedIn("member");
    const others = insertInvoice(stranger.id, {"status":"draft"});
    const othersBefore = JSON.stringify(db.select().from(schema.invoices).where(eq(schema.invoices.id, others.id)).get());
    const own = insertInvoice(viewer.id, {"status":"draft"});
    expect({
      others: await can(() => runMarkSent(viewer, others.id)),
      own: await can(() => runMarkSent(viewer, own.id)),
    }).toEqual({ others: false, own: true });
    expect(JSON.stringify(db.select().from(schema.invoices).where(eq(schema.invoices.id, others.id)).get())).toBe(othersBefore);
  });

  test("a visitor who has not signed in", async () => {
    const viewer = null;
    const others = insertInvoice(stranger.id, {"status":"draft"});
    const othersBefore = JSON.stringify(db.select().from(schema.invoices).where(eq(schema.invoices.id, others.id)).get());
    expect({
      others: await can(() => runMarkSent(viewer, others.id)),
      own: false,
    }).toEqual({ others: false, own: false });
    expect(JSON.stringify(db.select().from(schema.invoices).where(eq(schema.invoices.id, others.id)).get())).toBe(othersBefore);
  });

  test("refused on a record where status is not draft", async () => {
    const viewer = signedIn("admin");
    const record = insertInvoice(viewer.id, {"status":"sent"});
    await expect(runMarkSent(viewer, record.id)).rejects.toThrow("This cannot be done now.");
  });

  test("over chosen records, only those it fits and may run on change", async () => {
    const viewer = signedIn("admin");
    const fitting = insertInvoice(viewer.id, {"status":"draft"});
    const notFitting = insertInvoice(viewer.id, {"status":"sent"});
    const notFittingBefore = JSON.stringify(db.select().from(schema.invoices).where(eq(schema.invoices.id, notFitting.id)).get());
    expect(await runMarkSentMany(viewer, [fitting.id, fitting.id, notFitting.id])).toEqual({ changed: 1, skipped: 1 });
    expect(JSON.stringify(db.select().from(schema.invoices).where(eq(schema.invoices.id, notFitting.id)).get())).toBe(notFittingBefore);
    const again = insertInvoice(viewer.id, {"status":"draft"});
    const againBefore = JSON.stringify(db.select().from(schema.invoices).where(eq(schema.invoices.id, again.id)).get());
    await runMarkSentMany(null, [again.id]).catch(() => undefined);
    expect(JSON.stringify(db.select().from(schema.invoices).where(eq(schema.invoices.id, again.id)).get())).toBe(againBefore);
  });
});

