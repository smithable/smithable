"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { F } from "#/kit/formula";

type Row = Record<string, unknown>;

/** Computed fields of OrderLine, on records as stored (money in cents). */
export const orderLineFormulas = {
  amount: (r: Row): number => F.toCents((F.n(r.quantity) * F.fromCents(r.unitPrice))),
};

/** Values suggested when a OrderLine is created. */
export const orderLineDefaults = {

};

/** The record with its computed fields. */
export function withOrderLineFormulas<T extends Row>(row: T): T & { amount: number } {
  return { ...row, amount: orderLineFormulas.amount(row) };
}
"
`;

