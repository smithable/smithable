exports[`../../../examples/invoicing/smithable.yml > file list and generated code > src/generated/ask.server.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// "Ask" in the app (docs/design/assistant.md §6): the seven tools over everything the person
// may read, as core describes them for each role the assistant block names, and ask(), which
// answers a question as the signed-in person: the wording rules first, then the host's model
// (visitors: the rules only). Every call goes through the data functions, as a page's do.
import { AccessDenied, type Viewer } from "#/kit/access";
import type { AskKind } from "#/kit/ask";
import { type Answer, answer, hostModel } from "#/kit/assistant.server";
import { BadInput, NotFound } from "#/kit/refusal";
import type { Offer } from "#/kit/tools";

import { businessProfileData } from "./business-profile.server";
import { clientData } from "./client.server";
import { invoiceData } from "./invoice.server";
import { invoiceLineData } from "./invoice-line.server";
import { runMarkSent } from "./actions/mark-sent.server";
import { runMarkPaid } from "./actions/mark-paid.server";
import { businessProfileSchema } from "#/generated/business-profile.schema";
import { clientSchema } from "#/generated/client.schema";
import { invoiceSchema } from "#/generated/invoice.schema";
import { invoiceLineSchema } from "#/generated/invoice-line.schema";

const whole = (v: unknown, field: string) => {
  if (Number.isInteger(v)) return v as number;
  throw new BadInput(\`"\${field}" must be a record's id, a whole number.\`);
};
const amount = (v: unknown, field: string) => {
  const n = typeof v === "number" ? v : typeof v === "string" ? Number(v.trim()) : Number.NaN;
  if (Number.isFinite(n)) return n;
  throw new BadInput(\`"\${field}" must be an amount, like "12.50".\`);
};

/** The body as an object of known fields, or a refusal naming the first unknown one. */
function fieldsOf(body: unknown, known: readonly string[]): Record<string, unknown> {
  if (!body || typeof body !== "object" || Array.isArray(body)) throw new BadInput("The body must be a JSON object.");
  const unknown = Object.keys(body).find((k) => !known.includes(k));
  if (unknown) throw new BadInput(\`There is no field "\${unknown}" to set. Fields: \${known.join(", ")}.\`);
  return body as Record<string, unknown>;
}

/** A business profile as the API gives it. */
export function businessProfileToApi(row: Record<string, any>) {
  return {
    id: row.id as number,
    businessName: row.businessName ?? null,
    vatNumber: row.vatNumber ?? null,
    iban: row.iban ?? null,
    paymentTermDays: row.paymentTermDays ?? null,
    invoiceFooter: row.invoiceFooter ?? null,
    createdAt: row.createdAt instanceof Date ? row.createdAt.toISOString() : row.createdAt,
    updatedAt: row.updatedAt instanceof Date ? row.updatedAt.toISOString() : row.updatedAt,
  };
}

/** A business profile's values from a body: all of them, or a change to \`current\`. */
export function businessProfileFromApi(body: unknown, current?: Record<string, unknown>) {
  const given = fieldsOf(body, ["businessName", "vatNumber", "iban", "paymentTermDays", "invoiceFooter"]);
  const values: Record<string, unknown> = { ...current };
  for (const [key, v] of Object.entries(given))
    switch (key) {
      case "businessName":
        values.businessName = v;
        break;
      case "vatNumber":
        values.vatNumber = v;
        break;
      case "iban":
        values.iban = v;
        break;
      case "paymentTermDays":
        values.paymentTermDays = v;
        break;
      case "invoiceFooter":
        values.invoiceFooter = v;
        break;
    }
  return businessProfileSchema.parse(values);
}

/** A client as the API gives it. */
export function clientToApi(row: Record<string, any>) {
  return {
    id: row.id as number,
    name: row.name ?? null,
    email: row.email ?? null,
    address: row.address ?? null,
    vatNumber: row.vatNumber ?? null,
    createdAt: row.createdAt instanceof Date ? row.createdAt.toISOString() : row.createdAt,
    updatedAt: row.updatedAt instanceof Date ? row.updatedAt.toISOString() : row.updatedAt,
  };
}

/** A client's values from a body: all of them, or a change to \`current\`. */
export function clientFromApi(body: unknown, current?: Record<string, unknown>) {
  const given = fieldsOf(body, ["name", "email", "address", "vatNumber"]);
  const values: Record<string, unknown> = { ...current };
  for (const [key, v] of Object.entries(given))
    switch (key) {
      case "name":
        values.name = v;
        break;
      case "email":
        values.email = v;
        break;
      case "address":
        values.address = v;
        break;
      case "vatNumber":
        values.vatNumber = v;
        break;
    }
  return clientSchema.parse(values);
}

/** A invoice as the API gives it. */
export function invoiceToApi(row: Record<string, any>) {
  return {
    id: row.id as number,
    number: row.number ?? null,
    client: row.clientId ?? null,
    issuedOn: row.issuedOn ?? null,
    dueOn: row.dueOn ?? null,
    status: row.status ?? null,
    total: row.total == null ? null : (Number(row.total) / 100).toFixed(2),
    createdAt: row.createdAt instanceof Date ? row.createdAt.toISOString() : row.createdAt,
    updatedAt: row.updatedAt instanceof Date ? row.updatedAt.toISOString() : row.updatedAt,
  };
}

/** A invoice's values from a body: all of them, or a change to \`current\`. */
export function invoiceFromApi(body: unknown, current?: Record<string, unknown>) {
  const given = fieldsOf(body, ["number", "client", "issuedOn", "dueOn", "status"]);
  const values: Record<string, unknown> = { ...current };
  for (const [key, v] of Object.entries(given))
    switch (key) {
      case "number":
        values.number = v;
        break;
      case "client":
        values.clientId = v === null ? null : whole(v, "client");
        break;
      case "issuedOn":
        values.issuedOn = v;
        break;
      case "dueOn":
        values.dueOn = v;
        break;
      case "status":
        values.status = v;
        break;
    }
  return invoiceSchema.parse(values);
}

/** A invoice line as the API gives it. */
export function invoiceLineToApi(row: Record<string, any>) {
  return {
    id: row.id as number,
    invoice: row.invoiceId ?? null,
    description: row.description ?? null,
    quantity: row.quantity ?? null,
    unitPrice: row.unitPrice == null ? null : (Number(row.unitPrice) / 100).toFixed(2),
    amount: row.amount == null ? null : (Number(row.amount) / 100).toFixed(2),
    createdAt: row.createdAt instanceof Date ? row.createdAt.toISOString() : row.createdAt,
    updatedAt: row.updatedAt instanceof Date ? row.updatedAt.toISOString() : row.updatedAt,
  };
}

/** A invoice line's values from a body: all of them, or a change to \`current\`. */
export function invoiceLineFromApi(body: unknown, current?: Record<string, unknown>) {
  const given = fieldsOf(body, ["invoice", "description", "quantity", "unitPrice"]);
  const values: Record<string, unknown> = { ...current };
  for (const [key, v] of Object.entries(given))
    switch (key) {
      case "invoice":
        values.invoiceId = v === null ? null : whole(v, "invoice");
        break;
      case "description":
        values.description = v;
        break;
      case "quantity":
        values.quantity = v;
        break;
      case "unitPrice":
        values.unitPrice = v === null ? null : Math.round(amount(v, "unitPrice") * 100);
        break;
    }
  return invoiceLineSchema.parse(values);
}

