describe("the audit log", () => {
  test("names who created, changed and deleted a record, and what changed", async () => {
    const viewer = signedIn("admin");
    const made = await projectData.create(viewer, projectValues(viewer.id));
    await projectData.update(viewer, made.id, projectValues(viewer.id));
    await projectData.remove(viewer, made.id);
    const lines = db
      .select()
      .from(auditLog)
      .where(and(eq(auditLog.model, "Project"), eq(auditLog.recordId, made.id)))
      .all();
    expect(lines.map((l) => [l.action, l.who, l.role])).toEqual([
      ["created", viewer.id, viewer.role],
      ["changed", viewer.id, viewer.role],
      ["deleted", viewer.id, viewer.role],
    ]);
    // Only the line that deleted it keeps the record's name (its title by then); no field's
    // value is stored.
    expect(lines.map((l) => Boolean(l.title))).toEqual([false, false, true]);
    expect(JSON.stringify(lines[1]?.fields ?? [])).not.toContain(":");

    // Forget in the log: administrators only; it blanks the deleted record's name and is logged by id.
    expect(() => forgetInLog(signedIn("member"), { model: "Project", record: made.id })).toThrow(AccessDenied);
    forgetInLog(signedIn("admin"), { model: "Project", record: made.id });
    const after = db.select().from(auditLog).where(and(eq(auditLog.model, "Project"), eq(auditLog.recordId, made.id))).all();
    expect(after.map((l) => l.title)).toEqual([null, null, null]);
    const forgot = db.select().from(auditLog).where(eq(auditLog.action, "forgotten in the log")).all().at(-1);
    expect(forgot).toMatchObject({ title: null, details: { model: "Project", record: made.id } });
  });

  test("keeps the client's details and a deleted record's name 90 days, and a line 12 months", () => {
    const day = 24 * 60 * 60 * 1000;
    const line = (daysAgo: number) =>
      db
        .insert(auditLog)
        .values({ at: new Date(Date.now() - daysAgo * day), who: "test", action: "deleted", title: "Old", address: "10.0.0.1", browser: "test" })
        .returning()
        .get();
    const recent = line(10);
    const older = line(100);
    const oldest = line(400);
    pruneAudit();
    const row = (id: number) => db.select().from(auditLog).where(eq(auditLog.id, id)).get();
    expect(row(recent.id)).toMatchObject({ title: "Old", address: "10.0.0.1" });
    expect(row(older.id)).toMatchObject({ title: null, address: null, browser: null, action: "deleted" });
    expect(row(oldest.id)).toBeUndefined();
  });
});
"
`;

exports[`../../../examples/api/smithable.yml > file list and generated code > src/generated/actions/complete.server.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { eq } from "drizzle-orm";
import { db } from "#/db";
import * as schema from "#/db/schema";
import { AccessDenied, allows, check, type Viewer } from "#/kit/access";
import { audit } from "#/kit/audit.server";
import { afterChange } from "#/generated/hooks";
import { taskSettable } from "#/generated/task.schema";
import { taskData } from "#/generated/task.server";
import { completeAccess, completeFits } from "./complete";

type Row = NonNullable<Awaited<ReturnType<typeof taskData.get>>>;

/** The task's new values (only the fields the action sets), worked out on it as it was. */
function plan(_viewer: Viewer | null, row: Row) {
  return {
    id: row.id,
    values: taskSettable.partial().parse({
      status: "done",
    }),

  };
}

/** Runs the "complete" action on the task as the viewer. */
export async function runComplete(viewer: Viewer | null, id: number) {
  const row = await taskData.get(viewer, id);
  if (!row) throw new AccessDenied(viewer !== null);
  check(completeAccess, viewer, row.ownerId);
  if (!completeFits(row, viewer)) throw new Error("This cannot be done now.");
  const one = plan(viewer, row);
  return taskData.update(viewer, id, one.values, "complete", ["status"]);
}

/**
 * Runs the "complete" action on each chosen task it fits and the viewer may run it on
 * (docs/design/actions.md §9); the others are skipped. All or none: one that is refused stops
 * them all, and is named.
 */
export async function runCompleteMany(viewer: Viewer | null, ids: number[]) {
  const plans: ReturnType<typeof plan>[] = [];
  // An id given twice is one record, run once.
  const unique = [...new Set(ids)];
  for (const id of unique) {
    const row = await taskData.get(viewer, id);
    if (!row || !allows(completeAccess, viewer, row.ownerId) || !completeFits(row, viewer)) continue;
    try {
      plans.push(plan(viewer, row));
    } catch (error) {
      const why = error instanceof Error ? error.message : String(error);
      throw new Error(\`Task "\${String(row.title ?? row.id)}": \${why}\`);
    }
  }
  const written = db.transaction((tx) => plans.map((p) => {
      const changed = tx.update(schema.tasks).set(p.values).where(eq(schema.tasks.id, p.id)).returning().get();
      audit(tx, viewer, { action: "complete", model: "Task", record: changed.id, fields: ["status"] });
      const inserted = [

      ] as const;

      return { changed, inserted };
    }));
  for (const w of written) {
    await afterChange("afterUpdate", "Task", w.changed, viewer);

  }
  return { changed: plans.length, skipped: unique.length - plans.length };
}
"
`;

exports[`../../../examples/api/smithable.yml > file list and generated code > src/generated/actions/complete.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { z } from "zod";
import type { Rule } from "#/kit/access";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { writeAllowed } from "#/kit/limit";
import { currentViewer } from "#/lib/viewer.server";
import { runComplete, runCompleteMany } from "./complete.server";

/** Who may run the "complete" action: whoever may edit the task. */
export const completeAccess: Rule = { public: false, roles: ["admin", "member", "assistant"], owner: true };

/** Whether the "complete" action fits the task: it is offered and allowed only then. */
export function completeFits(row: { status?: unknown }, _viewer: { id: string } | null): boolean {
  return ["todo","doing"].includes(String(row.status));
}

/** The viewer about to run it, counted against how often one may write (see src/kit/limit.ts). */
async function writer() {
  const viewer = await currentViewer();
  writeAllowed(viewer, getRequestHeaders());
  return viewer;
}

export const complete = createServerFn({ method: "POST" })
  .validator(z.number().int())
  .handler(async ({ data }) => runComplete(await writer(), data));

/** The "complete" action on the chosen tasks (at most 1,000 at once). */
export const completeMany = createServerFn({ method: "POST" })
  .validator(z.object({ ids: z.array(z.number().int()).max(1000) }))
  .handler(async ({ data }) => runCompleteMany(await writer(), data.ids));
"
`;

