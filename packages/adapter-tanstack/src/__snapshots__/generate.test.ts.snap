"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { z } from "zod";
import type * as schema from "#/db/schema";
import { allows, type Rule } from "#/kit/access";
import type { RecordUi } from "#/kit/model";
import { orderDefaults, withOrderFormulas } from "./order.formulas";
import { orderAccess, orderData } from "./order.server";
import { writeAllowed } from "#/kit/limit";
import { currentViewer } from "#/lib/viewer.server";
import { orderSchema } from "./order.schema";

export type { OrderValues } from "./order.schema";

/** The viewer about to write, counted against how often one may (see src/kit/limit.ts). */
async function writer() {
  const viewer = await currentViewer();
  writeAllowed(viewer, getRequestHeaders());
  return viewer;
}

/** Order records as the kit reads them. */
export type OrderRow = typeof schema.orders.$inferSelect & {
  customer?: { id: number; name: string; deletedAt?: Date | null } | null;
  shippingCost?: unknown;
};

export const orderUi: RecordUi<OrderRow> = {
  model: "Order",
  label: "Order",
  pluralLabel: "Orders",
  titleField: "number",
  columns: ["number", "customerId", "status", "total", "shippingMethod"],
  fields: [
    {
      name: "number",
      label: "Number",
      kind: "string",
      required: true,
      get: (row) => row.number,
    },
    {
      name: "customerId",
      label: "Customer",
      kind: "relation",
      required: true,
      relation: { key: "customer", titleField: "name" },
      get: (row) => (row.customer && !row.customer.deletedAt ? row.customer.name : null),
    },
    {
      name: "status",
      label: "Status",
      kind: "choice",
      required: true,
      choices: [
        { value: "draft", label: "Draft" },
        { value: "placed", label: "Placed" },
        { value: "shipped", label: "Shipped" },
        { value: "canceled", label: "Canceled" },
      ],
      default: "draft",
      get: (row) => row.status,
    },
    {
      name: "total",
      label: "Total",
      kind: "money",
      required: true,
      get: (row) => row.total,
    },
    {
      name: "shippingMethod",
      label: "Shipping method",
      kind: "choice",
      required: true,
      choices: [
        { value: "standard", label: "Standard" },
        { value: "express", label: "Express" },
      ],
      default: "standard",
      get: (row) => row.shippingMethod,
    },
    {
      name: "shippingCost",
      label: "Shipping cost",
      kind: "money",
      required: false,
      computed: true,
      get: (row) => row.shippingCost,
    },
    {
      name: "placedAt",
      label: "Placed at",
      kind: "datetime",
      required: false,
      get: (row) => row.placedAt,
    },
  ],
  compute: withOrderFormulas,
  defaults: orderDefaults,
};

/** Who may delete orders: a list's selection offers Delete by it (the server checks again). */
export const orderDeleteRule: Rule = { public: false, roles: ["admin"], owner: true };


export const listOrders = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return { rows: await orderData.list(viewer), canCreate: allows(orderAccess.create, viewer) };
});

export const getOrder = createServerFn()
  .validator(z.number().int())
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    const row = await orderData.get(viewer, id);
    // In the trash: its page shows it read-only, with when, by whom and Restore.
    if (!row) {
      const gone = await orderData.trashed(viewer, id);
      return gone && { row: gone.row, canWrite: false, canDelete: false, trashed: { at: gone.deletedAt, by: gone.by, until: gone.until } };
    }
    if (!row) return null;
    return {
      row,
      trashed: null,
      canWrite: allows(orderAccess.write, viewer, row.ownerId),
      canDelete: allows(orderAccess.delete, viewer, row.ownerId),
    };
  });

export const createOrder = createServerFn({ method: "POST" })
  .validator(orderSchema)
  .handler(async ({ data }) => orderData.create(await writer(), data));

export const updateOrder = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), values: orderSchema }))
  .handler(async ({ data }) => orderData.update(await writer(), data.id, data.values));

/** Deletes a order; \`together\` takes what points to it along (docs/design/delete-together.md). */
export const deleteOrder = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), together: z.boolean().optional() }))
  .handler(async ({ data }) => orderData.remove(await writer(), data.id, data.together));

/** Deletes the chosen orders, all or none (at most 1,000 at once). */
export const deleteOrders = createServerFn({ method: "POST" })
  .validator(z.object({ ids: z.array(z.number().int()).max(1000), together: z.boolean().optional() }))
  .handler(async ({ data }) => orderData.removeMany(await writer(), data.ids, data.together));

/** The viewer's trash of orders (docs/design/trash.md). */
export const trashedOrders = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return { rows: await orderData.trash(viewer) };
});

/** Takes the chosen orders out of the trash. */
export const restoreOrders = createServerFn({ method: "POST" })
  .validator(z.array(z.number().int()).max(1000))
  .handler(async ({ data: ids }) => orderData.restore(await writer(), ids));

/** Removes the chosen orders in the trash for good. */
export const eraseOrders = createServerFn({ method: "POST" })
  .validator(z.array(z.number().int()).max(1000))
  .handler(async ({ data: ids }) => orderData.removeForGood(await writer(), ids));
"
`;

