exports[`../../../examples/records/smithable.yml > file list and generated code > src/generated/ask.server.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// "Ask" in the app (docs/design/assistant.md §6): the seven tools over everything the person
// may read, as core describes them for each role the assistant block names, and ask(), which
// answers a question as the signed-in person: the wording rules first, then the host's model
// (visitors: the rules only). Every call goes through the data functions, as a page's do.
import { AccessDenied, type Viewer } from "#/kit/access";
import type { AskKind } from "#/kit/ask";
import { type Answer, answer, hostModel } from "#/kit/assistant.server";
import { BadInput, NotFound } from "#/kit/refusal";
import type { Offer } from "#/kit/tools";

import { itemData } from "./item.server";

import { itemSchema } from "#/generated/item.schema";


/** The body as an object of known fields, or a refusal naming the first unknown one. */
function fieldsOf(body: unknown, known: readonly string[]): Record<string, unknown> {
  if (!body || typeof body !== "object" || Array.isArray(body)) throw new BadInput("The body must be a JSON object.");
  const unknown = Object.keys(body).find((k) => !known.includes(k));
  if (unknown) throw new BadInput(\`There is no field "\${unknown}" to set. Fields: \${known.join(", ")}.\`);
  return body as Record<string, unknown>;
}

/** A item as the API gives it. */
export function itemToApi(row: Record<string, any>) {
  return {
    id: row.id as number,
    name: row.name ?? null,
    summary: row.summary ?? null,
    kind: row.kind ?? null,
    link: row.link ?? null,
    addedOn: row.addedOn ?? null,
    createdAt: row.createdAt instanceof Date ? row.createdAt.toISOString() : row.createdAt,
    updatedAt: row.updatedAt instanceof Date ? row.updatedAt.toISOString() : row.updatedAt,
  };
}

/** A item's values from a body: all of them, or a change to \`current\`. */
export function itemFromApi(body: unknown, current?: Record<string, unknown>) {
  const given = fieldsOf(body, ["name", "summary", "kind", "link", "addedOn"]);
  const values: Record<string, unknown> = { ...current };
  for (const [key, v] of Object.entries(given))
    switch (key) {
      case "name":
        values.name = v;
        break;
      case "summary":
        values.summary = v;
        break;
      case "kind":
        values.kind = v;
        break;
      case "link":
        values.link = v;
        break;
      case "addedOn":
        values.addedOn = v;
        break;
    }
  return itemSchema.parse(values);
}

/**
 * What each caller is offered (by the key's role, and for a visitor without a key): the tools,
 * the summary, and what describe answers per kind, as that caller may use it.
 */
const OFFERS: Record<string, Offer & { describe: Record<string, string> }> = {
  "admin": {
    "summary": "Our Collection: A place to keep and show a collection of items.\\nItem (items): name*, summary, kind* (general | favorite | archived), link (url), addedOn* (date). Title: name.\\n* required. You act as someone with the role admin.",
    "tools": [
      {
        "name": "find",
        "description": "Records of one kind the caller may read, newest first, as {columns, rows, total}. Ask only for the fields needed; id and title always come.",
        "inputSchema": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "Item"
              ]
            },
            "where": {
              "type": "object",
              "description": "Field values to match, e.g. {\\"status\\":\\"open\\"}; a list means any of them; a number or date takes {\\"from\\":…,\\"to\\":…}; a reference takes an id or the record's title (\\"me\\" for a user); {\\"mine\\":true} is the caller's own records."
            },
            "search": {
              "type": "string",
              "description": "Words to look for in the records' texts."
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "sort": {
              "type": "string",
              "description": "A field; \\"-field\\" for the largest first."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 10
            },
            "page": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "annotations": {
          "readOnlyHint": true,
          "destructiveHint": false
        }
      },
      {
        "name": "measure",
        "description": "A number worked out by the app, never by reading rows: how many records, or the sum, average, min or max of a number field, optionally per value of a field or per month of a date. A min or max names the record that holds it; per reference, each group carries its title, the largest first.",
        "inputSchema": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "Item"
              ]
