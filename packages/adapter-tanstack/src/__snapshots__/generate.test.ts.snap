}

/** Runs the "startWork" action on the support case as the viewer, with what was asked. */
export async function runStartWork(viewer: Viewer | null, id: number, asked: z.output<typeof startWorkAsks>) {
  const row = await supportCaseData.get(viewer, id);
  if (!row) throw new AccessDenied(viewer !== null);
  check(startWorkAccess, viewer, row.ownerId);
  if (!startWorkFits(row, viewer)) throw new Error("This cannot be done now.");
  const one = plan(viewer, row, asked);
  return supportCaseData.update(viewer, id, one.values, "startWork", ["status"]);
}

/**
 * Runs the "startWork" action on each chosen support case it fits and the viewer may run it on
 * (docs/design/actions.md §9); the others are skipped. All or none: one that is refused stops
 * them all, and is named.
 */
export async function runStartWorkMany(viewer: Viewer | null, ids: number[], asked: z.output<typeof startWorkAsks>) {
  const plans: ReturnType<typeof plan>[] = [];
  // An id given twice is one record, run once.
  const unique = [...new Set(ids)];
  for (const id of unique) {
    const row = await supportCaseData.get(viewer, id);
    if (!row || !allows(startWorkAccess, viewer, row.ownerId) || !startWorkFits(row, viewer)) continue;
    try {
      plans.push(plan(viewer, row, asked));
    } catch (error) {
      const why = error instanceof Error ? error.message : String(error);
      throw new Error(\`Support case "\${String(row.subject ?? row.id)}": \${why}\`);
    }
  }
  const written = db.transaction((tx) => plans.map((p) => {
      const before = tx.select().from(schema.supportCases).where(eq(schema.supportCases.id, p.id)).get();
      const changed = tx.update(schema.supportCases).set(p.values).where(eq(schema.supportCases.id, p.id)).returning().get();
      audit(tx, viewer, { action: "startWork", model: "SupportCase", record: changed.id, fields: ["status","assignee"] });
      outgoing(tx, viewer, "SupportCase", "startWork", changed, before);
      const inserted = [

      ] as const;

      return { changed, inserted };
    }));
  for (const w of written) {
    await afterChange("afterUpdate", "SupportCase", w.changed, viewer);

  }
  return { changed: plans.length, skipped: unique.length - plans.length };
}
"
`;

exports[`../../../examples/support/smithable.yml > file list and generated code > src/generated/actions/start-work.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { z } from "zod";
import { supportCaseUi } from "#/generated/support-case";
import { supportCaseSchema } from "#/generated/support-case.schema";
import type { Rule } from "#/kit/access";
import { getRequestHeaders } from "@tanstack/react-start/server";
import type { ModelUi } from "#/kit/model";
import { userOptions } from "#/generated/users";
import { writeAllowed } from "#/kit/limit";
import { currentViewer } from "#/lib/viewer.server";
import { runStartWork, runStartWorkMany } from "./start-work.server";

/** Who may run the "startWork" action: whoever may edit the support case. */
export const startWorkAccess: Rule = { public: false, roles: ["admin", "agent"], owner: true };

/** Whether the "startWork" action fits the support case: it is offered and allowed only then. */
export function startWorkFits(row: { status?: unknown }, _viewer: { id: string } | null): boolean {
  return ["open","reopened"].includes(String(row.status));
}

/** What the "startWork" action asks for when its button is pressed. */
export const startWorkAsks = z.object({
  "assigneeId": supportCaseSchema.shape.assigneeId,
});

/** The dialog's fields: the support case's own, then each added record's under its heading. */
export const startWorkAskUi: ModelUi = {
  label: "Start work",
  pluralLabel: "Start work",
  titleField: "id",
  columns: [],
  fields: [
    ...supportCaseUi.fields.filter((f) => f.name === "assigneeId").map((f) => ({ ...f, required: true })),
  ],
  sections: [],
};

/** The choices of the references it asks for, loaded when its dialog opens. */
export async function startWorkAskOptions() {
  return { "assigneeId": await userOptions() };
}

/** The viewer about to run it, counted against how often one may write (see src/kit/limit.ts). */
async function writer() {
  const viewer = await currentViewer();
  writeAllowed(viewer, getRequestHeaders());
  return viewer;
}

export const startWork = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), values: startWorkAsks }))
  .handler(async ({ data }) => runStartWork(await writer(), data.id, data.values));

/** The "startWork" action on the chosen support cases (at most 1,000 at once). */
export const startWorkMany = createServerFn({ method: "POST" })
  .validator(z.object({ ids: z.array(z.number().int()).max(1000), values: startWorkAsks }))
  .handler(async ({ data }) => runStartWorkMany(await writer(), data.ids, data.values));
"
`;

