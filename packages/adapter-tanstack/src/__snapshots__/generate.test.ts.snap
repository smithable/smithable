describe("the audit log", () => {
  test("names who created, changed and deleted a record, and what changed", async () => {
    const viewer = signedIn("admin");
    const made = await componentData.create(viewer, componentValues(viewer.id));
    await componentData.update(viewer, made.id, componentValues(viewer.id));
    await componentData.remove(viewer, made.id);
    const lines = db
      .select()
      .from(auditLog)
      .where(and(eq(auditLog.model, "Component"), eq(auditLog.recordId, made.id)))
      .all();
    expect(lines.map((l) => [l.action, l.who, l.role])).toEqual([
      ["created", viewer.id, viewer.role],
      ["changed", viewer.id, viewer.role],
      ["deleted", viewer.id, viewer.role],
    ]);
    // Only the line that deleted it keeps the record's name (its title by then); no field's
    // value is stored.
    expect(lines.map((l) => Boolean(l.title))).toEqual([false, false, true]);
    expect(JSON.stringify(lines[1]?.fields ?? [])).not.toContain(":");

    // Forget in the log: administrators only; it blanks the deleted record's name and is logged by id.
    expect(() => forgetInLog(signedIn("staff"), { model: "Component", record: made.id })).toThrow(AccessDenied);
    forgetInLog(signedIn("admin"), { model: "Component", record: made.id });
    const after = db.select().from(auditLog).where(and(eq(auditLog.model, "Component"), eq(auditLog.recordId, made.id))).all();
    expect(after.map((l) => l.title)).toEqual([null, null, null]);
    const forgot = db.select().from(auditLog).where(eq(auditLog.action, "forgotten in the log")).all().at(-1);
    expect(forgot).toMatchObject({ title: null, details: { model: "Component", record: made.id } });
  });

  test("keeps the client's details and a deleted record's name 90 days, and a line 12 months", () => {
    const day = 24 * 60 * 60 * 1000;
    const line = (daysAgo: number) =>
      db
        .insert(auditLog)
        .values({ at: new Date(Date.now() - daysAgo * day), who: "test", action: "deleted", title: "Old", address: "10.0.0.1", browser: "test" })
        .returning()
        .get();
    const recent = line(10);
    const older = line(100);
    const oldest = line(400);
    pruneAudit();
    const row = (id: number) => db.select().from(auditLog).where(eq(auditLog.id, id)).get();
    expect(row(recent.id)).toMatchObject({ title: "Old", address: "10.0.0.1" });
    expect(row(older.id)).toMatchObject({ title: null, address: null, browser: null, action: "deleted" });
    expect(row(oldest.id)).toBeUndefined();
  });
});
"
`;

exports[`../../../examples/status/smithable.yml > file list and generated code > src/generated/actions/identified.server.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { eq } from "drizzle-orm";
import { db } from "#/db";
import * as schema from "#/db/schema";
import { AccessDenied, allows, check, personOf, type Viewer } from "#/kit/access";
import { audit } from "#/kit/audit.server";
import { F } from "#/kit/formula";
import { afterChange } from "#/generated/hooks";
import { incidentSettable } from "#/generated/incident.schema";
import { incidentData } from "#/generated/incident.server";
import { incidentUpdateSettable } from "#/generated/incident-update.schema";
import { incidentUpdateAccess } from "#/generated/incident-update.server";
import { identifiedAccess, identifiedFits } from "./identified";

type Row = NonNullable<Awaited<ReturnType<typeof incidentData.get>>>;

/** The incident's new values (only the fields the action sets) and the records it adds, worked out on it as it was. */
function plan(_viewer: Viewer | null, row: Row) {
  return {
    id: row.id,
    values: incidentSettable.partial().parse({
      status: "identified",
    }),
    added0: incidentUpdateSettable.parse({
      incidentId: row.id,
      at: new Date(F.NOW()),
      status: "identified",
      message: "The cause is found and a fix is being worked on.",
    }),
  };
}

/** Runs the "identified" action on the incident as the viewer. */
export async function runIdentified(viewer: Viewer | null, id: number) {
  const row = await incidentData.get(viewer, id);
  if (!row) throw new AccessDenied(viewer !== null);
  check(identifiedAccess, viewer, row.ownerId);
  if (!identifiedFits(row, viewer)) throw new Error("This cannot be done now.");
  check(incidentUpdateAccess.create, viewer);
  const one = plan(viewer, row);
  // One transaction: the change and the records it adds, or nothing.
  const written = db.transaction((tx) => {
      const changed = tx.update(schema.incidents).set(one.values).where(eq(schema.incidents.id, one.id)).returning().get();
      audit(tx, viewer, { action: "identified", model: "Incident", record: changed.id, fields: ["status"] });
      const inserted = [
        tx.insert(schema.incidentUpdates).values({ ...one.added0, ownerId: personOf(viewer) }).returning().get(),
      ] as const;
      audit(tx, viewer, { action: "created", model: "IncidentUpdate", record: inserted[0].id, details: { by: "identified" } });
      return { changed, inserted };
    });
  await afterChange("afterUpdate", "Incident", written.changed, viewer);
  await afterChange("afterCreate", "IncidentUpdate", written.inserted[0], viewer);
  return written.changed;
}

/**
 * Runs the "identified" action on each chosen incident it fits and the viewer may run it on
 * (docs/design/actions.md §9); the others are skipped. All or none: one that is refused stops
 * them all, and is named.
 */
export async function runIdentifiedMany(viewer: Viewer | null, ids: number[]) {
  check(incidentUpdateAccess.create, viewer);
  const plans: ReturnType<typeof plan>[] = [];
  // An id given twice is one record, run once.
  const unique = [...new Set(ids)];
  for (const id of unique) {
    const row = await incidentData.get(viewer, id);
    if (!row || !allows(identifiedAccess, viewer, row.ownerId) || !identifiedFits(row, viewer)) continue;
    try {
      plans.push(plan(viewer, row));
    } catch (error) {
      const why = error instanceof Error ? error.message : String(error);
      throw new Error(\`Incident "\${String(row.title ?? row.id)}": \${why}\`);
    }
  }
  const written = db.transaction((tx) => plans.map((p) => {
      const changed = tx.update(schema.incidents).set(p.values).where(eq(schema.incidents.id, p.id)).returning().get();
      audit(tx, viewer, { action: "identified", model: "Incident", record: changed.id, fields: ["status"] });
      const inserted = [
