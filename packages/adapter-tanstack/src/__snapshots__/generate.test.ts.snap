import { taskAccess, taskData } from "#/generated/task.server";
import { contains } from "#/kit/search";
import { currentViewer } from "#/lib/viewer.server";
import { type Search, listQuery, optional, text } from "#/kit/params";
import { buttonVariants } from "#/components/ui/button";
import { app } from "#/generated/app";
import { taskUi } from "#/generated/task";
import { w } from "#/kit/words";
import { PageHeader } from "#/kit/AppShell";
import { ModelTable } from "#/kit/ModelTable";
import { SearchBox } from "#/kit/SearchBox";

/** The tasks matching the search, among those the viewer may read. */
const searchTasks = createServerFn()
  .validator(listQuery)
  .handler(async ({ data }) => {
    const viewer = await currentViewer();
    const where = data.q ? contains([schema.tasks.title, schema.tasks.status, schema.tasks.details], data.q) : undefined;
    const rows = await taskData.list(viewer, where, 501);
    return {
      rows: rows.slice(0, 500),
      more: rows.length > 500,
      canCreate: allows(taskAccess.create, viewer),
    };
  });

export const Route = createFileRoute("/admin/tasks/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["admin"], context.viewer, location.href),
  head: () => ({ meta: [{"title":"Admin · Team Tasks"}] }),
  validateSearch: (s: Search) => optional({ q: text(s.q) }),
  loaderDeps: ({ search }) => ({ q: search.q }),
  loader: ({ deps }) => searchTasks({ data: { q: deps.q } }),  component: AdminTasksPage,
});

function AdminTasksPage() {
  const { rows, canCreate, more } = Route.useLoaderData();
  const { q } = Route.useSearch();
  const navigate = useNavigate();
  const newButton = canCreate && (
    <Link to="/admin/tasks/new" className={buttonVariants()}>
      {w.newOne("task")}
    </Link>
  );
  return (
    <>
      <PageHeader
        title="Tasks"
        actions={newButton}
      />
      <SearchBox
        value={q ?? ""}
        placeholder="Search by title, status or details"
        onSearch={(text) => navigate({ to: "/admin/tasks", search: { q: text || undefined }, replace: true, resetScroll: false })}
      />
      {more && (
        <p className="text-sm text-muted-foreground">The newest 500 are shown; search to find the others.</p>
      )}
      <ModelTable
        ui={taskUi}
        app={app}
        rows={rows}
        emptyMessage={q ? \`No tasks match “\${q}”.\` : undefined}
        emptyAction={newButton || undefined}
        onOpen={(row) => navigate({ to: "/admin/tasks/$id", params: { id: String(row.id) } })}
      />
    </>
  );
}
"
`;

exports[`../../../examples/api/smithable.yml > file list and generated code > src/routes/admin/tasks/new.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, useNavigate } from "@tanstack/react-router";
import { app } from "#/generated/app";
import { pageAccess } from "#/generated/pages";
import { createTask, taskUi } from "#/generated/task";
import { taskSchema } from "#/generated/task.schema";
import { projectOptions } from "#/generated/project";
import { userOptions } from "#/generated/users";
import { guardPage } from "#/kit/access";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";
import { w } from "#/kit/words";

export const Route = createFileRoute("/admin/tasks/new")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["admin"], context.viewer, location.href),
  head: () => ({ meta: [{"title":"Admin · Team Tasks"}] }),
  loader: async () => ({ options: { projectId: await projectOptions(), assigneeId: await userOptions() } }),
  component: NewTaskPage,
});

function NewTaskPage() {
  const { options } = Route.useLoaderData();
  const navigate = useNavigate();
  const back = () => navigate({ to: "/admin/tasks" });
  return (
    <>
      <PageHeader title={w.newOne("task")} />
      <ModelForm
        ui={taskUi}
        app={app}
        schema={taskSchema}
        options={options}
        submitLabel={w.createOne("task")}
        onSubmit={async (values) => {
          await createTask({ data: values });
          await back();
        }}
        onCancel={back}
      />
    </>
  );
}
"
`;

exports[`../../../examples/api/smithable.yml > file list and generated code > src/routes/api/v1/notes/$id.$field.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// A note's pictures and documents, for programs with a key: GET one (?n= for the n-th of
// several), PUT one as the body (a document's name in X-File-Name, a picture's description in
// X-Alt); a field of several gets it added.
import { createFileRoute } from "@tanstack/react-router";
import { noteData } from "#/generated/note.server";
import { BadInput, bytesOf, fileCall, NotFound } from "#/kit/api.server";
import { receiptFor } from "#/kit/receipts.server";
import {
  BadFile,
  BadPicture,
  FILE_MAX_BYTES,
  PICTURE_MAX_BYTES,
  roomFor,
  saveFile,
  savePicture,
  scanned,
  uploadResponse,
} from "#/kit/uploads";

const FIELDS: Record<string, { kind: "picture" | "file"; key: string; many: boolean; max: number }> = {
  "attachment": { kind: "file", key: "attachment", many: false, max: 10 },
};

async function target(viewer: Parameters<typeof noteData.get>[0], id: string, name: string) {
  const field = FIELDS[name];
  if (!field) throw new NotFound("This note has no picture or document by that name.");
  const row = await noteData.get(viewer, Number(id));
  if (!row) throw new NotFound("No such note, or not one this key may read.");
  return { field, row, value: (row as Record<string, unknown>)[field.key] };
}

export const Route = createFileRoute("/api/v1/notes/$id/$field")({
  server: {
    handlers: {
      GET: ({ request, params }) =>
        fileCall(request, async (viewer) => {
          const { field, value } = await target(viewer, params.id, params.field);
          const n = Number(new URL(request.url).searchParams.get("n") ?? 0);
          return uploadResponse(request, field.kind, field.many ? (Array.isArray(value) ? value[n] : undefined) : value, false);
        }),
      PUT: ({ request, params }) =>
        fileCall(request, async (viewer) => {
          const { field, row, value } = await target(viewer, params.id, params.field);
          const list = Array.isArray(value) ? value : [];
          if (field.many && list.length >= field.max) throw new BadInput(\`At most \${field.max} here.\`);
          // The app's storage is full (UPLOADS_MAX_BYTES): refused before the body is read.
          if (!roomFor(Number(request.headers.get("content-length") ?? 0))) throw new BadInput("There is no room left for files in this app.");
          const bytes = await bytesOf(request, field.kind === "file" ? FILE_MAX_BYTES : PICTURE_MAX_BYTES);
          let stored: unknown;
          try {
            await scanned(bytes);
          } catch (error) {
            if (error instanceof BadFile) throw new BadInput(error.message);
            throw error;
          }
          const named = (header: string) => decodeURIComponent(request.headers.get(header) ?? "");
          try {
            stored = field.kind === "file" ? saveFile("note", bytes, named("x-file-name")) : savePicture("note", bytes, named("x-alt"));
          } catch (error) {
            if (error instanceof BadFile || error instanceof BadPicture) throw new BadInput(error.message);
            throw error;
          }
          const sent = { ...(stored as { file: string }), receipt: receiptFor(viewer?.id ?? null, "note", params.field, (stored as { file: string }).file) };
          await noteData.update(viewer, row.id, { [field.key]: field.many ? [...list, sent] : sent } as never);
          return stored;
        }),
    },
  },
});
"
`;

exports[`../../../examples/api/smithable.yml > file list and generated code > src/routes/api/v1/notes/$id.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// One note for programs with a key: read, change (the fields given) or delete it.
import { createFileRoute } from "@tanstack/react-router";
import { noteFromApi, noteToApi } from "#/generated/api.server";
import { noteData } from "#/generated/note.server";
import { NotFound, apiCall } from "#/kit/api.server";

const found = async (viewer: Parameters<typeof noteData.get>[0], id: string) => {
  const row = await noteData.get(viewer, Number(id));
  if (!row) throw new NotFound("No such note, or not one this key may read.");
  return row;
};

export const Route = createFileRoute("/api/v1/notes/$id")({
  server: {
    handlers: {
      GET: ({ request, params }) => apiCall(request, async (viewer) => noteToApi(await found(viewer, params.id))),
      PATCH: ({ request, params }) =>
        apiCall(request, async (viewer, body) => {
          const row = await found(viewer, params.id);
          return noteToApi(await noteData.update(viewer, row.id, noteFromApi(body, row) as never));
        }),
      DELETE: ({ request, params }) =>
        apiCall(request, async (viewer) => {
          const row = await found(viewer, params.id);
          // ?together=true takes the records that point to it along (docs/design/delete-together.md).
          await noteData.remove(viewer, row.id, new URL(request.url).searchParams.get("together") === "true");
        }),
    },
  },
});
"
`;

exports[`../../../examples/api/smithable.yml > file list and generated code > src/routes/api/v1/notes/index.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// Notes for programs with a key (docs/design/integrations.md §2): what the key's role may read, a page at a time, and adding one.
import { createFileRoute } from "@tanstack/react-router";
import { noteFromApi, noteToApi } from "#/generated/api.server";
import { noteData } from "#/generated/note.server";
import { apiCall } from "#/kit/api.server";
import { whereFromQuery } from "#/kit/where";

export const Route = createFileRoute("/api/v1/notes/")({
  server: {
    handlers: {
      GET: ({ request }) =>
        apiCall(request, async (viewer) => {
          const query = new URL(request.url).searchParams;
          const limit = Math.min(100, Math.max(1, Number(query.get("limit")) || 100));
          const page = Math.max(1, Number(query.get("page")) || 1);
          // Filters as fields (?status=sent, a list as a,b, a range as from..to, mine=true), search, sort.
          const where = whereFromQuery(query, ["limit", "page", "search", "sort", "sum"]);
          const search = query.get("search") ?? undefined;
          const { items, total } = await noteData.find(viewer, {
            where,
            search,
            sort: query.get("sort") ?? undefined,
            limit,
            offset: (page - 1) * limit,
          });
          // ?sum=total adds up a number field over every record that fits, not only this page.
          const sums = query.get("sum")?.split(",").filter(Boolean);
          return {
            items: items.map(noteToApi),
            page,
            pages: Math.max(1, Math.ceil(total / limit)),
            total,
            ...(sums?.length
              ? { sums: Object.fromEntries(await Promise.all(sums.map(async (field) => [field, await noteData.measure(viewer, "sum", { field, where, search })]))) }
              : {}),
          };
        }),
      POST: ({ request }) =>
        apiCall(request, async (viewer, body) => noteToApi(await noteData.create(viewer, noteFromApi(body) as never)), 201),
    },
  },
});
"
`;

exports[`../../../examples/api/smithable.yml > file list and generated code > src/routes/api/v1/notes[.]csv.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// Notes as CSV for programs with a key: the same filters, search and sort as the JSON list.
import { createFileRoute } from "@tanstack/react-router";
import { noteUi } from "#/generated/note";
import { noteData } from "#/generated/note.server";
import { apiCall } from "#/kit/api.server";
import { csvOf } from "#/kit/csv";
import { whereFromQuery } from "#/kit/where";

export const Route = createFileRoute("/api/v1/notes.csv")({
  server: {
    handlers: {
      GET: ({ request }) =>
        apiCall(request, async (viewer) => {
          const query = new URL(request.url).searchParams;
          const { items } = await noteData.find(viewer, {
            where: whereFromQuery(query, ["search", "sort"]),
            search: query.get("search") ?? undefined,
            sort: query.get("sort") ?? undefined,
            limit: 10_000,
          });
          return new Response(csvOf(noteUi, items as never), {
            headers: {
              "Content-Type": "text/csv; charset=utf-8",
              "Content-Disposition": 'attachment; filename="notes.csv"',
            },
          });
        }),
    },
  },
});
"
`;

exports[`../../../examples/api/smithable.yml > file list and generated code > src/routes/api/v1/openapi[.]json.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// The API's description in the OpenAPI format, with no key needed to read it: with a key, or
// signed in as someone who may open the users page (its download), all a program may call; otherwise what anyone may read
// or add, which in an app with nothing public is nothing (no model or field names to a stranger).
import { createFileRoute } from "@tanstack/react-router";
import { OPENAPI, VISITOR_OPENAPI } from "#/generated/api.server";
import { pageAccess } from "#/generated/pages";
import { allows } from "#/kit/access";
import { callerOf } from "#/kit/api.server";
import { currentViewer } from "#/lib/viewer.server";

export const Route = createFileRoute("/api/v1/openapi.json")({
  server: {
    handlers: {
      GET: async ({ request }) => {
        // A key; or signed in as someone who may open the users page, where keys are made.
        const session = await currentViewer();
        const whole = callerOf(request).viewer || (session && allows(pageAccess["team"], session));
        return Response.json(whole ? OPENAPI : VISITOR_OPENAPI);
      },
    },
  },
});
"
`;

