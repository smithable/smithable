exports[`../../../examples/booking/smithable.yml > file list and generated code > src/db/schema.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { relations } from "drizzle-orm";
import { index, integer, sqliteTable, text, unique } from "drizzle-orm/sqlite-core";
import type { Picture } from "#/kit/uploads";

export const user = sqliteTable("user", {
  id: text().primaryKey(),
  name: text().notNull(),
  email: text().notNull().unique(),
  emailVerified: integer({ mode: "boolean" }).default(false).notNull(),
  image: text(),
  role: text().notNull().default("member"),
  createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
  updatedAt: integer({ mode: "timestamp_ms" })
    .notNull()
    .$defaultFn(() => new Date())
    .$onUpdate(() => new Date()),
});

export const session = sqliteTable(
  "session",
  {
    id: text().primaryKey(),
    expiresAt: integer({ mode: "timestamp_ms" }).notNull(),
    token: text().notNull().unique(),
    createdAt: integer({ mode: "timestamp_ms" }).notNull(),
    updatedAt: integer({ mode: "timestamp_ms" }).notNull(),
    ipAddress: text(),
    userAgent: text(),
    userId: text()
      .notNull()
      .references(() => user.id, { onDelete: "cascade" }),
  },
  (t) => [index("session_user_id_idx").on(t.userId)],
);

export const account = sqliteTable(
  "account",
  {
    id: text().primaryKey(),
    accountId: text().notNull(),
    providerId: text().notNull(),
    userId: text()
      .notNull()
      .references(() => user.id, { onDelete: "cascade" }),
    accessToken: text(),
    refreshToken: text(),
    idToken: text(),
    accessTokenExpiresAt: integer({ mode: "timestamp_ms" }),
    refreshTokenExpiresAt: integer({ mode: "timestamp_ms" }),
    scope: text(),
    password: text(),
    createdAt: integer({ mode: "timestamp_ms" }).notNull(),
    updatedAt: integer({ mode: "timestamp_ms" }).notNull(),
  },
  (t) => [index("account_user_id_idx").on(t.userId)],
);

export const verification = sqliteTable(
  "verification",
  {
    id: text().primaryKey(),
    identifier: text().notNull(),
    value: text().notNull(),
    expiresAt: integer({ mode: "timestamp_ms" }).notNull(),
    createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
    updatedAt: integer({ mode: "timestamp_ms" })
      .notNull()
      .$defaultFn(() => new Date())
      .$onUpdate(() => new Date()),
  },
  (t) => [index("verification_identifier_idx").on(t.identifier)],
);

export const auditLog = sqliteTable(
  "audit_log",
  {
    id: integer().primaryKey({ autoIncrement: true }),
    at: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
    trace: text(),
    /** A user's id, a key's name, "visitor", or "the app" for its own work. */
    who: text().notNull(),
    role: text(),
    address: text(),
    browser: text(),
    /** created, changed, deleted, copied, or an action's name. */
    action: text().notNull(),
    model: text(),
    recordId: integer(),
    title: text(),
    fields: text({ mode: "json" }).$type<string[]>(),
    details: text({ mode: "json" }).$type<Record<string, unknown>>(),
  },
  (t) => [index("audit_log_at").on(t.at), index("audit_log_record").on(t.model, t.recordId)],
);

export const uploads = sqliteTable(
  "uploads",
  {
    id: integer().primaryKey({ autoIncrement: true }),
    /** The stored file's name under uploads/ (src/kit/uploads.ts). */
    file: text().notNull(),
    model: text().notNull(),
    field: text().notNull(),
    /** Who uploaded it; nothing for a visitor. */
    uploader: text(),
    receipt: text().notNull(),
    at: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
  },
  (t) => [index("uploads_receipt").on(t.receipt), index("uploads_at").on(t.at)],
);

export const outgoingMail = sqliteTable(
  "outgoing_mail",
  {
    id: integer().primaryKey({ autoIncrement: true }),
    createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
    /** The outgoing entry's name in smithable.yml. */
    entry: text().notNull(),
    model: text().notNull(),
    recordId: integer().notNull(),
    to: text().notNull(),
    subject: text().notNull(),
    text: text().notNull(),
    tries: integer().notNull().default(0),
    nextAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
    sentAt: integer({ mode: "timestamp_ms" }),
    /** Given up after a day of tries; "Send again" in Activity clears it. */
    failedAt: integer({ mode: "timestamp_ms" }),
    error: text(),
  },
  (t) => [index("outgoing_mail_due").on(t.sentAt, t.failedAt, t.nextAt)],
);

export const outgoingCall = sqliteTable(
  "outgoing_call",
  {
    id: integer().primaryKey({ autoIncrement: true }),
    createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
    entry: text().notNull(),
    model: text().notNull(),
    recordId: integer().notNull(),
    /** The target's name; its address and secret are OUTGOING_<TARGET>_URL and _SECRET. */
    target: text().notNull(),
    body: text().notNull(),
    tries: integer().notNull().default(0),
    nextAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
    sentAt: integer({ mode: "timestamp_ms" }),
    failedAt: integer({ mode: "timestamp_ms" }),
    /** The answer's status, or why there was none. */
    status: integer(),
    error: text(),
  },
  (t) => [index("outgoing_call_due").on(t.sentAt, t.failedAt, t.nextAt)],
);

export const classTypes = sqliteTable("class_types", {
  id: integer().primaryKey({ autoIncrement: true }),
  name: text().notNull(),
  summary: text(),
  level: text({ enum: ["beginner", "allLevels", "advanced"] }).notNull().default("allLevels"),
  durationMinutes: integer().notNull().default(60),
  ownerId: text().references(() => user.id, { onDelete: "set null" }),
  createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
  updatedAt: integer({ mode: "timestamp_ms" })
    .notNull()
    .$defaultFn(() => new Date())
    .$onUpdate(() => new Date()),
});

export const instructors = sqliteTable("instructors", {
  id: integer().primaryKey({ autoIncrement: true }),
  name: text().notNull(),
  bio: text(),
  portrait: text({ mode: "json" }).$type<Picture>(),
  ownerId: text().references(() => user.id, { onDelete: "set null" }),
  createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
  updatedAt: integer({ mode: "timestamp_ms" })
    .notNull()
    .$defaultFn(() => new Date())
    .$onUpdate(() => new Date()),
});

export const sessions = sqliteTable("sessions", {
  id: integer().primaryKey({ autoIncrement: true }),
  classTypeId: integer().notNull().references(() => classTypes.id, { onDelete: "restrict" }),
  instructorId: integer().notNull().references(() => instructors.id, { onDelete: "restrict" }),
  startsAt: integer({ mode: "timestamp_ms" }).notNull(),
  capacity: integer().notNull().default(12),
  placesLeft: integer(),
  ownerId: text().references(() => user.id, { onDelete: "set null" }),
  createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
  updatedAt: integer({ mode: "timestamp_ms" })
    .notNull()
    .$defaultFn(() => new Date())
    .$onUpdate(() => new Date()),
});

// Records are private to their owner, so unique values are unique per owner.
export const bookings = sqliteTable(
  "bookings",
  {
    id: integer().primaryKey({ autoIncrement: true }),
    sessionId: integer().notNull().references(() => sessions.id, { onDelete: "restrict" }),
    ownerId: text().references(() => user.id, { onDelete: "set null" }),
    createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
    updatedAt: integer({ mode: "timestamp_ms" })
      .notNull()
      .$defaultFn(() => new Date())
      .$onUpdate(() => new Date()),
  },
  (t) => [unique().on(t.ownerId, t.sessionId)],
);

export const posts = sqliteTable("posts", {
  id: integer().primaryKey({ autoIncrement: true }),
  title: text().notNull(),
  address: text().unique(),
  summary: text(),
  cover: text({ mode: "json" }).$type<Picture>(),
  body: text().notNull(),
  publishedOn: text(),
  status: text({ enum: ["draft", "published"] }).notNull().default("draft"),
  ownerId: text().references(() => user.id, { onDelete: "set null" }),
  createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
  updatedAt: integer({ mode: "timestamp_ms" })
    .notNull()
    .$defaultFn(() => new Date())
    .$onUpdate(() => new Date()),
});

export const messages = sqliteTable("messages", {
  id: integer().primaryKey({ autoIncrement: true }),
  name: text().notNull(),
  email: text().notNull(),
  message: text().notNull(),
  ownerId: text().references(() => user.id, { onDelete: "set null" }),
  createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
  updatedAt: integer({ mode: "timestamp_ms" })
    .notNull()
    .$defaultFn(() => new Date())
    .$onUpdate(() => new Date()),
});

export const sessionsRelations = relations(sessions, ({ one, many }) => ({
  classType: one(classTypes, { fields: [sessions.classTypeId], references: [classTypes.id] }),
  instructor: one(instructors, { fields: [sessions.instructorId], references: [instructors.id] }),
  bookings: many(bookings),
}));

export const bookingsRelations = relations(bookings, ({ one }) => ({
  session: one(sessions, { fields: [bookings.sessionId], references: [sessions.id] }),
}));
"
`;

exports[`../../../examples/booking/smithable.yml > file list and generated code > src/db/seed.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// Sample data for development. Run with \`pnpm db:seed\`; tables that already have rows are left alone.
import { db } from "./index";
import * as schema from "./schema";
import { samplePicture } from "#/kit/uploads";
import { app } from "#/generated/app";
import { instantOf, wallTime } from "#/kit/zoned";

/**
 * A sample moved to this week (0) or the next (1) in the app's time zone, as a wall time
 * ("2026-09-30T09:00"): the same weekday, and the clock time the sample is written with.
 */
function aroundToday(sample: Date, week: number): string {
  const today = Date.parse(\`\${wallTime(new Date(), app.timeZone).slice(0, 10)}T00:00:00Z\`);
  const monday = today - ((new Date(today).getUTCDay() + 6) % 7) * 86_400_000;
  const day = (sample.getUTCDay() + 6) % 7;
  const moved = new Date(monday + (week * 7 + day) * 86_400_000).toISOString().slice(0, 10);
  return \`\${moved}T\${sample.toISOString().slice(11, 16)}\`;
}

if (db.select().from(schema.classTypes).limit(1).all().length === 0) {
  db.insert(schema.classTypes)
    .values([
    { name: "Vinyasa", summary: "A short description of Vinyasa.", level: "beginner", durationMinutes: 45 },
    { name: "Yin", summary: "A short description of Yin.", level: "allLevels", durationMinutes: 60 },
    { name: "Hatha", summary: "A short description of Hatha.", level: "advanced", durationMinutes: 75 },
    { name: "Foundations", summary: "A short description of Foundations.", level: "beginner", durationMinutes: 90 },
    { name: "Vinyasa 2", summary: "A short description of Vinyasa 2.", level: "allLevels", durationMinutes: 45 },
    { name: "Yin 2", summary: "A short description of Yin 2.", level: "advanced", durationMinutes: 60 },
    { name: "Hatha 2", summary: "A short description of Hatha 2.", level: "beginner", durationMinutes: 75 },
    { name: "Foundations 2", summary: "A short description of Foundations 2.", level: "allLevels", durationMinutes: 90 },
    ])
    .run();
}

if (db.select().from(schema.instructors).limit(1).all().length === 0) {
  db.insert(schema.instructors)
    .values([
    { name: "Emma Lindqvist", bio: "A short description of **Emma Lindqvist**.\\n\\n- What it is\\n- Who it is for", portrait: samplePicture("instructor", 0, "A picture of Emma Lindqvist") },
    { name: "Oskar Nieminen", bio: "A short description of **Oskar Nieminen**.\\n\\n- What it is\\n- Who it is for", portrait: samplePicture("instructor", 1, "A picture of Oskar Nieminen") },
    { name: "Sofia Andersson", bio: "A short description of **Sofia Andersson**.\\n\\n- What it is\\n- Who it is for", portrait: samplePicture("instructor", 2, "A picture of Sofia Andersson") },
    { name: "Leo Virtanen", bio: "A short description of **Leo Virtanen**.\\n\\n- What it is\\n- Who it is for", portrait: samplePicture("instructor", 0, "A picture of Leo Virtanen") },
    { name: "Aino Karlsson", bio: "A short description of **Aino Karlsson**.\\n\\n- What it is\\n- Who it is for", portrait: samplePicture("instructor", 1, "A picture of Aino Karlsson") },
    { name: "Elias Johansson", bio: "A short description of **Elias Johansson**.\\n\\n- What it is\\n- Who it is for", portrait: samplePicture("instructor", 2, "A picture of Elias Johansson") },
    { name: "Maja Korhonen", bio: "A short description of **Maja Korhonen**.\\n\\n- What it is\\n- Who it is for", portrait: samplePicture("instructor", 0, "A picture of Maja Korhonen") },
    { name: "William Berg", bio: "A short description of **William Berg**.\\n\\n- What it is\\n- Who it is for", portrait: samplePicture("instructor", 1, "A picture of William Berg") },
    ])
    .run();
}

if (db.select().from(schema.sessions).limit(1).all().length === 0) {
  db.insert(schema.sessions)
    .values([
    { classTypeId: 1, instructorId: 1, startsAt: instantOf(aroundToday(new Date("2026-09-01T08:00:00.000Z"), 0), app.timeZone), capacity: 8 },
    { classTypeId: 2, instructorId: 2, startsAt: instantOf(aroundToday(new Date("2026-09-02T10:00:00.000Z"), 1), app.timeZone), capacity: 12 },
    { classTypeId: 3, instructorId: 3, startsAt: instantOf(aroundToday(new Date("2026-09-03T12:00:00.000Z"), 0), app.timeZone), capacity: 16 },
    { classTypeId: 4, instructorId: 4, startsAt: instantOf(aroundToday(new Date("2026-09-04T08:00:00.000Z"), 1), app.timeZone), capacity: 8 },
    { classTypeId: 5, instructorId: 5, startsAt: instantOf(aroundToday(new Date("2026-09-05T10:00:00.000Z"), 0), app.timeZone), capacity: 12 },
    { classTypeId: 6, instructorId: 6, startsAt: instantOf(aroundToday(new Date("2026-09-06T12:00:00.000Z"), 1), app.timeZone), capacity: 16 },
    { classTypeId: 7, instructorId: 7, startsAt: instantOf(aroundToday(new Date("2026-09-07T08:00:00.000Z"), 0), app.timeZone), capacity: 8 },
    { classTypeId: 8, instructorId: 8, startsAt: instantOf(aroundToday(new Date("2026-09-08T10:00:00.000Z"), 1), app.timeZone), capacity: 12 },
    ])
    .run();
}

if (db.select().from(schema.posts).limit(1).all().length === 0) {
  db.insert(schema.posts)
