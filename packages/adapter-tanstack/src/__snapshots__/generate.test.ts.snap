exports[`../../../examples/booking/smithable.yml > file list and generated code > src/generated/session.server.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { type AnyColumn, and, asc, avg, count, desc, eq, inArray, isNotNull, max, min, sql, sum, type SQL } from "drizzle-orm";
import { db } from "#/db";
import * as schema from "#/db/schema";
import { AccessDenied, allows, check, Conflict, type ModelAccess, personOf, readScope, type Viewer } from "#/kit/access";
import { audit, changedFields } from "#/kit/audit.server";
import { refusal } from "#/kit/log.server";
import { BadInput } from "#/kit/refusal";
import { aggregate, type Filterable, sortOf, whereOf, wordsOf } from "#/kit/where";
import { afterChange, afterDelete } from "./hooks";
import { bookingData } from "./booking.server";
import { classTypeData } from "./class-type.server";
import { instructorData } from "./instructor.server";
import type { SessionValues } from "./session";
import { withSessionFormulas } from "./session.formulas";

/** A transaction, as the group's functions are called inside one (docs/design/delete-together.md). */
type Tx = Parameters<Parameters<typeof db.transaction>[0]>[0];

/**
 * What points to a session (docs/design/delete-together.md): the records that would go with it
 * to the trash, by model, and those that would show no session; nothing when nothing does.
 */
function usedBy(tx: Tx, id: number, title: string) {
  const pointing: { model: string; from: string; label: string; plural: string; depth: number; count: number | null }[] = [
    { model: "Booking", label: "Booking", plural: "Bookings", from: "Session", depth: 1, count: tx.select({ n: count() }).from(schema.bookings).where(and(eq(schema.bookings.sessionId, id))).get()?.n ?? 0 },
  ];
  // A deeper member is named when its parent has records ("and what belongs to them").
  const with_: typeof pointing = [];
  for (const e of pointing)
    if (e.count === null ? with_.some((p) => p.model === e.from) : e.count > 0) with_.push(e);
  if (!with_.length) return undefined;
  const loose = [] as { model: string; label: string; plural: string; count: number }[];
  return { id, title, model: "Session", label: "Session", with: with_, loose, together: false, missing: ["Session","Booking"] };
}

/** Who may read, create, change and delete sessions. */
export const sessionAccess: ModelAccess = {
  read: { public: true, roles: ["admin"], owner: true },
  create: { public: false, roles: ["admin"], owner: false },
  write: { public: false, roles: ["admin"], owner: true },
  delete: { public: false, roles: ["admin"], owner: true },
};

/** A record as the viewer gets it: who owns it only for its owner and roles that read every record. */
function shownTo<R extends { ownerId: string | null }>(viewer: Viewer | null, row: R): R {
  if (viewer && (row.ownerId === viewer.id || sessionAccess.read.roles.includes(viewer.role))) return row;
  return { ...row, ownerId: null };
}


/** What \`where\` may name, and how: the stored fields, by kind. */
const FILTERABLE: Record<string, Filterable> = {
  classType: { kind: "reference", column: schema.sessions.classTypeId, title: { table: schema.classTypes, column: schema.classTypes.name } },
  instructor: { kind: "reference", column: schema.sessions.instructorId, title: { table: schema.instructors, column: schema.instructors.name } },
  startsAt: { kind: "instant", column: schema.sessions.startsAt },
  capacity: { kind: "number", column: schema.sessions.capacity },
};

/** What the records can be sorted by. */
const SORTABLE = { id: schema.sessions.id, startsAt: schema.sessions.startsAt, capacity: schema.sessions.capacity, createdAt: schema.sessions.createdAt };

/** The number fields \`measure\` adds up; amounts are stored in cents. */
const NUMBERS: Record<string, AnyColumn> = { capacity: schema.sessions.capacity };
const MONEY: string[] = [];

/** Computed number fields \`measure\` adds up from the records themselves. */
const COMPUTED: string[] = ["placesLeft"];

/** The titles of the referenced records \`measureBy\` splits by, to name its groups. */
function titlesOf(viewer: Viewer | null, by: string, ids: number[]): Map<unknown, string> {
  switch (by) {
    case "classType":
      return new Map(db.select({ id: schema.classTypes.id, title: schema.classTypes.name }).from(schema.classTypes).where(and(inArray(schema.classTypes.id, ids), classTypeData.readable(viewer))).all().map((r) => [r.id, String(r.title)]));
    case "instructor":
      return new Map(db.select({ id: schema.instructors.id, title: schema.instructors.name }).from(schema.instructors).where(and(inArray(schema.instructors.id, ids), instructorData.readable(viewer))).all().map((r) => [r.id, String(r.title)]));
    default:
      return new Map();
  }
}

/** What \`measureBy\` may split by: choices, yes/no, references, and dates by month. */
const BY: string[] = ["classType","instructor","startsAt"];


/** Checks that the viewer may read the records the values refer to. */
function checkReferences(viewer: Viewer | null, values: SessionValues): void {
  if (values.classTypeId != null && !classTypeData.canRead(viewer, values.classTypeId))
    throw new AccessDenied(viewer !== null);
  if (values.instructorId != null && !instructorData.canRead(viewer, values.instructorId))
    throw new AccessDenied(viewer !== null);
}

/** \`rows\` with each \`field\` reference \`readable\` leaves out set to nothing (only its id stays). */
function hideRefs<R extends Record<string, unknown>>(rows: R[], field: string, readable: (ids: number[]) => number[]): R[] {
  const idOf = (row: R) => (row[field] as { id?: unknown } | null | undefined)?.id;
  const ids = [...new Set(rows.map(idOf).filter((id): id is number => typeof id === "number"))];
  if (!ids.length) return rows;
  const shown = new Set(readable(ids));
  return rows.map((row) => {
    const id = idOf(row);
    return typeof id === "number" && !shown.has(id) ? { ...row, [field]: null } : row;
  });
}

export const sessionData = {
  shownTo,
  /** The rows with each reference to a record the viewer may not read set to nothing: a related record's title is shown only to who may read it (only its id stays). */
  shownRefs<R extends Record<string, unknown>>(viewer: Viewer | null, rows: R[]): R[] {
    return hideRefs(hideRefs(rows, "classType", (ids, c = classTypeData.readable(viewer)) => (c ? db.select({ id: schema.classTypes.id }).from(schema.classTypes).where(and(inArray(schema.classTypes.id, ids), c)).all().map((r) => r.id) : ids)), "instructor", (ids, c = instructorData.readable(viewer)) => (c ? db.select({ id: schema.instructors.id }).from(schema.instructors).where(and(inArray(schema.instructors.id, ids), c)).all().map((r) => r.id) : ids));
  },

  /** A condition for the sessions the viewer may read. */
  readable(viewer: Viewer | null) {
    const scope = readScope(sessionAccess.read, viewer);
    if (scope === "all") return undefined;
    return scope === "own" && viewer ? eq(schema.sessions.ownerId, viewer.id) : sql\`false\`;
  },

  canRead(viewer: Viewer | null, id: number): boolean {
    const found = db
      .select({ id: schema.sessions.id })
      .from(schema.sessions)
      .where(and(eq(schema.sessions.id, id), sessionData.readable(viewer)))
      .get();
    return found !== undefined;
  },

  /** The sessions the viewer may read; \`where\` narrows them, e.g. to a search; \`limit\` keeps the newest (a data page). */
  async list(viewer: Viewer | null, where?: SQL, limit?: number) {
    if (readScope(sessionAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const found = sessionData.shownRefs(viewer, await db.query.sessions.findMany({
      where: and(sessionData.readable(viewer), where),
      with: { classType: { columns: { id: true, name: true } }, instructor: { columns: { id: true, name: true } }, bookings: true },
      orderBy: (t, { desc }) => [desc(t.id)],
      limit,
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    // The related records are here for the totals only: some may not be the viewer's to read.
    return rows.map((row) => {
      const { bookings, ...listed } = withSessionFormulas(row);
      return listed;
    });
  },

  /**
   * A page of the sessions the viewer may read that fit \`where\`, newest first (or in
   * \`order\`), and how many fit in all: for a list page. A page past the end is the last one.
   */
  async page(viewer: Viewer | null, where?: SQL, order?: SQL, page = 1, size = 50) {
    if (readScope(sessionAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = and(sessionData.readable(viewer), where);
    const total = db.select({ n: count() }).from(schema.sessions).where(condition).get()?.n ?? 0;
    const at = Math.min(Math.max(1, Math.trunc(page)), Math.max(1, Math.ceil(total / size)));
    const found = sessionData.shownRefs(viewer, await db.query.sessions.findMany({
      where: condition,
      with: { classType: { columns: { id: true, name: true } }, instructor: { columns: { id: true, name: true } }, bookings: true },
      orderBy: (t, { desc }) => [...(order ? [order] : []), desc(t.id)],
      limit: size,
      offset: (at - 1) * size,
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    // The related records are here for the totals only: some may not be the viewer's to read.
    return { rows: rows.map((row) => {
      const { bookings, ...listed } = withSessionFormulas(row);
      return listed;
    }), total, page: at, size };
  },

  /**
   * The sessions the viewer may read that fit \`where\` and \`search\`, in \`sort\`'s order (else newest
   * first), a page of them and how many there are: for the API and the assistants' tools.
   */
  async find(
    viewer: Viewer | null,
    options: { where?: unknown; search?: string; sort?: string; limit?: number; offset?: number } = {},
  ) {
    if (readScope(sessionAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = sessionData.fitting(viewer, options.where, options.search);
    const order = sortOf(SORTABLE, options.sort);
    const total = db.select({ n: count() }).from(schema.sessions).where(condition).get()?.n ?? 0;
    const found = sessionData.shownRefs(viewer, await db.query.sessions.findMany({
      where: condition,
      with: { classType: { columns: { id: true, name: true } }, instructor: { columns: { id: true, name: true } }, bookings: true },
      orderBy: (t, { desc }) => [...(order ? [order] : []), desc(t.id)],
      limit: options.limit ?? 100,
      offset: options.offset ?? 0,
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    // The related records are here for the totals only: some may not be the viewer's to read.
    return { items: rows.map((row) => {
      const { bookings, ...listed } = withSessionFormulas(row);
      return listed;
    }), total };
  },

  /**
   * A number from the sessions the viewer may read that fit \`where\`: how many, or the sum,
   * average, smallest or largest of a number field.
   */
  async measure(
    viewer: Viewer | null,
    how: "count" | "sum" | "average" | "smallest" | "largest",
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<number | null> {
    if (readScope(sessionAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = sessionData.fitting(viewer, options.where, options.search);
    if (how === "count")
      return db.select({ n: count() }).from(schema.sessions).where(condition).get()?.n ?? 0;
    const field = options.field ?? "";
    const money = MONEY.includes(field);
    if (COMPUTED.includes(field)) {
      const rows = await sessionData.computedRows(condition);
      const value = aggregate(rows.map((row) => row[field]), how);
      return value === null ? null : money ? value / 100 : value;
    }
    const column = NUMBERS[field];
    if (!column)
      throw new BadInput(
        \`\${how} needs a number field: \${[...Object.keys(NUMBERS), ...COMPUTED].join(", ") || "there are none"}.\`,
      );
    const pick = { sum, average: avg, smallest: min, largest: max }[how];
    const value = db.select({ v: pick(column) }).from(schema.sessions).where(condition).get()?.v;
    if (value === null || value === undefined) return null;
    return money ? Number(value) / 100 : Number(value);
  },

  /** Which record holds the smallest or largest value of a number field (the first of a tie). */
  async holder(
    viewer: Viewer | null,
    how: "smallest" | "largest",
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<{ id: number; title: string } | null> {
    const condition = sessionData.fitting(viewer, options.where, options.search);
    const field = options.field ?? "";
    if (COMPUTED.includes(field)) {
      let best: Record<string, unknown> | undefined;
      for (const row of await sessionData.computedRows(condition)) {
        const v = row[field];
        if (typeof v !== "number") continue;
        if (!best || (how === "largest" ? v > (best[field] as number) : v < (best[field] as number))) best = row;
      }
      return best ? { id: best.id as number, title: String(best.id) } : null;
    }
    const column = NUMBERS[field];
    if (!column) return null;
    const row = db
      .select({ id: schema.sessions.id, title: schema.sessions.id })
      .from(schema.sessions)
      .where(and(condition, isNotNull(column)))
      .orderBy(how === "largest" ? desc(column) : asc(column), asc(schema.sessions.id))
      .limit(1)
      .get();
    return row ? { id: row.id, title: String(row.title) } : null;
  },

  /**
   * The same number per value of a field (a choice, yes/no, a reference) or per month of a date:
   * \`[{ value, number }]\`, the most first.
   */
  async measureBy(
    viewer: Viewer | null,
    how: "count" | "sum" | "average" | "smallest" | "largest",
    by: string,
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<{ value: unknown; title?: string; number: number | null }[]> {
    if (readScope(sessionAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const split = FILTERABLE[by];
    if (!split || split.kind === "text" || split.kind === "number" || split.kind === "money")
      throw new BadInput(\`There is no field "\${by}" to split by. Fields: \${BY.join(", ")}.\`);
    const field = options.field ?? "";
    const money = MONEY.includes(field);
    const condition = sessionData.fitting(viewer, options.where, options.search);
    const amount = (n: number | null) => (n === null ? null : money ? n / 100 : n);
    const most = (a: { number: number | null }, b: { number: number | null }) => (b.number ?? 0) - (a.number ?? 0);
    // A reference's groups carry the referenced record's title beside its id.
    const named = (rows: { value: unknown; number: number | null }[]) => {
      if (split.kind !== "reference") return rows;
      const titles = titlesOf(viewer, by, rows.map((r) => r.value).filter((v): v is number => typeof v === "number"));
      return rows.map((r) => (titles.has(r.value) ? { value: r.value, title: titles.get(r.value), number: r.number } : r));
    };
    if (COMPUTED.includes(field)) {
      // Each record's month or value, then the computed numbers added up per group.
      const groups = new Map<unknown, unknown[]>();
      for (const row of await sessionData.computedRows(condition)) {
        const raw = row[split.kind === "reference" ? \`\${by}Id\` : by];
        const value = split.kind === "date" ? String(raw ?? "").slice(0, 7) || null : split.kind === "instant" ? (raw instanceof Date ? raw.toISOString().slice(0, 7) : null) : raw;
        groups.set(value, [...(groups.get(value) ?? []), row[field]]);
      }
      return named([...groups].map(([value, numbers]) => ({ value, number: amount(aggregate(numbers, how)) })).sort(most));
    }
    const key = split.kind === "date" ? sql<string>\`substr(\${split.column}, 1, 7)\` : split.kind === "instant" ? sql<string>\`strftime('%Y-%m', \${split.column} / 1000, 'unixepoch')\` : sql\`\${split.column}\`;
    const column = NUMBERS[field];
    if (how !== "count" && !column)
      throw new BadInput(\`\${how} needs a number field: \${[...Object.keys(NUMBERS), ...COMPUTED].join(", ") || "there are none"}.\`);
    const pick = how === "count" || !column ? count() : { sum, average: avg, smallest: min, largest: max }[how](column);
    return named(
      db
        .select({ value: key, number: pick })
        .from(schema.sessions)
        .where(condition)
        .groupBy(key)
        .all()
        .map((r) => ({ value: r.value, number: r.number === null ? null : amount(Number(r.number)) }))
        .sort(most),
    );
  },

  /**
   * The records that fit, with their computed fields worked out: for adding those up. At most
   * 10,000, so one call never reads a whole large table; more are refused with how to narrow them.
   */
  async computedRows(condition: SQL | undefined): Promise<Record<string, unknown>[]> {
    const rows = await db.query.sessions.findMany({ where: condition, with: { classType: { columns: { id: true, name: true } }, instructor: { columns: { id: true, name: true } }, bookings: true }, limit: 10001 });
    if (rows.length > 10000)
      throw new BadInput("More than 10,000 records to add up a computed field over: narrow them with where.");
    return rows.map((row) => withSessionFormulas(row as never) as Record<string, unknown>);
  },

  /** The condition for records the viewer may read that fit \`where\` and \`search\`. */
  fitting(viewer: Viewer | null, where?: unknown, search?: string) {
    return and(
      sessionData.readable(viewer),
      whereOf(FILTERABLE, where, viewer ? eq(schema.sessions.ownerId, viewer.id) : undefined, viewer?.id, {}),
      // Every word somewhere in the texts ("ship lamp" finds "ship's lamp").
      ...wordsOf(search).map(() => sql\`false\`),
    );
  },

  /** How many sessions the viewer may read, for a data page's overview; none to read: null. */
  count(viewer: Viewer | null): number | null {
    if (readScope(sessionAccess.read, viewer) === "none") return null;
    return db.select({ n: count() }).from(schema.sessions).where(sessionData.readable(viewer)).get()?.n ?? 0;
  },

  async get(viewer: Viewer | null, id: number) {
    const fetched = await db.query.sessions.findFirst({
      where: and(eq(schema.sessions.id, id), sessionData.readable(viewer)),
      with: { classType: { columns: { id: true, name: true } }, instructor: { columns: { id: true, name: true } }, bookings: { where: bookingData.readable(viewer) } },
    });
    const found = fetched && sessionData.shownRefs(viewer, [fetched])[0];
    const row = found && { ...shownTo(viewer, found), bookings: found.bookings.map((r) => bookingData.shownTo(viewer, r)) };
    if (!row) return null;
    // Totals count every related record, as in lists; the related records shown are the viewer's.
    const all = await db.query.sessions.findFirst({ where: eq(schema.sessions.id, id), with: { bookings: true } });
    return { ...withSessionFormulas({ ...row, bookings: all?.bookings ?? [] }), bookings: row.bookings };
  },

  async create(viewer: Viewer | null, values: SessionValues) {
    check(sessionAccess.create, viewer);
    checkReferences(viewer, values);
    let row: typeof schema.sessions.$inferSelect;
    try {
      row = db.transaction((tx) => {
        const made = tx.insert(schema.sessions).values({ ...values, ownerId: personOf(viewer) }).returning().get();
        audit(tx, viewer, { action: "created", model: "Session", record: made.id });
        return made;
      });
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterCreate", "Session", row, viewer);
    return row;
  },

  /** Changes the record; \`what\` names the change in the audit log (an action's name). */
  async update(viewer: Viewer | null, id: number, values: SessionValues, what = "changed") {
    const row = db
      .select({ ownerId: schema.sessions.ownerId })
      .from(schema.sessions)
      .where(and(eq(schema.sessions.id, id), sessionData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(sessionAccess.write, viewer, row.ownerId);
    checkReferences(viewer, values);
    let changed: typeof schema.sessions.$inferSelect;
    const updated = values;
    try {
      changed = db.transaction((tx) => {
      if (values.capacity != null) {
        const booked = tx.select({ n: count() }).from(schema.bookings).where(and(eq(schema.bookings.sessionId, id))).get()?.n ?? 0;
        if (values.capacity < booked) throw new Conflict(\`booked:\${booked}\`);
      }
        const before = tx.select().from(schema.sessions).where(eq(schema.sessions.id, id)).get();
        const after = tx.update(schema.sessions).set(updated).where(eq(schema.sessions.id, id)).returning().get();
        audit(tx, viewer, { action: what, model: "Session", record: id, fields: before && changedFields(before, after, Object.keys(updated).filter((k) => !["placesLeft"].includes(k))) });
        return after;
      });
    } catch (error) {
      throw error instanceof Conflict ? error : refusal(error);
    }
    await afterChange("afterUpdate", "Session", changed, viewer);
    return changed;
  },

  /** Deletes the record; \`together\` takes the records that point to it along to the trash (delete-together.md). */
  async remove(viewer: Viewer | null, id: number, _together = false): Promise<void> {
    const row = db
      .select({ ownerId: schema.sessions.ownerId })
      .from(schema.sessions)
      .where(and(eq(schema.sessions.id, id), sessionData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(sessionAccess.delete, viewer, row.ownerId);
    try {
      db.transaction((tx) => {
        const used = usedBy(tx, id, \`#\${id}\`);
        if (used) throw new Conflict(\`in-use:\${JSON.stringify(used)}\`);
        const gone = tx.delete(schema.sessions).where(eq(schema.sessions.id, id)).returning().get();
        if (gone) {
          audit(tx, viewer, { action: "deleted", model: "Session", record: id, title: gone.id });
        }
      });
    } catch (error) {
      throw refusal(error);
    }
    await afterDelete("Session", id, viewer);
  },

  /**
   * Deletes the chosen records the viewer may delete, all or none (one still in use stops them
   * all, and is named); the others are skipped.
   */
  async removeMany(viewer: Viewer | null, ids: number[], _together = false): Promise<{ deleted: number; skipped: number }> {
    const rows = db
      .select({ id: schema.sessions.id, ownerId: schema.sessions.ownerId })
      .from(schema.sessions)
      .where(and(inArray(schema.sessions.id, ids), sessionData.readable(viewer)))
      .all()
      .filter((row) => allows(sessionAccess.delete, viewer, row.ownerId));
    db.transaction((tx) => {
      for (const row of rows)
        try {
          const used = usedBy(tx, row.id, \`#\${row.id}\`);
          if (used) throw new Conflict(\`in-use:\${JSON.stringify(used)}\`);
          const gone = tx.delete(schema.sessions).where(eq(schema.sessions.id, row.id)).returning().get();
          if (gone) {
            audit(tx, viewer, { action: "deleted", model: "Session", record: row.id, title: gone.id });
          }
        } catch (error) {
          const refused = refusal(error);
          throw refused instanceof Conflict && refused.message === "in-use" ? new Conflict(\`in-use:\${row.id}\`) : refused;
        }
    });
    for (const row of rows) {
      await afterDelete("Session", row.id, viewer);
    }
    return { deleted: rows.length, skipped: new Set(ids).size - rows.length };
  },

  /** Choices for fields that refer to a session: the ones the viewer may read. */
  options(viewer: Viewer | null) {
    if (readScope(sessionAccess.read, viewer) === "none") return [];
    return db
      .select({ value: schema.sessions.id, label: sql<string>\`'Session #' || \${schema.sessions.id}\` })
      .from(schema.sessions)
      .where(sessionData.readable(viewer))
      .orderBy(schema.sessions.id)
      .all();
  },
};
"
`;

exports[`../../../examples/booking/smithable.yml > file list and generated code > src/generated/session.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { z } from "zod";
import type * as schema from "#/db/schema";
import { allows, type Rule } from "#/kit/access";
import type { RecordUi } from "#/kit/model";
import { sessionDefaults, withSessionFormulas } from "./session.formulas";
import { sessionAccess, sessionData } from "./session.server";
import { bookingAccess } from "./booking.server";
import { writeAllowed } from "#/kit/limit";
import { currentViewer } from "#/lib/viewer.server";
import { sessionSchema } from "./session.schema";

export type { SessionValues } from "./session.schema";

/** The viewer about to write, counted against how often one may (see src/kit/limit.ts). */
async function writer() {
  const viewer = await currentViewer();
  writeAllowed(viewer, getRequestHeaders());
  return viewer;
}

/** Session records as the kit reads them. */
export type SessionRow = typeof schema.sessions.$inferSelect & {
  classType?: { id: number; name: string } | null;
  instructor?: { id: number; name: string } | null;
  placesLeft?: unknown;
};

export const sessionUi: RecordUi<SessionRow> = {
  model: "Session",
  label: "Session",
  pluralLabel: "Sessions",
  titleField: "id",
  columns: ["classTypeId", "instructorId", "startsAt", "capacity", "placesLeft"],
  fields: [
    {
      name: "classTypeId",
      label: "Class type",
      kind: "relation",
      required: true,
      relation: { key: "classType", titleField: "name" },
      get: (row) => row.classType?.name ?? null,
    },
    {
      name: "instructorId",
      label: "Instructor",
      kind: "relation",
      required: true,
      relation: { key: "instructor", titleField: "name" },
      get: (row) => row.instructor?.name ?? null,
    },
    {
      name: "startsAt",
      label: "Starts at",
      kind: "datetime",
      required: true,
      get: (row) => row.startsAt,
    },
    {
      name: "capacity",
      label: "Capacity",
      kind: "int",
      required: true,
      default: 12,
      get: (row) => row.capacity,
    },
    {
      name: "placesLeft",
      label: "Places left",
      kind: "int",
      required: false,
      computed: true,
      get: (row) => row.placesLeft,
    },
  ],
  compute: withSessionFormulas,
  defaults: sessionDefaults,
};

/** Who may delete sessions: a list's selection offers Delete by it (the server checks again). */
export const sessionDeleteRule: Rule = { public: false, roles: ["admin"], owner: true };


export const listSessions = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return { rows: await sessionData.list(viewer), canCreate: allows(sessionAccess.create, viewer) };
});

export const getSession = createServerFn()
  .validator(z.number().int())
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    const row = await sessionData.get(viewer, id);
    if (!row) return null;
    return {
      row,
      canWrite: allows(sessionAccess.write, viewer, row.ownerId),
      canDelete: allows(sessionAccess.delete, viewer, row.ownerId),
      // Who may add to its related lists from here ("Add line" on an invoice).
      canAdd: { bookings: allows(bookingAccess.create, viewer) },
    };
  });

/** Choices for fields that refer to a session. */
export const sessionOptions = createServerFn().handler(async () =>
  sessionData.options(await currentViewer()),
);

export const createSession = createServerFn({ method: "POST" })
  .validator(sessionSchema)
  .handler(async ({ data }) => sessionData.create(await writer(), data));

export const updateSession = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), values: sessionSchema }))
  .handler(async ({ data }) => sessionData.update(await writer(), data.id, data.values));

/** Deletes a session; \`together\` takes what points to it along (docs/design/delete-together.md). */
export const deleteSession = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), together: z.boolean().optional() }))
  .handler(async ({ data }) => sessionData.remove(await writer(), data.id, data.together));

/** Deletes the chosen sessions, all or none (at most 1,000 at once). */
export const deleteSessions = createServerFn({ method: "POST" })
  .validator(z.object({ ids: z.array(z.number().int()).max(1000), together: z.boolean().optional() }))
  .handler(async ({ data }) => sessionData.removeMany(await writer(), data.ids, data.together));
"
`;

