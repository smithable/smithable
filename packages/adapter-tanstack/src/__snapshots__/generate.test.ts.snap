"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createInsertSchema } from "drizzle-zod";
import type { z } from "zod";
import * as schema from "#/db/schema";
import { w } from "#/kit/words";

/** What a stop may be given: a form's values and what the app fills (an action's set). */
export const stopSettable = createInsertSchema(schema.stops, {
  place: (s) => s.trim().min(1, w.required).max(200, w.atMostCharacters(200)),
  day: (s) => s.regex(/^\\d{4}-\\d{2}-\\d{2}$/, w.enterValidDate),
  hours: (s) => s.trim().min(1, w.required).max(200, w.atMostCharacters(200)),
  note: (s) => s.max(10000, w.atMostCharacters(10000)),
}).omit({ id: true, ownerId: true, createdAt: true, updatedAt: true });
/** What a stop's form sends, checked. */
export const stopSchema = stopSettable;

export type StopSettable = z.output<typeof stopSettable>;
export type StopValues = z.output<typeof stopSchema>;
"
`;

exports[`../../../examples/kiosk/smithable.yml > file list and generated code > src/generated/stop.server.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { and, count, eq, inArray, sql, type SQL } from "drizzle-orm";
import { db } from "#/db";
import * as schema from "#/db/schema";
import { AccessDenied, allows, check, Conflict, type ModelAccess, personOf, readScope, type Viewer } from "#/kit/access";
import { audit, changedFields } from "#/kit/audit.server";
import { refusal } from "#/kit/log.server";
import { afterChange, afterDelete } from "./hooks";
import { type StopSettable } from "./stop";

/** Who may read, create, change and delete stops. */
export const stopAccess: ModelAccess = {
  read: { public: true, roles: ["admin", "staff"], owner: false },
  create: { public: false, roles: ["admin", "staff"], owner: false },
  write: { public: false, roles: ["admin", "staff"], owner: true },
  delete: { public: false, roles: ["admin"], owner: true },
};

/** A record as the viewer gets it: who owns it only for its owner and roles that read every record. */
function shownTo<R extends { ownerId: string | null }>(viewer: Viewer | null, row: R): R {
  if ((viewer && row.ownerId === viewer.id) || (!!viewer && (!!viewer.system || stopAccess.read.roles.includes(viewer.role)))) return row;
  return { ...row, ownerId: null };
}



export const stopData = {
  shownTo,
  /** The rows with each reference to a record the viewer may not read set to nothing: a related record's title is shown only to who may read it (only its id stays). */
  shownRefs<R extends Record<string, unknown>>(_viewer: Viewer | null, rows: R[]): R[] {
    return rows;
  },

  /** A condition for the stops the viewer may read. */
  readable(viewer: Viewer | null) {
    const scope = readScope(stopAccess.read, viewer);
    if (scope === "all") return undefined;
    return scope === "own" && viewer ? eq(schema.stops.ownerId, viewer.id) : sql\`false\`;
  },

  canRead(viewer: Viewer | null, id: number): boolean {
    const found = db
      .select({ id: schema.stops.id })
      .from(schema.stops)
      .where(and(eq(schema.stops.id, id), stopData.readable(viewer)))
      .get();
    return found !== undefined;
  },

  /** The stops the viewer may read; \`where\` narrows them, e.g. to a search. */
  async list(viewer: Viewer | null, where?: SQL) {
    if (readScope(stopAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const found = stopData.shownRefs(viewer, await db.query.stops.findMany({
      where: and(stopData.readable(viewer), where),
      orderBy: (t, { desc }) => [desc(t.id)],
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return rows;
  },

  /**
   * A page of the stops the viewer may read that fit \`where\`, newest first (or in
   * \`order\`), and how many fit in all: for a list page. A page past the end is the last one.
   */
  async page(viewer: Viewer | null, where?: SQL, order?: SQL, page = 1, size = 50) {
    if (readScope(stopAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = and(stopData.readable(viewer), where);
    const total = db.select({ n: count() }).from(schema.stops).where(condition).get()?.n ?? 0;
    const at = Math.min(Math.max(1, Math.trunc(page)), Math.max(1, Math.ceil(total / size)));
    const found = stopData.shownRefs(viewer, await db.query.stops.findMany({
      where: condition,
      orderBy: (t, { desc }) => [...(order ? [order] : []), desc(t.id)],
      limit: size,
      offset: (at - 1) * size,
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return { rows: rows, total, page: at, size };
  },

  async get(viewer: Viewer | null, id: number) {
    const fetched = await db.query.stops.findFirst({
      where: and(eq(schema.stops.id, id), stopData.readable(viewer)),
    });
    const found = fetched && stopData.shownRefs(viewer, [fetched])[0];
    const row = found && shownTo(viewer, found);
    return row ? row : null;
  },

  async create(viewer: Viewer | null, values: StopSettable) {
    check(stopAccess.create, viewer);
    let row: typeof schema.stops.$inferSelect;
    try {
      row = db.transaction((tx) => {
        const made = tx.insert(schema.stops).values({ ...values, ownerId: personOf(viewer) }).returning().get();
        audit(tx, viewer, { action: "created", model: "Stop", record: made.id });
        return made;
      });
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterCreate", "Stop", row, viewer);
    return row;
  },

  /** Changes the record; \`what\` names the change in the audit log (an action's name). */
  /** Changes the fields given; what names the action ("changed" for a form), frees the fields it may change although locked (its own set). */
  async update(viewer: Viewer | null, id: number, values: Partial<StopSettable>, what = "changed", _frees: readonly string[] = []) {
    const row = db
      .select({ ownerId: schema.stops.ownerId })
      .from(schema.stops)
      .where(and(eq(schema.stops.id, id), stopData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    // A form's change needs write on the record; an action (what names it) checked its own access
    // first, which includes the roles its grant names (docs/design/actions.md, Access).
    if (what === "changed") check(stopAccess.write, viewer, row.ownerId);
    let changed: typeof schema.stops.$inferSelect;
    const updated = values;
    try {
      changed = db.transaction((tx) => {
        // Read again in the change itself: a record that left the viewer's reach meanwhile is refused.
        const before = tx.select().from(schema.stops).where(and(eq(schema.stops.id, id), stopData.readable(viewer))).get();
        if (!before) throw new AccessDenied(viewer !== null);
        const after = tx.update(schema.stops).set(updated).where(eq(schema.stops.id, id)).returning().get();
        audit(tx, viewer, { action: what, model: "Stop", record: id, fields: before && changedFields(before, after, Object.keys(updated)) });
        return after;
      });
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterUpdate", "Stop", changed, viewer);
    return changed;
  },

  /** Deletes the record; \`together\` takes the records that point to it along to the trash (delete-together.md). */
  async remove(viewer: Viewer | null, id: number, _together = false): Promise<void> {
    const row = db
      .select({ ownerId: schema.stops.ownerId })
      .from(schema.stops)
      .where(and(eq(schema.stops.id, id), stopData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(stopAccess.delete, viewer, row.ownerId);
    try {
      db.transaction((tx) => {
        // Read again in the change itself: a record that left the viewer's reach meanwhile is refused.
        if (!tx.select({ id: schema.stops.id }).from(schema.stops).where(and(eq(schema.stops.id, id), stopData.readable(viewer))).get())
          throw new AccessDenied(viewer !== null);
        const gone = tx.delete(schema.stops).where(eq(schema.stops.id, id)).returning().get();
        if (gone) {
          audit(tx, viewer, { action: "deleted", model: "Stop", record: id, title: gone.place });
        }
      });
    } catch (error) {
      throw refusal(error);
    }
    await afterDelete("Stop", id, viewer);
  },

  /**
   * Deletes the chosen records the viewer may delete, all or none (one still in use stops them
   * all, and is named); the others are skipped.
   */
  async removeMany(viewer: Viewer | null, ids: number[], _together = false): Promise<{ deleted: number; skipped: number }> {
    const rows = db
      .select({ id: schema.stops.id, ownerId: schema.stops.ownerId })
      .from(schema.stops)
      .where(and(inArray(schema.stops.id, ids), stopData.readable(viewer)))
      .all()
      .filter((row) => allows(stopAccess.delete, viewer, row.ownerId));
    db.transaction((tx) => {
      for (const row of rows)
        try {
          const gone = tx.delete(schema.stops).where(eq(schema.stops.id, row.id)).returning().get();
          if (gone) {
            audit(tx, viewer, { action: "deleted", model: "Stop", record: row.id, title: gone.place });
          }
        } catch (error) {
          const refused = refusal(error);
          throw refused instanceof Conflict && refused.message === "in-use" ? new Conflict(\`in-use:\${row.id}\`) : refused;
        }
    });
    for (const row of rows) {
      await afterDelete("Stop", row.id, viewer);
    }
    return { deleted: rows.length, skipped: new Set(ids).size - rows.length };
  },
};
"
`;

exports[`../../../examples/kiosk/smithable.yml > file list and generated code > src/generated/stop.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { z } from "zod";
import type * as schema from "#/db/schema";
import { allows, type Rule } from "#/kit/access";
import type { RecordUi } from "#/kit/model";
import { stopAccess, stopData } from "./stop.server";
import { writeAllowed } from "#/kit/limit";
import { currentViewer } from "#/lib/viewer.server";
import { stopSchema } from "./stop.schema";

export type { StopSettable, StopValues } from "./stop.schema";

/** The viewer about to write, counted against how often one may (see src/kit/limit.ts). */
async function writer() {
  const viewer = await currentViewer();
  writeAllowed(viewer, getRequestHeaders());
  return viewer;
}

/** Stop records as the kit reads them. */
export type StopRow = typeof schema.stops.$inferSelect;

export const stopUi: RecordUi<StopRow> = {
  model: "Stop",
  label: "Stop",
  pluralLabel: "Stops",
  titleField: "place",
  columns: ["place", "day", "hours"],
  fields: [
    {
      name: "place",
      label: "Place",
      kind: "string",
      required: true,
      get: (row) => row.place,
    },
    {
      name: "day",
      label: "Day",
      kind: "date",
      required: true,
      get: (row) => row.day,
    },
    {
      name: "hours",
      label: "Hours",
      kind: "string",
      required: true,
      get: (row) => row.hours,
    },
    {
      name: "note",
      label: "Note",
      kind: "text",
      required: false,
      get: (row) => row.note,
    },
  ],
};

/** Who may delete stops: a list's selection offers Delete by it (the server checks again). */
export const stopDeleteRule: Rule = { public: false, roles: ["admin"], owner: true };


export const listStops = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return { rows: await stopData.list(viewer), canCreate: allows(stopAccess.create, viewer) };
});

export const getStop = createServerFn()
  .validator(z.number().int())
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    const row = await stopData.get(viewer, id);
    if (!row) return null;
    return {
      row,
      canWrite: allows(stopAccess.write, viewer, row.ownerId),
      canDelete: allows(stopAccess.delete, viewer, row.ownerId),
    };
  });

export const createStop = createServerFn({ method: "POST" })
  .validator(stopSchema)
  .handler(async ({ data }) => stopData.create(await writer(), data));

export const updateStop = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), values: stopSchema }))
  .handler(async ({ data }) => stopData.update(await writer(), data.id, data.values));

/** Deletes a stop; \`together\` takes what points to it along (docs/design/delete-together.md). */
export const deleteStop = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), together: z.boolean().optional() }))
  .handler(async ({ data }) => stopData.remove(await writer(), data.id, data.together));

/** Deletes the chosen stops, all or none (at most 1,000 at once). */
export const deleteStops = createServerFn({ method: "POST" })
  .validator(z.object({ ids: z.array(z.number().int()).max(1000), together: z.boolean().optional() }))
  .handler(async ({ data }) => stopData.removeMany(await writer(), data.ids, data.together));
"
`;

