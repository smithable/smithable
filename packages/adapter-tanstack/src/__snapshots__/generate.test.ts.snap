export function confirmFits(row: { status?: unknown }, _viewer: { id: string } | null): boolean {
  return row.status === "requested";
}

/** The viewer about to run it, counted against how often one may write (see src/kit/limit.ts). */
async function writer() {
  const viewer = await currentViewer();
  writeAllowed(viewer, getRequestHeaders());
  return viewer;
}

export const confirm = createServerFn({ method: "POST" })
  .validator(z.number().int())
  .handler(async ({ data }) => runConfirm(await writer(), data));

/** The "confirm" action on the chosen appointments (at most 1,000 at once). */
export const confirmMany = createServerFn({ method: "POST" })
  .validator(z.object({ ids: z.array(z.number().int()).max(1000) }))
  .handler(async ({ data }) => runConfirmMany(await writer(), data.ids));
