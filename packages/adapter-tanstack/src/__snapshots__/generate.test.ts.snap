          deletable={chosen.filter((row) => allows(messageDeleteRule, viewer, row.ownerId)).length}
          onDelete={(together) => deleteMessages({ data: { ids: chosen.map((row) => row.id), together } })}
          onDone={async () => {
            setSelected(new Set());
            await router.invalidate();
          }}
          onExport={() => download(csvName(messageUi), csvOf(messageUi, chosen))}
        />
      )}
      <ModelTable
        ui={messageUi}
        page="messages"
        paging={{ page: at, size, total, to: (next) => navigate({ to: "/messages", search: (prev) => ({ ...prev, page: next > 1 ? next : undefined }) }) }}
        app={app}
        exportRows={async () => (await listMessages({ data: { all: true } })).rows}
        rows={rows}
        selection={selectable ? { ids: selected, onChange: setSelected } : undefined}
        emptyAction={newButton || undefined}
        onOpen={(row) => navigate({ to: "/messages/$id", params: { id: String(row.id) } })}
      />
    </>
  );
}
"
`;

