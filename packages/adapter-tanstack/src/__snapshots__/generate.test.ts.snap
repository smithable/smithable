"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, Link, useNavigate } from "@tanstack/react-router";
import { buttonVariants } from "#/components/ui/button";
import { app } from "#/generated/app";
import { listClassTypes, classTypeUi } from "#/generated/class-type";
import { PageHeader } from "#/kit/AppShell";
import { ModelTable } from "#/kit/ModelTable";

export const Route = createFileRoute("/class-types/")({
  loader: () => listClassTypes(),
  component: ClassTypesPage,
});

function ClassTypesPage() {
  const rows = Route.useLoaderData();
  const navigate = useNavigate();
  const newButton = (
    <Link to="/class-types/new" className={buttonVariants()}>
      New class type
    </Link>
  );
  return (
    <>
      <PageHeader
        title="Class types"
        actions={newButton}
      />
      <ModelTable
        ui={classTypeUi}
        app={app}
        rows={rows}
        emptyAction={newButton}
        onOpen={(row) => navigate({ to: "/class-types/$id", params: { id: String(row.id) } })}
      />
    </>
  );
}
"
`;

