  },
];

const landingRoutes = ["/"];
/** Public pages that visitors see in the site's frame (signed in, the app's). */
const visitorRoutes = ["/privacy", "/sign-in"];

/** Each page's route and name, longest route first. */
const pageRoutes: [string, string][] = [
  ["/appointments", "appointments"],
  ["/services", "services"],
  ["/time-off", "time-off"],
  ["/barbers", "barbers"],
  ["/privacy", "privacy"],
  ["/day", "day"],
  ["/", "home"],
];

/** The page a path is on, e.g. "customers" for /customers/12 (see data-page, src/custom/styles.css). */
function pageOf(path: string): string | undefined {
  return pageRoutes.find(([route]) => path === route || path.startsWith(route === "/" ? "/" : \`\${route}/\`))?.[1];
}


// Who is signed in, and, when a hosting service runs a copy of the app's data from an earlier
// time to look at (DATA_AS_OF), that time.
const getViewer = createServerFn().handler(async () => ({
  viewer: await currentViewer(),
  asOf: process.env.DATA_AS_OF,
  demo: process.env.DEMO_SIGN_IN === "1",
}));

export const Route = createRootRoute({
  // Every page knows who is signed in; pages check their access with it.
  beforeLoad: () => getViewer(),
  headers: ({ ssr }) => pageHeaders(ssr?.nonce),
  head: () => ({
    meta: [
      { charSet: "utf-8" },
      { name: "viewport", content: "width=device-width, initial-scale=1" },
      { title: app.name },
    ],
    links: [
      { rel: "stylesheet", href: appCss },
      { rel: "icon", href: "/favicon.svg", type: "image/svg+xml" },
    ],
  }),
  shellComponent: RootDocument,
  errorComponent: ({ error }) => (
    <ErrorNotice title={w.errorTitle} message={error instanceof Error ? error.message : undefined} />
  ),
  notFoundComponent: () => (
    <ErrorNotice kind="not-found" title={w.notFound} message={w.notFoundNote} />
  ),
});

function RootDocument({ children }: { children: React.ReactNode }) {
  const { viewer, asOf, demo } = Route.useRouteContext();
  const pathname = useRouterState({ select: (state) => state.location.pathname });
  // Set once React has taken over the page in the browser, for tests that must not type or
  // click before the page's handlers are attached (body[data-hydrated]).
  const [hydrated, setHydrated] = useState(false);
  useEffect(() => setHydrated(true), []);
  const router = useRouter();
  const signOut = async () => {
    await authClient.signOut();
    await router.invalidate();
  };
  const rename = async (name: string) => {
    const { error } = await authClient.updateUser({ name });
    if (error) throw new Error(error.message);
    await router.invalidate();
  };
  return (
    // data-appearance is set by the head's script before React takes over (src/kit/appearance.ts).
    <html lang="en" suppressHydrationWarning>
      <head>
        <ScriptOnce children={APPEARANCE_SCRIPT} />
        <HeadContent />
      </head>
      <body data-page={pageOf(pathname)} data-hydrated={hydrated ? "true" : undefined}>
        {asOf && (
          <p role="status" className="bg-warning px-4 py-2 text-center text-sm text-warning-foreground">
            A copy of this app's data as of {asOf.slice(0, 16).replace("T", " ")} UTC: changes made here are not kept.
          </p>
        )}
        {demo && (
          <p role="status" className="bg-warning px-4 py-2 text-center text-sm text-warning-foreground">
            This is a demo: sign in as anyone and try things; the data is reset every hour.
          </p>
        )}
        {landingRoutes.includes(pathname) ? (
          children
        ) : !viewer && visitorRoutes.some((r) => pathname === r || pathname.startsWith(\`\${r}/\`)) ? (
          <LandingLayout appName={app.name} link={{ to: "/sign-in", label: w.signIn }} site={site}>
            <div className="mx-auto max-w-6xl px-5 py-10">{children}</div>
          </LandingLayout>
        ) : (
          <AppShell appName={app.name} home={{ to: "/", access: pageAccess["home"] }} menus={menus} viewer={viewer} onSignOut={signOut} onRename={rename}>
            {children}
          </AppShell>
        )}
        <Consent privacy="/privacy" />
        <Scripts />
      </body>
    </html>
  );
}
"
`;

exports[`../../../examples/barbers/smithable.yml > file list and generated code > src/routes/appointments/$id.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, notFound, useNavigate, useRouter } from "@tanstack/react-router";
import { createServerFn } from "@tanstack/react-start";
import { and, desc, eq } from "drizzle-orm";
import { db } from "#/db";
import { auditLog, user } from "#/db/schema";
import { app } from "#/generated/app";
import { pageAccess, pageHead } from "#/generated/pages";
import { appointmentCancelState, appointmentUi, cancelOwnAppointment, deleteAppointment, getAppointment, updateAppointment } from "#/generated/appointment";
import { appointmentSchema } from "#/generated/appointment.schema";
import { CancelOwn } from "#/kit/Slots";
import { confirm, confirmAccess, confirmFits } from "#/generated/actions/confirm";
import { cancel, cancelAccess, cancelFits } from "#/generated/actions/cancel";
import { serviceOptions } from "#/generated/service";
import { barberOptions } from "#/generated/barber";
import { allows, guardPage } from "#/kit/access";
import { ActionButton } from "#/kit/ActionButton";
import { ActivityLog } from "#/kit/ActivityLog";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";
import { w } from "#/kit/words";
import { currentViewer } from "#/lib/viewer.server";

/** The record's lines in the audit log, newest first: administrators only, nobody else. */
const getHistory = createServerFn()
  .validator((id: number) => id)
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    if (viewer?.role !== "admin") return null;
    const people = new Map(db.select({ id: user.id, name: user.name }).from(user).all().map((p) => [p.id, p.name]));
    return db
      .select()
      .from(auditLog)
      .where(and(eq(auditLog.model, "Appointment"), eq(auditLog.recordId, id)))
      .orderBy(desc(auditLog.id))
      .limit(50)
      .all()
      .map((r) => ({
        id: r.id,
        at: r.at,
        who: r.who === "visitor" || r.who === "the app" ? r.who : (people.get(r.who) ?? (r.who.startsWith("key:") ? w.aKey(r.who.slice(4)) : r.who.startsWith("timer:") ? w.byTimer(r.who.slice(6)) : w.aRemovedUser(r.who))),
        action: r.action,
        fields: r.fields,
        details: r.details ? Object.fromEntries(Object.entries(r.details).map(([k, v]) => [k, String(v)])) : null,
      }));
  });

export const Route = createFileRoute("/appointments/$id")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["appointments"], context.viewer, location.href),
  head: () => pageHead("appointments"),
  loader: async ({ params }) => {
    const found = await getAppointment({ data: Number(params.id) });
    if (!found) throw notFound();
    return { ...found, options: { serviceId: await serviceOptions(), barberId: await barberOptions() }, history: await getHistory({ data: Number(params.id) }) };
  },
  component: AppointmentPage,
});

function AppointmentPage() {
  const { row, canWrite, canDelete, options, history } = Route.useLoaderData();
  const { viewer } = Route.useRouteContext();
  const navigate = useNavigate();
  const router = useRouter();
  const back = () => navigate({ to: "/appointments" });
  return (
    <>
      <PageHeader
        title={row.name || \`Appointment #\${row.id}\`}
        actions={
          <>
            {allows(confirmAccess, viewer, row.ownerId) && confirmFits(row, viewer) && (
              <ActionButton
                label="Confirm"
                concept="action:confirm"
                onRun={async () => {
                  await confirm({ data: row.id });
                  await router.invalidate();
                }}
              />
            )}
            {allows(cancelAccess, viewer, row.ownerId) && cancelFits(row, viewer) && (
              <ActionButton
                label="Cancel"
                concept="action:cancel"
                onRun={async () => {
                  await cancel({ data: row.id });
                  await router.invalidate();
                }}
              />
            )}
          </>
        }
      />
      <ModelForm
        key={String(row.updatedAt)}
        ui={appointmentUi}
        app={app}
        schema={appointmentSchema}
        initial={row}
        readOnly={!canWrite}
        options={options}
        submitLabel={w.saveChanges}
        onSubmit={async (values) => {
          await updateAppointment({ data: { id: row.id, values } });
          await back();
        }}
        onCancel={back}
        onDelete={
          canDelete
            ? async (together?: boolean) => {
                await deleteAppointment({ data: { id: row.id, together } });
                await back();
              }
            : undefined
        }
      />
      <section className="mt-10 max-w-3xl">
        <CancelOwn id={row.id} load={appointmentCancelState} cancel={cancelOwnAppointment} />
      </section>

      {history && history.length > 0 && (
        <section className="mt-10 max-w-3xl">
          <h2 className="mb-3 text-lg font-semibold">{w.history}</h2>
          <ActivityLog lines={history} app={app} />
        </section>
      )}
    </>
  );
}
"
`;

exports[`../../../examples/barbers/smithable.yml > file list and generated code > src/routes/appointments/index.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, Link, useNavigate, useRouter } from "@tanstack/react-router";
import { pageAccess, pageUi, pageHead } from "#/generated/pages";
import { guardPage, allows } from "#/kit/access";
import { createServerFn } from "@tanstack/react-start";
import * as schema from "#/db/schema";
import { appointmentAccess, appointmentData } from "#/generated/appointment.server";
import { inArray, and } from "drizzle-orm";
import { currentViewer } from "#/lib/viewer.server";
import { type Search, count, listQuery, optional, text } from "#/kit/params";
import { buttonVariants } from "#/components/ui/button";
import { confirm, confirmAccess, confirmFits, confirmMany } from "#/generated/actions/confirm";
import { cancel, cancelAccess, cancelFits, cancelMany } from "#/generated/actions/cancel";
import { ActionButton } from "#/kit/ActionButton";
import { useState } from "react";
import { SelectionBar } from "#/kit/SelectionBar";
import { csvName, csvOf, download } from "#/kit/csv";
import { deleteAppointments, appointmentDeleteRule, appointmentUi } from "#/generated/appointment";
import { app } from "#/generated/app";
import { w } from "#/kit/words";
import { PageHeader } from "#/kit/AppShell";
import { ModelTable } from "#/kit/ModelTable";
import { Filters } from "#/kit/Filters";

/** The appointments matching the search and the filters, among those the viewer may read. */
const searchAppointments = createServerFn()
  .validator(listQuery)
  .handler(async ({ data }) => {
    const viewer = await currentViewer();
    const where = and(
      undefined,
      data.f?.status ? inArray(schema.appointments.status, data.f?.status.split(",").filter((v) => ["requested", "confirmed", "cancelled"].includes(v)) as ("requested" | "confirmed" | "cancelled")[]) : undefined,
    );
    return {
      ...(await appointmentData.page(viewer, where, undefined, data.all ? 1 : data.page, data.all ? (viewer ? 10000 : 500) : undefined)),
      canCreate: allows(appointmentAccess.create, viewer),
      options: {  },
    };
  });

export const Route = createFileRoute("/appointments/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["appointments"], context.viewer, location.href),
  head: () => pageHead("appointments"),
  validateSearch: (s: Search) => optional({ q: text(s.q), sort: text(s.sort), status: text(s.status), page: count(s.page) }),
  loaderDeps: ({ search }) => search,
  loader: ({ deps: { q, sort, page, ...f } }) => searchAppointments({ data: { q, sort, f, page } }),
  // While a search or filter loads, the page stays (and its controls keep their focus).
  pendingMs: Number.POSITIVE_INFINITY,
  gcTime: 0,
  component: AppointmentsPage,
});

function AppointmentsPage() {
  const { rows, canCreate, total, page: at, size } = Route.useLoaderData();
  const { q, sort, page: _page, ...values } = Route.useSearch();
  const { viewer } = Route.useRouteContext();
  const navigate = useNavigate({ from: "/appointments/" });
  const router = useRouter();
  // The chosen rows, offered when the viewer may do something to at least one row.
  const [selected, setSelected] = useState<Set<number>>(new Set());
  const chosen = rows.filter((row) => selected.has(row.id));
  const selectable = rows.some((row) => allows(confirmAccess, viewer, row.ownerId) && confirmFits(row, viewer) || allows(cancelAccess, viewer, row.ownerId) && cancelFits(row, viewer) || allows(appointmentDeleteRule, viewer, row.ownerId));
  const newButton = canCreate && (
    <Link to="/appointments/new" className={buttonVariants()}>
      {w.newOne("appointment")}
    </Link>
  );
  return (
    <>
      <PageHeader
        page="appointments"
        title={pageUi["appointments"].title}
        actions={newButton}
      />
      <Filters
        filters={[
  {
    name: "status",
    label: "Status",
    kind: "chips",
    options: appointmentUi.fields.find((f) => f.name === "status")?.choices,
  },
]}
        values={values}
        onChange={(next) => navigate({ to: "/appointments", search: { q, ...next }, replace: true, resetScroll: false })}
      />
      {selectable && (
        <SelectionBar
          count={chosen.length}
          noun={["appointment", "appointments"]}
          app={app}
          titleOf={(id) => String(rows.find((row) => row.id === id)?.name ?? id)}
          actions={[
            {
              label: "Confirm",
              concept: "action:confirm",
              applies: chosen.filter((row) => allows(confirmAccess, viewer, row.ownerId) && confirmFits(row, viewer)).length,
              run: () => confirmMany({ data: { ids: chosen.map((row) => row.id) } }),
            },
            {
              label: "Cancel",
              concept: "action:cancel",
              applies: chosen.filter((row) => allows(cancelAccess, viewer, row.ownerId) && cancelFits(row, viewer)).length,
              run: () => cancelMany({ data: { ids: chosen.map((row) => row.id) } }),
            },
          ]}
          deletable={chosen.filter((row) => allows(appointmentDeleteRule, viewer, row.ownerId)).length}
          onDelete={(together) => deleteAppointments({ data: { ids: chosen.map((row) => row.id), together } })}
          onDone={async () => {
            setSelected(new Set());
            await router.invalidate();
          }}
          onExport={() => download(csvName(appointmentUi), csvOf(appointmentUi, chosen))}
        />
      )}
      <ModelTable
        ui={appointmentUi}
        page="appointments"
        paging={{ page: at, size, total, to: (next) => navigate({ to: "/appointments", search: (prev) => ({ ...prev, page: next > 1 ? next : undefined }) }) }}
        app={app}
        exportRows={async () => (await searchAppointments({ data: { q, sort, f: values, all: true } })).rows}
        rows={rows}
        selection={selectable ? { ids: selected, onChange: setSelected } : undefined}
        rowActions={(row) => (
          <>
            {allows(confirmAccess, viewer, row.ownerId) && confirmFits(row, viewer) && (
              <ActionButton
                label="Confirm"
                concept="action:confirm"
                onRun={async () => {
                  await confirm({ data: row.id });
                  await router.invalidate();
                }}
              />
            )}
            {allows(cancelAccess, viewer, row.ownerId) && cancelFits(row, viewer) && (
              <ActionButton
                label="Cancel"
                concept="action:cancel"
                onRun={async () => {
                  await cancel({ data: row.id });
                  await router.invalidate();
                }}
              />
            )}
          </>
        )}
        emptyMessage={q || Object.values(values).some(Boolean) ? "No appointments match the search and filters." : undefined}
        emptyAction={newButton || undefined}
        onOpen={(row) => navigate({ to: "/appointments/$id", params: { id: String(row.id) } })}
      />
    </>
  );
}
"
`;

