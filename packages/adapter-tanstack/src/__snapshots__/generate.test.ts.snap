"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createInsertSchema } from "drizzle-zod";
import type { z } from "zod";
import * as schema from "#/db/schema";
import { w } from "#/kit/words";

/** What a appointment may be given: a form's values and what the app fills (an action's set). */
export const appointmentSettable = createInsertSchema(schema.appointments, {
  name: (s) => s.trim().min(1, w.required).max(200, w.atMostCharacters(200)),
  phone: (s) => s.regex(/^\\+?[0-9 ()-]{5,20}$/, w.enterValidPhone),
  note: (s) => s.max(10000, w.atMostCharacters(10000)),
}).omit({ id: true, ownerId: true, createdAt: true, updatedAt: true }).partial({ status: true });
/** What a appointment's form sends, checked: never what the app fills. */
export const appointmentSchema = appointmentSettable.omit({ status: true });

export type AppointmentSettable = z.output<typeof appointmentSettable>;
export type AppointmentValues = z.output<typeof appointmentSchema>;
"
`;

