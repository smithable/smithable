if (db.select().from(classTypes).limit(1).all().length === 0) {
  db.insert(classTypes)
    .values([
    { name: "Class type 1", summary: "Prefers email over phone calls.", level: "beginner", durationMinutes: 45 },
    { name: "Class type 2", summary: "Follow up after the summer break.", level: "allLevels", durationMinutes: 60 },
    { name: "Class type 3", summary: "Long-standing relationship, very reliable.", level: "advanced", durationMinutes: 75 },
