"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { z } from "zod";
import type * as schema from "#/db/schema";
import { allows, type Rule } from "#/kit/access";
import type { RecordUi } from "#/kit/model";
import { incidentUpdateAccess, incidentUpdateData } from "./incident-update.server";
import { writeAllowed } from "#/kit/limit";
import { currentViewer } from "#/lib/viewer.server";
import { incidentUpdateSchema } from "./incident-update.schema";

export type { IncidentUpdateSettable, IncidentUpdateValues } from "./incident-update.schema";

/** The viewer about to write, counted against how often one may (see src/kit/limit.ts). */
async function writer() {
  const viewer = await currentViewer();
  writeAllowed(viewer, getRequestHeaders());
  return viewer;
}

/** IncidentUpdate records as the kit reads them. */
export type IncidentUpdateRow = typeof schema.incidentUpdates.$inferSelect & {
  incident?: { id: number; title: string } | null;
};

export const incidentUpdateUi: RecordUi<IncidentUpdateRow> = {
  model: "IncidentUpdate",
  label: "Incident update",
  pluralLabel: "Incident updates",
  titleField: "message",
  descriptionField: "message",
  columns: ["message", "incidentId", "at", "status"],
  fields: [
    {
      name: "incidentId",
      label: "Incident",
      kind: "relation",
      required: true,
      relation: { key: "incident", titleField: "title" },
      get: (row) => row.incident?.title ?? null,
    },
    {
      name: "at",
      label: "At",
      kind: "datetime",
      required: true,
      get: (row) => row.at,
    },
    {
      name: "status",
      label: "Status",
      kind: "choice",
      required: true,
      choices: [
        { value: "investigating", label: "Investigating" },
        { value: "identified", label: "Identified" },
        { value: "monitoring", label: "Monitoring" },
        { value: "resolved", label: "Resolved" },
      ],
      default: "investigating",
      get: (row) => row.status,
    },
    {
      name: "message",
      label: "Message",
      kind: "text",
      required: true,
      get: (row) => row.message,
    },
  ],
};

/** Who may delete incident updates: a list's selection offers Delete by it (the server checks again). */
export const incidentUpdateDeleteRule: Rule = { public: false, roles: ["admin"], owner: true };


export const listIncidentUpdates = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return { rows: await incidentUpdateData.list(viewer), canCreate: allows(incidentUpdateAccess.create, viewer) };
});

export const getIncidentUpdate = createServerFn()
  .validator(z.number().int())
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    const row = await incidentUpdateData.get(viewer, id);
    if (!row) return null;
    return {
      row,
      canWrite: allows(incidentUpdateAccess.write, viewer, row.ownerId),
      canDelete: allows(incidentUpdateAccess.delete, viewer, row.ownerId),
    };
  });

export const createIncidentUpdate = createServerFn({ method: "POST" })
  .validator(incidentUpdateSchema)
  .handler(async ({ data }) => incidentUpdateData.create(await writer(), data));

export const updateIncidentUpdate = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), values: incidentUpdateSchema }))
  .handler(async ({ data }) => incidentUpdateData.update(await writer(), data.id, data.values));

/** Deletes a incident update; \`together\` takes what points to it along (docs/design/delete-together.md). */
export const deleteIncidentUpdate = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), together: z.boolean().optional() }))
  .handler(async ({ data }) => incidentUpdateData.remove(await writer(), data.id, data.together));

/** Deletes the chosen incident updates, all or none (at most 1,000 at once). */
export const deleteIncidentUpdates = createServerFn({ method: "POST" })
  .validator(z.object({ ids: z.array(z.number().int()).max(1000), together: z.boolean().optional() }))
  .handler(async ({ data }) => incidentUpdateData.removeMany(await writer(), data.ids, data.together));
"
`;

exports[`../../../examples/status/smithable.yml > file list and generated code > src/generated/keys.server.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// Keys for the API (docs/design/integrations.md §2). Server-only. A key is a role, not a person:
// what it creates has no owner, and the audit log names it by its name.
import { createHash, randomBytes } from "node:crypto";
import { and, desc, eq, gt, isNull, or } from "drizzle-orm";
import { db } from "#/db";
import { apiKey } from "#/db/schema";
import { AccessDenied, personOf, type Viewer } from "#/kit/access";
import { audit } from "#/kit/audit.server";

export const KEY_ROLES = ["admin", "staff"] as const;

const hash = (key: string) => createHash("sha256").update(key).digest("hex");

/** An administrator, a person: a key with the admin role never makes or revokes keys. */
function admin(viewer: Viewer | null): Viewer {
  if (viewer?.role !== "admin" || !personOf(viewer)) throw new AccessDenied(viewer !== null);
  return viewer;
}

/** The keys, newest first: what they are for, their role, when they end and were last used. */
export function listKeys(viewer: Viewer | null) {
  admin(viewer);
  return db
    .select({
      id: apiKey.id,
      name: apiKey.name,
      role: apiKey.role,
      prefix: apiKey.prefix,
      expiresAt: apiKey.expiresAt,
      lastUsedAt: apiKey.lastUsedAt,
      revokedAt: apiKey.revokedAt,
      createdAt: apiKey.createdAt,
    })
    .from(apiKey)
    .orderBy(desc(apiKey.id))
    .all();
}

/** Makes a key and returns it: the only time it is shown. */
export function makeKey(
  viewer: Viewer | null,
  name: string,
  role: (typeof KEY_ROLES)[number],
  until?: Date,
): string {
  const by = admin(viewer);
  // Its own check, not only the route's: a key stands for a role the app has.
  if (!(KEY_ROLES as readonly string[]).includes(role)) throw new Error("No such role.");
  if (until && until.getTime() < Date.now()) throw new Error("The end date is in the past.");
  const key = \`smk_\${randomBytes(24).toString("base64url")}\`;
  db.transaction((tx) => {
    tx.insert(apiKey)
      .values({ name: name.trim(), role, hash: hash(key), prefix: key.slice(0, 10), expiresAt: until, createdById: by.id })
      .run();
    // What touches security keeps its values (never the key): its name, role and end.
    audit(tx, by, { action: "key made", details: { name: name.trim(), role, until: until?.toISOString().slice(0, 10) ?? "none" } });
  });
  return key;
}

/** Revokes a key: it stops working at once. */
export function revokeKey(viewer: Viewer | null, id: number): void {
  const by = admin(viewer);
  db.transaction((tx) => {
    const revoked = tx
      .update(apiKey)
      .set({ revokedAt: new Date() })
      .where(and(eq(apiKey.id, id), isNull(apiKey.revokedAt)))
      .returning()
      .get();
    if (revoked) audit(tx, by, { action: "key revoked", details: { name: revoked.name, role: revoked.role } });
  });
}

/**
 * The caller a request's key stands for (\\\`Authorization: Bearer smk_…\\\`), or null: a key not
 * revoked and not past its end. Its id is "key:<n>", so nothing it does is anyone's own.
 */
export function keyViewer(authorization: string | null | undefined): Viewer | null {
  const key = /^Bearer (smk_[A-Za-z0-9_-]+)$/.exec(authorization ?? "")?.[1];
  if (!key) return null;
  const found = db
    .select()
    .from(apiKey)
    .where(
      and(
        eq(apiKey.hash, hash(key)),
        isNull(apiKey.revokedAt),
        or(isNull(apiKey.expiresAt), gt(apiKey.expiresAt, new Date())),
      ),
    )
    .get();
  if (!found) return null;
  db.update(apiKey).set({ lastUsedAt: new Date() }).where(eq(apiKey.id, found.id)).run();
  return { id: \`key:\${found.id}\`, name: found.name, email: "", role: found.role };
}
"
`;

exports[`../../../examples/status/smithable.yml > file list and generated code > src/generated/keys.test.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// A key's life: made by an administrator, standing for its role, revoked or past its end.
import { eq } from "drizzle-orm";
import { expect, test } from "vitest";
import { db } from "#/db";
import { apiKey, auditLog, user } from "#/db/schema";
import { AccessDenied } from "#/kit/access";
import { keyViewer, listKeys, makeKey, revokeKey } from "./keys.server";
import { removeUser, setRole } from "./users.server";

const admin = { id: "keys-test-admin", name: "Keys test admin", email: "keys-test-admin@example.com", role: "admin" };

test("an administrator makes a key; it stands for its role until revoked or past its end", async () => {
  const key = makeKey(admin, "Billing sync", "staff");
  expect(key).toMatch(/^smk_/);
  expect(keyViewer(\`Bearer \${key}\`)).toMatchObject({ id: expect.stringMatching(/^key:/), name: "Billing sync", role: "staff" });
  // Stored as a hash: the key itself is nowhere, not in the table and not in the audit log.
  expect(JSON.stringify(db.select().from(apiKey).all())).not.toContain(key);
  expect(JSON.stringify(db.select().from(auditLog).all())).not.toContain(key);
  const made = listKeys(admin).find((k) => k.name === "Billing sync");
  expect(made?.lastUsedAt).toBeInstanceOf(Date);
  revokeKey(admin, made?.id ?? 0);
  expect(keyViewer(\`Bearer \${key}\`)).toBeNull();
  // A key cannot be made already ended; one whose end has passed stops working.
  expect(() => makeKey(admin, "Ended", "staff", new Date(Date.now() - 1000))).toThrow("The end date is in the past.");
  const old = makeKey(admin, "Old", "staff", new Date(Date.now() + 1000));
  db.update(apiKey).set({ expiresAt: new Date(Date.now() - 1000) }).where(eq(apiKey.name, "Old")).run();
  expect(keyViewer(\`Bearer \${old}\`)).toBeNull();
  expect(keyViewer("Bearer smk_madeup")).toBeNull();
  expect(keyViewer(null)).toBeNull();
  expect(() => makeKey({ ...admin, id: "keys-test-other", role: "staff" }, "Mine", "staff")).toThrow(AccessDenied);
  // A key cannot make keys, whatever its role.
  expect(() => makeKey(admin, "Made up", "superuser" as never)).toThrow("No such role.");
  const adminKey = makeKey(admin, "Admin key", "admin");
  expect(() => makeKey(keyViewer(\`Bearer \${adminKey}\`), "Minted", "admin")).toThrow(AccessDenied);
  revokeKey(admin, listKeys(admin).find((k) => k.name === "Admin key")?.id ?? 0);
  // A key goes with the person who made it.
  const maker = { id: "keys-test-maker", name: "Maker", email: "keys-test-maker@example.com", role: "admin" };
  db.insert(user).values(maker).run();
  const theirs = makeKey(maker, "Theirs", "staff");
  await removeUser(admin, maker.id);
  expect(keyViewer(\`Bearer \${theirs}\`)).toBeNull();
  // And with the role they had: a new role ends the keys they made.
  const demoted = { id: "keys-test-demoted", name: "Demoted", email: "keys-test-demoted@example.com", role: "admin" };
  db.insert(user).values(demoted).run();
  const before = makeKey(demoted, "Before", "admin");
  await setRole(admin, demoted.id, "staff");
  expect(keyViewer(\`Bearer \${before}\`)).toBeNull();
  // What touches security keeps its values: the key's name and role, never the key.
  const lines = db.select().from(auditLog).all().filter((l) => l.action.startsWith("key "));
  expect(lines.map((l) => [l.action, l.who, l.details?.name])).toEqual([
    ["key made", admin.id, "Billing sync"],
    ["key revoked", admin.id, "Billing sync"],
    ["key made", admin.id, "Old"],
    ["key made", admin.id, "Admin key"],
    ["key revoked", admin.id, "Admin key"],
    ["key made", maker.id, "Theirs"],
    ["key revoked", admin.id, "Theirs"],
    ["key made", "keys-test-demoted", "Before"],
    ["key revoked", admin.id, "Before"],
  ]);
});
"
`;

exports[`../../../examples/status/smithable.yml > file list and generated code > src/generated/maintenance.schema.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createInsertSchema } from "drizzle-zod";
import type { z } from "zod";
import * as schema from "#/db/schema";
