exports[`../../../examples/marketplace/smithable.yml > file list and generated code > src/db/schema.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { index, integer, sqliteTable, text, unique } from "drizzle-orm/sqlite-core";
import type { Picture } from "#/kit/uploads";

export const user = sqliteTable("user", {
  id: text().primaryKey(),
  name: text().notNull(),
  email: text().notNull().unique(),
  emailVerified: integer({ mode: "boolean" }).default(false).notNull(),
  image: text(),
  role: text().notNull().default("member"),
  createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
  updatedAt: integer({ mode: "timestamp_ms" })
    .notNull()
    .$defaultFn(() => new Date())
    .$onUpdate(() => new Date()),
});

export const session = sqliteTable(
  "session",
  {
    id: text().primaryKey(),
    expiresAt: integer({ mode: "timestamp_ms" }).notNull(),
    token: text().notNull().unique(),
    createdAt: integer({ mode: "timestamp_ms" }).notNull(),
    updatedAt: integer({ mode: "timestamp_ms" }).notNull(),
    ipAddress: text(),
    userAgent: text(),
    userId: text()
      .notNull()
      .references(() => user.id, { onDelete: "cascade" }),
  },
  (t) => [index("session_user_id_idx").on(t.userId)],
);

export const account = sqliteTable(
  "account",
  {
    id: text().primaryKey(),
    accountId: text().notNull(),
    providerId: text().notNull(),
    userId: text()
      .notNull()
      .references(() => user.id, { onDelete: "cascade" }),
    accessToken: text(),
    refreshToken: text(),
    idToken: text(),
    accessTokenExpiresAt: integer({ mode: "timestamp_ms" }),
    refreshTokenExpiresAt: integer({ mode: "timestamp_ms" }),
    scope: text(),
    password: text(),
    createdAt: integer({ mode: "timestamp_ms" }).notNull(),
    updatedAt: integer({ mode: "timestamp_ms" }).notNull(),
  },
  (t) => [index("account_user_id_idx").on(t.userId)],
);

export const verification = sqliteTable(
  "verification",
  {
    id: text().primaryKey(),
    identifier: text().notNull(),
    value: text().notNull(),
    expiresAt: integer({ mode: "timestamp_ms" }).notNull(),
    createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
    updatedAt: integer({ mode: "timestamp_ms" })
      .notNull()
      .$defaultFn(() => new Date())
      .$onUpdate(() => new Date()),
  },
  (t) => [index("verification_identifier_idx").on(t.identifier)],
);

export const auditLog = sqliteTable(
  "audit_log",
  {
    id: integer().primaryKey({ autoIncrement: true }),
    at: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
    trace: text(),
    /** A user's id, a key's name, "visitor", or "the app" for its own work. */
    who: text().notNull(),
    role: text(),
    address: text(),
    browser: text(),
    /** created, changed, deleted, copied, or an action's name. */
    action: text().notNull(),
    model: text(),
    recordId: integer(),
    title: text(),
    fields: text({ mode: "json" }).$type<string[]>(),
    details: text({ mode: "json" }).$type<Record<string, unknown>>(),
  },
  (t) => [index("audit_log_at").on(t.at), index("audit_log_record").on(t.model, t.recordId)],
);

export const fileReviews = sqliteTable(
  "file_reviews",
  {
    id: integer().primaryKey({ autoIncrement: true }),
    model: text().notNull(),
    recordId: integer().notNull(),
    field: text().notNull(),
    /** The stored file's name under uploads/ (src/kit/uploads.ts). */
    file: text().notNull(),
    /** pending, approved or rejected. */
    state: text().notNull().default("pending"),
    /** Why it was rejected, shown to the uploader on the record. */
    reason: text(),
    uploadedBy: text(),
    uploadedAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
    decidedBy: text(),
    decidedAt: integer({ mode: "timestamp_ms" }),
  },
  (t) => [
    index("file_reviews_record").on(t.model, t.recordId, t.state),
    index("file_reviews_state").on(t.state, t.uploadedAt),
  ],
);

export const uploads = sqliteTable(
  "uploads",
  {
    id: integer().primaryKey({ autoIncrement: true }),
    /** The stored file's name under uploads/ (src/kit/uploads.ts). */
    file: text().notNull(),
    model: text().notNull(),
    field: text().notNull(),
    /** Who uploaded it; nothing for a visitor. */
    uploader: text(),
    receipt: text().notNull(),
    at: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
  },
  (t) => [index("uploads_receipt").on(t.receipt), index("uploads_at").on(t.at)],
);

export const items = sqliteTable("items", {
  id: integer().primaryKey({ autoIncrement: true }),
  title: text().notNull(),
  photos: text({ mode: "json" }).$type<Picture[]>().notNull(),
  description: text().notNull(),
  price: integer(),
  category: text({ enum: ["furniture", "bikes", "electronics", "sports", "kids", "other"] }).notNull().default("furniture"),
  condition: text({ enum: ["likeNew", "good", "worn"] }).notNull().default("likeNew"),
  place: text(),
  available: integer({ mode: "boolean" }).default(true),
  ownerId: text().references(() => user.id, { onDelete: "set null" }),
  createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
  updatedAt: integer({ mode: "timestamp_ms" })
    .notNull()
    .$defaultFn(() => new Date())
    .$onUpdate(() => new Date()),
});

// The records people marked as favorites: each person's own, never shown to others.
export const itemsFavorites = sqliteTable(
  "items_favorites",
  {
    id: integer().primaryKey({ autoIncrement: true }),
    userId: text()
      .notNull()
      .references(() => user.id, { onDelete: "cascade" }),
    recordId: integer()
      .notNull()
      .references(() => items.id, { onDelete: "cascade" }),
    createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
  },
  (t) => [unique().on(t.userId, t.recordId)],
);
"
`;

exports[`../../../examples/marketplace/smithable.yml > file list and generated code > src/db/seed.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// Sample data for development. Run with \`pnpm db:seed\`; tables that already have rows are left alone.
import { db } from "./index";
import * as schema from "./schema";
import { samplePicture } from "#/kit/uploads";

if (db.select().from(schema.items).limit(1).all().length === 0) {
  db.insert(schema.items)
    .values([
    { title: "Item 1", photos: [samplePicture("item", 0, "A picture of Item 1")].filter((p) => p !== null), description: "A short description of Item 1.", price: 12000, category: "furniture", condition: "likeNew", place: "place 1", available: false },
    { title: "Item 2", photos: [samplePicture("item", 1, "A picture of Item 2"), samplePicture("item", 2, "A picture of Item 2")].filter((p) => p !== null), description: "A short description of Item 2.", price: 48000, category: "bikes", condition: "good", place: "place 2", available: true },
    { title: "Item 3", photos: [samplePicture("item", 2, "A picture of Item 3"), samplePicture("item", 0, "A picture of Item 3"), samplePicture("item", 1, "A picture of Item 3")].filter((p) => p !== null), description: "A short description of Item 3.", price: 125000, category: "electronics", condition: "worn", place: "place 3", available: true },
    { title: "Item 4", photos: [samplePicture("item", 0, "A picture of Item 4")].filter((p) => p !== null), description: "A short description of Item 4.", price: 230000, category: "sports", condition: "likeNew", place: "place 4", available: false },
