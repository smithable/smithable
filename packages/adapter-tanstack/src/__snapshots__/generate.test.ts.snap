/** What a incident update may be given: a form's values and what the app fills (an action's set). */
export const incidentUpdateSettable = createInsertSchema(schema.incidentUpdates, {
  message: (s) => s.trim().min(1, w.required).max(10000, w.atMostCharacters(10000)),
}).omit({ id: true, ownerId: true, createdAt: true, updatedAt: true });
/** What a incident update's form sends, checked. */
