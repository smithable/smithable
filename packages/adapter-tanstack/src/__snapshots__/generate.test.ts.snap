exports[`../../../examples/crm/smithable.yml > file list and generated code > src/routes/customers/index.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, Link, useNavigate, useRouter } from "@tanstack/react-router";
import { pageAccess } from "#/generated/pages";
import { guardPage, allows } from "#/kit/access";
import { createServerFn } from "@tanstack/react-start";
import * as schema from "#/db/schema";
import { customerAccess, customerData } from "#/generated/customer.server";
import { contains } from "#/kit/search";
import { currentViewer } from "#/lib/viewer.server";
import { type Search, count, listQuery, optional, text } from "#/kit/params";
import { buttonVariants } from "#/components/ui/button";
import { mergeCustomersAccess } from "#/generated/actions/merge-customers";
import { TrashNotice } from "#/kit/Trash";
import { restoreCustomers, deleteCustomers, customerDeleteRule, customerUi } from "#/generated/customer";
import { useState } from "react";
import { SelectionBar } from "#/kit/SelectionBar";
import { csvName, csvOf, download } from "#/kit/csv";
import { app } from "#/generated/app";
import { w } from "#/kit/words";
import { PageHeader } from "#/kit/AppShell";
import { ModelTable } from "#/kit/ModelTable";
import { SearchBox } from "#/kit/SearchBox";

/** The customers matching the search, among those the viewer may read. */
const searchCustomers = createServerFn()
  .validator(listQuery)
  .handler(async ({ data }) => {
    const viewer = await currentViewer();
    const where = data.q ? contains([schema.customers.name, schema.customers.email], data.q) : undefined;
    return { ...(await customerData.page(viewer, where, undefined, data.all ? 1 : data.page, data.all ? (viewer ? 10000 : 500) : undefined)), canCreate: allows(customerAccess.create, viewer) };
  });

export const Route = createFileRoute("/customers/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["customers"], context.viewer, location.href),
  head: () => ({ meta: [{"title":"Customers · Acme CRM"}] }),
  validateSearch: (s: Search) => optional({ q: text(s.q), page: count(s.page) }),
  loaderDeps: ({ search }) => ({ q: search.q, page: search.page }),
  loader: ({ deps }) => searchCustomers({ data: { q: deps.q, page: deps.page } }),
  // While a search loads, the page stays (and the box keeps its focus and text), never the
  // placeholder; coming back loads afresh instead of showing rows from before a change.
  pendingMs: Number.POSITIVE_INFINITY,
  gcTime: 0,
  component: CustomersPage,
});

function CustomersPage() {
  const { rows, canCreate, total, page: at, size } = Route.useLoaderData();
  const { q } = Route.useSearch();
  const { viewer } = Route.useRouteContext();
  const navigate = useNavigate({ from: "/customers/" });
  const router = useRouter();
  // The chosen rows, offered when the viewer may do something to at least one row.
  const [selected, setSelected] = useState<Set<number>>(new Set());
  const chosen = rows.filter((row) => selected.has(row.id));
  const selectable = rows.some((row) => allows(customerDeleteRule, viewer, row.accountManagerId));
  const newButton = canCreate && (
    <Link to="/customers/new" className={buttonVariants()}>
      {w.newOne("customer")}
    </Link>
  );
  const mergeCustomersButton = allows(mergeCustomersAccess, viewer) && (
    <Link to="/customers/actions/merge-customers" className={buttonVariants({ variant: "outline" })}>
      Merge customers
    </Link>
  );
  return (
    <>
      <PageHeader
        page="customers"
        title="Customers"
        actions={<>{mergeCustomersButton}{newButton}</>}
      />
      <SearchBox
        value={q ?? ""}
        placeholder="Search by name or email"
        onSearch={(text) => navigate({ to: "/customers", search: { q: text || undefined }, replace: true, resetScroll: false })}
      />
      {selectable && (
        <SelectionBar
          count={chosen.length}
          noun={["customer", "customers"]}
          app={app}
          titleOf={(id) => String(rows.find((row) => row.id === id)?.name ?? id)}
          actions={[]}
          deletable={chosen.filter((row) => allows(customerDeleteRule, viewer, row.accountManagerId)).length}
          onDelete={(together) => deleteCustomers({ data: { ids: chosen.map((row) => row.id), together } })}
          trash
          onDone={async () => {
            setSelected(new Set());
            await router.invalidate();
          }}
          onExport={() => download(csvName(customerUi), csvOf(customerUi, chosen))}
        />
      )}
      <TrashNotice
        model="Customer"
        onUndo={async (id) => {
          await restoreCustomers({ data: [id] });
          await router.invalidate();
        }}
      />
      <ModelTable
        ui={customerUi}
        page="customers"
        paging={{ page: at, size, total, to: (next) => navigate({ to: "/customers", search: (prev) => ({ ...prev, page: next > 1 ? next : undefined }) }) }}
        app={app}
        exportRows={async () => (await searchCustomers({ data: { q, all: true } })).rows}
        rows={rows}
        selection={selectable ? { ids: selected, onChange: setSelected } : undefined}
        emptyMessage={q ? \`No customers match “\${q}”.\` : undefined}
        emptyAction={newButton || undefined}
        onOpen={(row) => navigate({ to: "/customers/$id", params: { id: String(row.id) } })}
      />
      {viewer && (
        <p className="pt-2 text-right text-sm">
          <Link to="/customers/trash" className="text-muted-foreground hover:underline">
            {w.trashView}
          </Link>
        </p>
      )}
    </>
  );
}
"
`;

