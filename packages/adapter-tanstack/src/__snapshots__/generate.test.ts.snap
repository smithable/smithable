exports[`../../../examples/api/smithable.yml > file list and generated code > src/generated/hooks.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// Where the app reacts to changes: after a record is created, changed or deleted, and once a
// day. Your reactions go in src/custom/hooks.ts (send an email, update another record, call a
// service); a plugin's in its own hooks file. A hook runs on the server, in the request that
// made the change and with the viewer who made it, after the change is saved; a hook that
// throws fails that request. Daily jobs run in production, a day after the server started.
import type * as schema from "#/db/schema";
import type { Viewer } from "#/kit/access";
import { log } from "#/kit/log.server";
import * as custom from "#/custom/hooks";

export type Hook<Row> = (row: Row, viewer: Viewer | null) => void | Promise<void>;

/** Each model's record as it is stored. */
export interface Rows {
  Project: typeof schema.projects.$inferSelect;
  Task: typeof schema.tasks.$inferSelect;
  Note: typeof schema.notes.$inferSelect;
}

export interface Hooks {
  /** After a record is created, by model. */
  afterCreate?: { [M in keyof Rows]?: Hook<Rows[M]> };
  /** After a record is changed, with its new values. */
  afterUpdate?: { [M in keyof Rows]?: Hook<Rows[M]> };
  /** After a record is deleted; only its id is left. */
  afterDelete?: { [M in keyof Rows]?: Hook<{ id: number }> };
  /** Once a day. */
  daily?: (() => void | Promise<void>)[];
}

// Read when a hook runs, not when this module loads: custom code may import the data functions,
// which import this file.
const sources = (): Hooks[] => [custom.hooks];

export async function afterChange<M extends keyof Rows>(
  event: "afterCreate" | "afterUpdate",
  model: M,
  row: Rows[M],
  viewer: Viewer | null,
): Promise<void> {
  for (const source of sources()) {
    // One model's hook at a time: TypeScript cannot narrow the lookup by a generic key.
    const hook = source[event]?.[model] as Hook<Rows[M]> | undefined;
    await hook?.(row, viewer);
  }
}

export async function afterDelete<M extends keyof Rows>(
  model: M,
  id: number,
  viewer: Viewer | null,
): Promise<void> {
  for (const source of sources()) {
    const hook = source.afterDelete?.[model] as Hook<{ id: number }> | undefined;
    await hook?.({ id }, viewer);
  }
}

/** Every daily job, in order; a failing one is reported and the rest still run. */
export async function runDaily(): Promise<void> {
  for (const source of sources())
    for (const job of source.daily ?? []) {
      try {
        await job();
      } catch (error) {
        log.error("A daily job failed", { error });
      }
    }
}

// In production, once a day, starting a day after the server started (pnpm start). The timer
// never keeps the process alive by itself, so the server still stops when asked to.
if (import.meta.env.SSR && import.meta.env.PROD) {
  const day = 24 * 60 * 60 * 1000;
  const tick = () => setTimeout(() => runDaily().finally(tick), day).unref();
  tick();
}
"
`;

exports[`../../../examples/api/smithable.yml > file list and generated code > src/generated/keys.server.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// Keys for the API (docs/design/integrations.md §2). Server-only. A key is a role, not a person:
// what it creates has no owner, and the audit log names it by its name.
import { createHash, randomBytes } from "node:crypto";
import { and, desc, eq, gt, isNull, or } from "drizzle-orm";
import { db } from "#/db";
import { apiKey } from "#/db/schema";
import { AccessDenied, personOf, type Viewer } from "#/kit/access";
import { audit } from "#/kit/audit.server";

export const KEY_ROLES = ["admin", "member", "assistant"] as const;

const hash = (key: string) => createHash("sha256").update(key).digest("hex");

/** An administrator, a person: a key with the admin role never makes or revokes keys. */
function admin(viewer: Viewer | null): Viewer {
  if (viewer?.role !== "admin" || !personOf(viewer)) throw new AccessDenied(viewer !== null);
  return viewer;
}

/** The keys, newest first: what they are for, their role, when they end and were last used. */
export function listKeys(viewer: Viewer | null) {
  admin(viewer);
  return db
    .select({
      id: apiKey.id,
      name: apiKey.name,
      role: apiKey.role,
      prefix: apiKey.prefix,
      expiresAt: apiKey.expiresAt,
      lastUsedAt: apiKey.lastUsedAt,
      revokedAt: apiKey.revokedAt,
      createdAt: apiKey.createdAt,
    })
    .from(apiKey)
    .orderBy(desc(apiKey.id))
    .all();
}

/** Makes a key and returns it: the only time it is shown. */
export function makeKey(
  viewer: Viewer | null,
  name: string,
  role: (typeof KEY_ROLES)[number],
  until?: Date,
): string {
  const by = admin(viewer);
  if (until && until.getTime() < Date.now()) throw new Error("The end date is in the past.");
  const key = \`smk_\${randomBytes(24).toString("base64url")}\`;
  db.transaction((tx) => {
    tx.insert(apiKey)
      .values({ name: name.trim(), role, hash: hash(key), prefix: key.slice(0, 10), expiresAt: until, createdById: by.id })
      .run();
    // What touches security keeps its values (never the key): its name, role and end.
    audit(tx, by, { action: "key made", details: { name: name.trim(), role, until: until?.toISOString().slice(0, 10) ?? "none" } });
  });
  return key;
}

/** Revokes a key: it stops working at once. */
export function revokeKey(viewer: Viewer | null, id: number): void {
  const by = admin(viewer);
  db.transaction((tx) => {
    const revoked = tx
      .update(apiKey)
      .set({ revokedAt: new Date() })
      .where(and(eq(apiKey.id, id), isNull(apiKey.revokedAt)))
      .returning()
      .get();
    if (revoked) audit(tx, by, { action: "key revoked", details: { name: revoked.name, role: revoked.role } });
  });
}

/**
 * The caller a request's key stands for (\\\`Authorization: Bearer smk_…\\\`), or null: a key not
 * revoked and not past its end. Its id is "key:<n>", so nothing it does is anyone's own.
 */
export function keyViewer(authorization: string | null | undefined): Viewer | null {
  const key = /^Bearer (smk_[A-Za-z0-9_-]+)$/.exec(authorization ?? "")?.[1];
  if (!key) return null;
  const found = db
    .select()
    .from(apiKey)
    .where(
      and(
        eq(apiKey.hash, hash(key)),
        isNull(apiKey.revokedAt),
        or(isNull(apiKey.expiresAt), gt(apiKey.expiresAt, new Date())),
      ),
    )
    .get();
  if (!found) return null;
  db.update(apiKey).set({ lastUsedAt: new Date() }).where(eq(apiKey.id, found.id)).run();
  return { id: \`key:\${found.id}\`, name: found.name, email: "", role: found.role };
}
"
`;

exports[`../../../examples/api/smithable.yml > file list and generated code > src/generated/keys.test.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// A key's life: made by an administrator, standing for its role, revoked or past its end.
import { eq } from "drizzle-orm";
import { expect, test } from "vitest";
import { db } from "#/db";
import { apiKey, auditLog, user } from "#/db/schema";
import { AccessDenied } from "#/kit/access";
import { keyViewer, listKeys, makeKey, revokeKey } from "./keys.server";
import { removeUser } from "./users.server";

const admin = { id: "keys-test-admin", name: "Keys test admin", email: "keys-test-admin@example.com", role: "admin" };

test("an administrator makes a key; it stands for its role until revoked or past its end", async () => {
  const key = makeKey(admin, "Billing sync", "member");
  expect(key).toMatch(/^smk_/);
  expect(keyViewer(\`Bearer \${key}\`)).toMatchObject({ id: expect.stringMatching(/^key:/), name: "Billing sync", role: "member" });
  // Stored as a hash: the key itself is nowhere, not in the table and not in the audit log.
  expect(JSON.stringify(db.select().from(apiKey).all())).not.toContain(key);
  expect(JSON.stringify(db.select().from(auditLog).all())).not.toContain(key);
  const made = listKeys(admin).find((k) => k.name === "Billing sync");
  expect(made?.lastUsedAt).toBeInstanceOf(Date);
  revokeKey(admin, made?.id ?? 0);
  expect(keyViewer(\`Bearer \${key}\`)).toBeNull();
  // A key cannot be made already ended; one whose end has passed stops working.
  expect(() => makeKey(admin, "Ended", "member", new Date(Date.now() - 1000))).toThrow("The end date is in the past.");
  const old = makeKey(admin, "Old", "member", new Date(Date.now() + 1000));
  db.update(apiKey).set({ expiresAt: new Date(Date.now() - 1000) }).where(eq(apiKey.name, "Old")).run();
  expect(keyViewer(\`Bearer \${old}\`)).toBeNull();
  expect(keyViewer("Bearer smk_madeup")).toBeNull();
  expect(keyViewer(null)).toBeNull();
  expect(() => makeKey({ ...admin, id: "keys-test-other", role: "member" }, "Mine", "member")).toThrow(AccessDenied);
  // A key cannot make keys, whatever its role.
  const adminKey = makeKey(admin, "Admin key", "admin");
  expect(() => makeKey(keyViewer(\`Bearer \${adminKey}\`), "Minted", "admin")).toThrow(AccessDenied);
  revokeKey(admin, listKeys(admin).find((k) => k.name === "Admin key")?.id ?? 0);
  // A key goes with the person who made it.
  const maker = { id: "keys-test-maker", name: "Maker", email: "keys-test-maker@example.com", role: "admin" };
  db.insert(user).values(maker).run();
  const theirs = makeKey(maker, "Theirs", "member");
  await removeUser(admin, maker.id);
  expect(keyViewer(\`Bearer \${theirs}\`)).toBeNull();
  // What touches security keeps its values: the key's name and role, never the key.
  const lines = db.select().from(auditLog).all().filter((l) => l.action.startsWith("key "));
  expect(lines.map((l) => [l.action, l.who, l.details?.name])).toEqual([
    ["key made", admin.id, "Billing sync"],
    ["key revoked", admin.id, "Billing sync"],
    ["key made", admin.id, "Old"],
    ["key made", admin.id, "Admin key"],
    ["key revoked", admin.id, "Admin key"],
    ["key made", maker.id, "Theirs"],
    ["key revoked", admin.id, "Theirs"],
  ]);
});
"
`;

exports[`../../../examples/api/smithable.yml > file list and generated code > src/generated/mcp.server.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// The app's records and actions as tools for AI assistants (docs/design/assistant.md §3): seven
// tools whatever the app's size, and the app's summary as the server's instructions, both as core
// describes them for each caller; every call goes through the data functions, as the API's do.
import { AccessDenied, type Viewer } from "#/kit/access";
import { BadInput, NotFound } from "#/kit/refusal";
import type { Offer } from "#/kit/tools";
import { noteFromApi, noteToApi, projectFromApi, projectToApi, taskFromApi, taskToApi } from "./api.server";
import { projectData } from "./project.server";
import { taskData } from "./task.server";
import { noteData } from "./note.server";
import { runComplete } from "./actions/complete.server";
import { runReopen } from "./actions/reopen.server";


/**
 * What each caller is offered (by the key's role, and for a visitor without a key): the tools,
 * the summary, and what describe answers per kind, as that caller may use it.
 */
const OFFERS: Record<string, Offer & { describe: Record<string, string> }> = {
  "admin": {
    "summary": "Team Tasks: Tasks and notes, grouped in projects, that an AI assistant keeps for a small team.\\nProject (projects): name*, description. Title: name.\\nTask (tasks): title*, project* -> Project, status* (todo | doing | done), dueDate (date), assignee -> User, details. Title: title.\\nNote (notes): title*, project* -> Project, body, attachment (document). Title: title.\\nActions: complete (Task, when status is todo or doing), reopen (Task, when status is done).\\n* required. You act as someone with the role admin.",
    "tools": [
      {
        "name": "find",
        "description": "Records of one kind the caller may read, newest first, as {columns, rows, total}. Ask only for the fields needed; id and title always come.",
        "inputSchema": {
          "type": "object",
          "required": [
            "kind"
