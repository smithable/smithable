exports[`../../../examples/invoicing/smithable.yml > file list and generated code > src/routes/invoices/$id.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, Link, notFound, useNavigate, useRouter } from "@tanstack/react-router";
import { createServerFn } from "@tanstack/react-start";
import { and, desc, eq } from "drizzle-orm";
import { db } from "#/db";
import { auditLog, user } from "#/db/schema";
import { app } from "#/generated/app";
import { pageAccess } from "#/generated/pages";
import { deleteInvoice, getInvoice, invoiceUi, updateInvoice } from "#/generated/invoice";
import { invoiceSchema } from "#/generated/invoice.schema";
import { markSent, markSentAccess, markSentFits } from "#/generated/actions/mark-sent";
import { markPaid, markPaidAccess, markPaidFits } from "#/generated/actions/mark-paid";
import { buttonVariants } from "#/components/ui/button";
import { invoiceLineUi } from "#/generated/invoice-line";
import { clientOptions } from "#/generated/client";
import { allows, guardPage } from "#/kit/access";
import { ActionButton } from "#/kit/ActionButton";
import { ActivityLog } from "#/kit/ActivityLog";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";
import { w } from "#/kit/words";
import { currentViewer } from "#/lib/viewer.server";
import { ModelTable } from "#/kit/ModelTable";

/** The record's lines in the audit log, newest first: administrators only, nobody else. */
const getHistory = createServerFn()
  .validator((id: number) => id)
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    if (viewer?.role !== "admin") return null;
    const people = new Map(db.select({ id: user.id, name: user.name }).from(user).all().map((p) => [p.id, p.name]));
    return db
      .select()
      .from(auditLog)
      .where(and(eq(auditLog.model, "Invoice"), eq(auditLog.recordId, id)))
      .orderBy(desc(auditLog.id))
      .limit(50)
      .all()
      .map((r) => ({
        id: r.id,
        at: r.at,
        who: r.who === "visitor" || r.who === "the app" ? r.who : (people.get(r.who) ?? (r.who.startsWith("key:") ? w.aKey(r.who.slice(4)) : w.aRemovedUser(r.who))),
        action: r.action,
        fields: r.fields,
        details: r.details ? Object.fromEntries(Object.entries(r.details).map(([k, v]) => [k, String(v)])) : null,
      }));
  });

export const Route = createFileRoute("/invoices/$id")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["invoices"], context.viewer, location.href),
  head: () => ({ meta: [{"title":"Invoices · Invoicely"}] }),
  loader: async ({ params }) => {
    const found = await getInvoice({ data: Number(params.id) });
    if (!found) throw notFound();
    return { ...found, options: { clientId: await clientOptions() }, history: await getHistory({ data: Number(params.id) }) };
  },
  component: InvoicePage,
});

function InvoicePage() {
  const { row, canWrite, canDelete, canAdd, options, history } = Route.useLoaderData();
  const { viewer } = Route.useRouteContext();
  const navigate = useNavigate();
  const router = useRouter();
  const back = () => navigate({ to: "/invoices" });
  return (
    <>
      <PageHeader
        title={row.number || \`Invoice #\${row.id}\`}
        actions={
          <>
            {allows(markSentAccess, viewer, row.ownerId) && markSentFits(row) && (
              <ActionButton
                label="Mark sent"
                concept="action:markSent"
                onRun={async () => {
                  await markSent({ data: row.id });
                  await router.invalidate();
                }}
              />
            )}
            {allows(markPaidAccess, viewer, row.ownerId) && markPaidFits(row) && (
              <ActionButton
                label="Mark paid"
                concept="action:markPaid"
                onRun={async () => {
                  await markPaid({ data: row.id });
                  await router.invalidate();
                }}
              />
            )}
          </>
        }
      />
      <ModelForm
        key={String(row.updatedAt)}
        ui={invoiceUi}
        app={app}
        schema={invoiceSchema}
        initial={row}
        readOnly={!canWrite}
        options={options}
        submitLabel={w.saveChanges}
        onSubmit={async (values) => {
          await updateInvoice({ data: { id: row.id, values } });
          await back();
        }}
        onCancel={back}
        onDelete={
          canDelete
            ? async (together?: boolean) => {
                await deleteInvoice({ data: { id: row.id, together } });
                await back();
              }
            : undefined
        }
      />
      <section className="mt-10">
        <div className="mb-3 flex items-center justify-between gap-3">
          <h2 className="text-lg font-semibold">Lines</h2>
          {row.lines.length > 0 && canAdd?.lines && (
              <Link to="/invoice-lines/new" search={{ invoice: row.id }} className={buttonVariants({ variant: "outline" })}>
                {w.addOne("invoice line")}
              </Link>
            )}
        </div>
        <ModelTable
          ui={invoiceLineUi}
          app={app}
          rows={row.lines}
          hide={["invoiceId"]}
          onOpen={(item) => navigate({ to: "/invoice-lines/$id", params: { id: String(item.id) } })}
          emptyAction={canAdd?.lines && (
              <Link to="/invoice-lines/new" search={{ invoice: row.id }} className={buttonVariants({ variant: "outline" })}>
                {w.addOne("invoice line")}
              </Link>
            )}
          emptyMessage={canAdd?.lines ? undefined : w.noneYet("invoice lines")}
        />
      </section>
      {history && history.length > 0 && (
        <section className="mt-10 max-w-3xl">
          <h2 className="mb-3 text-lg font-semibold">{w.history}</h2>
          <ActivityLog lines={history} app={app} />
        </section>
      )}
    </>
  );
}
"
`;

exports[`../../../examples/invoicing/smithable.yml > file list and generated code > src/routes/invoices/index.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, Link, useNavigate, useRouter } from "@tanstack/react-router";
import { pageAccess } from "#/generated/pages";
import { guardPage, allows } from "#/kit/access";
import { createServerFn } from "@tanstack/react-start";
import * as schema from "#/db/schema";
import { invoiceAccess, invoiceData } from "#/generated/invoice.server";
import { inArray, and } from "drizzle-orm";
import { clientData } from "#/generated/client.server";
import { currentViewer } from "#/lib/viewer.server";
import { type Search, count, listQuery, optional, text } from "#/kit/params";
import { buttonVariants } from "#/components/ui/button";
import { markSent, markSentAccess, markSentFits, markSentMany } from "#/generated/actions/mark-sent";
import { markPaid, markPaidAccess, markPaidFits, markPaidMany } from "#/generated/actions/mark-paid";
import { ActionButton } from "#/kit/ActionButton";
import { useState } from "react";
import { SelectionBar } from "#/kit/SelectionBar";
import { csvName, csvOf, download } from "#/kit/csv";
import { deleteInvoices, invoiceDeleteRule, invoiceUi } from "#/generated/invoice";
import { app } from "#/generated/app";
import { w } from "#/kit/words";
import { PageHeader } from "#/kit/AppShell";
import { ModelTable } from "#/kit/ModelTable";
import { Filters } from "#/kit/Filters";

/** The invoices matching the search and the filters, among those the viewer may read. */
const searchInvoices = createServerFn()
  .validator(listQuery)
  .handler(async ({ data }) => {
    const viewer = await currentViewer();
    const where = and(
      undefined,
      data.f?.client ? inArray(schema.invoices.clientId, data.f?.client.split(",").map(Number).filter(Number.isInteger)) : undefined,
      data.f?.status ? inArray(schema.invoices.status, data.f?.status.split(",").filter((v) => ["draft", "sent", "paid", "overdue"].includes(v)) as ("draft" | "sent" | "paid" | "overdue")[]) : undefined,
    );
    return {
      ...(await invoiceData.page(viewer, where, undefined, data.all ? 1 : data.page, data.all ? (viewer ? 10000 : 500) : undefined)),
      canCreate: allows(invoiceAccess.create, viewer),
      options: { client: (await clientData.list(viewer)).map((r) => ({ value: String(r.id), label: String(r.name) })) },
    };
  });

export const Route = createFileRoute("/invoices/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["invoices"], context.viewer, location.href),
  head: () => ({ meta: [{"title":"Invoices · Invoicely"}] }),
  validateSearch: (s: Search) => optional({ q: text(s.q), sort: text(s.sort), client: text(s.client), status: text(s.status), page: count(s.page) }),
  loaderDeps: ({ search }) => search,
  loader: ({ deps: { q, sort, page, ...f } }) => searchInvoices({ data: { q, sort, f, page } }),
  // While a search or filter loads, the page stays (and its controls keep their focus).
  pendingMs: Number.POSITIVE_INFINITY,
  gcTime: 0,
  component: InvoicesPage,
});

function InvoicesPage() {
  const { rows, canCreate, total, page: at, size, options } = Route.useLoaderData();
  const { q, sort, page: _page, ...values } = Route.useSearch();
  const { viewer } = Route.useRouteContext();
  const navigate = useNavigate({ from: "/invoices/" });
  const router = useRouter();
  // The chosen rows, offered when the viewer may do something to at least one row.
  const [selected, setSelected] = useState<Set<number>>(new Set());
  const chosen = rows.filter((row) => selected.has(row.id));
  const selectable = rows.some((row) => allows(markSentAccess, viewer, row.ownerId) && markSentFits(row) || allows(markPaidAccess, viewer, row.ownerId) && markPaidFits(row) || allows(invoiceDeleteRule, viewer, row.ownerId));
  const newButton = canCreate && (
    <Link to="/invoices/new" className={buttonVariants()}>
      {w.newOne("invoice")}
    </Link>
  );
  return (
    <>
      <PageHeader
        page="invoices"
        title="Invoices"
        actions={newButton}
      />
      <Filters
        filters={[
  { name: "client", label: "Client", kind: "chips", options: options.client },
  {
    name: "status",
    label: "Status",
    kind: "chips",
    options: [
      { value: "draft", label: "Draft" },
      { value: "sent", label: "Sent" },
      { value: "paid", label: "Paid" },
      { value: "overdue", label: "Overdue" },
    ],
  },
]}
        values={values}
        onChange={(next) => navigate({ to: "/invoices", search: { q, ...next }, replace: true, resetScroll: false })}
      />
      {selectable && (
        <SelectionBar
          count={chosen.length}
          noun={["invoice", "invoices"]}
          app={app}
          titleOf={(id) => String(rows.find((row) => row.id === id)?.number ?? id)}
          actions={[
            {
              label: "Mark sent",
              concept: "action:markSent",
              applies: chosen.filter((row) => allows(markSentAccess, viewer, row.ownerId) && markSentFits(row)).length,
              run: () => markSentMany({ data: { ids: chosen.map((row) => row.id) } }),
            },
            {
              label: "Mark paid",
              concept: "action:markPaid",
              applies: chosen.filter((row) => allows(markPaidAccess, viewer, row.ownerId) && markPaidFits(row)).length,
              run: () => markPaidMany({ data: { ids: chosen.map((row) => row.id) } }),
            },
          ]}
          deletable={chosen.filter((row) => allows(invoiceDeleteRule, viewer, row.ownerId)).length}
          onDelete={(together) => deleteInvoices({ data: { ids: chosen.map((row) => row.id), together } })}
          onDone={async () => {
            setSelected(new Set());
            await router.invalidate();
          }}
          onExport={() => download(csvName(invoiceUi), csvOf(invoiceUi, chosen))}
        />
      )}
      <ModelTable
        ui={invoiceUi}
        page="invoices"
        paging={{ page: at, size, total, to: (next) => navigate({ to: "/invoices", search: (prev) => ({ ...prev, page: next > 1 ? next : undefined }) }) }}
        app={app}
        exportRows={async () => (await searchInvoices({ data: { q, sort, f: values, all: true } })).rows}
        rows={rows}
        selection={selectable ? { ids: selected, onChange: setSelected } : undefined}
        rowActions={(row) => (
          <>
            {allows(markSentAccess, viewer, row.ownerId) && markSentFits(row) && (
              <ActionButton
                label="Mark sent"
                concept="action:markSent"
                onRun={async () => {
                  await markSent({ data: row.id });
                  await router.invalidate();
                }}
              />
            )}
            {allows(markPaidAccess, viewer, row.ownerId) && markPaidFits(row) && (
              <ActionButton
                label="Mark paid"
                concept="action:markPaid"
                onRun={async () => {
                  await markPaid({ data: row.id });
                  await router.invalidate();
                }}
              />
            )}
          </>
        )}
        emptyMessage={q || Object.values(values).some(Boolean) ? "No invoices match the search and filters." : undefined}
        emptyAction={newButton || undefined}
        onOpen={(row) => navigate({ to: "/invoices/$id", params: { id: String(row.id) } })}
      />
    </>
  );
}
"
`;

exports[`../../../examples/invoicing/smithable.yml > file list and generated code > src/routes/invoices/new.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, useNavigate } from "@tanstack/react-router";
import { app } from "#/generated/app";
import { pageAccess } from "#/generated/pages";
import { createInvoice, invoiceUi } from "#/generated/invoice";
import { invoiceSchema } from "#/generated/invoice.schema";
import { clientOptions } from "#/generated/client";
import { guardPage } from "#/kit/access";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";
import { w } from "#/kit/words";
import { count, optional, type Search } from "#/kit/params";

export const Route = createFileRoute("/invoices/new")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["invoices"], context.viewer, location.href),
  head: () => ({ meta: [{"title":"Invoices · Invoicely"}] }),
  validateSearch: (s: Search) => optional({ client: count(s.client) }),
  loader: async () => ({ options: { clientId: await clientOptions() } }),
  component: NewInvoicePage,
});

function NewInvoicePage() {
  const { options } = Route.useLoaderData();
  const search = Route.useSearch();
  const navigate = useNavigate();
  const back = () => search.client ? navigate({ to: "/clients/$id", params: { id: String(search.client) } }) : navigate({ to: "/invoices" });
  return (
    <>
      <PageHeader title={w.newOne("invoice")} />
      <ModelForm
        ui={invoiceUi}
        app={app}
        schema={invoiceSchema}
        preset={{ ...(search.client ? { clientId: search.client } : {}) }}
        fixed={[...(search.client ? ["clientId"] : [])]}
        options={options}
        submitLabel={w.createOne("invoice")}
        onSubmit={async (values) => {
          await createInvoice({ data: values });
          await back();
        }}
        onCancel={back}
      />
    </>
  );
}
"
`;

exports[`../../../examples/invoicing/smithable.yml > file list and generated code > src/routes/overview/index.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, useNavigate } from "@tanstack/react-router";
import { createServerFn } from "@tanstack/react-start";
import { pageAccess } from "#/generated/pages";
import { guardPage } from "#/kit/access";
import { currentViewer } from "#/lib/viewer.server";
import { invoiceData } from "#/generated/invoice.server";
import { sum, byMonth, latest } from "#/kit/aggregate";
import { app } from "#/generated/app";
import { PageHeader } from "#/kit/AppShell";
import { StatCard, formatNumber, BarChart } from "#/kit/Dashboard";
import { invoiceUi } from "#/generated/invoice";
import { ModelTable } from "#/kit/ModelTable";

const getOverview = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  const invoices = await invoiceData.list(viewer);
  return {
    outstanding: sum(invoices.filter((row) => row.status === "sent"), (row) => row.total),
    overdue: sum(invoices.filter((row) => row.status === "overdue"), (row) => row.total),
    paid: sum(invoices.filter((row) => row.status === "paid"), (row) => row.total),
    invoiced: byMonth(invoices, (row) => row.issuedOn, (row) => Number(row.total) || 0),
    latest: latest(invoices, 5),
  };
});

export const Route = createFileRoute("/overview/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["overview"], context.viewer, location.href),
  head: () => ({ meta: [{"title":"Overview · Invoicely"}] }),
  loader: () => getOverview(),
  component: OverviewPage,
});

function OverviewPage() {
  const data = Route.useLoaderData();
  const navigate = useNavigate();
  return (
    <>
      <PageHeader page="overview" title="Overview" />
      <div data-kit="dashboard" className="space-y-6">
      <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <StatCard label="Outstanding" value={formatNumber("money", data.outstanding, app)} />
        <StatCard label="Overdue" value={formatNumber("money", data.overdue, app)} />
        <StatCard label="Paid" value={formatNumber("money", data.paid, app)} />
      </div>
      <BarChart label="Invoiced" kind="money" app={app} bars={data.invoiced} />
      <section aria-labelledby="latest-title" className="space-y-3">
        <h2 id="latest-title" className="font-semibold">Latest</h2>
        <ModelTable
          ui={invoiceUi}
          app={app}
          rows={data.latest}
          onOpen={(row) => navigate({ to: "/invoices/$id", params: { id: String(row.id) } })}
        />
      </section>
      </div>
    </>
  );
}
"
`;

