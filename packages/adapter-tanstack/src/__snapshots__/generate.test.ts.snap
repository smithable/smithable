"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { type AnyColumn, and, asc, avg, count, desc, eq, inArray, isNotNull, isNull, lt, max, min, sql, sum, type SQL } from "drizzle-orm";
import { db } from "#/db";
import * as schema from "#/db/schema";
import { AccessDenied, allows, check, Conflict, type ModelAccess, personOf, readScope, type Viewer } from "#/kit/access";
import { audit, changedFields } from "#/kit/audit.server";
import { refusal } from "#/kit/log.server";
import { contains } from "#/kit/search";
import { BadInput } from "#/kit/refusal";
import { aggregate, type Filterable, sortOf, whereOf, wordsOf } from "#/kit/where";
import { afterChange, afterDelete } from "./hooks";
import { customerData } from "./customer.server";
import type { OrderValues } from "./order";
import { withOrderFormulas } from "./order.formulas";
import "./trash.server";

/** A transaction, as the group's functions are called inside one (docs/design/delete-together.md). */
type Tx = Parameters<Parameters<typeof db.transaction>[0]>[0];

/** The record one went to the trash with, while it is still there: its label and title, by the mark ("Customer:12"). */
function rootInTrash(tag: string): string | undefined {
  const [model, id] = tag.split(":");
  switch (model) {
    case "Customer": {
      const root = db.select({ deletedAt: schema.customers.deletedAt, title: schema.customers.name }).from(schema.customers).where(eq(schema.customers.id, Number(id))).get();
      return root?.deletedAt ? \`Customer:\${String(root.title ?? id)}\` : undefined;
    }
    default:
      return undefined;
  }
}

/** Who may read, create, change and delete orders. */
export const orderAccess: ModelAccess = {
  read: { public: false, roles: ["admin", "sales"], owner: false },
  create: { public: false, roles: ["admin", "sales"], owner: false },
  write: { public: false, roles: ["admin", "sales"], owner: true },
  delete: { public: false, roles: ["admin"], owner: true },
};

/** A record as the viewer gets it: who owns it only for its owner and roles that read every record. */
function shownTo<R extends { ownerId: string | null }>(viewer: Viewer | null, row: R): R {
  if (viewer && (row.ownerId === viewer.id || orderAccess.read.roles.includes(viewer.role))) return row;
  return { ...row, ownerId: null };
}


/** What \`where\` may name, and how: the stored fields, by kind. */
const FILTERABLE: Record<string, Filterable> = {
  number: { kind: "text", column: schema.orders.number },
  customer: { kind: "reference", column: schema.orders.customerId, title: { table: schema.customers, column: schema.customers.name } },
  status: { kind: "choice", column: schema.orders.status, values: ["draft","placed","shipped","canceled"] },
  total: { kind: "money", column: schema.orders.total },
  shippingMethod: { kind: "choice", column: schema.orders.shippingMethod, values: ["standard","express"] },
  placedAt: { kind: "instant", column: schema.orders.placedAt },
};

/** What the records can be sorted by. */
const SORTABLE = { id: schema.orders.id, number: schema.orders.number, status: schema.orders.status, total: schema.orders.total, shippingMethod: schema.orders.shippingMethod, placedAt: schema.orders.placedAt, createdAt: schema.orders.createdAt };

/** The number fields \`measure\` adds up; amounts are stored in cents. */
const NUMBERS: Record<string, AnyColumn> = { total: schema.orders.total };
const MONEY: string[] = ["total","shippingCost"];

/** Computed number fields \`measure\` adds up from the records themselves. */
const COMPUTED: string[] = ["shippingCost"];

/** The titles of the referenced records \`measureBy\` splits by, to name its groups. */
function titlesOf(viewer: Viewer | null, by: string, ids: number[]): Map<unknown, string> {
  switch (by) {
    case "customer":
      return new Map(db.select({ id: schema.customers.id, title: schema.customers.name }).from(schema.customers).where(and(inArray(schema.customers.id, ids), customerData.readable(viewer))).all().map((r) => [r.id, String(r.title)]));
    default:
      return new Map();
  }
}

/** What \`measureBy\` may split by: choices, yes/no, references, and dates by month. */
const BY: string[] = ["customer","status","shippingMethod","placedAt"];


/** Checks that the viewer may read the records the values refer to. */
function checkReferences(viewer: Viewer | null, values: OrderValues): void {
  if (values.customerId != null && !customerData.canRead(viewer, values.customerId))
    throw new AccessDenied(viewer !== null);
}

/** How long a record stays in the trash, and the most a trash view shows. */
const TRASH_DAYS = 30;
const DAY = 24 * 60 * 60 * 1000;
/** \`rows\` with each \`field\` reference \`readable\` leaves out set to nothing (only its id stays). */
function hideRefs<R extends Record<string, unknown>>(rows: R[], field: string, readable: (ids: number[]) => number[]): R[] {
  const idOf = (row: R) => (row[field] as { id?: unknown } | null | undefined)?.id;
  const ids = [...new Set(rows.map(idOf).filter((id): id is number => typeof id === "number"))];
  if (!ids.length) return rows;
  const shown = new Set(readable(ids));
  return rows.map((row) => {
    const id = idOf(row);
    return typeof id === "number" && !shown.has(id) ? { ...row, [field]: null } : row;
  });
}

export const orderData = {
  shownTo,
  /** The rows with each reference to a record the viewer may not read set to nothing: a related record's title is shown only to who may read it (only its id stays). */
  shownRefs<R extends Record<string, unknown>>(viewer: Viewer | null, rows: R[]): R[] {
    return hideRefs(rows, "customer", (ids, c = customerData.readable(viewer)) => (c ? db.select({ id: schema.customers.id }).from(schema.customers).where(and(inArray(schema.customers.id, ids), c)).all().map((r) => r.id) : ids));
  },

  /** A condition for the orders the viewer may read. */
  readable(viewer: Viewer | null) {
    // What is in the trash is gone to every reader (docs/design/trash.md).
    return and(isNull(schema.orders.deletedAt), orderData.scoped(viewer));
  },

  /** The records the viewer may read by the read rule, the trashed ones too. */
  scoped(viewer: Viewer | null) {
    const scope = readScope(orderAccess.read, viewer);
    if (scope === "all") return undefined;
    return scope === "own" && viewer ? eq(schema.orders.ownerId, viewer.id) : sql\`false\`;
  },

  canRead(viewer: Viewer | null, id: number): boolean {
    const found = db
      .select({ id: schema.orders.id })
      .from(schema.orders)
      .where(and(eq(schema.orders.id, id), orderData.readable(viewer)))
      .get();
    return found !== undefined;
  },

  /** The orders the viewer may read; \`where\` narrows them, e.g. to a search. */
  async list(viewer: Viewer | null, where?: SQL) {
    if (readScope(orderAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const found = orderData.shownRefs(viewer, await db.query.orders.findMany({
      where: and(orderData.readable(viewer), where),
      with: { customer: { columns: { id: true, name: true, deletedAt: true } } },
      orderBy: (t, { desc }) => [desc(t.id)],
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return rows.map(withOrderFormulas);
  },

  /**
   * A page of the orders the viewer may read that fit \`where\`, newest first (or in
   * \`order\`), and how many fit in all: for a list page. A page past the end is the last one.
   */
  async page(viewer: Viewer | null, where?: SQL, order?: SQL, page = 1, size = 50) {
    if (readScope(orderAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = and(orderData.readable(viewer), where);
    const total = db.select({ n: count() }).from(schema.orders).where(condition).get()?.n ?? 0;
    const at = Math.min(Math.max(1, Math.trunc(page)), Math.max(1, Math.ceil(total / size)));
    const found = orderData.shownRefs(viewer, await db.query.orders.findMany({
      where: condition,
      with: { customer: { columns: { id: true, name: true, deletedAt: true } } },
      orderBy: (t, { desc }) => [...(order ? [order] : []), desc(t.id)],
      limit: size,
      offset: (at - 1) * size,
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return { rows: rows.map(withOrderFormulas), total, page: at, size };
  },

  /**
   * The orders the viewer may read that fit \`where\` and \`search\`, in \`sort\`'s order (else newest
   * first), a page of them and how many there are: for the API and the assistants' tools.
   */
  async find(
    viewer: Viewer | null,
    options: { where?: unknown; search?: string; sort?: string; limit?: number; offset?: number } = {},
  ) {
    if (readScope(orderAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = orderData.fitting(viewer, options.where, options.search);
    const order = sortOf(SORTABLE, options.sort);
    const total = db.select({ n: count() }).from(schema.orders).where(condition).get()?.n ?? 0;
    const found = orderData.shownRefs(viewer, await db.query.orders.findMany({
      where: condition,
      with: { customer: { columns: { id: true, name: true, deletedAt: true } } },
      orderBy: (t, { desc }) => [...(order ? [order] : []), desc(t.id)],
      limit: options.limit ?? 100,
      offset: options.offset ?? 0,
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return { items: rows.map(withOrderFormulas), total };
  },

  /**
   * A number from the orders the viewer may read that fit \`where\`: how many, or the sum,
   * average, smallest or largest of a number field.
   */
  async measure(
    viewer: Viewer | null,
    how: "count" | "sum" | "average" | "smallest" | "largest",
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<number | null> {
    if (readScope(orderAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = orderData.fitting(viewer, options.where, options.search);
    if (how === "count")
      return db.select({ n: count() }).from(schema.orders).where(condition).get()?.n ?? 0;
    const field = options.field ?? "";
    const money = MONEY.includes(field);
    if (COMPUTED.includes(field)) {
      const rows = await orderData.computedRows(condition);
      const value = aggregate(rows.map((row) => row[field]), how);
      return value === null ? null : money ? value / 100 : value;
    }
    const column = NUMBERS[field];
    if (!column)
      throw new BadInput(
        \`\${how} needs a number field: \${[...Object.keys(NUMBERS), ...COMPUTED].join(", ") || "there are none"}.\`,
      );
    const pick = { sum, average: avg, smallest: min, largest: max }[how];
    const value = db.select({ v: pick(column) }).from(schema.orders).where(condition).get()?.v;
    if (value === null || value === undefined) return null;
    return money ? Number(value) / 100 : Number(value);
  },

  /** Which record holds the smallest or largest value of a number field (the first of a tie). */
  async holder(
    viewer: Viewer | null,
    how: "smallest" | "largest",
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<{ id: number; title: string } | null> {
    const condition = orderData.fitting(viewer, options.where, options.search);
    const field = options.field ?? "";
    if (COMPUTED.includes(field)) {
      let best: Record<string, unknown> | undefined;
      for (const row of await orderData.computedRows(condition)) {
        const v = row[field];
        if (typeof v !== "number") continue;
        if (!best || (how === "largest" ? v > (best[field] as number) : v < (best[field] as number))) best = row;
      }
      return best ? { id: best.id as number, title: String(best.number) } : null;
    }
    const column = NUMBERS[field];
    if (!column) return null;
    const row = db
      .select({ id: schema.orders.id, title: schema.orders.number })
      .from(schema.orders)
      .where(and(condition, isNotNull(column)))
      .orderBy(how === "largest" ? desc(column) : asc(column), asc(schema.orders.id))
      .limit(1)
      .get();
    return row ? { id: row.id, title: String(row.title) } : null;
  },

  /**
   * The same number per value of a field (a choice, yes/no, a reference) or per month of a date:
   * \`[{ value, number }]\`, the most first.
   */
  async measureBy(
    viewer: Viewer | null,
    how: "count" | "sum" | "average" | "smallest" | "largest",
    by: string,
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<{ value: unknown; title?: string; number: number | null }[]> {
    if (readScope(orderAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const split = FILTERABLE[by];
    if (!split || split.kind === "text" || split.kind === "number" || split.kind === "money")
      throw new BadInput(\`There is no field "\${by}" to split by. Fields: \${BY.join(", ")}.\`);
    const field = options.field ?? "";
    const money = MONEY.includes(field);
    const condition = orderData.fitting(viewer, options.where, options.search);
    const amount = (n: number | null) => (n === null ? null : money ? n / 100 : n);
    const most = (a: { number: number | null }, b: { number: number | null }) => (b.number ?? 0) - (a.number ?? 0);
    // A reference's groups carry the referenced record's title beside its id.
    const named = (rows: { value: unknown; number: number | null }[]) => {
      if (split.kind !== "reference") return rows;
      const titles = titlesOf(viewer, by, rows.map((r) => r.value).filter((v): v is number => typeof v === "number"));
      return rows.map((r) => (titles.has(r.value) ? { value: r.value, title: titles.get(r.value), number: r.number } : r));
    };
    if (COMPUTED.includes(field)) {
      // Each record's month or value, then the computed numbers added up per group.
      const groups = new Map<unknown, unknown[]>();
      for (const row of await orderData.computedRows(condition)) {
        const raw = row[split.kind === "reference" ? \`\${by}Id\` : by];
        const value = split.kind === "date" ? String(raw ?? "").slice(0, 7) || null : split.kind === "instant" ? (raw instanceof Date ? raw.toISOString().slice(0, 7) : null) : raw;
        groups.set(value, [...(groups.get(value) ?? []), row[field]]);
      }
      return named([...groups].map(([value, numbers]) => ({ value, number: amount(aggregate(numbers, how)) })).sort(most));
    }
    const key = split.kind === "date" ? sql<string>\`substr(\${split.column}, 1, 7)\` : split.kind === "instant" ? sql<string>\`strftime('%Y-%m', \${split.column} / 1000, 'unixepoch')\` : sql\`\${split.column}\`;
    const column = NUMBERS[field];
    if (how !== "count" && !column)
      throw new BadInput(\`\${how} needs a number field: \${[...Object.keys(NUMBERS), ...COMPUTED].join(", ") || "there are none"}.\`);
    const pick = how === "count" || !column ? count() : { sum, average: avg, smallest: min, largest: max }[how](column);
    return named(
      db
        .select({ value: key, number: pick })
        .from(schema.orders)
        .where(condition)
        .groupBy(key)
        .all()
        .map((r) => ({ value: r.value, number: r.number === null ? null : amount(Number(r.number)) }))
        .sort(most),
    );
  },

  /**
   * The records that fit, with their computed fields worked out: for adding those up. At most
   * 10,000, so one call never reads a whole large table; more are refused with how to narrow them.
   */
  async computedRows(condition: SQL | undefined): Promise<Record<string, unknown>[]> {
    const rows = await db.query.orders.findMany({ where: condition, with: { customer: { columns: { id: true, name: true, deletedAt: true } } }, limit: 10001 });
    if (rows.length > 10000)
      throw new BadInput("More than 10,000 records to add up a computed field over: narrow them with where.");
    return rows.map((row) => withOrderFormulas(row as never) as Record<string, unknown>);
  },

  /** The orders the viewer may read whose number has the text: a few, for naming one. */
  named(viewer: Viewer | null, text: string): { id: number; title: string }[] {
    return db
      .select({ id: schema.orders.id, title: schema.orders.number })
      .from(schema.orders)
      .where(and(orderData.readable(viewer), contains([schema.orders.number], text)))
      .limit(6)
      .all()
      .map((row) => ({ id: row.id, title: String(row.title) }));
  },

  /** The condition for records the viewer may read that fit \`where\` and \`search\`. */
  fitting(viewer: Viewer | null, where?: unknown, search?: string) {
    return and(
      orderData.readable(viewer),
      whereOf(FILTERABLE, where, viewer ? eq(schema.orders.ownerId, viewer.id) : undefined, viewer?.id, {}),
      // Every word somewhere in the texts ("ship lamp" finds "ship's lamp").
      ...wordsOf(search).map((word) => contains([schema.orders.number], word)),
    );
  },

  async get(viewer: Viewer | null, id: number) {
    const fetched = await db.query.orders.findFirst({
      where: and(eq(schema.orders.id, id), orderData.readable(viewer)),
      with: { customer: { columns: { id: true, name: true, deletedAt: true } } },
    });
    const found = fetched && orderData.shownRefs(viewer, [fetched])[0];
    const row = found && shownTo(viewer, found);
    return row ? withOrderFormulas(row) : null;
  },

  async create(viewer: Viewer | null, values: OrderValues) {
    check(orderAccess.create, viewer);
    checkReferences(viewer, values);
    let row: typeof schema.orders.$inferSelect;
    try {
      row = db.transaction((tx) => {
        const made = tx.insert(schema.orders).values({ ...values, ownerId: personOf(viewer) }).returning().get();
        audit(tx, viewer, { action: "created", model: "Order", record: made.id });
        return made;
      });
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterCreate", "Order", row, viewer);
    return row;
  },

  /** Changes the record; \`what\` names the change in the audit log (an action's name). */
  async update(viewer: Viewer | null, id: number, values: OrderValues, what = "changed") {
    const row = db
      .select({ ownerId: schema.orders.ownerId })
      .from(schema.orders)
      .where(and(eq(schema.orders.id, id), orderData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(orderAccess.write, viewer, row.ownerId);
    checkReferences(viewer, values);
    let changed: typeof schema.orders.$inferSelect;
    const updated = values;
    try {
      changed = db.transaction((tx) => {
        const before = tx.select().from(schema.orders).where(eq(schema.orders.id, id)).get();
        const after = tx.update(schema.orders).set(updated).where(eq(schema.orders.id, id)).returning().get();
        audit(tx, viewer, { action: what, model: "Order", record: id, fields: before && changedFields(before, after, Object.keys(updated).filter((k) => !["shippingCost"].includes(k))) });
        return after;
      });
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterUpdate", "Order", changed, viewer);
    return changed;
  },

  /** Deletes the record; \`together\` takes the records that point to it along to the trash (delete-together.md). */
  async remove(viewer: Viewer | null, id: number, _together = false): Promise<void> {
    const row = db
      .select({ ownerId: schema.orders.ownerId })
      .from(schema.orders)
      .where(and(eq(schema.orders.id, id), orderData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(orderAccess.delete, viewer, row.ownerId);
    try {
      db.transaction((tx) => {
        const when = new Date();
        const gone = tx.update(schema.orders).set({ deletedAt: when, deletedBy: personOf(viewer) }).where(and(eq(schema.orders.id, id), isNull(schema.orders.deletedAt))).returning().get();
        if (gone) {
          audit(tx, viewer, { action: "trashed", model: "Order", record: id, title: gone.number });
        }
      });
    } catch (error) {
      throw refusal(error);
    }
    await afterDelete("Order", id, viewer);
  },

  /**
   * Deletes the chosen records the viewer may delete, all or none (one still in use stops them
   * all, and is named); the others are skipped.
   */
  async removeMany(viewer: Viewer | null, ids: number[], _together = false): Promise<{ deleted: number; skipped: number }> {
    const rows = db
      .select({ id: schema.orders.id, ownerId: schema.orders.ownerId })
      .from(schema.orders)
      .where(and(inArray(schema.orders.id, ids), orderData.readable(viewer)))
      .all()
      .filter((row) => allows(orderAccess.delete, viewer, row.ownerId));
    db.transaction((tx) => {
      const when = new Date();
      for (const row of rows)
        try {
          const gone = tx.update(schema.orders).set({ deletedAt: when, deletedBy: personOf(viewer) }).where(and(eq(schema.orders.id, row.id), isNull(schema.orders.deletedAt))).returning().get();
          if (gone) {
            audit(tx, viewer, { action: "trashed", model: "Order", record: row.id, title: gone.number });
          }
        } catch (error) {
          const refused = refusal(error);
          throw refused instanceof Conflict && refused.message === "in-use" ? new Conflict(\`in-use:\${row.id}\`) : refused;
        }
    });
    for (const row of rows) {
      await afterDelete("Order", row.id, viewer);
    }
    return { deleted: rows.length, skipped: new Set(ids).size - rows.length };
  },

  /**
   * The viewer's trash (docs/design/trash.md): the orders in it they may delete, the
   * latest first, with when and by whom, kept for thirty days.
   */
  async trash(viewer: Viewer | null) {
    const rows = orderData.shownRefs(
      viewer,
      await db.query.orders.findMany({
        where: and(isNotNull(schema.orders.deletedAt), orderData.scoped(viewer)),
        with: { customer: { columns: { id: true, name: true, deletedAt: true } } },
        orderBy: (t) => [desc(t.deletedAt)],
        limit: 1000,
      }),
    ).filter((row) => allows(orderAccess.delete, viewer, row.ownerId));
    const ids = [...new Set(rows.map((row) => row.deletedBy).filter((id): id is string => Boolean(id)))];
    const people = new Map(
      db.select({ id: schema.user.id, name: schema.user.name }).from(schema.user).where(inArray(schema.user.id, ids)).all().map((p) => [p.id, p.name]),
    );
    const withTitle = new Map<string, string>();
    for (const r of db.select({ id: schema.customers.id, title: schema.customers.name }).from(schema.customers).where(inArray(schema.customers.id, rows.flatMap((row) => (row.deletedWith?.startsWith("Customer:") ? [Number(row.deletedWith.slice(9))] : [])))).all())
      withTitle.set(\`Customer:\${r.id}\`, String(r.title ?? r.id));
    return rows.map((row) => ({ ...shownTo(viewer, row), deletedByName: (row.deletedBy && people.get(row.deletedBy)) ?? null, withTitle: (row.deletedWith && withTitle.get(row.deletedWith)) ?? null })).map(withOrderFormulas);
  },

  /** A order in the trash, as its page shows it read-only, with when and by whom; else nothing. */
  async trashed(viewer: Viewer | null, id: number) {
    const fetched = await db.query.orders.findFirst({
      where: and(eq(schema.orders.id, id), and(isNotNull(schema.orders.deletedAt), orderData.scoped(viewer))),
      with: { customer: { columns: { id: true, name: true, deletedAt: true } } },
    });
    const row = fetched && orderData.shownRefs(viewer, [fetched])[0];
    if (!row || !allows(orderAccess.delete, viewer, row.ownerId)) return null;
    const rows = [row];
    const ids = [...new Set(rows.map((row) => row.deletedBy).filter((id): id is string => Boolean(id)))];
    const people = new Map(
      db.select({ id: schema.user.id, name: schema.user.name }).from(schema.user).where(inArray(schema.user.id, ids)).all().map((p) => [p.id, p.name]),
    );
    return {
      row: withOrderFormulas(shownTo(viewer, row)),
      deletedAt: row.deletedAt as Date,
      by: (row.deletedBy && people.get(row.deletedBy)) ?? null,
      until: new Date((row.deletedAt as Date).getTime() + TRASH_DAYS * DAY),
    };
  },

  /** Takes the chosen orders out of the trash, those the viewer may delete. */
  restore(viewer: Viewer | null, ids: number[]): { restored: number; skipped: number } {
    const rows = db
      .select({ id: schema.orders.id, deletedWith: schema.orders.deletedWith, ownerId: schema.orders.ownerId })
      .from(schema.orders)
      .where(and(inArray(schema.orders.id, ids), and(isNotNull(schema.orders.deletedAt), orderData.scoped(viewer))))
      .all().filter((row) => allows(orderAccess.delete, viewer, row.ownerId));
    // One that went to the trash with another record comes back with it, not alone (delete-together.md).
    for (const row of rows) {
      const root = row.deletedWith && rootInTrash(row.deletedWith);
      if (root) throw new Conflict(\`restore-root-first:\${root}\`);
    }
    // A unique value a live record has taken since refuses it, as it refuses a new record.
    try {
      db.transaction((tx) => {
        for (const row of rows) {
          const back = tx.update(schema.orders).set({ deletedAt: null, deletedBy: null, deletedWith: null }).where(eq(schema.orders.id, row.id)).returning().get();
          audit(tx, viewer, { action: "restored", model: "Order", record: row.id, title: back.number });
        }
      });
    } catch (error) {
      throw refusal(error);
    }
    return { restored: rows.length, skipped: new Set(ids).size - rows.length };
  },

  /** Removes the chosen orders in the trash for good, with their pictures and documents. */
  removeForGood(viewer: Viewer | null, ids: number[]): { deleted: number; skipped: number } {
    const rows = db
      .select({ id: schema.orders.id, ownerId: schema.orders.ownerId })
      .from(schema.orders)
      .where(and(inArray(schema.orders.id, ids), and(isNotNull(schema.orders.deletedAt), orderData.scoped(viewer))))
      .all().filter((row) => allows(orderAccess.delete, viewer, row.ownerId));
    orderData.erase(viewer, rows.map((row) => row.id));
    return { deleted: rows.length, skipped: new Set(ids).size - rows.length };
  },

  /** Deletes trashed records for good (Delete permanently, Empty trash, the daily job). */
  erase(viewer: Viewer | null, ids: number[]): void {
    if (ids.length === 0) return;
    const rows = db
      .select({ id: schema.orders.id, ownerId: schema.orders.ownerId })
      .from(schema.orders)
      .where(and(inArray(schema.orders.id, ids), isNotNull(schema.orders.deletedAt)))
      .all();
    try {
      db.transaction((tx) => {
        for (const row of rows) {
          const gone = tx.delete(schema.orders).where(eq(schema.orders.id, row.id)).returning().get();
          if (gone) audit(tx, viewer, { action: "removed", model: "Order", record: row.id, title: gone.number });
        }
      });
    } catch (error) {
      throw refusal(error);
    }
  },

  /** What has been in the trash for thirty days goes for good (once a day, see trash.server.ts). */
  purge(now = Date.now()): number {
    const old = db
      .select({ id: schema.orders.id })
      .from(schema.orders)
      .where(lt(schema.orders.deletedAt, new Date(now - TRASH_DAYS * DAY)))
      .all()
      .map((row) => row.id);
    orderData.erase(null, old);
    return old.length;
  },

  /**
   * Moves the live orders the condition fits to the trash with another record
   * (docs/design/delete-together.md), marked as its group; the viewer must be allowed to delete each.
   */
  trashWith(tx: Tx, viewer: Viewer | null, fits: SQL, tag: string, when: Date): void {
    const rows = tx.select().from(schema.orders).where(and(fits, isNull(schema.orders.deletedAt))).all();
    for (const row of rows)
      if (!allows(orderAccess.delete, viewer, row.ownerId)) throw new Conflict("no-right:Order");
    if (rows.length === 0) return;
    tx.update(schema.orders).set({ deletedAt: when, deletedBy: personOf(viewer), deletedWith: tag }).where(and(fits, isNull(schema.orders.deletedAt))).run();
    for (const row of rows) {
      audit(tx, viewer, { action: "trashed", model: "Order", record: row.id, title: row.number, details: { with: tag } });
    }
  },

  /** Takes the orders that went to the trash with a record out of it again. */
  restoreWith(tx: Tx, viewer: Viewer | null, tag: string): void {
    const back = tx.update(schema.orders).set({ deletedAt: null, deletedBy: null, deletedWith: null }).where(eq(schema.orders.deletedWith, tag)).returning().all();
    for (const row of back)
      audit(tx, viewer, { action: "restored", model: "Order", record: row.id, title: row.number, details: { with: tag } });
  },
};
"
`;

