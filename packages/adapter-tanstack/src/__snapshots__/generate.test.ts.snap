  const { viewer } = Route.useRouteContext();
  return (
    <LandingLayout appName={app.name} link={viewer ? { to: "/items", label: w.openApp(app.name) } : { to: "/sign-in", label: w.signIn }} footer={{ links: [], texts: "pages.home.footer" }} site={site} viewer={viewer}>
      <Hero
          texts="pages.home.hero"
          title="Our Collection"
