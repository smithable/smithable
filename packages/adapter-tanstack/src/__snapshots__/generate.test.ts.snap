"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { eq } from "drizzle-orm";
import { db } from "#/db";
import * as schema from "#/db/schema";
import { AccessDenied, allows, check, type Viewer } from "#/kit/access";
import { audit } from "#/kit/audit.server";
import { outgoing } from "#/generated/outgoing.server";
import { afterChange } from "#/generated/hooks";
import { supportCaseSettable } from "#/generated/support-case.schema";
import { supportCaseData } from "#/generated/support-case.server";
import { assignToAccess, assignToFits, type assignToAsks } from "./assign-to";
import type { z } from "zod";

type Row = NonNullable<Awaited<ReturnType<typeof supportCaseData.get>>>;

/** The support case's new values (only the fields the action sets and asks for), worked out on it as it was. */
function plan(_viewer: Viewer | null, row: Row, asked: z.output<typeof assignToAsks>) {
  return {
    id: row.id,
    values: supportCaseSettable.partial().parse({
      assigneeId: asked["assigneeId"],
    }),

  };
}

/** Runs the "assignTo" action on the support case as the viewer, with what was asked. */
export async function runAssignTo(viewer: Viewer | null, id: number, asked: z.output<typeof assignToAsks>) {
  const row = await supportCaseData.get(viewer, id);
  if (!row) throw new AccessDenied(viewer !== null);
  check(assignToAccess, viewer, row.ownerId);
  if (!assignToFits(row, viewer)) throw new Error("This cannot be done now.");
  const one = plan(viewer, row, asked);
  return supportCaseData.update(viewer, id, one.values, "assignTo", []);
}

/**
 * Runs the "assignTo" action on each chosen support case it fits and the viewer may run it on
 * (docs/design/actions.md §9); the others are skipped. All or none: one that is refused stops
 * them all, and is named.
 */
export async function runAssignToMany(viewer: Viewer | null, ids: number[], asked: z.output<typeof assignToAsks>) {
  const plans: ReturnType<typeof plan>[] = [];
  // An id given twice is one record, run once.
  const unique = [...new Set(ids)];
  for (const id of unique) {
    const row = await supportCaseData.get(viewer, id);
    if (!row || !allows(assignToAccess, viewer, row.ownerId) || !assignToFits(row, viewer)) continue;
    try {
      plans.push(plan(viewer, row, asked));
    } catch (error) {
      const why = error instanceof Error ? error.message : String(error);
      throw new Error(\`Support case "\${String(row.subject ?? row.id)}": \${why}\`);
    }
  }
  const written = db.transaction((tx) => plans.map((p) => {
      const before = tx.select().from(schema.supportCases).where(eq(schema.supportCases.id, p.id)).get();
      const changed = tx.update(schema.supportCases).set(p.values).where(eq(schema.supportCases.id, p.id)).returning().get();
      audit(tx, viewer, { action: "assignTo", model: "SupportCase", record: changed.id, fields: ["assignee"] });
      outgoing(tx, viewer, "SupportCase", "assignTo", changed, before);
      const inserted = [

      ] as const;

      return { changed, inserted };
    }));
  for (const w of written) {
    await afterChange("afterUpdate", "SupportCase", w.changed, viewer);

  }
  return { changed: plans.length, skipped: unique.length - plans.length };
}
"
`;

exports[`../../../examples/support/smithable.yml > file list and generated code > src/generated/actions/assign-to.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { z } from "zod";
import { supportCaseUi } from "#/generated/support-case";
import { supportCaseSchema } from "#/generated/support-case.schema";
import type { Rule } from "#/kit/access";
import { getRequestHeaders } from "@tanstack/react-start/server";
import type { ModelUi } from "#/kit/model";
import { userOptions } from "#/generated/users";
import { writeAllowed } from "#/kit/limit";
import { currentViewer } from "#/lib/viewer.server";
import { runAssignTo, runAssignToMany } from "./assign-to.server";

/** Who may run the "assignTo" action: whoever may edit the support case. */
export const assignToAccess: Rule = { public: false, roles: ["admin", "agent"], owner: true };

/** Whether the "assignTo" action fits the support case: it is offered and allowed only then. */
export function assignToFits(_row: { }, _viewer: { id: string } | null): boolean {
  return true;
}

/** What the "assignTo" action asks for when its button is pressed. */
export const assignToAsks = z.object({
  "assigneeId": supportCaseSchema.shape.assigneeId,
});

/** The dialog's fields: the support case's own, then each added record's under its heading. */
export const assignToAskUi: ModelUi = {
  label: "Assign to",
  pluralLabel: "Assign to",
  titleField: "id",
  columns: [],
  fields: [
    ...supportCaseUi.fields.filter((f) => f.name === "assigneeId"),
  ],
  sections: [],
};

/** The choices of the references it asks for, loaded when its dialog opens. */
export async function assignToAskOptions() {
  return { "assigneeId": await userOptions() };
}

/** The viewer about to run it, counted against how often one may write (see src/kit/limit.ts). */
async function writer() {
  const viewer = await currentViewer();
  writeAllowed(viewer, getRequestHeaders());
  return viewer;
}

export const assignTo = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), values: assignToAsks }))
  .handler(async ({ data }) => runAssignTo(await writer(), data.id, data.values));

/** The "assignTo" action on the chosen support cases (at most 1,000 at once). */
export const assignToMany = createServerFn({ method: "POST" })
  .validator(z.object({ ids: z.array(z.number().int()).max(1000), values: assignToAsks }))
  .handler(async ({ data }) => runAssignToMany(await writer(), data.ids, data.values));
"
`;

