      db.transaction((tx) => {
        // Read again in the change itself: a record that left the viewer's reach meanwhile is refused.
        if (!tx.select({ id: schema.businessProfiles.id }).from(schema.businessProfiles).where(and(eq(schema.businessProfiles.id, id), businessProfileData.readable(viewer))).get())
          throw new AccessDenied(viewer !== null);
        const gone = tx.delete(schema.businessProfiles).where(eq(schema.businessProfiles.id, id)).returning().get();
        if (gone) {
          audit(tx, viewer, { action: "deleted", model: "BusinessProfile", record: id, title: gone.businessName });
        }
      });
    } catch (error) {
      throw refusal(error);
    }
    await afterDelete("BusinessProfile", id, viewer);
  },

  /**
   * Deletes the chosen records the viewer may delete, all or none (one still in use stops them
   * all, and is named); the others are skipped.
   */
  async removeMany(viewer: Viewer | null, ids: number[], _together = false): Promise<{ deleted: number; skipped: number }> {
    const rows = db
      .select({ id: schema.businessProfiles.id, ownerId: schema.businessProfiles.ownerId })
