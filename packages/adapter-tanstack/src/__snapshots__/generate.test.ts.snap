import { db } from "#/db";
import { auditLog, user } from "#/db/schema";
import { app } from "#/generated/app";
import { pageAccess, pageHead } from "#/generated/pages";
import { deletePost, getPost, postUi, updatePost } from "#/generated/post";
import { postSchema } from "#/generated/post.schema";
import { guardPage } from "#/kit/access";
import { ActivityLog } from "#/kit/ActivityLog";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";
import { w } from "#/kit/words";
import { currentViewer } from "#/lib/viewer.server";

/** The record's lines in the audit log, newest first: administrators only, nobody else. */
const getHistory = createServerFn()
  .validator((id: number) => id)
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    if (viewer?.role !== "admin") return null;
    const people = new Map(db.select({ id: user.id, name: user.name }).from(user).all().map((p) => [p.id, p.name]));
    return db
      .select()
      .from(auditLog)
      .where(and(eq(auditLog.model, "Post"), eq(auditLog.recordId, id)))
      .orderBy(desc(auditLog.id))
      .limit(50)
      .all()
      .map((r) => ({
        id: r.id,
        at: r.at,
        who: r.who === "visitor" || r.who === "the app" ? r.who : (people.get(r.who) ?? (r.who.startsWith("key:") ? w.aKey(r.who.slice(4)) : r.who.startsWith("timer:") ? w.byTimer(r.who.slice(6)) : w.aRemovedUser(r.who))),
        action: r.action,
        fields: r.fields,
        details: r.details ? Object.fromEntries(Object.entries(r.details).map(([k, v]) => [k, String(v)])) : null,
      }));
  });

export const Route = createFileRoute("/posts/$id")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["posts"], context.viewer, location.href),
  head: () => pageHead("posts"),
  loader: async ({ params }) => {
    const found = await getPost({ data: Number(params.id) });
    if (!found) throw notFound();
    return { ...found, history: await getHistory({ data: Number(params.id) }) };
  },
  component: PostPage,
});

function PostPage() {
  const { row, canWrite, canDelete, history } = Route.useLoaderData();
  const navigate = useNavigate();
  const back = () => navigate({ to: "/posts" });
  return (
    <>
      <PageHeader title={row.title || \`Post #\${row.id}\`} />
      <ModelForm
        key={String(row.updatedAt)}
        ui={postUi}
        app={app}
        schema={postSchema}
        initial={row}
        readOnly={!canWrite}
        submitLabel={w.saveChanges}
        onSubmit={async (values) => {
          await updatePost({ data: { id: row.id, values } });
          await back();
        }}
        onCancel={back}
        onDelete={
          canDelete
            ? async (together?: boolean) => {
                await deletePost({ data: { id: row.id, together } });
                await back();
              }
            : undefined
        }
      />

      {history && history.length > 0 && (
        <section className="mt-10 max-w-3xl">
          <h2 className="mb-3 text-lg font-semibold">{w.history}</h2>
          <ActivityLog lines={history} app={app} />
        </section>
      )}
    </>
  );
}
"
`;

exports[`../../../examples/booking/smithable.yml > file list and generated code > src/routes/posts/index.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, Link, useNavigate, useRouter } from "@tanstack/react-router";
import { pageAccess, pageUi, pageHead } from "#/generated/pages";
import { guardPage, allows } from "#/kit/access";
import { createServerFn } from "@tanstack/react-start";
import * as schema from "#/db/schema";
import { postAccess, postData } from "#/generated/post.server";
import { inArray, and } from "drizzle-orm";
import { currentViewer } from "#/lib/viewer.server";
import { type Search, count, listQuery, optional, text } from "#/kit/params";
import { buttonVariants } from "#/components/ui/button";
import { useState } from "react";
import { SelectionBar } from "#/kit/SelectionBar";
import { csvName, csvOf, download } from "#/kit/csv";
import { deletePosts, postDeleteRule, postUi } from "#/generated/post";
import { app } from "#/generated/app";
import { w } from "#/kit/words";
import { PageHeader } from "#/kit/AppShell";
import { ModelTable } from "#/kit/ModelTable";
import { Filters } from "#/kit/Filters";
import { BookOpen } from "lucide-react";

/** The posts matching the search and the filters, among those the viewer may read. */
const searchPosts = createServerFn()
  .validator(listQuery)
  .handler(async ({ data }) => {
    const viewer = await currentViewer();
    const where = and(
      undefined,
      data.f?.status ? inArray(schema.posts.status, data.f?.status.split(",").filter((v) => ["draft", "published"].includes(v)) as ("draft" | "published")[]) : undefined,
    );
    return {
      ...(await postData.page(viewer, where, undefined, data.all ? 1 : data.page, data.all ? (viewer ? 10000 : 500) : undefined)),
      canCreate: allows(postAccess.create, viewer),
      options: {  },
    };
  });

export const Route = createFileRoute("/posts/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["posts"], context.viewer, location.href),
  head: () => pageHead("posts"),
  validateSearch: (s: Search) => optional({ q: text(s.q), sort: text(s.sort), status: text(s.status), page: count(s.page) }),
  loaderDeps: ({ search }) => search,
  loader: ({ deps: { q, sort, page, ...f } }) => searchPosts({ data: { q, sort, f, page } }),
  // While a search or filter loads, the page stays (and its controls keep their focus).
  pendingMs: Number.POSITIVE_INFINITY,
  gcTime: 0,
  component: PostsPage,
});

function PostsPage() {
  const { rows, canCreate, total, page: at, size } = Route.useLoaderData();
  const { q, sort, page: _page, ...values } = Route.useSearch();
  const { viewer } = Route.useRouteContext();
  const navigate = useNavigate({ from: "/posts/" });
  const router = useRouter();
  // The chosen rows, offered when the viewer may do something to at least one row.
  const [selected, setSelected] = useState<Set<number>>(new Set());
  const chosen = rows.filter((row) => selected.has(row.id));
  const selectable = rows.some((row) => allows(postDeleteRule, viewer, row.ownerId));
  const newButton = canCreate && (
    <Link to="/posts/new" className={buttonVariants()}>
      {w.newOne("post")}
    </Link>
  );
  return (
    <>
      <PageHeader
        page="posts"
        title={pageUi["posts"].title}
        actions={newButton}
      />
      <Filters
        filters={[
  {
    name: "status",
    label: "Status",
    kind: "chips",
    options: postUi.fields.find((f) => f.name === "status")?.choices,
  },
]}
        values={values}
        onChange={(next) => navigate({ to: "/posts", search: { q, ...next }, replace: true, resetScroll: false })}
      />
      {selectable && (
        <SelectionBar
          count={chosen.length}
          noun={["post", "posts"]}
          app={app}
          titleOf={(id) => String(rows.find((row) => row.id === id)?.title ?? id)}
          actions={[]}
          deletable={chosen.filter((row) => allows(postDeleteRule, viewer, row.ownerId)).length}
          onDelete={(together) => deletePosts({ data: { ids: chosen.map((row) => row.id), together } })}
          onDone={async () => {
            setSelected(new Set());
            await router.invalidate();
          }}
          onExport={() => download(csvName(postUi), csvOf(postUi, chosen))}
        />
      )}
      <ModelTable
        ui={postUi}
        page="posts"
        paging={{ page: at, size, total, to: (next) => navigate({ to: "/posts", search: (prev) => ({ ...prev, page: next > 1 ? next : undefined }) }) }}
        app={app}
        exportRows={async () => (await searchPosts({ data: { q, sort, f: values, all: true } })).rows}
        rows={rows}
        icon={BookOpen}
        selection={selectable ? { ids: selected, onChange: setSelected } : undefined}
        emptyMessage={q || Object.values(values).some(Boolean) ? "No posts match the search and filters." : undefined}
        emptyAction={newButton || undefined}
        onOpen={(row) => navigate({ to: "/posts/$id", params: { id: String(row.id) } })}
      />
    </>
  );
}
"
`;

