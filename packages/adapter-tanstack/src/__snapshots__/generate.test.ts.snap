"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { z } from "zod";
import type * as schema from "#/db/schema";
import { allows, type Rule } from "#/kit/access";
import type { RecordUi } from "#/kit/model";
import { customerAccess, customerData } from "./customer.server";
import { orderAccess } from "./order.server";
import { writeAllowed } from "#/kit/limit";
import { userOptions } from "./users";
import { currentViewer } from "#/lib/viewer.server";
import { customerSchema } from "./customer.schema";

export type { CustomerSettable, CustomerValues } from "./customer.schema";

/** The viewer about to write, counted against how often one may (see src/kit/limit.ts). */
async function writer() {
  const viewer = await currentViewer();
  writeAllowed(viewer, getRequestHeaders());
  return viewer;
}

/** Customer records as the kit reads them. */
export type CustomerRow = typeof schema.customers.$inferSelect & {
  accountManager?: { id: string; name: string } | null;
};

export const customerUi: RecordUi<CustomerRow> = {
  model: "Customer",
  label: "Customer",
  pluralLabel: "Customers",
  titleField: "name",
  columns: ["name", "segment", "email", "phone", "creditLimit"],
  fields: [
    {
      name: "name",
      label: "Name",
      kind: "string",
      required: true,
      get: (row) => row.name,
    },
    {
      name: "email",
      label: "Email",
      kind: "email",
      required: false,
      get: (row) => row.email,
    },
    {
      name: "phone",
      label: "Phone",
      kind: "phone",
      required: false,
      get: (row) => row.phone,
    },
    {
      name: "segment",
      label: "Segment",
      kind: "choice",
      required: true,
      choices: [
        { value: "smb", label: "Smb" },
        { value: "enterprise", label: "Enterprise" },
        { value: "government", label: "Government" },
      ],
      default: "smb",
      get: (row) => row.segment,
    },
    {
      name: "creditLimit",
      label: "Credit limit",
      kind: "money",
      required: false,
      min: 0,
      get: (row) => row.creditLimit,
    },
    {
      name: "notes",
      label: "Notes",
      kind: "text",
      required: false,
      get: (row) => row.notes,
    },
    {
      name: "accountManagerId",
      label: "Account manager",
      kind: "user",
      required: false,
      relation: { key: "accountManager", titleField: "name" },
      get: (row) => row.accountManager?.name ?? null,
    },
  ],
};

/** Who may delete customers: a list's selection offers Delete by it (the server checks again). */
export const customerDeleteRule: Rule = { public: false, roles: ["admin"], owner: true };


export const listCustomers = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return { rows: await customerData.list(viewer), canCreate: allows(customerAccess.create, viewer) };
});

export const getCustomer = createServerFn()
  .validator(z.number().int())
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    const row = await customerData.get(viewer, id);
    // In the trash: its page shows it read-only, with when, by whom and Restore.
    if (!row) {
      const gone = await customerData.trashed(viewer, id);
      return gone && { row: gone.row, canWrite: false, canDelete: false, canAdd: { orders: false }, trashed: { at: gone.deletedAt, by: gone.by, until: gone.until } };
    }
    if (!row) return null;
    return {
      row,
      trashed: null,
      canWrite: allows(customerAccess.write, viewer, row.accountManagerId),
      canDelete: allows(customerAccess.delete, viewer, row.accountManagerId),
      // Who may add to its related lists from here ("Add line" on an invoice).
      canAdd: { orders: allows(orderAccess.create, viewer) },
    };
  });

/** Choices for fields that refer to a customer. */
export const customerOptions = createServerFn().handler(async () =>
  customerData.options(await currentViewer()),
);

/** Whom a customer can be given to: null for a viewer who can only make their own. */
export const customerOwnerOptions = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return (!!viewer && (!!viewer.system || customerAccess.write.roles.includes(viewer.role))) ? userOptions() : null;
});

export const createCustomer = createServerFn({ method: "POST" })
  .validator(customerSchema)
  .handler(async ({ data }) => customerData.create(await writer(), data));

export const updateCustomer = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), values: customerSchema }))
  .handler(async ({ data }) => customerData.update(await writer(), data.id, data.values));

/** Deletes a customer; \`together\` takes what points to it along (docs/design/delete-together.md). */
export const deleteCustomer = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), together: z.boolean().optional() }))
  .handler(async ({ data }) => customerData.remove(await writer(), data.id, data.together));

/** Deletes the chosen customers, all or none (at most 1,000 at once). */
export const deleteCustomers = createServerFn({ method: "POST" })
  .validator(z.object({ ids: z.array(z.number().int()).max(1000), together: z.boolean().optional() }))
  .handler(async ({ data }) => customerData.removeMany(await writer(), data.ids, data.together));

/** The viewer's trash of customers (docs/design/trash.md). */
export const trashedCustomers = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return { rows: await customerData.trash(viewer) };
});

/** Takes the chosen customers out of the trash. */
export const restoreCustomers = createServerFn({ method: "POST" })
  .validator(z.array(z.number().int()).max(1000))
  .handler(async ({ data: ids }) => customerData.restore(await writer(), ids));

/** Removes the chosen customers in the trash for good. */
export const eraseCustomers = createServerFn({ method: "POST" })
  .validator(z.array(z.number().int()).max(1000))
  .handler(async ({ data: ids }) => customerData.removeForGood(await writer(), ids));
"
`;

exports[`../../../examples/crm/smithable.yml > file list and generated code > src/generated/hooks.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// Where the app reacts to changes: after a record is created, changed or deleted, and once a
// day. Your reactions go in src/custom/hooks.ts (send an email, update another record, call a
// service); a plugin's in its own hooks file. A hook runs on the server, in the request that
// made the change and with the viewer who made it, after the change is saved; a hook that
// throws fails that request. Daily jobs run in production, a day after the server started.
import type * as schema from "#/db/schema";
import type { Viewer } from "#/kit/access";
import { log } from "#/kit/log.server";
import * as custom from "#/custom/hooks";

export type Hook<Row> = (row: Row, viewer: Viewer | null) => void | Promise<void>;

/** Each model's record as it is stored. */
export interface Rows {
  Customer: typeof schema.customers.$inferSelect;
  Order: typeof schema.orders.$inferSelect;
}

export interface Hooks {
  /** After a record is created, by model. */
  afterCreate?: { [M in keyof Rows]?: Hook<Rows[M]> };
  /** After a record is changed, with its new values. */
  afterUpdate?: { [M in keyof Rows]?: Hook<Rows[M]> };
  /** After a record is deleted; only its id is left. */
  afterDelete?: { [M in keyof Rows]?: Hook<{ id: number }> };
  /** Once a day. */
  daily?: (() => void | Promise<void>)[];
}

// Read when a hook runs, not when this module loads: custom code may import the data functions,
// which import this file.
const sources = (): Hooks[] => [custom.hooks];

export async function afterChange<M extends keyof Rows>(
  event: "afterCreate" | "afterUpdate",
  model: M,
  row: Rows[M],
  viewer: Viewer | null,
): Promise<void> {
  for (const source of sources()) {
    // One model's hook at a time: TypeScript cannot narrow the lookup by a generic key.
    const hook = source[event]?.[model] as Hook<Rows[M]> | undefined;
    await hook?.(row, viewer);
  }
}

export async function afterDelete<M extends keyof Rows>(
  model: M,
  id: number,
  viewer: Viewer | null,
): Promise<void> {
  for (const source of sources()) {
    const hook = source.afterDelete?.[model] as Hook<{ id: number }> | undefined;
    await hook?.({ id }, viewer);
  }
}

/** Every daily job, in order; a failing one is reported and the rest still run. */
export async function runDaily(): Promise<void> {
  for (const source of sources())
    for (const job of source.daily ?? []) {
      try {
        await job();
      } catch (error) {
        log.error("A daily job failed", { error });
      }
    }
}

// In production, once a day, starting a day after the server started (pnpm start). The timer
// never keeps the process alive by itself, so the server still stops when asked to.
if (import.meta.env.SSR && import.meta.env.PROD) {
  const day = 24 * 60 * 60 * 1000;
  const tick = () => setTimeout(() => runDaily().finally(tick), day).unref();
  tick();
}
"
`;

exports[`../../../examples/crm/smithable.yml > file list and generated code > src/generated/order.formulas.test.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// The examples given for Order's formulas: each must give the expected value.
import { describe, expect, test } from "vitest";
import { orderFormulas } from "./order.formulas";

describe("Order.shippingCost", () => {
  test("total 150, shippingMethod standard gives 0", () => {
    expect(orderFormulas.shippingCost({ total: 15000, shippingMethod: "standard" })).toBe(0);
  });

  test("total 80, shippingMethod standard gives 5", () => {
    expect(orderFormulas.shippingCost({ total: 8000, shippingMethod: "standard" })).toBe(500);
  });

  test("total 150, shippingMethod express gives 15", () => {
    expect(orderFormulas.shippingCost({ total: 15000, shippingMethod: "express" })).toBe(1500);
  });
});
"
`;

exports[`../../../examples/crm/smithable.yml > file list and generated code > src/generated/order.formulas.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { F } from "#/kit/formula";

type Row = Record<string, unknown>;

/** Computed fields of Order, on records as stored (money in cents). */
export const orderFormulas = {
  shippingCost: (r: Row): number => F.toCents(((F.compare("=", F.t(r.shippingMethod), "standard") && F.compare(">", F.fromCents(r.total), 100)) ? 0 : (F.compare("=", F.t(r.shippingMethod), "express") ? 15 : 5))),
};

/** Values suggested when a Order is created. */
export const orderDefaults = {
  placedAt: (_r: Row): string => F.NOW(),
};

/** The record with its computed fields. */
export function withOrderFormulas<T extends Row>(row: T): T & { shippingCost: number } {
  return { ...row, shippingCost: orderFormulas.shippingCost(row) };
}
"
`;

