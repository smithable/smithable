exports[`../../../examples/booking/smithable.yml > file list and generated code > src/routes/posts/new.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, useNavigate } from "@tanstack/react-router";
import { app } from "#/generated/app";
import { pageAccess } from "#/generated/pages";
import { createPost, postSchema, postUi } from "#/generated/post";
import { guardPage } from "#/kit/access";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";

export const Route = createFileRoute("/posts/new")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["posts"], context.viewer, location.href),
  component: NewPostPage,
});

function NewPostPage() {
  const navigate = useNavigate();
  const back = () => navigate({ to: "/posts" });
  return (
    <>
      <PageHeader title="New post" />
      <ModelForm
        ui={postUi}
        app={app}
        schema={postSchema}
        submitLabel="Create post"
        onSubmit={async (values) => {
          await createPost({ data: { ...values, address: values.address || addressFrom(values.title) } });
          await back();
        }}
        onCancel={back}
      />
    </>
  );
}

/** An address from a title: lowercase letters, digits and dashes ("Hello, World!" → hello-world). */
function addressFrom(title: unknown): string {
  return String(title ?? "")
    .normalize("NFD")
    .replace(/[\\u0300-\\u036f]/g, "")
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "")
    .slice(0, 80);
}
"
`;

exports[`../../../examples/booking/smithable.yml > file list and generated code > src/routes/schedule/index.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, useNavigate } from "@tanstack/react-router";
import { createServerFn } from "@tanstack/react-start";
import { and, gte, lt } from "drizzle-orm";
import { z } from "zod";
import { sessions } from "#/db/schema";
import { app } from "#/generated/app";
import { pageAccess } from "#/generated/pages";
import { sessionAccess, sessionData } from "#/generated/session.server";
import { allows, guardPage } from "#/kit/access";
import { PageHeader } from "#/kit/AppShell";
import { Calendar, calendarRange } from "#/kit/Calendar";
import { currentViewer } from "#/lib/viewer.server";
import { bookingPlaces, reserveBooking, deleteBooking } from "#/generated/booking";
import { Reserve } from "#/kit/Reserve";
import { classTypeData } from "#/generated/class-type.server";

/** The sessions whose start falls in the range shown, among those the viewer may read. */
const getRange = createServerFn()
  // A real range, and no longer than a month view needs (six weeks and a day on each side).
  .validator(
    z
      .object({ from: z.iso.datetime(), to: z.iso.datetime() })
      .refine((r) => Date.parse(r.from) < Date.parse(r.to) && Date.parse(r.to) - Date.parse(r.from) <= 44 * 86_400_000, "The range is not a week or a month."),
  )
  .handler(async ({ data }) => {
    const viewer = await currentViewer();
    const rows = await sessionData.list(viewer, and(gte(sessions.startsAt, new Date(data.from)), lt(sessions.startsAt, new Date(data.to))));
    // How long each ClassType lasts, among those the viewer may read.
    const minutes = new Map((await classTypeData.list(viewer)).map((r) => [r.id, r.durationMinutes]));
    return {
      items: rows.map((row) => ({
        id: row.id,
        start: row.startsAt,
        end: new Date(row.startsAt.getTime() + (minutes.get(row.classTypeId) ?? 60) * 60_000),
        title: String(row.classType?.name ?? ""),
      })),
      // Records are made on their page: the viewer must be able to open it, too.
      canCreate: allows(sessionAccess.create, viewer) && allows(pageAccess["sessions"], viewer),
      canOpen: allows(pageAccess["sessions"], viewer),
    };
  });

export const Route = createFileRoute("/schedule/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["schedule"], context.viewer, location.href),
  validateSearch: z.object({
    week: z.string().regex(/^\\d{4}-W\\d{2}$/).optional().catch(undefined),
    month: z.string().regex(/^\\d{4}-\\d{2}$/).optional().catch(undefined),
  }),
  loaderDeps: ({ search }) => search,
  loader: ({ deps }) => {
    const range = calendarRange(deps, app.timeZone);
    return getRange({ data: { from: range.from.toISOString(), to: range.to.toISOString() } });
  },
  component: SchedulePage,
});

function SchedulePage() {
  const { items, canCreate, canOpen } = Route.useLoaderData();
  const search = Route.useSearch();
  const navigate = useNavigate();
  return (
    <>
      <PageHeader page="schedule" title="Schedule" />
      <Calendar
        search={search}
        items={items}
        timeZone={app.timeZone}
        dateOnly={false}
        newLabel="New session"
        details={(id) => <Reserve id={id} load={bookingPlaces} book={reserveBooking} cancel={deleteBooking} />}
        onNavigate={(next) => navigate({ to: "/schedule", search: next })}
        onOpen={canOpen ? (id) => navigate({ to: "/sessions/$id", params: { id: String(id) } }) : undefined}
        onCreate={
          canCreate
            ? (start) => navigate({ to: "/sessions/new", search: { startsAt: start } })
            : undefined
        }
      />
    </>
  );
}
"
`;

exports[`../../../examples/booking/smithable.yml > file list and generated code > src/routes/sessions/$id.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, notFound, useNavigate } from "@tanstack/react-router";
import { app } from "#/generated/app";
import { pageAccess } from "#/generated/pages";
import { deleteSession, getSession, sessionSchema, sessionUi, updateSession } from "#/generated/session";
import { bookingPlaces, bookingUi, deleteBooking, reserveBooking } from "#/generated/booking";
import { Reserve } from "#/kit/Reserve";
import { classTypeOptions } from "#/generated/class-type";
import { instructorOptions } from "#/generated/instructor";
import { guardPage } from "#/kit/access";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";
import { ModelTable } from "#/kit/ModelTable";

export const Route = createFileRoute("/sessions/$id")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["sessions"], context.viewer, location.href),
  loader: async ({ params }) => {
    const found = await getSession({ data: Number(params.id) });
    if (!found) throw notFound();
    return { ...found, options: { classTypeId: await classTypeOptions(), instructorId: await instructorOptions() } };
  },
  component: SessionPage,
});

function SessionPage() {
  const { row, canWrite, canDelete, options } = Route.useLoaderData();
  const navigate = useNavigate();
  const back = () => navigate({ to: "/sessions" });
  return (
    <>
      <PageHeader title={\`Session #\${row.id}\`} />
      <ModelForm
        ui={sessionUi}
        app={app}
        schema={sessionSchema}
        initial={row}
        readOnly={!canWrite}
        options={options}
        submitLabel="Save changes"
        onSubmit={async (values) => {
          await updateSession({ data: { id: row.id, values } });
          await back();
        }}
        onCancel={back}
        onDelete={
          canDelete
            ? async () => {
                await deleteSession({ data: row.id });
                await back();
              }
            : undefined
        }
      />
      <section className="mt-10 max-w-3xl">
        <Reserve id={row.id} load={bookingPlaces} book={reserveBooking} cancel={deleteBooking} />
      </section>
      <section className="mt-10">
        <h2 className="mb-3 text-lg font-semibold">Bookings</h2>
        <ModelTable
          ui={bookingUi}
          app={app}
          rows={row.bookings}
          hide={["sessionId"]}
          onOpen={(item) => navigate({ to: "/my-bookings/$id", params: { id: String(item.id) } })}
        />
      </section>
    </>
  );
}
"
`;

