exports[`../../../examples/booking/smithable.yml > file list and generated code > src/routes/blog/$address.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { z } from "zod";
import { postAccess, postData } from "#/generated/post.server";
import { type PostRow } from "#/generated/post";
import { allows, guardPage } from "#/kit/access";
import { currentViewer } from "#/lib/viewer.server";
import { pageAccess } from "#/generated/pages";
import { createFileRoute, notFound } from "@tanstack/react-router";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { ArticleView } from "#/kit/Articles";
import { LandingLayout } from "#/kit/Landing";
import { app } from "#/generated/app";
import { site } from "#/generated/site";

// The row type from the model's module: a type of the data function would keep its server
// import in the page's code.
type Row = PostRow;

/** When an article appeared, for ordering: its publishedOn. */
const when = (row: Row) => (row.publishedOn ? new Date(\`\${row.publishedOn}T00:00:00Z\`).getTime() : 0);
const dateText = (row: Row) =>
  row.publishedOn ? new Intl.DateTimeFormat("en", { dateStyle: "long", timeZone: "UTC" }).format(new Date(\`\${row.publishedOn}T00:00:00Z\`)) : undefined;
/** An article's address under the page: its address. */
const addressOf = (row: Row) => row.address || String(row.id);
const hrefOf = (row: Row) => \`/blog/\${encodeURIComponent(addressOf(row))}\`;
/** The summary, else the body's first paragraph without its marks. */
const summaryOf = (row: Row) => {
  const first = (row.body ?? "").split(/\\n\\s*\\n/).find((b) => b.trim() && !b.trim().startsWith("#")) ?? "";
  const text = row.summary || first;
  const plain = text.replace(/[#*_\`>[\\]]|\\(https?:[^)]*\\)/g, "").trim();
  return plain.length > 200 ? \`\${plain.slice(0, 199)}…\` : plain || undefined;
};
const cardOf = (row: Row) => ({
  href: hrefOf(row),
  title: String(row.title ?? ""),
  summary: summaryOf(row),
  date: dateText(row),
  picture: row.cover ? { src: \`/files/post/\${row.id}/cover\`, alt: row.cover.alt, width: row.cover.width, height: row.cover.height } : undefined,
});

/** Newest first: by when they appeared, then by creation. */
const newestFirst = (rows: Row[]) => [...rows].sort((a, b) => when(b) - when(a) || b.id - a.id);

const getArticle = createServerFn()
  .validator(z.string().max(200))
  .handler(async ({ data: address }) => {
    // In the handler: the data function is the server's alone.
    const viewer = await currentViewer();
    const rows = newestFirst(await postData.list(viewer));
    const i = rows.findIndex((row) => addressOf(row) === address);
    const row = rows[i];
    if (!row) return null;
    const newer = rows[i - 1];
    const older = rows[i + 1];
    // The site's address, for the picture in links shared elsewhere (og:image).
    const headers = getRequestHeaders();
    const origin = \`\${headers.get("x-forwarded-proto") ?? "http"}://\${headers.get("x-forwarded-host") ?? headers.get("host")}\`;
    return {
      origin,
      article: {
        ...cardOf(row),
        body: String(row.body ?? ""),
        author: undefined,
      },
      previous: older ? { href: hrefOf(older), title: String(older.title ?? "") } : undefined,
      next: newer ? { href: hrefOf(newer), title: String(newer.title ?? "") } : undefined,
      edit: allows(postAccess.write, viewer, row.ownerId) && allows(pageAccess["posts"], viewer) ? \`/posts/\${row.id}\` : undefined,
    };
  });

export const Route = createFileRoute("/blog/$address")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["blog"], context.viewer, location.href),
  loader: async ({ params }) => {
    const found = await getArticle({ data: params.address });
    if (!found) throw notFound();
    return found;
  },
  // What a link to the article shows in chat apps and search: its title, summary and picture.
  head: ({ loaderData }) => ({
    meta: loaderData
      ? [
          { title: loaderData.article.title },
          ...(loaderData.article.summary ? [{ name: "description", content: loaderData.article.summary }] : []),
          { property: "og:title", content: loaderData.article.title },
          ...(loaderData.article.picture
            ? [{ property: "og:image", content: loaderData.origin + loaderData.article.picture.src }]
            : []),
        ]
      : [],
  }),
  component: ArticlePage,
});

function ArticlePage() {
  const { article, previous, next, edit } = Route.useLoaderData();
  const view = (
    <ArticleView
      title={article.title}
      date={article.date}
      author={article.author}
      picture={article.picture}
      body={article.body}
      previous={previous}
      next={next}
      edit={edit}
    />
  );
  return (
    <LandingLayout appName={app.name} site={site}>
      <div className="px-5 py-12">{view}</div>
    </LandingLayout>
  );
}
"
`;

exports[`../../../examples/booking/smithable.yml > file list and generated code > src/routes/blog/index.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { z } from "zod";
import { postAccess, postData } from "#/generated/post.server";
import { type PostRow } from "#/generated/post";
import { allows, guardPage } from "#/kit/access";
import { currentViewer } from "#/lib/viewer.server";
import { pageAccess } from "#/generated/pages";
import { createFileRoute } from "@tanstack/react-router";
import { ArticleList } from "#/kit/Articles";
import { LandingLayout } from "#/kit/Landing";
import { app } from "#/generated/app";
import { site } from "#/generated/site";

// The row type from the model's module: a type of the data function would keep its server
// import in the page's code.
type Row = PostRow;

/** When an article appeared, for ordering: its publishedOn. */
const when = (row: Row) => (row.publishedOn ? new Date(\`\${row.publishedOn}T00:00:00Z\`).getTime() : 0);
const dateText = (row: Row) =>
  row.publishedOn ? new Intl.DateTimeFormat("en", { dateStyle: "long", timeZone: "UTC" }).format(new Date(\`\${row.publishedOn}T00:00:00Z\`)) : undefined;
/** An article's address under the page: its address. */
const addressOf = (row: Row) => row.address || String(row.id);
const hrefOf = (row: Row) => \`/blog/\${encodeURIComponent(addressOf(row))}\`;
/** The summary, else the body's first paragraph without its marks. */
const summaryOf = (row: Row) => {
  const first = (row.body ?? "").split(/\\n\\s*\\n/).find((b) => b.trim() && !b.trim().startsWith("#")) ?? "";
  const text = row.summary || first;
  const plain = text.replace(/[#*_\`>[\\]]|\\(https?:[^)]*\\)/g, "").trim();
  return plain.length > 200 ? \`\${plain.slice(0, 199)}…\` : plain || undefined;
};
const cardOf = (row: Row) => ({
  href: hrefOf(row),
  title: String(row.title ?? ""),
  summary: summaryOf(row),
  date: dateText(row),
  picture: row.cover ? { src: \`/files/post/\${row.id}/cover\`, alt: row.cover.alt, width: row.cover.width, height: row.cover.height } : undefined,
});

/** Newest first: by when they appeared, then by creation. */
const newestFirst = (rows: Row[]) => [...rows].sort((a, b) => when(b) - when(a) || b.id - a.id);

const getArticles = createServerFn()
  .validator(z.number().int().min(1))
  .handler(async ({ data: page }) => {
    // In the handler: the data function is the server's alone.
    const viewer = await currentViewer();
    const rows = newestFirst(await postData.list(viewer));
    const start = (page - 1) * 12;
    return {
      items: rows.slice(start, start + 12).map(cardOf),
      more: rows.length > start + 12,
      canCreate: allows(postAccess.create, viewer),
    };
  });

export const Route = createFileRoute("/blog/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["blog"], context.viewer, location.href),
  validateSearch: z.object({ page: z.number().int().min(1).optional().catch(undefined) }),
  loaderDeps: ({ search }) => ({ page: search.page ?? 1 }),
  loader: ({ deps }) => getArticles({ data: deps.page }),
  head: () => ({ meta: [{ title: "Blog" }] }),
  component: ArticlesPage,
});

function ArticlesPage() {
  const { items, more } = Route.useLoaderData();
  const { page = 1 } = Route.useSearch();
  const list = (
    <ArticleList
      items={items}
      older={more ? \`?page=\${page + 1}\` : undefined}
      newer={page > 1 ? (page === 2 ? "/blog" : \`?page=\${page - 1}\`) : undefined}
    />
  );
  return (
    <LandingLayout appName={app.name} site={site}>
      <div className="mx-auto max-w-6xl px-5 py-12">
        <h1 className="mb-6 text-3xl font-bold">{"Blog"}</h1>
        {list}
      </div>
    </LandingLayout>
  );
}
"
`;

