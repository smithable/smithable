"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { F } from "#/kit/formula";

type Row = Record<string, unknown>;

/** Computed fields of Session, on records as stored (money in cents). */
export const sessionFormulas = {
  placesLeft: (r: Row): number => (F.n(r.capacity) - F.list(r.bookings).length),
};

/** Values suggested when a Session is created. */
export const sessionDefaults = {

};

/** The record with its computed fields. */
export function withSessionFormulas<T extends Row>(row: T): T & { placesLeft: number } {
  return { ...row, placesLeft: sessionFormulas.placesLeft(row) };
}
"
`;

exports[`../../../examples/booking/smithable.yml > file list and generated code > src/generated/session.name.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { nameOf, shortWhen, titleOf } from "#/kit/format";
import { app } from "./app";

/**
 * A session's name: classType · startsAt (smithable.yml's namedBy). \`leave\`: parts a
 * page already shows another way (a calendar's start), left out.
 */
export function sessionName(row: Record<string, unknown>, leave: readonly string[] = []): string {
  const parts: [string, string][] = [
    ["classType", (row.classType as Record<string, unknown> | null | undefined) ? titleOf((row.classType as Record<string, unknown> | null | undefined)?.name) : ""],
    ["startsAt", shortWhen(row.startsAt, false, app.timeZone)],
  ];
  return nameOf(
    parts.filter(([part]) => !leave.includes(part)).map(([, words]) => words),
    \`Session #\${row.id}\`,
  );
}
"
`;

