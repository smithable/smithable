  return (
    <>
      <PageHeader
        page="posts"
        title="Posts"
        actions={newButton}
      />
      {selectable && (
        <SelectionBar
          count={chosen.length}
          noun={["post", "posts"]}
          app={app}
          titleOf={(id) => String(rows.find((row) => row.id === id)?.title ?? id)}
