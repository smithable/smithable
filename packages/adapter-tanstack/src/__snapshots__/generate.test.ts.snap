"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { z } from "zod";
import type { Rule } from "#/kit/access";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { writeAllowed } from "#/kit/limit";
import { currentViewer } from "#/lib/viewer.server";
import { runMonitoring, runMonitoringMany } from "./monitoring.server";

/** Who may run the "monitoring" action: whoever may edit the incident, and may create what it adds. */
export const monitoringAccess: Rule = { public: false, roles: ["admin", "staff"], owner: true };

/** Whether the "monitoring" action fits the incident: it is offered and allowed only then. */
export function monitoringFits(row: { status?: unknown }): boolean {
  return ["investigating","identified"].includes(String(row.status));
}

/** The viewer about to run it, counted against how often one may write (see src/kit/limit.ts). */
async function writer() {
  const viewer = await currentViewer();
  writeAllowed(viewer, getRequestHeaders());
  return viewer;
}

export const monitoring = createServerFn({ method: "POST" })
  .validator(z.number().int())
  .handler(async ({ data }) => runMonitoring(await writer(), data));

/** The "monitoring" action on the chosen incidents (at most 1,000 at once). */
export const monitoringMany = createServerFn({ method: "POST" })
  .validator(z.object({ ids: z.array(z.number().int()).max(1000) }))
  .handler(async ({ data }) => runMonitoringMany(await writer(), data.ids));
"
`;

