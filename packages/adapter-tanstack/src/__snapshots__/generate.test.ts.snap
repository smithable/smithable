exports[`../../../examples/records/smithable.yml > file list and generated code > src/db/schema.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { index, integer, sqliteTable, text } from "drizzle-orm/sqlite-core";

export const user = sqliteTable("user", {
  id: text().primaryKey(),
  name: text().notNull(),
  email: text().notNull().unique(),
  emailVerified: integer({ mode: "boolean" }).default(false).notNull(),
  image: text(),
  role: text().notNull().default("member"),
  createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
  updatedAt: integer({ mode: "timestamp_ms" })
    .notNull()
    .$defaultFn(() => new Date())
    .$onUpdate(() => new Date()),
});

export const session = sqliteTable(
  "session",
  {
    id: text().primaryKey(),
    expiresAt: integer({ mode: "timestamp_ms" }).notNull(),
    token: text().notNull().unique(),
    createdAt: integer({ mode: "timestamp_ms" }).notNull(),
    updatedAt: integer({ mode: "timestamp_ms" }).notNull(),
    ipAddress: text(),
    userAgent: text(),
    userId: text()
      .notNull()
      .references(() => user.id, { onDelete: "cascade" }),
  },
  (t) => [index("session_user_id_idx").on(t.userId)],
);

export const account = sqliteTable(
  "account",
  {
    id: text().primaryKey(),
    accountId: text().notNull(),
    providerId: text().notNull(),
    userId: text()
      .notNull()
      .references(() => user.id, { onDelete: "cascade" }),
    accessToken: text(),
    refreshToken: text(),
    idToken: text(),
    accessTokenExpiresAt: integer({ mode: "timestamp_ms" }),
    refreshTokenExpiresAt: integer({ mode: "timestamp_ms" }),
    scope: text(),
    password: text(),
    createdAt: integer({ mode: "timestamp_ms" }).notNull(),
    updatedAt: integer({ mode: "timestamp_ms" }).notNull(),
  },
  (t) => [index("account_user_id_idx").on(t.userId)],
);

export const verification = sqliteTable(
  "verification",
  {
    id: text().primaryKey(),
    identifier: text().notNull(),
    value: text().notNull(),
    expiresAt: integer({ mode: "timestamp_ms" }).notNull(),
    createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
    updatedAt: integer({ mode: "timestamp_ms" })
      .notNull()
      .$defaultFn(() => new Date())
      .$onUpdate(() => new Date()),
  },
  (t) => [index("verification_identifier_idx").on(t.identifier)],
);

export const items = sqliteTable("items", {
  id: integer().primaryKey({ autoIncrement: true }),
  name: text().notNull(),
  summary: text(),
  kind: text({ enum: ["general", "favourite", "archived"] }).notNull().default("general"),
  link: text(),
  addedOn: text().notNull(),
  ownerId: text().references(() => user.id, { onDelete: "set null" }),
  createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
  updatedAt: integer({ mode: "timestamp_ms" })
    .notNull()
    .$defaultFn(() => new Date())
    .$onUpdate(() => new Date()),
});
"
`;

exports[`../../../examples/records/smithable.yml > file list and generated code > src/db/seed.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// Sample data for development. Run with \`pnpm db:seed\`; tables that already have rows are left alone.
import { db } from "./index";
import { items } from "./schema";

if (db.select().from(items).limit(1).all().length === 0) {
  db.insert(items)
    .values([
    { name: "Item 1", summary: "A short description of Item 1.", kind: "general", link: "https://example.com/item/1", addedOn: "2026-04-15" },
    { name: "Item 2", summary: "A short description of Item 2.", kind: "favourite", link: "https://example.com/item/2", addedOn: "2026-05-08" },
    { name: "Item 3", summary: "A short description of Item 3.", kind: "archived", link: "https://example.com/item/3", addedOn: "2026-05-31" },
    { name: "Item 4", summary: "A short description of Item 4.", kind: "general", link: "https://example.com/item/4", addedOn: "2026-06-23" },
    { name: "Item 5", summary: "A short description of Item 5.", kind: "favourite", link: "https://example.com/item/5", addedOn: "2026-07-16" },
    { name: "Item 6", summary: "A short description of Item 6.", kind: "archived", link: "https://example.com/item/6", addedOn: "2026-08-08" },
    { name: "Item 7", summary: "A short description of Item 7.", kind: "general", link: "https://example.com/item/7", addedOn: "2026-08-31" },
    { name: "Item 8", summary: "A short description of Item 8.", kind: "favourite", link: "https://example.com/item/8", addedOn: "2026-09-23" },
