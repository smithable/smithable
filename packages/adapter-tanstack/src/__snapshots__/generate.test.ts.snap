    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "better-auth": "1.7.12",
    "better-sqlite3": "12.11.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "drizzle-zod": "0.8.3",
