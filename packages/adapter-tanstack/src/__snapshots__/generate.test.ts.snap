import { currentViewer } from "#/lib/viewer.server";
import { runCollected, runCollectedMany } from "./collected.server";

/** Who may run the "collected" action: whoever may edit the order. */
export const collectedAccess: Rule = { public: false, roles: ["admin", "staff"], owner: true };

/** Whether the "collected" action fits the order: it is offered and allowed only then. */
export function collectedFits(row: { status?: unknown }, _viewer: { id: string } | null): boolean {
  return row.status === "ready";
}

/** The viewer about to run it, counted against how often one may write (see src/kit/limit.ts). */
async function writer() {
  const viewer = await currentViewer();
  writeAllowed(viewer, getRequestHeaders());
  return viewer;
}

export const collected = createServerFn({ method: "POST" })
  .validator(z.number().int())
  .handler(async ({ data }) => runCollected(await writer(), data));

/** The "collected" action on the chosen orders (at most 1,000 at once). */
export const collectedMany = createServerFn({ method: "POST" })
  .validator(z.object({ ids: z.array(z.number().int()).max(1000) }))
  .handler(async ({ data }) => runCollectedMany(await writer(), data.ids));
"
`;

