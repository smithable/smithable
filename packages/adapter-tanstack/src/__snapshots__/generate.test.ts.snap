/** What a incident's form sends, checked. */
export const incidentSchema = createInsertSchema(schema.incidents, {
  title: (s) => s.trim().min(1, w.required).max(200, w.atMostCharacters(200)),
  summary: (s) => s.max(50000, w.atMostCharacters(50000)),
}).omit({ id: true, ownerId: true, createdAt: true, updatedAt: true });

export type IncidentValues = z.output<typeof incidentSchema>;
"
