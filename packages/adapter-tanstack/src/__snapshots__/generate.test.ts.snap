exports[`../../../examples/crm/smithable.yml > file list and generated code > src/generated/customer.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { eq } from "drizzle-orm";
import { createInsertSchema } from "drizzle-zod";
import { z } from "zod";
import { db } from "#/db";
import { customers } from "#/db/schema";
import type { ModelUi } from "#/kit/model";

export const customerUi: ModelUi = {
  label: "Customer",
  pluralLabel: "Customers",
  titleField: "name",
  columns: ["name", "email", "phone", "segment", "creditLimit"],
  fields: [
    { name: "name", label: "Name", kind: "string", required: true },
    { name: "email", label: "Email", kind: "email", required: false },
    { name: "phone", label: "Phone", kind: "phone", required: false },
    {
      name: "segment",
      label: "Segment",
      kind: "choice",
      required: true,
      choices: [
        { value: "smb", label: "Smb" },
        { value: "enterprise", label: "Enterprise" },
        { value: "government", label: "Government" },
      ],
      default: "smb",
    },
    { name: "creditLimit", label: "Credit limit", kind: "money", required: false },
    { name: "notes", label: "Notes", kind: "text", required: false },
  ],
};

export const customerSchema = createInsertSchema(customers, {
  name: (s) => s.trim().min(1, "Required"),
  email: z.email("Enter a valid email address").nullish(),
  phone: (s) => s.regex(/^\\+?[0-9 ()-]{5,20}$/, "Enter a valid phone number"),
  creditLimit: (s) => s.min(0),
}).omit({ id: true, createdAt: true, updatedAt: true });

export const listCustomers = createServerFn().handler(() =>
  db.query.customers.findMany({
    orderBy: (t, { desc }) => [desc(t.id)],
  }),
);

export const getCustomer = createServerFn()
  .validator(z.number().int())
  .handler(async ({ data: id }) => {
    const row = await db.query.customers.findFirst({
      with: { orders: true },
      where: (t, { eq }) => eq(t.id, id),
    });
    return row ? row : null;
  });

/** Choices for fields that refer to a customer. */
export const customerOptions = createServerFn().handler(() =>
  db
    .select({ value: customers.id, label: customers.name })
    .from(customers)
    .orderBy(customers.name)
    .all(),
);

export const createCustomer = createServerFn({ method: "POST" })
  .validator(customerSchema)
  .handler(({ data }) => db.insert(customers).values(data).returning().get());

export const updateCustomer = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), values: customerSchema }))
  .handler(({ data }) =>
    db.update(customers).set(data.values).where(eq(customers.id, data.id)).returning().get(),
  );

export const deleteCustomer = createServerFn({ method: "POST" })
  .validator(z.number().int())
  .handler(({ data: id }) => {
    db.delete(customers).where(eq(customers.id, id)).run();
  });
"
`;

exports[`../../../examples/crm/smithable.yml > file list and generated code > src/generated/order.formulas.test.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// The examples of Order's formulas in smithable.yml.
import { describe, expect, test } from "vitest";
import { orderFormulas } from "./order.formulas";

describe("Order.shippingCost", () => {
  test("total 150, shippingMethod standard gives 0", () => {
    expect(orderFormulas.shippingCost({ total: 15000, shippingMethod: "standard" })).toBe(0);
  });

  test("total 80, shippingMethod standard gives 5", () => {
    expect(orderFormulas.shippingCost({ total: 8000, shippingMethod: "standard" })).toBe(500);
  });

  test("total 150, shippingMethod express gives 15", () => {
    expect(orderFormulas.shippingCost({ total: 15000, shippingMethod: "express" })).toBe(1500);
  });
});
"
`;

exports[`../../../examples/crm/smithable.yml > file list and generated code > src/generated/order.formulas.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { F } from "#/kit/formula";

type Row = Record<string, unknown>;

/** Computed fields of Order, on records as stored (money in cents). */
export const orderFormulas = {
  shippingCost: (r: Row): number => F.toCents(((F.compare("=", F.t(r.shippingMethod), "standard") && F.compare(">", F.fromCents(r.total), 100)) ? 0 : (F.compare("=", F.t(r.shippingMethod), "express") ? 15 : 5))),
};

/** Values suggested when a Order is created. */
export const orderDefaults = {

};

/** The record with its computed fields. */
export function withOrderFormulas<T extends Row>(row: T): T & { shippingCost: number } {
  return { ...row, shippingCost: orderFormulas.shippingCost(row) };
}
"
`;

exports[`../../../examples/crm/smithable.yml > file list and generated code > src/generated/order.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { eq } from "drizzle-orm";
import { createInsertSchema } from "drizzle-zod";
import { z } from "zod";
import { db } from "#/db";
import { orders } from "#/db/schema";
import type { ModelUi } from "#/kit/model";
import { orderDefaults, withOrderFormulas } from "./order.formulas";

export const orderUi: ModelUi = {
  label: "Order",
  pluralLabel: "Orders",
  titleField: "number",
  columns: ["number", "customerId", "status", "total", "shippingMethod"],
  fields: [
    { name: "number", label: "Number", kind: "string", required: true },
    {
      name: "customerId",
      label: "Customer",
      kind: "relation",
      required: true,
      relation: { key: "customer", titleField: "name" },
    },
    {
      name: "status",
      label: "Status",
      kind: "choice",
      required: true,
      choices: [
        { value: "draft", label: "Draft" },
        { value: "placed", label: "Placed" },
        { value: "shipped", label: "Shipped" },
        { value: "cancelled", label: "Cancelled" },
      ],
      default: "draft",
    },
    { name: "total", label: "Total", kind: "money", required: true },
    {
      name: "shippingMethod",
      label: "Shipping method",
      kind: "choice",
      required: true,
      choices: [
        { value: "standard", label: "Standard" },
        { value: "express", label: "Express" },
      ],
      default: "standard",
    },
    {
      name: "shippingCost",
      label: "Shipping cost",
      kind: "money",
      required: false,
      computed: true,
    },
    { name: "placedAt", label: "Placed at", kind: "datetime", required: false },
  ],
  compute: withOrderFormulas,
  defaults: orderDefaults,
};

export const orderSchema = createInsertSchema(orders, {
  number: (s) => s.trim().min(1, "Required"),
}).omit({ id: true, createdAt: true, updatedAt: true });

export const listOrders = createServerFn().handler(async () =>
  (await db.query.orders.findMany({
    with: { customer: { columns: { id: true, name: true } } },
    orderBy: (t, { desc }) => [desc(t.id)],
  })).map(withOrderFormulas),
);

export const getOrder = createServerFn()
  .validator(z.number().int())
  .handler(async ({ data: id }) => {
    const row = await db.query.orders.findFirst({
      with: { customer: { columns: { id: true, name: true } } },
      where: (t, { eq }) => eq(t.id, id),
    });
    return row ? withOrderFormulas(row) : null;
  });

export const createOrder = createServerFn({ method: "POST" })
  .validator(orderSchema)
  .handler(({ data }) => db.insert(orders).values(data).returning().get());

export const updateOrder = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), values: orderSchema }))
  .handler(({ data }) =>
    db.update(orders).set(data.values).where(eq(orders.id, data.id)).returning().get(),
  );

export const deleteOrder = createServerFn({ method: "POST" })
  .validator(z.number().int())
  .handler(({ data: id }) => {
    db.delete(orders).where(eq(orders.id, id)).run();
  });
"
`;

