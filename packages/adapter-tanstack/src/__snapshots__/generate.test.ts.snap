    }));
  for (const w of written) {
    await afterChange("afterUpdate", "Task", w.changed, viewer);

  }
  return { changed: plans.length, skipped: unique.length - plans.length };
}
"
`;

exports[`../../../examples/api/smithable.yml > file list and generated code > src/generated/actions/reopen.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { z } from "zod";
import type { Rule } from "#/kit/access";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { writeAllowed } from "#/kit/limit";
import { currentViewer } from "#/lib/viewer.server";
import { runReopen, runReopenMany } from "./reopen.server";

/** Who may run the "reopen" action: whoever may edit the task. */
export const reopenAccess: Rule = { public: false, roles: ["admin", "member", "assistant"], owner: true };

/** Whether the "reopen" action fits the task: it is offered and allowed only then. */
export function reopenFits(row: { status?: unknown }): boolean {
  return row.status === "done";
}

/** The viewer about to run it, counted against how often one may write (see src/kit/limit.ts). */
async function writer() {
  const viewer = await currentViewer();
  writeAllowed(viewer, getRequestHeaders());
  return viewer;
}

export const reopen = createServerFn({ method: "POST" })
  .validator(z.number().int())
  .handler(async ({ data }) => runReopen(await writer(), data));

/** The "reopen" action on the chosen tasks (at most 1,000 at once). */
export const reopenMany = createServerFn({ method: "POST" })
  .validator(z.object({ ids: z.array(z.number().int()).max(1000) }))
  .handler(async ({ data }) => runReopenMany(await writer(), data.ids));
"
`;

