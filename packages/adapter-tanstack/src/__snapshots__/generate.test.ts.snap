"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute } from "@tanstack/react-router";
import { createServerFn } from "@tanstack/react-start";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { z } from "zod";
import { app } from "#/generated/app";
import { pageAccess, pageUi, pageHead } from "#/generated/pages";
import { dishData } from "#/generated/dish.server";
import { orderData } from "#/generated/order.server";
import { orderUi, type OrderValues } from "#/generated/order";
import { orderSchema } from "#/generated/order.schema";
import { guardPage } from "#/kit/access";
import { type Hours, nextOpening, openAt } from "#/kit/hours";
import { writeAllowed } from "#/kit/limit";
import { type Menu, OrderPage } from "#/kit/OrderPage";
import { BadInput } from "#/kit/refusal";
import { currentViewer } from "#/lib/viewer.server";

/** When orders are taken, in the app's time zone; none means always. */
const HOURS: Hours | undefined = {
  mon: [[660, 1200]],
  tue: [[660, 1200]],
  wed: [[660, 1200]],
  thu: [[660, 1200]],
  fri: [[660, 1320]],
  sat: [[660, 1320]],
};
/** The fields the customer fills, in order. */
const ASK: string[] = ["name", "phone", "email", "wanted", "note"];

/** What can be chosen, as visitors may read it, and whether orders are taken now. */
const readMenu = createServerFn().handler(async (): Promise<Menu> => {
  const viewer = await currentViewer();
  const rows = await dishData.list(viewer);
  const now = new Date();
  return {
    choices: rows.map((r) => ({
      id: r.id,
      name: String(r.name ?? ""),
      price: Number(r.price ?? 0),
      section: r.section ?? null,
      description: r.description ?? null,
      picture: r.picture ? { src: \`/files/dish/\${r.id}/picture\`, alt: r.picture.alt } : null,
      available: r.available !== false,
    })),
    open: HOURS ? openAt(HOURS, now, app.timeZone) : true,
    opens: HOURS && !openAt(HOURS, now, app.timeZone) ? (nextOpening(HOURS, now, app.timeZone)?.toISOString() ?? null) : null,
  };
});

/** What the customer sends: their details and the chosen ids and quantities, never a price. */
const sent = orderSchema.pick({ name: true, phone: true, email: true, wanted: true, note: true });
const placeOrder = createServerFn({ method: "POST" })
  .validator((data: unknown) =>
    z
      .object({
        values: sent,
        lines: z.array(z.object({ id: z.number().int(), quantity: z.number().int().min(1).max(99) })).min(1).max(50),
      })
      .parse(data),
  )
  .handler(async ({ data }) => {
    const viewer = await currentViewer();
    writeAllowed(viewer, getRequestHeaders());
    if (HOURS && !openAt(HOURS, new Date(), app.timeZone)) throw new BadInput("closed");
    const made = await orderData.create(viewer, data.values as OrderValues, data.lines);
    return { number: made.number, id: made.id };
  });

export const Route = createFileRoute("/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["menu"], context.viewer, location.href),
  head: () => pageHead("menu"),
  loader: () => readMenu(),
  component: OrderRoute,
});

function OrderRoute() {
  const menu = Route.useLoaderData();
  return (
    <OrderPage
      title={pageUi["menu"].title}
      menu={menu}
      sections={[
  ["starters", "Starters"],
  ["mains", "Mains"],
  ["drinks", "Drinks"],
  ["sweets", "Sweets"],
]}
      app={app}
      ui={{ ...orderUi, fields: orderUi.fields.filter((f) => ASK.includes(f.name)) }}
      schema={sent}
      place={(values, lines) => placeOrder({ data: { values, lines } })}
    />
  );
}
"
`;

exports[`../../../examples/kiosk/smithable.yml > file list and generated code > src/routes/orders/$id.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, notFound, useNavigate, useRouter } from "@tanstack/react-router";
import { createServerFn } from "@tanstack/react-start";
import { and, desc, eq } from "drizzle-orm";
import { db } from "#/db";
import { auditLog, user } from "#/db/schema";
import { app } from "#/generated/app";
import { pageAccess, pageHead } from "#/generated/pages";
import { deleteOrder, getOrder, orderUi, updateOrder } from "#/generated/order";
import { orderSchema } from "#/generated/order.schema";
import { accept, acceptAccess, acceptFits } from "#/generated/actions/accept";
import { ready, readyAccess, readyFits } from "#/generated/actions/ready";
import { collected, collectedAccess, collectedFits } from "#/generated/actions/collected";
import { decline, declineAccess, declineAskUi, declineAsks, declineFits } from "#/generated/actions/decline";
import { orderLineUi } from "#/generated/order-line";
import { allows, guardPage } from "#/kit/access";
import { ActionButton } from "#/kit/ActionButton";
import { ActivityLog } from "#/kit/ActivityLog";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";
import { Overflow } from "#/kit/Overflow";
import { w } from "#/kit/words";
import { currentViewer } from "#/lib/viewer.server";
import { ModelTable } from "#/kit/ModelTable";

/** The record's lines in the audit log, newest first: administrators only, nobody else. */
const getHistory = createServerFn()
  .validator((id: number) => id)
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    if (viewer?.role !== "admin") return null;
    const people = new Map(db.select({ id: user.id, name: user.name }).from(user).all().map((p) => [p.id, p.name]));
    return db
      .select()
      .from(auditLog)
      .where(and(eq(auditLog.model, "Order"), eq(auditLog.recordId, id)))
      .orderBy(desc(auditLog.id))
      .limit(50)
      .all()
      .map((r) => ({
        id: r.id,
        at: r.at,
        who: r.who === "visitor" || r.who === "the app" ? r.who : (people.get(r.who) ?? (r.who.startsWith("key:") ? w.aKey(r.who.slice(4)) : r.who.startsWith("timer:") ? w.byTimer(r.who.slice(6)) : w.aRemovedUser(r.who))),
        action: r.action,
        fields: r.fields,
        details: r.details ? Object.fromEntries(Object.entries(r.details).map(([k, v]) => [k, String(v)])) : null,
      }));
  });

export const Route = createFileRoute("/orders/$id")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["orders"], context.viewer, location.href),
  head: () => pageHead("orders"),
  loader: async ({ params }) => {
    const found = await getOrder({ data: Number(params.id) });
    if (!found) throw notFound();
    return { ...found, history: await getHistory({ data: Number(params.id) }) };
  },
  component: OrderPage,
});

function OrderPage() {
  const { row, canWrite, canDelete, history } = Route.useLoaderData();
  const { viewer } = Route.useRouteContext();
  const navigate = useNavigate();
  const router = useRouter();
  const back = () => navigate({ to: "/orders" });
  return (
    <>
      <PageHeader
        title={row.name || \`Order #\${row.id}\`}
        actions={
          <Overflow>
            {allows(acceptAccess, viewer, row.ownerId) && acceptFits(row, viewer) && (
              <ActionButton
                label="Accept"
                concept="action:accept"
                onRun={async () => {
                  await accept({ data: row.id });
                  await router.invalidate();
                }}
              />
            )}
            {allows(readyAccess, viewer, row.ownerId) && readyFits(row, viewer) && (
              <ActionButton
                label="Ready"
                concept="action:ready"
                onRun={async () => {
                  await ready({ data: row.id });
                  await router.invalidate();
                }}
              />
            )}
            {allows(collectedAccess, viewer, row.ownerId) && collectedFits(row, viewer) && (
              <ActionButton
                label="Collected"
                concept="action:collected"
                onRun={async () => {
                  await collected({ data: row.id });
                  await router.invalidate();
                }}
              />
            )}
            {allows(declineAccess, viewer, row.ownerId) && declineFits(row, viewer) && (
              <ActionButton
                label="Decline"
                concept="action:decline"
                ask={{ ui: declineAskUi, schema: declineAsks, initial: row, app }}
                onRun={async (values) => {
                  await decline({ data: { id: row.id, values: values as never } });
                  await router.invalidate();
                }}
              />
            )}
          </Overflow>
        }
      />
      <ModelForm
        key={String(row.updatedAt)}
        ui={orderUi}
        app={app}
        schema={orderSchema}
        initial={row}
        readOnly={!canWrite}
        submitLabel={w.saveChanges}
        onSubmit={async (values) => {
          await updateOrder({ data: { id: row.id, values } });
          await back();
        }}
        onCancel={back}
        onDelete={
          canDelete
            ? async (together?: boolean) => {
                await deleteOrder({ data: { id: row.id, together } });
                await back();
              }
            : undefined
        }
      />
      <section className="mt-10">
        <div className="mb-3 flex items-center justify-between gap-3">
          <h2 className="text-lg font-semibold">Lines</h2>
          
        </div>
        <ModelTable
          ui={orderLineUi}
          app={app}
          rows={row.lines}
          hide={["orderId"]}
          emptyMessage={w.noneYet("order lines")}
        />
      </section>
      {history && history.length > 0 && (
        <section className="mt-10 max-w-3xl">
          <h2 className="mb-3 text-lg font-semibold">{w.history}</h2>
          <ActivityLog lines={history} app={app} />
        </section>
      )}
    </>
  );
}
"
`;

exports[`../../../examples/kiosk/smithable.yml > file list and generated code > src/routes/orders/index.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, Link, useNavigate, useRouter } from "@tanstack/react-router";
import { pageAccess, pageUi, pageHead } from "#/generated/pages";
import { guardPage, allows } from "#/kit/access";
import { createServerFn } from "@tanstack/react-start";
import * as schema from "#/db/schema";
import { orderAccess, orderData } from "#/generated/order.server";
import { inArray, and } from "drizzle-orm";
import { orderOf } from "#/kit/filter";
import { currentViewer } from "#/lib/viewer.server";
import { type Search, count, listQuery, optional, text } from "#/kit/params";
import { buttonVariants } from "#/components/ui/button";
import { accept, acceptAccess, acceptFits, acceptMany } from "#/generated/actions/accept";
import { ready, readyAccess, readyFits, readyMany } from "#/generated/actions/ready";
import { collected, collectedAccess, collectedFits, collectedMany } from "#/generated/actions/collected";
import { decline, declineAccess, declineFits, declineAskUi, declineAsks, declineMany } from "#/generated/actions/decline";
import { ActionButton } from "#/kit/ActionButton";
import { Overflow } from "#/kit/Overflow";
import { useState } from "react";
import { SelectionBar } from "#/kit/SelectionBar";
import { csvName, csvOf, download } from "#/kit/csv";
import { deleteOrders, orderDeleteRule, orderUi } from "#/generated/order";
import { app } from "#/generated/app";
import { w } from "#/kit/words";
import { PageHeader } from "#/kit/AppShell";
import { ModelTable } from "#/kit/ModelTable";
import { Filters } from "#/kit/Filters";

/** The orders matching the search and the filters, among those the viewer may read. */
const searchOrders = createServerFn()
  .validator(listQuery)
  .handler(async ({ data }) => {
    const viewer = await currentViewer();
    const where = and(
      undefined,
      data.f?.status ? inArray(schema.orders.status, data.f?.status.split(",").filter((v) => ["new", "accepted", "ready", "collected", "declined"].includes(v)) as ("new" | "accepted" | "ready" | "collected" | "declined")[]) : undefined,
    );
    // The order the viewer chose, among the fields the page offers; else the newest first.
    const order = orderOf({ createdAt: schema.orders.createdAt, wanted: schema.orders.wanted }, data.sort);
    return {
      ...(await orderData.page(viewer, where, order, data.all ? 1 : data.page, data.all ? (viewer ? 10000 : 500) : undefined)),
      canCreate: allows(orderAccess.create, viewer),
      options: {  },
    };
  });

export const Route = createFileRoute("/orders/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["orders"], context.viewer, location.href),
  head: () => pageHead("orders"),
  validateSearch: (s: Search) => optional({ q: text(s.q), sort: text(s.sort), status: text(s.status), page: count(s.page) }),
  loaderDeps: ({ search }) => search,
  loader: ({ deps: { q, sort, page, ...f } }) => searchOrders({ data: { q, sort, f, page } }),
  // While a search or filter loads, the page stays (and its controls keep their focus).
  pendingMs: Number.POSITIVE_INFINITY,
  gcTime: 0,
  component: OrdersPage,
});

function OrdersPage() {
  const { rows, canCreate, total, page: at, size } = Route.useLoaderData();
  const { q, sort, page: _page, ...values } = Route.useSearch();
  const { viewer } = Route.useRouteContext();
  const navigate = useNavigate({ from: "/orders/" });
  const router = useRouter();
  // The chosen rows, offered when the viewer may do something to at least one row.
  const [selected, setSelected] = useState<Set<number>>(new Set());
  const chosen = rows.filter((row) => selected.has(row.id));
  const selectable = rows.some((row) => allows(acceptAccess, viewer, row.ownerId) && acceptFits(row, viewer) || allows(readyAccess, viewer, row.ownerId) && readyFits(row, viewer) || allows(collectedAccess, viewer, row.ownerId) && collectedFits(row, viewer) || allows(declineAccess, viewer, row.ownerId) && declineFits(row, viewer) || allows(orderDeleteRule, viewer, row.ownerId));
  const newButton = canCreate && (
    <Link to="/orders/new" className={buttonVariants()}>
      {w.newOne("order")}
    </Link>
  );
  return (
    <>
      <PageHeader
        page="orders"
        title={pageUi["orders"].title}
        actions={newButton}
      />
      <Filters
        filters={[
  {
    name: "status",
    label: "Status",
    kind: "chips",
    options: orderUi.fields.find((f) => f.name === "status")?.choices,
  },
]}
        values={values}
        sorts={[
  { value: "createdAt", label: "Added, oldest first" },
  { value: "-createdAt", label: "Added, newest first" },
  { value: "wanted", label: "Wanted, oldest first" },
  { value: "-wanted", label: "Wanted, newest first" },
]}
        sort={sort}
        onChange={(next) => navigate({ to: "/orders", search: { q, ...next }, replace: true, resetScroll: false })}
      />
      {selectable && (
        <SelectionBar
          count={chosen.length}
          noun={["order", "orders"]}
          app={app}
          titleOf={(id) => String(rows.find((row) => row.id === id)?.name ?? id)}
          actions={[
            {
              label: "Accept",
              concept: "action:accept",
              applies: chosen.filter((row) => allows(acceptAccess, viewer, row.ownerId) && acceptFits(row, viewer)).length,
              run: () => acceptMany({ data: { ids: chosen.map((row) => row.id) } }),
            },
            {
              label: "Ready",
              concept: "action:ready",
              applies: chosen.filter((row) => allows(readyAccess, viewer, row.ownerId) && readyFits(row, viewer)).length,
              run: () => readyMany({ data: { ids: chosen.map((row) => row.id) } }),
            },
            {
              label: "Collected",
              concept: "action:collected",
              applies: chosen.filter((row) => allows(collectedAccess, viewer, row.ownerId) && collectedFits(row, viewer)).length,
              run: () => collectedMany({ data: { ids: chosen.map((row) => row.id) } }),
            },
            {
              label: "Decline",
              concept: "action:decline",
              applies: chosen.filter((row) => allows(declineAccess, viewer, row.ownerId) && declineFits(row, viewer)).length,
              ask: { ui: declineAskUi, schema: declineAsks },
              run: (values) => declineMany({ data: { ids: chosen.map((row) => row.id), values: values as never } }),
            },
          ]}
          deletable={chosen.filter((row) => allows(orderDeleteRule, viewer, row.ownerId)).length}
          onDelete={(together) => deleteOrders({ data: { ids: chosen.map((row) => row.id), together } })}
          onDone={async () => {
            setSelected(new Set());
            await router.invalidate();
          }}
          onExport={() => download(csvName(orderUi), csvOf(orderUi, chosen))}
        />
      )}
      <ModelTable
        ui={orderUi}
        page="orders"
        paging={{ page: at, size, total, to: (next) => navigate({ to: "/orders", search: (prev) => ({ ...prev, page: next > 1 ? next : undefined }) }) }}
        app={app}
        exportRows={async () => (await searchOrders({ data: { q, sort, f: values, all: true } })).rows}
        rows={rows}
        sorting={{ keys: { wanted: "wanted" }, value: sort, onChange: (next) => navigate({ to: "/orders", search: (prev) => ({ ...prev, sort: next, page: undefined }), replace: true, resetScroll: false }) }}
        selection={selectable ? { ids: selected, onChange: setSelected } : undefined}
        rowActions={(row) => (
          <Overflow inRow>
            {allows(acceptAccess, viewer, row.ownerId) && acceptFits(row, viewer) && (
              <ActionButton
                label="Accept"
                concept="action:accept"
                onRun={async () => {
                  await accept({ data: row.id });
                  await router.invalidate();
                }}
              />
            )}
            {allows(readyAccess, viewer, row.ownerId) && readyFits(row, viewer) && (
              <ActionButton
                label="Ready"
                concept="action:ready"
                onRun={async () => {
                  await ready({ data: row.id });
                  await router.invalidate();
                }}
              />
            )}
            {allows(collectedAccess, viewer, row.ownerId) && collectedFits(row, viewer) && (
              <ActionButton
                label="Collected"
                concept="action:collected"
                onRun={async () => {
                  await collected({ data: row.id });
                  await router.invalidate();
                }}
              />
            )}
            {allows(declineAccess, viewer, row.ownerId) && declineFits(row, viewer) && (
              <ActionButton
                label="Decline"
                concept="action:decline"
                ask={{ ui: declineAskUi, schema: declineAsks, initial: row, app }}
                onRun={async (values) => {
                  await decline({ data: { id: row.id, values: values as never } });
                  await router.invalidate();
                }}
              />
            )}
          </Overflow>
        )}
        emptyMessage={q || Object.values(values).some(Boolean) ? "No orders match the search and filters." : undefined}
        emptyAction={newButton || undefined}
        onOpen={(row) => navigate({ to: "/orders/$id", params: { id: String(row.id) } })}
      />
    </>
  );
}
"
`;

