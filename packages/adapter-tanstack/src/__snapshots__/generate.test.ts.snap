/** A page of the services the viewer may read. */
const listServices = createServerFn()
  .validator(listQuery)
  .handler(async ({ data }) => {
    const viewer = await currentViewer();
    return { ...(await serviceData.page(viewer, undefined, undefined, data.all ? 1 : data.page, data.all ? (viewer ? 10000 : 500) : undefined)), canCreate: allows(serviceAccess.create, viewer) };
  });

export const Route = createFileRoute("/services/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["services"], context.viewer, location.href),
  head: () => pageHead("services"),
  validateSearch: (s: Search) => optional({ page: count(s.page) }),
  loaderDeps: ({ search }) => ({ page: search.page }),
  loader: ({ deps }) => listServices({ data: { page: deps.page } }),
  component: ServicesPage,
});

function ServicesPage() {
  const { rows, canCreate, total, page: at, size } = Route.useLoaderData();
  const { viewer } = Route.useRouteContext();
  const navigate = useNavigate({ from: "/services/" });
  const router = useRouter();
