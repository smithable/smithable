exports[`../../../examples/crm/smithable.yml > file list and generated code > src/lib/auth.ts 1`] = `
"// Generated by Smithable from smithable.auth.yml. Do not edit: this file is overwritten on every change.
import { betterAuth } from "better-auth";
import { drizzleAdapter } from "better-auth/adapters/drizzle";
import { APIError } from "better-auth/api";
import { emailOTP } from "better-auth/plugins";
import { tanstackStartCookies } from "better-auth/tanstack-start";
import { eq } from "drizzle-orm";
import { db } from "#/db";
import { account, invitation, session, user, verification } from "#/db/schema";
import { ADDRESS_HEADER } from "#/kit/address.server";
import { audit } from "#/kit/audit.server";
import { codeAllowed } from "#/kit/limit";
import { log } from "#/kit/log.server";
import { mailConfigured, sendMail } from "#/kit/mail";
import { w } from "#/kit/words";

/** Sign-in providers in button order; each needs its keys in the environment (see the README). */
export const PROVIDERS = ["email"];

/** Who a session is for, as the audit log names them. */
function signedInAs(userId: string) {
  return db.select({ id: user.id, role: user.role }).from(user).where(eq(user.id, userId)).get() ?? null;
}
const ALLOWED_DOMAINS = ["acme.example"];
/** These addresses become admins when they first sign in. */
const ADMINS: string[] = ["owner@acme.example"];
const APP_NAME = "Acme CRM";

const socialProviders = {

};

/** The providers whose keys are set (email needs none: its codes go out by mail). */
export const configuredProviders = () => PROVIDERS.filter((p) => p === "email" || p in socialProviders);

/** Whether sign-in codes can leave the machine: mail settings, or development's outbox. */
export const codesReachPeople = () => import.meta.env.DEV || mailConfigured();
/** A mail stays in the outbox (the preview, or an app without mail settings): pages say so. */
export const mailKept = () => !mailConfigured();

/** The invitation for an address, if there is one (it may have expired). */
function invitationOf(email: string) {
  return db.select().from(invitation).where(eq(invitation.email, email)).get();
}

/** The invitation for an address that is still open. */
function openInvitation(email: string) {
  const invited = invitationOf(email);
  return invited && invited.expiresAt.getTime() > Date.now() ? invited : undefined;
}

/** Why an address may not have an account here, or nothing when it may. */
function joinRefusal(email: string): string | undefined {
  // The admins may always sign in, whatever the domains or the invitations say.
  if (ADMINS.includes(email)) return undefined;
  if (!ALLOWED_DOMAINS.includes(email.split("@")[1] ?? ""))
    return \`Only \${ALLOWED_DOMAINS.join(" and ")} accounts can sign in.\`;
  const invited = invitationOf(email);
  if (
    !(invited && invited.expiresAt.getTime() > Date.now()) &&
    !ADMINS.includes(email) &&
    !(import.meta.env.DEV && email.startsWith("dev-")) &&
    !(demoSignIn && email.startsWith("demo-"))
  )
    return invited
      ? "Your invitation has expired. Ask an administrator for a new one."
      : \`Only invited people can sign in to \${APP_NAME}. Ask an administrator for an invitation.\`;
  return undefined;
}


/**
 * A demo (DEMO_SIGN_IN=1 in the environment): the sign-in page offers every role without a
 * provider, as development does, and the data is reset by whoever runs the demo. Never set it
 * on a real app.
 */
export const demoSignIn = process.env.DEMO_SIGN_IN === "1";

const NO_TOKENS = {
  accessToken: null,
  refreshToken: null,
  idToken: null,
  accessTokenExpiresAt: null,
  refreshTokenExpiresAt: null,
};

// Production needs both: without a secret sessions could be forged, without the address
// sign-in breaks. Better to refuse to start than to run like that.
if (!import.meta.env.DEV && (!process.env.BETTER_AUTH_SECRET || !process.env.BETTER_AUTH_URL))
  throw new Error("Set BETTER_AUTH_SECRET and BETTER_AUTH_URL: in production the app does not start without them.");

/** The app is served over https: its cookies can take the __Host- prefix, which needs Secure. */
const hostCookies = (process.env.BETTER_AUTH_URL ?? "").startsWith("https://");

export const auth = betterAuth({
  // In development the app runs on port 3000 (pnpm dev); set BETTER_AUTH_URL in production.
  baseURL: process.env.BETTER_AUTH_URL ?? (import.meta.env.DEV ? "http://localhost:3000" : undefined),
  // In development the app may run on any local port (the preview, the tests).
  ...(import.meta.env.DEV ? { trustedOrigins: ["http://localhost:*", "http://127.0.0.1:*"] } : {}),
  database: drizzleAdapter(db, { provider: "sqlite", schema: { account, session, user, verification } }),
  socialProviders,
  // Its limits count per address from the one header the auth route sets (src/kit/address.server.ts),
  // never from an X-Forwarded-For the visitor could make up.
  // Over https the cookies are named so only this app's own address can set them (__Host-: Secure,
  // Path=/, no Domain), not a sibling app on the same domain.
  advanced: {
    ipAddress: { ipAddressHeaders: [ADDRESS_HEADER] },
    ...(hostCookies
      ? {
          useSecureCookies: false,
          // Every other cookie it makes stays Secure too (a sign-in's state).
          defaultCookieAttributes: { secure: true },
          cookies: Object.fromEntries(
            ["session_token", "session_data", "dont_remember", "state"].map((name) => [
              name,
              { name: \`__Host-better-auth.\${name}\`, attributes: { secure: true } },
            ]),
          ),
        }
      : {}),
  },
  // On in every production build, not only where NODE_ENV says so (Better Auth's default).
  rateLimit: { enabled: !import.meta.env.DEV },
  // Email and password only serve the development sign-in; production builds leave it off.
  emailAndPassword: { enabled: import.meta.env.DEV || demoSignIn },
  user: {
    additionalFields: {
      role: { type: "string", required: true, defaultValue: "sales", input: false },
    },
  },
  databaseHooks: {
    user: {
      create: {
        before: async (newUser) => {
          const email = newUser.email.toLowerCase();
          const refused = joinRefusal(email);
          if (refused) {
            audit(db, null, { action: "sign-in refused", model: "User", details: { email, reason: refused } });
            throw new APIError("FORBIDDEN", { message: refused });
          }
          return { data: { ...newUser, role: ADMINS.includes(email) ? "admin" : openInvitation(email)?.role ?? "sales" } };
        },
        after: async (created) => {
          const who = { id: created.id, role: String(created.role) };
          const email = created.email.toLowerCase();
          // Only an invitation still open was accepted (under open sign-up an expired one is not).
          const used = openInvitation(email);
          if (used)
            audit(db, who, { action: "invitation accepted", model: "User", details: { role: used.role } });
          // The invitation is used up: the user is the record from now on.
          db.delete(invitation).where(eq(invitation.email, email)).run();
          audit(db, who, { action: "account created", model: "User", details: { role: who.role } });
        },
      },
    },
    // Signing in and out are in the audit log, as the person who did it.
    session: {
      create: {
        after: async (session) => audit(db, signedInAs(session.userId), { action: "signed in" }),
      },
      // A session also ends when it expires or its user is removed: only a sign-out says so.
      delete: {
        after: async (session, ctx) => {
          if (ctx?.path === "/sign-out") audit(db, signedInAs(session.userId), { action: "signed out" });
        },
      },
    },
    // The app only signs people in with a provider and never calls it afterwards, so the
    // provider's tokens are not kept: not in the database, its backups or its exports.
    account: {
      create: { before: async (account) => ({ data: { ...account, ...NO_TOKENS } }) },
      update: { before: async (account) => ({ data: { ...account, ...NO_TOKENS } }) },
    },
  },
  plugins: [
    // Sign-in by a six-digit code by mail: good for ten minutes, five tries, stored hashed.
    emailOTP({
      otpLength: 6,
      expiresIn: 600,
      allowedAttempts: 5,
      storeOTP: "hashed",
      async sendVerificationOTP({ email, otp, type }, ctx) {
        // Without mail settings a production app keeps no codes: nobody would get them.
        if (type !== "sign-in" || !codesReachPeople()) return;
        const address = email.toLowerCase();
        // Too many codes for the address (or from the network address): no mail. The plugin sends
        // in the background, so the page's answer is the same either way.
        try {
          codeAllowed(address, ctx?.request?.headers ?? new Headers());
        } catch {
          return;
        }
        // Who may not join gets no mail, and the page says the same either way.
        const known = db.select({ id: user.id }).from(user).where(eq(user.email, address)).get();
        if (!known && joinRefusal(address)) return;
        // Not awaited, so the answer takes as long whether or not a mail goes out.
        void sendMail({
          to: address,
          subject: w.codeSubject(APP_NAME),
          text: w.codeText(APP_NAME, \`\${otp.slice(0, 3)} \${otp.slice(3)}\`),
        }).catch((error) => log.error("A sign-in code could not be sent", { error }));
      },
    }),
    tanstackStartCookies(),
  ],
});
"
`;

exports[`../../../examples/crm/smithable.yml > file list and generated code > src/lib/viewer.server.ts 1`] = `
"// Generated by Smithable from smithable.auth.yml. Do not edit: this file is overwritten on every change.
import { getRequestHeaders } from "@tanstack/react-start/server";
import type { Viewer } from "#/kit/access";
import { traceWho } from "#/kit/trace.server";
import { auth } from "#/lib/auth";

/** The signed-in user of the current request, or null; the access line names them. */
export async function currentViewer(): Promise<Viewer | null> {
  const session = await auth.api.getSession({ headers: getRequestHeaders() });
  if (!session) return null;
  const { id, name, email, role } = session.user;
  traceWho(id, role);
  return { id, name, email, role };
}
"
`;

exports[`../../../examples/crm/smithable.yml > file list and generated code > src/routes/__root.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createRootRoute, HeadContent, Scripts, useRouter, useRouterState } from "@tanstack/react-router";
import { createServerFn } from "@tanstack/react-start";
import { useEffect, useState } from "react";
import { History, ShoppingCart, Trash2, Users } from "lucide-react";
import { app } from "#/generated/app";
import { pageAccess } from "#/generated/pages";
import { currentViewer } from "#/lib/viewer.server";
import { AppShell, ErrorNotice, type MenuUi } from "#/kit/AppShell";
import { Ask } from "#/kit/Ask";
import { field } from "#/kit/params";
import { ask, asks } from "#/generated/ask.server";
import { Consent } from "#/kit/Consent";
import { pageHeaders } from "#/kit/security";
import { w } from "#/kit/words";
import { authClient } from "#/lib/auth-client";
import appCss from "#/styles.css?url";

const menus: MenuUi[] = [
  {
    name: "main",
    items: [
      {
        to: "/customers",
        label: "Customers",
        icon: Users,
        access: pageAccess["customers"],
      },
      {
        to: "/orders",
        label: "Orders",
        icon: ShoppingCart,
        access: pageAccess["orders"],
      },
    ],
  },
  {
    name: "admin",
    label: w.admin,
    items: [
      {
        to: "/team",
        label: "Team",
        icon: Users,
        access: pageAccess["team"],
      },
      {
        to: "/team/trash",
        label: w.trashView,
        icon: Trash2,
        access: pageAccess["team"],
      },
      {
        to: "/team/activity",
        label: w.activity,
        icon: History,
        access: pageAccess["team"],
      },
    ],
  },
];

/** Each page's route and name, longest route first. */
const pageRoutes: [string, string][] = [["/customers", "customers"], ["/orders", "orders"], ["/team", "team"]];

/** The page a path is on, e.g. "customers" for /customers/12 (see data-page, src/custom/styles.css). */
function pageOf(path: string): string | undefined {
  return pageRoutes.find(([route]) => path === route || path.startsWith(route === "/" ? "/" : \`\${route}/\`))?.[1];
}


// Who is signed in, and, when a hosting service runs a copy of the app's data from an earlier
// time to look at (DATA_AS_OF), that time.
const getViewer = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return {
    viewer,
    asOf: process.env.DATA_AS_OF,
    demo: process.env.DEMO_SIGN_IN === "1",
    asks: asks(viewer),
  };
});

/** A question to "Ask", answered as the person signed in (or a visitor), with what they may read. */
const askApp = createServerFn({ method: "POST" })
  .validator((data: unknown) => ({ question: field(data, "question", 500) }))
  .handler(async ({ data }) => ask(await currentViewer(), data.question));

export const Route = createRootRoute({
  // Every page knows who is signed in; pages check their access with it.
  beforeLoad: () => getViewer(),
  headers: ({ ssr }) => pageHeaders(ssr?.nonce),
  head: () => ({
    meta: [
      { charSet: "utf-8" },
      { name: "viewport", content: "width=device-width, initial-scale=1" },
      { title: app.name },
    ],
    links: [
      { rel: "stylesheet", href: appCss },
      { rel: "icon", href: "/favicon.svg", type: "image/svg+xml" },
    ],
  }),
  shellComponent: RootDocument,
  errorComponent: ({ error }) => (
    <ErrorNotice title={w.errorTitle} message={error instanceof Error ? error.message : undefined} />
  ),
  notFoundComponent: () => (
    <ErrorNotice title={w.notFound} message={w.notFoundNote} />
  ),
});

function RootDocument({ children }: { children: React.ReactNode }) {
  const { viewer, asOf, demo, asks } = Route.useRouteContext();
  const pathname = useRouterState({ select: (state) => state.location.pathname });
  // Set once React has taken over the page in the browser, for tests that must not type or
  // click before the page's handlers are attached (body[data-hydrated]).
  const [hydrated, setHydrated] = useState(false);
  useEffect(() => setHydrated(true), []);
  const router = useRouter();
  const signOut = async () => {
    await authClient.signOut();
    await router.invalidate();
  };
  const rename = async (name: string) => {
    const { error } = await authClient.updateUser({ name });
    if (error) throw new Error(error.message);
    await router.invalidate();
  };
  return (
    <html lang="en">
      <head>
        <HeadContent />
      </head>
      <body data-page={pageOf(pathname)} data-hydrated={hydrated ? "true" : undefined}>
        {asOf && (
          <p role="status" className="bg-warning px-4 py-2 text-center text-sm text-warning-foreground">
            A copy of this app's data as of {asOf.slice(0, 16).replace("T", " ")} UTC: changes made here are not kept.
          </p>
        )}
        {demo && (
          <p role="status" className="bg-warning px-4 py-2 text-center text-sm text-warning-foreground">
            This is a demo: sign in as anyone and try things; the data is reset every hour.
          </p>
        )}
        <AppShell appName={app.name} menus={menus} viewer={viewer} onSignOut={signOut} onRename={rename}>
          {children}
        </AppShell>
        {asks && <Ask ask={(question) => askApp({ data: { question } })} />}
        <Consent />
        <Scripts />
      </body>
    </html>
  );
}
"
`;

exports[`../../../examples/crm/smithable.yml > file list and generated code > src/routes/customers/$id.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, Link, notFound, useNavigate, useRouter } from "@tanstack/react-router";
import { createServerFn } from "@tanstack/react-start";
import { and, desc, eq } from "drizzle-orm";
import { db } from "#/db";
import { auditLog, user } from "#/db/schema";
import { app } from "#/generated/app";
import { pageAccess } from "#/generated/pages";
import { customerUi, deleteCustomer, getCustomer, restoreCustomers, updateCustomer } from "#/generated/customer";
import { customerSchema } from "#/generated/customer.schema";
import { TrashedBanner, rememberTrashed } from "#/kit/Trash";
import { buttonVariants } from "#/components/ui/button";
import { orderUi } from "#/generated/order";
import { userOptions } from "#/generated/users";
import { guardPage } from "#/kit/access";
import { ActivityLog } from "#/kit/ActivityLog";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";
import { w } from "#/kit/words";
import { currentViewer } from "#/lib/viewer.server";
import { ModelTable } from "#/kit/ModelTable";

/** The record's lines in the audit log, newest first: administrators only, nobody else. */
const getHistory = createServerFn()
  .validator((id: number) => id)
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    if (viewer?.role !== "admin") return null;
    const people = new Map(db.select({ id: user.id, name: user.name }).from(user).all().map((p) => [p.id, p.name]));
    return db
      .select()
      .from(auditLog)
      .where(and(eq(auditLog.model, "Customer"), eq(auditLog.recordId, id)))
      .orderBy(desc(auditLog.id))
      .limit(50)
      .all()
      .map((r) => ({
        id: r.id,
        at: r.at,
        who: r.who === "visitor" || r.who === "the app" ? r.who : (people.get(r.who) ?? (r.who.startsWith("key:") ? w.aKey(r.who.slice(4)) : w.aRemovedUser(r.who))),
        action: r.action,
        fields: r.fields,
        details: r.details ? Object.fromEntries(Object.entries(r.details).map(([k, v]) => [k, String(v)])) : null,
      }));
  });

export const Route = createFileRoute("/customers/$id")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["customers"], context.viewer, location.href),
  head: () => ({ meta: [{"title":"Customers · Acme CRM"}] }),
  loader: async ({ params }) => {
    const found = await getCustomer({ data: Number(params.id) });
    if (!found) throw notFound();
    return { ...found, options: { accountManagerId: await userOptions() }, history: await getHistory({ data: Number(params.id) }) };
  },
  component: CustomerPage,
});

function CustomerPage() {
  const { row, canWrite, canDelete, canAdd, trashed, options, history } = Route.useLoaderData();
  const navigate = useNavigate();
  const router = useRouter();
  const back = () => navigate({ to: "/customers" });
  return (
    <>
      <PageHeader title={row.name || \`Customer #\${row.id}\`} />
      {trashed && (
        <TrashedBanner
          {...trashed}
          app={app}
          ui={customerUi}
          onRestore={async () => {
            await restoreCustomers({ data: [row.id] });
            await router.invalidate();
          }}
        />
      )}
      <ModelForm
        key={String(row.updatedAt)}
        trash
        ui={customerUi}
        app={app}
        schema={customerSchema}
        initial={row}
        readOnly={!canWrite}
        options={options}
        submitLabel={w.saveChanges}
        onSubmit={async (values) => {
          await updateCustomer({ data: { id: row.id, values } });
          await back();
        }}
        onCancel={back}
        onDelete={
          canDelete
            ? async (together?: boolean) => {
                await deleteCustomer({ data: { id: row.id, together } });
                rememberTrashed("Customer", row.id, String(row.name || \`Customer #\${row.id}\`));
                await back();
              }
            : undefined
        }
      />
      <section className="mt-10">
        <div className="mb-3 flex items-center justify-between gap-3">
          <h2 className="text-lg font-semibold">Orders</h2>
          {row.orders.length > 0 && canAdd?.orders && (
              <Link to="/orders/new" search={{ customer: row.id }} className={buttonVariants({ variant: "outline" })}>
                {w.addOne("order")}
              </Link>
            )}
        </div>
        <ModelTable
          ui={orderUi}
          app={app}
          rows={row.orders}
          hide={["customerId"]}
          onOpen={(item) => navigate({ to: "/orders/$id", params: { id: String(item.id) } })}
          emptyAction={canAdd?.orders && (
              <Link to="/orders/new" search={{ customer: row.id }} className={buttonVariants({ variant: "outline" })}>
                {w.addOne("order")}
              </Link>
            )}
          emptyMessage={canAdd?.orders ? undefined : w.noneYet("orders")}
        />
      </section>
      {history && history.length > 0 && (
        <section className="mt-10 max-w-3xl">
          <h2 className="mb-3 text-lg font-semibold">{w.history}</h2>
          <ActivityLog lines={history} app={app} />
        </section>
      )}
    </>
  );
}
"
`;

