import { audit } from "#/kit/audit.server";
import { outgoing } from "#/generated/outgoing.server";
import { afterChange } from "#/generated/hooks";
import { orderSettable } from "#/generated/order.schema";
import { orderData } from "#/generated/order.server";
import { declineAccess, declineFits, type declineAsks } from "./decline";
import type { z } from "zod";

type Row = NonNullable<Awaited<ReturnType<typeof orderData.get>>>;

/** The order's new values (only the fields the action sets and asks for), worked out on it as it was. */
function plan(_viewer: Viewer | null, row: Row, asked: z.output<typeof declineAsks>) {
  return {
    id: row.id,
    values: orderSettable.partial().parse({
      status: "declined",
      reason: asked["reason"],
    }),

  };
}

/** Runs the "decline" action on the order as the viewer, with what was asked. */
export async function runDecline(viewer: Viewer | null, id: number, asked: z.output<typeof declineAsks>) {
  const row = await orderData.get(viewer, id);
  if (!row) throw new AccessDenied(viewer !== null);
  check(declineAccess, viewer, row.ownerId);
  if (!declineFits(row, viewer)) throw new Error("This cannot be done now.");
  const one = plan(viewer, row, asked);
  return orderData.update(viewer, id, one.values, "decline", ["status"]);
}

/**
 * Runs the "decline" action on each chosen order it fits and the viewer may run it on
 * (docs/design/actions.md §9); the others are skipped. All or none: one that is refused stops
 * them all, and is named.
 */
export async function runDeclineMany(viewer: Viewer | null, ids: number[], asked: z.output<typeof declineAsks>) {
  const plans: ReturnType<typeof plan>[] = [];
  // An id given twice is one record, run once.
  const unique = [...new Set(ids)];
  for (const id of unique) {
    const row = await orderData.get(viewer, id);
    if (!row || !allows(declineAccess, viewer, row.ownerId) || !declineFits(row, viewer)) continue;
    try {
      plans.push(plan(viewer, row, asked));
    } catch (error) {
      const why = error instanceof Error ? error.message : String(error);
      throw new Error(\`Order "\${String(row.name ?? row.id)}": \${why}\`);
    }
  }
  const written = db.transaction((tx) => plans.map((p) => {
      const before = tx.select().from(schema.orders).where(eq(schema.orders.id, p.id)).get();
      const changed = tx.update(schema.orders).set(p.values).where(eq(schema.orders.id, p.id)).returning().get();
      audit(tx, viewer, { action: "decline", model: "Order", record: changed.id, fields: ["status","reason"] });
      outgoing(tx, viewer, "Order", "decline", changed, before);
      const inserted = [

      ] as const;

      return { changed, inserted };
    }));
  for (const w of written) {
    await afterChange("afterUpdate", "Order", w.changed, viewer);

  }
  return { changed: plans.length, skipped: unique.length - plans.length };
}
"
`;

