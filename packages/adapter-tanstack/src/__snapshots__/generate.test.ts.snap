  --border: oklch(0.608320 0.037767 263.4399);
  --accent: oklch(0.933674 0.032471 281.9576);
  --sidebar: oklch(1.000000 0.000000 89.8756);
  --card-foreground: oklch(0.244862 0.038771 264.3540);
  --primary-foreground: oklch(1.000000 0.000000 89.8756);
  --secondary: oklch(0.945373 0.011590 264.5097);
