"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, notFound, useNavigate } from "@tanstack/react-router";
import { app } from "#/generated/app";
import { pageAccess, pageHead } from "#/generated/pages";
import { deleteSession, getSession, sessionUi, updateSession } from "#/generated/session";
import { sessionSchema } from "#/generated/session.schema";
import { sessionName } from "#/generated/session.name";
import { bookingUi } from "#/generated/booking";
import { classTypeOptions } from "#/generated/class-type";
import { instructorOptions } from "#/generated/instructor";
import { guardPage } from "#/kit/access";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";
import { w } from "#/kit/words";
import { ModelTable } from "#/kit/ModelTable";

export const Route = createFileRoute("/admin/sessions/$id")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["admin"], context.viewer, location.href),
  head: () => pageHead("admin"),
  loader: async ({ params }) => {
    const found = await getSession({ data: Number(params.id) });
    if (!found) throw notFound();
    return { ...found, options: { classTypeId: await classTypeOptions(), instructorId: await instructorOptions() } };
  },
  component: SessionPage,
});

function SessionPage() {
  const { row, canWrite, canDelete, options } = Route.useLoaderData();
  const navigate = useNavigate();
  const back = () => navigate({ to: "/admin/sessions" });
  return (
    <>
      <PageHeader title={sessionName(row as Record<string, unknown>)} />
      <ModelForm
        key={String(row.updatedAt)}
        ui={sessionUi}
        app={app}
        schema={sessionSchema}
        initial={row}
        readOnly={!canWrite}
        tells={[{"fields":["startsAt"],"list":"bookings","label":"Bookings"}]}
        options={options}
        submitLabel={w.saveChanges}
        onSubmit={async (values) => {
          await updateSession({ data: { id: row.id, values } });
          await back();
        }}
        onCancel={back}
        onDelete={
          canDelete
            ? async (together?: boolean) => {
                await deleteSession({ data: { id: row.id, together } });
                await back();
              }
            : undefined
        }
      />
      <section className="mt-10">
        <div className="mb-3 flex items-center justify-between gap-3">
          <h2 className="text-lg font-semibold">Bookings</h2>
          
        </div>
        <ModelTable
          ui={bookingUi}
          app={app}
          rows={row.bookings}
          hide={["sessionId"]}
          onOpen={(item) => navigate({ to: "/admin/bookings/$id", params: { id: String(item.id) } })}
          emptyMessage={w.noneYet("bookings")}
        />
      </section>
    </>
  );
}
"
`;

