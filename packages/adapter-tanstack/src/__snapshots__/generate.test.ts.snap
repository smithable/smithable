exports[`../../../examples/status/smithable.yml > file list and generated code > src/routes/maintenance/$id.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, notFound, useNavigate } from "@tanstack/react-router";
import { createServerFn } from "@tanstack/react-start";
import { and, desc, eq } from "drizzle-orm";
import { db } from "#/db";
import { apiKey, auditLog, user } from "#/db/schema";
import { app } from "#/generated/app";
import { pageAccess, pageHead } from "#/generated/pages";
import { deleteMaintenance, getMaintenance, maintenanceUi, updateMaintenance } from "#/generated/maintenance";
import { maintenanceSchema } from "#/generated/maintenance.schema";
import { componentOptions } from "#/generated/component";
import { guardPage } from "#/kit/access";
import { ActivityLog } from "#/kit/ActivityLog";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";
import { w } from "#/kit/words";
import { currentViewer } from "#/lib/viewer.server";

/** The record's lines in the audit log, newest first: administrators only, nobody else. */
const getHistory = createServerFn()
  .validator((id: number) => id)
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    if (viewer?.role !== "admin") return null;
    const people = new Map(db.select({ id: user.id, name: user.name }).from(user).all().map((p) => [p.id, p.name]));
    // A key's lines name the key ("key:3" is the key made as "Uptime monitor").
    for (const k of db.select({ id: apiKey.id, name: apiKey.name }).from(apiKey).all())
      people.set(\`key:\${k.id}\`, \`key "\${k.name}"\`);
    return db
      .select()
      .from(auditLog)
      .where(and(eq(auditLog.model, "Maintenance"), eq(auditLog.recordId, id)))
      .orderBy(desc(auditLog.id))
      .limit(50)
      .all()
      .map((r) => ({
        id: r.id,
        at: r.at,
        who: r.who === "visitor" || r.who === "the app" ? r.who : (people.get(r.who) ?? (r.who.startsWith("key:") ? w.aKey(r.who.slice(4)) : r.who.startsWith("timer:") ? w.byTimer(r.who.slice(6)) : w.aRemovedUser(r.who))),
        action: r.action,
        fields: r.fields,
        details: r.details ? Object.fromEntries(Object.entries(r.details).map(([k, v]) => [k, String(v)])) : null,
      }));
  });

export const Route = createFileRoute("/maintenance/$id")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["maintenance"], context.viewer, location.href),
  head: () => pageHead("maintenance"),
  loader: async ({ params }) => {
    const found = await getMaintenance({ data: Number(params.id) });
    if (!found) throw notFound();
    return { ...found, options: { componentId: await componentOptions() }, history: await getHistory({ data: Number(params.id) }) };
  },
  component: MaintenancePage,
});

function MaintenancePage() {
  const { row, canWrite, canDelete, options, history } = Route.useLoaderData();
  const navigate = useNavigate();
  const back = () => navigate({ to: "/maintenance" });
  return (
    <>
      <PageHeader title={row.title || \`Maintenance #\${row.id}\`} />
      <ModelForm
        key={String(row.updatedAt)}
        ui={maintenanceUi}
        app={app}
        schema={maintenanceSchema}
        initial={row}
        readOnly={!canWrite}
        options={options}
        submitLabel={w.saveChanges}
        onSubmit={async (values) => {
          await updateMaintenance({ data: { id: row.id, values } });
          await back();
        }}
        onCancel={back}
        onDelete={
          canDelete
            ? async (together?: boolean) => {
                await deleteMaintenance({ data: { id: row.id, together } });
                await back();
              }
            : undefined
        }
      />

      {history && history.length > 0 && (
        <section className="mt-10 max-w-3xl">
          <h2 className="mb-3 text-lg font-semibold">{w.history}</h2>
          <ActivityLog lines={history} app={app} />
        </section>
      )}
    </>
  );
}
"
`;

exports[`../../../examples/status/smithable.yml > file list and generated code > src/routes/maintenance/index.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, Link, useNavigate, useRouter } from "@tanstack/react-router";
import { pageAccess, pageUi, pageHead } from "#/generated/pages";
import { guardPage, allows } from "#/kit/access";
import { createServerFn } from "@tanstack/react-start";
import { maintenanceAccess, maintenanceData } from "#/generated/maintenance.server";
import { currentViewer } from "#/lib/viewer.server";
import { type Search, count, listQuery, optional } from "#/kit/params";
import { buttonVariants } from "#/components/ui/button";
import { useState } from "react";
import { SelectionBar } from "#/kit/SelectionBar";
import { csvName, csvOf, download } from "#/kit/csv";
import { deleteMaintenances, maintenanceDeleteRule, maintenanceUi } from "#/generated/maintenance";
import { app } from "#/generated/app";
import { w } from "#/kit/words";
import { PageHeader } from "#/kit/AppShell";
import { ModelTable } from "#/kit/ModelTable";

/** A page of the maintenances the viewer may read. */
const listMaintenances = createServerFn()
  .validator(listQuery)
  .handler(async ({ data }) => {
    const viewer = await currentViewer();
    return { ...(await maintenanceData.page(viewer, undefined, undefined, data.all ? 1 : data.page, data.all ? (viewer ? 10000 : 500) : undefined)), canCreate: allows(maintenanceAccess.create, viewer) };
  });

export const Route = createFileRoute("/maintenance/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["maintenance"], context.viewer, location.href),
  head: () => pageHead("maintenance"),
  validateSearch: (s: Search) => optional({ page: count(s.page) }),
  loaderDeps: ({ search }) => ({ page: search.page }),
  loader: ({ deps }) => listMaintenances({ data: { page: deps.page } }),
  component: MaintenancePage,
});

function MaintenancePage() {
  const { rows, canCreate, total, page: at, size } = Route.useLoaderData();
  const { viewer } = Route.useRouteContext();
  const navigate = useNavigate({ from: "/maintenance/" });
  const router = useRouter();
  // The chosen rows, offered when the viewer may do something to at least one row.
  const [selected, setSelected] = useState<Set<number>>(new Set());
  const chosen = rows.filter((row) => selected.has(row.id));
  const selectable = rows.some((row) => allows(maintenanceDeleteRule, viewer, row.ownerId));
  const newButton = canCreate && (
    <Link to="/maintenance/new" className={buttonVariants()}>
      {w.newOne("maintenance")}
    </Link>
  );
  return (
    <>
      <PageHeader
        page="maintenance"
        title={pageUi["maintenance"].title}
        actions={newButton}
      />
      {selectable && (
        <SelectionBar
          count={chosen.length}
          noun={["maintenance", "maintenances"]}
          app={app}
          titleOf={(id) => String(rows.find((row) => row.id === id)?.title ?? id)}
          actions={[]}
          deletable={chosen.filter((row) => allows(maintenanceDeleteRule, viewer, row.ownerId)).length}
          onDelete={(together) => deleteMaintenances({ data: { ids: chosen.map((row) => row.id), together } })}
          onDone={async () => {
            setSelected(new Set());
            await router.invalidate();
          }}
          onExport={() => download(csvName(maintenanceUi), csvOf(maintenanceUi, chosen))}
        />
      )}
      <ModelTable
        ui={maintenanceUi}
        page="maintenance"
        paging={{ page: at, size, total, to: (next) => navigate({ to: "/maintenance", search: (prev) => ({ ...prev, page: next > 1 ? next : undefined }) }) }}
        app={app}
        exportRows={async () => (await listMaintenances({ data: { all: true } })).rows}
        rows={rows}
        selection={selectable ? { ids: selected, onChange: setSelected } : undefined}
        emptyAction={newButton || undefined}
        onOpen={(row) => navigate({ to: "/maintenance/$id", params: { id: String(row.id) } })}
      />
    </>
  );
}
"
`;

