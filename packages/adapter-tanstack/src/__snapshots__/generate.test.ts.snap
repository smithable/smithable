exports[`../../../examples/status/smithable.yml > file list and generated code > src/routes/history/$address.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { z } from "zod";
import { incidentAccess, incidentData } from "#/generated/incident.server";
import { type IncidentRow } from "#/generated/incident";
import { allows, guardPage } from "#/kit/access";
import { currentViewer } from "#/lib/viewer.server";
import { pageAccess } from "#/generated/pages";
import { createFileRoute, notFound } from "@tanstack/react-router";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { ArticleView } from "#/kit/Articles";
import { LandingLayout } from "#/kit/Landing";
import { app } from "#/generated/app";
import { site } from "#/generated/site";

// The row type from the model's module: a type of the data function would keep its server
// import in the page's code.
type Row = IncidentRow;

/** When an article appeared, for ordering: its detectedAt. */
const when = (row: Row) => (row.detectedAt ? new Date(row.detectedAt).getTime() : 0);
const dateText = (row: Row) =>
  row.detectedAt ? new Intl.DateTimeFormat("en", { dateStyle: "long" }).format(new Date(row.detectedAt)) : undefined;
/** An article's address under the page: its id. */
const addressOf = (row: Row) => String(row.id);
const hrefOf = (row: Row) => \`/history/\${encodeURIComponent(addressOf(row))}\`;
/** The summary, else the body's first paragraph without its marks. */
const summaryOf = (row: Row) => {
  const first = (row.summary ?? "").split(/\\n\\s*\\n/).find((b) => b.trim() && !b.trim().startsWith("#")) ?? "";
  const text = first;
  const plain = text.replace(/[#*_\`>[\\]]|\\(https?:[^)]*\\)/g, "").trim();
  return plain.length > 200 ? \`\${plain.slice(0, 199)}…\` : plain || undefined;
};
const cardOf = (row: Row) => ({
  href: hrefOf(row),
  title: String(row.title ?? ""),
  summary: summaryOf(row),
  date: dateText(row),
  picture: undefined,
});

/** Newest first: by when they appeared, then by creation. */
const newestFirst = (rows: Row[]) => [...rows].sort((a, b) => when(b) - when(a) || b.id - a.id);

const getArticle = createServerFn()
  .validator(z.string().max(200))
  .handler(async ({ data: address }) => {
    // In the handler: the data function is the server's alone.
    const viewer = await currentViewer();
    const rows = newestFirst(await incidentData.list(viewer));
    const i = rows.findIndex((row) => addressOf(row) === address);
    const row = rows[i];
    if (!row) return null;
    const newer = rows[i - 1];
    const older = rows[i + 1];
    // The site's address, for the picture in links shared elsewhere (og:image).
    const headers = getRequestHeaders();
    const origin = \`\${headers.get("x-forwarded-proto") ?? "http"}://\${headers.get("x-forwarded-host") ?? headers.get("host")}\`;
    return {
      origin,
      article: {
        ...cardOf(row),
        body: String(row.summary ?? ""),
        author: undefined,
      },
      previous: older ? { href: hrefOf(older), title: String(older.title ?? "") } : undefined,
      next: newer ? { href: hrefOf(newer), title: String(newer.title ?? "") } : undefined,
      edit: allows(incidentAccess.write, viewer, row.ownerId) && allows(pageAccess["incidents"], viewer) ? \`/incidents/\${row.id}\` : undefined,
    };
  });

export const Route = createFileRoute("/history/$address")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["history"], context.viewer, location.href),
  loader: async ({ params }) => {
    const found = await getArticle({ data: params.address });
    if (!found) throw notFound();
    return found;
  },
  // What a link to the article shows in chat apps and search: its title, summary and picture.
  head: ({ loaderData }) => ({
    meta: loaderData
      ? [
          { title: loaderData.article.title },
          ...(loaderData.article.summary ? [{ name: "description", content: loaderData.article.summary }] : []),
          { property: "og:title", content: loaderData.article.title },
        ]
      : [],
  }),
  component: ArticlePage,
});

function ArticlePage() {
  const { article, previous, next, edit } = Route.useLoaderData();
  const view = (
    <ArticleView
      title={article.title}
      date={article.date}
      author={article.author}
      picture={article.picture}
      body={article.body}
      previous={previous}
      next={next}
      edit={edit}
    />
  );
  return (
    <LandingLayout appName={app.name} site={site}>
      <div className="px-5 py-12">{view}</div>
    </LandingLayout>
  );
}
"
`;

exports[`../../../examples/status/smithable.yml > file list and generated code > src/routes/history/index.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { z } from "zod";
import { incidentAccess, incidentData } from "#/generated/incident.server";
import { type IncidentRow } from "#/generated/incident";
import { allows, guardPage } from "#/kit/access";
import { currentViewer } from "#/lib/viewer.server";
import { pageAccess } from "#/generated/pages";
import { createFileRoute } from "@tanstack/react-router";
import { ArticleList } from "#/kit/Articles";
import { count, optional, type Search } from "#/kit/params";
import { LandingLayout } from "#/kit/Landing";
import { app } from "#/generated/app";
import { site } from "#/generated/site";

// The row type from the model's module: a type of the data function would keep its server
// import in the page's code.
type Row = IncidentRow;

/** When an article appeared, for ordering: its detectedAt. */
const when = (row: Row) => (row.detectedAt ? new Date(row.detectedAt).getTime() : 0);
const dateText = (row: Row) =>
  row.detectedAt ? new Intl.DateTimeFormat("en", { dateStyle: "long" }).format(new Date(row.detectedAt)) : undefined;
/** An article's address under the page: its id. */
const addressOf = (row: Row) => String(row.id);
const hrefOf = (row: Row) => \`/history/\${encodeURIComponent(addressOf(row))}\`;
/** The summary, else the body's first paragraph without its marks. */
const summaryOf = (row: Row) => {
  const first = (row.summary ?? "").split(/\\n\\s*\\n/).find((b) => b.trim() && !b.trim().startsWith("#")) ?? "";
  const text = first;
  const plain = text.replace(/[#*_\`>[\\]]|\\(https?:[^)]*\\)/g, "").trim();
  return plain.length > 200 ? \`\${plain.slice(0, 199)}…\` : plain || undefined;
};
const cardOf = (row: Row) => ({
  href: hrefOf(row),
  title: String(row.title ?? ""),
  summary: summaryOf(row),
  date: dateText(row),
  picture: undefined,
});

/** Newest first: by when they appeared, then by creation. */
const newestFirst = (rows: Row[]) => [...rows].sort((a, b) => when(b) - when(a) || b.id - a.id);

const getArticles = createServerFn()
  .validator(z.number().int().min(1))
  .handler(async ({ data: page }) => {
    // In the handler: the data function is the server's alone.
    const viewer = await currentViewer();
    const rows = newestFirst(await incidentData.list(viewer));
    const start = (page - 1) * 12;
    return {
      items: rows.slice(start, start + 12).map(cardOf),
      more: rows.length > start + 12,
      canCreate: allows(incidentAccess.create, viewer),
    };
  });

export const Route = createFileRoute("/history/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["history"], context.viewer, location.href),
  head: () => ({ meta: [{"title":"History · Northwind Status"}] }),
  validateSearch: (s: Search) => optional({ page: count(s.page) }),
  loaderDeps: ({ search }) => ({ page: search.page ?? 1 }),
  loader: ({ deps }) => getArticles({ data: deps.page }),
  component: ArticlesPage,
});

function ArticlesPage() {
  const { items, more } = Route.useLoaderData();
  const { page = 1 } = Route.useSearch();
  const list = (
    <ArticleList
      items={items}
      older={more ? \`?page=\${page + 1}\` : undefined}
      newer={page > 1 ? (page === 2 ? "/history" : \`?page=\${page - 1}\`) : undefined}
    />
  );
  return (
    <LandingLayout appName={app.name} site={site}>
      <div className="mx-auto max-w-6xl px-5 py-12">
        <h1 className="mb-6 text-3xl font-bold">{"History"}</h1>
        {list}
      </div>
    </LandingLayout>
  );
}
"
`;

exports[`../../../examples/status/smithable.yml > file list and generated code > src/routes/incidents/$id.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, Link, notFound, useNavigate, useRouter } from "@tanstack/react-router";
import { createServerFn } from "@tanstack/react-start";
import { and, desc, eq } from "drizzle-orm";
import { db } from "#/db";
import { apiKey, auditLog, user } from "#/db/schema";
import { app } from "#/generated/app";
import { pageAccess } from "#/generated/pages";
import { deleteIncident, getIncident, incidentUi, updateIncident } from "#/generated/incident";
import { incidentSchema } from "#/generated/incident.schema";
import { identified, identifiedAccess, identifiedFits } from "#/generated/actions/identified";
import { monitoring, monitoringAccess, monitoringFits } from "#/generated/actions/monitoring";
import { resolve, resolveAccess, resolveFits } from "#/generated/actions/resolve";
import { buttonVariants } from "#/components/ui/button";
import { incidentUpdateUi } from "#/generated/incident-update";
import { componentOptions } from "#/generated/component";
import { allows, guardPage } from "#/kit/access";
import { ActionButton } from "#/kit/ActionButton";
import { ActivityLog } from "#/kit/ActivityLog";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";
import { w } from "#/kit/words";
import { currentViewer } from "#/lib/viewer.server";
import { ModelTable } from "#/kit/ModelTable";

/** The record's lines in the audit log, newest first: administrators only, nobody else. */
const getHistory = createServerFn()
  .validator((id: number) => id)
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    if (viewer?.role !== "admin") return null;
    const people = new Map(db.select({ id: user.id, name: user.name }).from(user).all().map((p) => [p.id, p.name]));
    // A key's lines name the key ("key:3" is the key made as "Uptime monitor").
    for (const k of db.select({ id: apiKey.id, name: apiKey.name }).from(apiKey).all())
      people.set(\`key:\${k.id}\`, \`key "\${k.name}"\`);
    return db
      .select()
      .from(auditLog)
      .where(and(eq(auditLog.model, "Incident"), eq(auditLog.recordId, id)))
      .orderBy(desc(auditLog.id))
      .limit(50)
      .all()
      .map((r) => ({
        id: r.id,
        at: r.at,
        who: r.who === "visitor" || r.who === "the app" ? r.who : (people.get(r.who) ?? (r.who.startsWith("key:") ? w.aKey(r.who.slice(4)) : w.aRemovedUser(r.who))),
        action: r.action,
        fields: r.fields,
        details: r.details ? Object.fromEntries(Object.entries(r.details).map(([k, v]) => [k, String(v)])) : null,
      }));
  });

export const Route = createFileRoute("/incidents/$id")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["incidents"], context.viewer, location.href),
  head: () => ({ meta: [{"title":"Incidents · Northwind Status"}] }),
  loader: async ({ params }) => {
    const found = await getIncident({ data: Number(params.id) });
    if (!found) throw notFound();
    return { ...found, options: { componentId: await componentOptions() }, history: await getHistory({ data: Number(params.id) }) };
  },
  component: IncidentPage,
});

function IncidentPage() {
  const { row, canWrite, canDelete, canAdd, options, history } = Route.useLoaderData();
  const { viewer } = Route.useRouteContext();
  const navigate = useNavigate();
  const router = useRouter();
  const back = () => navigate({ to: "/incidents" });
  return (
    <>
      <PageHeader
        title={row.title || \`Incident #\${row.id}\`}
        actions={
          <>
            {allows(identifiedAccess, viewer, row.ownerId) && identifiedFits(row) && (
              <ActionButton
                label="Identified"
                concept="action:identified"
                onRun={async () => {
                  await identified({ data: row.id });
                  await router.invalidate();
                }}
              />
            )}
            {allows(monitoringAccess, viewer, row.ownerId) && monitoringFits(row) && (
              <ActionButton
                label="Monitoring"
                concept="action:monitoring"
                onRun={async () => {
                  await monitoring({ data: row.id });
                  await router.invalidate();
                }}
              />
            )}
            {allows(resolveAccess, viewer, row.ownerId) && resolveFits(row) && (
              <ActionButton
                label="Resolve"
                concept="action:resolve"
                onRun={async () => {
                  await resolve({ data: row.id });
                  await router.invalidate();
                }}
              />
            )}
          </>
        }
      />
      <ModelForm
        key={String(row.updatedAt)}
        ui={incidentUi}
        app={app}
        schema={incidentSchema}
        initial={row}
        readOnly={!canWrite}
        options={options}
        submitLabel={w.saveChanges}
        onSubmit={async (values) => {
          await updateIncident({ data: { id: row.id, values } });
          await back();
        }}
        onCancel={back}
        onDelete={
          canDelete
            ? async (together?: boolean) => {
                await deleteIncident({ data: { id: row.id, together } });
                await back();
              }
            : undefined
        }
      />
      <section className="mt-10">
        <div className="mb-3 flex items-center justify-between gap-3">
          <h2 className="text-lg font-semibold">Updates</h2>
          {row.updates.length > 0 && canAdd?.updates && (
              <Link to="/updates/new" search={{ incident: row.id }} className={buttonVariants({ variant: "outline" })}>
                {w.addOne("incident update")}
              </Link>
            )}
        </div>
        <ModelTable
          ui={incidentUpdateUi}
          app={app}
          rows={row.updates}
          hide={["incidentId"]}
          onOpen={(item) => navigate({ to: "/updates/$id", params: { id: String(item.id) } })}
          emptyAction={canAdd?.updates && (
              <Link to="/updates/new" search={{ incident: row.id }} className={buttonVariants({ variant: "outline" })}>
                {w.addOne("incident update")}
              </Link>
            )}
          emptyMessage={canAdd?.updates ? undefined : w.noneYet("incident updates")}
        />
      </section>
      {history && history.length > 0 && (
        <section className="mt-10 max-w-3xl">
          <h2 className="mb-3 text-lg font-semibold">{w.history}</h2>
          <ActivityLog lines={history} app={app} />
        </section>
      )}
    </>
  );
}
"
`;

exports[`../../../examples/status/smithable.yml > file list and generated code > src/routes/incidents/index.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, Link, useNavigate, useRouter } from "@tanstack/react-router";
import { pageAccess } from "#/generated/pages";
import { guardPage, allows } from "#/kit/access";
import { createServerFn } from "@tanstack/react-start";
import { incidentAccess, incidentData } from "#/generated/incident.server";
import { currentViewer } from "#/lib/viewer.server";
import { type Search, count, listQuery, optional } from "#/kit/params";
import { buttonVariants } from "#/components/ui/button";
import { identified, identifiedAccess, identifiedFits, identifiedMany } from "#/generated/actions/identified";
import { monitoring, monitoringAccess, monitoringFits, monitoringMany } from "#/generated/actions/monitoring";
import { resolve, resolveAccess, resolveFits, resolveMany } from "#/generated/actions/resolve";
import { ActionButton } from "#/kit/ActionButton";
import { Overflow } from "#/kit/Overflow";
import { useState } from "react";
import { SelectionBar } from "#/kit/SelectionBar";
import { csvName, csvOf, download } from "#/kit/csv";
import { deleteIncidents, incidentDeleteRule, incidentUi } from "#/generated/incident";
import { app } from "#/generated/app";
import { w } from "#/kit/words";
import { PageHeader } from "#/kit/AppShell";
import { ModelTable } from "#/kit/ModelTable";

/** A page of the incidents the viewer may read. */
const listIncidents = createServerFn()
  .validator(listQuery)
  .handler(async ({ data }) => {
    const viewer = await currentViewer();
    return { ...(await incidentData.page(viewer, undefined, undefined, data.all ? 1 : data.page, data.all ? (viewer ? 10000 : 500) : undefined)), canCreate: allows(incidentAccess.create, viewer) };
  });

export const Route = createFileRoute("/incidents/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["incidents"], context.viewer, location.href),
  head: () => ({ meta: [{"title":"Incidents · Northwind Status"}] }),
  validateSearch: (s: Search) => optional({ page: count(s.page) }),
  loaderDeps: ({ search }) => ({ page: search.page }),
  loader: ({ deps }) => listIncidents({ data: { page: deps.page } }),
  component: IncidentsPage,
});

function IncidentsPage() {
  const { rows, canCreate, total, page: at, size } = Route.useLoaderData();
  const { viewer } = Route.useRouteContext();
  const navigate = useNavigate({ from: "/incidents/" });
  const router = useRouter();
  // The chosen rows, offered when the viewer may do something to at least one row.
  const [selected, setSelected] = useState<Set<number>>(new Set());
  const chosen = rows.filter((row) => selected.has(row.id));
  const selectable = rows.some((row) => allows(identifiedAccess, viewer, row.ownerId) && identifiedFits(row) || allows(monitoringAccess, viewer, row.ownerId) && monitoringFits(row) || allows(resolveAccess, viewer, row.ownerId) && resolveFits(row) || allows(incidentDeleteRule, viewer, row.ownerId));
  const newButton = canCreate && (
    <Link to="/incidents/new" className={buttonVariants()}>
      {w.newOne("incident")}
    </Link>
  );
  return (
    <>
      <PageHeader
        page="incidents"
        title="Incidents"
        actions={newButton}
      />
      {selectable && (
        <SelectionBar
          count={chosen.length}
          noun={["incident", "incidents"]}
          app={app}
          titleOf={(id) => String(rows.find((row) => row.id === id)?.title ?? id)}
          actions={[
            {
              label: "Identified",
              concept: "action:identified",
              applies: chosen.filter((row) => allows(identifiedAccess, viewer, row.ownerId) && identifiedFits(row)).length,
              run: () => identifiedMany({ data: { ids: chosen.map((row) => row.id) } }),
            },
            {
              label: "Monitoring",
              concept: "action:monitoring",
              applies: chosen.filter((row) => allows(monitoringAccess, viewer, row.ownerId) && monitoringFits(row)).length,
              run: () => monitoringMany({ data: { ids: chosen.map((row) => row.id) } }),
            },
            {
              label: "Resolve",
              concept: "action:resolve",
              applies: chosen.filter((row) => allows(resolveAccess, viewer, row.ownerId) && resolveFits(row)).length,
              run: () => resolveMany({ data: { ids: chosen.map((row) => row.id) } }),
            },
          ]}
          deletable={chosen.filter((row) => allows(incidentDeleteRule, viewer, row.ownerId)).length}
          onDelete={(together) => deleteIncidents({ data: { ids: chosen.map((row) => row.id), together } })}
          onDone={async () => {
            setSelected(new Set());
            await router.invalidate();
          }}
          onExport={() => download(csvName(incidentUi), csvOf(incidentUi, chosen))}
        />
      )}
      <ModelTable
        ui={incidentUi}
        page="incidents"
        paging={{ page: at, size, total, to: (next) => navigate({ to: "/incidents", search: (prev) => ({ ...prev, page: next > 1 ? next : undefined }) }) }}
        app={app}
        exportRows={async () => (await listIncidents({ data: { all: true } })).rows}
        rows={rows}
        selection={selectable ? { ids: selected, onChange: setSelected } : undefined}
        rowActions={(row) => (
          <Overflow inRow>
            {allows(identifiedAccess, viewer, row.ownerId) && identifiedFits(row) && (
              <ActionButton
                label="Identified"
                concept="action:identified"
                onRun={async () => {
                  await identified({ data: row.id });
                  await router.invalidate();
                }}
              />
            )}
            {allows(monitoringAccess, viewer, row.ownerId) && monitoringFits(row) && (
              <ActionButton
                label="Monitoring"
                concept="action:monitoring"
                onRun={async () => {
                  await monitoring({ data: row.id });
                  await router.invalidate();
                }}
              />
            )}
            {allows(resolveAccess, viewer, row.ownerId) && resolveFits(row) && (
              <ActionButton
                label="Resolve"
                concept="action:resolve"
                onRun={async () => {
                  await resolve({ data: row.id });
                  await router.invalidate();
                }}
              />
            )}
          </Overflow>
        )}
        emptyAction={newButton || undefined}
        onOpen={(row) => navigate({ to: "/incidents/$id", params: { id: String(row.id) } })}
      />
    </>
  );
}
"
`;

