    const updated = values;
    try {
      changed = db.transaction((tx) => {
        const before = tx.select().from(schema.incidentUpdates).where(eq(schema.incidentUpdates.id, id)).get();
        const after = tx.update(schema.incidentUpdates).set(updated).where(eq(schema.incidentUpdates.id, id)).returning().get();
        audit(tx, viewer, { action: what, model: "IncidentUpdate", record: id, fields: before && changedFields(before, after, Object.keys(updated)) });
        return after;
