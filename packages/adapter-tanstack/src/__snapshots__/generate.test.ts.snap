"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createInsertSchema } from "drizzle-zod";
import { z } from "zod";
import * as schema from "#/db/schema";
import { w } from "#/kit/words";

/** What a instructor's form sends, checked. */
export const instructorSchema = createInsertSchema(schema.instructors, {
  name: (s) => s.trim().min(1, w.required).max(200, w.atMostCharacters(200)),
  bio: (s) => s.max(50000, w.atMostCharacters(50000)),
  portrait: z.object({ file: z.string().regex(/^instructor\\/[a-f0-9]{24}\\.webp$/), alt: z.string().trim().max(200), width: z.int().positive(), height: z.int().positive(), generated: z.literal(true).optional(), receipt: z.string().max(64).optional() }).nullish(),
}).omit({ id: true, ownerId: true, createdAt: true, updatedAt: true });

export type InstructorValues = z.output<typeof instructorSchema>;
"
`;

exports[`../../../examples/booking/smithable.yml > file list and generated code > src/generated/instructor.server.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { type AnyColumn, and, asc, avg, count, desc, eq, inArray, isNotNull, max, min, sql, sum, type SQL } from "drizzle-orm";
import { db } from "#/db";
import * as schema from "#/db/schema";
import { AccessDenied, allows, check, Conflict, type ModelAccess, personOf, readScope, type Viewer } from "#/kit/access";
import { audit, changedFields } from "#/kit/audit.server";
import { refusal } from "#/kit/log.server";
import { contains } from "#/kit/search";
import { BadInput } from "#/kit/refusal";
import { aggregate, type Filterable, sortOf, whereOf, wordsOf } from "#/kit/where";
import { deletePicture } from "#/kit/uploads";
import { acceptFiles } from "#/kit/receipts.server";
import { afterChange, afterDelete } from "./hooks";
import type { InstructorValues } from "./instructor";

/** A transaction, as the group's functions are called inside one (docs/design/delete-together.md). */
type Tx = Parameters<Parameters<typeof db.transaction>[0]>[0];

/**
 * What points to a instructor (docs/design/delete-together.md): the records that would go with it
 * to the trash, by model, and those that would show no instructor; nothing when nothing does.
 */
function usedBy(tx: Tx, id: number, title: string) {
  const pointing: { model: string; from: string; label: string; plural: string; depth: number; count: number | null }[] = [
    { model: "Session", label: "Session", plural: "Sessions", from: "Instructor", depth: 1, count: tx.select({ n: count() }).from(schema.sessions).where(and(eq(schema.sessions.instructorId, id))).get()?.n ?? 0 },
    { model: "Booking", label: "Booking", plural: "Bookings", from: "Session", depth: 2, count: tx.select({ n: count() }).from(schema.bookings).innerJoin(schema.sessions, eq(schema.bookings.sessionId, schema.sessions.id)).where(and(eq(schema.sessions.instructorId, id))).get()?.n ?? 0 },
  ];
  // A deeper member is named when its parent has records ("and what belongs to them").
  const with_: typeof pointing = [];
  for (const e of pointing)
    if (e.count === null ? with_.some((p) => p.model === e.from) : e.count > 0) with_.push(e);
  if (!with_.length) return undefined;
  const loose = [] as { model: string; label: string; plural: string; count: number }[];
  return { id, title, model: "Instructor", label: "Instructor", with: with_, loose, together: false, missing: ["Instructor","Session","Booking"] };
}

/** Who may read, create, change and delete instructors. */
export const instructorAccess: ModelAccess = {
  read: { public: true, roles: ["admin"], owner: true },
  create: { public: false, roles: ["admin"], owner: false },
  write: { public: false, roles: ["admin"], owner: true },
  delete: { public: false, roles: ["admin"], owner: true },
};

/** A record as the viewer gets it: who owns it only for its owner and roles that read every record. */
function shownTo<R extends { ownerId: string | null }>(viewer: Viewer | null, row: R): R {
  if (viewer && (row.ownerId === viewer.id || instructorAccess.read.roles.includes(viewer.role))) return row;
  return { ...row, ownerId: null };
}


/** What \`where\` may name, and how: the stored fields, by kind. */
const FILTERABLE: Record<string, Filterable> = {
  name: { kind: "text", column: schema.instructors.name },
  bio: { kind: "text", column: schema.instructors.bio },
};

/** What the records can be sorted by. */
const SORTABLE = { id: schema.instructors.id, name: schema.instructors.name, bio: schema.instructors.bio, createdAt: schema.instructors.createdAt };

/** The number fields \`measure\` adds up; amounts are stored in cents. */
const NUMBERS: Record<string, AnyColumn> = {  };
const MONEY: string[] = [];

/** Computed number fields \`measure\` adds up from the records themselves. */
const COMPUTED: string[] = [];

/** The titles of the referenced records \`measureBy\` splits by, to name its groups. */
function titlesOf(_viewer: Viewer | null, _by: string, _ids: number[]): Map<unknown, string> {
  switch (_by) {
    default:
      return new Map();
  }
}

/** What \`measureBy\` may split by: choices, yes/no, references, and dates by month. */
const BY: string[] = [];


/** Each picture or document new to the record must come with the receipt its upload gave the viewer (src/kit/receipts.server.ts); the receipts are not kept. */
function checkFiles(viewer: Viewer | null, values: InstructorValues, before?: Record<string, unknown>): InstructorValues {
  return {
    ...values,
    ...("portrait" in values ? { portrait: acceptFiles(viewer, "instructor", "portrait", values.portrait, before?.portrait) } : {}),
  };
}

export const instructorData = {
  shownTo,
  /** The rows with each reference to a record the viewer may not read set to nothing: a related record's title is shown only to who may read it (only its id stays). */
  shownRefs<R extends Record<string, unknown>>(_viewer: Viewer | null, rows: R[]): R[] {
    return rows;
  },

  /** Whether a stored picture or document is on any record (the trash too): a file no record has may go. */
  uses(file: string): boolean {
    return !!db.select({ id: schema.instructors.id }).from(schema.instructors).where(sql\`\${schema.instructors.portrait} like \${\`%"file":"\${file}"%\`}\`).get();
  },

  /** A condition for the instructors the viewer may read. */
  readable(viewer: Viewer | null) {
    const scope = readScope(instructorAccess.read, viewer);
    if (scope === "all") return undefined;
    return scope === "own" && viewer ? eq(schema.instructors.ownerId, viewer.id) : sql\`false\`;
  },

  canRead(viewer: Viewer | null, id: number): boolean {
    const found = db
      .select({ id: schema.instructors.id })
      .from(schema.instructors)
      .where(and(eq(schema.instructors.id, id), instructorData.readable(viewer)))
      .get();
    return found !== undefined;
  },

  /** The instructors the viewer may read; \`where\` narrows them, e.g. to a search; \`limit\` keeps the newest (a data page). */
  async list(viewer: Viewer | null, where?: SQL, limit?: number) {
    if (readScope(instructorAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const found = instructorData.shownRefs(viewer, await db.query.instructors.findMany({
      where: and(instructorData.readable(viewer), where),
      orderBy: (t, { desc }) => [desc(t.id)],
      limit,
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return rows;
  },

  /**
   * A page of the instructors the viewer may read that fit \`where\`, newest first (or in
   * \`order\`), and how many fit in all: for a list page. A page past the end is the last one.
   */
  async page(viewer: Viewer | null, where?: SQL, order?: SQL, page = 1, size = 50) {
    if (readScope(instructorAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = and(instructorData.readable(viewer), where);
    const total = db.select({ n: count() }).from(schema.instructors).where(condition).get()?.n ?? 0;
    const at = Math.min(Math.max(1, Math.trunc(page)), Math.max(1, Math.ceil(total / size)));
    const found = instructorData.shownRefs(viewer, await db.query.instructors.findMany({
      where: condition,
      orderBy: (t, { desc }) => [...(order ? [order] : []), desc(t.id)],
      limit: size,
      offset: (at - 1) * size,
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return { rows: rows, total, page: at, size };
  },

  /**
   * The instructors the viewer may read that fit \`where\` and \`search\`, in \`sort\`'s order (else newest
   * first), a page of them and how many there are: for the API and the assistants' tools.
   */
  async find(
    viewer: Viewer | null,
    options: { where?: unknown; search?: string; sort?: string; limit?: number; offset?: number } = {},
  ) {
    if (readScope(instructorAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = instructorData.fitting(viewer, options.where, options.search);
    const order = sortOf(SORTABLE, options.sort);
    const total = db.select({ n: count() }).from(schema.instructors).where(condition).get()?.n ?? 0;
    const found = instructorData.shownRefs(viewer, await db.query.instructors.findMany({
      where: condition,
      orderBy: (t, { desc }) => [...(order ? [order] : []), desc(t.id)],
      limit: options.limit ?? 100,
      offset: options.offset ?? 0,
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return { items: rows, total };
  },

  /**
   * A number from the instructors the viewer may read that fit \`where\`: how many, or the sum,
   * average, smallest or largest of a number field.
   */
  async measure(
    viewer: Viewer | null,
    how: "count" | "sum" | "average" | "smallest" | "largest",
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<number | null> {
    if (readScope(instructorAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = instructorData.fitting(viewer, options.where, options.search);
    if (how === "count")
      return db.select({ n: count() }).from(schema.instructors).where(condition).get()?.n ?? 0;
    const field = options.field ?? "";
    const money = MONEY.includes(field);
    if (COMPUTED.includes(field)) {
      const rows = await instructorData.computedRows(condition);
      const value = aggregate(rows.map((row) => row[field]), how);
      return value === null ? null : money ? value / 100 : value;
    }
    const column = NUMBERS[field];
    if (!column)
      throw new BadInput(
        \`\${how} needs a number field: \${[...Object.keys(NUMBERS), ...COMPUTED].join(", ") || "there are none"}.\`,
      );
    const pick = { sum, average: avg, smallest: min, largest: max }[how];
    const value = db.select({ v: pick(column) }).from(schema.instructors).where(condition).get()?.v;
    if (value === null || value === undefined) return null;
    return money ? Number(value) / 100 : Number(value);
  },

  /** Which record holds the smallest or largest value of a number field (the first of a tie). */
  async holder(
    viewer: Viewer | null,
    how: "smallest" | "largest",
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<{ id: number; title: string } | null> {
    const condition = instructorData.fitting(viewer, options.where, options.search);
    const field = options.field ?? "";
    if (COMPUTED.includes(field)) {
      let best: Record<string, unknown> | undefined;
      for (const row of await instructorData.computedRows(condition)) {
        const v = row[field];
        if (typeof v !== "number") continue;
        if (!best || (how === "largest" ? v > (best[field] as number) : v < (best[field] as number))) best = row;
      }
      return best ? { id: best.id as number, title: String(best.name) } : null;
    }
    const column = NUMBERS[field];
    if (!column) return null;
    const row = db
      .select({ id: schema.instructors.id, title: schema.instructors.name })
      .from(schema.instructors)
      .where(and(condition, isNotNull(column)))
      .orderBy(how === "largest" ? desc(column) : asc(column), asc(schema.instructors.id))
      .limit(1)
      .get();
    return row ? { id: row.id, title: String(row.title) } : null;
  },

  /**
   * The same number per value of a field (a choice, yes/no, a reference) or per month of a date:
   * \`[{ value, number }]\`, the most first.
   */
  async measureBy(
    viewer: Viewer | null,
    how: "count" | "sum" | "average" | "smallest" | "largest",
    by: string,
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<{ value: unknown; title?: string; number: number | null }[]> {
    if (readScope(instructorAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const split = FILTERABLE[by];
    if (!split || split.kind === "text" || split.kind === "number" || split.kind === "money")
      throw new BadInput(\`There is no field "\${by}" to split by. Fields: \${BY.join(", ")}.\`);
    const field = options.field ?? "";
    const money = MONEY.includes(field);
    const condition = instructorData.fitting(viewer, options.where, options.search);
    const amount = (n: number | null) => (n === null ? null : money ? n / 100 : n);
    const most = (a: { number: number | null }, b: { number: number | null }) => (b.number ?? 0) - (a.number ?? 0);
    // A reference's groups carry the referenced record's title beside its id.
    const named = (rows: { value: unknown; number: number | null }[]) => {
      if (split.kind !== "reference") return rows;
      const titles = titlesOf(viewer, by, rows.map((r) => r.value).filter((v): v is number => typeof v === "number"));
      return rows.map((r) => (titles.has(r.value) ? { value: r.value, title: titles.get(r.value), number: r.number } : r));
    };
    if (COMPUTED.includes(field)) {
      // Each record's month or value, then the computed numbers added up per group.
      const groups = new Map<unknown, unknown[]>();
      for (const row of await instructorData.computedRows(condition)) {
        const raw = row[split.kind === "reference" ? \`\${by}Id\` : by];
        const value = split.kind === "date" ? String(raw ?? "").slice(0, 7) || null : split.kind === "instant" ? (raw instanceof Date ? raw.toISOString().slice(0, 7) : null) : raw;
        groups.set(value, [...(groups.get(value) ?? []), row[field]]);
      }
      return named([...groups].map(([value, numbers]) => ({ value, number: amount(aggregate(numbers, how)) })).sort(most));
    }
    const key = split.kind === "date" ? sql<string>\`substr(\${split.column}, 1, 7)\` : split.kind === "instant" ? sql<string>\`strftime('%Y-%m', \${split.column} / 1000, 'unixepoch')\` : sql\`\${split.column}\`;
    const column = NUMBERS[field];
    if (how !== "count" && !column)
      throw new BadInput(\`\${how} needs a number field: \${[...Object.keys(NUMBERS), ...COMPUTED].join(", ") || "there are none"}.\`);
    const pick = how === "count" || !column ? count() : { sum, average: avg, smallest: min, largest: max }[how](column);
    return named(
      db
        .select({ value: key, number: pick })
        .from(schema.instructors)
        .where(condition)
        .groupBy(key)
        .all()
        .map((r) => ({ value: r.value, number: r.number === null ? null : amount(Number(r.number)) }))
        .sort(most),
    );
  },

  /**
   * The records that fit, with their computed fields worked out: for adding those up. At most
   * 10,000, so one call never reads a whole large table; more are refused with how to narrow them.
   */
  async computedRows(condition: SQL | undefined): Promise<Record<string, unknown>[]> {
    const rows = await db.query.instructors.findMany({ where: condition, limit: 10001 });
    if (rows.length > 10000)
      throw new BadInput("More than 10,000 records to add up a computed field over: narrow them with where.");
    return rows.map((row) => row as Record<string, unknown>);
  },

  /** The instructors the viewer may read whose name has the text: a few, for naming one. */
  named(viewer: Viewer | null, text: string): { id: number; title: string }[] {
    return db
      .select({ id: schema.instructors.id, title: schema.instructors.name })
      .from(schema.instructors)
      .where(and(instructorData.readable(viewer), contains([schema.instructors.name], text)))
      .limit(6)
      .all()
      .map((row) => ({ id: row.id, title: String(row.title) }));
  },

  /** The condition for records the viewer may read that fit \`where\` and \`search\`. */
  fitting(viewer: Viewer | null, where?: unknown, search?: string) {
    return and(
      instructorData.readable(viewer),
      whereOf(FILTERABLE, where, viewer ? eq(schema.instructors.ownerId, viewer.id) : undefined, viewer?.id, {}),
      // Every word somewhere in the texts ("ship lamp" finds "ship's lamp").
      ...wordsOf(search).map((word) => contains([schema.instructors.name, schema.instructors.bio], word)),
    );
  },

  /** How many instructors the viewer may read, for a data page's overview; none to read: null. */
  count(viewer: Viewer | null): number | null {
    if (readScope(instructorAccess.read, viewer) === "none") return null;
    return db.select({ n: count() }).from(schema.instructors).where(instructorData.readable(viewer)).get()?.n ?? 0;
  },

  async get(viewer: Viewer | null, id: number) {
    const fetched = await db.query.instructors.findFirst({
      where: and(eq(schema.instructors.id, id), instructorData.readable(viewer)),
    });
    const found = fetched && instructorData.shownRefs(viewer, [fetched])[0];
    const row = found && shownTo(viewer, found);
    return row ? row : null;
  },

  async create(viewer: Viewer | null, values: InstructorValues) {
    check(instructorAccess.create, viewer);
    values = checkFiles(viewer, values);
    let row: typeof schema.instructors.$inferSelect;
    try {
      row = db.transaction((tx) => {
        const made = tx.insert(schema.instructors).values({ ...values, ownerId: personOf(viewer) }).returning().get();
        audit(tx, viewer, { action: "created", model: "Instructor", record: made.id });
        return made;
      });
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterCreate", "Instructor", row, viewer);
    return row;
  },

  /** Changes the record; \`what\` names the change in the audit log (an action's name). */
  async update(viewer: Viewer | null, id: number, values: InstructorValues, what = "changed") {
    const row = db
      .select({ ownerId: schema.instructors.ownerId, portrait: schema.instructors.portrait })
      .from(schema.instructors)
      .where(and(eq(schema.instructors.id, id), instructorData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(instructorAccess.write, viewer, row.ownerId);
    values = checkFiles(viewer, values, db.select({ portrait: schema.instructors.portrait }).from(schema.instructors).where(eq(schema.instructors.id, id)).get());
    let changed: typeof schema.instructors.$inferSelect;
    const updated = values;
    try {
      changed = db.transaction((tx) => {
        const before = tx.select().from(schema.instructors).where(eq(schema.instructors.id, id)).get();
        const after = tx.update(schema.instructors).set(updated).where(eq(schema.instructors.id, id)).returning().get();
        audit(tx, viewer, { action: what, model: "Instructor", record: id, fields: before && changedFields(before, after, Object.keys(updated)) });
        return after;
      });
    } catch (error) {
      throw refusal(error);
    }
    if (row.portrait && row.portrait.file !== changed.portrait?.file) deletePicture(row.portrait, !!db.select({ id: schema.instructors.id }).from(schema.instructors).where(sql\`\${schema.instructors.portrait} like \${\`%"file":"\${row.portrait.file}"%\`}\`).get());
    await afterChange("afterUpdate", "Instructor", changed, viewer);
    return changed;
  },

  /** Deletes the record; \`together\` takes the records that point to it along to the trash (delete-together.md). */
  async remove(viewer: Viewer | null, id: number, _together = false): Promise<void> {
    const row = db
      .select({ name: schema.instructors.name, ownerId: schema.instructors.ownerId, portrait: schema.instructors.portrait })
      .from(schema.instructors)
      .where(and(eq(schema.instructors.id, id), instructorData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(instructorAccess.delete, viewer, row.ownerId);
    try {
      db.transaction((tx) => {
        const used = usedBy(tx, id, String(row.name ?? id));
        if (used) throw new Conflict(\`in-use:\${JSON.stringify(used)}\`);
        const gone = tx.delete(schema.instructors).where(eq(schema.instructors.id, id)).returning().get();
        if (gone) {
          audit(tx, viewer, { action: "deleted", model: "Instructor", record: id, title: gone.name });
        }
      });
    } catch (error) {
      throw refusal(error);
    }
    if (row.portrait && row.portrait.file !== undefined) deletePicture(row.portrait, !!db.select({ id: schema.instructors.id }).from(schema.instructors).where(sql\`\${schema.instructors.portrait} like \${\`%"file":"\${row.portrait.file}"%\`}\`).get());
    await afterDelete("Instructor", id, viewer);
  },

  /**
   * Deletes the chosen records the viewer may delete, all or none (one still in use stops them
   * all, and is named); the others are skipped.
   */
  async removeMany(viewer: Viewer | null, ids: number[], _together = false): Promise<{ deleted: number; skipped: number }> {
    const rows = db
      .select({ id: schema.instructors.id, name: schema.instructors.name, ownerId: schema.instructors.ownerId, portrait: schema.instructors.portrait })
      .from(schema.instructors)
      .where(and(inArray(schema.instructors.id, ids), instructorData.readable(viewer)))
      .all()
      .filter((row) => allows(instructorAccess.delete, viewer, row.ownerId));
    db.transaction((tx) => {
      for (const row of rows)
        try {
          const used = usedBy(tx, row.id, String(row.name ?? row.id));
          if (used) throw new Conflict(\`in-use:\${JSON.stringify(used)}\`);
          const gone = tx.delete(schema.instructors).where(eq(schema.instructors.id, row.id)).returning().get();
          if (gone) {
            audit(tx, viewer, { action: "deleted", model: "Instructor", record: row.id, title: gone.name });
          }
        } catch (error) {
          const refused = refusal(error);
          throw refused instanceof Conflict && refused.message === "in-use" ? new Conflict(\`in-use:\${row.id}\`) : refused;
        }
    });
    for (const row of rows) {
      if (row.portrait && row.portrait.file !== undefined) deletePicture(row.portrait, !!db.select({ id: schema.instructors.id }).from(schema.instructors).where(sql\`\${schema.instructors.portrait} like \${\`%"file":"\${row.portrait.file}"%\`}\`).get());
      await afterDelete("Instructor", row.id, viewer);
    }
    return { deleted: rows.length, skipped: new Set(ids).size - rows.length };
  },

  /**
   * The instructors the viewer may read whose name contains the text: a search of records that
   * refer to them finds them only among these.
   */
  titled(viewer: Viewer | null, text: string): number[] {
    return db
      .select({ id: schema.instructors.id })
      .from(schema.instructors)
      .where(and(contains([schema.instructors.name], text), instructorData.readable(viewer)))
      .all()
      .map((row) => row.id);
  },

  /** Choices for fields that refer to a instructor: the ones the viewer may read. */
  options(viewer: Viewer | null) {
    if (readScope(instructorAccess.read, viewer) === "none") return [];
    return db
      .select({ value: schema.instructors.id, label: schema.instructors.name })
      .from(schema.instructors)
      .where(instructorData.readable(viewer))
      .orderBy(asc(schema.instructors.name))
      .all();
  },
};
"
`;

exports[`../../../examples/booking/smithable.yml > file list and generated code > src/generated/instructor.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { z } from "zod";
import type * as schema from "#/db/schema";
import { allows, type Rule } from "#/kit/access";
import type { RecordUi } from "#/kit/model";
import { MarkdownEditor, MarkdownText } from "#/kit/Markdown";
import { bindPicture } from "#/kit/PictureInput";
import { instructorAccess, instructorData } from "./instructor.server";
import { writeAllowed } from "#/kit/limit";
import { currentViewer } from "#/lib/viewer.server";
import { instructorSchema } from "./instructor.schema";

export type { InstructorValues } from "./instructor.schema";

/** The viewer about to write, counted against how often one may (see src/kit/limit.ts). */
async function writer() {
  const viewer = await currentViewer();
  writeAllowed(viewer, getRequestHeaders());
  return viewer;
}

/** Instructor records as the kit reads them. */
export type InstructorRow = typeof schema.instructors.$inferSelect;

export const instructorUi: RecordUi<InstructorRow> = {
  model: "Instructor",
  label: "Instructor",
  pluralLabel: "Instructors",
  titleField: "name",
  columns: ["name", "portrait"],
  fields: [
    {
      name: "name",
      label: "Name",
      kind: "string",
      required: true,
      get: (row) => row.name,
    },
    {
      name: "bio",
      label: "Bio",
      kind: "markdown",
      required: false,
      input: MarkdownEditor,
      view: MarkdownText,
      get: (row) => row.bio,
    },
    {
      name: "portrait",
      label: "Portrait",
      kind: "picture",
      required: false,
      input: bindPicture("instructor", "portrait"),
      get: (row) => row.portrait,
    },
  ],
};

/** Who may delete instructors: a list's selection offers Delete by it (the server checks again). */
export const instructorDeleteRule: Rule = { public: false, roles: ["admin"], owner: true };


export const listInstructors = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return { rows: await instructorData.list(viewer), canCreate: allows(instructorAccess.create, viewer) };
});

export const getInstructor = createServerFn()
  .validator(z.number().int())
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    const row = await instructorData.get(viewer, id);
    if (!row) return null;
    return {
      row,
      canWrite: allows(instructorAccess.write, viewer, row.ownerId),
      canDelete: allows(instructorAccess.delete, viewer, row.ownerId),
    };
  });

/** Choices for fields that refer to a instructor. */
export const instructorOptions = createServerFn().handler(async () =>
  instructorData.options(await currentViewer()),
);

export const createInstructor = createServerFn({ method: "POST" })
  .validator(instructorSchema)
  .handler(async ({ data }) => instructorData.create(await writer(), data));

export const updateInstructor = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), values: instructorSchema }))
  .handler(async ({ data }) => instructorData.update(await writer(), data.id, data.values));

/** Deletes a instructor; \`together\` takes what points to it along (docs/design/delete-together.md). */
export const deleteInstructor = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), together: z.boolean().optional() }))
  .handler(async ({ data }) => instructorData.remove(await writer(), data.id, data.together));

/** Deletes the chosen instructors, all or none (at most 1,000 at once). */
export const deleteInstructors = createServerFn({ method: "POST" })
  .validator(z.object({ ids: z.array(z.number().int()).max(1000), together: z.boolean().optional() }))
  .handler(async ({ data }) => instructorData.removeMany(await writer(), data.ids, data.together));
"
`;

