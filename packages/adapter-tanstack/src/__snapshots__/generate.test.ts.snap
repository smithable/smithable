"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { z } from "zod";
import { postAccess, postData } from "#/generated/post.server";
import { type PostRow } from "#/generated/post";
import { allows, guardPage } from "#/kit/access";
import { currentViewer } from "#/lib/viewer.server";
import { pageAccess } from "#/generated/pages";
import { createFileRoute } from "@tanstack/react-router";
import { ArticleList } from "#/kit/Articles";
import { count, optional, type Search } from "#/kit/params";
import { LandingLayout } from "#/kit/Landing";
import { app } from "#/generated/app";
import { site } from "#/generated/site";

// The row type from the model's module: a type of the data function would keep its server
// import in the page's code.
type Row = PostRow;

/** When an article appeared, for ordering: its publishedOn. */
const when = (row: Row) => (row.publishedOn ? new Date(\`\${row.publishedOn}T00:00:00Z\`).getTime() : 0);
const dateText = (row: Row) =>
  row.publishedOn ? new Intl.DateTimeFormat("en", { dateStyle: "long", timeZone: "UTC" }).format(new Date(\`\${row.publishedOn}T00:00:00Z\`)) : undefined;
/** An article's address under the page: its address. */
const addressOf = (row: Row) => row.address || String(row.id);
const hrefOf = (row: Row) => \`/blog/\${encodeURIComponent(addressOf(row))}\`;
/** The summary, else the body's first paragraph without its marks. */
const summaryOf = (row: Row) => {
  const first = (row.body ?? "").split(/\\n\\s*\\n/).find((b) => b.trim() && !b.trim().startsWith("#")) ?? "";
  const text = row.summary || first;
  const plain = text.replace(/[#*_\`>[\\]]|\\(https?:[^)]*\\)/g, "").trim();
  return plain.length > 200 ? \`\${plain.slice(0, 199)}…\` : plain || undefined;
};
const cardOf = (row: Row) => ({
  href: hrefOf(row),
  title: String(row.title ?? ""),
  summary: summaryOf(row),
  date: dateText(row),
  picture: row.cover ? { src: \`/files/post/\${row.id}/cover\`, alt: row.cover.alt, width: row.cover.width, height: row.cover.height, generated: row.cover.generated } : undefined,
});

/** Newest first: by when they appeared, then by creation. */
const newestFirst = (rows: Row[]) => [...rows].sort((a, b) => when(b) - when(a) || b.id - a.id);

const getArticles = createServerFn()
  .validator(z.number().int().min(1))
  .handler(async ({ data: page }) => {
    // In the handler: the data function is the server's alone.
    const viewer = await currentViewer();
    const rows = newestFirst(await postData.list(viewer));
    const start = (page - 1) * 12;
    return {
      items: rows.slice(start, start + 12).map(cardOf),
      more: rows.length > start + 12,
      canCreate: allows(postAccess.create, viewer),
    };
  });

export const Route = createFileRoute("/blog/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["blog"], context.viewer, location.href),
  head: () => ({ meta: [{"title":"Blog · Stillwater Yoga"}] }),
  validateSearch: (s: Search) => optional({ page: count(s.page) }),
  loaderDeps: ({ search }) => ({ page: search.page ?? 1 }),
  loader: ({ deps }) => getArticles({ data: deps.page }),
  component: ArticlesPage,
});

function ArticlesPage() {
  const { items, more } = Route.useLoaderData();
  const { page = 1 } = Route.useSearch();
  const list = (
    <ArticleList
      items={items}
      older={more ? \`?page=\${page + 1}\` : undefined}
      newer={page > 1 ? (page === 2 ? "/blog" : \`?page=\${page - 1}\`) : undefined}
    />
  );
  return (
    <LandingLayout appName={app.name} site={site}>
      <div className="mx-auto max-w-6xl px-5 py-12">
        <h1 className="mb-6 text-3xl font-bold">{"Blog"}</h1>
        {list}
      </div>
    </LandingLayout>
  );
}
"
`;

exports[`../../../examples/booking/smithable.yml > file list and generated code > src/routes/class-types/$id.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, notFound, useNavigate } from "@tanstack/react-router";
import { createServerFn } from "@tanstack/react-start";
import { and, desc, eq } from "drizzle-orm";
import { db } from "#/db";
import { auditLog, user } from "#/db/schema";
import { app } from "#/generated/app";
import { pageAccess } from "#/generated/pages";
import { classTypeUi, deleteClassType, getClassType, updateClassType } from "#/generated/class-type";
import { classTypeSchema } from "#/generated/class-type.schema";
import { guardPage } from "#/kit/access";
import { ActivityLog } from "#/kit/ActivityLog";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";
import { w } from "#/kit/words";
import { currentViewer } from "#/lib/viewer.server";

/** The record's lines in the audit log, newest first: administrators only, nobody else. */
const getHistory = createServerFn()
  .validator((id: number) => id)
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    if (viewer?.role !== "admin") return null;
    const people = new Map(db.select({ id: user.id, name: user.name }).from(user).all().map((p) => [p.id, p.name]));
    return db
      .select()
      .from(auditLog)
      .where(and(eq(auditLog.model, "ClassType"), eq(auditLog.recordId, id)))
      .orderBy(desc(auditLog.id))
      .limit(50)
      .all()
      .map((r) => ({
        id: r.id,
        at: r.at,
        who: r.who === "visitor" || r.who === "the app" ? r.who : (people.get(r.who) ?? (r.who.startsWith("key:") ? w.aKey(r.who.slice(4)) : w.aRemovedUser(r.who))),
        action: r.action,
        fields: r.fields,
        details: r.details ? Object.fromEntries(Object.entries(r.details).map(([k, v]) => [k, String(v)])) : null,
      }));
  });

export const Route = createFileRoute("/class-types/$id")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["class-types"], context.viewer, location.href),
  head: () => ({ meta: [{"title":"Class types · Stillwater Yoga"}] }),
  loader: async ({ params }) => {
    const found = await getClassType({ data: Number(params.id) });
    if (!found) throw notFound();
    return { ...found, history: await getHistory({ data: Number(params.id) }) };
  },
  component: ClassTypePage,
});

function ClassTypePage() {
  const { row, canWrite, canDelete, history } = Route.useLoaderData();
  const navigate = useNavigate();
  const back = () => navigate({ to: "/class-types" });
  return (
    <>
      <PageHeader title={row.name || \`Class type #\${row.id}\`} />
      <ModelForm
        key={String(row.updatedAt)}
        ui={classTypeUi}
        app={app}
        schema={classTypeSchema}
        initial={row}
        readOnly={!canWrite}
        submitLabel={w.saveChanges}
        onSubmit={async (values) => {
          await updateClassType({ data: { id: row.id, values } });
          await back();
        }}
        onCancel={back}
        onDelete={
          canDelete
            ? async (together?: boolean) => {
                await deleteClassType({ data: { id: row.id, together } });
                await back();
              }
            : undefined
        }
      />

      {history && history.length > 0 && (
        <section className="mt-10 max-w-3xl">
          <h2 className="mb-3 text-lg font-semibold">{w.history}</h2>
          <ActivityLog lines={history} app={app} />
        </section>
      )}
    </>
  );
}
"
`;

exports[`../../../examples/booking/smithable.yml > file list and generated code > src/routes/class-types/index.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, Link, useNavigate, useRouter } from "@tanstack/react-router";
import { pageAccess } from "#/generated/pages";
import { guardPage, allows } from "#/kit/access";
import { createServerFn } from "@tanstack/react-start";
import { classTypeAccess, classTypeData } from "#/generated/class-type.server";
import { currentViewer } from "#/lib/viewer.server";
import { type Search, count, listQuery, optional } from "#/kit/params";
import { buttonVariants } from "#/components/ui/button";
import { useState } from "react";
import { SelectionBar } from "#/kit/SelectionBar";
import { csvName, csvOf, download } from "#/kit/csv";
import { deleteClassTypes, classTypeDeleteRule, classTypeUi } from "#/generated/class-type";
import { app } from "#/generated/app";
import { w } from "#/kit/words";
import { PageHeader } from "#/kit/AppShell";
import { ModelTable } from "#/kit/ModelTable";

/** A page of the class types the viewer may read. */
const listClassTypes = createServerFn()
  .validator(listQuery)
  .handler(async ({ data }) => {
    const viewer = await currentViewer();
    return { ...(await classTypeData.page(viewer, undefined, undefined, data.all ? 1 : data.page, data.all ? (viewer ? 10000 : 500) : undefined)), canCreate: allows(classTypeAccess.create, viewer) };
  });

export const Route = createFileRoute("/class-types/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["class-types"], context.viewer, location.href),
  head: () => ({ meta: [{"title":"Class types · Stillwater Yoga"}] }),
  validateSearch: (s: Search) => optional({ page: count(s.page) }),
  loaderDeps: ({ search }) => ({ page: search.page }),
  loader: ({ deps }) => listClassTypes({ data: { page: deps.page } }),
  component: ClassTypesPage,
});

function ClassTypesPage() {
  const { rows, canCreate, total, page: at, size } = Route.useLoaderData();
  const { viewer } = Route.useRouteContext();
  const navigate = useNavigate({ from: "/class-types/" });
  const router = useRouter();
  // The chosen rows, offered when the viewer may do something to at least one row.
  const [selected, setSelected] = useState<Set<number>>(new Set());
  const chosen = rows.filter((row) => selected.has(row.id));
  const selectable = rows.some((row) => allows(classTypeDeleteRule, viewer, row.ownerId));
  const newButton = canCreate && (
    <Link to="/class-types/new" className={buttonVariants()}>
      {w.newOne("class type")}
    </Link>
  );
  return (
    <>
      <PageHeader
        page="class-types"
        title="Class types"
        actions={newButton}
      />
      {selectable && (
        <SelectionBar
          count={chosen.length}
          noun={["class type", "class types"]}
          app={app}
          titleOf={(id) => String(rows.find((row) => row.id === id)?.name ?? id)}
          actions={[]}
          deletable={chosen.filter((row) => allows(classTypeDeleteRule, viewer, row.ownerId)).length}
          onDelete={(together) => deleteClassTypes({ data: { ids: chosen.map((row) => row.id), together } })}
          onDone={async () => {
            setSelected(new Set());
            await router.invalidate();
          }}
          onExport={() => download(csvName(classTypeUi), csvOf(classTypeUi, chosen))}
        />
      )}
      <ModelTable
        ui={classTypeUi}
        page="class-types"
        paging={{ page: at, size, total, to: (next) => navigate({ to: "/class-types", search: (prev) => ({ ...prev, page: next > 1 ? next : undefined }) }) }}
        app={app}
        exportRows={async () => (await listClassTypes({ data: { all: true } })).rows}
        rows={rows}
        selection={selectable ? { ids: selected, onChange: setSelected } : undefined}
        emptyAction={newButton || undefined}
        onOpen={(row) => navigate({ to: "/class-types/$id", params: { id: String(row.id) } })}
      />
    </>
  );
}
"
`;

