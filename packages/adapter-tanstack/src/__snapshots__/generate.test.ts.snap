import { bookingSchema } from "#/generated/booking.schema";
import { sessionOptions } from "#/generated/session";
import { guardPage } from "#/kit/access";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";
import { w } from "#/kit/words";
import { count, optional, type Search } from "#/kit/params";

export const Route = createFileRoute("/my-bookings/new")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["my-bookings"], context.viewer, location.href),
  head: () => ({ meta: [{"title":"My bookings · Stillwater Yoga"}] }),
  validateSearch: (s: Search) => optional({ session: count(s.session) }),
  loader: async () => ({ options: { sessionId: await sessionOptions() } }),
  component: NewBookingPage,
});

function NewBookingPage() {
  const { options } = Route.useLoaderData();
  const search = Route.useSearch();
  const navigate = useNavigate();
  const back = () => search.session ? navigate({ to: "/sessions/$id", params: { id: String(search.session) } }) : navigate({ to: "/my-bookings" });
  return (
    <>
