import { createInsertSchema } from "drizzle-zod";
import type { z } from "zod";
import * as schema from "#/db/schema";

/** What a session's form sends, checked. */
export const sessionSchema = createInsertSchema(schema.sessions).omit({ id: true, ownerId: true, createdAt: true, updatedAt: true });

export type SessionValues = z.output<typeof sessionSchema>;
"
