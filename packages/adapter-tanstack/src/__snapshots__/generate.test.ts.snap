exports[`../../../examples/api/smithable.yml > file list and generated code > src/routes/sign-in.tsx 1`] = `
"// Generated by Smithable from smithable.auth.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, useRouter } from "@tanstack/react-router";
import { createServerFn } from "@tanstack/react-start";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { eq } from "drizzle-orm";
import { db } from "#/db";
import { invitation, user } from "#/db/schema";
import { oneOf, optional, type Search, shaped, text } from "#/kit/params";
import { app } from "#/generated/app";
import { ROLE_LABELS } from "#/generated/roles";
import { SignIn } from "#/kit/SignIn";
import { w } from "#/kit/words";
import { auth, codesReachPeople, configuredProviders, demoSignIn, mailKept, PROVIDERS } from "#/lib/auth";
import { authClient } from "#/lib/auth-client";

const ROLES = ["admin","member","assistant"] as const;

/** The sign-in choices, and whom an invitation link is for (by its token; never signs anyone in). */
const signInOptions = createServerFn()
  .validator((data: unknown) => ({ invite: text((data as Search | null)?.invite, 100) }))
  .handler(({ data }) => {
    const providers = configuredProviders();
    const invited = data.invite
      ? db
          .select({ email: invitation.email, role: invitation.role, expiresAt: invitation.expiresAt })
          .from(invitation)
          .where(eq(invitation.token, data.invite))
          .get()
      : undefined;
    const open = invited && invited.expiresAt.getTime() > Date.now() ? invited : undefined;
    return {
      providers,
      missing: PROVIDERS.filter((p) => !providers.includes(p)),
      demo: demoSignIn,
      invitation: open ? { email: open.email, role: ROLE_LABELS[open.role] ?? open.role } : null, codes: codesReachPeople(), kept: mailKept(),
    };
  });

/** The development sign-in's passwords, by address, for this process only. */
const devPasswords = new Map<string, string>();

/** Development, or a demo: signs in as a user with the role, without a provider. */
const devSignIn = createServerFn({ method: "POST" })
  .validator((role: unknown) => {
    const known = oneOf(role, ROLES);
    if (!known) throw new Error("No such role.");
    return known;
  })
  .handler(async ({ data: role }) => {
    if (!import.meta.env.DEV && !demoSignIn) throw new Error(w.developmentOnlyNote);
    const prefix = demoSignIn && !import.meta.env.DEV ? "demo" : "dev";
    const email = \`\${prefix}-\${role}@example.com\`;
    // One password per user while this process runs, never a known one: nobody signs in as them
    // without this button, and two tabs signing in at once (Studio and its guide) use the same.
    const password = devPasswords.get(email) ?? crypto.randomUUID() + crypto.randomUUID();
    devPasswords.set(email, password);
    const context = await auth.$context;
    const made = () => db.select({ id: user.id }).from(user).where(eq(user.email, email)).get();
    if (!made()) {
      // Two tabs signing in at once (Studio and its guide): the other may make the user first.
      try {
        const created = await context.internalAdapter.createUser({ email, name: \`\${prefix === "demo" ? "Demo" : "Dev"} \${role}\`, emailVerified: true }, { method: "admin" });
        await context.internalAdapter.linkAccount({ providerId: "credential", accountId: created.id, password: await context.password.hash(password), userId: created.id });
      } catch (error) {
        if (!made()) throw error;
      }
    }
    db.update(user).set({ role }).where(eq(user.email, email)).run();
    const signIn = () => auth.api.signInEmail({ body: { email, password }, headers: getRequestHeaders() });
    // After a restart (or a password someone changed) the user's is another one: set anew.
    await signIn().catch(async () => {
      await context.internalAdapter.updatePassword(made()?.id as string, await context.password.hash(password));
      await signIn();
    });
  });

export const Route = createFileRoute("/sign-in")({
  // Only paths within the app, so the page cannot send anyone elsewhere.
  validateSearch: (s: Search) => optional({
    redirect: shaped(s.redirect, /^\\/(?!\\/)/),
    invite: text(s.invite, 100),
  }),
  loaderDeps: ({ search }) => ({ invite: search.invite }),
  loader: ({ deps }) => signInOptions({ data: { invite: deps.invite } }),
  component: SignInPage,
});

function SignInPage() {
  const { providers, missing, demo, invitation, codes, kept } = Route.useLoaderData();
  const { redirect = "/" } = Route.useSearch();
  const router = useRouter();
  return (
    <SignIn
      appName={app.name}
      providers={providers}
      missing={missing}
      invitation={invitation}
      invitedOnly
      devRoles={import.meta.env.DEV || demo ? [...ROLES] : undefined}
      demo={demo}
      onProvider={async (provider) => {
        const { error } = await authClient.signIn.social({ provider, callbackURL: redirect });
        if (error) throw new Error(error.message);
      }}
      codes={codes}
      kept={kept}
      onSendCode={async (address) => {
        const { error } = await authClient.emailOtp.sendVerificationOtp({ email: address, type: "sign-in" });
        if (error) throw new Error(error.message);
      }}
      onCode={async (address, code) => {
        const { error } = await authClient.signIn.emailOtp({ email: address, otp: code.replace(/\\s/g, "") });
        if (error) throw new Error(error.message);
        await router.invalidate();
        await router.navigate({ href: redirect });
      }}
      onDevRole={async (role) => {
        await devSignIn({ data: role as (typeof ROLES)[number] });
        await router.invalidate();
        await router.navigate({ href: redirect });
      }}
    />
  );
}
"
`;

exports[`../../../examples/api/smithable.yml > file list and generated code > src/routes/team/activity.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, useNavigate, useRouter } from "@tanstack/react-router";
import { createServerFn } from "@tanstack/react-start";
import { and, desc, eq, gte, inArray, lt } from "drizzle-orm";
import { z } from "zod";
import { db } from "#/db";
import { apiKey, auditLog, user } from "#/db/schema";
import * as schema from "#/db/schema";
import { app } from "#/generated/app";
import { projectUi } from "#/generated/project";
import { taskUi } from "#/generated/task";
import { noteUi } from "#/generated/note";
import { pageAccess } from "#/generated/pages";
import { AccessDenied, guardPage } from "#/kit/access";
import { ActivityLog } from "#/kit/ActivityLog";
import { PageHeader } from "#/kit/AppShell";
import { forgetInLog } from "#/kit/audit.server";
import { count, optional, type Search, text } from "#/kit/params";
import { w } from "#/kit/words";
import { currentViewer } from "#/lib/viewer.server";

/** The activity's filters, from the address. */
const filters = (s: Search) => optional({
  who: text(s.who),
  model: text(s.model),
  record: count(s.record),
  action: text(s.action),
  from: text(s.from),
  to: text(s.to),
});

/** Each model's label, for the filter and the lines. */
const LABELS: Record<string, string> = { Project: projectUi.label, Task: taskUi.label, Note: noteUi.label };

/** The newest lines that match, named for people (administrators only). */
const getActivity = createServerFn()
  .validator(filters)
  .handler(async ({ data }) => {
    const viewer = await currentViewer();
    if (viewer?.role !== "admin") throw new AccessDenied(viewer !== null);
    const day = 24 * 60 * 60 * 1000;
    const rows = db
      .select()
      .from(auditLog)
      .where(
        and(
          data.who ? eq(auditLog.who, data.who) : undefined,
          data.model ? eq(auditLog.model, data.model) : undefined,
          data.record ? eq(auditLog.recordId, data.record) : undefined,
          data.action ? eq(auditLog.action, data.action) : undefined,
          data.from ? gte(auditLog.at, new Date(data.from)) : undefined,
          data.to ? lt(auditLog.at, new Date(new Date(data.to).getTime() + day)) : undefined,
        ),
      )
      .orderBy(desc(auditLog.id))
      .limit(200)
      .all();
    const people = db.select({ id: user.id, name: user.name }).from(user).orderBy(user.name).all();
    const named = new Map(people.map((p) => [p.id, p.name]));
    // A record by its title now; a deleted one keeps the title its delete line has, or its id.
    const ids = (model: string) => [
      ...new Set(rows.filter((r) => r.model === model && r.recordId != null).map((r) => r.recordId as number)),
    ];
    const titles = new Map<string, Map<number, string>>([
      [
        "Project",
        new Map(
          db
            .select({ id: schema.projects.id, title: schema.projects.name })
            .from(schema.projects)
            .where(inArray(schema.projects.id, ids("Project")))
            .all()
            .map((r) => [r.id, String(r.title ?? r.id)]),
        ),
      ],
      [
        "Task",
        new Map(
          db
            .select({ id: schema.tasks.id, title: schema.tasks.title })
            .from(schema.tasks)
            .where(inArray(schema.tasks.id, ids("Task")))
            .all()
            .map((r) => [r.id, String(r.title ?? r.id)]),
        ),
      ],
      [
        "Note",
        new Map(
          db
            .select({ id: schema.notes.id, title: schema.notes.title })
            .from(schema.notes)
            .where(inArray(schema.notes.id, ids("Note")))
            .all()
            .map((r) => [r.id, String(r.title ?? r.id)]),
        ),
      ],
    ]);
    // A key's lines name the key ("key:3" is the key made as "Uptime monitor").
    for (const k of db.select({ id: apiKey.id, name: apiKey.name }).from(apiKey).all())
      named.set(\`key:\${k.id}\`, w.keyNamed(k.name));
    // A key's line once keys are gone from the app (the API turned off) still says it was a key;
    // a timer's line names the timer (docs/design/timed-actions.md §2).
    const removedUser = (id: string) =>
      named.get(id) ??
      (id.startsWith("key:")
        ? w.aKey(id.slice(4))
        : id.startsWith("timer:")
          ? w.byTimer(id.slice(6))
          : w.aRemovedUser(id));
    const lines = rows.map((r) => {
      const label = r.model ? LABELS[r.model] : undefined;
      const now = r.model && r.recordId != null ? titles.get(r.model)?.get(r.recordId) : undefined;
      const gone = label && r.recordId != null && now === undefined;
      const removed = r.action === "user removed" ? String(r.details?.user ?? "") : "";
      return {
        id: r.id,
        at: r.at,
        who: r.who === "visitor" || r.who === "the app" ? r.who : (removedUser(r.who) ?? r.who),
        action: r.action,
        record: now
          ? \`\${label} "\${now}"\`
          : gone
            ? r.title
              ? w.deletedNamed(label ?? "", r.title)
              : w.aDeletedOne(label ?? "", String(r.recordId))
            : undefined,
        fields: r.fields,
        // As text: what touches security, by name and value.
        details: r.details ? Object.fromEntries(Object.entries(r.details).map(([k, v]) => [k, String(v)])) : null,
        forget:
          gone && r.action === "deleted" && r.model
            ? { model: r.model, record: r.recordId as number }
            : removed && !named.has(removed)
              ? { user: removed }
              : undefined,
      };
    });
    const actions = db.selectDistinct({ action: auditLog.action }).from(auditLog).all().map((a) => a.action).sort();
    return { lines, people, actions };
  });

const forget = createServerFn({ method: "POST" })
  .validator(z.union([z.object({ model: z.string(), record: z.number().int() }), z.object({ user: z.string() })]))
  .handler(async ({ data }) => forgetInLog(await currentViewer(), data));

export const Route = createFileRoute("/team/activity")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["team"], context.viewer, location.href),
  validateSearch: filters,
  loaderDeps: ({ search }) => search,
  loader: ({ deps }) => getActivity({ data: deps }),
  component: ActivityPage,
});

function ActivityPage() {
  const { lines, people, actions } = Route.useLoaderData();
  const search = Route.useSearch();
  const navigate = useNavigate();
  const router = useRouter();
  return (
    <>
      <PageHeader page="team" title={w.activity} subtitle={w.activityLead} />
      <ActivityLog
        lines={lines}
        filters={search}
        people={people}
        models={Object.entries(LABELS).map(([name, label]) => ({ name, label }))}
        actions={actions}
        app={app}
        onFilter={(next) => navigate({ to: "/team/activity", search: next, replace: true, resetScroll: false })}
        onForget={async (target) => {
          await forget({ data: target });
          await router.invalidate();
        }}
      />
    </>
  );
}
"
`;

exports[`../../../examples/api/smithable.yml > file list and generated code > src/routes/team/index.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, useRouter } from "@tanstack/react-router";
import { createServerFn } from "@tanstack/react-start";
import { z } from "zod";
import { app } from "#/generated/app";
import { pageAccess, pageUi, pageHead } from "#/generated/pages";
import { ROLE_LABELS } from "#/generated/roles";
import {
  invite,
  listUsers,
  origin,
  removeUser,
  resendInvitation,
  type Role,
  ROLES,
  setRole,
  usesOf,
  withdrawInvitation,
} from "#/generated/users.server";
import { listKeys, makeKey, revokeKey } from "#/generated/keys.server";
import { guardPage } from "#/kit/access";
import { PageHeader } from "#/kit/AppShell";
import { Keys } from "#/kit/Keys";
import { inviteAllowed } from "#/kit/limit";
import { mailConfigured } from "#/kit/mail";
import { Users } from "#/kit/Users";
import { currentViewer } from "#/lib/viewer.server";

const ROLE_OPTIONS = [
  { value: "admin", label: ROLE_LABELS["admin"] },
  {
    value: "member",
    label: ROLE_LABELS["member"],
    description: "A team member who works with the tasks and notes.",
  },
  {
    value: "assistant",
    label: ROLE_LABELS["assistant"],
    description: "The AI assistant's key: reads everything, adds and changes tasks and notes, never deletes.",
  },
];

const getUsers = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  // Only administrators see and make keys.
  return { ...(await listUsers(viewer, origin())), keys: viewer?.role === "admin" ? listKeys(viewer) : [] };
});

const makeApiKey = createServerFn({ method: "POST" })
  .validator(z.object({ name: z.string().trim().min(1).max(100), role: z.enum(ROLES), until: z.iso.date().optional() }))
  .handler(async ({ data }) =>
    makeKey(await currentViewer(), data.name, data.role, data.until ? new Date(\`\${data.until}T23:59:59Z\`) : undefined),
  );

const revokeApiKey = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int() }))
  .handler(async ({ data }) => revokeKey(await currentViewer(), data.id));

const inviteUser = createServerFn({ method: "POST" })
  .validator(z.object({ email: z.email().max(200), role: z.enum(ROLES) }))
  .handler(async ({ data }) => {
    const viewer = await currentViewer();
    inviteAllowed(viewer);
    await invite(viewer, data.email, data.role, origin());
    return { kept: !mailConfigured() };
  });

const changeRole = createServerFn({ method: "POST" })
  .validator(z.object({ userId: z.string().max(100), role: z.enum(ROLES) }))
  .handler(async ({ data }) => {
    await setRole(await currentViewer(), data.userId, data.role);
  });

const remove = createServerFn({ method: "POST" })
  .validator(z.object({ userId: z.string().max(100), heirId: z.string().max(100).optional() }))
  .handler(async ({ data }) => {
    await removeUser(await currentViewer(), data.userId, data.heirId);
  });

const uses = createServerFn()
  .validator(z.object({ userId: z.string().max(100) }))
  .handler(async ({ data }) => usesOf(await currentViewer(), data.userId));

const resend = createServerFn({ method: "POST" })
  .validator(z.object({ invitationId: z.string().max(100) }))
  .handler(async ({ data }) => {
    const viewer = await currentViewer();
    inviteAllowed(viewer);
    await resendInvitation(viewer, data.invitationId, origin());
    return { kept: !mailConfigured() };
  });

const withdraw = createServerFn({ method: "POST" })
  .validator(z.object({ invitationId: z.string().max(100) }))
  .handler(async ({ data }) => {
    await withdrawInvitation(await currentViewer(), data.invitationId);
  });

export const Route = createFileRoute("/team/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["team"], context.viewer, location.href),
  head: () => pageHead("team"),
  loader: () => getUsers(),
  component: TeamPage,
});

function TeamPage() {
  const { users, invitations, keys } = Route.useLoaderData();
  const { viewer } = Route.useRouteContext();
  const router = useRouter();
  const then = async <T,>(change: Promise<T>) => {
    const done = await change;
    await router.invalidate();
    return done;
  };
  return (
    <>
      <PageHeader page="team" title={pageUi["team"].title} />
      <Users
        viewerId={viewer?.id}
        roles={ROLE_OPTIONS}
        users={users}
        invitations={invitations}
        onInvite={(email, role) => then(inviteUser({ data: { email, role: role as Role } }))}
        onSetRole={(userId, role) => then(changeRole({ data: { userId, role: role as Role } }))}
        onRemove={(userId, heirId) => then(remove({ data: { userId, heirId } }))}
        usesOf={(userId) => uses({ data: { userId } })}
        onResend={(invitationId) => then(resend({ data: { invitationId } }))}
        onWithdraw={(invitationId) => then(withdraw({ data: { invitationId } }))}
      />
      {viewer?.role === "admin" && (
        <Keys
          keys={keys}
          roles={ROLE_OPTIONS}
          use={{ app: app.name, path: "projects", tools: true }}
          onMake={async (name, role, until) => {
            const key = await makeApiKey({ data: { name, role: role as Role, until } });
            await router.invalidate();
            return key;
          }}
          onRevoke={(id) => then(revokeApiKey({ data: { id } }))}
        />
      )}
    </>
  );
}
"
`;

