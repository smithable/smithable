  const selectable = rows.some((row) => allows(serviceDeleteRule, viewer, row.ownerId));
  const newButton = canCreate && (
    <Link to="/services/new" className={buttonVariants()}>
      {w.newOne("service")}
    </Link>
  );
  return (
    <>
      <PageHeader
        page="services"
        title={pageUi["services"].title}
        actions={newButton}
      />
      {selectable && (
        <SelectionBar
          count={chosen.length}
          noun={["service", "services"]}
          app={app}
          titleOf={(id) => String(rows.find((row) => row.id === id)?.name ?? id)}
          actions={[]}
          deletable={chosen.filter((row) => allows(serviceDeleteRule, viewer, row.ownerId)).length}
          onDelete={(together) => deleteServices({ data: { ids: chosen.map((row) => row.id), together } })}
          onDone={async () => {
            setSelected(new Set());
            await router.invalidate();
          }}
          onExport={() => download(csvName(serviceUi), csvOf(serviceUi, chosen))}
        />
      )}
      <ModelTable
        ui={serviceUi}
        page="services"
        paging={{ page: at, size, total, to: (next) => navigate({ to: "/services", search: (prev) => ({ ...prev, page: next > 1 ? next : undefined }) }) }}
        app={app}
        exportRows={async () => (await listServices({ data: { all: true } })).rows}
        rows={rows}
        selection={selectable ? { ids: selected, onChange: setSelected } : undefined}
        emptyAction={newButton || undefined}
        onOpen={(row) => navigate({ to: "/services/$id", params: { id: String(row.id) } })}
      />
    </>
  );
}
"
`;

