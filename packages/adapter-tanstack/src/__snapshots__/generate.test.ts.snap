}

/** A session as the API gives it. */
export function sessionToApi(row: Record<string, any>) {
  return {
    id: row.id as number,
    classType: row.classTypeId ?? null,
    instructor: row.instructorId ?? null,
    startsAt: row.startsAt instanceof Date ? row.startsAt.toISOString() : (row.startsAt ?? null),
    capacity: row.capacity ?? null,
    placesLeft: row.placesLeft ?? null,
    createdAt: row.createdAt instanceof Date ? row.createdAt.toISOString() : row.createdAt,
    updatedAt: row.updatedAt instanceof Date ? row.updatedAt.toISOString() : row.updatedAt,
  };
}

/** A session's values from a body: all of them, or a change to \`current\`. */
export function sessionFromApi(body: unknown, current?: Record<string, unknown>) {
  const given = fieldsOf(body, ["classType", "instructor", "startsAt", "capacity"]);
  const values: Record<string, unknown> = { ...current };
  for (const [key, v] of Object.entries(given))
    switch (key) {
      case "classType":
        values.classTypeId = v === null ? null : whole(v, "classType");
        break;
      case "instructor":
        values.instructorId = v === null ? null : whole(v, "instructor");
        break;
      case "startsAt":
        values.startsAt = v === null ? null : moment(v, "startsAt");
        break;
      case "capacity":
        values.capacity = v;
        break;
    }
  return sessionSchema.parse(values);
}

