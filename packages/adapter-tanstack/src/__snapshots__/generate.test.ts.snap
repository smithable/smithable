exports[`../../../examples/records/smithable.yml > file list and generated code > src/generated/access.test.ts 1`] = `
"// Generated by Smithable from smithable.yml and smithable.auth.yml. Do not edit: this file is overwritten on every change.
// For every model and role: which records a user can read, create, change and delete.
// "Own" records are owned by the user; "others" by someone else.
import { describe, expect, test } from "vitest";
import { db } from "#/db";
import { items, user } from "#/db/schema";
import { AccessDenied, type Viewer } from "#/kit/access";
import { itemData } from "./item.server";

let counter = 0;
const next = () => ++counter;

/** A new signed-in user with the role. */
function signedIn(role: string): Viewer {
  const n = next();
  const viewer = { id: \`test-user-\${n}\`, name: \`Test \${role} \${n}\`, email: \`user\${n}@example.com\`, role };
  db.insert(user).values(viewer).run();
  return viewer;
}

/** Owns the records that are someone else's. */
const stranger = signedIn("member");

/** Whether the action is allowed; any other failure fails the test. */
async function can(action: () => unknown): Promise<boolean> {
  try {
    await action();
    return true;
  } catch (error) {
    if (error instanceof AccessDenied) return false;
    throw error;
  }
}

/** Whether the viewer can open the record and sees it in the list. */
async function reads(
  data: { get(viewer: never, id: number): Promise<unknown>; list(viewer: never): Promise<{ id: number }[]> },
  viewer: unknown,
  id: number,
): Promise<boolean> {
  const listed = await data.list(viewer as never).then(
    (rows) => rows.some((row) => row.id === id),
    (error) => {
      if (error instanceof AccessDenied) return false;
      throw error;
    },
  );
  return listed && (await data.get(viewer as never, id)) !== null;
}

function itemValues(_owner: string | null) {
  const n = next();
  return { name: \`Item name \${n}\`, summary: null, kind: "general", link: null, addedOn: "2026-01-15" } as const;
}

function insertItem(owner: string | null) {
  return db
    .insert(items)
    .values({ ...itemValues(owner), ownerId: owner })
    .returning()
    .get();
}

describe("Item", () => {
  test("admin", async () => {
    const viewer = signedIn("admin");
    const others = insertItem(stranger.id);
    const own = insertItem(viewer.id);
    expect({
      readOthers: await reads(itemData, viewer, others.id),
      readOwn: await reads(itemData, viewer, own.id),
      create: await can(() => itemData.create(viewer, itemValues(viewer.id))),
      changeOthers: await can(() => itemData.update(viewer, others.id, itemValues(viewer.id))),
      changeOwn: await can(() => itemData.update(viewer, own.id, itemValues(viewer.id))),
      deleteOthers: await can(() => itemData.remove(viewer, others.id)),
      deleteOwn: await can(() => itemData.remove(viewer, own.id)),
    }).toEqual({
      readOthers: true,
      readOwn: true,
      create: true,
      changeOthers: true,
      changeOwn: true,
      deleteOthers: true,
      deleteOwn: true,
    });
  });

  test("member", async () => {
    const viewer = signedIn("member");
    const others = insertItem(stranger.id);
    const own = insertItem(viewer.id);
    expect({
      readOthers: await reads(itemData, viewer, others.id),
      readOwn: await reads(itemData, viewer, own.id),
      create: await can(() => itemData.create(viewer, itemValues(viewer.id))),
      changeOthers: await can(() => itemData.update(viewer, others.id, itemValues(viewer.id))),
      changeOwn: await can(() => itemData.update(viewer, own.id, itemValues(viewer.id))),
      deleteOthers: await can(() => itemData.remove(viewer, others.id)),
      deleteOwn: await can(() => itemData.remove(viewer, own.id)),
    }).toEqual({
      readOthers: true,
      readOwn: true,
      create: false,
      changeOthers: false,
      changeOwn: false,
      deleteOthers: false,
      deleteOwn: false,
    });
  });

  test("a visitor who has not signed in", async () => {
    const viewer = null;
    const others = insertItem(stranger.id);
    expect({
      readOthers: await reads(itemData, viewer, others.id),
      readOwn: false,
      create: await can(() => itemData.create(viewer, itemValues(null))),
      changeOthers: await can(() => itemData.update(viewer, others.id, itemValues(null))),
      changeOwn: false,
      deleteOthers: await can(() => itemData.remove(viewer, others.id)),
      deleteOwn: false,
    }).toEqual({
      readOthers: true,
      readOwn: false,
      create: false,
      changeOthers: false,
      changeOwn: false,
      deleteOthers: false,
      deleteOwn: false,
    });
  });
});
"
`;

