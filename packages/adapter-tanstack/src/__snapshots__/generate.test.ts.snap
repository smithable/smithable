"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createInsertSchema } from "drizzle-zod";
import { z } from "zod";
import * as schema from "#/db/schema";
import { w } from "#/kit/words";

/** What a customer's form sends, checked. */
export const customerSchema = createInsertSchema(schema.customers, {
  name: (s) => s.trim().min(1, w.required).max(200, w.atMostCharacters(200)),
  email: z.email(w.enterValidEmail).nullish(),
  phone: (s) => s.regex(/^\\+?[0-9 ()-]{5,20}$/, w.enterValidPhone),
  creditLimit: (s) => s.min(0),
  notes: (s) => s.max(10000, w.atMostCharacters(10000)),
}).omit({ id: true, createdAt: true, updatedAt: true });

export type CustomerValues = z.output<typeof customerSchema>;
"
`;

exports[`../../../examples/crm/smithable.yml > file list and generated code > src/generated/customer.server.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { type AnyColumn, and, asc, avg, count, desc, eq, inArray, isNotNull, isNull, lt, max, min, sql, sum, type SQL } from "drizzle-orm";
import { db } from "#/db";
import * as schema from "#/db/schema";
import { AccessDenied, allows, check, Conflict, type ModelAccess, personOf, readScope, type Viewer } from "#/kit/access";
import { audit, changedFields } from "#/kit/audit.server";
import { refusal } from "#/kit/log.server";
import { contains } from "#/kit/search";
import { BadInput } from "#/kit/refusal";
import { aggregate, type Filterable, sortOf, whereOf, wordsOf } from "#/kit/where";
import { afterChange, afterDelete } from "./hooks";
import { orderData } from "./order.server";
import type { CustomerValues } from "./customer";
import "./trash.server";

/** A transaction, as the group's functions are called inside one (docs/design/delete-together.md). */
type Tx = Parameters<Parameters<typeof db.transaction>[0]>[0];

/**
 * What points to a customer (docs/design/delete-together.md): the records that would go with it
 * to the trash, by model, and those that would show no customer; nothing when nothing does.
 */
function usedBy(tx: Tx, id: number, title: string) {
  const pointing: { model: string; from: string; label: string; plural: string; depth: number; count: number | null }[] = [
    { model: "Order", label: "Order", plural: "Orders", from: "Customer", depth: 1, count: tx.select({ n: count() }).from(schema.orders).where(and(eq(schema.orders.customerId, id), isNull(schema.orders.deletedAt))).get()?.n ?? 0 },
  ];
  // A deeper member is named when its parent has records ("and what belongs to them").
  const with_: typeof pointing = [];
  for (const e of pointing)
    if (e.count === null ? with_.some((p) => p.model === e.from) : e.count > 0) with_.push(e);
  if (!with_.length) return undefined;
  const loose = [] as { model: string; label: string; plural: string; count: number }[];
  return { id, title, model: "Customer", label: "Customer", with: with_, loose, together: true, missing: [] };
}

/** Who may read, create, change and delete customers. */
export const customerAccess: ModelAccess = {
  read: { public: false, roles: ["admin", "sales"], owner: false },
  create: { public: false, roles: ["admin", "sales"], owner: false },
  write: { public: false, roles: ["admin", "sales"], owner: true },
  delete: { public: false, roles: ["admin"], owner: true },
};


/** What \`where\` may name, and how: the stored fields, by kind. */
const FILTERABLE: Record<string, Filterable> = {
  name: { kind: "text", column: schema.customers.name },
  email: { kind: "text", column: schema.customers.email },
  phone: { kind: "text", column: schema.customers.phone },
  segment: { kind: "choice", column: schema.customers.segment, values: ["smb","enterprise","government"] },
  creditLimit: { kind: "money", column: schema.customers.creditLimit },
  notes: { kind: "text", column: schema.customers.notes },
  accountManager: { kind: "reference", column: schema.customers.accountManagerId, title: { table: schema.user, column: schema.user.name } },
};

/** What the records can be sorted by. */
const SORTABLE = { id: schema.customers.id, name: schema.customers.name, email: schema.customers.email, phone: schema.customers.phone, segment: schema.customers.segment, creditLimit: schema.customers.creditLimit, notes: schema.customers.notes, createdAt: schema.customers.createdAt };

/** The number fields \`measure\` adds up; amounts are stored in cents. */
const NUMBERS: Record<string, AnyColumn> = { creditLimit: schema.customers.creditLimit };
const MONEY: string[] = ["creditLimit"];

/** Computed number fields \`measure\` adds up from the records themselves. */
const COMPUTED: string[] = [];

/** The titles of the referenced records \`measureBy\` splits by, to name its groups. */
function titlesOf(_viewer: Viewer | null, _by: string, _ids: number[]): Map<unknown, string> {
  switch (_by) {
    default:
      return new Map();
  }
}

/** What \`measureBy\` may split by: choices, yes/no, references, and dates by month. */
const BY: string[] = ["segment","accountManager"];


/**
 * Whose record it is: anyone's for a role that may change everyone's, otherwise the viewer's
 * own, whatever the form sent.
 */
function ownerFor(viewer: Viewer | null, given: string | null | undefined): string | null {
  if (viewer && customerAccess.write.roles.includes(viewer.role)) return given ?? personOf(viewer);
  return personOf(viewer);
}

/** How long a record stays in the trash, and the most a trash view shows. */
const TRASH_DAYS = 30;
const DAY = 24 * 60 * 60 * 1000;
export const customerData = {
  /** The rows with each reference to a record the viewer may not read set to nothing: a related record's title is shown only to who may read it (only its id stays). */
  shownRefs<R extends Record<string, unknown>>(_viewer: Viewer | null, rows: R[]): R[] {
    return rows;
  },

  /** A condition for the customers the viewer may read. */
  readable(viewer: Viewer | null) {
    // What is in the trash is gone to every reader (docs/design/trash.md).
    return and(isNull(schema.customers.deletedAt), customerData.scoped(viewer));
  },

  /** The records the viewer may read by the read rule, the trashed ones too. */
  scoped(viewer: Viewer | null) {
    const scope = readScope(customerAccess.read, viewer);
    if (scope === "all") return undefined;
    return scope === "own" && viewer ? eq(schema.customers.accountManagerId, viewer.id) : sql\`false\`;
  },

  canRead(viewer: Viewer | null, id: number): boolean {
    const found = db
      .select({ id: schema.customers.id })
      .from(schema.customers)
      .where(and(eq(schema.customers.id, id), customerData.readable(viewer)))
      .get();
    return found !== undefined;
  },

  /** The customers the viewer may read; \`where\` narrows them, e.g. to a search. */
  async list(viewer: Viewer | null, where?: SQL) {
    if (readScope(customerAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const rows = customerData.shownRefs(viewer, await db.query.customers.findMany({
      where: and(customerData.readable(viewer), where),
      with: { accountManager: { columns: { id: true, name: true } } },
      orderBy: (t, { desc }) => [desc(t.id)],
    }));
    return rows;
  },

  /**
   * A page of the customers the viewer may read that fit \`where\`, newest first (or in
   * \`order\`), and how many fit in all: for a list page. A page past the end is the last one.
   */
  async page(viewer: Viewer | null, where?: SQL, order?: SQL, page = 1, size = 50) {
    if (readScope(customerAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = and(customerData.readable(viewer), where);
    const total = db.select({ n: count() }).from(schema.customers).where(condition).get()?.n ?? 0;
    const at = Math.min(Math.max(1, Math.trunc(page)), Math.max(1, Math.ceil(total / size)));
    const rows = customerData.shownRefs(viewer, await db.query.customers.findMany({
      where: condition,
      with: { accountManager: { columns: { id: true, name: true } } },
      orderBy: (t, { desc }) => [...(order ? [order] : []), desc(t.id)],
      limit: size,
      offset: (at - 1) * size,
    }));
    return { rows: rows, total, page: at, size };
  },

  /**
   * The customers the viewer may read that fit \`where\` and \`search\`, in \`sort\`'s order (else newest
   * first), a page of them and how many there are: for the API and the assistants' tools.
   */
  async find(
    viewer: Viewer | null,
    options: { where?: unknown; search?: string; sort?: string; limit?: number; offset?: number } = {},
  ) {
    if (readScope(customerAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = customerData.fitting(viewer, options.where, options.search);
    const order = sortOf(SORTABLE, options.sort);
    const total = db.select({ n: count() }).from(schema.customers).where(condition).get()?.n ?? 0;
    const rows = customerData.shownRefs(viewer, await db.query.customers.findMany({
      where: condition,
      with: { accountManager: { columns: { id: true, name: true } } },
      orderBy: (t, { desc }) => [...(order ? [order] : []), desc(t.id)],
      limit: options.limit ?? 100,
      offset: options.offset ?? 0,
    }));
    return { items: rows, total };
  },

  /**
   * A number from the customers the viewer may read that fit \`where\`: how many, or the sum,
   * average, smallest or largest of a number field.
   */
  async measure(
    viewer: Viewer | null,
    how: "count" | "sum" | "average" | "smallest" | "largest",
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<number | null> {
    if (readScope(customerAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = customerData.fitting(viewer, options.where, options.search);
    if (how === "count")
      return db.select({ n: count() }).from(schema.customers).where(condition).get()?.n ?? 0;
    const field = options.field ?? "";
    const money = MONEY.includes(field);
    if (COMPUTED.includes(field)) {
      const rows = await customerData.computedRows(condition);
      const value = aggregate(rows.map((row) => row[field]), how);
      return value === null ? null : money ? value / 100 : value;
    }
    const column = NUMBERS[field];
    if (!column)
      throw new BadInput(
        \`\${how} needs a number field: \${[...Object.keys(NUMBERS), ...COMPUTED].join(", ") || "there are none"}.\`,
      );
    const pick = { sum, average: avg, smallest: min, largest: max }[how];
    const value = db.select({ v: pick(column) }).from(schema.customers).where(condition).get()?.v;
    if (value === null || value === undefined) return null;
    return money ? Number(value) / 100 : Number(value);
  },

  /** Which record holds the smallest or largest value of a number field (the first of a tie). */
  async holder(
    viewer: Viewer | null,
    how: "smallest" | "largest",
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<{ id: number; title: string } | null> {
    const condition = customerData.fitting(viewer, options.where, options.search);
    const field = options.field ?? "";
    if (COMPUTED.includes(field)) {
      let best: Record<string, unknown> | undefined;
      for (const row of await customerData.computedRows(condition)) {
        const v = row[field];
        if (typeof v !== "number") continue;
        if (!best || (how === "largest" ? v > (best[field] as number) : v < (best[field] as number))) best = row;
      }
      return best ? { id: best.id as number, title: String(best.name) } : null;
    }
    const column = NUMBERS[field];
    if (!column) return null;
    const row = db
      .select({ id: schema.customers.id, title: schema.customers.name })
      .from(schema.customers)
      .where(and(condition, isNotNull(column)))
      .orderBy(how === "largest" ? desc(column) : asc(column), asc(schema.customers.id))
      .limit(1)
      .get();
    return row ? { id: row.id, title: String(row.title) } : null;
  },

  /**
   * The same number per value of a field (a choice, yes/no, a reference) or per month of a date:
   * \`[{ value, number }]\`, the most first.
   */
  async measureBy(
    viewer: Viewer | null,
    how: "count" | "sum" | "average" | "smallest" | "largest",
    by: string,
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<{ value: unknown; title?: string; number: number | null }[]> {
    if (readScope(customerAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const split = FILTERABLE[by];
    if (!split || split.kind === "text" || split.kind === "number" || split.kind === "money")
      throw new BadInput(\`There is no field "\${by}" to split by. Fields: \${BY.join(", ")}.\`);
    const field = options.field ?? "";
    const money = MONEY.includes(field);
    const condition = customerData.fitting(viewer, options.where, options.search);
    const amount = (n: number | null) => (n === null ? null : money ? n / 100 : n);
    const most = (a: { number: number | null }, b: { number: number | null }) => (b.number ?? 0) - (a.number ?? 0);
    // A reference's groups carry the referenced record's title beside its id.
    const named = (rows: { value: unknown; number: number | null }[]) => {
      if (split.kind !== "reference") return rows;
      const titles = titlesOf(viewer, by, rows.map((r) => r.value).filter((v): v is number => typeof v === "number"));
      return rows.map((r) => (titles.has(r.value) ? { value: r.value, title: titles.get(r.value), number: r.number } : r));
    };
    if (COMPUTED.includes(field)) {
      // Each record's month or value, then the computed numbers added up per group.
      const groups = new Map<unknown, unknown[]>();
      for (const row of await customerData.computedRows(condition)) {
        const raw = row[split.kind === "reference" ? \`\${by}Id\` : by];
        const value = split.kind === "date" ? String(raw ?? "").slice(0, 7) || null : split.kind === "instant" ? (raw instanceof Date ? raw.toISOString().slice(0, 7) : null) : raw;
        groups.set(value, [...(groups.get(value) ?? []), row[field]]);
      }
      return named([...groups].map(([value, numbers]) => ({ value, number: amount(aggregate(numbers, how)) })).sort(most));
    }
    const key = split.kind === "date" ? sql<string>\`substr(\${split.column}, 1, 7)\` : split.kind === "instant" ? sql<string>\`strftime('%Y-%m', \${split.column} / 1000, 'unixepoch')\` : sql\`\${split.column}\`;
    const column = NUMBERS[field];
    if (how !== "count" && !column)
      throw new BadInput(\`\${how} needs a number field: \${[...Object.keys(NUMBERS), ...COMPUTED].join(", ") || "there are none"}.\`);
    const pick = how === "count" || !column ? count() : { sum, average: avg, smallest: min, largest: max }[how](column);
    return named(
      db
        .select({ value: key, number: pick })
        .from(schema.customers)
        .where(condition)
        .groupBy(key)
        .all()
        .map((r) => ({ value: r.value, number: r.number === null ? null : amount(Number(r.number)) }))
        .sort(most),
    );
  },

  /**
   * The records that fit, with their computed fields worked out: for adding those up. At most
   * 10,000, so one call never reads a whole large table; more are refused with how to narrow them.
   */
  async computedRows(condition: SQL | undefined): Promise<Record<string, unknown>[]> {
    const rows = await db.query.customers.findMany({ where: condition, with: { accountManager: { columns: { id: true, name: true } } }, limit: 10001 });
    if (rows.length > 10000)
      throw new BadInput("More than 10,000 records to add up a computed field over: narrow them with where.");
    return rows.map((row) => row as Record<string, unknown>);
  },

  /** The customers the viewer may read whose name has the text: a few, for naming one. */
  named(viewer: Viewer | null, text: string): { id: number; title: string }[] {
    return db
      .select({ id: schema.customers.id, title: schema.customers.name })
      .from(schema.customers)
      .where(and(customerData.readable(viewer), contains([schema.customers.name], text)))
      .limit(6)
      .all()
      .map((row) => ({ id: row.id, title: String(row.title) }));
  },

  /** The condition for records the viewer may read that fit \`where\` and \`search\`. */
  fitting(viewer: Viewer | null, where?: unknown, search?: string) {
    return and(
      customerData.readable(viewer),
      whereOf(FILTERABLE, where, viewer ? eq(schema.customers.accountManagerId, viewer.id) : undefined, viewer?.id, {}),
      // Every word somewhere in the texts ("ship lamp" finds "ship's lamp").
      ...wordsOf(search).map((word) => contains([schema.customers.name, schema.customers.email, schema.customers.phone, schema.customers.notes], word)),
    );
  },

  async get(viewer: Viewer | null, id: number) {
    const fetched = await db.query.customers.findFirst({
      where: and(eq(schema.customers.id, id), customerData.readable(viewer)),
      with: { accountManager: { columns: { id: true, name: true } }, orders: { where: orderData.readable(viewer) } },
    });
    const found = fetched && customerData.shownRefs(viewer, [fetched])[0];
    const row = found && { ...found, orders: found.orders.map((r) => orderData.shownTo(viewer, r)) };
    return row ? row : null;
  },

  async create(viewer: Viewer | null, values: CustomerValues) {
    check(customerAccess.create, viewer);
    let row: typeof schema.customers.$inferSelect;
    try {
      row = db.transaction((tx) => {
        const made = tx.insert(schema.customers).values({ ...values, accountManagerId: ownerFor(viewer, values.accountManagerId) }).returning().get();
        audit(tx, viewer, { action: "created", model: "Customer", record: made.id });
        return made;
      });
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterCreate", "Customer", row, viewer);
    return row;
  },

  /** Changes the record; \`what\` names the change in the audit log (an action's name). */
  async update(viewer: Viewer | null, id: number, values: CustomerValues, what = "changed") {
    const row = db
      .select({ accountManagerId: schema.customers.accountManagerId })
      .from(schema.customers)
      .where(and(eq(schema.customers.id, id), customerData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(customerAccess.write, viewer, row.accountManagerId);
    let changed: typeof schema.customers.$inferSelect;
    const updated = { ...values, accountManagerId: ownerFor(viewer, values.accountManagerId ?? row.accountManagerId) };
    try {
      changed = db.transaction((tx) => {
        const before = tx.select().from(schema.customers).where(eq(schema.customers.id, id)).get();
        const after = tx.update(schema.customers).set(updated).where(eq(schema.customers.id, id)).returning().get();
        audit(tx, viewer, { action: what, model: "Customer", record: id, fields: before && changedFields(before, after, Object.keys(updated)) });
        return after;
      });
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterUpdate", "Customer", changed, viewer);
    return changed;
  },

  /** Deletes the record; \`together\` takes the records that point to it along to the trash (delete-together.md). */
  async remove(viewer: Viewer | null, id: number, together = false): Promise<void> {
    const row = db
      .select({ name: schema.customers.name, accountManagerId: schema.customers.accountManagerId })
      .from(schema.customers)
      .where(and(eq(schema.customers.id, id), customerData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(customerAccess.delete, viewer, row.accountManagerId);
    try {
      db.transaction((tx) => {
        const used = usedBy(tx, id, String(row.name ?? id));
        if (used && !together) throw new Conflict(\`in-use:\${JSON.stringify(used)}\`);
        const when = new Date();
        const gone = tx.update(schema.customers).set({ deletedAt: when, deletedBy: personOf(viewer) }).where(and(eq(schema.customers.id, id), isNull(schema.customers.deletedAt))).returning().get();
        if (gone) {
          audit(tx, viewer, { action: "trashed", model: "Customer", record: id, title: gone.name });
          if (used) {
            const tag = \`Customer:\${id}\`;
            orderData.trashWith(tx, viewer, eq(schema.orders.customerId, id), tag, when);
          }
        }
      });
    } catch (error) {
      throw refusal(error);
    }
    await afterDelete("Customer", id, viewer);
  },

  /**
   * Deletes the chosen records the viewer may delete, all or none (one still in use stops them
   * all, and is named); the others are skipped.
   */
  async removeMany(viewer: Viewer | null, ids: number[], together = false): Promise<{ deleted: number; skipped: number }> {
    const rows = db
      .select({ id: schema.customers.id, name: schema.customers.name, accountManagerId: schema.customers.accountManagerId })
      .from(schema.customers)
      .where(and(inArray(schema.customers.id, ids), customerData.readable(viewer)))
      .all()
      .filter((row) => allows(customerAccess.delete, viewer, row.accountManagerId));
    db.transaction((tx) => {
      const when = new Date();
      for (const row of rows)
        try {
          const used = usedBy(tx, row.id, String(row.name ?? row.id));
          if (used && !together) throw new Conflict(\`in-use:\${JSON.stringify(used)}\`);
          const gone = tx.update(schema.customers).set({ deletedAt: when, deletedBy: personOf(viewer) }).where(and(eq(schema.customers.id, row.id), isNull(schema.customers.deletedAt))).returning().get();
          if (gone) {
            audit(tx, viewer, { action: "trashed", model: "Customer", record: row.id, title: gone.name });
            if (used) {
              const tag = \`Customer:\${row.id}\`;
              orderData.trashWith(tx, viewer, eq(schema.orders.customerId, row.id), tag, when);
            }
          }
        } catch (error) {
          const refused = refusal(error);
          throw refused instanceof Conflict && refused.message === "in-use" ? new Conflict(\`in-use:\${row.id}\`) : refused;
        }
    });
    for (const row of rows) {
      await afterDelete("Customer", row.id, viewer);
    }
    return { deleted: rows.length, skipped: new Set(ids).size - rows.length };
  },

  /**
   * The viewer's trash (docs/design/trash.md): the customers in it they may delete, the
   * latest first, with when and by whom, kept for thirty days.
   */
  async trash(viewer: Viewer | null) {
    const rows = customerData.shownRefs(
      viewer,
      await db.query.customers.findMany({
        where: and(isNotNull(schema.customers.deletedAt), customerData.scoped(viewer)),
        with: { accountManager: { columns: { id: true, name: true } } },
        orderBy: (t) => [desc(t.deletedAt)],
        limit: 1000,
      }),
    ).filter((row) => allows(customerAccess.delete, viewer, row.accountManagerId));
    const ids = [...new Set(rows.map((row) => row.deletedBy).filter((id): id is string => Boolean(id)))];
    const people = new Map(
      db.select({ id: schema.user.id, name: schema.user.name }).from(schema.user).where(inArray(schema.user.id, ids)).all().map((p) => [p.id, p.name]),
    );
    const withCount = new Map<string, number>();
    const tags = rows.map((row) => \`Customer:\${row.id}\`);
    for (const r of db.select({ tag: schema.orders.deletedWith, n: count() }).from(schema.orders).where(inArray(schema.orders.deletedWith, tags)).groupBy(schema.orders.deletedWith).all())
      withCount.set(r.tag as string, (withCount.get(r.tag as string) ?? 0) + r.n);
    return rows.map((row) => ({ ...row, deletedByName: (row.deletedBy && people.get(row.deletedBy)) ?? null, withCount: withCount.get(\`Customer:\${row.id}\`) ?? 0 }));
  },

  /** A customer in the trash, as its page shows it read-only, with when and by whom; else nothing. */
  async trashed(viewer: Viewer | null, id: number) {
    const fetched = await db.query.customers.findFirst({
      where: and(eq(schema.customers.id, id), and(isNotNull(schema.customers.deletedAt), customerData.scoped(viewer))),
      with: { accountManager: { columns: { id: true, name: true } }, orders: { where: orderData.readable(viewer) } },
    });
    const row = fetched && customerData.shownRefs(viewer, [fetched])[0];
    if (!row || !allows(customerAccess.delete, viewer, row.accountManagerId)) return null;
    const rows = [row];
    const ids = [...new Set(rows.map((row) => row.deletedBy).filter((id): id is string => Boolean(id)))];
    const people = new Map(
      db.select({ id: schema.user.id, name: schema.user.name }).from(schema.user).where(inArray(schema.user.id, ids)).all().map((p) => [p.id, p.name]),
    );
    return {
      row: row,
      deletedAt: row.deletedAt as Date,
      by: (row.deletedBy && people.get(row.deletedBy)) ?? null,
      until: new Date((row.deletedAt as Date).getTime() + TRASH_DAYS * DAY),
    };
  },

  /** Takes the chosen customers out of the trash, those the viewer may delete. */
  restore(viewer: Viewer | null, ids: number[]): { restored: number; skipped: number } {
    const rows = db
      .select({ id: schema.customers.id, accountManagerId: schema.customers.accountManagerId })
      .from(schema.customers)
      .where(and(inArray(schema.customers.id, ids), and(isNotNull(schema.customers.deletedAt), customerData.scoped(viewer))))
      .all().filter((row) => allows(customerAccess.delete, viewer, row.accountManagerId));
    // A unique value a live record has taken since refuses it, as it refuses a new record.
    try {
      db.transaction((tx) => {
        for (const row of rows) {
          const back = tx.update(schema.customers).set({ deletedAt: null, deletedBy: null, deletedWith: null }).where(eq(schema.customers.id, row.id)).returning().get();
          audit(tx, viewer, { action: "restored", model: "Customer", record: row.id, title: back.name });
          // What went to the trash with it comes back with it.
          orderData.restoreWith(tx, viewer, \`Customer:\${row.id}\`);
        }
      });
    } catch (error) {
      throw refusal(error);
    }
    return { restored: rows.length, skipped: new Set(ids).size - rows.length };
  },

  /** Removes the chosen customers in the trash for good, with their pictures and documents. */
  removeForGood(viewer: Viewer | null, ids: number[]): { deleted: number; skipped: number } {
    const rows = db
      .select({ id: schema.customers.id, accountManagerId: schema.customers.accountManagerId })
      .from(schema.customers)
      .where(and(inArray(schema.customers.id, ids), and(isNotNull(schema.customers.deletedAt), customerData.scoped(viewer))))
      .all().filter((row) => allows(customerAccess.delete, viewer, row.accountManagerId));
    customerData.erase(viewer, rows.map((row) => row.id));
    return { deleted: rows.length, skipped: new Set(ids).size - rows.length };
  },

  /** Deletes trashed records for good (Delete permanently, Empty trash, the daily job). */
  erase(viewer: Viewer | null, ids: number[]): void {
    if (ids.length === 0) return;
    // What is in the trash pointing to them goes first, deepest first (docs/design/delete-together.md).
    orderData.erase(viewer, db.select({ id: schema.orders.id }).from(schema.orders).where(and(isNotNull(schema.orders.deletedAt), inArray(schema.orders.customerId, ids))).all().map((r) => r.id));

    const rows = db
      .select({ id: schema.customers.id, accountManagerId: schema.customers.accountManagerId })
      .from(schema.customers)
      .where(and(inArray(schema.customers.id, ids), isNotNull(schema.customers.deletedAt)))
      .all();
    try {
      db.transaction((tx) => {
        for (const row of rows) {
          const gone = tx.delete(schema.customers).where(eq(schema.customers.id, row.id)).returning().get();
          if (gone) audit(tx, viewer, { action: "removed", model: "Customer", record: row.id, title: gone.name });
        }
      });
    } catch (error) {
      throw refusal(error);
    }
  },

  /** What has been in the trash for thirty days goes for good (once a day, see trash.server.ts). */
  purge(now = Date.now()): number {
    const old = db
      .select({ id: schema.customers.id })
      .from(schema.customers)
      .where(lt(schema.customers.deletedAt, new Date(now - TRASH_DAYS * DAY)))
      .all()
      .map((row) => row.id);
    customerData.erase(null, old);
    return old.length;
  },

  /**
   * The customers the viewer may read whose name contains the text: a search of records that
   * refer to them finds them only among these.
   */
  titled(viewer: Viewer | null, text: string): number[] {
    return db
      .select({ id: schema.customers.id })
      .from(schema.customers)
      .where(and(contains([schema.customers.name], text), customerData.readable(viewer)))
      .all()
      .map((row) => row.id);
  },

  /** Choices for fields that refer to a customer: the ones the viewer may read. */
  options(viewer: Viewer | null) {
    if (readScope(customerAccess.read, viewer) === "none") return [];
    return db
      .select({ value: schema.customers.id, label: schema.customers.name })
      .from(schema.customers)
      .where(customerData.readable(viewer))
      .orderBy(asc(schema.customers.name))
      .all();
  },
};
"
`;

exports[`../../../examples/crm/smithable.yml > file list and generated code > src/generated/customer.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { z } from "zod";
import type * as schema from "#/db/schema";
import { allows, type Rule } from "#/kit/access";
import type { RecordUi } from "#/kit/model";
import { customerAccess, customerData } from "./customer.server";
import { orderAccess } from "./order.server";
import { writeAllowed } from "#/kit/limit";
import { currentViewer } from "#/lib/viewer.server";
import { customerSchema } from "./customer.schema";

export type { CustomerValues } from "./customer.schema";

/** The viewer about to write, counted against how often one may (see src/kit/limit.ts). */
async function writer() {
  const viewer = await currentViewer();
  writeAllowed(viewer, getRequestHeaders());
  return viewer;
}

/** Customer records as the kit reads them. */
export type CustomerRow = typeof schema.customers.$inferSelect & {
  accountManager?: { id: string; name: string } | null;
};

export const customerUi: RecordUi<CustomerRow> = {
  model: "Customer",
  label: "Customer",
  pluralLabel: "Customers",
  titleField: "name",
  columns: ["name", "segment", "email", "phone", "creditLimit"],
  fields: [
    {
      name: "name",
      label: "Name",
      kind: "string",
      required: true,
      get: (row) => row.name,
    },
    {
      name: "email",
      label: "Email",
      kind: "email",
      required: false,
      get: (row) => row.email,
    },
    {
      name: "phone",
      label: "Phone",
      kind: "phone",
      required: false,
      get: (row) => row.phone,
    },
    {
      name: "segment",
      label: "Segment",
      kind: "choice",
      required: true,
      choices: [
        { value: "smb", label: "Smb" },
        { value: "enterprise", label: "Enterprise" },
        { value: "government", label: "Government" },
      ],
      default: "smb",
      get: (row) => row.segment,
    },
    {
      name: "creditLimit",
      label: "Credit limit",
      kind: "money",
      required: false,
      min: 0,
      get: (row) => row.creditLimit,
    },
    {
      name: "notes",
      label: "Notes",
      kind: "text",
      required: false,
      get: (row) => row.notes,
    },
    {
      name: "accountManagerId",
      label: "Account manager",
      kind: "user",
      required: false,
      relation: { key: "accountManager", titleField: "name" },
      get: (row) => row.accountManager?.name ?? null,
    },
  ],
};

/** Who may delete customers: a list's selection offers Delete by it (the server checks again). */
export const customerDeleteRule: Rule = { public: false, roles: ["admin"], owner: true };


export const listCustomers = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return { rows: await customerData.list(viewer), canCreate: allows(customerAccess.create, viewer) };
});

export const getCustomer = createServerFn()
  .validator(z.number().int())
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    const row = await customerData.get(viewer, id);
    // In the trash: its page shows it read-only, with when, by whom and Restore.
    if (!row) {
      const gone = await customerData.trashed(viewer, id);
      return gone && { row: gone.row, canWrite: false, canDelete: false, canAdd: { orders: false }, trashed: { at: gone.deletedAt, by: gone.by, until: gone.until } };
    }
    if (!row) return null;
    return {
      row,
      trashed: null,
      canWrite: allows(customerAccess.write, viewer, row.accountManagerId),
      canDelete: allows(customerAccess.delete, viewer, row.accountManagerId),
      // Who may add to its related lists from here ("Add line" on an invoice).
      canAdd: { orders: allows(orderAccess.create, viewer) },
    };
  });

/** Choices for fields that refer to a customer. */
export const customerOptions = createServerFn().handler(async () =>
  customerData.options(await currentViewer()),
);

export const createCustomer = createServerFn({ method: "POST" })
  .validator(customerSchema)
  .handler(async ({ data }) => customerData.create(await writer(), data));

export const updateCustomer = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), values: customerSchema }))
  .handler(async ({ data }) => customerData.update(await writer(), data.id, data.values));

/** Deletes a customer; \`together\` takes what points to it along (docs/design/delete-together.md). */
export const deleteCustomer = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), together: z.boolean().optional() }))
  .handler(async ({ data }) => customerData.remove(await writer(), data.id, data.together));

/** Deletes the chosen customers, all or none (at most 1,000 at once). */
export const deleteCustomers = createServerFn({ method: "POST" })
  .validator(z.object({ ids: z.array(z.number().int()).max(1000), together: z.boolean().optional() }))
  .handler(async ({ data }) => customerData.removeMany(await writer(), data.ids, data.together));

/** The viewer's trash of customers (docs/design/trash.md). */
export const trashedCustomers = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return { rows: await customerData.trash(viewer) };
});

/** Takes the chosen customers out of the trash. */
export const restoreCustomers = createServerFn({ method: "POST" })
  .validator(z.array(z.number().int()).max(1000))
  .handler(async ({ data: ids }) => customerData.restore(await writer(), ids));

/** Removes the chosen customers in the trash for good. */
export const eraseCustomers = createServerFn({ method: "POST" })
  .validator(z.array(z.number().int()).max(1000))
  .handler(async ({ data: ids }) => customerData.removeForGood(await writer(), ids));
"
`;

exports[`../../../examples/crm/smithable.yml > file list and generated code > src/generated/hooks.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// Where the app reacts to changes: after a record is created, changed or deleted, and once a
// day. Your reactions go in src/custom/hooks.ts (send an email, update another record, call a
// service); a plugin's in its own hooks file. A hook runs on the server, in the request that
// made the change and with the viewer who made it, after the change is saved; a hook that
// throws fails that request. Daily jobs run in production, a day after the server started.
import type * as schema from "#/db/schema";
import type { Viewer } from "#/kit/access";
import { log } from "#/kit/log.server";
import * as custom from "#/custom/hooks";

export type Hook<Row> = (row: Row, viewer: Viewer | null) => void | Promise<void>;

/** Each model's record as it is stored. */
export interface Rows {
  Customer: typeof schema.customers.$inferSelect;
  Order: typeof schema.orders.$inferSelect;
}

export interface Hooks {
  /** After a record is created, by model. */
  afterCreate?: { [M in keyof Rows]?: Hook<Rows[M]> };
  /** After a record is changed, with its new values. */
  afterUpdate?: { [M in keyof Rows]?: Hook<Rows[M]> };
  /** After a record is deleted; only its id is left. */
  afterDelete?: { [M in keyof Rows]?: Hook<{ id: number }> };
  /** Once a day. */
  daily?: (() => void | Promise<void>)[];
}

// Read when a hook runs, not when this module loads: custom code may import the data functions,
// which import this file.
const sources = (): Hooks[] => [custom.hooks];

export async function afterChange<M extends keyof Rows>(
  event: "afterCreate" | "afterUpdate",
  model: M,
  row: Rows[M],
  viewer: Viewer | null,
): Promise<void> {
  for (const source of sources()) {
    // One model's hook at a time: TypeScript cannot narrow the lookup by a generic key.
    const hook = source[event]?.[model] as Hook<Rows[M]> | undefined;
    await hook?.(row, viewer);
  }
}

export async function afterDelete<M extends keyof Rows>(
  model: M,
  id: number,
  viewer: Viewer | null,
): Promise<void> {
  for (const source of sources()) {
    const hook = source.afterDelete?.[model] as Hook<{ id: number }> | undefined;
    await hook?.({ id }, viewer);
  }
}

/** Every daily job, in order; a failing one is reported and the rest still run. */
export async function runDaily(): Promise<void> {
  for (const source of sources())
    for (const job of source.daily ?? []) {
      try {
        await job();
      } catch (error) {
        log.error("A daily job failed", { error });
      }
    }
}

// In production, once a day, starting a day after the server started (pnpm start). The timer
// never keeps the process alive by itself, so the server still stops when asked to.
if (import.meta.env.SSR && import.meta.env.PROD) {
  const day = 24 * 60 * 60 * 1000;
  const tick = () => setTimeout(() => runDaily().finally(tick), day).unref();
  tick();
}
"
`;

exports[`../../../examples/crm/smithable.yml > file list and generated code > src/generated/order.formulas.test.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// The examples given for Order's formulas: each must give the expected value.
import { describe, expect, test } from "vitest";
import { orderFormulas } from "./order.formulas";

describe("Order.shippingCost", () => {
  test("total 150, shippingMethod standard gives 0", () => {
    expect(orderFormulas.shippingCost({ total: 15000, shippingMethod: "standard" })).toBe(0);
  });

  test("total 80, shippingMethod standard gives 5", () => {
    expect(orderFormulas.shippingCost({ total: 8000, shippingMethod: "standard" })).toBe(500);
  });

  test("total 150, shippingMethod express gives 15", () => {
    expect(orderFormulas.shippingCost({ total: 15000, shippingMethod: "express" })).toBe(1500);
  });
});
"
`;

