/** The viewer about to write, counted against how often one may (see src/kit/limit.ts). */
async function writer() {
  const viewer = await currentViewer();
  writeAllowed(viewer, getRequestHeaders());
  return viewer;
}

/** IncidentUpdate records as the kit reads them. */
export type IncidentUpdateRow = typeof schema.incidentUpdates.$inferSelect & {
  incident?: { id: number; title: string } | null;
};

export const incidentUpdateUi: RecordUi<IncidentUpdateRow> = {
  model: "IncidentUpdate",
  label: "Incident update",
  pluralLabel: "Incident updates",
  titleField: "id",
  descriptionField: "message",
  columns: ["incidentId", "at", "status"],
  fields: [
    {
      name: "incidentId",
      label: "Incident",
      kind: "relation",
      required: true,
      relation: { key: "incident", titleField: "title" },
      get: (row) => row.incident?.title ?? null,
    },
    {
      name: "at",
      label: "At",
      kind: "datetime",
      required: true,
      get: (row) => row.at,
    },
    {
      name: "status",
      label: "Status",
      kind: "choice",
      required: true,
      choices: [
        { value: "investigating", label: "Investigating" },
        { value: "identified", label: "Identified" },
        { value: "monitoring", label: "Monitoring" },
        { value: "resolved", label: "Resolved" },
      ],
      default: "investigating",
      get: (row) => row.status,
    },
    {
      name: "message",
      label: "Message",
      kind: "text",
      required: true,
      get: (row) => row.message,
    },
  ],
};

/** Who may delete incident updates: a list's selection offers Delete by it (the server checks again). */
export const incidentUpdateDeleteRule: Rule = { public: false, roles: ["admin"], owner: true };


export const listIncidentUpdates = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return { rows: await incidentUpdateData.list(viewer), canCreate: allows(incidentUpdateAccess.create, viewer) };
});

export const getIncidentUpdate = createServerFn()
  .validator(z.number().int())
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    const row = await incidentUpdateData.get(viewer, id);
    if (!row) return null;
    return {
      row,
      canWrite: allows(incidentUpdateAccess.write, viewer, row.ownerId),
      canDelete: allows(incidentUpdateAccess.delete, viewer, row.ownerId),
    };
  });

export const createIncidentUpdate = createServerFn({ method: "POST" })
  .validator(incidentUpdateSchema)
  .handler(async ({ data }) => incidentUpdateData.create(await writer(), data));

export const updateIncidentUpdate = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), values: incidentUpdateSchema }))
  .handler(async ({ data }) => incidentUpdateData.update(await writer(), data.id, data.values));

/** Deletes a incident update; \`together\` takes what points to it along (docs/design/delete-together.md). */
export const deleteIncidentUpdate = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), together: z.boolean().optional() }))
  .handler(async ({ data }) => incidentUpdateData.remove(await writer(), data.id, data.together));

/** Deletes the chosen incident updates, all or none (at most 1,000 at once). */
export const deleteIncidentUpdates = createServerFn({ method: "POST" })
  .validator(z.object({ ids: z.array(z.number().int()).max(1000), together: z.boolean().optional() }))
  .handler(async ({ data }) => incidentUpdateData.removeMany(await writer(), data.ids, data.together));
"
`;

