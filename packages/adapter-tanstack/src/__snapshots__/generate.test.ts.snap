"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { and, asc, eq, sql, type SQL } from "drizzle-orm";
import { db } from "#/db";
import { classTypes } from "#/db/schema";
import { AccessDenied, check, type ModelAccess, readScope, type Viewer } from "#/kit/access";
import type { ClassTypeValues } from "./class-type";

/** Who may read, create, change and delete class types. */
export const classTypeAccess: ModelAccess = {
  read: { public: true, roles: ["admin"], owner: true },
  create: { public: false, roles: ["admin"], owner: false },
  write: { public: false, roles: ["admin"], owner: true },
  delete: { public: false, roles: ["admin"], owner: true },
};

export const classTypeData = {
  /** A condition for the class types the viewer may read. */
  readable(viewer: Viewer | null) {
    const scope = readScope(classTypeAccess.read, viewer);
    if (scope === "all") return undefined;
    return scope === "own" && viewer ? eq(classTypes.ownerId, viewer.id) : sql\`false\`;
  },

  canRead(viewer: Viewer | null, id: number): boolean {
    const found = db
      .select({ id: classTypes.id })
      .from(classTypes)
      .where(and(eq(classTypes.id, id), classTypeData.readable(viewer)))
      .get();
    return found !== undefined;
  },

  /** The class types the viewer may read; \`where\` narrows them, e.g. to a search. */
  async list(viewer: Viewer | null, where?: SQL) {
    if (readScope(classTypeAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const rows = await db.query.classTypes.findMany({
      where: and(classTypeData.readable(viewer), where),
      orderBy: (t, { desc }) => [desc(t.id)],
    });
    return rows;
  },

  async get(viewer: Viewer | null, id: number) {
    const row = await db.query.classTypes.findFirst({
      where: and(eq(classTypes.id, id), classTypeData.readable(viewer)),
    });
    return row ? row : null;
  },

  create(viewer: Viewer | null, values: ClassTypeValues) {
    check(classTypeAccess.create, viewer);
    return db.insert(classTypes).values({ ...values, ownerId: viewer?.id ?? null }).returning().get();
  },

  update(viewer: Viewer | null, id: number, values: ClassTypeValues) {
    const row = db
      .select({ ownerId: classTypes.ownerId })
      .from(classTypes)
      .where(and(eq(classTypes.id, id), classTypeData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(classTypeAccess.write, viewer, row.ownerId);
    return db.update(classTypes).set(values).where(eq(classTypes.id, id)).returning().get();
  },

  remove(viewer: Viewer | null, id: number): void {
    const row = db
      .select({ ownerId: classTypes.ownerId })
      .from(classTypes)
      .where(and(eq(classTypes.id, id), classTypeData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(classTypeAccess.delete, viewer, row.ownerId);
    db.delete(classTypes).where(eq(classTypes.id, id)).run();
  },

  /** Choices for fields that refer to a class type: the ones the viewer may read. */
  options(viewer: Viewer | null) {
    if (readScope(classTypeAccess.read, viewer) === "none") return [];
    return db
      .select({ value: classTypes.id, label: classTypes.name })
      .from(classTypes)
      .where(classTypeData.readable(viewer))
      .orderBy(asc(classTypes.name))
      .all();
  },
};
"
`;

