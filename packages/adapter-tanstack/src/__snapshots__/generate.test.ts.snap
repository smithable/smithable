exports[`../../../examples/crm/smithable.yml > file list and generated code > src/generated/access.test.ts 1`] = `
"// Generated by Smithable from smithable.yml and smithable.auth.yml. Do not edit: this file is overwritten on every change.
// For every model and role: which records a user can read, create, change and delete.
// "Own" records are owned by the user; "others" by someone else.
import { and, eq } from "drizzle-orm";
import { describe, expect, test } from "vitest";
import { db } from "#/db";
import { auditLog, user } from "#/db/schema";
import * as schema from "#/db/schema";
import { AccessDenied, type Viewer } from "#/kit/access";
import { forgetInLog, pruneAudit } from "#/kit/audit.server";
import { customerData } from "./customer.server";
import { orderData } from "./order.server";

let counter = 0;
const next = () => ++counter;

/** A new signed-in user with the role. */
function signedIn(role: string): Viewer {
  const n = next();
  const viewer = { id: \`test-user-\${n}\`, name: \`Test \${role} \${n}\`, email: \`user\${n}@example.com\`, role };
  db.insert(user).values(viewer).run();
  return viewer;
}

/** Owns the records that are someone else's. */
const stranger = signedIn("sales");

/** Whether the action is allowed; any other failure fails the test. */
async function can(action: () => unknown): Promise<boolean> {
  try {
    await action();
    return true;
  } catch (error) {
    if (error instanceof AccessDenied) return false;
    throw error;
  }
}

/** Whether the viewer can open the record and sees it in the list. */
async function reads(
  data: { get(viewer: never, id: number): Promise<unknown>; list(viewer: never): Promise<{ id: number }[]> },
  viewer: unknown,
  id: number,
): Promise<boolean> {
  const listed = await data.list(viewer as never).then(
    (rows) => rows.some((row) => row.id === id),
    (error) => {
      if (error instanceof AccessDenied) return false;
      throw error;
    },
  );
  return listed && (await data.get(viewer as never, id)) !== null;
}

function customerValues(owner: string | null) {
  const n = next();
  return { name: \`Customer name \${n}\`, email: \`customer\${n}@example.com\`, phone: null, segment: "smb", creditLimit: null, notes: null, accountManagerId: owner } as const;
}

function insertCustomer(owner: string | null, values: Record<string, unknown> = {}) {
  return db
    .insert(schema.customers)
    .values({ ...customerValues(owner), ...values })
    .returning()
    .get();
}

function orderValues(owner: string | null) {
  const n = next();
  return { number: \`Order number \${n}\`, customerId: insertCustomer(owner).id, status: "draft", total: 1000, shippingMethod: "standard", placedAt: null } as const;
}

function insertOrder(owner: string | null, values: Record<string, unknown> = {}) {
  return db
    .insert(schema.orders)
    .values({ ...orderValues(owner), ...values, ownerId: owner })
    .returning()
    .get();
}

describe("Customer", () => {
  test("admin", async () => {
    const viewer = signedIn("admin");
    const others = insertCustomer(stranger.id);
    const own = insertCustomer(viewer.id);
    expect({
      readOthers: await reads(customerData, viewer, others.id),
      readOwn: await reads(customerData, viewer, own.id),
      create: await can(() => customerData.create(viewer, customerValues(viewer.id))),
      changeOthers: await can(() => customerData.update(viewer, others.id, customerValues(stranger.id))),
      changeOwn: await can(() => customerData.update(viewer, own.id, customerValues(viewer.id))),
      deleteOthers: await can(() => customerData.remove(viewer, others.id)),
      deleteOwn: await can(() => customerData.remove(viewer, own.id)),
    }).toEqual({
      readOthers: true,
      readOwn: true,
      create: true,
      changeOthers: true,
      changeOwn: true,
      deleteOthers: true,
      deleteOwn: true,
    });
  });

  test("sales", async () => {
    const viewer = signedIn("sales");
    const others = insertCustomer(stranger.id);
    const own = insertCustomer(viewer.id);
    expect({
      readOthers: await reads(customerData, viewer, others.id),
      readOwn: await reads(customerData, viewer, own.id),
      create: await can(() => customerData.create(viewer, customerValues(viewer.id))),
      changeOthers: await can(() => customerData.update(viewer, others.id, customerValues(stranger.id))),
      changeOwn: await can(() => customerData.update(viewer, own.id, customerValues(viewer.id))),
      deleteOthers: await can(() => customerData.remove(viewer, others.id)),
      deleteOwn: await can(() => customerData.remove(viewer, own.id)),
    }).toEqual({
      readOthers: true,
      readOwn: true,
      create: true,
      changeOthers: true,
      changeOwn: true,
      deleteOthers: false,
      deleteOwn: true,
    });
  });

  test("a visitor who has not signed in", async () => {
    const viewer = null;
    const others = insertCustomer(stranger.id);
    expect({
      readOthers: await reads(customerData, viewer, others.id),
      readOwn: false,
      create: await can(() => customerData.create(viewer, customerValues(null))),
      changeOthers: await can(() => customerData.update(viewer, others.id, customerValues(stranger.id))),
      changeOwn: false,
      deleteOthers: await can(() => customerData.remove(viewer, others.id)),
      deleteOwn: false,
    }).toEqual({
      readOthers: false,
      readOwn: false,
      create: false,
      changeOthers: false,
      changeOwn: false,
      deleteOthers: false,
      deleteOwn: false,
    });
  });
});

describe("Order", () => {
  test("admin", async () => {
    const viewer = signedIn("admin");
    const others = insertOrder(stranger.id);
    const own = insertOrder(viewer.id);
    expect({
      readOthers: await reads(orderData, viewer, others.id),
      readOwn: await reads(orderData, viewer, own.id),
      create: await can(() => orderData.create(viewer, orderValues(viewer.id))),
      changeOthers: await can(() => orderData.update(viewer, others.id, orderValues(stranger.id))),
      changeOwn: await can(() => orderData.update(viewer, own.id, orderValues(viewer.id))),
      deleteOthers: await can(() => orderData.remove(viewer, others.id)),
      deleteOwn: await can(() => orderData.remove(viewer, own.id)),
    }).toEqual({
      readOthers: true,
      readOwn: true,
      create: true,
      changeOthers: true,
      changeOwn: true,
      deleteOthers: true,
      deleteOwn: true,
    });
  });

  test("sales", async () => {
    const viewer = signedIn("sales");
    const others = insertOrder(stranger.id);
    const own = insertOrder(viewer.id);
    expect({
      readOthers: await reads(orderData, viewer, others.id),
      readOwn: await reads(orderData, viewer, own.id),
      create: await can(() => orderData.create(viewer, orderValues(viewer.id))),
      changeOthers: await can(() => orderData.update(viewer, others.id, orderValues(stranger.id))),
      changeOwn: await can(() => orderData.update(viewer, own.id, orderValues(viewer.id))),
      deleteOthers: await can(() => orderData.remove(viewer, others.id)),
      deleteOwn: await can(() => orderData.remove(viewer, own.id)),
    }).toEqual({
      readOthers: true,
      readOwn: true,
      create: true,
      changeOthers: true,
      changeOwn: true,
      deleteOthers: false,
      deleteOwn: true,
    });
  });

  test("a visitor who has not signed in", async () => {
    const viewer = null;
    const others = insertOrder(stranger.id);
    expect({
      readOthers: await reads(orderData, viewer, others.id),
      readOwn: false,
      create: await can(() => orderData.create(viewer, orderValues(null))),
      changeOthers: await can(() => orderData.update(viewer, others.id, orderValues(stranger.id))),
      changeOwn: false,
      deleteOthers: await can(() => orderData.remove(viewer, others.id)),
      deleteOwn: false,
    }).toEqual({
      readOthers: false,
      readOwn: false,
      create: false,
      changeOthers: false,
      changeOwn: false,
      deleteOthers: false,
      deleteOwn: false,
    });
  });
});

describe("the audit log", () => {
  test("names who created, changed and deleted a record, and what changed", async () => {
    const viewer = signedIn("admin");
    const made = await customerData.create(viewer, customerValues(viewer.id));
    await customerData.update(viewer, made.id, customerValues(viewer.id));
    await customerData.remove(viewer, made.id);
    const lines = db
      .select()
      .from(auditLog)
      .where(and(eq(auditLog.model, "Customer"), eq(auditLog.recordId, made.id)))
      .all();
    expect(lines.map((l) => [l.action, l.who, l.role])).toEqual([
      ["created", viewer.id, viewer.role],
      ["changed", viewer.id, viewer.role],
      ["trashed", viewer.id, viewer.role],
    ]);
    // Only the line that deleted it keeps the record's name (its title by then); no field's
    // value is stored.
    expect(lines.map((l) => Boolean(l.title))).toEqual([false, false, true]);
    expect(JSON.stringify(lines[1]?.fields ?? [])).not.toContain(":");

    // Forget in the log: administrators only; it blanks the deleted record's name and is logged by id.
    expect(() => forgetInLog(signedIn("sales"), { model: "Customer", record: made.id })).toThrow(AccessDenied);
    forgetInLog(signedIn("admin"), { model: "Customer", record: made.id });
    const after = db.select().from(auditLog).where(and(eq(auditLog.model, "Customer"), eq(auditLog.recordId, made.id))).all();
    expect(after.map((l) => l.title)).toEqual([null, null, null]);
    const forgot = db.select().from(auditLog).where(eq(auditLog.action, "forgotten in the log")).all().at(-1);
    expect(forgot).toMatchObject({ title: null, details: { model: "Customer", record: made.id } });
  });

  test("keeps the client's details and a deleted record's name 90 days, and a line 12 months", () => {
    const day = 24 * 60 * 60 * 1000;
    const line = (daysAgo: number) =>
      db
        .insert(auditLog)
        .values({ at: new Date(Date.now() - daysAgo * day), who: "test", action: "deleted", title: "Old", address: "10.0.0.1", browser: "test" })
        .returning()
        .get();
    const recent = line(10);
    const older = line(100);
    const oldest = line(400);
    pruneAudit();
    const row = (id: number) => db.select().from(auditLog).where(eq(auditLog.id, id)).get();
    expect(row(recent.id)).toMatchObject({ title: "Old", address: "10.0.0.1" });
    expect(row(older.id)).toMatchObject({ title: null, address: null, browser: null, action: "deleted" });
    expect(row(oldest.id)).toBeUndefined();
  });
});
"
`;

