export const Route = createFileRoute("/barbers/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["barbers"], context.viewer, location.href),
  head: () => pageHead("barbers"),
  validateSearch: (s: Search) => optional({ page: count(s.page) }),
  loaderDeps: ({ search }) => ({ page: search.page }),
  loader: ({ deps }) => listBarbers({ data: { page: deps.page } }),
  component: BarbersPage,
});

function BarbersPage() {
  const { rows, canCreate, total, page: at, size } = Route.useLoaderData();
  const { viewer } = Route.useRouteContext();
  const navigate = useNavigate({ from: "/barbers/" });
  const router = useRouter();
  // The chosen rows, offered when the viewer may do something to at least one row.
  const [selected, setSelected] = useState<Set<number>>(new Set());
  const chosen = rows.filter((row) => selected.has(row.id));
  const selectable = rows.some((row) => allows(barberDeleteRule, viewer, row.ownerId));
  const newButton = canCreate && (
    <Link to="/barbers/new" className={buttonVariants()}>
      {w.newOne("barber")}
    </Link>
  );
  return (
    <>
      <PageHeader
        page="barbers"
        title={pageUi["barbers"].title}
        actions={newButton}
      />
      {selectable && (
        <SelectionBar
          count={chosen.length}
          noun={["barber", "barbers"]}
          app={app}
          titleOf={(id) => String(rows.find((row) => row.id === id)?.name ?? id)}
          actions={[]}
          deletable={chosen.filter((row) => allows(barberDeleteRule, viewer, row.ownerId)).length}
          onDelete={(together) => deleteBarbers({ data: { ids: chosen.map((row) => row.id), together } })}
          onDone={async () => {
            setSelected(new Set());
            await router.invalidate();
          }}
          onExport={() => download(csvName(barberUi), csvOf(barberUi, chosen))}
        />
      )}
      <ModelTable
        ui={barberUi}
        page="barbers"
        paging={{ page: at, size, total, to: (next) => navigate({ to: "/barbers", search: (prev) => ({ ...prev, page: next > 1 ? next : undefined }) }) }}
        app={app}
        exportRows={async () => (await listBarbers({ data: { all: true } })).rows}
        rows={rows}
        icon={List}
        selection={selectable ? { ids: selected, onChange: setSelected } : undefined}
        emptyAction={newButton || undefined}
        onOpen={(row) => navigate({ to: "/barbers/$id", params: { id: String(row.id) } })}
      />
    </>
  );
}
"
`;

