"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, Link, useNavigate } from "@tanstack/react-router";
import { pageAccess, pageHead } from "#/generated/pages";
import { guardPage, allows } from "#/kit/access";
import { createServerFn } from "@tanstack/react-start";
import { sessionAccess, sessionData } from "#/generated/session.server";
import { currentViewer } from "#/lib/viewer.server";
import { buttonVariants } from "#/components/ui/button";
import { app } from "#/generated/app";
import { sessionUi } from "#/generated/session";
import { w } from "#/kit/words";
import { PageHeader } from "#/kit/AppShell";
import { ModelTable } from "#/kit/ModelTable";

/** The newest sessions the viewer may read. */
const listSessions = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  const rows = await sessionData.list(viewer, undefined, 501);
    return {
      rows: rows.slice(0, 500),
      more: rows.length > 500,
      canCreate: allows(sessionAccess.create, viewer),
    };
});

export const Route = createFileRoute("/admin/sessions/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["admin"], context.viewer, location.href),
  head: () => pageHead("admin"),
  loader: () => listSessions(),
  component: AdminSessionsPage,
});

function AdminSessionsPage() {
  const { rows, canCreate, more } = Route.useLoaderData();
  const navigate = useNavigate();
  const newButton = canCreate && (
    <Link to="/admin/sessions/new" className={buttonVariants()}>
      {w.newOne("session")}
    </Link>
  );
  return (
    <>
      <PageHeader
        title={sessionUi.pluralLabel}
        actions={newButton}
      />
      {more && (
        <p className="text-sm text-muted-foreground">The newest 500 are shown.</p>
      )}
      <ModelTable
        ui={sessionUi}
        app={app}
        rows={rows}
        emptyAction={newButton || undefined}
        onOpen={(row) => navigate({ to: "/admin/sessions/$id", params: { id: String(row.id) } })}
      />
    </>
  );
}
"
`;

