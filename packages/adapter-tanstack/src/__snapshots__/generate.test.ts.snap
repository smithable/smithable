export const Route = createFileRoute("/messages/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["messages"], context.viewer, location.href),
  head: () => pageHead("messages"),
  validateSearch: (s: Search) => optional({ page: count(s.page) }),
  loaderDeps: ({ search }) => ({ page: search.page }),
  loader: ({ deps }) => listMessages({ data: { page: deps.page } }),
  component: MessagesPage,
});

function MessagesPage() {
  const { rows, canCreate, total, page: at, size } = Route.useLoaderData();
  const { viewer } = Route.useRouteContext();
  const navigate = useNavigate({ from: "/messages/" });
  const router = useRouter();
