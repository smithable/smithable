"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, useNavigate } from "@tanstack/react-router";
import { app } from "#/generated/app";
import { pageAccess } from "#/generated/pages";
import { createSession, sessionSchema, sessionUi } from "#/generated/session";
import { classTypeOptions } from "#/generated/class-type";
import { instructorOptions } from "#/generated/instructor";
import { guardPage } from "#/kit/access";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";
import { instantOf } from "#/kit/zoned";
import { z } from "zod";

export const Route = createFileRoute("/admin/sessions/new")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["admin"], context.viewer, location.href),
  validateSearch: z.object({ startsAt: z.string().max(40).optional().catch(undefined) }),
  loader: async () => ({ options: { classTypeId: await classTypeOptions(), instructorId: await instructorOptions() } }),
  component: NewSessionPage,
});

function NewSessionPage() {
  const { options } = Route.useLoaderData();
  const search = Route.useSearch();
  const navigate = useNavigate();
  const back = () => navigate({ to: "/admin/sessions" });
  return (
    <>
      <PageHeader title="New session" />
      <ModelForm
        ui={sessionUi}
        app={app}
        schema={sessionSchema}
        preset={search.startsAt ? { startsAt: instantOf(search.startsAt, app.timeZone) } : undefined}
        options={options}
        submitLabel="Create session"
        onSubmit={async (values) => {
          await createSession({ data: values });
          await back();
        }}
        onCancel={back}
      />
    </>
  );
}
"
