      db.transaction((tx) => {
        // Read again in the change itself: a record that left the viewer's reach meanwhile is refused.
        if (!tx.select({ id: schema.incidents.id }).from(schema.incidents).where(and(eq(schema.incidents.id, id), incidentData.readable(viewer))).get())
