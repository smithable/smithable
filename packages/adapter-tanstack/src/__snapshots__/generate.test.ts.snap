"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// The examples given for Order's formulas: each must give the expected value.
import { describe, expect, test } from "vitest";
import { orderFormulas } from "./order.formulas";

describe("Order.shippingCost", () => {
  test("total 150, shippingMethod standard gives 0", () => {
    expect(orderFormulas.shippingCost({ total: 15000, shippingMethod: "standard" })).toBe(0);
  });

  test("total 80, shippingMethod standard gives 5", () => {
    expect(orderFormulas.shippingCost({ total: 8000, shippingMethod: "standard" })).toBe(500);
  });

  test("total 150, shippingMethod express gives 15", () => {
    expect(orderFormulas.shippingCost({ total: 15000, shippingMethod: "express" })).toBe(1500);
  });
});
"
`;

exports[`../../../examples/crm/smithable.yml > file list and generated code > src/generated/order.formulas.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { F } from "#/kit/formula";

type Row = Record<string, unknown>;

/** Computed fields of Order, on records as stored (money in cents). */
export const orderFormulas = {
  shippingCost: (r: Row): number => F.toCents(((F.compare("=", F.t(r.shippingMethod), "standard") && F.compare(">", F.fromCents(r.total), 100)) ? 0 : (F.compare("=", F.t(r.shippingMethod), "express") ? 15 : 5))),
};

/** Values suggested when a Order is created. */
export const orderDefaults = {
  placedAt: (_r: Row): string => F.NOW(),
};

/** The record with its computed fields. */
export function withOrderFormulas<T extends Row>(row: T): T & { shippingCost: number } {
  return { ...row, shippingCost: orderFormulas.shippingCost(row) };
}
"
`;

exports[`../../../examples/crm/smithable.yml > file list and generated code > src/generated/order.server.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { and, eq, sql, type SQL } from "drizzle-orm";
import { db } from "#/db";
import { orders } from "#/db/schema";
import { AccessDenied, check, type ModelAccess, readScope, refusal, type Viewer } from "#/kit/access";
import { afterChange, afterDelete } from "./hooks";
import { customerData } from "./customer.server";
import type { OrderValues } from "./order";
import { withOrderFormulas } from "./order.formulas";

/** Who may read, create, change and delete orders. */
export const orderAccess: ModelAccess = {
  read: { public: false, roles: ["admin", "sales"], owner: false },
  create: { public: false, roles: ["admin", "sales"], owner: false },
  write: { public: false, roles: ["admin", "sales"], owner: false },
  delete: { public: false, roles: ["admin"], owner: false },
};

/** Checks that the viewer may read the records the values refer to. */
function checkReferences(viewer: Viewer | null, values: OrderValues): void {
  if (values.customerId != null && !customerData.canRead(viewer, values.customerId))
    throw new AccessDenied(viewer !== null);
}

export const orderData = {
  /** A condition for the orders the viewer may read. */
  readable(viewer: Viewer | null) {
    const scope = readScope(orderAccess.read, viewer);
    if (scope === "all") return undefined;
    return scope === "own" && viewer ? eq(orders.ownerId, viewer.id) : sql\`false\`;
  },

  canRead(viewer: Viewer | null, id: number): boolean {
    const found = db
      .select({ id: orders.id })
      .from(orders)
      .where(and(eq(orders.id, id), orderData.readable(viewer)))
      .get();
    return found !== undefined;
  },

  /** The orders the viewer may read; \`where\` narrows them, e.g. to a search. */
  async list(viewer: Viewer | null, where?: SQL) {
    if (readScope(orderAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const rows = await db.query.orders.findMany({
      where: and(orderData.readable(viewer), where),
      with: { customer: { columns: { id: true, name: true } } },
      orderBy: (t, { desc }) => [desc(t.id)],
    });
    return rows.map(withOrderFormulas);
  },

  async get(viewer: Viewer | null, id: number) {
    const row = await db.query.orders.findFirst({
      where: and(eq(orders.id, id), orderData.readable(viewer)),
      with: { customer: { columns: { id: true, name: true } } },
    });
    return row ? withOrderFormulas(row) : null;
  },

  async create(viewer: Viewer | null, values: OrderValues) {
    check(orderAccess.create, viewer);
    checkReferences(viewer, values);
    let row: typeof orders.$inferSelect;
    try {
      row = db.insert(orders).values({ ...values, ownerId: viewer?.id ?? null }).returning().get();
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterCreate", "Order", row, viewer);
    return row;
  },

  async update(viewer: Viewer | null, id: number, values: OrderValues) {
    const row = db
      .select({ ownerId: orders.ownerId })
      .from(orders)
      .where(and(eq(orders.id, id), orderData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(orderAccess.write, viewer, row.ownerId);
    checkReferences(viewer, values);
    let changed: typeof orders.$inferSelect;
    const updated = values;
    try {
      changed = db.update(orders).set(updated).where(eq(orders.id, id)).returning().get();
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterUpdate", "Order", changed, viewer);
    return changed;
  },

  async remove(viewer: Viewer | null, id: number): Promise<void> {
    const row = db
      .select({ ownerId: orders.ownerId })
      .from(orders)
      .where(and(eq(orders.id, id), orderData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(orderAccess.delete, viewer, row.ownerId);
    try {
      db.delete(orders).where(eq(orders.id, id)).run();
    } catch (error) {
      throw refusal(error);
    }
    await afterDelete("Order", id, viewer);
  },
};
"
`;

exports[`../../../examples/crm/smithable.yml > file list and generated code > src/generated/order.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { createInsertSchema } from "drizzle-zod";
import { z } from "zod";
import { orders } from "#/db/schema";
import { allows } from "#/kit/access";
import type { RecordUi } from "#/kit/model";
import { orderDefaults, withOrderFormulas } from "./order.formulas";
import { orderAccess, orderData } from "./order.server";
import { currentViewer } from "#/lib/viewer.server";

/** Order records as the kit reads them. */
export type OrderRow = typeof orders.$inferSelect & {
  customer?: { id: number; name: string } | null;
  shippingCost?: unknown;
};

export const orderUi: RecordUi<OrderRow> = {
  model: "Order",
  label: "Order",
  pluralLabel: "Orders",
  titleField: "number",
  columns: ["number", "customerId", "status", "total", "shippingMethod"],
  fields: [
    {
      name: "number",
      label: "Number",
      kind: "string",
      required: true,
      get: (row) => row.number,
    },
    {
      name: "customerId",
      label: "Customer",
      kind: "relation",
      required: true,
      relation: { key: "customer", titleField: "name" },
      get: (row) => row.customer?.name ?? null,
    },
    {
      name: "status",
      label: "Status",
      kind: "choice",
      required: true,
      choices: [
        { value: "draft", label: "Draft" },
        { value: "placed", label: "Placed" },
        { value: "shipped", label: "Shipped" },
        { value: "cancelled", label: "Cancelled" },
      ],
      default: "draft",
      get: (row) => row.status,
    },
    {
      name: "total",
      label: "Total",
      kind: "money",
      required: true,
      get: (row) => row.total,
    },
    {
      name: "shippingMethod",
      label: "Shipping method",
      kind: "choice",
      required: true,
      choices: [
        { value: "standard", label: "Standard" },
        { value: "express", label: "Express" },
      ],
      default: "standard",
      get: (row) => row.shippingMethod,
    },
    {
      name: "shippingCost",
      label: "Shipping cost",
      kind: "money",
      required: false,
      computed: true,
      get: (row) => row.shippingCost,
    },
    {
      name: "placedAt",
      label: "Placed at",
      kind: "datetime",
      required: false,
      get: (row) => row.placedAt,
    },
  ],
  compute: withOrderFormulas,
  defaults: orderDefaults,
};

export const orderSchema = createInsertSchema(orders, {
  number: (s) => s.trim().min(1, "Required").max(200, "At most 200 characters"),
}).omit({ id: true, ownerId: true, createdAt: true, updatedAt: true });

export type OrderValues = z.output<typeof orderSchema>;

export const listOrders = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return { rows: await orderData.list(viewer), canCreate: allows(orderAccess.create, viewer) };
});

export const getOrder = createServerFn()
  .validator(z.number().int())
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    const row = await orderData.get(viewer, id);
    if (!row) return null;
    return {
      row,
      canWrite: allows(orderAccess.write, viewer, row.ownerId),
      canDelete: allows(orderAccess.delete, viewer, row.ownerId),
    };
  });

export const createOrder = createServerFn({ method: "POST" })
  .validator(orderSchema)
  .handler(async ({ data }) => orderData.create(await currentViewer(), data));

export const updateOrder = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), values: orderSchema }))
  .handler(async ({ data }) => orderData.update(await currentViewer(), data.id, data.values));

export const deleteOrder = createServerFn({ method: "POST" })
  .validator(z.number().int())
  .handler(async ({ data: id }) => orderData.remove(await currentViewer(), id));
"
`;

