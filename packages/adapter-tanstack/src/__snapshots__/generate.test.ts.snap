"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import type { Rule } from "#/kit/access";

/** Who may open each page. */
export const pageAccess = {
  customers: { public: false, roles: ["admin", "sales"], owner: false },
  orders: { public: false, roles: ["admin", "sales"], owner: false },
