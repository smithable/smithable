exports[`../../../examples/booking/smithable.yml > file list and generated code > src/routes/admin/posts/index.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, Link, useNavigate } from "@tanstack/react-router";
import { pageAccess } from "#/generated/pages";
import { guardPage, allows } from "#/kit/access";
import { createServerFn } from "@tanstack/react-start";
import { z } from "zod";
import { posts } from "#/db/schema";
import { postAccess, postData } from "#/generated/post.server";
import { contains } from "#/kit/search";
import { currentViewer } from "#/lib/viewer.server";
import { buttonVariants } from "#/components/ui/button";
import { app } from "#/generated/app";
import { postUi } from "#/generated/post";
import { PageHeader } from "#/kit/AppShell";
import { ModelTable } from "#/kit/ModelTable";
import { SearchBox } from "#/kit/SearchBox";
import { BookOpen } from "lucide-react";

/** The posts matching the search, among those the viewer may read. */
const searchPosts = createServerFn()
  .validator(z.object({ q: z.string().max(200).optional() }))
  .handler(async ({ data }) => {
    const viewer = await currentViewer();
    const where = data.q ? contains([posts.title, posts.address, posts.summary, posts.body, posts.status], data.q) : undefined;
    const rows = await postData.list(viewer, where, 501);
    return {
      rows: rows.slice(0, 500),
      more: rows.length > 500,
      canCreate: allows(postAccess.create, viewer),
    };
  });

export const Route = createFileRoute("/admin/posts/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["admin"], context.viewer, location.href),
  validateSearch: z.object({ q: z.string().optional().catch(undefined) }),
  loaderDeps: ({ search }) => ({ q: search.q }),
  loader: ({ deps }) => searchPosts({ data: { q: deps.q } }),
  // While a search loads, the page stays (and the box keeps its focus and text), never the
  // placeholder; coming back loads afresh instead of showing rows from before a change.
  pendingMs: Number.POSITIVE_INFINITY,
  gcTime: 0,
  component: AdminPostsPage,
});

function AdminPostsPage() {
  const { rows, canCreate, more } = Route.useLoaderData();
  const { q } = Route.useSearch();
  const navigate = useNavigate();
  const newButton = canCreate && (
    <Link to="/admin/posts/new" className={buttonVariants()}>
      New post
    </Link>
  );
  return (
    <>
      <PageHeader
        title="Posts"
        actions={newButton}
      />
      <SearchBox
        value={q ?? ""}
        placeholder="Search by title, address, summary, body or status"
        onSearch={(text) => navigate({ to: "/admin/posts", search: { q: text || undefined }, replace: true })}
      />
      {more && (
        <p className="text-sm text-muted-foreground">The newest 500 are shown; search to find the others.</p>
      )}
      <ModelTable
        ui={postUi}
        app={app}
        rows={rows}
        icon={BookOpen}
        emptyMessage={q ? \`No posts match “\${q}”.\` : undefined}
        emptyAction={newButton || undefined}
        onOpen={(row) => navigate({ to: "/admin/posts/$id", params: { id: String(row.id) } })}
      />
    </>
  );
}
"
`;

exports[`../../../examples/booking/smithable.yml > file list and generated code > src/routes/admin/posts/new.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, useNavigate } from "@tanstack/react-router";
import { app } from "#/generated/app";
import { pageAccess } from "#/generated/pages";
import { createPost, postSchema, postUi } from "#/generated/post";
import { guardPage } from "#/kit/access";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";

export const Route = createFileRoute("/admin/posts/new")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["admin"], context.viewer, location.href),
  component: NewPostPage,
});

function NewPostPage() {
  const navigate = useNavigate();
  const back = () => navigate({ to: "/admin/posts" });
  return (
    <>
      <PageHeader title="New post" />
      <ModelForm
        ui={postUi}
        app={app}
        schema={postSchema}
        submitLabel="Create post"
        onSubmit={async (values) => {
          await createPost({ data: { ...values, address: values.address || addressFrom(values.title) } });
          await back();
        }}
        onCancel={back}
      />
    </>
  );
}

/** An address from a title: lowercase letters, digits and dashes ("Hello, World!" → hello-world). */
function addressFrom(title: unknown): string {
  return String(title ?? "")
    .normalize("NFD")
    .replace(/[\\u0300-\\u036f]/g, "")
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "")
    .slice(0, 80);
}
"
`;

