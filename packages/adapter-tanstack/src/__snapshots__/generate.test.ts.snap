    {
      name: "componentId",
      label: "Component",
      kind: "relation",
      required: false,
      relation: { key: "component", titleField: "name" },
      get: (row) => row.component?.name ?? null,
    },
    {
      name: "startsAt",
      label: "Starts at",
      kind: "datetime",
      required: true,
      get: (row) => row.startsAt,
    },
    {
      name: "endsAt",
      label: "Ends at",
      kind: "datetime",
      required: true,
      get: (row) => row.endsAt,
    },
    {
      name: "description",
      label: "Description",
      kind: "text",
      required: false,
      get: (row) => row.description,
    },
  ],
};

/** Who may delete maintenances: a list's selection offers Delete by it (the server checks again). */
export const maintenanceDeleteRule: Rule = { public: false, roles: ["admin"], owner: true };


export const listMaintenances = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return { rows: await maintenanceData.list(viewer), canCreate: allows(maintenanceAccess.create, viewer) };
});

export const getMaintenance = createServerFn()
  .validator(z.number().int())
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    const row = await maintenanceData.get(viewer, id);
    if (!row) return null;
    return {
      row,
      canWrite: allows(maintenanceAccess.write, viewer, row.ownerId),
      canDelete: allows(maintenanceAccess.delete, viewer, row.ownerId),
    };
  });

export const createMaintenance = createServerFn({ method: "POST" })
  .validator(maintenanceSchema)
  .handler(async ({ data }) => maintenanceData.create(await writer(), data));

export const updateMaintenance = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), values: maintenanceSchema }))
  .handler(async ({ data }) => maintenanceData.update(await writer(), data.id, data.values));

/** Deletes a maintenance; \`together\` takes what points to it along (docs/design/delete-together.md). */
export const deleteMaintenance = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), together: z.boolean().optional() }))
  .handler(async ({ data }) => maintenanceData.remove(await writer(), data.id, data.together));

/** Deletes the chosen maintenances, all or none (at most 1,000 at once). */
export const deleteMaintenances = createServerFn({ method: "POST" })
  .validator(z.object({ ids: z.array(z.number().int()).max(1000), together: z.boolean().optional() }))
  .handler(async ({ data }) => maintenanceData.removeMany(await writer(), data.ids, data.together));
"
`;

