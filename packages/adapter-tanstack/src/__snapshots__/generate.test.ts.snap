exports[`../../../examples/crm/smithable.yml > file list and generated code > src/db/schema.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { relations, sql } from "drizzle-orm";
import { index, integer, sqliteTable, text, uniqueIndex } from "drizzle-orm/sqlite-core";

export const user = sqliteTable("user", {
  id: text().primaryKey(),
  name: text().notNull(),
  email: text().notNull().unique(),
  emailVerified: integer({ mode: "boolean" }).default(false).notNull(),
  image: text(),
  role: text().notNull().default("sales"),
  createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
  updatedAt: integer({ mode: "timestamp_ms" })
    .notNull()
    .$defaultFn(() => new Date())
    .$onUpdate(() => new Date()),
});

export const session = sqliteTable(
  "session",
  {
    id: text().primaryKey(),
    expiresAt: integer({ mode: "timestamp_ms" }).notNull(),
    token: text().notNull().unique(),
    createdAt: integer({ mode: "timestamp_ms" }).notNull(),
    updatedAt: integer({ mode: "timestamp_ms" }).notNull(),
    ipAddress: text(),
    userAgent: text(),
    userId: text()
      .notNull()
      .references(() => user.id, { onDelete: "cascade" }),
  },
  (t) => [index("session_user_id_idx").on(t.userId)],
);

export const account = sqliteTable(
  "account",
  {
    id: text().primaryKey(),
    accountId: text().notNull(),
    providerId: text().notNull(),
    userId: text()
      .notNull()
      .references(() => user.id, { onDelete: "cascade" }),
    accessToken: text(),
    refreshToken: text(),
    idToken: text(),
    accessTokenExpiresAt: integer({ mode: "timestamp_ms" }),
    refreshTokenExpiresAt: integer({ mode: "timestamp_ms" }),
    scope: text(),
    password: text(),
    createdAt: integer({ mode: "timestamp_ms" }).notNull(),
    updatedAt: integer({ mode: "timestamp_ms" }).notNull(),
  },
  (t) => [index("account_user_id_idx").on(t.userId)],
);

export const verification = sqliteTable(
  "verification",
  {
    id: text().primaryKey(),
    identifier: text().notNull(),
    value: text().notNull(),
    expiresAt: integer({ mode: "timestamp_ms" }).notNull(),
    createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
    updatedAt: integer({ mode: "timestamp_ms" })
      .notNull()
      .$defaultFn(() => new Date())
      .$onUpdate(() => new Date()),
  },
  (t) => [index("verification_identifier_idx").on(t.identifier)],
);

export const invitation = sqliteTable("invitation", {
  id: text().primaryKey(),
  email: text().notNull().unique(),
  role: text().notNull(),
  token: text().notNull().unique(),
  invitedById: text().references(() => user.id, { onDelete: "set null" }),
  createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
  expiresAt: integer({ mode: "timestamp_ms" }).notNull(),
});

export const auditLog = sqliteTable(
  "audit_log",
  {
    id: integer().primaryKey({ autoIncrement: true }),
    at: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
    trace: text(),
    /** A user's id, a key's name, "visitor", or "the app" for its own work. */
    who: text().notNull(),
    role: text(),
    address: text(),
    browser: text(),
    /** created, changed, deleted, copied, or an action's name. */
    action: text().notNull(),
    model: text(),
    recordId: integer(),
    title: text(),
    fields: text({ mode: "json" }).$type<string[]>(),
    details: text({ mode: "json" }).$type<Record<string, unknown>>(),
  },
  (t) => [index("audit_log_at").on(t.at), index("audit_log_record").on(t.model, t.recordId)],
);

export const customers = sqliteTable(
  "customers",
  {
    id: integer().primaryKey({ autoIncrement: true }),
    name: text().notNull(),
    email: text(),
    phone: text(),
    segment: text({ enum: ["smb", "enterprise", "government"] }).notNull().default("smb"),
    creditLimit: integer(),
    notes: text(),
    accountManagerId: text().references(() => user.id, { onDelete: "set null" }),
    createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
    updatedAt: integer({ mode: "timestamp_ms" })
      .notNull()
      .$defaultFn(() => new Date())
      .$onUpdate(() => new Date()),
    /** In the trash since, and by whom (docs/design/trash.md); live records have neither. */
    deletedAt: integer({ mode: "timestamp_ms" }),
    deletedBy: text(),
    /** The record it went to the trash with ("Customer:12"), restored with it (docs/design/delete-together.md). */
    deletedWith: text(),
  },
  (t) => [uniqueIndex("customers_email_unique").on(t.email).where(sql\`\${t.deletedAt} is null\`), index("customers_live").on(t.accountManagerId).where(sql\`\${t.deletedAt} is null\`), index("customers_deleted_with").on(t.deletedWith).where(sql\`\${t.deletedWith} is not null\`)],
);

export const orders = sqliteTable(
  "orders",
  {
    id: integer().primaryKey({ autoIncrement: true }),
    number: text().notNull(),
    customerId: integer().notNull().references(() => customers.id, { onDelete: "restrict" }),
    status: text({ enum: ["draft", "placed", "shipped", "canceled"] }).notNull().default("draft"),
    total: integer().notNull(),
    shippingMethod: text({ enum: ["standard", "express"] }).notNull().default("standard"),
    shippingCost: integer(),
    placedAt: integer({ mode: "timestamp_ms" }),
    ownerId: text().references(() => user.id, { onDelete: "set null" }),
    createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
    updatedAt: integer({ mode: "timestamp_ms" })
      .notNull()
      .$defaultFn(() => new Date())
      .$onUpdate(() => new Date()),
    /** In the trash since, and by whom (docs/design/trash.md); live records have neither. */
    deletedAt: integer({ mode: "timestamp_ms" }),
    deletedBy: text(),
    /** The record it went to the trash with ("Customer:12"), restored with it (docs/design/delete-together.md). */
    deletedWith: text(),
  },
  (t) => [uniqueIndex("orders_number_unique").on(t.number).where(sql\`\${t.deletedAt} is null\`), index("orders_live").on(t.ownerId).where(sql\`\${t.deletedAt} is null\`), index("orders_deleted_with").on(t.deletedWith).where(sql\`\${t.deletedWith} is not null\`)],
);

export const customersRelations = relations(customers, ({ one, many }) => ({
  accountManager: one(user, { fields: [customers.accountManagerId], references: [user.id] }),
  orders: many(orders),
}));

export const ordersRelations = relations(orders, ({ one }) => ({
  customer: one(customers, { fields: [orders.customerId], references: [customers.id] }),
}));
"
`;

