exports[`../../../examples/records/smithable.yml > file list and generated code > src/routes/items/$id.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, notFound, useNavigate } from "@tanstack/react-router";
import { app } from "#/generated/app";
import { pageAccess } from "#/generated/pages";
import { deleteItem, getItem, itemSchema, itemUi, updateItem } from "#/generated/item";
import { guardPage } from "#/kit/access";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";

export const Route = createFileRoute("/items/$id")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["items"], context.viewer, location.href),
  loader: async ({ params }) => {
    const found = await getItem({ data: Number(params.id) });
    if (!found) throw notFound();
    return { ...found };
  },
  component: ItemPage,
});

function ItemPage() {
  const { row, canWrite, canDelete } = Route.useLoaderData();
  const navigate = useNavigate();
  const back = () => navigate({ to: "/items" });
  return (
    <>
      <PageHeader title={row.name || \`Item #\${row.id}\`} />
      <ModelForm
        ui={itemUi}
        app={app}
        schema={itemSchema}
        initial={row}
        readOnly={!canWrite}
        submitLabel="Save changes"
        onSubmit={async (values) => {
          await updateItem({ data: { id: row.id, values } });
          await back();
        }}
        onCancel={back}
        onDelete={
          canDelete
            ? async () => {
                await deleteItem({ data: row.id });
                await back();
              }
            : undefined
        }
      />

    </>
  );
}
"
`;

exports[`../../../examples/records/smithable.yml > file list and generated code > src/routes/items/index.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, Link, useNavigate } from "@tanstack/react-router";
import { pageAccess } from "#/generated/pages";
import { guardPage, allows } from "#/kit/access";
import { createServerFn } from "@tanstack/react-start";
import { z } from "zod";
import { items } from "#/db/schema";
import { itemAccess, itemData } from "#/generated/item.server";
import { contains } from "#/kit/search";
import { currentViewer } from "#/lib/viewer.server";
import { buttonVariants } from "#/components/ui/button";
import { app } from "#/generated/app";
import { itemUi } from "#/generated/item";
import { PageHeader } from "#/kit/AppShell";
import { ModelTable } from "#/kit/ModelTable";
import { SearchBox } from "#/kit/SearchBox";

/** The items matching the search, among those the viewer may read. */
const searchItems = createServerFn()
  .validator(z.object({ q: z.string().max(200).optional() }))
  .handler(async ({ data }) => {
    const viewer = await currentViewer();
    const where = data.q ? contains([items.name, items.summary], data.q) : undefined;
    return { rows: await itemData.list(viewer, where), canCreate: allows(itemAccess.create, viewer) };
  });

export const Route = createFileRoute("/items/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["items"], context.viewer, location.href),
  validateSearch: z.object({ q: z.string().optional().catch(undefined) }),
  loaderDeps: ({ search }) => ({ q: search.q }),
  loader: ({ deps }) => searchItems({ data: { q: deps.q } }),
  component: ItemsPage,
});

function ItemsPage() {
  const { rows, canCreate } = Route.useLoaderData();
  const { q } = Route.useSearch();
  const navigate = useNavigate();
  const newButton = canCreate && (
    <Link to="/items/new" className={buttonVariants()}>
      New item
    </Link>
  );
  return (
    <>
      <PageHeader
        page="items"
        title="Items"
        actions={newButton}
      />
      <SearchBox
        value={q ?? ""}
        placeholder="Search by name or summary"
        onSearch={(text) => navigate({ to: "/items", search: { q: text || undefined }, replace: true })}
      />
      <ModelTable
        ui={itemUi}
        page="items"
        app={app}
        rows={rows}
        emptyMessage={q ? \`No items match “\${q}”.\` : undefined}
        emptyAction={newButton || undefined}
        onOpen={(row) => navigate({ to: "/items/$id", params: { id: String(row.id) } })}
      />
    </>
  );
}
"
`;

