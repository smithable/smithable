import { and, eq, sql, type SQL } from "drizzle-orm";
import { db } from "#/db";
import { invoiceLines } from "#/db/schema";
import { AccessDenied, check, type ModelAccess, readScope, refusal, type Viewer } from "#/kit/access";
import { afterChange, afterDelete } from "./hooks";
import { invoiceData } from "./invoice.server";
import type { InvoiceLineValues } from "./invoice-line";
import { withInvoiceLineFormulas } from "./invoice-line.formulas";

/** Who may read, create, change and delete invoice lines. */
export const invoiceLineAccess: ModelAccess = {
  read: { public: false, roles: ["admin"], owner: true },
  create: { public: false, roles: ["admin", "member"], owner: false },
  write: { public: false, roles: ["admin"], owner: true },
  delete: { public: false, roles: ["admin"], owner: true },
};

/** Checks that the viewer may read the records the values refer to. */
function checkReferences(viewer: Viewer | null, values: InvoiceLineValues): void {
  if (values.invoiceId != null && !invoiceData.canRead(viewer, values.invoiceId))
    throw new AccessDenied(viewer !== null);
}

export const invoiceLineData = {
  /** A condition for the invoice lines the viewer may read. */
  readable(viewer: Viewer | null) {
    const scope = readScope(invoiceLineAccess.read, viewer);
    if (scope === "all") return undefined;
    return scope === "own" && viewer ? eq(invoiceLines.ownerId, viewer.id) : sql\`false\`;
  },

  canRead(viewer: Viewer | null, id: number): boolean {
    const found = db
      .select({ id: invoiceLines.id })
      .from(invoiceLines)
      .where(and(eq(invoiceLines.id, id), invoiceLineData.readable(viewer)))
      .get();
    return found !== undefined;
  },

  /** The invoice lines the viewer may read; \`where\` narrows them, e.g. to a search. */
  async list(viewer: Viewer | null, where?: SQL) {
    if (readScope(invoiceLineAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const rows = await db.query.invoiceLines.findMany({
      where: and(invoiceLineData.readable(viewer), where),
      with: { invoice: { columns: { id: true, number: true } } },
      orderBy: (t, { desc }) => [desc(t.id)],
    });
    return rows.map(withInvoiceLineFormulas);
  },

  async get(viewer: Viewer | null, id: number) {
    const row = await db.query.invoiceLines.findFirst({
      where: and(eq(invoiceLines.id, id), invoiceLineData.readable(viewer)),
      with: { invoice: { columns: { id: true, number: true } } },
    });
    return row ? withInvoiceLineFormulas(row) : null;
  },

  async create(viewer: Viewer | null, values: InvoiceLineValues) {
    check(invoiceLineAccess.create, viewer);
    checkReferences(viewer, values);
    let row: typeof invoiceLines.$inferSelect;
    try {
      row = db.insert(invoiceLines).values({ ...values, ownerId: viewer?.id ?? null }).returning().get();
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterCreate", "InvoiceLine", row, viewer);
    return row;
  },

  async update(viewer: Viewer | null, id: number, values: InvoiceLineValues) {
    const row = db
      .select({ ownerId: invoiceLines.ownerId })
      .from(invoiceLines)
      .where(and(eq(invoiceLines.id, id), invoiceLineData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(invoiceLineAccess.write, viewer, row.ownerId);
    checkReferences(viewer, values);
    let changed: typeof invoiceLines.$inferSelect;
    const updated = values;
    try {
      changed = db.update(invoiceLines).set(updated).where(eq(invoiceLines.id, id)).returning().get();
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterUpdate", "InvoiceLine", changed, viewer);
    return changed;
  },

  async remove(viewer: Viewer | null, id: number): Promise<void> {
    const row = db
      .select({ ownerId: invoiceLines.ownerId })
      .from(invoiceLines)
      .where(and(eq(invoiceLines.id, id), invoiceLineData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(invoiceLineAccess.delete, viewer, row.ownerId);
    try {
      db.delete(invoiceLines).where(eq(invoiceLines.id, id)).run();
    } catch (error) {
      throw refusal(error);
    }
    await afterDelete("InvoiceLine", id, viewer);
  },
};
"
`;

exports[`../../../examples/invoicing/smithable.yml > file list and generated code > src/generated/invoice-line.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { createInsertSchema } from "drizzle-zod";
import { z } from "zod";
import { invoiceLines } from "#/db/schema";
import { allows } from "#/kit/access";
import type { RecordUi } from "#/kit/model";
import { invoiceLineDefaults, withInvoiceLineFormulas } from "./invoice-line.formulas";
import { invoiceLineAccess, invoiceLineData } from "./invoice-line.server";
import { currentViewer } from "#/lib/viewer.server";

/** InvoiceLine records as the kit reads them. */
export type InvoiceLineRow = typeof invoiceLines.$inferSelect & {
  invoice?: { id: number; number: string } | null;
  amount?: unknown;
};

export const invoiceLineUi: RecordUi<InvoiceLineRow> = {
  model: "InvoiceLine",
  label: "Invoice line",
  pluralLabel: "Invoice lines",
  titleField: "description",
  columns: ["invoiceId", "description", "quantity", "unitPrice", "amount"],
  fields: [
    {
      name: "invoiceId",
      label: "Invoice",
      kind: "relation",
      required: true,
      relation: { key: "invoice", titleField: "number" },
      get: (row) => row.invoice?.number ?? null,
    },
    {
      name: "description",
      label: "Description",
      kind: "string",
      required: true,
      get: (row) => row.description,
    },
    {
      name: "quantity",
      label: "Quantity",
      kind: "decimal",
      required: true,
      default: 1,
      get: (row) => row.quantity,
    },
    {
      name: "unitPrice",
      label: "Unit price",
      kind: "money",
      required: true,
      get: (row) => row.unitPrice,
    },
    {
      name: "amount",
      label: "Amount",
      kind: "money",
      required: false,
      computed: true,
      get: (row) => row.amount,
    },
  ],
  compute: withInvoiceLineFormulas,
  defaults: invoiceLineDefaults,
};

export const invoiceLineSchema = createInsertSchema(invoiceLines, {
  description: (s) => s.trim().min(1, "Required").max(200, "At most 200 characters"),
}).omit({ id: true, ownerId: true, createdAt: true, updatedAt: true });

export type InvoiceLineValues = z.output<typeof invoiceLineSchema>;

export const listInvoiceLines = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return { rows: await invoiceLineData.list(viewer), canCreate: allows(invoiceLineAccess.create, viewer) };
});

export const getInvoiceLine = createServerFn()
  .validator(z.number().int())
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    const row = await invoiceLineData.get(viewer, id);
    if (!row) return null;
    return {
      row,
      canWrite: allows(invoiceLineAccess.write, viewer, row.ownerId),
      canDelete: allows(invoiceLineAccess.delete, viewer, row.ownerId),
    };
  });

export const createInvoiceLine = createServerFn({ method: "POST" })
  .validator(invoiceLineSchema)
  .handler(async ({ data }) => invoiceLineData.create(await currentViewer(), data));

export const updateInvoiceLine = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), values: invoiceLineSchema }))
  .handler(async ({ data }) => invoiceLineData.update(await currentViewer(), data.id, data.values));

export const deleteInvoiceLine = createServerFn({ method: "POST" })
  .validator(z.number().int())
  .handler(async ({ data: id }) => invoiceLineData.remove(await currentViewer(), id));
"
`;

