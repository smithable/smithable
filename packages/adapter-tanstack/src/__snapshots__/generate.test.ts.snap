      label: "Email",
      kind: "email",
      required: true,
      get: (row) => row.email,
    },
    {
      name: "address",
      label: "Address",
      kind: "text",
      required: false,
      get: (row) => row.address,
    },
    {
      name: "vatNumber",
      label: "Vat number",
      kind: "string",
      required: false,
      get: (row) => row.vatNumber,
    },
  ],
};

export const clientSchema = createInsertSchema(clients, {
  name: (s) => s.trim().min(1, "Required").max(200, "At most 200 characters"),
  email: z.email("Enter a valid email address"),
  address: (s) => s.max(10000, "At most 10,000 characters"),
  vatNumber: (s) => s.max(200, "At most 200 characters"),
}).omit({ id: true, ownerId: true, createdAt: true, updatedAt: true });

export type ClientValues = z.output<typeof clientSchema>;

export const listClients = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return { rows: await clientData.list(viewer), canCreate: allows(clientAccess.create, viewer) };
});

export const getClient = createServerFn()
  .validator(z.number().int())
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    const row = await clientData.get(viewer, id);
    if (!row) return null;
    return {
      row,
      canWrite: allows(clientAccess.write, viewer, row.ownerId),
      canDelete: allows(clientAccess.delete, viewer, row.ownerId),
    };
  });

/** Choices for fields that refer to a client. */
export const clientOptions = createServerFn().handler(async () =>
  clientData.options(await currentViewer()),
);

export const createClient = createServerFn({ method: "POST" })
  .validator(clientSchema)
  .handler(async ({ data }) => clientData.create(await writer(), data));

export const updateClient = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), values: clientSchema }))
  .handler(async ({ data }) => clientData.update(await writer(), data.id, data.values));

export const deleteClient = createServerFn({ method: "POST" })
  .validator(z.number().int())
  .handler(async ({ data: id }) => clientData.remove(await writer(), id));
"
`;

