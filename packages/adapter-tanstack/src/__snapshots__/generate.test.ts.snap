import { guardPage } from "#/kit/access";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";
import { w } from "#/kit/words";
import { instantOf } from "#/kit/zoned";
import { optional, type Search, text } from "#/kit/params";

export const Route = createFileRoute("/appointments/new")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["appointments"], context.viewer, location.href),
  head: () => pageHead("appointments"),
  validateSearch: (s: Search) => optional({ startsAt: text(s.startsAt, 40) }),
  loader: async () => ({ options: { serviceId: await serviceOptions(), barberId: await barberOptions() } }),
  component: NewAppointmentPage,
});

function NewAppointmentPage() {
  const { options } = Route.useLoaderData();
  const search = Route.useSearch();
  const navigate = useNavigate();
  const back = () => navigate({ to: "/appointments" });
  return (
    <>
      <PageHeader title={w.newOne("appointment")} />
      <ModelForm
        ui={appointmentUi}
        app={app}
        schema={appointmentSchema}
        preset={{ ...(search.startsAt ? { startsAt: instantOf(search.startsAt, app.timeZone) } : {}) }}
        options={options}
        submitLabel={w.createOne("appointment")}
        onSubmit={async (values) => {
          await createAppointment({ data: values });
          await back();
        }}
        onCancel={back}
      />
