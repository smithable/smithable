    });
  });

  test("member", async () => {
    const viewer = signedIn("member");
    const others = insertBooking(stranger.id);
    const own = insertBooking(viewer.id);
    expect({
      readOthers: await reads(bookingData, viewer, others.id),
      readOwn: await reads(bookingData, viewer, own.id),
      create: await can(() => bookingData.create(viewer, bookingValues(viewer.id))),
      changeOthers: await can(() => bookingData.update(viewer, others.id, bookingValues(stranger.id))),
      changeOwn: await can(() => bookingData.update(viewer, own.id, bookingValues(viewer.id))),
      deleteOthers: await can(() => bookingData.remove(viewer, others.id)),
      deleteOwn: await can(() => bookingData.remove(viewer, own.id)),
    }).toEqual({
      readOthers: false,
      readOwn: true,
      create: true,
      changeOthers: false,
      changeOwn: true,
      deleteOthers: false,
      deleteOwn: true,
    });
  });

  test("a visitor who has not signed in", async () => {
    const viewer = null;
    const others = insertBooking(stranger.id);
    expect({
      readOthers: await reads(bookingData, viewer, others.id),
      readOwn: false,
      create: await can(() => bookingData.create(viewer, bookingValues(null))),
      changeOthers: await can(() => bookingData.update(viewer, others.id, bookingValues(stranger.id))),
      changeOwn: false,
      deleteOthers: await can(() => bookingData.remove(viewer, others.id)),
      deleteOwn: false,
    }).toEqual({
      readOthers: false,
      readOwn: false,
      create: false,
      changeOthers: false,
      changeOwn: false,
      deleteOthers: false,
      deleteOwn: false,
    });
  });

  test("a capacity: at most 1 per session, and the number cannot go below what is taken", async () => {
    const viewer = signedIn("admin");
    const place = db.insert(schema.sessions).values({ ...{ ...sessionValues(viewer.id), capacity: 1 }, ownerId: viewer.id }).returning().get();
    for (let i = 0; i < 1; i++)
      await (async (booker) => bookingData.create(booker, { ...bookingValues(viewer.id), sessionId: place.id }))(signedIn("admin"));
    const last = signedIn("admin");
    await expect(bookingData.create(last, { ...bookingValues(viewer.id), sessionId: place.id })).rejects.toThrow("full");
    const admin = signedIn("admin");
    await expect(sessionData.update(admin, place.id, { ...{ ...sessionValues(viewer.id), capacity: 1 }, capacity: 0 })).rejects.toThrow("booked:1");
  });
});

