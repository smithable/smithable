"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, Link, useNavigate } from "@tanstack/react-router";
import { buttonVariants } from "#/components/ui/button";
import { app } from "#/generated/app";
import { listInvoices, invoiceUi } from "#/generated/invoice";
import { PageHeader } from "#/kit/AppShell";
import { ModelTable } from "#/kit/ModelTable";

export const Route = createFileRoute("/invoices/")({
  loader: () => listInvoices(),
  component: InvoicesPage,
});

function InvoicesPage() {
  const rows = Route.useLoaderData();
  const navigate = useNavigate();
  const newButton = (
    <Link to="/invoices/new" className={buttonVariants()}>
      New invoice
    </Link>
  );
  return (
    <>
      <PageHeader title="Invoices" actions={newButton} />
      <ModelTable
        ui={invoiceUi}
        app={app}
        rows={rows}
        emptyAction={newButton}
        onOpen={(row) => navigate({ to: "/invoices/$id", params: { id: String(row.id) } })}
      />
    </>
  );
}
"
`;

