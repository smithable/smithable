"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { eq } from "drizzle-orm";
import { db } from "#/db";
import * as schema from "#/db/schema";
import { AccessDenied, allows, check, type Viewer } from "#/kit/access";
import { audit } from "#/kit/audit.server";
import { afterChange } from "#/generated/hooks";
import { postSettable } from "#/generated/post.schema";
import { postData } from "#/generated/post.server";
import { publishAccess, publishFits } from "./publish";

type Row = NonNullable<Awaited<ReturnType<typeof postData.get>>>;

/** The post's new values (only the fields the action sets), worked out on it as it was. */
function plan(_viewer: Viewer | null, row: Row) {
  return {
    id: row.id,
    values: postSettable.partial().parse({
      status: "published",
    }),

  };
}

/** Runs the "publish" action on the post as the viewer. */
export async function runPublish(viewer: Viewer | null, id: number) {
  const row = await postData.get(viewer, id);
  if (!row) throw new AccessDenied(viewer !== null);
  check(publishAccess, viewer, row.ownerId);
  if (!publishFits(row, viewer)) throw new Error("This cannot be done now.");
  const one = plan(viewer, row);
  return postData.update(viewer, id, one.values, "publish", ["status"]);
}

/**
 * Runs the "publish" action on each chosen post it fits and the viewer may run it on
 * (docs/design/actions.md §9); the others are skipped. All or none: one that is refused stops
 * them all, and is named.
 */
export async function runPublishMany(viewer: Viewer | null, ids: number[]) {
  const plans: ReturnType<typeof plan>[] = [];
  // An id given twice is one record, run once.
  const unique = [...new Set(ids)];
  for (const id of unique) {
    const row = await postData.get(viewer, id);
    if (!row || !allows(publishAccess, viewer, row.ownerId) || !publishFits(row, viewer)) continue;
    try {
      plans.push(plan(viewer, row));
    } catch (error) {
      const why = error instanceof Error ? error.message : String(error);
      throw new Error(\`Post "\${String(row.title ?? row.id)}": \${why}\`);
    }
  }
  const written = db.transaction((tx) => plans.map((p) => {
      const changed = tx.update(schema.posts).set(p.values).where(eq(schema.posts.id, p.id)).returning().get();
      audit(tx, viewer, { action: "publish", model: "Post", record: changed.id, fields: ["status"] });
      const inserted = [

      ] as const;

      return { changed, inserted };
    }));
  for (const w of written) {
    await afterChange("afterUpdate", "Post", w.changed, viewer);

  }
  return { changed: plans.length, skipped: unique.length - plans.length };
}
"
`;

exports[`../../../examples/booking/smithable.yml > file list and generated code > src/generated/actions/publish.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { z } from "zod";
import type { Rule } from "#/kit/access";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { writeAllowed } from "#/kit/limit";
import { currentViewer } from "#/lib/viewer.server";
import { runPublish, runPublishMany } from "./publish.server";

/** Who may run the "publish" action: whoever may edit the post. */
export const publishAccess: Rule = { public: false, roles: ["admin"], owner: true };

/** Whether the "publish" action fits the post: it is offered and allowed only then. */
export function publishFits(row: { status?: unknown }, _viewer: { id: string } | null): boolean {
  return row.status === "draft";
}

/** The viewer about to run it, counted against how often one may write (see src/kit/limit.ts). */
async function writer() {
  const viewer = await currentViewer();
  writeAllowed(viewer, getRequestHeaders());
  return viewer;
}

export const publish = createServerFn({ method: "POST" })
  .validator(z.number().int())
  .handler(async ({ data }) => runPublish(await writer(), data));

/** The "publish" action on the chosen posts (at most 1,000 at once). */
export const publishMany = createServerFn({ method: "POST" })
  .validator(z.object({ ids: z.array(z.number().int()).max(1000) }))
  .handler(async ({ data }) => runPublishMany(await writer(), data.ids));
"
`;

