"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, Link, useNavigate, useRouter } from "@tanstack/react-router";
import { pageAccess, pageUi, pageHead } from "#/generated/pages";
import { guardPage, allows } from "#/kit/access";
import { createServerFn } from "@tanstack/react-start";
import { invoiceLineAccess, invoiceLineData } from "#/generated/invoice-line.server";
import { currentViewer } from "#/lib/viewer.server";
import { type Search, count, listQuery, optional } from "#/kit/params";
import { buttonVariants } from "#/components/ui/button";
import { useState } from "react";
import { SelectionBar } from "#/kit/SelectionBar";
import { csvName, csvOf, download } from "#/kit/csv";
import { deleteInvoiceLines, invoiceLineDeleteRule, invoiceLineUi } from "#/generated/invoice-line";
import { app } from "#/generated/app";
import { w } from "#/kit/words";
import { PageHeader } from "#/kit/AppShell";
import { ModelTable } from "#/kit/ModelTable";

/** A page of the invoice lines the viewer may read. */
const listInvoiceLines = createServerFn()
  .validator(listQuery)
  .handler(async ({ data }) => {
    const viewer = await currentViewer();
    return { ...(await invoiceLineData.page(viewer, undefined, undefined, data.all ? 1 : data.page, data.all ? (viewer ? 10000 : 500) : undefined)), canCreate: allows(invoiceLineAccess.create, viewer) };
  });

export const Route = createFileRoute("/invoice-lines/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["invoice-lines"], context.viewer, location.href),
  head: () => pageHead("invoice-lines"),
  validateSearch: (s: Search) => optional({ page: count(s.page) }),
  loaderDeps: ({ search }) => ({ page: search.page }),
  loader: ({ deps }) => listInvoiceLines({ data: { page: deps.page } }),
  component: InvoiceLinesPage,
});

function InvoiceLinesPage() {
  const { rows, canCreate, total, page: at, size } = Route.useLoaderData();
  const { viewer } = Route.useRouteContext();
  const navigate = useNavigate({ from: "/invoice-lines/" });
  const router = useRouter();
  // The chosen rows, offered when the viewer may do something to at least one row.
  const [selected, setSelected] = useState<Set<number>>(new Set());
  const chosen = rows.filter((row) => selected.has(row.id));
  const selectable = rows.some((row) => allows(invoiceLineDeleteRule, viewer, row.ownerId));
  const newButton = canCreate && (
    <Link to="/invoice-lines/new" className={buttonVariants()}>
      {w.newOne("invoice line")}
    </Link>
  );
  return (
    <>
      <PageHeader
        page="invoice-lines"
        title={pageUi["invoice-lines"].title}
        actions={newButton}
      />
      {selectable && (
        <SelectionBar
          count={chosen.length}
          noun={["invoice line", "invoice lines"]}
          app={app}
          titleOf={(id) => String(rows.find((row) => row.id === id)?.description ?? id)}
          actions={[]}
          deletable={chosen.filter((row) => allows(invoiceLineDeleteRule, viewer, row.ownerId)).length}
          onDelete={(together) => deleteInvoiceLines({ data: { ids: chosen.map((row) => row.id), together } })}
          onDone={async () => {
            setSelected(new Set());
            await router.invalidate();
          }}
          onExport={() => download(csvName(invoiceLineUi), csvOf(invoiceLineUi, chosen))}
        />
      )}
      <ModelTable
        ui={invoiceLineUi}
        page="invoice-lines"
        paging={{ page: at, size, total, to: (next) => navigate({ to: "/invoice-lines", search: (prev) => ({ ...prev, page: next > 1 ? next : undefined }) }) }}
        app={app}
        exportRows={async () => (await listInvoiceLines({ data: { all: true } })).rows}
        rows={rows}
        selection={selectable ? { ids: selected, onChange: setSelected } : undefined}
        emptyAction={newButton || undefined}
        onOpen={(row) => navigate({ to: "/invoice-lines/$id", params: { id: String(row.id) } })}
      />
    </>
  );
}
"
`;

