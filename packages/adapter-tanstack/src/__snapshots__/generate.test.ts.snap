exports[`../../../examples/crm/smithable.yml > file list and generated code > src/generated/customer.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { desc, eq } from "drizzle-orm";
import { createInsertSchema } from "drizzle-zod";
import { z } from "zod";
import { db } from "#/db";
import { customers } from "#/db/schema";
import type { ModelUi } from "#/kit/model";

export const customerUi: ModelUi = {
  label: "Customer",
  pluralLabel: "Customers",
  titleField: "name",
  columns: ["name", "email", "phone", "segment", "creditLimit"],
  fields: [
    { name: "name", label: "Name", kind: "string", required: true },
    { name: "email", label: "Email", kind: "email", required: false },
    { name: "phone", label: "Phone", kind: "phone", required: false },
    {
      name: "segment",
      label: "Segment",
      kind: "choice",
      required: true,
      choices: [
        { value: "smb", label: "Smb" },
        { value: "enterprise", label: "Enterprise" },
        { value: "government", label: "Government" },
      ],
      default: "smb",
    },
    {
      name: "creditLimit",
      label: "Credit limit",
      kind: "money",
      required: false,
      help: "Maximum outstanding balance before new orders are held.",
    },
    { name: "notes", label: "Notes", kind: "text", required: false },
  ],
};

export const customerSchema = createInsertSchema(customers, {
  name: (s) => s.trim().min(1, "Required"),
  email: z.email("Enter a valid email address").nullish(),
  phone: (s) => s.regex(/^\\+?[0-9 ()-]{5,20}$/, "Enter a valid phone number"),
  creditLimit: (s) => s.min(0),
}).omit({ id: true, createdAt: true, updatedAt: true });

export const listCustomers = createServerFn().handler(() =>
  db.select().from(customers).orderBy(desc(customers.id)).all(),
);

export const getCustomer = createServerFn()
  .validator(z.number().int())
  .handler(({ data: id }) => db.select().from(customers).where(eq(customers.id, id)).get() ?? null);

export const createCustomer = createServerFn({ method: "POST" })
  .validator(customerSchema)
  .handler(({ data }) => db.insert(customers).values(data).returning().get());

export const updateCustomer = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), values: customerSchema }))
  .handler(({ data }) =>
    db.update(customers).set(data.values).where(eq(customers.id, data.id)).returning().get(),
  );

export const deleteCustomer = createServerFn({ method: "POST" })
  .validator(z.number().int())
  .handler(({ data: id }) => {
    db.delete(customers).where(eq(customers.id, id)).run();
  });
"
`;

