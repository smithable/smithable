"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { F } from "#/kit/formula";

type Row = Record<string, unknown>;

/** Computed fields of HomeEstimateCalculator, on records as stored (money in cents). */
export const homeEstimateCalculatorFormulas = {
  withoutPass: (r: Row): number => F.toCents((F.n(r.classesPerMonth) * F.fromCents(r.dropIn))),
  saved: (r: Row): number => F.toCents(((F.n(r.classesPerMonth) * F.fromCents(r.dropIn)) - F.fromCents(r.pass))),
};

/** Values suggested when a HomeEstimateCalculator is created. */
export const homeEstimateCalculatorDefaults = {

};

/** The record with its computed fields. */
export function withHomeEstimateCalculatorFormulas<T extends Row>(row: T): T & { withoutPass: number; saved: number } {
  return { ...row, withoutPass: homeEstimateCalculatorFormulas.withoutPass(row), saved: homeEstimateCalculatorFormulas.saved(row) };
}
"
`;

