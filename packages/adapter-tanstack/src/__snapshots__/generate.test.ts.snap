exports[`../../../examples/booking/smithable.yml > file list and generated code > src/routes/admin/index.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, Link } from "@tanstack/react-router";
import { createServerFn } from "@tanstack/react-start";
import { pageAccess } from "#/generated/pages";
import { classTypeData } from "#/generated/class-type.server";
import { instructorData } from "#/generated/instructor.server";
import { sessionData } from "#/generated/session.server";
import { bookingData } from "#/generated/booking.server";
import { messageData } from "#/generated/message.server";
import { guardPage } from "#/kit/access";
import { PageHeader } from "#/kit/AppShell";
import { currentViewer } from "#/lib/viewer.server";

/** How many records of each model the viewer may read; null where they may read none. */
const getCounts = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return {
    "class-types": classTypeData.count(viewer),
    "instructors": instructorData.count(viewer),
    "sessions": sessionData.count(viewer),
    "bookings": bookingData.count(viewer),
    "messages": messageData.count(viewer),
  };
});

const MODELS = [
  { key: "class-types", label: "Class types", to: "/admin/class-types" },
  { key: "instructors", label: "Instructors", to: "/admin/instructors" },
  { key: "sessions", label: "Sessions", to: "/admin/sessions" },
  { key: "bookings", label: "Bookings", to: "/admin/bookings" },
  { key: "messages", label: "Messages", to: "/admin/messages" },
] as const;

export const Route = createFileRoute("/admin/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["admin"], context.viewer, location.href),
  loader: () => getCounts(),
  component: AdminPage,
});

function AdminPage() {
  const counts = Route.useLoaderData();
  return (
    <>
      <PageHeader page="admin" title="Admin" />
      <ul className="divide-y divide-border rounded-lg border border-border bg-card">
        {MODELS.filter((m) => counts[m.key] !== null).map((m) => (
          <li key={m.key}>
            <Link to={m.to} className="flex items-center justify-between gap-4 px-4 py-3 hover:bg-muted">
              <span className="font-medium">{m.label}</span>
              <span className="text-muted-foreground tabular-nums">{counts[m.key]}</span>
            </Link>
          </li>
        ))}
      </ul>
    </>
  );
}
"
`;

exports[`../../../examples/booking/smithable.yml > file list and generated code > src/routes/admin/instructors/$id.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, notFound, useNavigate } from "@tanstack/react-router";
import { app } from "#/generated/app";
import { pageAccess } from "#/generated/pages";
import { deleteInstructor, getInstructor, instructorSchema, instructorUi, updateInstructor } from "#/generated/instructor";
import { guardPage } from "#/kit/access";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";

export const Route = createFileRoute("/admin/instructors/$id")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["admin"], context.viewer, location.href),
  loader: async ({ params }) => {
    const found = await getInstructor({ data: Number(params.id) });
    if (!found) throw notFound();
    return { ...found };
  },
  component: InstructorPage,
});

function InstructorPage() {
  const { row, canWrite, canDelete } = Route.useLoaderData();
  const navigate = useNavigate();
  const back = () => navigate({ to: "/admin/instructors" });
  return (
    <>
      <PageHeader title={row.name || \`Instructor #\${row.id}\`} />
      <ModelForm
        ui={instructorUi}
        app={app}
        schema={instructorSchema}
        initial={row}
        readOnly={!canWrite}
        submitLabel="Save changes"
        onSubmit={async (values) => {
          await updateInstructor({ data: { id: row.id, values } });
          await back();
        }}
        onCancel={back}
        onDelete={
          canDelete
            ? async () => {
                await deleteInstructor({ data: row.id });
                await back();
              }
            : undefined
        }
      />

    </>
  );
}
"
`;

