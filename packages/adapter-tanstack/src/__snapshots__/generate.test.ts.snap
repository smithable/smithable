"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute } from "@tanstack/react-router";
import { pageAccess } from "#/generated/pages";
import { guardPage } from "#/kit/access";
import { LandingLayout, Hero, RecordCards } from "#/kit/Landing";
import { w } from "#/kit/words";
import { site } from "#/generated/site";
import { listItems } from "#/generated/item";

export const Route = createFileRoute("/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["home"], context.viewer, location.href),
  head: () => ({ meta: [{"title":"Our Collection"}] }),
  loader: async () => ({ items: (await listItems()).rows }),
  component: HomePage,
});

function HomePage() {
  const data = Route.useLoaderData();
  const { viewer } = Route.useRouteContext();
  return (
    <LandingLayout appName="Our Collection" link={viewer ? { to: "/items", label: w.openApp("Our Collection") } : { to: "/sign-in", label: w.signIn }} footer={{ links: [], texts: "pages.home.footer" }} site={site}>
      <Hero
          texts="pages.home.hero"
          title="Our Collection"
          subtitle="A place to keep and show a collection of items."
          link={{ to: "/items", label: "Get started" }}
          more
        />
      <RecordCards
          texts="pages.home.items"
          id="items"
          title="Items"
          cards={data.items.slice(0, 6).map((row) => ({
            key: row.id,
            title: String(row.name),
            href: \`/items/\${row.id}\`,
            text: row.summary ?? undefined,
            badge: ({ general: "General", favorite: "Favorite", archived: "Archived" } as Record<string, string>)[row.kind],
          }))}
        />
    </LandingLayout>
  );
}
"
`;

exports[`../../../examples/records/smithable.yml > file list and generated code > src/routes/items/$id.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, notFound, useNavigate } from "@tanstack/react-router";
import { createServerFn } from "@tanstack/react-start";
import { and, desc, eq } from "drizzle-orm";
import { db } from "#/db";
import { auditLog, user } from "#/db/schema";
import { app } from "#/generated/app";
import { pageAccess } from "#/generated/pages";
import { deleteItem, getItem, itemUi, updateItem } from "#/generated/item";
import { itemSchema } from "#/generated/item.schema";
import { guardPage } from "#/kit/access";
import { ActivityLog } from "#/kit/ActivityLog";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";
import { w } from "#/kit/words";
import { currentViewer } from "#/lib/viewer.server";

/** The record's lines in the audit log, newest first: administrators only, nobody else. */
const getHistory = createServerFn()
  .validator((id: number) => id)
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    if (viewer?.role !== "admin") return null;
    const people = new Map(db.select({ id: user.id, name: user.name }).from(user).all().map((p) => [p.id, p.name]));
    return db
      .select()
      .from(auditLog)
      .where(and(eq(auditLog.model, "Item"), eq(auditLog.recordId, id)))
      .orderBy(desc(auditLog.id))
      .limit(50)
      .all()
      .map((r) => ({
        id: r.id,
        at: r.at,
        who: r.who === "visitor" || r.who === "the app" ? r.who : (people.get(r.who) ?? (r.who.startsWith("key:") ? w.aKey(r.who.slice(4)) : w.aRemovedUser(r.who))),
        action: r.action,
        fields: r.fields,
        details: r.details ? Object.fromEntries(Object.entries(r.details).map(([k, v]) => [k, String(v)])) : null,
      }));
  });

export const Route = createFileRoute("/items/$id")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["items"], context.viewer, location.href),
  head: () => ({ meta: [{"title":"Items · Our Collection"}] }),
  loader: async ({ params }) => {
    const found = await getItem({ data: Number(params.id) });
    if (!found) throw notFound();
    return { ...found, history: await getHistory({ data: Number(params.id) }) };
  },
  component: ItemPage,
});

function ItemPage() {
  const { row, canWrite, canDelete, history } = Route.useLoaderData();
  const navigate = useNavigate();
  const back = () => navigate({ to: "/items" });
  return (
    <>
      <PageHeader title={row.name || \`Item #\${row.id}\`} />
      <ModelForm
        key={String(row.updatedAt)}
        ui={itemUi}
        app={app}
        schema={itemSchema}
        initial={row}
        readOnly={!canWrite}
        submitLabel={w.saveChanges}
        onSubmit={async (values) => {
          await updateItem({ data: { id: row.id, values } });
          await back();
        }}
        onCancel={back}
        onDelete={
          canDelete
            ? async (together?: boolean) => {
                await deleteItem({ data: { id: row.id, together } });
                await back();
              }
            : undefined
        }
      />

      {history && history.length > 0 && (
        <section className="mt-10 max-w-3xl">
          <h2 className="mb-3 text-lg font-semibold">{w.history}</h2>
          <ActivityLog lines={history} app={app} />
        </section>
      )}
    </>
  );
}
"
`;

exports[`../../../examples/records/smithable.yml > file list and generated code > src/routes/items/index.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, Link, useNavigate, useRouter } from "@tanstack/react-router";
import { pageAccess } from "#/generated/pages";
import { guardPage, allows } from "#/kit/access";
import { createServerFn } from "@tanstack/react-start";
import * as schema from "#/db/schema";
import { itemAccess, itemData } from "#/generated/item.server";
import { contains } from "#/kit/search";
import { currentViewer } from "#/lib/viewer.server";
import { type Search, count, listQuery, optional, text } from "#/kit/params";
import { buttonVariants } from "#/components/ui/button";
import { useState } from "react";
import { SelectionBar } from "#/kit/SelectionBar";
import { csvName, csvOf, download } from "#/kit/csv";
import { deleteItems, itemDeleteRule, itemUi } from "#/generated/item";
import { app } from "#/generated/app";
import { w } from "#/kit/words";
import { PageHeader } from "#/kit/AppShell";
import { ModelTable } from "#/kit/ModelTable";
import { SearchBox } from "#/kit/SearchBox";

/** The items matching the search, among those the viewer may read. */
const searchItems = createServerFn()
  .validator(listQuery)
  .handler(async ({ data }) => {
    const viewer = await currentViewer();
    const where = data.q ? contains([schema.items.name, schema.items.summary], data.q) : undefined;
    return { ...(await itemData.page(viewer, where, undefined, data.all ? 1 : data.page, data.all ? (viewer ? 10000 : 500) : undefined)), canCreate: allows(itemAccess.create, viewer) };
  });

export const Route = createFileRoute("/items/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["items"], context.viewer, location.href),
  head: () => ({ meta: [{"title":"Items · Our Collection"}] }),
  validateSearch: (s: Search) => optional({ q: text(s.q), page: count(s.page) }),
  loaderDeps: ({ search }) => ({ q: search.q, page: search.page }),
  loader: ({ deps }) => searchItems({ data: { q: deps.q, page: deps.page } }),
  // While a search loads, the page stays (and the box keeps its focus and text), never the
  // placeholder; coming back loads afresh instead of showing rows from before a change.
  pendingMs: Number.POSITIVE_INFINITY,
  gcTime: 0,
  component: ItemsPage,
});

function ItemsPage() {
  const { rows, canCreate, total, page: at, size } = Route.useLoaderData();
  const { q } = Route.useSearch();
  const { viewer } = Route.useRouteContext();
  const navigate = useNavigate({ from: "/items/" });
  const router = useRouter();
  // The chosen rows, offered when the viewer may do something to at least one row.
  const [selected, setSelected] = useState<Set<number>>(new Set());
  const chosen = rows.filter((row) => selected.has(row.id));
  const selectable = rows.some((row) => allows(itemDeleteRule, viewer, row.ownerId));
  const newButton = canCreate && (
    <Link to="/items/new" className={buttonVariants()}>
      {w.newOne("item")}
    </Link>
  );
  return (
    <>
      <PageHeader
        page="items"
        title="Items"
        actions={newButton}
      />
      <SearchBox
        value={q ?? ""}
        placeholder="Search by name or summary"
        onSearch={(text) => navigate({ to: "/items", search: { q: text || undefined }, replace: true, resetScroll: false })}
      />
      {selectable && (
        <SelectionBar
          count={chosen.length}
          noun={["item", "items"]}
          app={app}
          titleOf={(id) => String(rows.find((row) => row.id === id)?.name ?? id)}
          actions={[]}
          deletable={chosen.filter((row) => allows(itemDeleteRule, viewer, row.ownerId)).length}
          onDelete={(together) => deleteItems({ data: { ids: chosen.map((row) => row.id), together } })}
          onDone={async () => {
            setSelected(new Set());
            await router.invalidate();
          }}
          onExport={() => download(csvName(itemUi), csvOf(itemUi, chosen))}
        />
      )}
      <ModelTable
        ui={itemUi}
        page="items"
        paging={{ page: at, size, total, to: (next) => navigate({ to: "/items", search: (prev) => ({ ...prev, page: next > 1 ? next : undefined }) }) }}
        app={app}
        exportRows={async () => (await searchItems({ data: { q, all: true } })).rows}
        rows={rows}
        selection={selectable ? { ids: selected, onChange: setSelected } : undefined}
        emptyMessage={q ? \`No items match “\${q}”.\` : undefined}
        emptyAction={newButton || undefined}
        onOpen={(row) => navigate({ to: "/items/$id", params: { id: String(row.id) } })}
      />
    </>
  );
}
"
`;

