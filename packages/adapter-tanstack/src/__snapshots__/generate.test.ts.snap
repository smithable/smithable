exports[`../../../examples/crm/smithable.yml > file list and generated code > src/generated/access.test.ts 1`] = `
"// Generated by Smithable from smithable.yml and smithable.auth.yml. Do not edit: this file is overwritten on every change.
// For every model and role: which records a user can read, create, change and delete.
// "Own" records are owned by the user; "others" by someone else.
import { describe, expect, test } from "vitest";
import { db } from "#/db";
import { customers, orders, user } from "#/db/schema";
import { AccessDenied, type Viewer } from "#/kit/access";
import { customerData } from "./customer.server";
import { orderData } from "./order.server";

let counter = 0;
const next = () => ++counter;

/** A new signed-in user with the role. */
function signedIn(role: string): Viewer {
  const n = next();
  const viewer = { id: \`test-user-\${n}\`, name: \`Test \${role} \${n}\`, email: \`user\${n}@example.com\`, role };
  db.insert(user).values(viewer).run();
  return viewer;
}

/** Owns the records that are someone else's. */
const stranger = signedIn("sales");

/** Whether the action is allowed; any other failure fails the test. */
async function can(action: () => unknown): Promise<boolean> {
  try {
    await action();
    return true;
  } catch (error) {
    if (error instanceof AccessDenied) return false;
    throw error;
  }
}

/** Whether the viewer can open the record and sees it in the list. */
async function reads(
  data: { get(viewer: never, id: number): Promise<unknown>; list(viewer: never): Promise<{ id: number }[]> },
  viewer: unknown,
  id: number,
): Promise<boolean> {
  const listed = await data.list(viewer as never).then(
    (rows) => rows.some((row) => row.id === id),
    (error) => {
      if (error instanceof AccessDenied) return false;
      throw error;
    },
  );
  return listed && (await data.get(viewer as never, id)) !== null;
}

function customerValues(owner: string | null) {
  const n = next();
  return { name: \`Customer name \${n}\`, email: \`customer\${n}@example.com\`, phone: null, segment: "smb", creditLimit: null, notes: null, accountManagerId: owner } as const;
}

function insertCustomer(owner: string | null, values: Record<string, unknown> = {}) {
  return db
    .insert(customers)
    .values({ ...customerValues(owner), ...values })
    .returning()
    .get();
}

function orderValues(owner: string | null) {
  const n = next();
  return { number: \`Order number \${n}\`, customerId: insertCustomer(owner).id, status: "draft", total: 1000, shippingMethod: "standard", placedAt: null } as const;
}

function insertOrder(owner: string | null, values: Record<string, unknown> = {}) {
  return db
    .insert(orders)
    .values({ ...orderValues(owner), ...values, ownerId: owner })
    .returning()
    .get();
}

describe("Customer", () => {
  test("admin", async () => {
    const viewer = signedIn("admin");
    const others = insertCustomer(stranger.id);
    const own = insertCustomer(viewer.id);
    expect({
      readOthers: await reads(customerData, viewer, others.id),
      readOwn: await reads(customerData, viewer, own.id),
      create: await can(() => customerData.create(viewer, customerValues(viewer.id))),
      changeOthers: await can(() => customerData.update(viewer, others.id, customerValues(viewer.id))),
      changeOwn: await can(() => customerData.update(viewer, own.id, customerValues(viewer.id))),
      deleteOthers: await can(() => customerData.remove(viewer, others.id)),
      deleteOwn: await can(() => customerData.remove(viewer, own.id)),
    }).toEqual({
      readOthers: true,
      readOwn: true,
      create: true,
      changeOthers: true,
      changeOwn: true,
      deleteOthers: true,
      deleteOwn: true,
    });
  });

  test("sales", async () => {
    const viewer = signedIn("sales");
    const others = insertCustomer(stranger.id);
    const own = insertCustomer(viewer.id);
    expect({
      readOthers: await reads(customerData, viewer, others.id),
      readOwn: await reads(customerData, viewer, own.id),
      create: await can(() => customerData.create(viewer, customerValues(viewer.id))),
      changeOthers: await can(() => customerData.update(viewer, others.id, customerValues(viewer.id))),
      changeOwn: await can(() => customerData.update(viewer, own.id, customerValues(viewer.id))),
      deleteOthers: await can(() => customerData.remove(viewer, others.id)),
      deleteOwn: await can(() => customerData.remove(viewer, own.id)),
    }).toEqual({
      readOthers: true,
      readOwn: true,
      create: true,
      changeOthers: true,
      changeOwn: true,
      deleteOthers: false,
      deleteOwn: false,
    });
  });

  test("a visitor who has not signed in", async () => {
    const viewer = null;
    const others = insertCustomer(stranger.id);
    expect({
      readOthers: await reads(customerData, viewer, others.id),
      readOwn: false,
      create: await can(() => customerData.create(viewer, customerValues(null))),
      changeOthers: await can(() => customerData.update(viewer, others.id, customerValues(null))),
      changeOwn: false,
      deleteOthers: await can(() => customerData.remove(viewer, others.id)),
      deleteOwn: false,
    }).toEqual({
      readOthers: false,
      readOwn: false,
      create: false,
      changeOthers: false,
      changeOwn: false,
      deleteOthers: false,
      deleteOwn: false,
    });
  });
});

describe("Order", () => {
  test("admin", async () => {
    const viewer = signedIn("admin");
    const others = insertOrder(stranger.id);
    const own = insertOrder(viewer.id);
    expect({
      readOthers: await reads(orderData, viewer, others.id),
      readOwn: await reads(orderData, viewer, own.id),
      create: await can(() => orderData.create(viewer, orderValues(viewer.id))),
      changeOthers: await can(() => orderData.update(viewer, others.id, orderValues(viewer.id))),
      changeOwn: await can(() => orderData.update(viewer, own.id, orderValues(viewer.id))),
      deleteOthers: await can(() => orderData.remove(viewer, others.id)),
      deleteOwn: await can(() => orderData.remove(viewer, own.id)),
    }).toEqual({
      readOthers: true,
      readOwn: true,
      create: true,
      changeOthers: true,
      changeOwn: true,
      deleteOthers: true,
      deleteOwn: true,
    });
  });

  test("sales", async () => {
    const viewer = signedIn("sales");
    const others = insertOrder(stranger.id);
    const own = insertOrder(viewer.id);
    expect({
      readOthers: await reads(orderData, viewer, others.id),
      readOwn: await reads(orderData, viewer, own.id),
      create: await can(() => orderData.create(viewer, orderValues(viewer.id))),
      changeOthers: await can(() => orderData.update(viewer, others.id, orderValues(viewer.id))),
      changeOwn: await can(() => orderData.update(viewer, own.id, orderValues(viewer.id))),
      deleteOthers: await can(() => orderData.remove(viewer, others.id)),
      deleteOwn: await can(() => orderData.remove(viewer, own.id)),
    }).toEqual({
      readOthers: true,
      readOwn: true,
      create: true,
      changeOthers: true,
      changeOwn: true,
      deleteOthers: false,
      deleteOwn: false,
    });
  });

  test("a visitor who has not signed in", async () => {
    const viewer = null;
    const others = insertOrder(stranger.id);
    expect({
      readOthers: await reads(orderData, viewer, others.id),
      readOwn: false,
      create: await can(() => orderData.create(viewer, orderValues(null))),
      changeOthers: await can(() => orderData.update(viewer, others.id, orderValues(null))),
      changeOwn: false,
      deleteOthers: await can(() => orderData.remove(viewer, others.id)),
      deleteOwn: false,
    }).toEqual({
      readOthers: false,
      readOwn: false,
      create: false,
      changeOthers: false,
      changeOwn: false,
      deleteOthers: false,
      deleteOwn: false,
    });
  });
});
"
`;

exports[`../../../examples/crm/smithable.yml > file list and generated code > src/generated/actions/merge-customers.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { z } from "zod";
import { mergeCustomers as implementation } from "#/custom/actions/merge-customers";
import { customerData } from "#/generated/customer.server";
import { AccessDenied, check, type Rule, type Viewer } from "#/kit/access";
import type { ModelUi } from "#/kit/model";
import { currentViewer } from "#/lib/viewer.server";

/** Who may run the "mergeCustomers" action. */
export const mergeCustomersAccess: Rule = { public: false, roles: ["admin"], owner: false };

/** What the "mergeCustomers" action needs. */
export const mergeCustomersInput = z.object({
  keep: z.number().int(),
  duplicate: z.number().int(),
});

export type MergeCustomersInput = z.infer<typeof mergeCustomersInput>;

/** What the "mergeCustomers" action returns. */
export type MergeCustomersOutput = void;

export const mergeCustomersUi: ModelUi = {
  label: "Merge customers",
  pluralLabel: "Merge customers",
  titleField: "id",
  columns: [],
  fields: [
    {
      name: "keep",
      label: "Keep",
      kind: "relation",
      required: true,
      relation: { key: "keep", titleField: "name" },
    },
    {
      name: "duplicate",
      label: "Duplicate",
      kind: "relation",
      required: true,
      relation: { key: "duplicate", titleField: "name" },
    },
  ],
};

export const mergeCustomers = createServerFn({ method: "POST" })
  .validator(mergeCustomersInput)
  .handler(async ({ data }) => {
    const viewer = await currentViewer();
    check(mergeCustomersAccess, viewer);
    if (data.keep != null && !customerData.canRead(viewer, data.keep)) throw new AccessDenied(true);
    if (data.duplicate != null && !customerData.canRead(viewer, data.duplicate)) throw new AccessDenied(true);
    // The implementation may take the viewer too, e.g. to use the data functions as them.
    const run: (input: MergeCustomersInput, viewer: Viewer | null) => Promise<MergeCustomersOutput> = implementation;
    return run(data, viewer);
  });
"
`;

