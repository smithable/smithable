"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { and, asc, count, eq, gt, gte, inArray, lt, ne, sql, type SQL } from "drizzle-orm";
import { db } from "#/db";
import * as schema from "#/db/schema";
import { AccessDenied, allows, check, Conflict, type ModelAccess, personOf, readScope, type Viewer } from "#/kit/access";
import { audit, changedFields } from "#/kit/audit.server";
import { refusal } from "#/kit/log.server";
import { outgoing } from "#/generated/outgoing.server";
import { afterChange, afterDelete } from "./hooks";
import { app } from "./app";
import { addDays, around, fits as fitsTime, freeTimes, type Schedule, type Taken } from "#/kit/slots";
import { wallTime } from "#/kit/zoned";
import { serviceData } from "./service.server";
import { barberData } from "./barber.server";
import { type AppointmentSettable } from "./appointment";

/** A transaction, as the group's functions are called inside one (docs/design/delete-together.md). */
type Tx = Parameters<Parameters<typeof db.transaction>[0]>[0];

/** The time a barber is booked by (smithable.yml, models.Barber.schedule). */
const SCHEDULE: Schedule = {
  hours: {
    mon: [[540, 1020]],
    tue: [[540, 1020]],
    wed: [[540, 1020]],
    thu: [[540, 1020]],
    fri: [[540, 1020]],
    sat: [[600, 840]],
  },
  breaks: [[720, 750]],
  gap: 10,
};

/** Whether a record takes its barber's time (while it fits occupies.while). */
const holdsTime = (row: Record<string, unknown>) => ["requested","confirmed"].includes(String(row.status));

/** What is taken of a barber's time between two instants: the records that hold it, and time away. */
function takenOf(tx: Tx | typeof db, barberId: number, from: Date, until: Date, except?: number): Taken[] {
  const booked = tx.select({ starts: schema.appointments.startsAt, minutes: schema.services.minutes }).from(schema.appointments).innerJoin(schema.services, eq(schema.services.id, schema.appointments.serviceId)).where(and(eq(schema.appointments.barberId, barberId), gte(schema.appointments.startsAt, from), lt(schema.appointments.startsAt, until), inArray(schema.appointments.status, ["requested","confirmed"]), except === undefined ? undefined : ne(schema.appointments.id, except))).all();
  const away = tx.select({ from: schema.timeOffs.from, until: schema.timeOffs.until }).from(schema.timeOffs).where(and(eq(schema.timeOffs.barberId, barberId), lt(schema.timeOffs.from, until), gt(schema.timeOffs.until, from))).all();
  return [
    ...booked.map((b) => ({ from: b.starts.getTime(), until: b.starts.getTime() + (b.minutes ?? 0) * 60_000 })),
    ...away.map((a) => ({ from: a.from.getTime(), until: a.until.getTime(), away: true })),
  ];
}

/**
 * Refuses a record that would take time its barber does not have: outside the hours, in a
 * break or time away, or over another booking with the gap after it. The refusal names the
 * next free times that day (docs/design/appointments.md §4).
 */
function checkTime(tx: Tx, row: Record<string, unknown>, except?: number) {
  const resource = row.barberId as number | null | undefined;
  const starts = row.startsAt == null ? undefined : new Date(row.startsAt as Date | string | number);
  const minutes = (row.serviceId == null ? null : (tx.select({ n: schema.services.minutes }).from(schema.services).where(eq(schema.services.id, row.serviceId as number)).get()?.n ?? null)) as number | null;
  if (resource == null || !starts || minutes == null || !holdsTime(row)) return;
  const [from, until] = around(wallTime(starts, app.timeZone).slice(0, 10), app.timeZone);
  const taken = takenOf(tx, resource, from, until, except);
  if (fitsTime(SCHEDULE, starts, minutes, taken, app.timeZone)) return;
  const next = freeTimes(SCHEDULE, wallTime(starts, app.timeZone).slice(0, 10), minutes, taken, app.timeZone).slice(0, 3);
  throw new Conflict(\`not-free:\${next.map((t) => t.toISOString()).join(",")}\`);
}

/** Who may read, create, change and delete appointments. */
export const appointmentAccess: ModelAccess = {
  read: { public: false, roles: ["admin"], owner: true },
  create: { public: false, roles: ["admin", "member"], owner: false },
  write: { public: false, roles: ["admin"], owner: true },
  delete: { public: false, roles: ["admin"], owner: true },
};

/** A record as the viewer gets it: who owns it only for its owner and roles that read every record. */
function shownTo<R extends { ownerId: string | null }>(viewer: Viewer | null, row: R): R {
  if ((viewer && row.ownerId === viewer.id) || (!!viewer && (!!viewer.system || appointmentAccess.read.roles.includes(viewer.role)))) return row;
  return { ...row, ownerId: null };
}



/** Checks that the viewer may read the records the values refer to. */
function checkReferences(viewer: Viewer | null, values: Partial<AppointmentSettable>): void {
  if (values.serviceId != null && !serviceData.canRead(viewer, values.serviceId))
    throw new AccessDenied(viewer !== null);
  if (values.barberId != null && !barberData.canRead(viewer, values.barberId))
    throw new AccessDenied(viewer !== null);
}

/** \`rows\` with each \`field\` reference \`readable\` leaves out set to nothing (only its id stays). */
function hideRefs<R extends Record<string, unknown>>(rows: R[], field: string, readable: (ids: number[]) => number[]): R[] {
  const idOf = (row: R) => (row[field] as { id?: unknown } | null | undefined)?.id;
  const ids = [...new Set(rows.map(idOf).filter((id): id is number => typeof id === "number"))];
  if (!ids.length) return rows;
  const shown = new Set(readable(ids));
  return rows.map((row) => {
    const id = idOf(row);
    return typeof id === "number" && !shown.has(id) ? { ...row, [field]: null } : row;
  });
}

export const appointmentData = {
  shownTo,
  /** The rows with each reference to a record the viewer may not read set to nothing: a related record's title is shown only to who may read it (only its id stays). */
  shownRefs<R extends Record<string, unknown>>(viewer: Viewer | null, rows: R[]): R[] {
    return hideRefs(hideRefs(rows, "service", (ids, c = serviceData.readable(viewer)) => (c ? db.select({ id: schema.services.id }).from(schema.services).where(and(inArray(schema.services.id, ids), c)).all().map((r) => r.id) : ids)), "barber", (ids, c = barberData.readable(viewer)) => (c ? db.select({ id: schema.barbers.id }).from(schema.barbers).where(and(inArray(schema.barbers.id, ids), c)).all().map((r) => r.id) : ids));
  },

  /** A condition for the appointments the viewer may read. */
  readable(viewer: Viewer | null) {
    const scope = readScope(appointmentAccess.read, viewer);
    if (scope === "all") return undefined;
    return scope === "own" && viewer ? eq(schema.appointments.ownerId, viewer.id) : sql\`false\`;
  },

  canRead(viewer: Viewer | null, id: number): boolean {
    const found = db
      .select({ id: schema.appointments.id })
      .from(schema.appointments)
      .where(and(eq(schema.appointments.id, id), appointmentData.readable(viewer)))
      .get();
    return found !== undefined;
  },

  /** The appointments the viewer may read; \`where\` narrows them, e.g. to a search. */
  async list(viewer: Viewer | null, where?: SQL) {
    if (readScope(appointmentAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const found = appointmentData.shownRefs(viewer, await db.query.appointments.findMany({
      where: and(appointmentData.readable(viewer), where),
      with: { service: { columns: { id: true, name: true } }, barber: { columns: { id: true, name: true } } },
      orderBy: (t, { desc }) => [desc(t.id)],
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return rows;
  },

  /**
   * A page of the appointments the viewer may read that fit \`where\`, newest first (or in
   * \`order\`), and how many fit in all: for a list page. A page past the end is the last one.
   */
  async page(viewer: Viewer | null, where?: SQL, order?: SQL, page = 1, size = 50) {
    if (readScope(appointmentAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = and(appointmentData.readable(viewer), where);
    const total = db.select({ n: count() }).from(schema.appointments).where(condition).get()?.n ?? 0;
    const at = Math.min(Math.max(1, Math.trunc(page)), Math.max(1, Math.ceil(total / size)));
    const found = appointmentData.shownRefs(viewer, await db.query.appointments.findMany({
      where: condition,
      with: { service: { columns: { id: true, name: true } }, barber: { columns: { id: true, name: true } } },
      orderBy: (t, { desc }) => [...(order ? [order] : []), desc(t.id)],
      limit: size,
      offset: (at - 1) * size,
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return { rows: rows, total, page: at, size };
  },

  /**
   * A day's free times for the picker: of one barber, or of every one the viewer may read, the
   * first free one in their order taking each time. With \`first\`, the first day from \`date\` that
   * has any, within 60 days.
   */
  freeTimes(viewer: Viewer | null, input: { resource?: number | null; length: number; date: string; first?: boolean }): { date: string; times: { at: string; resource: number }[] } {
    const minutes = serviceData.canRead(viewer, input.length) ? (db.select({ n: schema.services.minutes }).from(schema.services).where(eq(schema.services.id, input.length)).get()?.n ?? null) : null;
    const resources =
      input.resource == null
        ? db.select({ id: schema.barbers.id }).from(schema.barbers).where(barberData.readable(viewer)).orderBy(asc(schema.barbers.id)).all().map((r) => r.id)
        : barberData.canRead(viewer, input.resource) ? [input.resource] : [];
    for (let day = 0; minutes && day < (input.first ? 60 : 1); day++) {
      const date = addDays(input.date, day);
      const [from, until] = around(date, app.timeZone);
      const free = new Map<number, number>();
      for (const resource of resources)
        for (const at of freeTimes(SCHEDULE, date, minutes, takenOf(db, resource, from, until), app.timeZone))
          if (!free.has(at.getTime())) free.set(at.getTime(), resource);
      if (free.size || !input.first)
        return { date, times: [...free].sort((a, b) => a[0] - b[0]).map(([at, resource]) => ({ at: new Date(at).toISOString(), resource })) };
    }
    return { date: input.date, times: [] };
  },

  /** Whether the viewer may cancel this appointment themselves now: their own, holding time, more than 12h before its start. */
  cancelState(viewer: Viewer | null, id: number): { can: boolean; late: boolean } | null {
    if (!viewer) return null;
    const row = db.select().from(schema.appointments).where(and(eq(schema.appointments.id, id), appointmentData.readable(viewer))).get();
    if (!row || row.ownerId !== viewer.id || !holdsTime(row)) return null;
    const closes = row.startsAt.getTime() - 720 * 60_000;
    return { can: Date.now() < closes, late: Date.now() >= closes };
  },

  /** Cancels the viewer's own appointment while they may: Appointment.status becomes cancelled. */
  async cancelOwn(viewer: Viewer | null, id: number) {
    if (!appointmentData.cancelState(viewer, id)?.can) throw new AccessDenied(viewer !== null);
    return appointmentData.update(viewer, id, { status: "cancelled" }, "cancelled");
  },

  async get(viewer: Viewer | null, id: number) {
    const fetched = await db.query.appointments.findFirst({
      where: and(eq(schema.appointments.id, id), appointmentData.readable(viewer)),
      with: { service: { columns: { id: true, name: true } }, barber: { columns: { id: true, name: true } } },
    });
    const found = fetched && appointmentData.shownRefs(viewer, [fetched])[0];
    const row = found && shownTo(viewer, found);
    return row ? row : null;
  },

  async create(viewer: Viewer | null, values: AppointmentSettable) {
    check(appointmentAccess.create, viewer);
    checkReferences(viewer, values);
    let row: typeof schema.appointments.$inferSelect;
    try {
      // The time's check and the insert in one transaction: two people cannot both take the same time.
      row = db.transaction((tx) => {
        checkTime(tx, { status: "requested", ...values });
        const made = tx.insert(schema.appointments).values({ ...values, ownerId: personOf(viewer) }).returning().get();
        audit(tx, viewer, { action: "created", model: "Appointment", record: made.id });
        outgoing(tx, viewer, "Appointment", "created", made);
        return made;
      });
    } catch (error) {
      throw error instanceof Conflict ? error : refusal(error);
    }
    await afterChange("afterCreate", "Appointment", row, viewer);
    return row;
  },

  /** Changes the record; \`what\` names the change in the audit log (an action's name). */
  /** Changes the fields given; what names the action ("changed" for a form), frees the fields it may change although locked (its own set). */
  async update(viewer: Viewer | null, id: number, values: Partial<AppointmentSettable>, what = "changed", _frees: readonly string[] = []) {
    const row = db
      .select({ ownerId: schema.appointments.ownerId })
      .from(schema.appointments)
      .where(and(eq(schema.appointments.id, id), appointmentData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    // A form's change needs write on the record; an action (what names it) checked its own access
    // first, which includes the roles its grant names (docs/design/actions.md, Access).
    if (what === "changed") check(appointmentAccess.write, viewer, row.ownerId);
    checkReferences(viewer, values);
    let changed: typeof schema.appointments.$inferSelect;
    const updated = values;
    try {
      changed = db.transaction((tx) => {
        // Read again in the change itself: a record that left the viewer's reach meanwhile is refused.
        const before = tx.select().from(schema.appointments).where(and(eq(schema.appointments.id, id), appointmentData.readable(viewer))).get();
        if (!before) throw new AccessDenied(viewer !== null);
        // A change that moves the time it takes (or takes time again) is checked like a new one.
        const moving: Record<string, unknown> = updated;
        if (!holdsTime(before) || ["barberId", "startsAt", "serviceId", "status"].some((k) => k in moving && JSON.stringify(moving[k]) !== JSON.stringify(before[k as keyof typeof before])))
          checkTime(tx, { ...before, ...updated }, id);
        const after = tx.update(schema.appointments).set(updated).where(eq(schema.appointments.id, id)).returning().get();
        audit(tx, viewer, { action: what, model: "Appointment", record: id, fields: before && changedFields(before, after, Object.keys(updated)) });
        outgoing(tx, viewer, "Appointment", what, after, before);
        return after;
      });
    } catch (error) {
      throw error instanceof Conflict ? error : refusal(error);
    }
    await afterChange("afterUpdate", "Appointment", changed, viewer);
    return changed;
  },

  /** Deletes the record; \`together\` takes the records that point to it along to the trash (delete-together.md). */
  async remove(viewer: Viewer | null, id: number, _together = false): Promise<void> {
    const row = db
      .select({ ownerId: schema.appointments.ownerId })
      .from(schema.appointments)
      .where(and(eq(schema.appointments.id, id), appointmentData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(appointmentAccess.delete, viewer, row.ownerId);
    try {
      db.transaction((tx) => {
        // Read again in the change itself: a record that left the viewer's reach meanwhile is refused.
        if (!tx.select({ id: schema.appointments.id }).from(schema.appointments).where(and(eq(schema.appointments.id, id), appointmentData.readable(viewer))).get())
          throw new AccessDenied(viewer !== null);
        const gone = tx.delete(schema.appointments).where(eq(schema.appointments.id, id)).returning().get();
        if (gone) {
          audit(tx, viewer, { action: "deleted", model: "Appointment", record: id, title: gone.name });
          outgoing(tx, viewer, "Appointment", "deleted", gone);
        }
      });
    } catch (error) {
      throw refusal(error);
    }
    await afterDelete("Appointment", id, viewer);
  },

  /**
   * Deletes the chosen records the viewer may delete, all or none (one still in use stops them
   * all, and is named); the others are skipped.
   */
  async removeMany(viewer: Viewer | null, ids: number[], _together = false): Promise<{ deleted: number; skipped: number }> {
    const rows = db
      .select({ id: schema.appointments.id, ownerId: schema.appointments.ownerId })
      .from(schema.appointments)
      .where(and(inArray(schema.appointments.id, ids), appointmentData.readable(viewer)))
      .all()
      .filter((row) => allows(appointmentAccess.delete, viewer, row.ownerId));
    db.transaction((tx) => {
      for (const row of rows)
        try {
          const gone = tx.delete(schema.appointments).where(eq(schema.appointments.id, row.id)).returning().get();
          if (gone) {
            audit(tx, viewer, { action: "deleted", model: "Appointment", record: row.id, title: gone.name });
            outgoing(tx, viewer, "Appointment", "deleted", gone);
          }
        } catch (error) {
          const refused = refusal(error);
          throw refused instanceof Conflict && refused.message === "in-use" ? new Conflict(\`in-use:\${row.id}\`) : refused;
        }
    });
    for (const row of rows) {
      await afterDelete("Appointment", row.id, viewer);
    }
    return { deleted: rows.length, skipped: new Set(ids).size - rows.length };
  },
};
"
`;

exports[`../../../examples/barbers/smithable.yml > file list and generated code > src/generated/appointment.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { z } from "zod";
import type * as schema from "#/db/schema";
import { allows, type Rule } from "#/kit/access";
import type { RecordUi } from "#/kit/model";
import { bindSlots } from "#/kit/Slots";
import { appointmentAccess, appointmentData } from "./appointment.server";
import { writeAllowed } from "#/kit/limit";
import { currentViewer } from "#/lib/viewer.server";
import { appointmentSchema } from "./appointment.schema";

export type { AppointmentSettable, AppointmentValues } from "./appointment.schema";

/** The viewer about to write, counted against how often one may (see src/kit/limit.ts). */
async function writer() {
  const viewer = await currentViewer();
  writeAllowed(viewer, getRequestHeaders());
  return viewer;
}

/** Appointment records as the kit reads them. */
export type AppointmentRow = typeof schema.appointments.$inferSelect & {
  service?: { id: number; name: string } | null;
  barber?: { id: number; name: string } | null;
};

/** A day's free times for the form's picker (docs/design/appointments.md §4). */
export const appointmentTimes = createServerFn()
  .validator(z.object({ resource: z.number().int().positive().nullable(), length: z.number().int().positive(), date: z.string().regex(/^\\d{4}-\\d{2}-\\d{2}$/), first: z.boolean().optional() }))
  .handler(async ({ data }) => appointmentData.freeTimes(await currentViewer(), data));

/** Whether the viewer may cancel their own appointment now (the record page's Cancel). */
export const appointmentCancelState = createServerFn()
  .validator(z.number().int())
  .handler(async ({ data: id }) => appointmentData.cancelState(await currentViewer(), id));

/** Cancels the viewer's own appointment, while they may. */
export const cancelOwnAppointment = createServerFn({ method: "POST" })
  .validator(z.number().int())
  .handler(async ({ data: id }) => appointmentData.cancelOwn(await writer(), id));

export const appointmentUi: RecordUi<AppointmentRow> = {
  model: "Appointment",
  label: "Appointment",
  pluralLabel: "Appointments",
  titleField: "name",
  columns: ["name", "serviceId", "barberId", "startsAt", "status"],
  fields: [
    {
      name: "serviceId",
      label: "Service",
      kind: "relation",
      required: true,
      relation: { key: "service", titleField: "name" },
      get: (row) => row.service?.name ?? null,
    },
    {
      name: "barberId",
      label: "Barber",
      kind: "relation",
      required: true,
      relation: { key: "barber", titleField: "name" },
      get: (row) => row.barber?.name ?? null,
    },
    {
      name: "startsAt",
      label: "Starts at",
      kind: "datetime",
      required: true,
      input: bindSlots(appointmentTimes, { resource: "barberId", length: "serviceId" }),
      get: (row) => row.startsAt,
    },
    {
      name: "name",
      label: "Name",
      kind: "string",
      required: true,
      get: (row) => row.name,
    },
    {
      name: "phone",
      label: "Phone",
      kind: "phone",
      required: false,
      get: (row) => row.phone,
    },
    {
      name: "note",
      label: "Note",
      kind: "text",
      required: false,
      get: (row) => row.note,
    },
    {
      name: "status",
      label: "Status",
      kind: "choice",
      required: true,
      byApp: true,
      choices: [
        { value: "requested", label: "Requested" },
        { value: "confirmed", label: "Confirmed" },
        { value: "cancelled", label: "Cancelled" },
      ],
      default: "requested",
      get: (row) => row.status,
    },
  ],
};

/** Who may delete appointments: a list's selection offers Delete by it (the server checks again). */
export const appointmentDeleteRule: Rule = { public: false, roles: ["admin"], owner: true };


export const listAppointments = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return { rows: await appointmentData.list(viewer), canCreate: allows(appointmentAccess.create, viewer) };
});

export const getAppointment = createServerFn()
  .validator(z.number().int())
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    const row = await appointmentData.get(viewer, id);
    if (!row) return null;
    return {
      row,
      canWrite: allows(appointmentAccess.write, viewer, row.ownerId),
      canDelete: allows(appointmentAccess.delete, viewer, row.ownerId),
    };
  });

export const createAppointment = createServerFn({ method: "POST" })
  .validator(appointmentSchema)
  .handler(async ({ data }) => appointmentData.create(await writer(), data));

export const updateAppointment = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), values: appointmentSchema }))
  .handler(async ({ data }) => appointmentData.update(await writer(), data.id, data.values));

