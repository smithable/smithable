    return db
      .select()
      .from(auditLog)
      .where(and(eq(auditLog.model, "Message"), eq(auditLog.recordId, id)))
      .orderBy(desc(auditLog.id))
      .limit(50)
      .all()
      .map((r) => ({
        id: r.id,
        at: r.at,
