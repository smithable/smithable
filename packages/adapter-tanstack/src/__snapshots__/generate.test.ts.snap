"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createInsertSchema } from "drizzle-zod";
import { z } from "zod";
import * as schema from "#/db/schema";
import { w } from "#/kit/words";

/** What a invoice may be given: a form's values and what the app fills (an action's set). */
export const invoiceSettable = createInsertSchema(schema.invoices, {
  number: (s) => s.trim().min(1, w.required).max(200, w.atMostCharacters(200)),
  issuedOn: (s) => s.regex(/^\\d{4}-\\d{2}-\\d{2}$/, w.enterValidDate),
  dueOn: (s) => s.regex(/^\\d{4}-\\d{2}-\\d{2}$/, w.enterValidDate),
  contract: z.object({ file: z.string().regex(/^invoice\\/[a-f0-9]{24}\\.[a-z0-9]{2,4}$/), name: z.string().max(200), type: z.string().max(100), size: z.int().nonnegative(), receipt: z.string().max(64).optional() }).nullish(),
}).omit({ id: true, ownerId: true, createdAt: true, updatedAt: true });
/** What a invoice's form sends, checked. */
export const invoiceSchema = invoiceSettable;

export type InvoiceSettable = z.output<typeof invoiceSettable>;
export type InvoiceValues = z.output<typeof invoiceSchema>;
"
`;

