            },
            "where": {
              "type": "object",
              "description": "Field values to match, e.g. {\\"status\\":\\"open\\"}; a list means any of them; a number or date takes {\\"from\\":…,\\"to\\":…}; a reference takes an id or the record's title (\\"me\\" for a user); {\\"mine\\":true} is the caller's own records."
            },
