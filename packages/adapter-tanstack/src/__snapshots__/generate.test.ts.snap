import { createFileRoute, notFound, useNavigate } from "@tanstack/react-router";
import { deleteOrder, getOrder, orderSchema, orderUi, updateOrder } from "#/generated/order";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";

export const Route = createFileRoute("/orders/$id")({
  loader: async ({ params }) => {
    const row = await getOrder({ data: Number(params.id) });
    if (!row) throw notFound();
    return row;
  },
  component: OrderPage,
});

function OrderPage() {
  const row = Route.useLoaderData();
  const navigate = useNavigate();
  const back = () => navigate({ to: "/orders" });
  return (
    <>
      <PageHeader title={row.number || \`Order #\${row.id}\`} />
      <ModelForm
        ui={orderUi}
        schema={orderSchema}
        initial={row}
        submitLabel="Save changes"
        onSubmit={async (values) => {
          await updateOrder({ data: { id: row.id, values } });
          await back();
        }}
        onCancel={back}
        onDelete={async () => {
          await deleteOrder({ data: row.id });
          await back();
        }}
      />
    </>
  );
}
"
`;

