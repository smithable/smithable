"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { and, asc, count, eq, inArray, sql, type SQL } from "drizzle-orm";
import { db } from "#/db";
import * as schema from "#/db/schema";
import { AccessDenied, allows, check, Conflict, type ModelAccess, personOf, readScope, type Viewer } from "#/kit/access";
import { audit, changedFields } from "#/kit/audit.server";
import { refusal } from "#/kit/log.server";
import { contains } from "#/kit/search";
import { deletePicture } from "#/kit/uploads";
import { acceptFiles } from "#/kit/receipts.server";
import { afterChange, afterDelete } from "./hooks";
import { timeOffData } from "./time-off.server";
import { timeOffUi } from "./time-off";
import { appointmentUi } from "./appointment";
import { barberUi, type BarberSettable } from "./barber";

/** A transaction, as the group's functions are called inside one (docs/design/delete-together.md). */
type Tx = Parameters<Parameters<typeof db.transaction>[0]>[0];

/**
 * What points to a barber (docs/design/delete-together.md): the records that would go with it
 * to the trash, by model, and those that would show no barber; nothing when nothing does.
 */
function usedBy(tx: Tx, id: number, title: string) {
  const pointing: { model: string; from: string; label: string; plural: string; depth: number; count: number | null }[] = [
    { model: "TimeOff", label: timeOffUi.label, plural: timeOffUi.pluralLabel, from: "Barber", depth: 1, count: tx.select({ n: count() }).from(schema.timeOffs).where(and(eq(schema.timeOffs.barberId, id))).get()?.n ?? 0 },
    { model: "Appointment", label: appointmentUi.label, plural: appointmentUi.pluralLabel, from: "Barber", depth: 1, count: tx.select({ n: count() }).from(schema.appointments).where(and(eq(schema.appointments.barberId, id))).get()?.n ?? 0 },
  ];
  // A deeper member is named when its parent has records ("and what belongs to them").
  const with_: typeof pointing = [];
  for (const e of pointing)
    if (e.count === null ? with_.some((p) => p.model === e.from) : e.count > 0) with_.push(e);
  if (!with_.length) return undefined;
  const loose = [] as { model: string; label: string; plural: string; count: number }[];
  return { id, title, model: "Barber", label: barberUi.label, with: with_, loose, together: false, missing: [barberUi.label, timeOffUi.label, appointmentUi.label] };
}

/** Who may read, create, change and delete barbers. */
export const barberAccess: ModelAccess = {
  read: { public: true, roles: ["admin"], owner: true },
  create: { public: false, roles: ["admin"], owner: false },
  write: { public: false, roles: ["admin"], owner: true },
  delete: { public: false, roles: ["admin"], owner: true },
};

/** A record as the viewer gets it: who owns it only for its owner and roles that read every record. */
function shownTo<R extends { ownerId: string | null }>(viewer: Viewer | null, row: R): R {
  if ((viewer && row.ownerId === viewer.id) || (!!viewer && (!!viewer.system || barberAccess.read.roles.includes(viewer.role)))) return row;
  return { ...row, ownerId: null };
}



/** Each picture or document new to the record must come with the receipt its upload gave the viewer (src/kit/receipts.server.ts); the receipts are not kept. */
function checkFiles<V extends Partial<BarberSettable>>(viewer: Viewer | null, values: V, before?: Record<string, unknown>): V {
  return {
    ...values,
    ...("portrait" in values ? { portrait: acceptFiles(viewer, "barber", "portrait", values.portrait, before?.portrait) } : {}),
  };
}

export const barberData = {
  shownTo,
  /** The rows with each reference to a record the viewer may not read set to nothing: a related record's title is shown only to who may read it (only its id stays). */
  shownRefs<R extends Record<string, unknown>>(_viewer: Viewer | null, rows: R[]): R[] {
    return rows;
  },

  /** Whether a stored picture or document is on any record (the trash too): a file no record has may go. */
  uses(file: string): boolean {
    return !!db.select({ id: schema.barbers.id }).from(schema.barbers).where(sql\`\${schema.barbers.portrait} like \${\`%"file":"\${file}"%\`}\`).get();
  },

  /** A condition for the barbers the viewer may read. */
  readable(viewer: Viewer | null) {
    const scope = readScope(barberAccess.read, viewer);
    if (scope === "all") return undefined;
    return scope === "own" && viewer ? eq(schema.barbers.ownerId, viewer.id) : sql\`false\`;
  },

  canRead(viewer: Viewer | null, id: number): boolean {
    const found = db
      .select({ id: schema.barbers.id })
      .from(schema.barbers)
      .where(and(eq(schema.barbers.id, id), barberData.readable(viewer)))
      .get();
    return found !== undefined;
  },

  /** The barbers the viewer may read; \`where\` narrows them, e.g. to a search. */
  async list(viewer: Viewer | null, where?: SQL) {
    if (readScope(barberAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const found = barberData.shownRefs(viewer, await db.query.barbers.findMany({
      where: and(barberData.readable(viewer), where),
      orderBy: (t, { desc }) => [desc(t.id)],
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return rows;
  },

  /**
   * A page of the barbers the viewer may read that fit \`where\`, newest first (or in
   * \`order\`), and how many fit in all: for a list page. A page past the end is the last one.
   */
  async page(viewer: Viewer | null, where?: SQL, order?: SQL, page = 1, size = 50) {
    if (readScope(barberAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = and(barberData.readable(viewer), where);
    const total = db.select({ n: count() }).from(schema.barbers).where(condition).get()?.n ?? 0;
    const at = Math.min(Math.max(1, Math.trunc(page)), Math.max(1, Math.ceil(total / size)));
    const found = barberData.shownRefs(viewer, await db.query.barbers.findMany({
      where: condition,
      orderBy: (t, { desc }) => [...(order ? [order] : []), desc(t.id)],
      limit: size,
      offset: (at - 1) * size,
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return { rows: rows, total, page: at, size };
  },

  async get(viewer: Viewer | null, id: number) {
    const fetched = await db.query.barbers.findFirst({
      where: and(eq(schema.barbers.id, id), barberData.readable(viewer)),
      with: { timeOffs: { where: timeOffData.readable(viewer) } },
    });
    const found = fetched && barberData.shownRefs(viewer, [fetched])[0];
    const row = found && { ...shownTo(viewer, found), timeOffs: found.timeOffs.map((r) => timeOffData.shownTo(viewer, r)) };
    return row ? row : null;
  },

  async create(viewer: Viewer | null, values: BarberSettable) {
    check(barberAccess.create, viewer);
    values = checkFiles(viewer, values);
    let row: typeof schema.barbers.$inferSelect;
    try {
      row = db.transaction((tx) => {
        const made = tx.insert(schema.barbers).values({ ...values, ownerId: personOf(viewer) }).returning().get();
        audit(tx, viewer, { action: "created", model: "Barber", record: made.id });
        return made;
      });
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterCreate", "Barber", row, viewer);
    return row;
  },

  /** Changes the record; \`what\` names the change in the audit log (an action's name). */
  /** Changes the fields given; what names the action ("changed" for a form), frees the fields it may change although locked (its own set). */
  async update(viewer: Viewer | null, id: number, values: Partial<BarberSettable>, what = "changed", _frees: readonly string[] = []) {
    const row = db
      .select({ ownerId: schema.barbers.ownerId, portrait: schema.barbers.portrait })
      .from(schema.barbers)
      .where(and(eq(schema.barbers.id, id), barberData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    // A form's change needs write on the record; an action (what names it) checked its own access
    // first, which includes the roles its grant names (docs/design/actions.md, Access).
    if (what === "changed") check(barberAccess.write, viewer, row.ownerId);
    values = checkFiles(viewer, values, db.select({ portrait: schema.barbers.portrait }).from(schema.barbers).where(eq(schema.barbers.id, id)).get());
    let changed: typeof schema.barbers.$inferSelect;
    const updated = values;
    try {
      changed = db.transaction((tx) => {
        // Read again in the change itself: a record that left the viewer's reach meanwhile is refused.
        const before = tx.select().from(schema.barbers).where(and(eq(schema.barbers.id, id), barberData.readable(viewer))).get();
        if (!before) throw new AccessDenied(viewer !== null);
        const after = tx.update(schema.barbers).set(updated).where(eq(schema.barbers.id, id)).returning().get();
        audit(tx, viewer, { action: what, model: "Barber", record: id, fields: before && changedFields(before, after, Object.keys(updated)) });
        return after;
      });
    } catch (error) {
      throw refusal(error);
    }
    if (row.portrait && row.portrait.file !== changed.portrait?.file) deletePicture(row.portrait, !!db.select({ id: schema.barbers.id }).from(schema.barbers).where(sql\`\${schema.barbers.portrait} like \${\`%"file":"\${row.portrait.file}"%\`}\`).get());
    await afterChange("afterUpdate", "Barber", changed, viewer);
    return changed;
  },

  /** Deletes the record; \`together\` takes the records that point to it along to the trash (delete-together.md). */
  async remove(viewer: Viewer | null, id: number, _together = false): Promise<void> {
    const row = db
      .select({ name: schema.barbers.name, ownerId: schema.barbers.ownerId, portrait: schema.barbers.portrait })
      .from(schema.barbers)
      .where(and(eq(schema.barbers.id, id), barberData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(barberAccess.delete, viewer, row.ownerId);
    try {
      db.transaction((tx) => {
        // Read again in the change itself: a record that left the viewer's reach meanwhile is refused.
        if (!tx.select({ id: schema.barbers.id }).from(schema.barbers).where(and(eq(schema.barbers.id, id), barberData.readable(viewer))).get())
          throw new AccessDenied(viewer !== null);
        const used = usedBy(tx, id, String(row.name ?? id));
        if (used) throw new Conflict(\`in-use:\${JSON.stringify(used)}\`);
        const gone = tx.delete(schema.barbers).where(eq(schema.barbers.id, id)).returning().get();
        if (gone) {
          audit(tx, viewer, { action: "deleted", model: "Barber", record: id, title: gone.name });
        }
      });
    } catch (error) {
      throw refusal(error);
    }
    if (row.portrait && row.portrait.file !== undefined) deletePicture(row.portrait, !!db.select({ id: schema.barbers.id }).from(schema.barbers).where(sql\`\${schema.barbers.portrait} like \${\`%"file":"\${row.portrait.file}"%\`}\`).get());
    await afterDelete("Barber", id, viewer);
  },

  /**
   * Deletes the chosen records the viewer may delete, all or none (one still in use stops them
   * all, and is named); the others are skipped.
   */
  async removeMany(viewer: Viewer | null, ids: number[], _together = false): Promise<{ deleted: number; skipped: number }> {
    const rows = db
      .select({ id: schema.barbers.id, name: schema.barbers.name, ownerId: schema.barbers.ownerId, portrait: schema.barbers.portrait })
      .from(schema.barbers)
      .where(and(inArray(schema.barbers.id, ids), barberData.readable(viewer)))
      .all()
      .filter((row) => allows(barberAccess.delete, viewer, row.ownerId));
    db.transaction((tx) => {
      for (const row of rows)
        try {
          const used = usedBy(tx, row.id, String(row.name ?? row.id));
          if (used) throw new Conflict(\`in-use:\${JSON.stringify(used)}\`);
          const gone = tx.delete(schema.barbers).where(eq(schema.barbers.id, row.id)).returning().get();
          if (gone) {
            audit(tx, viewer, { action: "deleted", model: "Barber", record: row.id, title: gone.name });
          }
        } catch (error) {
          const refused = refusal(error);
          throw refused instanceof Conflict && refused.message === "in-use" ? new Conflict(\`in-use:\${row.id}\`) : refused;
        }
    });
    for (const row of rows) {
      if (row.portrait && row.portrait.file !== undefined) deletePicture(row.portrait, !!db.select({ id: schema.barbers.id }).from(schema.barbers).where(sql\`\${schema.barbers.portrait} like \${\`%"file":"\${row.portrait.file}"%\`}\`).get());
      await afterDelete("Barber", row.id, viewer);
    }
    return { deleted: rows.length, skipped: new Set(ids).size - rows.length };
  },

  /**
   * The barbers the viewer may read whose name contains the text: a search of records that
   * refer to them finds them only among these.
   */
  titled(viewer: Viewer | null, text: string): number[] {
    return db
      .select({ id: schema.barbers.id })
      .from(schema.barbers)
      .where(and(contains([schema.barbers.name], text), barberData.readable(viewer)))
      .all()
      .map((row) => row.id);
  },

  /** Choices for fields that refer to a barber: the ones the viewer may read. */
  options(viewer: Viewer | null) {
    if (readScope(barberAccess.read, viewer) === "none") return [];
    return db
      .select({ value: schema.barbers.id, label: schema.barbers.name })
      .from(schema.barbers)
      .where(barberData.readable(viewer))
      .orderBy(asc(schema.barbers.name))
      .all();
  },
};
"
`;

