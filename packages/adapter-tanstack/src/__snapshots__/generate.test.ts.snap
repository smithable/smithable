    const record = insertOrder(viewer.id, {"status":"accepted"});
    await expect(runAccept(viewer, record.id)).rejects.toThrow("This cannot be done now.");
  });

  test("over chosen records, only those it fits and may run on change", async () => {
    const viewer = signedIn("admin");
    const fitting = insertOrder(viewer.id, {"status":"new"});
    const notFitting = insertOrder(viewer.id, {"status":"accepted"});
    const notFittingBefore = JSON.stringify(db.select().from(schema.orders).where(eq(schema.orders.id, notFitting.id)).get());
    expect(await runAcceptMany(viewer, [fitting.id, fitting.id, notFitting.id])).toEqual({ changed: 1, skipped: 1 });
    expect(JSON.stringify(db.select().from(schema.orders).where(eq(schema.orders.id, notFitting.id)).get())).toBe(notFittingBefore);
    const again = insertOrder(viewer.id, {"status":"new"});
    const againBefore = JSON.stringify(db.select().from(schema.orders).where(eq(schema.orders.id, again.id)).get());
    await runAcceptMany(null, [again.id]).catch(() => undefined);
    expect(JSON.stringify(db.select().from(schema.orders).where(eq(schema.orders.id, again.id)).get())).toBe(againBefore);
  });
});

