                "Incident"
              ]
            },
            "of": {
              "type": "string",
              "description": "count (the default), or \\"sum total\\", \\"average total\\", \\"min …\\", \\"max …\\"."
            },
            "where": {
              "type": "object",
              "description": "Field values to match, e.g. {\\"status\\":\\"open\\"}; a list means any of them; a number or date takes {\\"from\\":…,\\"to\\":…}; a reference takes an id or the record's title (\\"me\\" for a user); {\\"mine\\":true} is the caller's own records."
            },
            "search": {
              "type": "string",
              "description": "Words to look for in the records' texts."
            },
            "by": {
              "type": "string",
              "description": "A choice, yes/no, reference or date field."
            }
