exports[`../../../examples/booking/smithable.yml > file list and generated code > tests/smoke.spec.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { readdirSync, readFileSync } from "node:fs";
import { join } from "node:path";
import { expect, type Page, test } from "@playwright/test";

/** Opens a page and fails on any error in the browser, e.g. a script the policy blocked. */
async function visit(page: Page, route: string) {
  const errors: string[] = [];
  page.on("pageerror", (e) => errors.push(e.message));
  page.on("console", (m) => m.type() === "error" && errors.push(m.text()));
  await page.goto(route);
  await page.waitForLoadState("networkidle");
  await expect(page.locator("h1").first()).toBeVisible();
  expect(errors).toEqual([]);
}

/**
 * Signs in through the development sign-in. A click before the page has hydrated reaches no
 * handler, and the development server may reload the page for a library it just found: try again.
 */
async function signIn(page: Page, role: string) {
  for (let attempt = 1; ; attempt++) {
    await page.goto("/sign-in");
    await page.locator('body[data-hydrated="true"]').waitFor();
    await page.getByRole("button", { name: \`Sign in as \${role}\` }).click();
    try {
      await page.waitForURL((url) => url.pathname !== "/sign-in", { timeout: 15_000 });
      return;
    } catch (error) {
      // A slow redirect may still land: signed in by then, nothing to try again.
      if (new URL(page.url()).pathname !== "/sign-in") return;
      if (attempt === 3) throw error;
    }
  }
}

// Every page once before the tests: the development server compiles a page on its first visit
// (and may reload for a new library), which on a busy machine takes most of a test's minute.
test.beforeAll(async ({ browser }) => {
  test.setTimeout(300_000);
  const slow: string[] = [];
  const warm = async (role: string | undefined, routes: string[]) => {
    const context = await browser.newContext();
    const page = await context.newPage();
    const open = async (route: string) => {
      try {
        await page.goto(route, { timeout: 90_000 });
        await page.waitForLoadState("networkidle", { timeout: 45_000 });
      } catch {
        slow.push(role ? \`\${route} (as \${role})\` : route);
      }
    };
    if (role) await signIn(page, role).catch(() => {});
    for (const route of routes) await open(route);
    await context.close();
  };
  await warm(undefined, ["/", "/schedule", "/blog", "/privacy"]);
  await warm("admin", ["/sessions", "/class-types", "/instructors", "/messages", "/posts", "/my-bookings", "/admin"]);
  if (slow.length) throw new Error(\`Pages that did not open while warming up: \${slow.join(", ")}\`);
});

test("Home opens for a visitor", async ({ page }) => {
  await visit(page, "/");
});
test("Schedule opens for a visitor", async ({ page }) => {
  await visit(page, "/schedule");
});
test("Blog opens for a visitor", async ({ page }) => {
  await visit(page, "/blog");
});
test("Privacy opens for a visitor", async ({ page }) => {
  await visit(page, "/privacy");
});
test("Sessions needs sign-in", async ({ page }) => {
  await page.goto("/sessions");
  await expect(page).toHaveURL(/sign-in/);
});
test("Class types needs sign-in", async ({ page }) => {
  await page.goto("/class-types");
  await expect(page).toHaveURL(/sign-in/);
});
test("Instructors needs sign-in", async ({ page }) => {
  await page.goto("/instructors");
  await expect(page).toHaveURL(/sign-in/);
});
test("Messages needs sign-in", async ({ page }) => {
  await page.goto("/messages");
  await expect(page).toHaveURL(/sign-in/);
});
test("Posts needs sign-in", async ({ page }) => {
  await page.goto("/posts");
  await expect(page).toHaveURL(/sign-in/);
});
test("My bookings needs sign-in", async ({ page }) => {
  await page.goto("/my-bookings");
  await expect(page).toHaveURL(/sign-in/);
});
test("Admin needs sign-in", async ({ page }) => {
  await page.goto("/admin");
  await expect(page).toHaveURL(/sign-in/);
});

test.describe("signed in as admin", () => {
  test.beforeEach(async ({ page }) => {
    await signIn(page, "admin");
  });

  test("Sessions opens", async ({ page }) => {
    await visit(page, "/sessions");
  });
  test("Class types opens", async ({ page }) => {
    await visit(page, "/class-types");
  });
  test("Instructors opens", async ({ page }) => {
    await visit(page, "/instructors");
  });
  test("Messages opens", async ({ page }) => {
    await visit(page, "/messages");
  });
  test("Posts opens", async ({ page }) => {
    await visit(page, "/posts");
  });
  test("My bookings opens", async ({ page }) => {
    await visit(page, "/my-bookings");
  });
  test("Admin opens", async ({ page }) => {
    await visit(page, "/admin");
  });
});

test.describe("signed in as member", () => {
  test.beforeEach(async ({ page }) => {
    await signIn(page, "member");
  });

  test("My bookings opens", async ({ page }) => {
    await visit(page, "/my-bookings");
  });
});

/** The sign-in code mailed to an address, from the smoke tests' outbox (no mail is sent). */
function codeFor(address: string): string | undefined {
  const outbox = join("data", "smoke", "mail", "outbox");
  let files: string[] = [];
  try {
    files = readdirSync(outbox).sort().reverse();
  } catch {}
  for (const file of files) {
    const mail = readFileSync(join(outbox, file), "utf8").replace(/=\\r?\\n/g, "");
    if (mail.includes(\`To: \${address}\`)) return /is (\\d{3} \\d{3})\\./.exec(mail)?.[1];
  }
  return undefined;
}

test("signing in with a code from the outbox", async ({ page }) => {
  const address = \`dev-code-\${Date.now()}@example.com\`;
  await page.goto("/sign-in");
  await page.locator('body[data-hydrated="true"]').waitFor();
  await page.getByLabel("Email address").fill(address);
  await page.getByRole("button", { name: "Send me a code" }).click();
  // The page asks for the code (its words differ when the mail stays in the outbox).
  await expect(page.getByLabel("Code")).toBeVisible();
  await expect.poll(() => codeFor(address), { timeout: 15_000 }).toBeTruthy();
  await page.getByLabel("Code").fill(codeFor(address) as string);
  await page.getByRole("button", { name: "Sign in", exact: true }).click();
  await page.waitForURL((url) => url.pathname !== "/sign-in");
});
"
`;

