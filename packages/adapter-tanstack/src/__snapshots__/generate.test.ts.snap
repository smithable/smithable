  --secondary: oklch(0.945373 0.011590 264.5097);
  --secondary-foreground: oklch(0.244862 0.038771 264.3540);
  --accent-foreground: oklch(0.244862 0.038771 264.3540);
  --input: oklch(0.608320 0.037767 263.4399);
  --ring: oklch(0.510573 0.230053 276.9656);
  --sidebar-foreground: oklch(0.244862 0.038771 264.3540);
  --destructive: oklch(0.505420 0.190493 27.5181);
  --success: oklch(0.447925 0.108321 151.3277);
  --warning: oklch(0.476186 0.103366 61.9071);
  --destructive-foreground: oklch(1.000000 0.000000 89.8756);
  --success-foreground: oklch(1.000000 0.000000 89.8756);
  --warning-foreground: oklch(1.000000 0.000000 89.8756);
  --chart-1: oklch(0.510573 0.230053 276.9656);
  --chart-2: oklch(0.510938 0.086055 186.3914);
  --chart-3: oklch(0.553781 0.120683 66.4416);
  --chart-4: oklch(0.557537 0.252488 302.3212);
  --chart-5: oklch(0.514256 0.197806 16.9350);
  --radius: 10px;
  --font-body: "Inter Variable", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  --control-height: 2.75rem;
  --row-height: 4rem;
  --cell-padding: 1rem;
  --card-padding: 1.5rem;
  --motion-fast: 120ms;
  --motion-slow: 180ms;
  --motion-ease: cubic-bezier(0.2, 0, 0, 1);
  --motion-distance: 6px;
  --landing-motion: none;
  --hero-motion: none;
  --font-heading: "Inter Variable", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  --heading-weight: 700;
  --heading-tracking: -0.02em;
  --heading-scale: 1;
  --heading-case: none;
  --card-shadow: 0 1px 2px rgb(0 0 0 / 0.05);
  --card-border: 1px;
  --card-border-color: var(--border);
  --section-background: transparent;
  --section-border: 0;
  --section-gap: 0;
  --divider: var(--border);
  --button-radius: calc(var(--radius) - 2px);
  --button-weight: 600;
  --picture-radius: initial;
  --picture-frame: 0;
  --table-numbers: normal;
  --row-divider: var(--divider);
  --row-stripe: transparent;
  --hover: color-mix(in oklch, var(--foreground) 7%, transparent);
  --primary-hover: color-mix(in oklch, var(--primary), black 20%);
  --destructive-hover: color-mix(in oklch, var(--destructive), black 20%);
}

/* Touch screens get 44 px targets whatever the density. */
@media (pointer: coarse) {
  :root {
    --control-height: 2.75rem;
  }
}

/* A visitor who asks for less motion gets none, whatever the theme says. */
@media (prefers-reduced-motion: reduce) {
  :root {
    --motion-fast: 0ms;
    --motion-slow: 0ms;
    --motion-distance: 0px;
    --landing-motion: none;
    --hero-motion: none;
  }
}

@media (prefers-color-scheme: dark) {
  :root {
    --background: oklch(0.197469 0.027449 267.7258);
    --foreground: oklch(0.961159 0.018238 269.0896);
