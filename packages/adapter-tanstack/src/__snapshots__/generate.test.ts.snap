"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, Link, useNavigate } from "@tanstack/react-router";
import { pageAccess } from "#/generated/pages";
import { guardPage, allows } from "#/kit/access";
import { createServerFn } from "@tanstack/react-start";
import { bookingAccess, bookingData } from "#/generated/booking.server";
import { currentViewer } from "#/lib/viewer.server";
import { buttonVariants } from "#/components/ui/button";
import { app } from "#/generated/app";
import { bookingUi } from "#/generated/booking";
import { PageHeader } from "#/kit/AppShell";
import { ModelTable } from "#/kit/ModelTable";

/** The newest bookings the viewer may read. */
const listBookings = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  const rows = await bookingData.list(viewer, undefined, 501);
    return {
      rows: rows.slice(0, 500),
      more: rows.length > 500,
      canCreate: allows(bookingAccess.create, viewer),
    };
});

export const Route = createFileRoute("/admin/bookings/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["admin"], context.viewer, location.href),
  loader: () => listBookings(),
  component: AdminBookingsPage,
});

function AdminBookingsPage() {
  const { rows, canCreate, more } = Route.useLoaderData();
  const navigate = useNavigate();
  const newButton = canCreate && (
    <Link to="/admin/bookings/new" className={buttonVariants()}>
      New booking
    </Link>
  );
  return (
    <>
      <PageHeader
        title="Bookings"
        actions={newButton}
      />
      {more && (
        <p className="text-sm text-muted-foreground">The newest 500 are shown.</p>
      )}
      <ModelTable
        ui={bookingUi}
        app={app}
        rows={rows}
        emptyAction={newButton || undefined}
        onOpen={(row) => navigate({ to: "/admin/bookings/$id", params: { id: String(row.id) } })}
      />
    </>
  );
}
"
`;

