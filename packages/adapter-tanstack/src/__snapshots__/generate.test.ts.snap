exports[`../../../examples/records/smithable.yml > file list and generated code > src/generated/item.server.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { and, eq, sql, type SQL } from "drizzle-orm";
import { db } from "#/db";
import { items } from "#/db/schema";
import { AccessDenied, check, type ModelAccess, readScope, refusal, type Viewer } from "#/kit/access";
import { afterChange, afterDelete } from "./hooks";
import type { ItemValues } from "./item";
import { withItemFormulas } from "./item.formulas";

/** Who may read, create, change and delete items. */
export const itemAccess: ModelAccess = {
  read: { public: true, roles: ["admin"], owner: true },
  create: { public: false, roles: ["admin"], owner: false },
  write: { public: false, roles: ["admin"], owner: false },
  delete: { public: false, roles: ["admin"], owner: false },
};

export const itemData = {
  /** A condition for the items the viewer may read. */
  readable(viewer: Viewer | null) {
    const scope = readScope(itemAccess.read, viewer);
    if (scope === "all") return undefined;
    return scope === "own" && viewer ? eq(items.ownerId, viewer.id) : sql\`false\`;
  },

  canRead(viewer: Viewer | null, id: number): boolean {
    const found = db
      .select({ id: items.id })
      .from(items)
      .where(and(eq(items.id, id), itemData.readable(viewer)))
      .get();
    return found !== undefined;
  },

  /** The items the viewer may read; \`where\` narrows them, e.g. to a search. */
  async list(viewer: Viewer | null, where?: SQL) {
    if (readScope(itemAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const rows = await db.query.items.findMany({
      where: and(itemData.readable(viewer), where),
      orderBy: (t, { desc }) => [desc(t.id)],
    });
    return rows.map(withItemFormulas);
  },

  async get(viewer: Viewer | null, id: number) {
    const row = await db.query.items.findFirst({
      where: and(eq(items.id, id), itemData.readable(viewer)),
    });
    return row ? withItemFormulas(row) : null;
  },

  async create(viewer: Viewer | null, values: ItemValues) {
    check(itemAccess.create, viewer);
    let row: typeof items.$inferSelect;
    try {
      row = db.insert(items).values({ ...values, ownerId: viewer?.id ?? null }).returning().get();
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterCreate", "Item", row, viewer);
    return row;
  },

  async update(viewer: Viewer | null, id: number, values: ItemValues) {
    const row = db
      .select({ ownerId: items.ownerId })
      .from(items)
      .where(and(eq(items.id, id), itemData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(itemAccess.write, viewer, row.ownerId);
    let changed: typeof items.$inferSelect;
    const updated = values;
    try {
      changed = db.update(items).set(updated).where(eq(items.id, id)).returning().get();
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterUpdate", "Item", changed, viewer);
    return changed;
  },

  async remove(viewer: Viewer | null, id: number): Promise<void> {
    const row = db
      .select({ ownerId: items.ownerId })
      .from(items)
      .where(and(eq(items.id, id), itemData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(itemAccess.delete, viewer, row.ownerId);
    try {
      db.delete(items).where(eq(items.id, id)).run();
    } catch (error) {
      throw refusal(error);
    }
    await afterDelete("Item", id, viewer);
  },
};
"
`;

exports[`../../../examples/records/smithable.yml > file list and generated code > src/generated/item.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { createInsertSchema } from "drizzle-zod";
import { z } from "zod";
import { items } from "#/db/schema";
import { allows } from "#/kit/access";
import type { RecordUi } from "#/kit/model";
import { itemDefaults, withItemFormulas } from "./item.formulas";
import { itemAccess, itemData } from "./item.server";
import { writeAllowed } from "#/kit/limit";
import { currentViewer } from "#/lib/viewer.server";

/** The viewer about to write, counted against how often one may (see src/kit/limit.ts). */
async function writer() {
  const viewer = await currentViewer();
  writeAllowed(viewer, getRequestHeaders());
  return viewer;
}

/** Item records as the kit reads them. */
export type ItemRow = typeof items.$inferSelect;

export const itemUi: RecordUi<ItemRow> = {
  model: "Item",
  label: "Item",
  pluralLabel: "Items",
  titleField: "name",
  descriptionField: "summary",
  columns: ["name", "kind", "addedOn", "link"],
  fields: [
    {
      name: "name",
      label: "Name",
      kind: "string",
      required: true,
      get: (row) => row.name,
    },
    {
      name: "summary",
      label: "Summary",
      kind: "text",
      required: false,
      get: (row) => row.summary,
    },
    {
      name: "kind",
      label: "Kind",
      kind: "choice",
      required: true,
      choices: [
        { value: "general", label: "General" },
        { value: "favourite", label: "Favourite" },
        { value: "archived", label: "Archived" },
      ],
      default: "general",
      get: (row) => row.kind,
    },
    {
      name: "link",
      label: "Link",
      kind: "url",
      required: false,
      get: (row) => row.link,
    },
    {
      name: "addedOn",
      label: "Added on",
      kind: "date",
      required: true,
      get: (row) => row.addedOn,
    },
  ],
  compute: withItemFormulas,
  defaults: itemDefaults,
};

export const itemSchema = createInsertSchema(items, {
  name: (s) => s.trim().min(1, "Required").max(200, "At most 200 characters"),
  summary: (s) => s.max(10000, "At most 10,000 characters"),
  link: z.url("Enter a valid web address").nullish(),
  addedOn: (s) => s.regex(/^\\d{4}-\\d{2}-\\d{2}$/, "Enter a valid date"),
}).omit({ id: true, ownerId: true, createdAt: true, updatedAt: true });

export type ItemValues = z.output<typeof itemSchema>;

export const listItems = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return { rows: await itemData.list(viewer), canCreate: allows(itemAccess.create, viewer) };
});

export const getItem = createServerFn()
  .validator(z.number().int())
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    const row = await itemData.get(viewer, id);
    if (!row) return null;
    return {
      row,
      canWrite: allows(itemAccess.write, viewer, row.ownerId),
      canDelete: allows(itemAccess.delete, viewer, row.ownerId),
    };
  });

export const createItem = createServerFn({ method: "POST" })
  .validator(itemSchema)
  .handler(async ({ data }) => itemData.create(await writer(), data));

export const updateItem = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), values: itemSchema }))
  .handler(async ({ data }) => itemData.update(await writer(), data.id, data.values));

export const deleteItem = createServerFn({ method: "POST" })
  .validator(z.number().int())
  .handler(async ({ data: id }) => itemData.remove(await writer(), id));
"
`;

