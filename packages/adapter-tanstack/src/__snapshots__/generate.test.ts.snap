"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { createInsertSchema } from "drizzle-zod";
import { z } from "zod";
import { instructors } from "#/db/schema";
import { allows } from "#/kit/access";
import type { RecordUi } from "#/kit/model";
import { MarkdownEditor } from "#/kit/Markdown";
import { bindPicture } from "#/kit/PictureInput";
import { instructorAccess, instructorData } from "./instructor.server";
import { writeAllowed } from "#/kit/limit";
import { currentViewer } from "#/lib/viewer.server";

/** The viewer about to write, counted against how often one may (see src/kit/limit.ts). */
async function writer() {
  const viewer = await currentViewer();
  writeAllowed(viewer, getRequestHeaders());
  return viewer;
}

/** Instructor records as the kit reads them. */
export type InstructorRow = typeof instructors.$inferSelect;

export const instructorUi: RecordUi<InstructorRow> = {
  model: "Instructor",
  label: "Instructor",
  pluralLabel: "Instructors",
  titleField: "name",
  columns: ["name", "portrait"],
  fields: [
    {
      name: "name",
      label: "Name",
      kind: "string",
      required: true,
      get: (row) => row.name,
    },
    {
      name: "bio",
      label: "Bio",
      kind: "markdown",
      required: false,
      input: MarkdownEditor,
      get: (row) => row.bio,
    },
    {
      name: "portrait",
      label: "Portrait",
      kind: "picture",
      required: false,
      input: bindPicture("instructor", "portrait"),
      get: (row) => row.portrait,
    },
  ],
};

export const instructorSchema = createInsertSchema(instructors, {
  name: (s) => s.trim().min(1, "Required").max(200, "At most 200 characters"),
  bio: (s) => s.max(50000, "At most 50,000 characters"),
  portrait: z.object({ file: z.string().max(100), alt: z.string().trim().max(200), width: z.int().positive(), height: z.int().positive() }).nullish(),
}).omit({ id: true, ownerId: true, createdAt: true, updatedAt: true });

export type InstructorValues = z.output<typeof instructorSchema>;

export const listInstructors = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return { rows: await instructorData.list(viewer), canCreate: allows(instructorAccess.create, viewer) };
});

export const getInstructor = createServerFn()
  .validator(z.number().int())
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    const row = await instructorData.get(viewer, id);
    if (!row) return null;
    return {
      row,
      canWrite: allows(instructorAccess.write, viewer, row.ownerId),
      canDelete: allows(instructorAccess.delete, viewer, row.ownerId),
    };
  });

/** Choices for fields that refer to a instructor. */
export const instructorOptions = createServerFn().handler(async () =>
  instructorData.options(await currentViewer()),
);

export const createInstructor = createServerFn({ method: "POST" })
  .validator(instructorSchema)
  .handler(async ({ data }) => instructorData.create(await writer(), data));

export const updateInstructor = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), values: instructorSchema }))
  .handler(async ({ data }) => instructorData.update(await writer(), data.id, data.values));

export const deleteInstructor = createServerFn({ method: "POST" })
  .validator(z.number().int())
  .handler(async ({ data: id }) => instructorData.remove(await writer(), id));
"
`;

