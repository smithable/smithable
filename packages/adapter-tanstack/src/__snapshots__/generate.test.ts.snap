  const chosen = rows.filter((row) => selected.has(row.id));
  const selectable = rows.some((row) => allows(messageDeleteRule, viewer, row.ownerId));
  const newButton = canCreate && (
    <Link to="/messages/new" className={buttonVariants()}>
      {w.newOne("message")}
    </Link>
  );
  return (
    <>
      <PageHeader
        page="messages"
        title={pageUi["messages"].title}
        actions={newButton}
      />
      {selectable && (
        <SelectionBar
          count={chosen.length}
          noun={["message", "messages"]}
