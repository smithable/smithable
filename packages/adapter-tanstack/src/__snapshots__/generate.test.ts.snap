"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { type AnyColumn, and, asc, avg, count, desc, eq, inArray, isNotNull, max, min, sql, sum, type SQL } from "drizzle-orm";
import { db } from "#/db";
import * as schema from "#/db/schema";
import { AccessDenied, allows, check, Conflict, type ModelAccess, personOf, readScope, type Viewer } from "#/kit/access";
import { audit, changedFields } from "#/kit/audit.server";
import { refusal } from "#/kit/log.server";
import { outgoing } from "#/generated/outgoing.server";
import { contains } from "#/kit/search";
import { BadInput } from "#/kit/refusal";
import { aggregate, type Filterable, nearest, sortOf, whereOf, wordsOf } from "#/kit/where";
import { deleteFile } from "#/kit/uploads";
import { acceptFiles } from "#/kit/receipts.server";
import { afterChange, afterDelete } from "./hooks";
import { invoiceLineData } from "./invoice-line.server";
import { clientData } from "./client.server";
import { invoiceLineUi } from "./invoice-line";
import { invoiceUi, type InvoiceSettable } from "./invoice";
import { withInvoiceFormulas } from "./invoice.formulas";
import "./timers.server";

/** A transaction, as the group's functions are called inside one (docs/design/delete-together.md). */
type Tx = Parameters<Parameters<typeof db.transaction>[0]>[0];

/**
 * What points to a invoice (docs/design/delete-together.md): the records that would go with it
 * to the trash, by model, and those that would show no invoice; nothing when nothing does.
 */
function usedBy(tx: Tx, id: number, title: string) {
  const pointing: { model: string; from: string; label: string; plural: string; depth: number; count: number | null }[] = [
    { model: "InvoiceLine", label: invoiceLineUi.label, plural: invoiceLineUi.pluralLabel, from: "Invoice", depth: 1, count: tx.select({ n: count() }).from(schema.invoiceLines).where(and(eq(schema.invoiceLines.invoiceId, id))).get()?.n ?? 0 },
  ];
  // A deeper member is named when its parent has records ("and what belongs to them").
  const with_: typeof pointing = [];
  for (const e of pointing)
    if (e.count === null ? with_.some((p) => p.model === e.from) : e.count > 0) with_.push(e);
  if (!with_.length) return undefined;
  const loose = [] as { model: string; label: string; plural: string; count: number }[];
  return { id, title, model: "Invoice", label: invoiceUi.label, with: with_, loose, together: false, missing: [invoiceUi.label, invoiceLineUi.label] };
}

/** Who may read, create, change and delete invoices. */
export const invoiceAccess: ModelAccess = {
  read: { public: false, roles: ["admin"], owner: true },
  create: { public: false, roles: ["admin", "member"], owner: false },
  write: { public: false, roles: ["admin"], owner: true },
  delete: { public: false, roles: ["admin"], owner: true },
};

/** A record as the viewer gets it: who owns it only for its owner and roles that read every record. */
function shownTo<R extends { ownerId: string | null }>(viewer: Viewer | null, row: R): R {
  if ((viewer && row.ownerId === viewer.id) || (!!viewer && (!!viewer.system || invoiceAccess.read.roles.includes(viewer.role)))) return row;
  return { ...row, ownerId: null };
}


/** What \`where\` may name, and how: the stored fields, by kind. */
const FILTERABLE: Record<string, Filterable> = {
  number: { kind: "text", column: schema.invoices.number },
  client: { kind: "reference", column: schema.invoices.clientId },
  issuedOn: { kind: "date", column: schema.invoices.issuedOn },
  dueOn: { kind: "date", column: schema.invoices.dueOn },
  status: { kind: "choice", column: schema.invoices.status, values: ["draft","sent","paid","overdue"] },
};

/** What the records can be sorted by. */
const SORTABLE = { id: schema.invoices.id, number: schema.invoices.number, issuedOn: schema.invoices.issuedOn, dueOn: schema.invoices.dueOn, status: schema.invoices.status, createdAt: schema.invoices.createdAt };

/** The number fields \`measure\` adds up; amounts are stored in cents. */
const NUMBERS: Record<string, AnyColumn> = {  };
const MONEY: string[] = ["total"];

/** Computed number fields \`measure\` adds up from the records themselves. */
const COMPUTED: string[] = ["total"];

/** The titles of the referenced records \`measureBy\` splits by, to name its groups. */
function titlesOf(viewer: Viewer | null, by: string, ids: number[]): Map<unknown, string> {
  switch (by) {
    case "client":
      return new Map(db.select({ id: schema.clients.id, title: schema.clients.name }).from(schema.clients).where(and(inArray(schema.clients.id, ids), clientData.readable(viewer))).all().map((r) => [r.id, String(r.title)]));
    default:
      return new Map();
  }
}

/** What \`measureBy\` may split by: choices, yes/no, references, and dates by month. */
const BY: string[] = ["client","issuedOn","dueOn","status"];


/** Each picture or document new to the record must come with the receipt its upload gave the viewer (src/kit/receipts.server.ts); the receipts are not kept. */
function checkFiles<V extends Partial<InvoiceSettable>>(viewer: Viewer | null, values: V, before?: Record<string, unknown>): V {
  return {
    ...values,
    ...("contract" in values ? { contract: acceptFiles(viewer, "invoice", "contract", values.contract, before?.contract) } : {}),
  };
}

/** Checks that the viewer may read the records the values refer to. */
function checkReferences(viewer: Viewer | null, values: Partial<InvoiceSettable>): void {
  if (values.clientId != null && !clientData.canRead(viewer, values.clientId))
    throw new AccessDenied(viewer !== null);
}

/** \`rows\` with each \`field\` reference \`readable\` leaves out set to nothing (only its id stays). */
function hideRefs<R extends Record<string, unknown>>(rows: R[], field: string, readable: (ids: number[]) => number[]): R[] {
  const idOf = (row: R) => (row[field] as { id?: unknown } | null | undefined)?.id;
  const ids = [...new Set(rows.map(idOf).filter((id): id is number => typeof id === "number"))];
  if (!ids.length) return rows;
  const shown = new Set(readable(ids));
  return rows.map((row) => {
    const id = idOf(row);
    return typeof id === "number" && !shown.has(id) ? { ...row, [field]: null } : row;
  });
}

export const invoiceData = {
  shownTo,
  /** The rows with each reference to a record the viewer may not read set to nothing: a related record's title is shown only to who may read it (only its id stays). */
  shownRefs<R extends Record<string, unknown>>(viewer: Viewer | null, rows: R[]): R[] {
    return hideRefs(rows, "client", (ids, c = clientData.readable(viewer)) => (c ? db.select({ id: schema.clients.id }).from(schema.clients).where(and(inArray(schema.clients.id, ids), c)).all().map((r) => r.id) : ids));
  },

  /** Whether a stored picture or document is on any record (the trash too): a file no record has may go. */
  uses(file: string): boolean {
    return !!db.select({ id: schema.invoices.id }).from(schema.invoices).where(sql\`\${schema.invoices.contract} like \${\`%"file":"\${file}"%\`}\`).get();
  },

  /** A condition for the invoices the viewer may read. */
  readable(viewer: Viewer | null) {
    const scope = readScope(invoiceAccess.read, viewer);
    if (scope === "all") return undefined;
    return scope === "own" && viewer ? eq(schema.invoices.ownerId, viewer.id) : sql\`false\`;
  },

  canRead(viewer: Viewer | null, id: number): boolean {
    const found = db
      .select({ id: schema.invoices.id })
      .from(schema.invoices)
      .where(and(eq(schema.invoices.id, id), invoiceData.readable(viewer)))
      .get();
    return found !== undefined;
  },

  /** The invoices the viewer may read; \`where\` narrows them, e.g. to a search. */
  async list(viewer: Viewer | null, where?: SQL) {
    if (readScope(invoiceAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const found = invoiceData.shownRefs(viewer, await db.query.invoices.findMany({
      where: and(invoiceData.readable(viewer), where),
      with: { client: { columns: { id: true, name: true } }, lines: true },
      orderBy: (t, { desc }) => [desc(t.id)],
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    // The related records are here for the totals only: some may not be the viewer's to read.
    return rows.map((row) => {
      const { lines, ...listed } = withInvoiceFormulas(row);
      return listed;
    });
  },

  /**
   * A page of the invoices the viewer may read that fit \`where\`, newest first (or in
   * \`order\`), and how many fit in all: for a list page. A page past the end is the last one.
   */
  async page(viewer: Viewer | null, where?: SQL, order?: SQL, page = 1, size = 50) {
    if (readScope(invoiceAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = and(invoiceData.readable(viewer), where);
    const total = db.select({ n: count() }).from(schema.invoices).where(condition).get()?.n ?? 0;
    const at = Math.min(Math.max(1, Math.trunc(page)), Math.max(1, Math.ceil(total / size)));
    const found = invoiceData.shownRefs(viewer, await db.query.invoices.findMany({
      where: condition,
      with: { client: { columns: { id: true, name: true } }, lines: true },
      orderBy: (t, { desc }) => [...(order ? [order] : []), desc(t.id)],
      limit: size,
      offset: (at - 1) * size,
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    // The related records are here for the totals only: some may not be the viewer's to read.
    return { rows: rows.map((row) => {
      const { lines, ...listed } = withInvoiceFormulas(row);
      return listed;
    }), total, page: at, size };
  },

  /**
   * The invoices the viewer may read that fit \`where\` and \`search\`, in \`sort\`'s order (else newest
   * first), a page of them and how many there are: for the API and the assistants' tools.
   */
  async find(
    viewer: Viewer | null,
    options: { where?: unknown; search?: string; sort?: string; limit?: number; offset?: number } = {},
  ) {
    if (readScope(invoiceAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = invoiceData.fitting(viewer, options.where, options.search);
    const order = sortOf(SORTABLE, options.sort);
    const total = db.select({ n: count() }).from(schema.invoices).where(condition).get()?.n ?? 0;
    const found = invoiceData.shownRefs(viewer, await db.query.invoices.findMany({
      where: condition,
      with: { client: { columns: { id: true, name: true } }, lines: true },
      orderBy: (t, { desc }) => [...(order ? [order] : []), desc(t.id)],
      limit: options.limit ?? 100,
      offset: options.offset ?? 0,
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    // The related records are here for the totals only: some may not be the viewer's to read.
    return { items: rows.map((row) => {
      const { lines, ...listed } = withInvoiceFormulas(row);
      return listed;
    }), total };
  },

  /**
   * A number from the invoices the viewer may read that fit \`where\`: how many, or the sum,
   * average, smallest or largest of a number field.
   */
  async measure(
    viewer: Viewer | null,
    how: "count" | "sum" | "average" | "smallest" | "largest",
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<number | null> {
    if (readScope(invoiceAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = invoiceData.fitting(viewer, options.where, options.search);
    if (how === "count")
      return db.select({ n: count() }).from(schema.invoices).where(condition).get()?.n ?? 0;
    const field = options.field ?? "";
    const money = MONEY.includes(field);
    if (COMPUTED.includes(field)) {
      const rows = await invoiceData.computedRows(condition);
      const value = aggregate(rows.map((row) => row[field]), how);
      return value === null ? null : money ? value / 100 : value;
    }
    const column = Object.hasOwn(NUMBERS, field) ? NUMBERS[field] : undefined;
    if (!column)
      throw new BadInput(
        \`\${how} needs a number field: \${[...Object.keys(NUMBERS), ...COMPUTED].join(", ") || "there are none"}.\`,
      );
    const pick = { sum, average: avg, smallest: min, largest: max }[how];
    const value = db.select({ v: pick(column) }).from(schema.invoices).where(condition).get()?.v;
    if (value === null || value === undefined) return null;
    return money ? Number(value) / 100 : Number(value);
  },

  /** Which record holds the smallest or largest value of a number field (the first of a tie). */
  async holder(
    viewer: Viewer | null,
    how: "smallest" | "largest",
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<{ id: number; title: string } | null> {
    const condition = invoiceData.fitting(viewer, options.where, options.search);
    const field = options.field ?? "";
    if (COMPUTED.includes(field)) {
      let best: Record<string, unknown> | undefined;
      for (const row of await invoiceData.computedRows(condition)) {
        const v = row[field];
        if (typeof v !== "number") continue;
        if (!best || (how === "largest" ? v > (best[field] as number) : v < (best[field] as number))) best = row;
      }
      return best ? { id: best.id as number, title: String(best.number) } : null;
    }
    const column = Object.hasOwn(NUMBERS, field) ? NUMBERS[field] : undefined;
    if (!column) return null;
    const row = db
      .select({ id: schema.invoices.id, title: schema.invoices.number })
      .from(schema.invoices)
      .where(and(condition, isNotNull(column)))
      .orderBy(how === "largest" ? desc(column) : asc(column), asc(schema.invoices.id))
      .limit(1)
      .get();
    return row ? { id: row.id, title: String(row.title) } : null;
  },

  /**
   * The same number per value of a field (a choice, yes/no, a reference) or per month of a date:
   * \`[{ value, number }]\`, the most first.
   */
  async measureBy(
    viewer: Viewer | null,
    how: "count" | "sum" | "average" | "smallest" | "largest",
    by: string,
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<{ value: unknown; title?: string; number: number | null }[]> {
    if (readScope(invoiceAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const split = Object.hasOwn(FILTERABLE, by) ? FILTERABLE[by] : undefined;
    if (!split || split.kind === "text" || split.kind === "number" || split.kind === "money")
      throw new BadInput(\`There is no field "\${by}" to split by. Fields: \${BY.join(", ")}.\`);
    const field = options.field ?? "";
    const money = MONEY.includes(field);
    const condition = invoiceData.fitting(viewer, options.where, options.search);
    const amount = (n: number | null) => (n === null ? null : money ? n / 100 : n);
    const most = (a: { number: number | null }, b: { number: number | null }) => (b.number ?? 0) - (a.number ?? 0);
    // A reference's groups carry the referenced record's title beside its id.
    const named = (rows: { value: unknown; number: number | null }[]) => {
      if (split.kind !== "reference") return rows;
      const titles = titlesOf(viewer, by, rows.map((r) => r.value).filter((v): v is number => typeof v === "number"));
      return rows.map((r) => (titles.has(r.value) ? { value: r.value, title: titles.get(r.value), number: r.number } : r));
    };
    if (COMPUTED.includes(field)) {
      // Each record's month or value, then the computed numbers added up per group.
      const groups = new Map<unknown, unknown[]>();
      for (const row of await invoiceData.computedRows(condition)) {
        const raw = row[split.kind === "reference" ? \`\${by}Id\` : by];
        const value = split.kind === "date" ? String(raw ?? "").slice(0, 7) || null : split.kind === "instant" ? (raw instanceof Date ? raw.toISOString().slice(0, 7) : null) : raw;
        groups.set(value, [...(groups.get(value) ?? []), row[field]]);
      }
      return named([...groups].map(([value, numbers]) => ({ value, number: amount(aggregate(numbers, how)) })).sort(most));
    }
    const key = split.kind === "date" ? sql<string>\`substr(\${split.column}, 1, 7)\` : split.kind === "instant" ? sql<string>\`strftime('%Y-%m', \${split.column} / 1000, 'unixepoch')\` : sql\`\${split.column}\`;
    const column = Object.hasOwn(NUMBERS, field) ? NUMBERS[field] : undefined;
    if (how !== "count" && !column)
      throw new BadInput(\`\${how} needs a number field: \${[...Object.keys(NUMBERS), ...COMPUTED].join(", ") || "there are none"}.\`);
    const pick = how === "count" || !column ? count() : { sum, average: avg, smallest: min, largest: max }[how](column);
    return named(
      db
        .select({ value: key, number: pick })
        .from(schema.invoices)
        .where(condition)
        .groupBy(key)
        .all()
        .map((r) => ({ value: r.value, number: r.number === null ? null : amount(Number(r.number)) }))
        .sort(most),
    );
  },

  /**
   * The records that fit, with their computed fields worked out: for adding those up. At most
   * 10,000, so one call never reads a whole large table; more are refused with how to narrow them.
   */
  async computedRows(condition: SQL | undefined): Promise<Record<string, unknown>[]> {
    const rows = await db.query.invoices.findMany({ where: condition, with: { client: { columns: { id: true, name: true } }, lines: true }, limit: 10001 });
    if (rows.length > 10000)
      throw new BadInput("More than 10,000 records to add up a computed field over: narrow them with where.");
    return rows.map((row) => withInvoiceFormulas(row as never) as Record<string, unknown>);
  },

  /** The invoices the viewer may read whose number has the text: a few, for naming one. */
  named(viewer: Viewer | null, text: string): { id: number; title: string }[] {
    return db
      .select({ id: schema.invoices.id, title: schema.invoices.number })
      .from(schema.invoices)
      .where(and(invoiceData.readable(viewer), contains([schema.invoices.number], text)))
      .limit(6)
      .all()
      .map((row) => ({ id: row.id, title: String(row.title) }));
  },

  /** Every number the viewer may read (at most 2,000): the nearest when a name fits none. */
  titles(viewer: Viewer | null): string[] {
    return db
      .select({ title: schema.invoices.number })
      .from(schema.invoices)
      .where(invoiceData.readable(viewer))
      .limit(2000)
      .all()
      .map((row) => String(row.title));
  },

  /** Why \`where\` found none when it names a text no record has: the field's nearest values. */
  whyNone(viewer: Viewer | null, where: unknown): string | undefined {
    if (!where || typeof where !== "object") return undefined;
    for (const [name, v] of Object.entries(where)) {
      const field = Object.hasOwn(FILTERABLE, name) ? FILTERABLE[name] : undefined;
      if (field?.kind !== "text" || (typeof v !== "string" && typeof v !== "number")) continue;
      const values = db
        .selectDistinct({ v: sql<string>\`\${field.column}\` })
        .from(schema.invoices)
        .where(and(invoiceData.readable(viewer), isNotNull(field.column)))
        .limit(2000)
        .all()
        .map((row) => String(row.v));
      const asked = String(v);
      if (values.length && !values.some((x) => x.toLowerCase().includes(asked.toLowerCase())))
        return \`No invoice has "\${asked}" in \${name}; the nearest: \${nearest(asked, values).join(", ")}.\`;
    }
    return undefined;
  },

  /** The condition for records the viewer may read that fit \`where\` and \`search\`. */
  fitting(viewer: Viewer | null, where?: unknown, search?: string) {
    return and(
      invoiceData.readable(viewer),
      whereOf(FILTERABLE, where, viewer ? eq(schema.invoices.ownerId, viewer.id) : undefined, viewer?.id, {client: { find: (text: string) => clientData.named(viewer, text), titles: () => clientData.titles(viewer) }}),
      // Every word somewhere in the texts ("ship lamp" finds "ship's lamp").
      ...wordsOf(search).map((word) => contains([schema.invoices.number], word)),
    );
  },

  async get(viewer: Viewer | null, id: number) {
    const fetched = await db.query.invoices.findFirst({
      where: and(eq(schema.invoices.id, id), invoiceData.readable(viewer)),
      with: { client: { columns: { id: true, name: true } }, lines: { where: invoiceLineData.readable(viewer) } },
    });
    const found = fetched && invoiceData.shownRefs(viewer, [fetched])[0];
    const row = found && { ...shownTo(viewer, found), lines: found.lines.map((r) => invoiceLineData.shownTo(viewer, r)) };
    if (!row) return null;
    // Totals count every related record, as in lists; the related records shown are the viewer's.
    const all = await db.query.invoices.findFirst({ where: eq(schema.invoices.id, id), with: { lines: true } });
    return { ...withInvoiceFormulas({ ...row, lines: all?.lines ?? [] }), lines: row.lines };
  },

  async create(viewer: Viewer | null, values: InvoiceSettable) {
    check(invoiceAccess.create, viewer);
    values = checkFiles(viewer, values);
    checkReferences(viewer, values);
    let row: typeof schema.invoices.$inferSelect;
    try {
      row = db.transaction((tx) => {
        const made = tx.insert(schema.invoices).values({ ...values, ownerId: personOf(viewer) }).returning().get();
        audit(tx, viewer, { action: "created", model: "Invoice", record: made.id });
        outgoing(tx, viewer, "Invoice", "created", made);
        return made;
      });
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterCreate", "Invoice", row, viewer);
    return row;
  },

  /** Changes the record; \`what\` names the change in the audit log (an action's name). */
  /** Changes the fields given; what names the action ("changed" for a form), frees the fields it may change although locked (its own set). */
  async update(viewer: Viewer | null, id: number, values: Partial<InvoiceSettable>, what = "changed", _frees: readonly string[] = []) {
    const row = db
      .select({ ownerId: schema.invoices.ownerId, contract: schema.invoices.contract })
      .from(schema.invoices)
      .where(and(eq(schema.invoices.id, id), invoiceData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    // A form's change needs write on the record; an action (what names it) checked its own access
    // first, which includes the roles its grant names (docs/design/actions.md, Access).
    if (what === "changed") check(invoiceAccess.write, viewer, row.ownerId);
    values = checkFiles(viewer, values, db.select({ contract: schema.invoices.contract }).from(schema.invoices).where(eq(schema.invoices.id, id)).get());
    checkReferences(viewer, values);
    let changed: typeof schema.invoices.$inferSelect;
    const updated = values;
    try {
      changed = db.transaction((tx) => {
        // Read again in the change itself: a record that left the viewer's reach meanwhile is refused.
        const before = tx.select().from(schema.invoices).where(and(eq(schema.invoices.id, id), invoiceData.readable(viewer))).get();
        if (!before) throw new AccessDenied(viewer !== null);
        const after = tx.update(schema.invoices).set(updated).where(eq(schema.invoices.id, id)).returning().get();
        audit(tx, viewer, { action: what, model: "Invoice", record: id, fields: before && changedFields(before, after, Object.keys(updated).filter((k) => !["total"].includes(k))) });
        outgoing(tx, viewer, "Invoice", what, after, before);
        return after;
      });
    } catch (error) {
      throw refusal(error);
    }
    if (row.contract && row.contract.file !== changed.contract?.file) deleteFile(row.contract, !!db.select({ id: schema.invoices.id }).from(schema.invoices).where(sql\`\${schema.invoices.contract} like \${\`%"file":"\${row.contract.file}"%\`}\`).get());
    await afterChange("afterUpdate", "Invoice", changed, viewer);
    return changed;
  },

  /** Deletes the record; \`together\` takes the records that point to it along to the trash (delete-together.md). */
  async remove(viewer: Viewer | null, id: number, _together = false): Promise<void> {
    const row = db
      .select({ number: schema.invoices.number, ownerId: schema.invoices.ownerId, contract: schema.invoices.contract })
      .from(schema.invoices)
      .where(and(eq(schema.invoices.id, id), invoiceData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(invoiceAccess.delete, viewer, row.ownerId);
    try {
      db.transaction((tx) => {
        // Read again in the change itself: a record that left the viewer's reach meanwhile is refused.
        if (!tx.select({ id: schema.invoices.id }).from(schema.invoices).where(and(eq(schema.invoices.id, id), invoiceData.readable(viewer))).get())
          throw new AccessDenied(viewer !== null);
        const used = usedBy(tx, id, String(row.number ?? id));
        if (used) throw new Conflict(\`in-use:\${JSON.stringify(used)}\`);
        const gone = tx.delete(schema.invoices).where(eq(schema.invoices.id, id)).returning().get();
        if (gone) {
          audit(tx, viewer, { action: "deleted", model: "Invoice", record: id, title: gone.number });
          outgoing(tx, viewer, "Invoice", "deleted", gone);
        }
      });
    } catch (error) {
      throw refusal(error);
    }
    if (row.contract && row.contract.file !== undefined) deleteFile(row.contract, !!db.select({ id: schema.invoices.id }).from(schema.invoices).where(sql\`\${schema.invoices.contract} like \${\`%"file":"\${row.contract.file}"%\`}\`).get());
    await afterDelete("Invoice", id, viewer);
  },

  /**
   * Deletes the chosen records the viewer may delete, all or none (one still in use stops them
   * all, and is named); the others are skipped.
   */
  async removeMany(viewer: Viewer | null, ids: number[], _together = false): Promise<{ deleted: number; skipped: number }> {
    const rows = db
      .select({ id: schema.invoices.id, number: schema.invoices.number, ownerId: schema.invoices.ownerId, contract: schema.invoices.contract })
      .from(schema.invoices)
      .where(and(inArray(schema.invoices.id, ids), invoiceData.readable(viewer)))
      .all()
      .filter((row) => allows(invoiceAccess.delete, viewer, row.ownerId));
    db.transaction((tx) => {
      for (const row of rows)
        try {
          const used = usedBy(tx, row.id, String(row.number ?? row.id));
          if (used) throw new Conflict(\`in-use:\${JSON.stringify(used)}\`);
          const gone = tx.delete(schema.invoices).where(eq(schema.invoices.id, row.id)).returning().get();
          if (gone) {
            audit(tx, viewer, { action: "deleted", model: "Invoice", record: row.id, title: gone.number });
            outgoing(tx, viewer, "Invoice", "deleted", gone);
          }
        } catch (error) {
          const refused = refusal(error);
          throw refused instanceof Conflict && refused.message === "in-use" ? new Conflict(\`in-use:\${row.id}\`) : refused;
        }
    });
    for (const row of rows) {
      if (row.contract && row.contract.file !== undefined) deleteFile(row.contract, !!db.select({ id: schema.invoices.id }).from(schema.invoices).where(sql\`\${schema.invoices.contract} like \${\`%"file":"\${row.contract.file}"%\`}\`).get());
      await afterDelete("Invoice", row.id, viewer);
    }
    return { deleted: rows.length, skipped: new Set(ids).size - rows.length };
  },

  /**
   * The invoices the viewer may read whose number contains the text: a search of records that
   * refer to them finds them only among these.
   */
  titled(viewer: Viewer | null, text: string): number[] {
    return db
      .select({ id: schema.invoices.id })
      .from(schema.invoices)
      .where(and(contains([schema.invoices.number], text), invoiceData.readable(viewer)))
      .all()
      .map((row) => row.id);
  },

  /** Choices for fields that refer to a invoice: the ones the viewer may read. */
  options(viewer: Viewer | null) {
    if (readScope(invoiceAccess.read, viewer) === "none") return [];
    return db
      .select({ value: schema.invoices.id, label: schema.invoices.number })
      .from(schema.invoices)
      .where(invoiceData.readable(viewer))
      .orderBy(asc(schema.invoices.number))
      .all();
  },
};
"
`;

exports[`../../../examples/invoicing/smithable.yml > file list and generated code > src/generated/invoice.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { z } from "zod";
import type * as schema from "#/db/schema";
import { allows, type Rule } from "#/kit/access";
import type { RecordUi } from "#/kit/model";
import { bindFile } from "#/kit/FileInput";
import { invoiceDefaults, withInvoiceFormulas } from "./invoice.formulas";
import { invoiceAccess, invoiceData } from "./invoice.server";
import { invoiceLineAccess } from "./invoice-line.server";
import { writeAllowed } from "#/kit/limit";
import { currentViewer } from "#/lib/viewer.server";
import { invoiceSchema } from "./invoice.schema";

export type { InvoiceSettable, InvoiceValues } from "./invoice.schema";

/** The viewer about to write, counted against how often one may (see src/kit/limit.ts). */
async function writer() {
  const viewer = await currentViewer();
  writeAllowed(viewer, getRequestHeaders());
  return viewer;
}

/** Invoice records as the kit reads them. */
export type InvoiceRow = typeof schema.invoices.$inferSelect & {
  client?: { id: number; name: string } | null;
  total?: unknown;
};

export const invoiceUi: RecordUi<InvoiceRow> = {
  model: "Invoice",
  label: "Invoice",
  pluralLabel: "Invoices",
  titleField: "number",
  columns: ["number", "clientId", "issuedOn", "dueOn", "status"],
  fields: [
    {
      name: "number",
      label: "Number",
      kind: "string",
      required: true,
      get: (row) => row.number,
    },
    {
      name: "clientId",
      label: "Client",
      kind: "relation",
      required: true,
      relation: { key: "client", titleField: "name" },
      get: (row) => row.client?.name ?? null,
    },
    {
      name: "issuedOn",
      label: "Issued on",
      kind: "date",
      required: true,
      get: (row) => row.issuedOn,
    },
    {
      name: "dueOn",
      label: "Due on",
      kind: "date",
      required: true,
      get: (row) => row.dueOn,
    },
    {
      name: "status",
      label: "Status",
      kind: "choice",
      required: true,
      choices: [
        { value: "draft", label: "Draft" },
        { value: "sent", label: "Sent" },
        { value: "paid", label: "Paid" },
        { value: "overdue", label: "Overdue" },
      ],
      default: "draft",
      get: (row) => row.status,
    },
    {
      name: "contract",
      label: "Contract",
      kind: "file",
      required: false,
      input: bindFile("invoice", "contract"),
      get: (row) => row.contract,
    },
    {
      name: "total",
      label: "Total",
      kind: "money",
      required: false,
      computed: true,
      get: (row) => row.total,
    },
  ],
  compute: withInvoiceFormulas,
  defaults: invoiceDefaults,
};

/** Who may delete invoices: a list's selection offers Delete by it (the server checks again). */
export const invoiceDeleteRule: Rule = { public: false, roles: ["admin"], owner: true };


export const listInvoices = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return { rows: await invoiceData.list(viewer), canCreate: allows(invoiceAccess.create, viewer) };
});

export const getInvoice = createServerFn()
  .validator(z.number().int())
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    const row = await invoiceData.get(viewer, id);
    if (!row) return null;
    return {
      row,
      canWrite: allows(invoiceAccess.write, viewer, row.ownerId),
      canDelete: allows(invoiceAccess.delete, viewer, row.ownerId),
      // Who may add to its related lists from here ("Add line" on an invoice).
      canAdd: { lines: allows(invoiceLineAccess.create, viewer) },
    };
  });

/** Choices for fields that refer to a invoice. */
export const invoiceOptions = createServerFn().handler(async () =>
  invoiceData.options(await currentViewer()),
);

export const createInvoice = createServerFn({ method: "POST" })
  .validator(invoiceSchema)
  .handler(async ({ data }) => invoiceData.create(await writer(), data));

export const updateInvoice = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), values: invoiceSchema }))
  .handler(async ({ data }) => invoiceData.update(await writer(), data.id, data.values));

/** Deletes a invoice; \`together\` takes what points to it along (docs/design/delete-together.md). */
export const deleteInvoice = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), together: z.boolean().optional() }))
  .handler(async ({ data }) => invoiceData.remove(await writer(), data.id, data.together));

/** Deletes the chosen invoices, all or none (at most 1,000 at once). */
export const deleteInvoices = createServerFn({ method: "POST" })
  .validator(z.object({ ids: z.array(z.number().int()).max(1000), together: z.boolean().optional() }))
  .handler(async ({ data }) => invoiceData.removeMany(await writer(), data.ids, data.together));
"
`;

