exports[`../../../examples/support/smithable.yml > file list and generated code > src/db/schema.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { relations } from "drizzle-orm";
import { index, integer, sqliteTable, text } from "drizzle-orm/sqlite-core";
import type { StoredFile } from "#/kit/uploads";

export const user = sqliteTable("user", {
  id: text().primaryKey(),
  name: text().notNull(),
  email: text().notNull().unique(),
  emailVerified: integer({ mode: "boolean" }).default(false).notNull(),
  image: text(),
  role: text().notNull().default("agent"),
  createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
  updatedAt: integer({ mode: "timestamp_ms" })
    .notNull()
    .$defaultFn(() => new Date())
    .$onUpdate(() => new Date()),
});

export const session = sqliteTable(
  "session",
  {
    id: text().primaryKey(),
    expiresAt: integer({ mode: "timestamp_ms" }).notNull(),
    token: text().notNull().unique(),
    createdAt: integer({ mode: "timestamp_ms" }).notNull(),
    updatedAt: integer({ mode: "timestamp_ms" }).notNull(),
    ipAddress: text(),
    userAgent: text(),
    userId: text()
      .notNull()
      .references(() => user.id, { onDelete: "cascade" }),
  },
  (t) => [index("session_user_id_idx").on(t.userId)],
);

export const account = sqliteTable(
  "account",
  {
    id: text().primaryKey(),
    accountId: text().notNull(),
    providerId: text().notNull(),
    userId: text()
      .notNull()
      .references(() => user.id, { onDelete: "cascade" }),
    accessToken: text(),
    refreshToken: text(),
    idToken: text(),
    accessTokenExpiresAt: integer({ mode: "timestamp_ms" }),
    refreshTokenExpiresAt: integer({ mode: "timestamp_ms" }),
    scope: text(),
    password: text(),
    createdAt: integer({ mode: "timestamp_ms" }).notNull(),
    updatedAt: integer({ mode: "timestamp_ms" }).notNull(),
  },
  (t) => [index("account_user_id_idx").on(t.userId)],
);

export const verification = sqliteTable(
  "verification",
  {
    id: text().primaryKey(),
    identifier: text().notNull(),
    value: text().notNull(),
    expiresAt: integer({ mode: "timestamp_ms" }).notNull(),
    createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
    updatedAt: integer({ mode: "timestamp_ms" })
      .notNull()
      .$defaultFn(() => new Date())
      .$onUpdate(() => new Date()),
  },
  (t) => [index("verification_identifier_idx").on(t.identifier)],
);

export const invitation = sqliteTable("invitation", {
  id: text().primaryKey(),
  email: text().notNull().unique(),
  role: text().notNull(),
  token: text().notNull().unique(),
  invitedById: text().references(() => user.id, { onDelete: "set null" }),
  createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
  expiresAt: integer({ mode: "timestamp_ms" }).notNull(),
});

export const auditLog = sqliteTable(
  "audit_log",
  {
    id: integer().primaryKey({ autoIncrement: true }),
    at: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
    trace: text(),
    /** A user's id, a key's name, "visitor", or "the app" for its own work. */
    who: text().notNull(),
    role: text(),
    address: text(),
    browser: text(),
    /** created, changed, deleted, copied, or an action's name. */
    action: text().notNull(),
    model: text(),
    recordId: integer(),
    title: text(),
    fields: text({ mode: "json" }).$type<string[]>(),
    details: text({ mode: "json" }).$type<Record<string, unknown>>(),
  },
  (t) => [index("audit_log_at").on(t.at), index("audit_log_record").on(t.model, t.recordId)],
);

export const uploads = sqliteTable(
  "uploads",
  {
    id: integer().primaryKey({ autoIncrement: true }),
    /** The stored file's name under uploads/ (src/kit/uploads.ts). */
    file: text().notNull(),
    model: text().notNull(),
    field: text().notNull(),
    /** Who uploaded it; nothing for a visitor. */
    uploader: text(),
    receipt: text().notNull(),
    at: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
  },
  (t) => [index("uploads_receipt").on(t.receipt), index("uploads_at").on(t.at)],
);

export const outgoingMail = sqliteTable(
  "outgoing_mail",
  {
    id: integer().primaryKey({ autoIncrement: true }),
    createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
    /** The outgoing entry's name in smithable.yml. */
    entry: text().notNull(),
    model: text().notNull(),
    recordId: integer().notNull(),
    to: text().notNull(),
    subject: text().notNull(),
    text: text().notNull(),
    /** A thread mail's headers (docs/design/mail-threads.md §4): its own id, what it answers, the thread. */
    messageId: text(),
    inReplyTo: text(),
    references: text(),
    replyTo: text(),
    tries: integer().notNull().default(0),
    nextAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
    sentAt: integer({ mode: "timestamp_ms" }),
    /** Given up after a day of tries; "Send again" in Activity clears it. */
    failedAt: integer({ mode: "timestamp_ms" }),
    error: text(),
  },
  (t) => [index("outgoing_mail_due").on(t.sentAt, t.failedAt, t.nextAt)],
);

export const outgoingCall = sqliteTable(
  "outgoing_call",
  {
    id: integer().primaryKey({ autoIncrement: true }),
    createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
    entry: text().notNull(),
    model: text().notNull(),
    recordId: integer().notNull(),
    /** The target's name; its address and secret are OUTGOING_<TARGET>_URL and _SECRET. */
    target: text().notNull(),
    body: text().notNull(),
    tries: integer().notNull().default(0),
    nextAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
    sentAt: integer({ mode: "timestamp_ms" }),
    failedAt: integer({ mode: "timestamp_ms" }),
    /** The answer's status, or why there was none. */
    status: integer(),
    error: text(),
  },
  (t) => [index("outgoing_call_due").on(t.sentAt, t.failedAt, t.nextAt)],
);

export const incomingSeen = sqliteTable(
  "incoming_seen",
  {
    id: integer().primaryKey({ autoIncrement: true }),
    /** The incoming entry's name, and the call's own id (Idempotency-Key, or the entry's id). */
    name: text().notNull(),
    key: text().notNull(),
    at: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
  },
  (t) => [index("incoming_seen_key").on(t.name, t.key)],
);

export const mailThreads = sqliteTable(
  "mail_threads",
  {
    id: integer().primaryKey({ autoIncrement: true }),
    /** The record the thread is about: the model an incoming mail entry creates, and its id. */
    model: text().notNull(),
    recordId: integer().notNull(),
    messageId: text().notNull(),
    /** A mail that came in, not one the app sent. */
    received: integer({ mode: "boolean" }).notNull().default(false),
    at: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
  },
  (t) => [index("mail_threads_message").on(t.messageId), index("mail_threads_record").on(t.model, t.recordId)],
);

export const supportCases = sqliteTable("support_cases", {
  id: integer().primaryKey({ autoIncrement: true }),
  subject: text().notNull(),
  customerEmail: text().notNull(),
  status: text({ enum: ["open", "inProgress", "closed", "reopened"] }).notNull().default("open"),
  priority: integer().notNull().default(3),
  assigneeId: text().references(() => user.id, { onDelete: "set null" }),
  body: text(),
  attachments: text({ mode: "json" }).$type<StoredFile[]>(),
  ownerId: text().references(() => user.id, { onDelete: "set null" }),
  createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
  updatedAt: integer({ mode: "timestamp_ms" })
    .notNull()
    .$defaultFn(() => new Date())
    .$onUpdate(() => new Date()),
});

export const messages = sqliteTable("messages", {
  id: integer().primaryKey({ autoIncrement: true }),
  content: text().notNull(),
  sender: text({ enum: ["agent", "customer"] }).notNull().default("agent"),
  agentId: text().references(() => user.id, { onDelete: "set null" }),
  fromEmail: text(),
  attachments: text({ mode: "json" }).$type<StoredFile[]>(),
  supportCaseId: integer().notNull().references(() => supportCases.id, { onDelete: "restrict" }),
  ownerId: text().references(() => user.id, { onDelete: "set null" }),
  createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
  updatedAt: integer({ mode: "timestamp_ms" })
    .notNull()
    .$defaultFn(() => new Date())
    .$onUpdate(() => new Date()),
});

export const supportCasesRelations = relations(supportCases, ({ one, many }) => ({
  assignee: one(user, { fields: [supportCases.assigneeId], references: [user.id] }),
  messages: many(messages),
}));

export const messagesRelations = relations(messages, ({ one }) => ({
  agent: one(user, { fields: [messages.agentId], references: [user.id] }),
  supportCase: one(supportCases, { fields: [messages.supportCaseId], references: [supportCases.id] }),
}));
"
`;

