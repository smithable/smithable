exports[`../../../examples/invoicing/smithable.yml > file list and generated code > src/generated/access.test.ts 1`] = `
"// Generated by Smithable from smithable.yml and smithable.auth.yml. Do not edit: this file is overwritten on every change.
// For every model and role: which records a user can read, create, change and delete.
// "Own" records are owned by the user; "others" by someone else.
import { describe, expect, test } from "vitest";
import { db } from "#/db";
import { businessProfiles, clients, invoiceLines, invoices, user } from "#/db/schema";
import { AccessDenied, type Viewer } from "#/kit/access";
import { businessProfileData } from "./business-profile.server";
import { clientData } from "./client.server";
import { invoiceData } from "./invoice.server";
import { invoiceLineData } from "./invoice-line.server";

let counter = 0;
const next = () => ++counter;

/** A new signed-in user with the role. */
function signedIn(role: string): Viewer {
  const n = next();
  const viewer = { id: \`test-user-\${n}\`, name: \`Test \${role} \${n}\`, email: \`user\${n}@example.com\`, role };
  db.insert(user).values(viewer).run();
  return viewer;
}

/** Owns the records that are someone else's. */
const stranger = signedIn("member");

/** Whether the action is allowed; any other failure fails the test. */
async function can(action: () => unknown): Promise<boolean> {
  try {
    await action();
    return true;
  } catch (error) {
    if (error instanceof AccessDenied) return false;
    throw error;
  }
}

/** Whether the viewer can open the record and sees it in the list. */
async function reads(
  data: { get(viewer: never, id: number): Promise<unknown>; list(viewer: never): Promise<{ id: number }[]> },
  viewer: unknown,
  id: number,
): Promise<boolean> {
  const listed = await data.list(viewer as never).then(
    (rows) => rows.some((row) => row.id === id),
    (error) => {
      if (error instanceof AccessDenied) return false;
      throw error;
    },
  );
  return listed && (await data.get(viewer as never, id)) !== null;
}

function businessProfileValues(_owner: string | null) {
  const n = next();
  return { businessName: \`BusinessProfile businessName \${n}\`, vatNumber: null, iban: null, paymentTermDays: n, invoiceFooter: null } as const;
}

function insertBusinessProfile(owner: string | null) {
  return db
    .insert(businessProfiles)
    .values({ ...businessProfileValues(owner), ownerId: owner })
    .returning()
    .get();
}

function clientValues(_owner: string | null) {
  const n = next();
  return { name: \`Client name \${n}\`, email: \`client\${n}@example.com\`, address: null, vatNumber: null } as const;
}

function insertClient(owner: string | null) {
  return db
    .insert(clients)
    .values({ ...clientValues(owner), ownerId: owner })
    .returning()
    .get();
}

function invoiceValues(owner: string | null) {
  const n = next();
  return { number: \`Invoice number \${n}\`, clientId: insertClient(owner).id, issuedOn: "2026-01-15", dueOn: "2026-01-15", status: "draft" } as const;
}

function insertInvoice(owner: string | null) {
  return db
    .insert(invoices)
    .values({ ...invoiceValues(owner), ownerId: owner })
    .returning()
    .get();
}

function invoiceLineValues(owner: string | null) {
  const n = next();
  return { invoiceId: insertInvoice(owner).id, description: \`InvoiceLine description \${n}\`, quantity: 1.5, unitPrice: 1000 } as const;
}

function insertInvoiceLine(owner: string | null) {
  return db
    .insert(invoiceLines)
    .values({ ...invoiceLineValues(owner), ownerId: owner })
    .returning()
    .get();
}

describe("BusinessProfile", () => {
  test("admin", async () => {
    const viewer = signedIn("admin");
    const others = insertBusinessProfile(stranger.id);
    const own = insertBusinessProfile(viewer.id);
    expect({
      readOthers: await reads(businessProfileData, viewer, others.id),
      readOwn: await reads(businessProfileData, viewer, own.id),
      create: await can(() => businessProfileData.create(viewer, businessProfileValues(viewer.id))),
      changeOthers: await can(() => businessProfileData.update(viewer, others.id, businessProfileValues(viewer.id))),
      changeOwn: await can(() => businessProfileData.update(viewer, own.id, businessProfileValues(viewer.id))),
      deleteOthers: await can(() => businessProfileData.remove(viewer, others.id)),
      deleteOwn: await can(() => businessProfileData.remove(viewer, own.id)),
    }).toEqual({
      readOthers: true,
      readOwn: true,
      create: true,
      changeOthers: true,
      changeOwn: true,
      deleteOthers: true,
      deleteOwn: true,
    });
  });

  test("member", async () => {
    const viewer = signedIn("member");
    const others = insertBusinessProfile(stranger.id);
    const own = insertBusinessProfile(viewer.id);
    expect({
      readOthers: await reads(businessProfileData, viewer, others.id),
      readOwn: await reads(businessProfileData, viewer, own.id),
      create: await can(() => businessProfileData.create(viewer, businessProfileValues(viewer.id))),
      changeOthers: await can(() => businessProfileData.update(viewer, others.id, businessProfileValues(viewer.id))),
      changeOwn: await can(() => businessProfileData.update(viewer, own.id, businessProfileValues(viewer.id))),
      deleteOthers: await can(() => businessProfileData.remove(viewer, others.id)),
      deleteOwn: await can(() => businessProfileData.remove(viewer, own.id)),
    }).toEqual({
      readOthers: false,
      readOwn: true,
      create: true,
      changeOthers: false,
      changeOwn: true,
      deleteOthers: false,
      deleteOwn: true,
    });
  });

  test("a visitor who has not signed in", async () => {
    const viewer = null;
    const others = insertBusinessProfile(stranger.id);
    expect({
      readOthers: await reads(businessProfileData, viewer, others.id),
      readOwn: false,
      create: await can(() => businessProfileData.create(viewer, businessProfileValues(null))),
      changeOthers: await can(() => businessProfileData.update(viewer, others.id, businessProfileValues(null))),
      changeOwn: false,
      deleteOthers: await can(() => businessProfileData.remove(viewer, others.id)),
      deleteOwn: false,
    }).toEqual({
      readOthers: false,
      readOwn: false,
      create: false,
      changeOthers: false,
      changeOwn: false,
      deleteOthers: false,
      deleteOwn: false,
    });
  });
});

describe("Client", () => {
  test("admin", async () => {
    const viewer = signedIn("admin");
    const others = insertClient(stranger.id);
    const own = insertClient(viewer.id);
    expect({
      readOthers: await reads(clientData, viewer, others.id),
      readOwn: await reads(clientData, viewer, own.id),
      create: await can(() => clientData.create(viewer, clientValues(viewer.id))),
      changeOthers: await can(() => clientData.update(viewer, others.id, clientValues(viewer.id))),
      changeOwn: await can(() => clientData.update(viewer, own.id, clientValues(viewer.id))),
      deleteOthers: await can(() => clientData.remove(viewer, others.id)),
      deleteOwn: await can(() => clientData.remove(viewer, own.id)),
    }).toEqual({
      readOthers: true,
      readOwn: true,
      create: true,
      changeOthers: true,
      changeOwn: true,
      deleteOthers: true,
      deleteOwn: true,
    });
  });

  test("member", async () => {
    const viewer = signedIn("member");
    const others = insertClient(stranger.id);
    const own = insertClient(viewer.id);
    expect({
      readOthers: await reads(clientData, viewer, others.id),
      readOwn: await reads(clientData, viewer, own.id),
      create: await can(() => clientData.create(viewer, clientValues(viewer.id))),
      changeOthers: await can(() => clientData.update(viewer, others.id, clientValues(viewer.id))),
      changeOwn: await can(() => clientData.update(viewer, own.id, clientValues(viewer.id))),
