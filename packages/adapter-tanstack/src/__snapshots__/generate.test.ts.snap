exports[`../../../examples/crm/smithable.yml > file list and generated code > src/routes/orders/index.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, Link, useNavigate, useRouter } from "@tanstack/react-router";
import { pageAccess, pageUi, pageHead } from "#/generated/pages";
import { guardPage, allows } from "#/kit/access";
import { createServerFn } from "@tanstack/react-start";
import * as schema from "#/db/schema";
import { orderAccess, orderData } from "#/generated/order.server";
import { or, inArray, and } from "drizzle-orm";
import { contains } from "#/kit/search";
import { customerData } from "#/generated/customer.server";
import { currentViewer } from "#/lib/viewer.server";
import { type Search, count, listQuery, optional, text } from "#/kit/params";
import { buttonVariants } from "#/components/ui/button";
import { TrashNotice } from "#/kit/Trash";
import { restoreOrders, deleteOrders, orderDeleteRule, orderUi } from "#/generated/order";
import { useState } from "react";
import { SelectionBar } from "#/kit/SelectionBar";
import { csvName, csvOf, download } from "#/kit/csv";
import { app } from "#/generated/app";
import { w } from "#/kit/words";
import { PageHeader } from "#/kit/AppShell";
import { ModelTable } from "#/kit/ModelTable";
import { SearchBox } from "#/kit/SearchBox";
import { Filters } from "#/kit/Filters";

/** The orders matching the search and the filters, among those the viewer may read. */
const searchOrders = createServerFn()
  .validator(listQuery)
  .handler(async ({ data }) => {
    const viewer = await currentViewer();
    const where = and(
      data.q ? or(contains([schema.orders.number], data.q), inArray(schema.orders.customerId, customerData.titled(viewer, data.q))) : undefined,
      data.f?.status ? inArray(schema.orders.status, data.f?.status.split(",").filter((v) => ["draft", "placed", "shipped", "canceled"].includes(v)) as ("draft" | "placed" | "shipped" | "canceled")[]) : undefined,
    );
    return {
      ...(await orderData.page(viewer, where, undefined, data.all ? 1 : data.page, data.all ? (viewer ? 10000 : 500) : undefined)),
      canCreate: allows(orderAccess.create, viewer),
      options: {  },
    };
  });

export const Route = createFileRoute("/orders/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["orders"], context.viewer, location.href),
  head: () => pageHead("orders"),
  validateSearch: (s: Search) => optional({ q: text(s.q), sort: text(s.sort), status: text(s.status), page: count(s.page) }),
  loaderDeps: ({ search }) => search,
  loader: ({ deps: { q, sort, page, ...f } }) => searchOrders({ data: { q, sort, f, page } }),
  // While a search or filter loads, the page stays (and its controls keep their focus).
  pendingMs: Number.POSITIVE_INFINITY,
  gcTime: 0,
  component: OrdersPage,
});

function OrdersPage() {
  const { rows, canCreate, total, page: at, size } = Route.useLoaderData();
  const { q, sort, page: _page, ...values } = Route.useSearch();
  const { viewer } = Route.useRouteContext();
  const navigate = useNavigate({ from: "/orders/" });
  const router = useRouter();
  // The chosen rows, offered when the viewer may do something to at least one row.
  const [selected, setSelected] = useState<Set<number>>(new Set());
  const chosen = rows.filter((row) => selected.has(row.id));
  const selectable = rows.some((row) => allows(orderDeleteRule, viewer, row.ownerId));
  const newButton = canCreate && (
    <Link to="/orders/new" className={buttonVariants()}>
      {w.newOne("order")}
    </Link>
  );
  return (
    <>
      <PageHeader
        page="orders"
        title={pageUi["orders"].title}
        actions={newButton}
      />
      <SearchBox
        value={q ?? ""}
        placeholder="Search by number or customer"
        onSearch={(text) => navigate({ to: "/orders", search: (prev) => ({ ...prev, q: text || undefined, page: undefined }), replace: true, resetScroll: false })}
      />
      <Filters
        filters={[
  {
    name: "status",
    label: "Status",
    kind: "chips",
    options: orderUi.fields.find((f) => f.name === "status")?.choices,
  },
]}
        values={values}
        onChange={(next) => navigate({ to: "/orders", search: { q, ...next }, replace: true, resetScroll: false })}
      />
      {selectable && (
        <SelectionBar
          count={chosen.length}
          noun={["order", "orders"]}
          app={app}
          titleOf={(id) => String(rows.find((row) => row.id === id)?.number ?? id)}
          actions={[]}
          deletable={chosen.filter((row) => allows(orderDeleteRule, viewer, row.ownerId)).length}
          onDelete={(together) => deleteOrders({ data: { ids: chosen.map((row) => row.id), together } })}
          trash
          onDone={async () => {
            setSelected(new Set());
            await router.invalidate();
          }}
          onExport={() => download(csvName(orderUi), csvOf(orderUi, chosen))}
        />
      )}
      <TrashNotice
        model="Order"
        onUndo={async (id) => {
          await restoreOrders({ data: [id] });
          await router.invalidate();
        }}
      />
      <ModelTable
        ui={orderUi}
        page="orders"
        paging={{ page: at, size, total, to: (next) => navigate({ to: "/orders", search: (prev) => ({ ...prev, page: next > 1 ? next : undefined }) }) }}
        app={app}
        exportRows={async () => (await searchOrders({ data: { q, sort, f: values, all: true } })).rows}
        rows={rows}
        selection={selectable ? { ids: selected, onChange: setSelected } : undefined}
        emptyMessage={q || Object.values(values).some(Boolean) ? "No orders match the search and filters." : undefined}
        emptyAction={newButton || undefined}
        onOpen={(row) => navigate({ to: "/orders/$id", params: { id: String(row.id) } })}
      />
      {viewer && (
        <p className="pt-2 text-right text-sm">
          <Link to="/orders/trash" className="text-muted-foreground hover:underline">
            {w.trashView}
          </Link>
        </p>
      )}
    </>
  );
}
"
`;

exports[`../../../examples/crm/smithable.yml > file list and generated code > src/routes/orders/new.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, useNavigate } from "@tanstack/react-router";
import { app } from "#/generated/app";
import { pageAccess, pageHead } from "#/generated/pages";
import { createOrder, orderUi } from "#/generated/order";
import { orderSchema } from "#/generated/order.schema";
import { customerOptions } from "#/generated/customer";
import { guardPage } from "#/kit/access";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";
import { w } from "#/kit/words";
import { count, optional, type Search } from "#/kit/params";

export const Route = createFileRoute("/orders/new")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["orders"], context.viewer, location.href),
  head: () => pageHead("orders"),
  validateSearch: (s: Search) => optional({ customer: count(s.customer) }),
  loader: async () => ({ options: { customerId: await customerOptions() } }),
  component: NewOrderPage,
});

function NewOrderPage() {
  const { options } = Route.useLoaderData();
  const search = Route.useSearch();
  const navigate = useNavigate();
  const back = () => search.customer ? navigate({ to: "/customers/$id", params: { id: String(search.customer) } }) : navigate({ to: "/orders" });
  return (
    <>
      <PageHeader title={w.newOne("order")} />
      <ModelForm
        ui={orderUi}
        app={app}
        schema={orderSchema}
        preset={{ ...(search.customer ? { customerId: search.customer } : {}) }}
        fixed={[...(search.customer ? ["customerId"] : [])]}
        options={options}
        submitLabel={w.createOne("order")}
        onSubmit={async (values) => {
          await createOrder({ data: values });
          await back();
        }}
        onCancel={back}
      />
    </>
  );
}
"
`;

