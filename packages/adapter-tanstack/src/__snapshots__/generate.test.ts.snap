exports[`../../../examples/barbers/smithable.yml > file list and generated code > src/generated/access.test.ts 1`] = `
"// Generated by Smithable from smithable.yml and smithable.auth.yml. Do not edit: this file is overwritten on every change.
// For every model and role: which records a user can read, create, change and delete.
// "Own" records are owned by the user; "others" by someone else.
import { and, eq } from "drizzle-orm";
import { describe, expect, test } from "vitest";
import { db } from "#/db";
import { auditLog, user } from "#/db/schema";
import * as schema from "#/db/schema";
import { AccessDenied, type Viewer } from "#/kit/access";
import { forgetInLog, pruneAudit } from "#/kit/audit.server";
import { instantOf } from "#/kit/zoned";
import { app } from "./app";
import { serviceData } from "./service.server";
import { barberData } from "./barber.server";
import { timeOffData } from "./time-off.server";
import { appointmentData } from "./appointment.server";
import { runConfirm, runConfirmMany } from "./actions/confirm.server";
import { runCancel, runCancelMany } from "./actions/cancel.server";

let counter = 0;
const next = () => ++counter;

/** A new signed-in user with the role. */
function signedIn(role: string): Viewer {
  const n = next();
  const viewer = { id: \`test-user-\${n}\`, name: \`Test \${role} \${n}\`, email: \`user\${n}@example.com\`, role };
  db.insert(user).values(viewer).run();
  return viewer;
}

/** Owns the records that are someone else's. */
const stranger = signedIn("member");

/** Whether the action is allowed; any other failure fails the test. */
async function can(action: () => unknown): Promise<boolean> {
  try {
    await action();
    return true;
  } catch (error) {
    if (error instanceof AccessDenied) return false;
    throw error;
  }
}

/** Whether the viewer can open the record and sees it in the list. */
async function reads(
  data: { get(viewer: never, id: number): Promise<unknown>; list(viewer: never): Promise<{ id: number }[]> },
  viewer: unknown,
  id: number,
): Promise<boolean> {
  const listed = await data.list(viewer as never).then(
    (rows) => rows.some((row) => row.id === id),
    (error) => {
      if (error instanceof AccessDenied) return false;
      throw error;
    },
  );
  return listed && (await data.get(viewer as never, id)) !== null;
}

function serviceValues(_owner: string | null) {
  const n = next();
  return { name: \`Service name \${n}\`, summary: null, minutes: 30, price: null } as const;
}

function insertService(owner: string | null, values: Record<string, unknown> = {}) {
  return db
    .insert(schema.services)
    .values({ ...serviceValues(owner), ...values, ownerId: owner })
    .returning()
    .get();
}

function barberValues(_owner: string | null) {
  const n = next();
  return { name: \`Barber name \${n}\`, bio: null, portrait: null } as const;
}

function insertBarber(owner: string | null, values: Record<string, unknown> = {}) {
  return db
    .insert(schema.barbers)
    .values({ ...barberValues(owner), ...values, ownerId: owner })
    .returning()
    .get();
}

function timeOffValues(owner: string | null) {
  return { barberId: insertBarber(owner).id, from: new Date("2099-01-15T10:00:00Z"), until: new Date("2099-01-15T10:00:00Z"), note: null } as const;
}

function insertTimeOff(owner: string | null, values: Record<string, unknown> = {}) {
  return db
    .insert(schema.timeOffs)
    .values({ ...timeOffValues(owner), ...values, ownerId: owner })
    .returning()
    .get();
}

function appointmentValues(owner: string | null) {
  const n = next();
  return { serviceId: insertService(owner).id, barberId: insertBarber(owner).id, startsAt: instantOf("2026-01-12T09:00", app.timeZone), name: \`Appointment name \${n}\`, phone: null, note: null, status: "requested" } as const;
}

function insertAppointment(owner: string | null, values: Record<string, unknown> = {}) {
  return db
    .insert(schema.appointments)
    .values({ ...appointmentValues(owner), ...values, ownerId: owner })
    .returning()
    .get();
}

describe("Service", () => {
  test("admin", async () => {
    const viewer = signedIn("admin");
    const others = insertService(stranger.id);
    const own = insertService(viewer.id);
    expect({
      readOthers: await reads(serviceData, viewer, others.id),
      readOwn: await reads(serviceData, viewer, own.id),
      create: await can(() => serviceData.create(viewer, serviceValues(viewer.id))),
      changeOthers: await can(() => serviceData.update(viewer, others.id, serviceValues(stranger.id))),
      changeOwn: await can(() => serviceData.update(viewer, own.id, serviceValues(viewer.id))),
      deleteOthers: await can(() => serviceData.remove(viewer, others.id)),
      deleteOwn: await can(() => serviceData.remove(viewer, own.id)),
    }).toEqual({
      readOthers: true,
      readOwn: true,
      create: true,
      changeOthers: true,
      changeOwn: true,
      deleteOthers: true,
      deleteOwn: true,
    });
  });

  test("member", async () => {
    const viewer = signedIn("member");
    const others = insertService(stranger.id);
    const own = insertService(viewer.id);
    expect({
      readOthers: await reads(serviceData, viewer, others.id),
      readOwn: await reads(serviceData, viewer, own.id),
      create: await can(() => serviceData.create(viewer, serviceValues(viewer.id))),
      changeOthers: await can(() => serviceData.update(viewer, others.id, serviceValues(stranger.id))),
      changeOwn: await can(() => serviceData.update(viewer, own.id, serviceValues(viewer.id))),
      deleteOthers: await can(() => serviceData.remove(viewer, others.id)),
      deleteOwn: await can(() => serviceData.remove(viewer, own.id)),
    }).toEqual({
      readOthers: true,
      readOwn: true,
      create: false,
      changeOthers: false,
      changeOwn: true,
      deleteOthers: false,
      deleteOwn: true,
    });
  });

  test("a visitor who has not signed in", async () => {
    const viewer = null;
    const others = insertService(stranger.id);
    expect({
      readOthers: await reads(serviceData, viewer, others.id),
      readOwn: false,
      create: await can(() => serviceData.create(viewer, serviceValues(null))),
      changeOthers: await can(() => serviceData.update(viewer, others.id, serviceValues(stranger.id))),
      changeOwn: false,
      deleteOthers: await can(() => serviceData.remove(viewer, others.id)),
      deleteOwn: false,
    }).toEqual({
      readOthers: true,
      readOwn: false,
      create: false,
      changeOthers: false,
      changeOwn: false,
      deleteOthers: false,
      deleteOwn: false,
    });
  });
});

describe("Barber", () => {
  test("admin", async () => {
    const viewer = signedIn("admin");
    const others = insertBarber(stranger.id);
    const own = insertBarber(viewer.id);
    expect({
      readOthers: await reads(barberData, viewer, others.id),
      readOwn: await reads(barberData, viewer, own.id),
      create: await can(() => barberData.create(viewer, barberValues(viewer.id))),
      changeOthers: await can(() => barberData.update(viewer, others.id, barberValues(stranger.id))),
      changeOwn: await can(() => barberData.update(viewer, own.id, barberValues(viewer.id))),
      deleteOthers: await can(() => barberData.remove(viewer, others.id)),
      deleteOwn: await can(() => barberData.remove(viewer, own.id)),
    }).toEqual({
      readOthers: true,
      readOwn: true,
      create: true,
      changeOthers: true,
      changeOwn: true,
      deleteOthers: true,
      deleteOwn: true,
    });
  });

  test("member", async () => {
    const viewer = signedIn("member");
    const others = insertBarber(stranger.id);
    const own = insertBarber(viewer.id);
    expect({
      readOthers: await reads(barberData, viewer, others.id),
      readOwn: await reads(barberData, viewer, own.id),
      create: await can(() => barberData.create(viewer, barberValues(viewer.id))),
      changeOthers: await can(() => barberData.update(viewer, others.id, barberValues(stranger.id))),
      changeOwn: await can(() => barberData.update(viewer, own.id, barberValues(viewer.id))),
      deleteOthers: await can(() => barberData.remove(viewer, others.id)),
      deleteOwn: await can(() => barberData.remove(viewer, own.id)),
    }).toEqual({
      readOthers: true,
      readOwn: true,
      create: false,
      changeOthers: false,
      changeOwn: true,
      deleteOthers: false,
      deleteOwn: true,
    });
  });

  test("a visitor who has not signed in", async () => {
    const viewer = null;
    const others = insertBarber(stranger.id);
    expect({
      readOthers: await reads(barberData, viewer, others.id),
      readOwn: false,
      create: await can(() => barberData.create(viewer, barberValues(null))),
      changeOthers: await can(() => barberData.update(viewer, others.id, barberValues(stranger.id))),
      changeOwn: false,
      deleteOthers: await can(() => barberData.remove(viewer, others.id)),
      deleteOwn: false,
