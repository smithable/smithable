"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createInsertSchema } from "drizzle-zod";
import { z } from "zod";
import * as schema from "#/db/schema";
import { w } from "#/kit/words";

/** What a message may be given: a form's values and what the app fills (an action's set). */
export const messageSettable = createInsertSchema(schema.messages, {
  content: (s) => s.trim().min(1, w.required).max(10000, w.atMostCharacters(10000)),
  fromEmail: z.email(w.enterValidEmail).nullish(),
  attachments: z.array(z.object({ file: z.string().regex(/^message\\/[a-f0-9]{24}\\.[a-z0-9]{2,4}$/), name: z.string().max(200), type: z.string().max(100), size: z.int().nonnegative(), receipt: z.string().max(64).optional() })).max(10).nullish(),
}).omit({ id: true, ownerId: true, createdAt: true, updatedAt: true }).partial({ agentId: true });
/** What a message's form sends, checked: never what the app fills. */
export const messageSchema = messageSettable.omit({ agentId: true });

export type MessageSettable = z.output<typeof messageSettable>;
export type MessageValues = z.output<typeof messageSchema>;
"
`;

exports[`../../../examples/support/smithable.yml > file list and generated code > src/generated/message.server.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { type AnyColumn, and, asc, avg, count, desc, eq, inArray, isNotNull, max, min, sql, sum, type SQL } from "drizzle-orm";
import { db } from "#/db";
import * as schema from "#/db/schema";
import { AccessDenied, allows, check, Conflict, type ModelAccess, personOf, readScope, type Viewer } from "#/kit/access";
import { audit, changedFields } from "#/kit/audit.server";
import { refusal } from "#/kit/log.server";
import { titleOf } from "#/kit/format";
import { outgoing } from "#/generated/outgoing.server";
import { contains } from "#/kit/search";
import { BadInput } from "#/kit/refusal";
import { aggregate, type Filterable, nearest, sortOf, whereOf, wordsOf } from "#/kit/where";
import { deleteFile } from "#/kit/uploads";
import { acceptFiles } from "#/kit/receipts.server";
import { afterChange, afterDelete } from "./hooks";
import { supportCaseData } from "./support-case.server";
import { type MessageSettable } from "./message";

/** Who may read, create, change and delete messages. */
export const messageAccess: ModelAccess = {
  read: { public: false, roles: ["admin", "agent"], owner: false },
  create: { public: false, roles: ["admin", "agent"], owner: false },
  write: { public: false, roles: ["admin", "agent"], owner: true },
  delete: { public: false, roles: ["admin"], owner: true },
};

/** A record as the viewer gets it: who owns it only for its owner and roles that read every record. */
function shownTo<R extends { ownerId: string | null }>(viewer: Viewer | null, row: R): R {
  if ((viewer && row.ownerId === viewer.id) || (!!viewer && (!!viewer.system || messageAccess.read.roles.includes(viewer.role)))) return row;
  return { ...row, ownerId: null };
}


/** What \`where\` may name, and how: the stored fields, by kind. */
const FILTERABLE: Record<string, Filterable> = {
  content: { kind: "text", column: schema.messages.content },
  sender: { kind: "choice", column: schema.messages.sender, values: ["agent","customer"] },
  agent: { kind: "reference", column: schema.messages.agentId, title: { table: schema.user, column: schema.user.name } },
  fromEmail: { kind: "text", column: schema.messages.fromEmail },
  supportCase: { kind: "reference", column: schema.messages.supportCaseId },
};

/** What the records can be sorted by. */
const SORTABLE = { id: schema.messages.id, content: schema.messages.content, sender: schema.messages.sender, fromEmail: schema.messages.fromEmail, createdAt: schema.messages.createdAt };

/** The number fields \`measure\` adds up; amounts are stored in cents. */
const NUMBERS: Record<string, AnyColumn> = {  };
const MONEY: string[] = [];

/** Computed number fields \`measure\` adds up from the records themselves. */
const COMPUTED: string[] = [];

/** The titles of the referenced records \`measureBy\` splits by, to name its groups. */
function titlesOf(viewer: Viewer | null, by: string, ids: number[]): Map<unknown, string> {
  switch (by) {
    case "supportCase":
      return new Map(db.select({ id: schema.supportCases.id, title: schema.supportCases.subject }).from(schema.supportCases).where(and(inArray(schema.supportCases.id, ids), supportCaseData.readable(viewer))).all().map((r) => [r.id, String(r.title)]));
    default:
      return new Map();
  }
}

/** What \`measureBy\` may split by: choices, yes/no, references, and dates by month. */
const BY: string[] = ["sender","agent","supportCase"];


/** Each picture or document new to the record must come with the receipt its upload gave the viewer (src/kit/receipts.server.ts); the receipts are not kept. */
function checkFiles<V extends Partial<MessageSettable>>(viewer: Viewer | null, values: V, before?: Record<string, unknown>): V {
  return {
    ...values,
    ...("attachments" in values ? { attachments: acceptFiles(viewer, "message", "attachments", values.attachments, before?.attachments) } : {}),
  };
}

/** Checks that the viewer may read the records the values refer to. */
function checkReferences(viewer: Viewer | null, values: Partial<MessageSettable>): void {
  if (values.supportCaseId != null && !supportCaseData.canRead(viewer, values.supportCaseId))
    throw new AccessDenied(viewer !== null);
}

/** \`rows\` with each \`field\` reference \`readable\` leaves out set to nothing (only its id stays). */
function hideRefs<R extends Record<string, unknown>>(rows: R[], field: string, readable: (ids: number[]) => number[]): R[] {
  const idOf = (row: R) => (row[field] as { id?: unknown } | null | undefined)?.id;
  const ids = [...new Set(rows.map(idOf).filter((id): id is number => typeof id === "number"))];
  if (!ids.length) return rows;
  const shown = new Set(readable(ids));
  return rows.map((row) => {
    const id = idOf(row);
    return typeof id === "number" && !shown.has(id) ? { ...row, [field]: null } : row;
  });
}

export const messageData = {
  shownTo,
  /** The rows with each reference to a record the viewer may not read set to nothing: a related record's title is shown only to who may read it (only its id stays). */
  shownRefs<R extends Record<string, unknown>>(viewer: Viewer | null, rows: R[]): R[] {
    return hideRefs(rows, "supportCase", (ids, c = supportCaseData.readable(viewer)) => (c ? db.select({ id: schema.supportCases.id }).from(schema.supportCases).where(and(inArray(schema.supportCases.id, ids), c)).all().map((r) => r.id) : ids));
  },

  /** Whether a stored picture or document is on any record (the trash too): a file no record has may go. */
  uses(file: string): boolean {
    return !!db.select({ id: schema.messages.id }).from(schema.messages).where(sql\`\${schema.messages.attachments} like \${\`%"file":"\${file}"%\`}\`).get();
  },

  /** A condition for the messages the viewer may read. */
  readable(viewer: Viewer | null) {
    const scope = readScope(messageAccess.read, viewer);
    if (scope === "all") return undefined;
    return scope === "own" && viewer ? eq(schema.messages.ownerId, viewer.id) : sql\`false\`;
  },

  canRead(viewer: Viewer | null, id: number): boolean {
    const found = db
      .select({ id: schema.messages.id })
      .from(schema.messages)
      .where(and(eq(schema.messages.id, id), messageData.readable(viewer)))
      .get();
    return found !== undefined;
  },

  /** The messages the viewer may read; \`where\` narrows them, e.g. to a search. */
  async list(viewer: Viewer | null, where?: SQL) {
    if (readScope(messageAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const found = messageData.shownRefs(viewer, await db.query.messages.findMany({
      where: and(messageData.readable(viewer), where),
      with: { supportCase: { columns: { id: true, subject: true } }, agent: { columns: { id: true, name: true } } },
      orderBy: (t, { desc }) => [desc(t.id)],
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return rows;
  },

  /**
   * The messages the viewer may read that fit \`where\` and \`search\`, in \`sort\`'s order (else newest
   * first), a page of them and how many there are: for the API and the assistants' tools.
   */
  async find(
    viewer: Viewer | null,
    options: { where?: unknown; search?: string; sort?: string; limit?: number; offset?: number } = {},
  ) {
    if (readScope(messageAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = messageData.fitting(viewer, options.where, options.search);
    const order = sortOf(SORTABLE, options.sort);
    const total = db.select({ n: count() }).from(schema.messages).where(condition).get()?.n ?? 0;
    const found = messageData.shownRefs(viewer, await db.query.messages.findMany({
      where: condition,
      with: { supportCase: { columns: { id: true, subject: true } }, agent: { columns: { id: true, name: true } } },
      orderBy: (t, { desc }) => [...(order ? [order] : []), desc(t.id)],
      limit: options.limit ?? 100,
      offset: options.offset ?? 0,
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return { items: rows, total };
  },

  /**
   * A number from the messages the viewer may read that fit \`where\`: how many, or the sum,
   * average, smallest or largest of a number field.
   */
  async measure(
    viewer: Viewer | null,
    how: "count" | "sum" | "average" | "smallest" | "largest",
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<number | null> {
    if (readScope(messageAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = messageData.fitting(viewer, options.where, options.search);
    if (how === "count")
      return db.select({ n: count() }).from(schema.messages).where(condition).get()?.n ?? 0;
    const field = options.field ?? "";
    const money = MONEY.includes(field);
    if (COMPUTED.includes(field)) {
      const rows = await messageData.computedRows(condition);
      const value = aggregate(rows.map((row) => row[field]), how);
      return value === null ? null : money ? value / 100 : value;
    }
    const column = Object.hasOwn(NUMBERS, field) ? NUMBERS[field] : undefined;
    if (!column)
      throw new BadInput(
        \`\${how} needs a number field: \${[...Object.keys(NUMBERS), ...COMPUTED].join(", ") || "there are none"}.\`,
      );
    const pick = { sum, average: avg, smallest: min, largest: max }[how];
    const value = db.select({ v: pick(column) }).from(schema.messages).where(condition).get()?.v;
    if (value === null || value === undefined) return null;
    return money ? Number(value) / 100 : Number(value);
  },

  /** Which record holds the smallest or largest value of a number field (the first of a tie). */
  async holder(
    viewer: Viewer | null,
    how: "smallest" | "largest",
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<{ id: number; title: string } | null> {
    const condition = messageData.fitting(viewer, options.where, options.search);
    const field = options.field ?? "";
    if (COMPUTED.includes(field)) {
      let best: Record<string, unknown> | undefined;
      for (const row of await messageData.computedRows(condition)) {
        const v = row[field];
        if (typeof v !== "number") continue;
        if (!best || (how === "largest" ? v > (best[field] as number) : v < (best[field] as number))) best = row;
      }
      return best ? { id: best.id as number, title: titleOf(best.content) } : null;
    }
    const column = Object.hasOwn(NUMBERS, field) ? NUMBERS[field] : undefined;
    if (!column) return null;
    const row = db
      .select({ id: schema.messages.id, title: schema.messages.content })
      .from(schema.messages)
      .where(and(condition, isNotNull(column)))
      .orderBy(how === "largest" ? desc(column) : asc(column), asc(schema.messages.id))
      .limit(1)
      .get();
    return row ? { id: row.id, title: titleOf(row.title) } : null;
  },

  /**
   * The same number per value of a field (a choice, yes/no, a reference) or per month of a date:
   * \`[{ value, number }]\`, the most first.
   */
  async measureBy(
    viewer: Viewer | null,
    how: "count" | "sum" | "average" | "smallest" | "largest",
    by: string,
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<{ value: unknown; title?: string; number: number | null }[]> {
    if (readScope(messageAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const split = Object.hasOwn(FILTERABLE, by) ? FILTERABLE[by] : undefined;
    if (!split || split.kind === "text" || split.kind === "number" || split.kind === "money")
      throw new BadInput(\`There is no field "\${by}" to split by. Fields: \${BY.join(", ")}.\`);
    const field = options.field ?? "";
    const money = MONEY.includes(field);
    const condition = messageData.fitting(viewer, options.where, options.search);
    const amount = (n: number | null) => (n === null ? null : money ? n / 100 : n);
    const most = (a: { number: number | null }, b: { number: number | null }) => (b.number ?? 0) - (a.number ?? 0);
    // A reference's groups carry the referenced record's title beside its id.
    const named = (rows: { value: unknown; number: number | null }[]) => {
      if (split.kind !== "reference") return rows;
      const titles = titlesOf(viewer, by, rows.map((r) => r.value).filter((v): v is number => typeof v === "number"));
      return rows.map((r) => (titles.has(r.value) ? { value: r.value, title: titles.get(r.value), number: r.number } : r));
    };
    if (COMPUTED.includes(field)) {
      // Each record's month or value, then the computed numbers added up per group.
      const groups = new Map<unknown, unknown[]>();
      for (const row of await messageData.computedRows(condition)) {
        const raw = row[split.kind === "reference" ? \`\${by}Id\` : by];
        const value = split.kind === "date" ? String(raw ?? "").slice(0, 7) || null : split.kind === "instant" ? (raw instanceof Date ? raw.toISOString().slice(0, 7) : null) : raw;
        groups.set(value, [...(groups.get(value) ?? []), row[field]]);
      }
      return named([...groups].map(([value, numbers]) => ({ value, number: amount(aggregate(numbers, how)) })).sort(most));
    }
    const key = split.kind === "date" ? sql<string>\`substr(\${split.column}, 1, 7)\` : split.kind === "instant" ? sql<string>\`strftime('%Y-%m', \${split.column} / 1000, 'unixepoch')\` : sql\`\${split.column}\`;
    const column = Object.hasOwn(NUMBERS, field) ? NUMBERS[field] : undefined;
    if (how !== "count" && !column)
      throw new BadInput(\`\${how} needs a number field: \${[...Object.keys(NUMBERS), ...COMPUTED].join(", ") || "there are none"}.\`);
    const pick = how === "count" || !column ? count() : { sum, average: avg, smallest: min, largest: max }[how](column);
    return named(
      db
        .select({ value: key, number: pick })
        .from(schema.messages)
        .where(condition)
        .groupBy(key)
        .all()
        .map((r) => ({ value: r.value, number: r.number === null ? null : amount(Number(r.number)) }))
        .sort(most),
    );
  },

  /**
   * The records that fit, with their computed fields worked out: for adding those up. At most
   * 10,000, so one call never reads a whole large table; more are refused with how to narrow them.
   */
  async computedRows(condition: SQL | undefined): Promise<Record<string, unknown>[]> {
    const rows = await db.query.messages.findMany({ where: condition, with: { supportCase: { columns: { id: true, subject: true } }, agent: { columns: { id: true, name: true } } }, limit: 10001 });
    if (rows.length > 10000)
      throw new BadInput("More than 10,000 records to add up a computed field over: narrow them with where.");
    return rows.map((row) => row as Record<string, unknown>);
  },

  /** The messages the viewer may read whose content has the text: a few, for naming one. */
  named(viewer: Viewer | null, text: string): { id: number; title: string }[] {
    return db
      .select({ id: schema.messages.id, title: schema.messages.content })
      .from(schema.messages)
      .where(and(messageData.readable(viewer), contains([schema.messages.content], text)))
      .limit(6)
      .all()
      .map((row) => ({ id: row.id, title: titleOf(row.title) }));
  },

  /** Every content the viewer may read (at most 2,000): the nearest when a name fits none. */
  titles(viewer: Viewer | null): string[] {
    return db
      .select({ title: schema.messages.content })
      .from(schema.messages)
      .where(messageData.readable(viewer))
      .limit(2000)
      .all()
      .map((row) => titleOf(row.title));
  },

  /** Why \`where\` found none when it names a text no record has: the field's nearest values. */
  whyNone(viewer: Viewer | null, where: unknown): string | undefined {
    if (!where || typeof where !== "object") return undefined;
    for (const [name, v] of Object.entries(where)) {
      const field = Object.hasOwn(FILTERABLE, name) ? FILTERABLE[name] : undefined;
      if (field?.kind !== "text" || (typeof v !== "string" && typeof v !== "number")) continue;
      const values = db
        .selectDistinct({ v: sql<string>\`\${field.column}\` })
        .from(schema.messages)
        .where(and(messageData.readable(viewer), isNotNull(field.column)))
        .limit(2000)
        .all()
        .map((row) => String(row.v));
      const asked = String(v);
      if (values.length && !values.some((x) => x.toLowerCase().includes(asked.toLowerCase())))
        return \`No message has "\${asked}" in \${name}; the nearest: \${nearest(asked, values).join(", ")}.\`;
    }
    return undefined;
  },

  /** The condition for records the viewer may read that fit \`where\` and \`search\`. */
  fitting(viewer: Viewer | null, where?: unknown, search?: string) {
    return and(
      messageData.readable(viewer),
      whereOf(FILTERABLE, where, viewer ? eq(schema.messages.ownerId, viewer.id) : undefined, viewer?.id, {supportCase: { find: (text: string) => supportCaseData.named(viewer, text), titles: () => supportCaseData.titles(viewer) }}),
      // Every word somewhere in the texts ("ship lamp" finds "ship's lamp").
      ...wordsOf(search).map((word) => contains([schema.messages.content, schema.messages.fromEmail], word)),
    );
  },

  async get(viewer: Viewer | null, id: number) {
    const fetched = await db.query.messages.findFirst({
      where: and(eq(schema.messages.id, id), messageData.readable(viewer)),
      with: { supportCase: { columns: { id: true, subject: true } }, agent: { columns: { id: true, name: true } } },
    });
    const found = fetched && messageData.shownRefs(viewer, [fetched])[0];
    const row = found && shownTo(viewer, found);
    return row ? row : null;
  },

  async create(viewer: Viewer | null, values: MessageSettable) {
    check(messageAccess.create, viewer);
    values = checkFiles(viewer, values);
    checkReferences(viewer, values);
    let row: typeof schema.messages.$inferSelect;
    try {
      row = db.transaction((tx) => {
        const made = tx.insert(schema.messages).values({ ...values, ownerId: personOf(viewer), agentId: personOf(viewer) }).returning().get();
        audit(tx, viewer, { action: "created", model: "Message", record: made.id });
        outgoing(tx, viewer, "Message", "created", made);
        return made;
      });
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterCreate", "Message", row, viewer);
    return row;
  },

  /** Changes the record; \`what\` names the change in the audit log (an action's name). */
  /** Changes the fields given; what names the action ("changed" for a form), frees the fields it may change although locked (its own set). */
  async update(viewer: Viewer | null, id: number, values: Partial<MessageSettable>, what = "changed", _frees: readonly string[] = []) {
    const row = db
      .select({ ownerId: schema.messages.ownerId, attachments: schema.messages.attachments })
      .from(schema.messages)
      .where(and(eq(schema.messages.id, id), messageData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    // A form's change needs write on the record; an action (what names it) checked its own access
    // first, which includes the roles its grant names (docs/design/actions.md, Access).
    if (what === "changed") check(messageAccess.write, viewer, row.ownerId);
    values = checkFiles(viewer, values, db.select({ attachments: schema.messages.attachments }).from(schema.messages).where(eq(schema.messages.id, id)).get());
    checkReferences(viewer, values);
    let changed: typeof schema.messages.$inferSelect;
    const updated = values;
    try {
      changed = db.transaction((tx) => {
        // Read again in the change itself: a record that left the viewer's reach meanwhile is refused.
        const before = tx.select().from(schema.messages).where(and(eq(schema.messages.id, id), messageData.readable(viewer))).get();
        if (!before) throw new AccessDenied(viewer !== null);
        const after = tx.update(schema.messages).set(updated).where(eq(schema.messages.id, id)).returning().get();
        audit(tx, viewer, { action: what, model: "Message", record: id, fields: before && changedFields(before, after, Object.keys(updated)) });
        outgoing(tx, viewer, "Message", what, after, before);
        return after;
      });
    } catch (error) {
      throw refusal(error);
    }
    for (const p of row.attachments ?? []) if (!(changed.attachments ?? []).map((p) => p.file).includes(p.file)) deleteFile(p, !!db.select({ id: schema.messages.id }).from(schema.messages).where(sql\`\${schema.messages.attachments} like \${\`%"file":"\${p.file}"%\`}\`).get());
    await afterChange("afterUpdate", "Message", changed, viewer);
    return changed;
  },

  /** Deletes the record; \`together\` takes the records that point to it along to the trash (delete-together.md). */
  async remove(viewer: Viewer | null, id: number, _together = false): Promise<void> {
    const row = db
      .select({ ownerId: schema.messages.ownerId, attachments: schema.messages.attachments })
      .from(schema.messages)
      .where(and(eq(schema.messages.id, id), messageData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(messageAccess.delete, viewer, row.ownerId);
    try {
      db.transaction((tx) => {
        // Read again in the change itself: a record that left the viewer's reach meanwhile is refused.
        if (!tx.select({ id: schema.messages.id }).from(schema.messages).where(and(eq(schema.messages.id, id), messageData.readable(viewer))).get())
          throw new AccessDenied(viewer !== null);
        const gone = tx.delete(schema.messages).where(eq(schema.messages.id, id)).returning().get();
        if (gone) {
          audit(tx, viewer, { action: "deleted", model: "Message", record: id, title: titleOf(gone.content) });
          outgoing(tx, viewer, "Message", "deleted", gone);
        }
      });
    } catch (error) {
      throw refusal(error);
    }
    for (const p of row.attachments ?? []) if (!([] as string[]).includes(p.file)) deleteFile(p, !!db.select({ id: schema.messages.id }).from(schema.messages).where(sql\`\${schema.messages.attachments} like \${\`%"file":"\${p.file}"%\`}\`).get());
    await afterDelete("Message", id, viewer);
  },

  /**
   * Deletes the chosen records the viewer may delete, all or none (one still in use stops them
   * all, and is named); the others are skipped.
   */
  async removeMany(viewer: Viewer | null, ids: number[], _together = false): Promise<{ deleted: number; skipped: number }> {
    const rows = db
      .select({ id: schema.messages.id, ownerId: schema.messages.ownerId, attachments: schema.messages.attachments })
      .from(schema.messages)
      .where(and(inArray(schema.messages.id, ids), messageData.readable(viewer)))
      .all()
      .filter((row) => allows(messageAccess.delete, viewer, row.ownerId));
    db.transaction((tx) => {
      for (const row of rows)
        try {
          const gone = tx.delete(schema.messages).where(eq(schema.messages.id, row.id)).returning().get();
          if (gone) {
            audit(tx, viewer, { action: "deleted", model: "Message", record: row.id, title: titleOf(gone.content) });
            outgoing(tx, viewer, "Message", "deleted", gone);
          }
        } catch (error) {
          const refused = refusal(error);
          throw refused instanceof Conflict && refused.message === "in-use" ? new Conflict(\`in-use:\${row.id}\`) : refused;
        }
    });
    for (const row of rows) {
      for (const p of row.attachments ?? []) if (!([] as string[]).includes(p.file)) deleteFile(p, !!db.select({ id: schema.messages.id }).from(schema.messages).where(sql\`\${schema.messages.attachments} like \${\`%"file":"\${p.file}"%\`}\`).get());
      await afterDelete("Message", row.id, viewer);
    }
    return { deleted: rows.length, skipped: new Set(ids).size - rows.length };
  },
};
"
`;

exports[`../../../examples/support/smithable.yml > file list and generated code > src/generated/message.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { z } from "zod";
import type * as schema from "#/db/schema";
import { allows, type Rule } from "#/kit/access";
import type { RecordUi } from "#/kit/model";
import { bindFiles } from "#/kit/FileInput";
import { messageAccess, messageData } from "./message.server";
import { writeAllowed } from "#/kit/limit";
import { currentViewer } from "#/lib/viewer.server";
import { messageSchema } from "./message.schema";

export type { MessageSettable, MessageValues } from "./message.schema";

/** The viewer about to write, counted against how often one may (see src/kit/limit.ts). */
async function writer() {
  const viewer = await currentViewer();
  writeAllowed(viewer, getRequestHeaders());
  return viewer;
}

/** Message records as the kit reads them. */
export type MessageRow = typeof schema.messages.$inferSelect & {
  agent?: { id: string; name: string } | null;
  supportCase?: { id: number; subject: string } | null;
};

export const messageUi: RecordUi<MessageRow> = {
  model: "Message",
  label: "Message",
  pluralLabel: "Messages",
  titleField: "content",
  descriptionField: "content",
  columns: ["content", "sender", "supportCaseId", "agentId", "fromEmail"],
  fields: [
    {
      name: "content",
      label: "Content",
      kind: "text",
      required: true,
      get: (row) => row.content,
    },
    {
      name: "sender",
      label: "Sender",
      kind: "choice",
      required: true,
      choices: [{ value: "agent", label: "Agent" }, { value: "customer", label: "Customer" }],
      default: "agent",
      get: (row) => row.sender,
    },
    {
      name: "agentId",
      label: "Agent",
      kind: "user",
      required: false,
      byApp: true,
      relation: { key: "agent", titleField: "name" },
      get: (row) => row.agent?.name ?? null,
    },
    {
      name: "fromEmail",
      label: "From email",
      kind: "email",
      required: false,
      get: (row) => row.fromEmail,
    },
    {
      name: "attachments",
      label: "Attachments",
      kind: "files",
      required: false,
      input: bindFiles("message", "attachments", 10),
      get: (row) => row.attachments,
    },
    {
      name: "supportCaseId",
      label: "Support case",
      kind: "relation",
      required: true,
      relation: { key: "supportCase", titleField: "subject" },
      get: (row) => row.supportCase?.subject ?? null,
    },
  ],
};

/** Who may delete messages: a list's selection offers Delete by it (the server checks again). */
export const messageDeleteRule: Rule = { public: false, roles: ["admin"], owner: true };


export const listMessages = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return { rows: await messageData.list(viewer), canCreate: allows(messageAccess.create, viewer) };
});

export const getMessage = createServerFn()
  .validator(z.number().int())
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    const row = await messageData.get(viewer, id);
    if (!row) return null;
    return {
      row,
      canWrite: allows(messageAccess.write, viewer, row.ownerId),
      canDelete: allows(messageAccess.delete, viewer, row.ownerId),
    };
  });

export const createMessage = createServerFn({ method: "POST" })
  .validator(messageSchema)
  .handler(async ({ data }) => messageData.create(await writer(), data));

export const updateMessage = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), values: messageSchema }))
  .handler(async ({ data }) => messageData.update(await writer(), data.id, data.values));

/** Deletes a message; \`together\` takes what points to it along (docs/design/delete-together.md). */
export const deleteMessage = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), together: z.boolean().optional() }))
  .handler(async ({ data }) => messageData.remove(await writer(), data.id, data.together));

/** Deletes the chosen messages, all or none (at most 1,000 at once). */
export const deleteMessages = createServerFn({ method: "POST" })
  .validator(z.object({ ids: z.array(z.number().int()).max(1000), together: z.boolean().optional() }))
  .handler(async ({ data }) => messageData.removeMany(await writer(), data.ids, data.together));
"
`;

exports[`../../../examples/support/smithable.yml > file list and generated code > src/generated/outgoing.server.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { AsyncLocalStorage } from "node:async_hooks";
import { and, asc, eq } from "drizzle-orm";
import type { SQLiteColumn, SQLiteTable } from "drizzle-orm/sqlite-core";
import type { db } from "#/db";
import * as schema from "#/db/schema";
import { app } from "#/generated/app";
import type { Viewer } from "#/kit/access";
import { formatValue } from "#/kit/format";
import { counts } from "#/kit/outgoing";
import { type Happening, queueMail, type Recipient, type Thread } from "#/kit/outgoing.server";

type Tx = Pick<typeof db, "select" | "insert">;
type Row = Record<string, unknown>;

/** One column of the record with the id, inside the transaction. */
function one(tx: Tx, table: SQLiteTable, id: SQLiteColumn, column: SQLiteColumn, value: unknown): unknown {
  if (value == null) return undefined;
  return tx.select({ v: column }).from(table).where(eq(id, value)).get()?.v;
}

const arriving = new AsyncLocalStorage<{ messageId?: string; quiet: boolean }>();

/**
 * Runs a change made from an incoming mail (mail-threads.md §3): the mail's id joins the thread its
 * first answer starts, and an automatic mail (an auto-reply, a bounce) tells nobody.
 */
export function fromMail<T>(mail: { messageId?: string; quiet: boolean }, run: () => Promise<T>): Promise<T> {
  return arriving.run(mail, run);
}

/**
 * A record's mail thread (mail-threads.md §4): the tag at the end of the subject, the latest mail
 * received as the one answered, the thread's last twenty ids, where a reply goes, and each id sent kept.
 */
function thread(tx: Tx, model: string, record: number, replyTo: string | undefined): Thread {
  const ids = tx
    .select({ id: schema.mailThreads.messageId, received: schema.mailThreads.received })
    .from(schema.mailThreads)
    .where(and(eq(schema.mailThreads.model, model), eq(schema.mailThreads.recordId, record)))
    .orderBy(asc(schema.mailThreads.at), asc(schema.mailThreads.id))
    .all();
  // The mail this change came from is the one its first answer answers.
  const got = arriving.getStore()?.messageId;
  if (got && !ids.some((i) => i.id === got)) {
    tx.insert(schema.mailThreads).values({ model, recordId: record, messageId: got, received: true }).run();
    ids.push({ id: got, received: true });
  }
  return {
    tag: \`[\${app.name} #\${record}]\`,
    inReplyTo: (ids.filter((i) => i.received).at(-1) ?? ids.at(-1))?.id,
    references: ids.slice(-20).map((i) => i.id),
    replyTo: replyTo || undefined,
    keep: (messageId) => {
      tx.insert(schema.mailThreads).values({ model, recordId: record, messageId }).run();
    },
  };
}

/** Each model's record as a mail shows it: the subject, its fields, its page. */
const SHOWN: Record<string, (tx: Tx, r: Row) => Omit<Happening, "entry" | "model" | "record">> = {
  "SupportCase": (tx, r) => ({
    subject: String(String(r.subject ?? r.id)),
    fields: [
      ["Subject", formatValue({ name: "subject", label: "Subject", kind: "string", required: false }, r.subject, app)],
      ["Customer email", formatValue({
  name: "customerEmail",
  label: "Customer email",
  kind: "email",
  required: false,
}, r.customerEmail, app)],
      ["Status", formatValue({
  name: "status",
  label: "Status",
  kind: "choice",
  required: false,
  choices: [
    { value: "open", label: "Open" },
    { value: "inProgress", label: "In progress" },
    { value: "closed", label: "Closed" },
    { value: "reopened", label: "Reopened" },
  ],
}, r.status, app)],
      ["Priority", formatValue({ name: "priority", label: "Priority", kind: "int", required: false }, r.priority, app)],
      ["Assignee", String(one(tx, schema.user, schema.user.id, schema.user.name, r.assigneeId) ?? "—")],
      ["Body", formatValue({ name: "body", label: "Body", kind: "text", required: false }, r.body, app)],
    ],
    link: \`/cases/\${r.id}\`,
    thread: thread(tx, "SupportCase", r.id as number, process.env.INCOMING_SUPPORT_ADDRESS),
  }),
  "Message": (tx, r) => ({
    subject: String(one(tx, schema.supportCases, schema.supportCases.id, schema.supportCases.subject, r.supportCaseId as number) ?? ""),
    fields: [
      ["Content", formatValue({ name: "content", label: "Content", kind: "text", required: false }, r.content, app)],
      ["Sender", formatValue({
  name: "sender",
  label: "Sender",
  kind: "choice",
  required: false,
  choices: [{ value: "agent", label: "Agent" }, { value: "customer", label: "Customer" }],
}, r.sender, app)],
      ["Agent", String(one(tx, schema.user, schema.user.id, schema.user.name, r.agentId) ?? "—")],
      ["From email", formatValue({ name: "fromEmail", label: "From email", kind: "email", required: false }, r.fromEmail, app)],
      ["Support case", String(one(tx, schema.supportCases, schema.supportCases.id, schema.supportCases.subject, r.supportCaseId) ?? "—")],
    ],
    letter: String(r.content ?? ""),
    thread: thread(tx, "SupportCase", r.supportCaseId as number, process.env.INCOMING_SUPPORT_ADDRESS),
  }),
};

/** The entries of smithable.yml's outgoing section, with their texts. */
const ENTRIES: {
  name: string;
  model: string;
  when: string;
  fits?: (r: Row) => boolean;
  /** For a change: only one of these fields changing counts. */
  fields?: string[];
  subject?: string;
  text?: string;
  to?: (tx: Tx, r: Row) => Recipient[];
}[] = [
  {
    name: "caseReceived",
    model: "SupportCase",
    when: "created",
    to: (_tx, r) => [{ email: r.customerEmail as string | null }],
  },
  {
    name: "replySent",
    model: "Message",
    when: "created",
    fits: (r) => r.sender === "agent",
    to: (tx, r) => [{ email: one(tx, schema.supportCases, schema.supportCases.id, schema.supportCases.customerEmail, r.supportCaseId) as string | null }],
  },
];

/**
 * Queues what a change asks for, in its transaction: \`what\` is created, changed, deleted or the
 * action's name; \`record\` the record after (a deleted one as it was), \`before\` before a change.
 */
export function outgoing(tx: Tx, viewer: Viewer | null, model: string, what: string, record: Row, before?: Row): void {
  if (arriving.getStore()?.quiet) return;
  for (const entry of ENTRIES) {
    if (entry.model !== model || !counts(entry.when, what, entry.fits, record, before, entry.fields)) continue;
    const shown = SHOWN[model]?.(tx, record);
    if (!shown || !entry.to) continue;
    queueMail(
      tx,
      viewer,
      { ...shown, ...(entry.subject ? { subject: entry.subject } : {}), ...(entry.text ? { text: entry.text } : {}), entry: entry.name, model, record: record.id as number },
      entry.to(tx, record),
      entry.when === "created",
    );
  }
}
"
`;

