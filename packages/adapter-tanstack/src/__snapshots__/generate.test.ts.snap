"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { z } from "zod";
import type * as schema from "#/db/schema";
import { allows, type Rule } from "#/kit/access";
import type { RecordUi } from "#/kit/model";
import { bindPicture } from "#/kit/PictureInput";
import { dishAccess, dishData } from "./dish.server";
import { writeAllowed } from "#/kit/limit";
import { currentViewer } from "#/lib/viewer.server";
import { dishSchema } from "./dish.schema";

export type { DishSettable, DishValues } from "./dish.schema";

/** The viewer about to write, counted against how often one may (see src/kit/limit.ts). */
async function writer() {
  const viewer = await currentViewer();
  writeAllowed(viewer, getRequestHeaders());
  return viewer;
}

/** Dish records as the kit reads them. */
export type DishRow = typeof schema.dishes.$inferSelect;

export const dishUi: RecordUi<DishRow> = {
  model: "Dish",
  label: "Dish",
  pluralLabel: "Dishes",
  titleField: "name",
  descriptionField: "description",
  columns: ["name", "picture", "price", "section", "diet"],
  fields: [
    {
      name: "name",
      label: "Name",
      kind: "string",
      required: true,
      get: (row) => row.name,
    },
    {
      name: "description",
      label: "Description",
      kind: "text",
      required: false,
      get: (row) => row.description,
    },
    {
      name: "price",
      label: "Price",
      kind: "money",
      required: true,
      get: (row) => row.price,
    },
    {
      name: "section",
      label: "Section",
      kind: "choice",
      required: true,
      choices: [
        { value: "starters", label: "Starters" },
        { value: "mains", label: "Mains" },
        { value: "drinks", label: "Drinks" },
        { value: "sweets", label: "Sweets" },
      ],
      default: "starters",
      get: (row) => row.section,
    },
    {
      name: "picture",
      label: "Picture",
      kind: "picture",
      required: false,
      input: bindPicture("dish", "picture"),
      get: (row) => row.picture,
    },
    {
      name: "diet",
      label: "Diet",
      kind: "choice",
      required: true,
      choices: [
        { value: "none", label: "None" },
        { value: "vegetarian", label: "Vegetarian" },
        { value: "vegan", label: "Vegan" },
      ],
      default: "none",
      get: (row) => row.diet,
    },
    {
      name: "allergens",
      label: "Allergens",
      kind: "string",
      required: false,
      get: (row) => row.allergens,
    },
    {
      name: "available",
      label: "Available",
      kind: "bool",
      required: false,
      default: true,
      get: (row) => row.available,
    },
  ],
};

/** Who may delete dishes: a list's selection offers Delete by it (the server checks again). */
export const dishDeleteRule: Rule = { public: false, roles: ["admin"], owner: true };


export const listDishes = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return { rows: await dishData.list(viewer), canCreate: allows(dishAccess.create, viewer) };
});

export const getDish = createServerFn()
  .validator(z.number().int())
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    const row = await dishData.get(viewer, id);
    if (!row) return null;
    return {
      row,
      canWrite: allows(dishAccess.write, viewer, row.ownerId),
      canDelete: allows(dishAccess.delete, viewer, row.ownerId),
    };
  });

/** Choices for fields that refer to a dish. */
export const dishOptions = createServerFn().handler(async () =>
  dishData.options(await currentViewer()),
);

export const createDish = createServerFn({ method: "POST" })
  .validator(dishSchema)
  .handler(async ({ data }) => dishData.create(await writer(), data));

export const updateDish = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), values: dishSchema }))
  .handler(async ({ data }) => dishData.update(await writer(), data.id, data.values));

/** Deletes a dish; \`together\` takes what points to it along (docs/design/delete-together.md). */
export const deleteDish = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), together: z.boolean().optional() }))
  .handler(async ({ data }) => dishData.remove(await writer(), data.id, data.together));

/** Deletes the chosen dishes, all or none (at most 1,000 at once). */
export const deleteDishes = createServerFn({ method: "POST" })
  .validator(z.object({ ids: z.array(z.number().int()).max(1000), together: z.boolean().optional() }))
  .handler(async ({ data }) => dishData.removeMany(await writer(), data.ids, data.together));
"
`;

exports[`../../../examples/kiosk/smithable.yml > file list and generated code > src/generated/hooks.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// Where the app reacts to changes: after a record is created, changed or deleted, and once a
// day. Your reactions go in src/custom/hooks.ts (send an email, update another record, call a
// service); a plugin's in its own hooks file. A hook runs on the server, in the request that
// made the change and with the viewer who made it, after the change is saved; a hook that
// throws fails that request. Daily jobs run in production, a day after the server started.
import type * as schema from "#/db/schema";
import type { Viewer } from "#/kit/access";
import { log } from "#/kit/log.server";
import * as custom from "#/custom/hooks";

export type Hook<Row> = (row: Row, viewer: Viewer | null) => void | Promise<void>;

/** Each model's record as it is stored. */
export interface Rows {
  Dish: typeof schema.dishes.$inferSelect;
  Order: typeof schema.orders.$inferSelect;
  OrderLine: typeof schema.orderLines.$inferSelect;
  Stop: typeof schema.stops.$inferSelect;
}

export interface Hooks {
  /** After a record is created, by model. */
  afterCreate?: { [M in keyof Rows]?: Hook<Rows[M]> };
  /** After a record is changed, with its new values. */
  afterUpdate?: { [M in keyof Rows]?: Hook<Rows[M]> };
  /** After a record is deleted; only its id is left. */
  afterDelete?: { [M in keyof Rows]?: Hook<{ id: number }> };
  /** Once a day. */
  daily?: (() => void | Promise<void>)[];
}

// Read when a hook runs, not when this module loads: custom code may import the data functions,
// which import this file.
const sources = (): Hooks[] => [custom.hooks];

export async function afterChange<M extends keyof Rows>(
  event: "afterCreate" | "afterUpdate",
  model: M,
  row: Rows[M],
  viewer: Viewer | null,
): Promise<void> {
  for (const source of sources()) {
    // One model's hook at a time: TypeScript cannot narrow the lookup by a generic key.
    const hook = source[event]?.[model] as Hook<Rows[M]> | undefined;
    await hook?.(row, viewer);
  }
}

export async function afterDelete<M extends keyof Rows>(
  model: M,
  id: number,
  viewer: Viewer | null,
): Promise<void> {
  for (const source of sources()) {
    const hook = source.afterDelete?.[model] as Hook<{ id: number }> | undefined;
    await hook?.({ id }, viewer);
  }
}

/** Every daily job, in order; a failing one is reported and the rest still run. */
export async function runDaily(): Promise<void> {
  for (const source of sources())
    for (const job of source.daily ?? []) {
      try {
        await job();
      } catch (error) {
        log.error("A daily job failed", { error });
      }
    }
}

// In production, once a day, starting a day after the server started (pnpm start). The timer
// never keeps the process alive by itself, so the server still stops when asked to.
if (import.meta.env.SSR && import.meta.env.PROD) {
  const day = 24 * 60 * 60 * 1000;
  const tick = () => setTimeout(() => runDaily().finally(tick), day).unref();
  tick();
}
"
`;

