exports[`../../../examples/booking/smithable.yml > file list and generated code > src/db/schema.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { relations } from "drizzle-orm";
import { index, integer, sqliteTable, text, unique, uniqueIndex } from "drizzle-orm/sqlite-core";
import type { Picture } from "#/kit/uploads";

export const user = sqliteTable("user", {
  id: text().primaryKey(),
  name: text().notNull(),
  email: text().notNull().unique(),
  emailVerified: integer({ mode: "boolean" }).default(false).notNull(),
  image: text(),
  role: text().notNull().default("member"),
  createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
  updatedAt: integer({ mode: "timestamp_ms" })
    .notNull()
    .$defaultFn(() => new Date())
    .$onUpdate(() => new Date()),
});

export const session = sqliteTable(
  "session",
  {
    id: text().primaryKey(),
    expiresAt: integer({ mode: "timestamp_ms" }).notNull(),
    token: text().notNull().unique(),
    createdAt: integer({ mode: "timestamp_ms" }).notNull(),
    updatedAt: integer({ mode: "timestamp_ms" }).notNull(),
    ipAddress: text(),
    userAgent: text(),
    userId: text()
      .notNull()
      .references(() => user.id, { onDelete: "cascade" }),
  },
  (t) => [index("session_user_id_idx").on(t.userId)],
);

export const account = sqliteTable(
  "account",
  {
    id: text().primaryKey(),
    accountId: text().notNull(),
    providerId: text().notNull(),
    userId: text()
      .notNull()
      .references(() => user.id, { onDelete: "cascade" }),
    accessToken: text(),
    refreshToken: text(),
    idToken: text(),
    accessTokenExpiresAt: integer({ mode: "timestamp_ms" }),
    refreshTokenExpiresAt: integer({ mode: "timestamp_ms" }),
    scope: text(),
    password: text(),
    createdAt: integer({ mode: "timestamp_ms" }).notNull(),
    updatedAt: integer({ mode: "timestamp_ms" }).notNull(),
  },
  (t) => [index("account_user_id_idx").on(t.userId)],
);

export const verification = sqliteTable(
  "verification",
  {
    id: text().primaryKey(),
    identifier: text().notNull(),
    value: text().notNull(),
    expiresAt: integer({ mode: "timestamp_ms" }).notNull(),
    createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
    updatedAt: integer({ mode: "timestamp_ms" })
      .notNull()
      .$defaultFn(() => new Date())
      .$onUpdate(() => new Date()),
  },
  (t) => [index("verification_identifier_idx").on(t.identifier)],
);

export const auditLog = sqliteTable(
  "audit_log",
  {
    id: integer().primaryKey({ autoIncrement: true }),
    at: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
    trace: text(),
    /** A user's id, a key's name, "visitor", or "the app" for its own work. */
    who: text().notNull(),
    role: text(),
    address: text(),
    browser: text(),
    /** created, changed, deleted, copied, or an action's name. */
    action: text().notNull(),
    model: text(),
    recordId: integer(),
    title: text(),
    fields: text({ mode: "json" }).$type<string[]>(),
    details: text({ mode: "json" }).$type<Record<string, unknown>>(),
  },
  (t) => [index("audit_log_at").on(t.at), index("audit_log_record").on(t.model, t.recordId)],
);

export const uploads = sqliteTable(
  "uploads",
  {
    id: integer().primaryKey({ autoIncrement: true }),
    /** The stored file's name under uploads/ (src/kit/uploads.ts). */
    file: text().notNull(),
    model: text().notNull(),
    field: text().notNull(),
    /** Who uploaded it; nothing for a visitor. */
    uploader: text(),
    receipt: text().notNull(),
    at: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
  },
  (t) => [index("uploads_receipt").on(t.receipt), index("uploads_at").on(t.at)],
);

export const outgoingMail = sqliteTable(
  "outgoing_mail",
  {
    id: integer().primaryKey({ autoIncrement: true }),
    createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
    /** The outgoing entry's name in smithable.yml. */
    entry: text().notNull(),
    model: text().notNull(),
    recordId: integer().notNull(),
    to: text().notNull(),
    subject: text().notNull(),
    text: text().notNull(),
    /** A thread mail's headers (docs/design/mail-threads.md §4): its own id, what it answers, the thread. */
    messageId: text(),
    inReplyTo: text(),
    references: text(),
    replyTo: text(),
    tries: integer().notNull().default(0),
    nextAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
    sentAt: integer({ mode: "timestamp_ms" }),
    /** Given up after a day of tries; "Send again" in Activity clears it. */
    failedAt: integer({ mode: "timestamp_ms" }),
    error: text(),
  },
  (t) => [index("outgoing_mail_due").on(t.sentAt, t.failedAt, t.nextAt)],
);

export const outgoingCall = sqliteTable(
  "outgoing_call",
  {
    id: integer().primaryKey({ autoIncrement: true }),
    createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
    entry: text().notNull(),
    model: text().notNull(),
    recordId: integer().notNull(),
    /** The target's name; its address and secret are OUTGOING_<TARGET>_URL and _SECRET. */
    target: text().notNull(),
    body: text().notNull(),
    tries: integer().notNull().default(0),
    nextAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
    sentAt: integer({ mode: "timestamp_ms" }),
    failedAt: integer({ mode: "timestamp_ms" }),
    /** The answer's status, or why there was none. */
    status: integer(),
    error: text(),
  },
  (t) => [index("outgoing_call_due").on(t.sentAt, t.failedAt, t.nextAt)],
);

export const timerRuns = sqliteTable(
  "timer_runs",
  {
    id: integer().primaryKey({ autoIncrement: true }),
    timer: text().notNull(),
    record: integer().notNull(),
    due: text().notNull(),
    ranAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
    /** running, done, skipped, gone, failed, given up; seen for a timer's first sighting. */
    outcome: text().notNull(),
    tries: integer().notNull().default(0),
  },
  (t) => [uniqueIndex("timer_runs_once").on(t.timer, t.record, t.due)],
);

export const classTypes = sqliteTable("class_types", {
  id: integer().primaryKey({ autoIncrement: true }),
  name: text().notNull(),
  summary: text(),
  level: text({ enum: ["beginner", "allLevels", "advanced"] }).notNull().default("allLevels"),
  durationMinutes: integer().notNull().default(60),
  ownerId: text().references(() => user.id, { onDelete: "set null" }),
  createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
  updatedAt: integer({ mode: "timestamp_ms" })
    .notNull()
    .$defaultFn(() => new Date())
    .$onUpdate(() => new Date()),
});

export const instructors = sqliteTable("instructors", {
  id: integer().primaryKey({ autoIncrement: true }),
  name: text().notNull(),
  bio: text(),
  portrait: text({ mode: "json" }).$type<Picture>(),
  ownerId: text().references(() => user.id, { onDelete: "set null" }),
  createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
  updatedAt: integer({ mode: "timestamp_ms" })
    .notNull()
    .$defaultFn(() => new Date())
    .$onUpdate(() => new Date()),
});

export const sessions = sqliteTable("sessions", {
  id: integer().primaryKey({ autoIncrement: true }),
  classTypeId: integer().notNull().references(() => classTypes.id, { onDelete: "restrict" }),
  instructorId: integer().notNull().references(() => instructors.id, { onDelete: "restrict" }),
  startsAt: integer({ mode: "timestamp_ms" }).notNull(),
  capacity: integer().notNull().default(12),
  placesLeft: integer(),
  ownerId: text().references(() => user.id, { onDelete: "set null" }),
  createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
  updatedAt: integer({ mode: "timestamp_ms" })
    .notNull()
    .$defaultFn(() => new Date())
    .$onUpdate(() => new Date()),
});

// Values unique per owner are unique among one owner's records (docs/design/uniqueness.md).
export const bookings = sqliteTable(
  "bookings",
  {
    id: integer().primaryKey({ autoIncrement: true }),
    sessionId: integer().notNull().references(() => sessions.id, { onDelete: "restrict" }),
    attendeeId: text().references(() => user.id, { onDelete: "set null" }),
    createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
    updatedAt: integer({ mode: "timestamp_ms" })
      .notNull()
      .$defaultFn(() => new Date())
      .$onUpdate(() => new Date()),
  },
  (t) => [unique().on(t.attendeeId, t.sessionId)],
);

export const posts = sqliteTable("posts", {
  id: integer().primaryKey({ autoIncrement: true }),
  title: text().notNull(),
  address: text().unique(),
  summary: text(),
  cover: text({ mode: "json" }).$type<Picture>(),
  body: text().notNull(),
  publishedOn: text(),
  status: text({ enum: ["draft", "published"] }).notNull().default("draft"),
  ownerId: text().references(() => user.id, { onDelete: "set null" }),
  createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
  updatedAt: integer({ mode: "timestamp_ms" })
    .notNull()
    .$defaultFn(() => new Date())
    .$onUpdate(() => new Date()),
});

export const messages = sqliteTable("messages", {
  id: integer().primaryKey({ autoIncrement: true }),
  name: text().notNull(),
  email: text().notNull(),
  message: text().notNull(),
  ownerId: text().references(() => user.id, { onDelete: "set null" }),
  createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
  updatedAt: integer({ mode: "timestamp_ms" })
    .notNull()
    .$defaultFn(() => new Date())
    .$onUpdate(() => new Date()),
});

export const classTypesRelations = relations(classTypes, ({ many }) => ({
  sessions: many(sessions),
}));

export const instructorsRelations = relations(instructors, ({ many }) => ({
  sessions: many(sessions),
}));

export const sessionsRelations = relations(sessions, ({ one, many }) => ({
  classType: one(classTypes, { fields: [sessions.classTypeId], references: [classTypes.id] }),
  instructor: one(instructors, { fields: [sessions.instructorId], references: [instructors.id] }),
  bookings: many(bookings),
}));

export const bookingsRelations = relations(bookings, ({ one }) => ({
  session: one(sessions, { fields: [bookings.sessionId], references: [sessions.id] }),
  attendee: one(user, { fields: [bookings.attendeeId], references: [user.id] }),
}));
"
`;

