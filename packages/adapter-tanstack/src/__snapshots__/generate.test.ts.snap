"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// Sample data for development. Run with \`pnpm db:seed\`; tables that already have rows are left alone.
import { db } from "./index";
import { classTypes, instructors, sessions } from "./schema";

if (db.select().from(classTypes).limit(1).all().length === 0) {
  db.insert(classTypes)
    .values([
    { name: "Class type 1", summary: "Prefers email over phone calls.", level: "beginner", durationMinutes: 45 },
    { name: "Class type 2", summary: "Follow up after the summer break.", level: "allLevels", durationMinutes: 60 },
    { name: "Class type 3", summary: "Long-standing relationship, very reliable.", level: "advanced", durationMinutes: 75 },
    { name: "Class type 4", summary: "Interested in the premium offering.", level: "beginner", durationMinutes: 90 },
    { name: "Class type 5", summary: "Asked for a quote in the spring.", level: "allLevels", durationMinutes: 45 },
    { name: "Class type 6", summary: "Recommended to us by a partner.", level: "advanced", durationMinutes: 60 },
    { name: "Class type 7", summary: "Needs invoices in English.", level: "beginner", durationMinutes: 75 },
    { name: "Class type 8", summary: "Visited our office in August.", level: "allLevels", durationMinutes: 90 },
    ])
    .run();
}

if (db.select().from(instructors).limit(1).all().length === 0) {
  db.insert(instructors)
    .values([
    { name: "Emma Lindqvist", bio: "Prefers email over phone calls." },
    { name: "Oskar Nieminen", bio: "Follow up after the summer break." },
    { name: "Sofia Andersson", bio: "Long-standing relationship, very reliable." },
    { name: "Leo Virtanen", bio: "Interested in the premium offering." },
    { name: "Aino Karlsson", bio: "Asked for a quote in the spring." },
    { name: "Elias Johansson", bio: "Recommended to us by a partner." },
    { name: "Maja Korhonen", bio: "Needs invoices in English." },
    { name: "William Berg", bio: "Visited our office in August." },
    ])
    .run();
}

if (db.select().from(sessions).limit(1).all().length === 0) {
  db.insert(sessions)
    .values([
    { startsAt: new Date("2026-09-01T08:00:00.000Z"), capacity: 8 },
    { startsAt: new Date("2026-09-02T10:00:00.000Z"), capacity: 12 },
    { startsAt: new Date("2026-09-03T12:00:00.000Z"), capacity: 16 },
    { startsAt: new Date("2026-09-04T08:00:00.000Z"), capacity: 8 },
    { startsAt: new Date("2026-09-05T10:00:00.000Z"), capacity: 12 },
    { startsAt: new Date("2026-09-06T12:00:00.000Z"), capacity: 16 },
    { startsAt: new Date("2026-09-07T08:00:00.000Z"), capacity: 8 },
    { startsAt: new Date("2026-09-08T10:00:00.000Z"), capacity: 12 },
    ])
    .run();
}
"
`;

