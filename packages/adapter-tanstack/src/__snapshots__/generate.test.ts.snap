"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import type { Rule } from "#/kit/access";
import { app } from "#/generated/app";

/** Who may open each page. */
export const pageAccess = {
  customers: { public: false, roles: ["admin", "sales"], owner: false },
  orders: { public: false, roles: ["admin", "sales"], owner: false },
  team: { public: false, roles: ["admin"], owner: false },
} satisfies Record<string, Rule>;

interface PageUi {
  title: string;
  subtitle?: string;
  description?: string;
}

/** Each page's words: the menus, its header and its tab read them here. */
export const pageUi = {
  customers: { title: "Customers" },
  orders: { title: "Orders" },
  team: { title: "Team" },
} satisfies Record<string, PageUi>;

/** A route's head: the tab's title ("<page> · <app>", the page at / the app's name alone), and the description search engines show. */
export function pageHead(page: keyof typeof pageUi) {
  const ui: PageUi = pageUi[page];
  const title = \`\${ui.title} · \${app.name}\`;
  const described = ui.description ? [{ name: "description", content: ui.description }] : [];
  return { meta: [{ title }, ...described] };
}
"
`;

