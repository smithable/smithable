"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { and, asc, count, eq, inArray, sql, type SQL } from "drizzle-orm";
import { db } from "#/db";
import * as schema from "#/db/schema";
import { AccessDenied, allows, check, Conflict, type ModelAccess, personOf, readScope, type Viewer } from "#/kit/access";
import { audit, changedFields } from "#/kit/audit.server";
import { refusal } from "#/kit/log.server";
import { contains } from "#/kit/search";
import { afterChange, afterDelete } from "./hooks";
import { appointmentUi } from "./appointment";
import { serviceUi, type ServiceSettable } from "./service";

/** A transaction, as the group's functions are called inside one (docs/design/delete-together.md). */
type Tx = Parameters<Parameters<typeof db.transaction>[0]>[0];

/**
 * What points to a service (docs/design/delete-together.md): the records that would go with it
 * to the trash, by model, and those that would show no service; nothing when nothing does.
 */
function usedBy(tx: Tx, id: number, title: string) {
  const pointing: { model: string; from: string; label: string; plural: string; depth: number; count: number | null }[] = [
    { model: "Appointment", label: appointmentUi.label, plural: appointmentUi.pluralLabel, from: "Service", depth: 1, count: tx.select({ n: count() }).from(schema.appointments).where(and(eq(schema.appointments.serviceId, id))).get()?.n ?? 0 },
  ];
  // A deeper member is named when its parent has records ("and what belongs to them").
  const with_: typeof pointing = [];
  for (const e of pointing)
    if (e.count === null ? with_.some((p) => p.model === e.from) : e.count > 0) with_.push(e);
  if (!with_.length) return undefined;
  const loose = [] as { model: string; label: string; plural: string; count: number }[];
  return { id, title, model: "Service", label: serviceUi.label, with: with_, loose, together: false, missing: [serviceUi.label, appointmentUi.label] };
}

/** Who may read, create, change and delete services. */
export const serviceAccess: ModelAccess = {
  read: { public: true, roles: ["admin"], owner: true },
  create: { public: false, roles: ["admin"], owner: false },
  write: { public: false, roles: ["admin"], owner: true },
  delete: { public: false, roles: ["admin"], owner: true },
};

/** A record as the viewer gets it: who owns it only for its owner and roles that read every record. */
function shownTo<R extends { ownerId: string | null }>(viewer: Viewer | null, row: R): R {
  if ((viewer && row.ownerId === viewer.id) || (!!viewer && (!!viewer.system || serviceAccess.read.roles.includes(viewer.role)))) return row;
  return { ...row, ownerId: null };
}



export const serviceData = {
  shownTo,
  /** The rows with each reference to a record the viewer may not read set to nothing: a related record's title is shown only to who may read it (only its id stays). */
  shownRefs<R extends Record<string, unknown>>(_viewer: Viewer | null, rows: R[]): R[] {
    return rows;
  },

  /** A condition for the services the viewer may read. */
  readable(viewer: Viewer | null) {
    const scope = readScope(serviceAccess.read, viewer);
    if (scope === "all") return undefined;
    return scope === "own" && viewer ? eq(schema.services.ownerId, viewer.id) : sql\`false\`;
  },

  canRead(viewer: Viewer | null, id: number): boolean {
    const found = db
      .select({ id: schema.services.id })
      .from(schema.services)
      .where(and(eq(schema.services.id, id), serviceData.readable(viewer)))
      .get();
    return found !== undefined;
  },

  /** The services the viewer may read; \`where\` narrows them, e.g. to a search. */
  async list(viewer: Viewer | null, where?: SQL) {
    if (readScope(serviceAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const found = serviceData.shownRefs(viewer, await db.query.services.findMany({
      where: and(serviceData.readable(viewer), where),
      orderBy: (t, { desc }) => [desc(t.id)],
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return rows;
  },

  /**
   * A page of the services the viewer may read that fit \`where\`, newest first (or in
   * \`order\`), and how many fit in all: for a list page. A page past the end is the last one.
   */
  async page(viewer: Viewer | null, where?: SQL, order?: SQL, page = 1, size = 50) {
    if (readScope(serviceAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = and(serviceData.readable(viewer), where);
    const total = db.select({ n: count() }).from(schema.services).where(condition).get()?.n ?? 0;
    const at = Math.min(Math.max(1, Math.trunc(page)), Math.max(1, Math.ceil(total / size)));
    const found = serviceData.shownRefs(viewer, await db.query.services.findMany({
      where: condition,
      orderBy: (t, { desc }) => [...(order ? [order] : []), desc(t.id)],
      limit: size,
      offset: (at - 1) * size,
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return { rows: rows, total, page: at, size };
  },

  async get(viewer: Viewer | null, id: number) {
    const fetched = await db.query.services.findFirst({
      where: and(eq(schema.services.id, id), serviceData.readable(viewer)),
    });
    const found = fetched && serviceData.shownRefs(viewer, [fetched])[0];
    const row = found && shownTo(viewer, found);
    return row ? row : null;
  },

  async create(viewer: Viewer | null, values: ServiceSettable) {
    check(serviceAccess.create, viewer);
    let row: typeof schema.services.$inferSelect;
    try {
      row = db.transaction((tx) => {
        const made = tx.insert(schema.services).values({ ...values, ownerId: personOf(viewer) }).returning().get();
        audit(tx, viewer, { action: "created", model: "Service", record: made.id });
        return made;
      });
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterCreate", "Service", row, viewer);
    return row;
  },

  /** Changes the record; \`what\` names the change in the audit log (an action's name). */
  /** Changes the fields given; what names the action ("changed" for a form), frees the fields it may change although locked (its own set). */
  async update(viewer: Viewer | null, id: number, values: Partial<ServiceSettable>, what = "changed", _frees: readonly string[] = []) {
    const row = db
      .select({ ownerId: schema.services.ownerId })
      .from(schema.services)
      .where(and(eq(schema.services.id, id), serviceData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    // A form's change needs write on the record; an action (what names it) checked its own access
    // first, which includes the roles its grant names (docs/design/actions.md, Access).
    if (what === "changed") check(serviceAccess.write, viewer, row.ownerId);
    let changed: typeof schema.services.$inferSelect;
    const updated = values;
    try {
      changed = db.transaction((tx) => {
        // Read again in the change itself: a record that left the viewer's reach meanwhile is refused.
        const before = tx.select().from(schema.services).where(and(eq(schema.services.id, id), serviceData.readable(viewer))).get();
        if (!before) throw new AccessDenied(viewer !== null);
        const after = tx.update(schema.services).set(updated).where(eq(schema.services.id, id)).returning().get();
        audit(tx, viewer, { action: what, model: "Service", record: id, fields: before && changedFields(before, after, Object.keys(updated)) });
        return after;
      });
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterUpdate", "Service", changed, viewer);
    return changed;
  },

  /** Deletes the record; \`together\` takes the records that point to it along to the trash (delete-together.md). */
  async remove(viewer: Viewer | null, id: number, _together = false): Promise<void> {
    const row = db
      .select({ name: schema.services.name, ownerId: schema.services.ownerId })
      .from(schema.services)
      .where(and(eq(schema.services.id, id), serviceData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(serviceAccess.delete, viewer, row.ownerId);
    try {
      db.transaction((tx) => {
        // Read again in the change itself: a record that left the viewer's reach meanwhile is refused.
        if (!tx.select({ id: schema.services.id }).from(schema.services).where(and(eq(schema.services.id, id), serviceData.readable(viewer))).get())
          throw new AccessDenied(viewer !== null);
        const used = usedBy(tx, id, String(row.name ?? id));
        if (used) throw new Conflict(\`in-use:\${JSON.stringify(used)}\`);
        const gone = tx.delete(schema.services).where(eq(schema.services.id, id)).returning().get();
        if (gone) {
          audit(tx, viewer, { action: "deleted", model: "Service", record: id, title: gone.name });
        }
      });
    } catch (error) {
      throw refusal(error);
    }
    await afterDelete("Service", id, viewer);
  },

  /**
   * Deletes the chosen records the viewer may delete, all or none (one still in use stops them
   * all, and is named); the others are skipped.
   */
  async removeMany(viewer: Viewer | null, ids: number[], _together = false): Promise<{ deleted: number; skipped: number }> {
    const rows = db
      .select({ id: schema.services.id, name: schema.services.name, ownerId: schema.services.ownerId })
      .from(schema.services)
      .where(and(inArray(schema.services.id, ids), serviceData.readable(viewer)))
      .all()
      .filter((row) => allows(serviceAccess.delete, viewer, row.ownerId));
    db.transaction((tx) => {
      for (const row of rows)
        try {
          const used = usedBy(tx, row.id, String(row.name ?? row.id));
          if (used) throw new Conflict(\`in-use:\${JSON.stringify(used)}\`);
          const gone = tx.delete(schema.services).where(eq(schema.services.id, row.id)).returning().get();
          if (gone) {
            audit(tx, viewer, { action: "deleted", model: "Service", record: row.id, title: gone.name });
          }
        } catch (error) {
          const refused = refusal(error);
          throw refused instanceof Conflict && refused.message === "in-use" ? new Conflict(\`in-use:\${row.id}\`) : refused;
        }
    });
    for (const row of rows) {
      await afterDelete("Service", row.id, viewer);
    }
    return { deleted: rows.length, skipped: new Set(ids).size - rows.length };
  },

  /**
   * The services the viewer may read whose name contains the text: a search of records that
   * refer to them finds them only among these.
   */
  titled(viewer: Viewer | null, text: string): number[] {
    return db
      .select({ id: schema.services.id })
      .from(schema.services)
      .where(and(contains([schema.services.name], text), serviceData.readable(viewer)))
      .all()
      .map((row) => row.id);
  },

  /** Choices for fields that refer to a service: the ones the viewer may read. */
  options(viewer: Viewer | null) {
    if (readScope(serviceAccess.read, viewer) === "none") return [];
    return db
      .select({ value: schema.services.id, label: schema.services.name })
      .from(schema.services)
      .where(serviceData.readable(viewer))
      .orderBy(asc(schema.services.name))
      .all();
  },
};
"
`;

exports[`../../../examples/barbers/smithable.yml > file list and generated code > src/generated/service.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { z } from "zod";
import type * as schema from "#/db/schema";
import { allows, type Rule } from "#/kit/access";
import type { RecordUi } from "#/kit/model";
import { serviceAccess, serviceData } from "./service.server";
import { writeAllowed } from "#/kit/limit";
import { currentViewer } from "#/lib/viewer.server";
import { serviceSchema } from "./service.schema";

export type { ServiceSettable, ServiceValues } from "./service.schema";

/** The viewer about to write, counted against how often one may (see src/kit/limit.ts). */
async function writer() {
  const viewer = await currentViewer();
  writeAllowed(viewer, getRequestHeaders());
  return viewer;
}

/** Service records as the kit reads them. */
export type ServiceRow = typeof schema.services.$inferSelect;

export const serviceUi: RecordUi<ServiceRow> = {
  model: "Service",
  label: "Service",
  pluralLabel: "Services",
  titleField: "name",
  descriptionField: "summary",
  columns: ["name", "minutes", "price"],
  fields: [
    {
      name: "name",
      label: "Name",
      kind: "string",
      required: true,
      get: (row) => row.name,
    },
    {
      name: "summary",
      label: "Summary",
      kind: "text",
      required: false,
      get: (row) => row.summary,
    },
    {
      name: "minutes",
      label: "Minutes",
      kind: "int",
      required: true,
      default: 30,
      get: (row) => row.minutes,
    },
    {
      name: "price",
      label: "Price",
      kind: "money",
      required: false,
      get: (row) => row.price,
    },
  ],
};

/** Who may delete services: a list's selection offers Delete by it (the server checks again). */
export const serviceDeleteRule: Rule = { public: false, roles: ["admin"], owner: true };


export const listServices = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return { rows: await serviceData.list(viewer), canCreate: allows(serviceAccess.create, viewer) };
});

export const getService = createServerFn()
  .validator(z.number().int())
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    const row = await serviceData.get(viewer, id);
    if (!row) return null;
    return {
      row,
      canWrite: allows(serviceAccess.write, viewer, row.ownerId),
      canDelete: allows(serviceAccess.delete, viewer, row.ownerId),
    };
  });

/** Choices for fields that refer to a service. */
export const serviceOptions = createServerFn().handler(async () =>
  serviceData.options(await currentViewer()),
);

export const createService = createServerFn({ method: "POST" })
  .validator(serviceSchema)
  .handler(async ({ data }) => serviceData.create(await writer(), data));

export const updateService = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), values: serviceSchema }))
  .handler(async ({ data }) => serviceData.update(await writer(), data.id, data.values));

/** Deletes a service; \`together\` takes what points to it along (docs/design/delete-together.md). */
export const deleteService = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), together: z.boolean().optional() }))
  .handler(async ({ data }) => serviceData.remove(await writer(), data.id, data.together));

/** Deletes the chosen services, all or none (at most 1,000 at once). */
export const deleteServices = createServerFn({ method: "POST" })
  .validator(z.object({ ids: z.array(z.number().int()).max(1000), together: z.boolean().optional() }))
  .handler(async ({ data }) => serviceData.removeMany(await writer(), data.ids, data.together));
"
`;

