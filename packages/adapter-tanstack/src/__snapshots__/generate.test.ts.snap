exports[`../../../examples/api/smithable.yml > file list and generated code > src/generated/project.server.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { type AnyColumn, and, asc, avg, count, desc, eq, inArray, isNotNull, max, min, sql, sum, type SQL } from "drizzle-orm";
import { db } from "#/db";
import * as schema from "#/db/schema";
import { AccessDenied, allows, check, Conflict, type ModelAccess, personOf, readScope, type Viewer } from "#/kit/access";
import { audit, changedFields } from "#/kit/audit.server";
import { refusal } from "#/kit/log.server";
import { contains } from "#/kit/search";
import { BadInput } from "#/kit/refusal";
import { aggregate, type Filterable, sortOf, whereOf, wordsOf } from "#/kit/where";
import { afterChange, afterDelete } from "./hooks";
import { taskData } from "./task.server";
import { noteData } from "./note.server";
import type { ProjectValues } from "./project";

/** A transaction, as the group's functions are called inside one (docs/design/delete-together.md). */
type Tx = Parameters<Parameters<typeof db.transaction>[0]>[0];

/**
 * What points to a project (docs/design/delete-together.md): the records that would go with it
 * to the trash, by model, and those that would show no project; nothing when nothing does.
 */
function usedBy(tx: Tx, id: number, title: string) {
  const pointing: { model: string; from: string; label: string; plural: string; depth: number; count: number | null }[] = [
    { model: "Task", label: "Task", plural: "Tasks", from: "Project", depth: 1, count: tx.select({ n: count() }).from(schema.tasks).where(and(eq(schema.tasks.projectId, id))).get()?.n ?? 0 },
    { model: "Note", label: "Note", plural: "Notes", from: "Project", depth: 1, count: tx.select({ n: count() }).from(schema.notes).where(and(eq(schema.notes.projectId, id))).get()?.n ?? 0 },
  ];
  // A deeper member is named when its parent has records ("and what belongs to them").
  const with_: typeof pointing = [];
  for (const e of pointing)
    if (e.count === null ? with_.some((p) => p.model === e.from) : e.count > 0) with_.push(e);
  if (!with_.length) return undefined;
  const loose = [] as { model: string; label: string; plural: string; count: number }[];
  return { id, title, model: "Project", label: "Project", with: with_, loose, together: false, missing: ["Project","Task","Note"] };
}

/** Who may read, create, change and delete projects. */
export const projectAccess: ModelAccess = {
  read: { public: false, roles: ["admin", "member", "assistant"], owner: false },
  create: { public: false, roles: ["admin", "member"], owner: false },
  write: { public: false, roles: ["admin", "member"], owner: true },
  delete: { public: false, roles: ["admin", "member"], owner: true },
};

/** A record as the viewer gets it: who owns it only for its owner and roles that read every record. */
function shownTo<R extends { ownerId: string | null }>(viewer: Viewer | null, row: R): R {
  if (viewer && (row.ownerId === viewer.id || projectAccess.read.roles.includes(viewer.role))) return row;
  return { ...row, ownerId: null };
}


/** What \`where\` may name, and how: the stored fields, by kind. */
const FILTERABLE: Record<string, Filterable> = {
  name: { kind: "text", column: schema.projects.name },
  description: { kind: "text", column: schema.projects.description },
};

/** What the records can be sorted by. */
const SORTABLE = { id: schema.projects.id, name: schema.projects.name, description: schema.projects.description, createdAt: schema.projects.createdAt };

/** The number fields \`measure\` adds up; amounts are stored in cents. */
const NUMBERS: Record<string, AnyColumn> = {  };
const MONEY: string[] = [];

/** Computed number fields \`measure\` adds up from the records themselves. */
const COMPUTED: string[] = [];

/** The titles of the referenced records \`measureBy\` splits by, to name its groups. */
function titlesOf(_viewer: Viewer | null, _by: string, _ids: number[]): Map<unknown, string> {
  switch (_by) {
    default:
      return new Map();
  }
}

/** What \`measureBy\` may split by: choices, yes/no, references, and dates by month. */
const BY: string[] = [];


export const projectData = {
  shownTo,
  /** The rows with each reference to a record the viewer may not read set to nothing: a related record's title is shown only to who may read it (only its id stays). */
  shownRefs<R extends Record<string, unknown>>(_viewer: Viewer | null, rows: R[]): R[] {
    return rows;
  },

  /** A condition for the projects the viewer may read. */
  readable(viewer: Viewer | null) {
    const scope = readScope(projectAccess.read, viewer);
    if (scope === "all") return undefined;
    return scope === "own" && viewer ? eq(schema.projects.ownerId, viewer.id) : sql\`false\`;
  },

  canRead(viewer: Viewer | null, id: number): boolean {
    const found = db
      .select({ id: schema.projects.id })
      .from(schema.projects)
      .where(and(eq(schema.projects.id, id), projectData.readable(viewer)))
      .get();
    return found !== undefined;
  },

  /** The projects the viewer may read; \`where\` narrows them, e.g. to a search; \`limit\` keeps the newest (a data page). */
  async list(viewer: Viewer | null, where?: SQL, limit?: number) {
    if (readScope(projectAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const found = projectData.shownRefs(viewer, await db.query.projects.findMany({
      where: and(projectData.readable(viewer), where),
      orderBy: (t, { desc }) => [desc(t.id)],
      limit,
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return rows;
  },

  /**
   * The projects the viewer may read that fit \`where\` and \`search\`, in \`sort\`'s order (else newest
   * first), a page of them and how many there are: for the API and the assistants' tools.
   */
  async find(
    viewer: Viewer | null,
    options: { where?: unknown; search?: string; sort?: string; limit?: number; offset?: number } = {},
  ) {
    if (readScope(projectAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = projectData.fitting(viewer, options.where, options.search);
    const order = sortOf(SORTABLE, options.sort);
    const total = db.select({ n: count() }).from(schema.projects).where(condition).get()?.n ?? 0;
    const found = projectData.shownRefs(viewer, await db.query.projects.findMany({
      where: condition,
      orderBy: (t, { desc }) => [...(order ? [order] : []), desc(t.id)],
      limit: options.limit ?? 100,
      offset: options.offset ?? 0,
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return { items: rows, total };
  },

  /**
   * A number from the projects the viewer may read that fit \`where\`: how many, or the sum,
   * average, smallest or largest of a number field.
   */
  async measure(
    viewer: Viewer | null,
    how: "count" | "sum" | "average" | "smallest" | "largest",
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<number | null> {
    if (readScope(projectAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = projectData.fitting(viewer, options.where, options.search);
    if (how === "count")
      return db.select({ n: count() }).from(schema.projects).where(condition).get()?.n ?? 0;
    const field = options.field ?? "";
    const money = MONEY.includes(field);
    if (COMPUTED.includes(field)) {
      const rows = await projectData.computedRows(condition);
      const value = aggregate(rows.map((row) => row[field]), how);
      return value === null ? null : money ? value / 100 : value;
    }
    const column = NUMBERS[field];
    if (!column)
      throw new BadInput(
        \`\${how} needs a number field: \${[...Object.keys(NUMBERS), ...COMPUTED].join(", ") || "there are none"}.\`,
      );
    const pick = { sum, average: avg, smallest: min, largest: max }[how];
    const value = db.select({ v: pick(column) }).from(schema.projects).where(condition).get()?.v;
    if (value === null || value === undefined) return null;
    return money ? Number(value) / 100 : Number(value);
  },

  /** Which record holds the smallest or largest value of a number field (the first of a tie). */
  async holder(
    viewer: Viewer | null,
    how: "smallest" | "largest",
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<{ id: number; title: string } | null> {
    const condition = projectData.fitting(viewer, options.where, options.search);
    const field = options.field ?? "";
    if (COMPUTED.includes(field)) {
      let best: Record<string, unknown> | undefined;
      for (const row of await projectData.computedRows(condition)) {
        const v = row[field];
        if (typeof v !== "number") continue;
        if (!best || (how === "largest" ? v > (best[field] as number) : v < (best[field] as number))) best = row;
      }
      return best ? { id: best.id as number, title: String(best.name) } : null;
    }
    const column = NUMBERS[field];
    if (!column) return null;
    const row = db
      .select({ id: schema.projects.id, title: schema.projects.name })
      .from(schema.projects)
      .where(and(condition, isNotNull(column)))
      .orderBy(how === "largest" ? desc(column) : asc(column), asc(schema.projects.id))
      .limit(1)
      .get();
    return row ? { id: row.id, title: String(row.title) } : null;
  },

  /**
   * The same number per value of a field (a choice, yes/no, a reference) or per month of a date:
   * \`[{ value, number }]\`, the most first.
   */
  async measureBy(
    viewer: Viewer | null,
    how: "count" | "sum" | "average" | "smallest" | "largest",
    by: string,
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<{ value: unknown; title?: string; number: number | null }[]> {
    if (readScope(projectAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const split = FILTERABLE[by];
    if (!split || split.kind === "text" || split.kind === "number" || split.kind === "money")
      throw new BadInput(\`There is no field "\${by}" to split by. Fields: \${BY.join(", ")}.\`);
    const field = options.field ?? "";
    const money = MONEY.includes(field);
    const condition = projectData.fitting(viewer, options.where, options.search);
    const amount = (n: number | null) => (n === null ? null : money ? n / 100 : n);
    const most = (a: { number: number | null }, b: { number: number | null }) => (b.number ?? 0) - (a.number ?? 0);
    // A reference's groups carry the referenced record's title beside its id.
    const named = (rows: { value: unknown; number: number | null }[]) => {
      if (split.kind !== "reference") return rows;
      const titles = titlesOf(viewer, by, rows.map((r) => r.value).filter((v): v is number => typeof v === "number"));
      return rows.map((r) => (titles.has(r.value) ? { value: r.value, title: titles.get(r.value), number: r.number } : r));
    };
    if (COMPUTED.includes(field)) {
      // Each record's month or value, then the computed numbers added up per group.
      const groups = new Map<unknown, unknown[]>();
      for (const row of await projectData.computedRows(condition)) {
        const raw = row[split.kind === "reference" ? \`\${by}Id\` : by];
        const value = split.kind === "date" ? String(raw ?? "").slice(0, 7) || null : split.kind === "instant" ? (raw instanceof Date ? raw.toISOString().slice(0, 7) : null) : raw;
        groups.set(value, [...(groups.get(value) ?? []), row[field]]);
      }
      return named([...groups].map(([value, numbers]) => ({ value, number: amount(aggregate(numbers, how)) })).sort(most));
    }
    const key = split.kind === "date" ? sql<string>\`substr(\${split.column}, 1, 7)\` : split.kind === "instant" ? sql<string>\`strftime('%Y-%m', \${split.column} / 1000, 'unixepoch')\` : sql\`\${split.column}\`;
    const column = NUMBERS[field];
    if (how !== "count" && !column)
      throw new BadInput(\`\${how} needs a number field: \${[...Object.keys(NUMBERS), ...COMPUTED].join(", ") || "there are none"}.\`);
    const pick = how === "count" || !column ? count() : { sum, average: avg, smallest: min, largest: max }[how](column);
    return named(
      db
        .select({ value: key, number: pick })
        .from(schema.projects)
        .where(condition)
        .groupBy(key)
        .all()
        .map((r) => ({ value: r.value, number: r.number === null ? null : amount(Number(r.number)) }))
        .sort(most),
    );
  },

  /**
   * The records that fit, with their computed fields worked out: for adding those up. At most
   * 10,000, so one call never reads a whole large table; more are refused with how to narrow them.
   */
  async computedRows(condition: SQL | undefined): Promise<Record<string, unknown>[]> {
    const rows = await db.query.projects.findMany({ where: condition, limit: 10001 });
    if (rows.length > 10000)
      throw new BadInput("More than 10,000 records to add up a computed field over: narrow them with where.");
    return rows.map((row) => row as Record<string, unknown>);
  },

  /** The projects the viewer may read whose name has the text: a few, for naming one. */
  named(viewer: Viewer | null, text: string): { id: number; title: string }[] {
    return db
      .select({ id: schema.projects.id, title: schema.projects.name })
      .from(schema.projects)
      .where(and(projectData.readable(viewer), contains([schema.projects.name], text)))
      .limit(6)
      .all()
      .map((row) => ({ id: row.id, title: String(row.title) }));
  },

  /** The condition for records the viewer may read that fit \`where\` and \`search\`. */
  fitting(viewer: Viewer | null, where?: unknown, search?: string) {
    return and(
      projectData.readable(viewer),
      whereOf(FILTERABLE, where, viewer ? eq(schema.projects.ownerId, viewer.id) : undefined, viewer?.id, {}),
      // Every word somewhere in the texts ("ship lamp" finds "ship's lamp").
      ...wordsOf(search).map((word) => contains([schema.projects.name, schema.projects.description], word)),
    );
  },

  /** How many projects the viewer may read, for a data page's overview; none to read: null. */
  count(viewer: Viewer | null): number | null {
    if (readScope(projectAccess.read, viewer) === "none") return null;
    return db.select({ n: count() }).from(schema.projects).where(projectData.readable(viewer)).get()?.n ?? 0;
  },

  async get(viewer: Viewer | null, id: number) {
    const fetched = await db.query.projects.findFirst({
      where: and(eq(schema.projects.id, id), projectData.readable(viewer)),
      with: { tasks: { where: taskData.readable(viewer), with: { assignee: { columns: { id: true, name: true } } } }, notes: { where: noteData.readable(viewer) } },
    });
    const found = fetched && projectData.shownRefs(viewer, [{ ...fetched, tasks: taskData.shownRefs(viewer, fetched.tasks) }])[0];
    const row = found && { ...shownTo(viewer, found), tasks: found.tasks.map((r) => taskData.shownTo(viewer, r)), notes: found.notes.map((r) => noteData.shownTo(viewer, r)) };
    return row ? row : null;
  },

  async create(viewer: Viewer | null, values: ProjectValues) {
    check(projectAccess.create, viewer);
    let row: typeof schema.projects.$inferSelect;
    try {
      row = db.transaction((tx) => {
        const made = tx.insert(schema.projects).values({ ...values, ownerId: personOf(viewer) }).returning().get();
        audit(tx, viewer, { action: "created", model: "Project", record: made.id });
        return made;
      });
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterCreate", "Project", row, viewer);
    return row;
  },

  /** Changes the record; \`what\` names the change in the audit log (an action's name). */
  async update(viewer: Viewer | null, id: number, values: ProjectValues, what = "changed") {
    const row = db
      .select({ ownerId: schema.projects.ownerId })
      .from(schema.projects)
      .where(and(eq(schema.projects.id, id), projectData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(projectAccess.write, viewer, row.ownerId);
    let changed: typeof schema.projects.$inferSelect;
    const updated = values;
    try {
      changed = db.transaction((tx) => {
        const before = tx.select().from(schema.projects).where(eq(schema.projects.id, id)).get();
        const after = tx.update(schema.projects).set(updated).where(eq(schema.projects.id, id)).returning().get();
        audit(tx, viewer, { action: what, model: "Project", record: id, fields: before && changedFields(before, after, Object.keys(updated)) });
        return after;
      });
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterUpdate", "Project", changed, viewer);
    return changed;
  },

  /** Deletes the record; \`together\` takes the records that point to it along to the trash (delete-together.md). */
  async remove(viewer: Viewer | null, id: number, _together = false): Promise<void> {
    const row = db
      .select({ name: schema.projects.name, ownerId: schema.projects.ownerId })
      .from(schema.projects)
      .where(and(eq(schema.projects.id, id), projectData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(projectAccess.delete, viewer, row.ownerId);
    try {
      db.transaction((tx) => {
        const used = usedBy(tx, id, String(row.name ?? id));
        if (used) throw new Conflict(\`in-use:\${JSON.stringify(used)}\`);
        const gone = tx.delete(schema.projects).where(eq(schema.projects.id, id)).returning().get();
        if (gone) {
          audit(tx, viewer, { action: "deleted", model: "Project", record: id, title: gone.name });
        }
      });
    } catch (error) {
      throw refusal(error);
    }
    await afterDelete("Project", id, viewer);
  },

  /**
   * Deletes the chosen records the viewer may delete, all or none (one still in use stops them
   * all, and is named); the others are skipped.
   */
  async removeMany(viewer: Viewer | null, ids: number[], _together = false): Promise<{ deleted: number; skipped: number }> {
    const rows = db
      .select({ id: schema.projects.id, name: schema.projects.name, ownerId: schema.projects.ownerId })
      .from(schema.projects)
      .where(and(inArray(schema.projects.id, ids), projectData.readable(viewer)))
      .all()
      .filter((row) => allows(projectAccess.delete, viewer, row.ownerId));
    db.transaction((tx) => {
      for (const row of rows)
        try {
          const used = usedBy(tx, row.id, String(row.name ?? row.id));
          if (used) throw new Conflict(\`in-use:\${JSON.stringify(used)}\`);
          const gone = tx.delete(schema.projects).where(eq(schema.projects.id, row.id)).returning().get();
          if (gone) {
            audit(tx, viewer, { action: "deleted", model: "Project", record: row.id, title: gone.name });
          }
        } catch (error) {
          const refused = refusal(error);
          throw refused instanceof Conflict && refused.message === "in-use" ? new Conflict(\`in-use:\${row.id}\`) : refused;
        }
    });
    for (const row of rows) {
      await afterDelete("Project", row.id, viewer);
    }
    return { deleted: rows.length, skipped: new Set(ids).size - rows.length };
  },

  /**
   * The projects the viewer may read whose name contains the text: a search of records that
   * refer to them finds them only among these.
   */
  titled(viewer: Viewer | null, text: string): number[] {
    return db
      .select({ id: schema.projects.id })
      .from(schema.projects)
      .where(and(contains([schema.projects.name], text), projectData.readable(viewer)))
      .all()
      .map((row) => row.id);
  },

  /** Choices for fields that refer to a project: the ones the viewer may read. */
  options(viewer: Viewer | null) {
    if (readScope(projectAccess.read, viewer) === "none") return [];
    return db
      .select({ value: schema.projects.id, label: schema.projects.name })
      .from(schema.projects)
      .where(projectData.readable(viewer))
      .orderBy(asc(schema.projects.name))
      .all();
  },
