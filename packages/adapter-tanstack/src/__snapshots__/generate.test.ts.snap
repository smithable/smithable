describe("the confirm action", () => {
  test("admin", async () => {
    const viewer = signedIn("admin");
    const others = insertAppointment(stranger.id, {"status":"requested"});
    const own = insertAppointment(viewer.id, {"status":"requested"});
    expect({
      others: await can(() => runConfirm(viewer, others.id)),
      own: await can(() => runConfirm(viewer, own.id)),
    }).toEqual({ others: true, own: true });
  });

  test("member", async () => {
    const viewer = signedIn("member");
    const others = insertAppointment(stranger.id, {"status":"requested"});
    const othersBefore = JSON.stringify(db.select().from(schema.appointments).where(eq(schema.appointments.id, others.id)).get());
    const own = insertAppointment(viewer.id, {"status":"requested"});
    expect({
      others: await can(() => runConfirm(viewer, others.id)),
      own: await can(() => runConfirm(viewer, own.id)),
    }).toEqual({ others: false, own: true });
    expect(JSON.stringify(db.select().from(schema.appointments).where(eq(schema.appointments.id, others.id)).get())).toBe(othersBefore);
  });

  test("a visitor who has not signed in", async () => {
    const viewer = null;
    const others = insertAppointment(stranger.id, {"status":"requested"});
    const othersBefore = JSON.stringify(db.select().from(schema.appointments).where(eq(schema.appointments.id, others.id)).get());
    expect({
      others: await can(() => runConfirm(viewer, others.id)),
      own: false,
    }).toEqual({ others: false, own: false });
    expect(JSON.stringify(db.select().from(schema.appointments).where(eq(schema.appointments.id, others.id)).get())).toBe(othersBefore);
  });

  test("refused on a record where status is not requested", async () => {
    const viewer = signedIn("admin");
    const record = insertAppointment(viewer.id, {"status":"confirmed"});
    await expect(runConfirm(viewer, record.id)).rejects.toThrow("This cannot be done now.");
  });

  test("over chosen records, only those it fits and may run on change", async () => {
    const viewer = signedIn("admin");
    const fitting = insertAppointment(viewer.id, {"status":"requested"});
    const notFitting = insertAppointment(viewer.id, {"status":"confirmed"});
    const notFittingBefore = JSON.stringify(db.select().from(schema.appointments).where(eq(schema.appointments.id, notFitting.id)).get());
    expect(await runConfirmMany(viewer, [fitting.id, fitting.id, notFitting.id])).toEqual({ changed: 1, skipped: 1 });
    expect(JSON.stringify(db.select().from(schema.appointments).where(eq(schema.appointments.id, notFitting.id)).get())).toBe(notFittingBefore);
    const again = insertAppointment(viewer.id, {"status":"requested"});
    const againBefore = JSON.stringify(db.select().from(schema.appointments).where(eq(schema.appointments.id, again.id)).get());
    await runConfirmMany(null, [again.id]).catch(() => undefined);
    expect(JSON.stringify(db.select().from(schema.appointments).where(eq(schema.appointments.id, again.id)).get())).toBe(againBefore);
  });
});

