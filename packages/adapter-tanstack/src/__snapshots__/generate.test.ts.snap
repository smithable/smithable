"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { F } from "#/kit/formula";

type Row = Record<string, unknown>;

/** Computed fields of InvoiceLine, on records as stored (money in cents). */
export const invoiceLineFormulas = {
  amount: (r: Row): number => F.toCents((F.n(r.quantity) * F.fromCents(r.unitPrice))),
};

/** Values suggested when a InvoiceLine is created. */
export const invoiceLineDefaults = {

};

/** The record with its computed fields. */
export function withInvoiceLineFormulas<T extends Row>(row: T): T & { amount: number } {
  return { ...row, amount: invoiceLineFormulas.amount(row) };
}
"
