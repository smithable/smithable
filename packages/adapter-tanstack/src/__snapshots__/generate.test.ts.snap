"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// The standard actions offered on a task, for programs with a key.
import { createFileRoute } from "@tanstack/react-router";
import { taskToApi } from "#/generated/api.server";
import { runComplete } from "#/generated/actions/complete.server";
import { runReopen } from "#/generated/actions/reopen.server";
import { apiCall, NotFound } from "#/kit/api.server";

export const Route = createFileRoute("/api/v1/tasks/$id/actions/$action")({
  server: {
    handlers: {
      POST: ({ request, params }) =>
        apiCall(request, async (viewer) => {
          const id = Number(params.id);
          switch (params.action) {
            case "complete":
              return taskToApi(await runComplete(viewer, id));
            case "reopen":
              return taskToApi(await runReopen(viewer, id));
            default:
              throw new NotFound(\`There is no action "\${params.action}" here.\`);
          }
        }),
    },
  },
});
"
`;

