exports[`../../../examples/marketplace/smithable.yml > file list and generated code > src/generated/hooks.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// Where the app reacts to changes: after a record is created, changed or deleted, and once a
// day. Your reactions go in src/custom/hooks.ts (send an email, update another record, call a
// service); a plugin's in its own hooks file. A hook runs on the server, in the request that
// made the change and with the viewer who made it, after the change is saved; a hook that
// throws fails that request. Daily jobs run in production, a day after the server started.
import type * as schema from "#/db/schema";
import type { Viewer } from "#/kit/access";
import { log } from "#/kit/log.server";
import * as custom from "#/custom/hooks";

export type Hook<Row> = (row: Row, viewer: Viewer | null) => void | Promise<void>;

/** Each model's record as it is stored. */
export interface Rows {
  Item: typeof schema.items.$inferSelect;
}

export interface Hooks {
  /** After a record is created, by model. */
  afterCreate?: { [M in keyof Rows]?: Hook<Rows[M]> };
  /** After a record is changed, with its new values. */
  afterUpdate?: { [M in keyof Rows]?: Hook<Rows[M]> };
  /** After a record is deleted; only its id is left. */
  afterDelete?: { [M in keyof Rows]?: Hook<{ id: number }> };
  /** Once a day. */
  daily?: (() => void | Promise<void>)[];
}

// Read when a hook runs, not when this module loads: custom code may import the data functions,
// which import this file.
const sources = (): Hooks[] => [custom.hooks];

export async function afterChange<M extends keyof Rows>(
  event: "afterCreate" | "afterUpdate",
  model: M,
  row: Rows[M],
  viewer: Viewer | null,
): Promise<void> {
  for (const source of sources()) {
    // One model's hook at a time: TypeScript cannot narrow the lookup by a generic key.
    const hook = source[event]?.[model] as Hook<Rows[M]> | undefined;
    await hook?.(row, viewer);
  }
}

export async function afterDelete<M extends keyof Rows>(
  model: M,
  id: number,
  viewer: Viewer | null,
): Promise<void> {
  for (const source of sources()) {
    const hook = source.afterDelete?.[model] as Hook<{ id: number }> | undefined;
    await hook?.({ id }, viewer);
  }
}

/** Every daily job, in order; a failing one is reported and the rest still run. */
export async function runDaily(): Promise<void> {
  for (const source of sources())
    for (const job of source.daily ?? []) {
      try {
        await job();
      } catch (error) {
        log.error("A daily job failed", { error });
      }
    }
}

// In production, once a day, starting a day after the server started (pnpm start). The timer
// never keeps the process alive by itself, so the server still stops when asked to.
if (import.meta.env.SSR && import.meta.env.PROD) {
  const day = 24 * 60 * 60 * 1000;
  const tick = () => setTimeout(() => runDaily().finally(tick), day).unref();
  tick();
}
"
`;

exports[`../../../examples/marketplace/smithable.yml > file list and generated code > src/generated/item.schema.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createInsertSchema } from "drizzle-zod";
import { z } from "zod";
import * as schema from "#/db/schema";
import { w } from "#/kit/words";

/** What a item may be given: a form's values and what the app fills (an action's set). */
export const itemSettable = createInsertSchema(schema.items, {
  title: (s) => s.trim().min(1, w.required).max(200, w.atMostCharacters(200)),
  photos: z.array(z.object({ file: z.string().regex(/^item\\/[a-f0-9]{24}\\.webp$/), alt: z.string().trim().max(200), width: z.int().positive(), height: z.int().positive(), generated: z.literal(true).optional(), receipt: z.string().max(64).optional() })).max(10),
  description: (s) => s.trim().min(1, w.required).max(10000, w.atMostCharacters(10000)),
  place: (s) => s.max(200, w.atMostCharacters(200)),
}).omit({ id: true, ownerId: true, createdAt: true, updatedAt: true });
/** What a item's form sends, checked. */
export const itemSchema = itemSettable;

export type ItemSettable = z.output<typeof itemSettable>;
export type ItemValues = z.output<typeof itemSchema>;
"
`;

exports[`../../../examples/marketplace/smithable.yml > file list and generated code > src/generated/item.server.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { type AnyColumn, and, asc, avg, count, desc, eq, inArray, isNotNull, max, min, notExists, or, sql, sum, type SQL } from "drizzle-orm";
import { db } from "#/db";
import * as schema from "#/db/schema";
import { AccessDenied, allows, check, Conflict, type ModelAccess, personOf, readScope, type Viewer } from "#/kit/access";
import { audit, changedFields } from "#/kit/audit.server";
import { refusal } from "#/kit/log.server";
import { contains } from "#/kit/search";
import { BadInput } from "#/kit/refusal";
import { aggregate, type Filterable, nearest, sortOf, whereOf, wordsOf } from "#/kit/where";
import { deletePicture } from "#/kit/uploads";
import { acceptFiles } from "#/kit/receipts.server";
import { tellReviewers } from "#/kit/review-mail.server";
import { afterChange, afterDelete } from "./hooks";
import { type ItemSettable } from "./item";

/**
 * Each new file in a reviewed field waits for a reviewer (docs/design/file-review.md), unless a
 * reviewer sent it; a file that is replaced or removed leaves the list, and with it a rejection
 * and its reason.
 */
function queueReviews(
  tx: Parameters<Parameters<typeof db.transaction>[0]>[0],
  viewer: Viewer | null,
  recordId: number,
  before: Record<string, unknown> | undefined,
  after: Record<string, unknown>,
) {
  const files = (value: unknown) =>
    (Array.isArray(value) ? value : value ? [value] : []).map((v) => (v as { file: string }).file);
  let queued = false;
  for (const [field, key] of [["photos","photos"]] as [string, string][]) {
    const had = files(before?.[key]);
    const has = files(after[key]);
    const gone = had.filter((f) => !has.includes(f));
    if (gone.length)
      tx.delete(schema.fileReviews)
        .where(and(eq(schema.fileReviews.model, "Item"), eq(schema.fileReviews.recordId, recordId), eq(schema.fileReviews.field, field), inArray(schema.fileReviews.file, gone)))
        .run();
    if (viewer && REVIEWERS.includes(viewer.role)) continue;
    for (const file of has.filter((f) => !had.includes(f))) {
      // A new file answers what was asked: the field's rejections go (their reasons were shown
      // until now), and an earlier decision about the same file (files are named by their
      // content) is replaced.
      tx.delete(schema.fileReviews)
        .where(and(eq(schema.fileReviews.model, "Item"), eq(schema.fileReviews.recordId, recordId), eq(schema.fileReviews.field, field), or(eq(schema.fileReviews.file, file), eq(schema.fileReviews.state, "rejected"))))
        .run();
      tx.insert(schema.fileReviews)
        .values({ model: "Item", recordId, field, file, uploadedBy: viewer?.id ?? null })
        .run();
      queued = true;
    }
  }
  // The reviewers are told once the change is saved (a rolled-back one leaves nothing waiting).
  if (queued) setTimeout(() => void tellReviewers("Torget", "Item"), 0);
}

/** Who may read, create, change and delete items. */
export const itemAccess: ModelAccess = {
  read: { public: true, roles: ["admin"], owner: true },
  create: { public: false, roles: ["admin", "member"], owner: false },
  write: { public: false, roles: ["admin"], owner: true },
  delete: { public: false, roles: ["admin"], owner: true },
};
/** The roles that approve or reject items' waiting files (docs/design/file-review.md). */
export const REVIEWERS: string[] = ["admin"];

/** A record as the viewer gets it: who owns it only for its owner and roles that read every record. */
function shownTo<R extends { ownerId: string | null }>(viewer: Viewer | null, row: R): R {
  if ((viewer && row.ownerId === viewer.id) || (!!viewer && (!!viewer.system || itemAccess.read.roles.includes(viewer.role)))) return row;
  return { ...row, ownerId: null };
}


/** What \`where\` may name, and how: the stored fields, by kind. */
const FILTERABLE: Record<string, Filterable> = {
  title: { kind: "text", column: schema.items.title },
  description: { kind: "text", column: schema.items.description },
  price: { kind: "money", column: schema.items.price },
  category: { kind: "choice", column: schema.items.category, values: ["furniture","bikes","electronics","sports","kids","other"] },
  condition: { kind: "choice", column: schema.items.condition, values: ["likeNew","good","worn"] },
  place: { kind: "text", column: schema.items.place },
  available: { kind: "bool", column: schema.items.available },
};

/** What the records can be sorted by. */
const SORTABLE = { id: schema.items.id, title: schema.items.title, description: schema.items.description, price: schema.items.price, category: schema.items.category, condition: schema.items.condition, place: schema.items.place, available: schema.items.available, createdAt: schema.items.createdAt };

/** The number fields \`measure\` adds up; amounts are stored in cents. */
const NUMBERS: Record<string, AnyColumn> = { price: schema.items.price };
const MONEY: string[] = ["price"];

/** Computed number fields \`measure\` adds up from the records themselves. */
const COMPUTED: string[] = [];

/** The titles of the referenced records \`measureBy\` splits by, to name its groups. */
function titlesOf(_viewer: Viewer | null, _by: string, _ids: number[]): Map<unknown, string> {
  switch (_by) {
    default:
      return new Map();
  }
}

/** What \`measureBy\` may split by: choices, yes/no, references, and dates by month. */
const BY: string[] = ["category","condition","available"];


/** Each picture or document new to the record must come with the receipt its upload gave the viewer (src/kit/receipts.server.ts); the receipts are not kept. */
function checkFiles<V extends Partial<ItemSettable>>(viewer: Viewer | null, values: V, before?: Record<string, unknown>): V {
  return {
    ...values,
    ...("photos" in values ? { photos: acceptFiles(viewer, "item", "photos", values.photos, before?.photos) } : {}),
  };
}

export const itemData = {
  shownTo,
  /** The rows with each reference to a record the viewer may not read set to nothing: a related record's title is shown only to who may read it (only its id stays). */
  shownRefs<R extends Record<string, unknown>>(_viewer: Viewer | null, rows: R[]): R[] {
    return rows;
  },

  /** Whether a stored picture or document is on any record (the trash too): a file no record has may go. */
  uses(file: string): boolean {
    return !!db.select({ id: schema.items.id }).from(schema.items).where(sql\`\${schema.items.photos} like \${\`%"file":"\${file}"%\`}\`).get();
  },

  /** A condition for the items the viewer may read. */
  readable(viewer: Viewer | null) {
    // A record waiting for its required file to be approved is its owner's and the reviewers' only (docs/design/file-review.md).
    return and(itemData.unheld(viewer), itemData.scoped(viewer));
  },

  /** Records whose required file waits for review (or was rejected) are left out, except for their owner and the reviewers. */
  unheld(viewer: Viewer | null) {
    if (viewer && REVIEWERS.includes(viewer.role)) return undefined;
    const waiting = notExists(
      db
        .select({ id: schema.fileReviews.id })
        .from(schema.fileReviews)
        .where(
          and(
            eq(schema.fileReviews.model, "Item"),
            eq(schema.fileReviews.recordId, schema.items.id),
            inArray(schema.fileReviews.state, ["pending", "rejected"]),
            inArray(schema.fileReviews.field, ["photos"]),
          ),
        ),
    );
    return viewer ? or(waiting, eq(schema.items.ownerId, viewer.id)) : waiting;
  },

  /** The records the viewer may read by the read rule, the trashed ones too. */
  scoped(viewer: Viewer | null) {
    const scope = readScope(itemAccess.read, viewer);
    if (scope === "all") return undefined;
    return scope === "own" && viewer ? eq(schema.items.ownerId, viewer.id) : sql\`false\`;
  },

  /** The record's files waiting for review, or rejected with a reason: for its owner and the reviewers only. */
  reviewNotes(viewer: Viewer | null, id: number): { field: string; state: string; reason: string | null }[] {
    if (!viewer) return [];
    if (!REVIEWERS.includes(viewer.role)) {
      const own = db.select({ owner: schema.items.ownerId }).from(schema.items).where(eq(schema.items.id, id)).get();
      if (own?.owner !== viewer.id) return [];
    }
    return db
      .select({ field: schema.fileReviews.field, state: schema.fileReviews.state, reason: schema.fileReviews.reason })
      .from(schema.fileReviews)
      .where(and(eq(schema.fileReviews.model, "Item"), eq(schema.fileReviews.recordId, id), inArray(schema.fileReviews.state, ["pending", "rejected"])))
      .all();
  },

  canRead(viewer: Viewer | null, id: number): boolean {
    const found = db
      .select({ id: schema.items.id })
      .from(schema.items)
      .where(and(eq(schema.items.id, id), itemData.readable(viewer)))
      .get();
    return found !== undefined;
  },

  /** The items the viewer saved, by id: their own marks, never anyone else's. */
  saved(viewer: Viewer | null): number[] {
    if (!viewer) return [];
    return db
      .select({ id: schema.itemsFavorites.recordId })
      .from(schema.itemsFavorites)
      .where(eq(schema.itemsFavorites.userId, viewer.id))
      .all()
      .map((r) => r.id);
  },

  /** Saves a item the viewer may read, or unsaves it; whether it is saved now. */
  toggleSaved(viewer: Viewer | null, id: number): boolean {
    if (!viewer || !itemData.canRead(viewer, id)) throw new AccessDenied(viewer !== null);
    const mark = and(eq(schema.itemsFavorites.userId, viewer.id), eq(schema.itemsFavorites.recordId, id));
    if (db.delete(schema.itemsFavorites).where(mark).run().changes) return false;
    db.insert(schema.itemsFavorites).values({ userId: viewer.id, recordId: id }).onConflictDoNothing().run();
    return true;
  },

  /** The items the viewer may read; \`where\` narrows them, e.g. to a search; \`order\` sorts them before the newest-first rest. */
  async list(viewer: Viewer | null, where?: SQL, order?: SQL) {
    if (readScope(itemAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const found = itemData.shownRefs(viewer, await db.query.items.findMany({
      where: and(itemData.readable(viewer), where),
      orderBy: (t, { desc }) => [...(order ? [order] : []), desc(t.id)],
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return rows;
  },

  /**
   * A page of the items the viewer may read that fit \`where\`, newest first (or in
   * \`order\`), and how many fit in all: for a list page. A page past the end is the last one.
   */
  async page(viewer: Viewer | null, where?: SQL, order?: SQL, page = 1, size = 50) {
    if (readScope(itemAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = and(itemData.readable(viewer), where);
    const total = db.select({ n: count() }).from(schema.items).where(condition).get()?.n ?? 0;
    const at = Math.min(Math.max(1, Math.trunc(page)), Math.max(1, Math.ceil(total / size)));
    const found = itemData.shownRefs(viewer, await db.query.items.findMany({
      where: condition,
      orderBy: (t, { desc }) => [...(order ? [order] : []), desc(t.id)],
      limit: size,
      offset: (at - 1) * size,
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return { rows: rows, total, page: at, size };
  },

  /**
   * The items the viewer may read that fit \`where\` and \`search\`, in \`sort\`'s order (else newest
   * first), a page of them and how many there are: for the API and the assistants' tools.
   */
  async find(
    viewer: Viewer | null,
    options: { where?: unknown; search?: string; sort?: string; limit?: number; offset?: number } = {},
  ) {
    if (readScope(itemAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = itemData.fitting(viewer, options.where, options.search);
    const order = sortOf(SORTABLE, options.sort);
    const total = db.select({ n: count() }).from(schema.items).where(condition).get()?.n ?? 0;
    const found = itemData.shownRefs(viewer, await db.query.items.findMany({
      where: condition,
      orderBy: (t, { desc }) => [...(order ? [order] : []), desc(t.id)],
      limit: options.limit ?? 100,
      offset: options.offset ?? 0,
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return { items: rows, total };
  },

  /**
   * A number from the items the viewer may read that fit \`where\`: how many, or the sum,
   * average, smallest or largest of a number field.
   */
  async measure(
    viewer: Viewer | null,
    how: "count" | "sum" | "average" | "smallest" | "largest",
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<number | null> {
    if (readScope(itemAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = itemData.fitting(viewer, options.where, options.search);
    if (how === "count")
      return db.select({ n: count() }).from(schema.items).where(condition).get()?.n ?? 0;
    const field = options.field ?? "";
    const money = MONEY.includes(field);
    if (COMPUTED.includes(field)) {
      const rows = await itemData.computedRows(condition);
      const value = aggregate(rows.map((row) => row[field]), how);
      return value === null ? null : money ? value / 100 : value;
    }
    const column = Object.hasOwn(NUMBERS, field) ? NUMBERS[field] : undefined;
    if (!column)
      throw new BadInput(
        \`\${how} needs a number field: \${[...Object.keys(NUMBERS), ...COMPUTED].join(", ") || "there are none"}.\`,
      );
    const pick = { sum, average: avg, smallest: min, largest: max }[how];
    const value = db.select({ v: pick(column) }).from(schema.items).where(condition).get()?.v;
    if (value === null || value === undefined) return null;
    return money ? Number(value) / 100 : Number(value);
  },

  /** Which record holds the smallest or largest value of a number field (the first of a tie). */
  async holder(
    viewer: Viewer | null,
    how: "smallest" | "largest",
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<{ id: number; title: string } | null> {
    const condition = itemData.fitting(viewer, options.where, options.search);
    const field = options.field ?? "";
    if (COMPUTED.includes(field)) {
      let best: Record<string, unknown> | undefined;
      for (const row of await itemData.computedRows(condition)) {
        const v = row[field];
        if (typeof v !== "number") continue;
        if (!best || (how === "largest" ? v > (best[field] as number) : v < (best[field] as number))) best = row;
      }
      return best ? { id: best.id as number, title: String(best.title) } : null;
    }
    const column = Object.hasOwn(NUMBERS, field) ? NUMBERS[field] : undefined;
    if (!column) return null;
    const row = db
      .select({ id: schema.items.id, title: schema.items.title })
      .from(schema.items)
      .where(and(condition, isNotNull(column)))
      .orderBy(how === "largest" ? desc(column) : asc(column), asc(schema.items.id))
      .limit(1)
      .get();
    return row ? { id: row.id, title: String(row.title) } : null;
  },

  /**
   * The same number per value of a field (a choice, yes/no, a reference) or per month of a date:
   * \`[{ value, number }]\`, the most first.
   */
  async measureBy(
    viewer: Viewer | null,
    how: "count" | "sum" | "average" | "smallest" | "largest",
    by: string,
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<{ value: unknown; title?: string; number: number | null }[]> {
    if (readScope(itemAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const split = Object.hasOwn(FILTERABLE, by) ? FILTERABLE[by] : undefined;
    if (!split || split.kind === "text" || split.kind === "number" || split.kind === "money")
      throw new BadInput(\`There is no field "\${by}" to split by. Fields: \${BY.join(", ")}.\`);
    const field = options.field ?? "";
    const money = MONEY.includes(field);
    const condition = itemData.fitting(viewer, options.where, options.search);
    const amount = (n: number | null) => (n === null ? null : money ? n / 100 : n);
    const most = (a: { number: number | null }, b: { number: number | null }) => (b.number ?? 0) - (a.number ?? 0);
    // A reference's groups carry the referenced record's title beside its id.
    const named = (rows: { value: unknown; number: number | null }[]) => {
      if (split.kind !== "reference") return rows;
      const titles = titlesOf(viewer, by, rows.map((r) => r.value).filter((v): v is number => typeof v === "number"));
      return rows.map((r) => (titles.has(r.value) ? { value: r.value, title: titles.get(r.value), number: r.number } : r));
    };
    if (COMPUTED.includes(field)) {
      // Each record's month or value, then the computed numbers added up per group.
      const groups = new Map<unknown, unknown[]>();
      for (const row of await itemData.computedRows(condition)) {
        const raw = row[split.kind === "reference" ? \`\${by}Id\` : by];
        const value = split.kind === "date" ? String(raw ?? "").slice(0, 7) || null : split.kind === "instant" ? (raw instanceof Date ? raw.toISOString().slice(0, 7) : null) : raw;
        groups.set(value, [...(groups.get(value) ?? []), row[field]]);
      }
      return named([...groups].map(([value, numbers]) => ({ value, number: amount(aggregate(numbers, how)) })).sort(most));
    }
    const key = split.kind === "date" ? sql<string>\`substr(\${split.column}, 1, 7)\` : split.kind === "instant" ? sql<string>\`strftime('%Y-%m', \${split.column} / 1000, 'unixepoch')\` : sql\`\${split.column}\`;
    const column = Object.hasOwn(NUMBERS, field) ? NUMBERS[field] : undefined;
    if (how !== "count" && !column)
      throw new BadInput(\`\${how} needs a number field: \${[...Object.keys(NUMBERS), ...COMPUTED].join(", ") || "there are none"}.\`);
    const pick = how === "count" || !column ? count() : { sum, average: avg, smallest: min, largest: max }[how](column);
    return named(
      db
        .select({ value: key, number: pick })
        .from(schema.items)
        .where(condition)
        .groupBy(key)
        .all()
        .map((r) => ({ value: r.value, number: r.number === null ? null : amount(Number(r.number)) }))
        .sort(most),
    );
  },

  /**
   * The records that fit, with their computed fields worked out: for adding those up. At most
   * 10,000, so one call never reads a whole large table; more are refused with how to narrow them.
   */
  async computedRows(condition: SQL | undefined): Promise<Record<string, unknown>[]> {
    const rows = await db.query.items.findMany({ where: condition, limit: 10001 });
    if (rows.length > 10000)
      throw new BadInput("More than 10,000 records to add up a computed field over: narrow them with where.");
    return rows.map((row) => row as Record<string, unknown>);
  },

  /** The items the viewer may read whose title has the text: a few, for naming one. */
  named(viewer: Viewer | null, text: string): { id: number; title: string }[] {
    return db
      .select({ id: schema.items.id, title: schema.items.title })
      .from(schema.items)
      .where(and(itemData.readable(viewer), contains([schema.items.title], text)))
      .limit(6)
      .all()
      .map((row) => ({ id: row.id, title: String(row.title) }));
  },

  /** Every title the viewer may read (at most 2,000): the nearest when a name fits none. */
  titles(viewer: Viewer | null): string[] {
    return db
      .select({ title: schema.items.title })
      .from(schema.items)
      .where(itemData.readable(viewer))
      .limit(2000)
      .all()
      .map((row) => String(row.title));
  },

  /** Why \`where\` found none when it names a text no record has: the field's nearest values. */
  whyNone(viewer: Viewer | null, where: unknown): string | undefined {
    if (!where || typeof where !== "object") return undefined;
    for (const [name, v] of Object.entries(where)) {
      const field = Object.hasOwn(FILTERABLE, name) ? FILTERABLE[name] : undefined;
      if (field?.kind !== "text" || (typeof v !== "string" && typeof v !== "number")) continue;
      const values = db
        .selectDistinct({ v: sql<string>\`\${field.column}\` })
        .from(schema.items)
        .where(and(itemData.readable(viewer), isNotNull(field.column)))
        .limit(2000)
        .all()
        .map((row) => String(row.v));
      const asked = String(v);
      if (values.length && !values.some((x) => x.toLowerCase().includes(asked.toLowerCase())))
        return \`No item has "\${asked}" in \${name}; the nearest: \${nearest(asked, values).join(", ")}.\`;
    }
    return undefined;
  },

  /** The condition for records the viewer may read that fit \`where\` and \`search\`. */
  fitting(viewer: Viewer | null, where?: unknown, search?: string) {
    return and(
      itemData.readable(viewer),
      whereOf(FILTERABLE, where, viewer ? eq(schema.items.ownerId, viewer.id) : undefined, viewer?.id, {}),
      // Every word somewhere in the texts ("ship lamp" finds "ship's lamp").
      ...wordsOf(search).map((word) => contains([schema.items.title, schema.items.description, schema.items.place], word)),
    );
  },

  async get(viewer: Viewer | null, id: number) {
    const fetched = await db.query.items.findFirst({
      where: and(eq(schema.items.id, id), itemData.readable(viewer)),
    });
    const found = fetched && itemData.shownRefs(viewer, [fetched])[0];
    const row = found && shownTo(viewer, found);
    return row ? row : null;
  },

  /** Who owns a item the viewer may read, for the server only (a message to its owner). */
  ownerOf(viewer: Viewer | null, id: number): string | null {
    return (
      db
        .select({ ownerId: schema.items.ownerId })
        .from(schema.items)
        .where(and(eq(schema.items.id, id), itemData.readable(viewer)))
        .get()?.ownerId ?? null
    );
  },

  async create(viewer: Viewer | null, values: ItemSettable) {
    check(itemAccess.create, viewer);
    values = checkFiles(viewer, values);
    let row: typeof schema.items.$inferSelect;
    try {
      row = db.transaction((tx) => {
        const made = tx.insert(schema.items).values({ ...values, ownerId: personOf(viewer) }).returning().get();
        audit(tx, viewer, { action: "created", model: "Item", record: made.id });
        queueReviews(tx, viewer, made.id, undefined, made);
        return made;
      });
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterCreate", "Item", row, viewer);
    return row;
  },

  /** Changes the record; \`what\` names the change in the audit log (an action's name). */
  /** Changes the fields given; what names the action ("changed" for a form), frees the fields it may change although locked (its own set). */
  async update(viewer: Viewer | null, id: number, values: Partial<ItemSettable>, what = "changed", _frees: readonly string[] = []) {
    const row = db
      .select({ ownerId: schema.items.ownerId, photos: schema.items.photos })
      .from(schema.items)
      .where(and(eq(schema.items.id, id), itemData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    // A form's change needs write on the record; an action (what names it) checked its own access
    // first, which includes the roles its grant names (docs/design/actions.md, Access).
    if (what === "changed") check(itemAccess.write, viewer, row.ownerId);
    values = checkFiles(viewer, values, db.select({ photos: schema.items.photos }).from(schema.items).where(eq(schema.items.id, id)).get());
    let changed: typeof schema.items.$inferSelect;
    const updated = values;
    try {
      changed = db.transaction((tx) => {
        // Read again in the change itself: a record that left the viewer's reach meanwhile is refused.
        const before = tx.select().from(schema.items).where(and(eq(schema.items.id, id), itemData.readable(viewer))).get();
        if (!before) throw new AccessDenied(viewer !== null);
        const after = tx.update(schema.items).set(updated).where(eq(schema.items.id, id)).returning().get();
        audit(tx, viewer, { action: what, model: "Item", record: id, fields: before && changedFields(before, after, Object.keys(updated)) });
        queueReviews(tx, viewer, id, before, after);
        return after;
      });
    } catch (error) {
      throw refusal(error);
    }
    for (const p of row.photos ?? []) if (!(changed.photos ?? []).map((p) => p.file).includes(p.file)) deletePicture(p, !!db.select({ id: schema.items.id }).from(schema.items).where(sql\`\${schema.items.photos} like \${\`%"file":"\${p.file}"%\`}\`).get());
    await afterChange("afterUpdate", "Item", changed, viewer);
    return changed;
  },

  /** Deletes the record; \`together\` takes the records that point to it along to the trash (delete-together.md). */
  async remove(viewer: Viewer | null, id: number, _together = false): Promise<void> {
    const row = db
      .select({ ownerId: schema.items.ownerId, photos: schema.items.photos })
      .from(schema.items)
      .where(and(eq(schema.items.id, id), itemData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(itemAccess.delete, viewer, row.ownerId);
    try {
      db.transaction((tx) => {
        // Read again in the change itself: a record that left the viewer's reach meanwhile is refused.
        if (!tx.select({ id: schema.items.id }).from(schema.items).where(and(eq(schema.items.id, id), itemData.readable(viewer))).get())
          throw new AccessDenied(viewer !== null);
        const gone = tx.delete(schema.items).where(eq(schema.items.id, id)).returning().get();
        if (gone) {
          audit(tx, viewer, { action: "deleted", model: "Item", record: id, title: gone.title });
        }
      });
    } catch (error) {
      throw refusal(error);
    }
    for (const p of row.photos ?? []) if (!([] as string[]).includes(p.file)) deletePicture(p, !!db.select({ id: schema.items.id }).from(schema.items).where(sql\`\${schema.items.photos} like \${\`%"file":"\${p.file}"%\`}\`).get());
    await afterDelete("Item", id, viewer);
  },

  /**
   * Deletes the chosen records the viewer may delete, all or none (one still in use stops them
   * all, and is named); the others are skipped.
   */
  async removeMany(viewer: Viewer | null, ids: number[], _together = false): Promise<{ deleted: number; skipped: number }> {
    const rows = db
      .select({ id: schema.items.id, ownerId: schema.items.ownerId, photos: schema.items.photos })
      .from(schema.items)
      .where(and(inArray(schema.items.id, ids), itemData.readable(viewer)))
      .all()
      .filter((row) => allows(itemAccess.delete, viewer, row.ownerId));
    db.transaction((tx) => {
      for (const row of rows)
        try {
          const gone = tx.delete(schema.items).where(eq(schema.items.id, row.id)).returning().get();
          if (gone) {
            audit(tx, viewer, { action: "deleted", model: "Item", record: row.id, title: gone.title });
          }
        } catch (error) {
          const refused = refusal(error);
          throw refused instanceof Conflict && refused.message === "in-use" ? new Conflict(\`in-use:\${row.id}\`) : refused;
        }
    });
    for (const row of rows) {
      for (const p of row.photos ?? []) if (!([] as string[]).includes(p.file)) deletePicture(p, !!db.select({ id: schema.items.id }).from(schema.items).where(sql\`\${schema.items.photos} like \${\`%"file":"\${p.file}"%\`}\`).get());
      await afterDelete("Item", row.id, viewer);
    }
    return { deleted: rows.length, skipped: new Set(ids).size - rows.length };
  },
};
"
`;

exports[`../../../examples/marketplace/smithable.yml > file list and generated code > src/generated/item.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { z } from "zod";
import type * as schema from "#/db/schema";
import { allows, type Rule } from "#/kit/access";
import type { RecordUi } from "#/kit/model";
import { bindPictures } from "#/kit/PictureInput";
import { itemAccess, itemData } from "./item.server";
import { writeAllowed } from "#/kit/limit";
import { currentViewer } from "#/lib/viewer.server";
import { itemSchema } from "./item.schema";

export type { ItemSettable, ItemValues } from "./item.schema";

/** The viewer about to write, counted against how often one may (see src/kit/limit.ts). */
async function writer() {
  const viewer = await currentViewer();
  writeAllowed(viewer, getRequestHeaders());
  return viewer;
}

/** Item records as the kit reads them. */
export type ItemRow = typeof schema.items.$inferSelect;

export const itemUi: RecordUi<ItemRow> = {
  model: "Item",
  label: "Item",
  pluralLabel: "Items",
  titleField: "title",
  descriptionField: "description",
  columns: ["title", "photos", "category", "condition", "price"],
  fields: [
    {
      name: "title",
      label: "Title",
      kind: "string",
      required: true,
      get: (row) => row.title,
    },
    {
      name: "photos",
      label: "Photos",
      kind: "pictures",
      required: true,
      input: bindPictures("item", "photos", 10),
      get: (row) => row.photos,
    },
    {
      name: "description",
      label: "Description",
      kind: "text",
      required: true,
      get: (row) => row.description,
    },
    {
      name: "price",
      label: "Price",
      kind: "money",
      required: false,
      get: (row) => row.price,
    },
    {
      name: "category",
      label: "Category",
      kind: "choice",
      required: true,
      choices: [
        { value: "furniture", label: "Furniture" },
        { value: "bikes", label: "Bikes" },
        { value: "electronics", label: "Electronics" },
        { value: "sports", label: "Sports" },
        { value: "kids", label: "Kids" },
        { value: "other", label: "Other" },
      ],
      default: "furniture",
      get: (row) => row.category,
    },
    {
      name: "condition",
      label: "Condition",
      kind: "choice",
      required: true,
      choices: [
        { value: "likeNew", label: "Like new" },
        { value: "good", label: "Good" },
        { value: "worn", label: "Worn" },
      ],
      default: "likeNew",
      get: (row) => row.condition,
    },
    {
      name: "place",
      label: "Place",
      kind: "string",
      required: false,
      get: (row) => row.place,
    },
    {
      name: "available",
      label: "Available",
      kind: "bool",
      required: false,
      default: true,
      get: (row) => row.available,
    },
  ],
};

/** Who may delete items: a list's selection offers Delete by it (the server checks again). */
export const itemDeleteRule: Rule = { public: false, roles: ["admin"], owner: true };


export const listItems = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return { rows: await itemData.list(viewer), canCreate: allows(itemAccess.create, viewer) };
});

export const getItem = createServerFn()
  .validator(z.number().int())
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    const row = await itemData.get(viewer, id);
    if (!row) return null;
    return {
      row,
      // Its files waiting for review, or rejected with the reason: for its owner and the reviewers.
      review: itemData.reviewNotes(viewer, id),
      saved: itemData.saved(viewer).includes(id),
      canWrite: allows(itemAccess.write, viewer, row.ownerId),
      canDelete: allows(itemAccess.delete, viewer, row.ownerId),
    };
  });

export const createItem = createServerFn({ method: "POST" })
  .validator(itemSchema)
  .handler(async ({ data }) => itemData.create(await writer(), data));

export const updateItem = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), values: itemSchema }))
  .handler(async ({ data }) => itemData.update(await writer(), data.id, data.values));

/** Deletes a item; \`together\` takes what points to it along (docs/design/delete-together.md). */
export const deleteItem = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), together: z.boolean().optional() }))
  .handler(async ({ data }) => itemData.remove(await writer(), data.id, data.together));

/** Deletes the chosen items, all or none (at most 1,000 at once). */
export const deleteItems = createServerFn({ method: "POST" })
  .validator(z.object({ ids: z.array(z.number().int()).max(1000), together: z.boolean().optional() }))
  .handler(async ({ data }) => itemData.removeMany(await writer(), data.ids, data.together));

/** Saves the record for the viewer, or unsaves it (their own mark); whether it is saved now. */
export const toggleSavedItem = createServerFn({ method: "POST" })
  .validator(z.number().int())
  .handler(async ({ data: id }) => itemData.toggleSaved(await writer(), id));
"
