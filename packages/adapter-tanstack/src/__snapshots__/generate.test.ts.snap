exports[`../../../examples/status/smithable.yml > file list and generated code > src/generated/access.test.ts 1`] = `
"// Generated by Smithable from smithable.yml and smithable.auth.yml. Do not edit: this file is overwritten on every change.
// For every model and role: which records a user can read, create, change and delete.
// "Own" records are owned by the user; "others" by someone else.
import { and, eq } from "drizzle-orm";
import { describe, expect, test } from "vitest";
import { db } from "#/db";
import { auditLog, user } from "#/db/schema";
import * as schema from "#/db/schema";
import { AccessDenied, type Viewer } from "#/kit/access";
import { forgetInLog, pruneAudit } from "#/kit/audit.server";
import { componentData } from "./component.server";
import { incidentData } from "./incident.server";
import { incidentUpdateData } from "./incident-update.server";
import { maintenanceData } from "./maintenance.server";
import { runIdentified, runIdentifiedMany } from "./actions/identified.server";
import { runMonitoring, runMonitoringMany } from "./actions/monitoring.server";
import { runResolve, runResolveMany } from "./actions/resolve.server";

let counter = 0;
const next = () => ++counter;

/** A new signed-in user with the role. */
function signedIn(role: string): Viewer {
  const n = next();
  const viewer = { id: \`test-user-\${n}\`, name: \`Test \${role} \${n}\`, email: \`user\${n}@example.com\`, role };
  db.insert(user).values(viewer).run();
  return viewer;
}

/** Owns the records that are someone else's. */
const stranger = signedIn("staff");

/** Whether the action is allowed; any other failure fails the test. */
async function can(action: () => unknown): Promise<boolean> {
  try {
    await action();
    return true;
  } catch (error) {
    if (error instanceof AccessDenied) return false;
    throw error;
  }
}

/** Whether the viewer can open the record and sees it in the list. */
async function reads(
  data: { get(viewer: never, id: number): Promise<unknown>; list(viewer: never): Promise<{ id: number }[]> },
  viewer: unknown,
  id: number,
): Promise<boolean> {
  const listed = await data.list(viewer as never).then(
    (rows) => rows.some((row) => row.id === id),
    (error) => {
      if (error instanceof AccessDenied) return false;
      throw error;
    },
  );
  return listed && (await data.get(viewer as never, id)) !== null;
}

function componentValues(_owner: string | null) {
  const n = next();
  return { name: \`Component name \${n}\`, status: "operational", description: null } as const;
}

function insertComponent(owner: string | null, values: Record<string, unknown> = {}) {
  return db
    .insert(schema.components)
    .values({ ...componentValues(owner), ...values, ownerId: owner })
    .returning()
    .get();
}

function incidentValues(_owner: string | null) {
  const n = next();
  return { title: \`Incident title \${n}\`, status: "investigating", componentId: null, detectedAt: new Date("2026-01-15T10:00:00Z"), resolvedAt: null, summary: null } as const;
}

function insertIncident(owner: string | null, values: Record<string, unknown> = {}) {
  return db
    .insert(schema.incidents)
    .values({ ...incidentValues(owner), ...values, ownerId: owner })
    .returning()
    .get();
}

function incidentUpdateValues(owner: string | null) {
  const n = next();
  return { incidentId: insertIncident(owner).id, at: new Date("2026-01-15T10:00:00Z"), status: "investigating", message: \`IncidentUpdate message \${n}\` } as const;
}

function insertIncidentUpdate(owner: string | null, values: Record<string, unknown> = {}) {
  return db
    .insert(schema.incidentUpdates)
    .values({ ...incidentUpdateValues(owner), ...values, ownerId: owner })
    .returning()
    .get();
}

function maintenanceValues(_owner: string | null) {
  const n = next();
  return { title: \`Maintenance title \${n}\`, componentId: null, startsAt: new Date("2026-01-15T10:00:00Z"), endsAt: new Date("2026-01-15T10:00:00Z"), description: null } as const;
}

function insertMaintenance(owner: string | null, values: Record<string, unknown> = {}) {
  return db
    .insert(schema.maintenances)
    .values({ ...maintenanceValues(owner), ...values, ownerId: owner })
    .returning()
    .get();
}

describe("Component", () => {
  test("admin", async () => {
    const viewer = signedIn("admin");
    const others = insertComponent(stranger.id);
    const own = insertComponent(viewer.id);
    expect({
      readOthers: await reads(componentData, viewer, others.id),
      readOwn: await reads(componentData, viewer, own.id),
      create: await can(() => componentData.create(viewer, componentValues(viewer.id))),
      changeOthers: await can(() => componentData.update(viewer, others.id, componentValues(stranger.id))),
      changeOwn: await can(() => componentData.update(viewer, own.id, componentValues(viewer.id))),
      deleteOthers: await can(() => componentData.remove(viewer, others.id)),
      deleteOwn: await can(() => componentData.remove(viewer, own.id)),
    }).toEqual({
      readOthers: true,
      readOwn: true,
      create: true,
      changeOthers: true,
      changeOwn: true,
      deleteOthers: true,
      deleteOwn: true,
    });
  });

  test("staff", async () => {
    const viewer = signedIn("staff");
    const others = insertComponent(stranger.id);
    const own = insertComponent(viewer.id);
    expect({
      readOthers: await reads(componentData, viewer, others.id),
      readOwn: await reads(componentData, viewer, own.id),
      create: await can(() => componentData.create(viewer, componentValues(viewer.id))),
      changeOthers: await can(() => componentData.update(viewer, others.id, componentValues(stranger.id))),
      changeOwn: await can(() => componentData.update(viewer, own.id, componentValues(viewer.id))),
      deleteOthers: await can(() => componentData.remove(viewer, others.id)),
      deleteOwn: await can(() => componentData.remove(viewer, own.id)),
    }).toEqual({
      readOthers: true,
      readOwn: true,
      create: true,
      changeOthers: true,
      changeOwn: true,
      deleteOthers: false,
      deleteOwn: true,
    });
  });

  test("a visitor who has not signed in", async () => {
    const viewer = null;
    const others = insertComponent(stranger.id);
    expect({
      readOthers: await reads(componentData, viewer, others.id),
      readOwn: false,
      create: await can(() => componentData.create(viewer, componentValues(null))),
      changeOthers: await can(() => componentData.update(viewer, others.id, componentValues(stranger.id))),
      changeOwn: false,
      deleteOthers: await can(() => componentData.remove(viewer, others.id)),
      deleteOwn: false,
    }).toEqual({
      readOthers: true,
      readOwn: false,
      create: false,
      changeOthers: false,
      changeOwn: false,
      deleteOthers: false,
      deleteOwn: false,
    });
  });

  test("a visitor reading the component is not told who added its incidents", async () => {
    const parent = insertComponent(stranger.id);
