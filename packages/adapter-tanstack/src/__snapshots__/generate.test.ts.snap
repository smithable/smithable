exports[`../../../examples/invoicing/smithable.yml > file list and generated code > src/generated/business-profile.server.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { and, eq, sql, type SQL } from "drizzle-orm";
import { db } from "#/db";
import { businessProfiles } from "#/db/schema";
import { AccessDenied, check, type ModelAccess, readScope, refusal, type Viewer } from "#/kit/access";
import { afterChange, afterDelete } from "./hooks";
import type { BusinessProfileValues } from "./business-profile";

/** Who may read, create, change and delete business profiles. */
export const businessProfileAccess: ModelAccess = {
  read: { public: false, roles: ["admin"], owner: true },
  create: { public: false, roles: ["admin", "member"], owner: false },
  write: { public: false, roles: ["admin"], owner: true },
  delete: { public: false, roles: ["admin"], owner: true },
};

export const businessProfileData = {
  /** A condition for the business profiles the viewer may read. */
  readable(viewer: Viewer | null) {
    const scope = readScope(businessProfileAccess.read, viewer);
    if (scope === "all") return undefined;
    return scope === "own" && viewer ? eq(businessProfiles.ownerId, viewer.id) : sql\`false\`;
  },

  canRead(viewer: Viewer | null, id: number): boolean {
    const found = db
      .select({ id: businessProfiles.id })
      .from(businessProfiles)
      .where(and(eq(businessProfiles.id, id), businessProfileData.readable(viewer)))
      .get();
    return found !== undefined;
  },

  /** The business profiles the viewer may read; \`where\` narrows them, e.g. to a search. */
  async list(viewer: Viewer | null, where?: SQL) {
    if (readScope(businessProfileAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const rows = await db.query.businessProfiles.findMany({
      where: and(businessProfileData.readable(viewer), where),
      orderBy: (t, { desc }) => [desc(t.id)],
    });
    return rows;
  },

  async get(viewer: Viewer | null, id: number) {
    const row = await db.query.businessProfiles.findFirst({
      where: and(eq(businessProfiles.id, id), businessProfileData.readable(viewer)),
    });
    return row ? row : null;
  },

  async create(viewer: Viewer | null, values: BusinessProfileValues) {
    check(businessProfileAccess.create, viewer);
    let row: typeof businessProfiles.$inferSelect;
    try {
      row = db.insert(businessProfiles).values({ ...values, ownerId: viewer?.id ?? null }).returning().get();
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterCreate", "BusinessProfile", row, viewer);
    return row;
  },

  async update(viewer: Viewer | null, id: number, values: BusinessProfileValues) {
    const row = db
      .select({ ownerId: businessProfiles.ownerId })
      .from(businessProfiles)
      .where(and(eq(businessProfiles.id, id), businessProfileData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(businessProfileAccess.write, viewer, row.ownerId);
    let changed: typeof businessProfiles.$inferSelect;
    const updated = values;
    try {
      changed = db.update(businessProfiles).set(updated).where(eq(businessProfiles.id, id)).returning().get();
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterUpdate", "BusinessProfile", changed, viewer);
    return changed;
  },

  async remove(viewer: Viewer | null, id: number): Promise<void> {
    const row = db
      .select({ ownerId: businessProfiles.ownerId })
      .from(businessProfiles)
      .where(and(eq(businessProfiles.id, id), businessProfileData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(businessProfileAccess.delete, viewer, row.ownerId);
    try {
      db.delete(businessProfiles).where(eq(businessProfiles.id, id)).run();
    } catch (error) {
      throw refusal(error);
    }
    await afterDelete("BusinessProfile", id, viewer);
  },
};
"
`;

exports[`../../../examples/invoicing/smithable.yml > file list and generated code > src/generated/business-profile.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { createInsertSchema } from "drizzle-zod";
import { z } from "zod";
import { businessProfiles } from "#/db/schema";
import { allows } from "#/kit/access";
import type { RecordUi } from "#/kit/model";
import { businessProfileAccess, businessProfileData } from "./business-profile.server";
import { currentViewer } from "#/lib/viewer.server";

/** BusinessProfile records as the kit reads them. */
export type BusinessProfileRow = typeof businessProfiles.$inferSelect;

export const businessProfileUi: RecordUi<BusinessProfileRow> = {
  model: "BusinessProfile",
  label: "Business profile",
  pluralLabel: "Business profiles",
  titleField: "businessName",
  columns: ["businessName", "vatNumber", "iban", "paymentTermDays"],
  fields: [
    {
      name: "businessName",
      label: "Business name",
      kind: "string",
      required: true,
      get: (row) => row.businessName,
    },
    {
      name: "vatNumber",
      label: "Vat number",
      kind: "string",
      required: false,
      get: (row) => row.vatNumber,
    },
    {
      name: "iban",
      label: "Iban",
      kind: "string",
      required: false,
      get: (row) => row.iban,
    },
    {
      name: "paymentTermDays",
      label: "Payment term days",
      kind: "int",
      required: true,
      default: 30,
      get: (row) => row.paymentTermDays,
    },
    {
      name: "invoiceFooter",
      label: "Invoice footer",
      kind: "text",
      required: false,
      get: (row) => row.invoiceFooter,
    },
  ],
};

export const businessProfileSchema = createInsertSchema(businessProfiles, {
  businessName: (s) => s.trim().min(1, "Required").max(200, "At most 200 characters"),
  vatNumber: (s) => s.max(200, "At most 200 characters"),
  iban: (s) => s.max(200, "At most 200 characters"),
  invoiceFooter: (s) => s.max(10000, "At most 10,000 characters"),
}).omit({ id: true, ownerId: true, createdAt: true, updatedAt: true });

export type BusinessProfileValues = z.output<typeof businessProfileSchema>;

export const listBusinessProfiles = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return { rows: await businessProfileData.list(viewer), canCreate: allows(businessProfileAccess.create, viewer) };
});

export const getBusinessProfile = createServerFn()
  .validator(z.number().int())
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    const row = await businessProfileData.get(viewer, id);
    if (!row) return null;
    return {
      row,
      canWrite: allows(businessProfileAccess.write, viewer, row.ownerId),
