exports[`../../../examples/booking/smithable.yml > file list and generated code > tests/smoke.spec.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { expect, type Page, test } from "@playwright/test";

/** Opens a page and fails on any error in the browser, e.g. a script the policy blocked. */
async function visit(page: Page, route: string) {
  const errors: string[] = [];
  page.on("pageerror", (e) => errors.push(e.message));
  page.on("console", (m) => m.type() === "error" && errors.push(m.text()));
  await page.goto(route);
  await page.waitForLoadState("networkidle");
  await expect(page.locator("h1").first()).toBeVisible();
  expect(errors).toEqual([]);
}

test("Home opens for a visitor", async ({ page }) => {
  await visit(page, "/");
});
test("Schedule opens for a visitor", async ({ page }) => {
  await visit(page, "/schedule");
});
test("Blog opens for a visitor", async ({ page }) => {
  await visit(page, "/blog");
});
test("Sessions needs sign-in", async ({ page }) => {
  await page.goto("/sessions");
  await expect(page).toHaveURL(/sign-in/);
});
test("Class types needs sign-in", async ({ page }) => {
  await page.goto("/class-types");
  await expect(page).toHaveURL(/sign-in/);
});
test("Instructors needs sign-in", async ({ page }) => {
  await page.goto("/instructors");
  await expect(page).toHaveURL(/sign-in/);
});
test("Messages needs sign-in", async ({ page }) => {
  await page.goto("/messages");
  await expect(page).toHaveURL(/sign-in/);
});
test("Posts needs sign-in", async ({ page }) => {
  await page.goto("/posts");
  await expect(page).toHaveURL(/sign-in/);
});
test("My bookings needs sign-in", async ({ page }) => {
  await page.goto("/my-bookings");
  await expect(page).toHaveURL(/sign-in/);
});
test("Admin needs sign-in", async ({ page }) => {
  await page.goto("/admin");
  await expect(page).toHaveURL(/sign-in/);
});

test.describe("signed in as admin", () => {
  test.beforeEach(async ({ page }) => {
    await page.goto("/sign-in");
    await page.waitForLoadState("networkidle");
    await page.getByRole("button", { name: "Sign in as admin" }).click();
    await page.waitForURL((url) => url.pathname !== "/sign-in");
  });

  test("Sessions opens", async ({ page }) => {
    await visit(page, "/sessions");
  });
  test("Class types opens", async ({ page }) => {
    await visit(page, "/class-types");
  });
  test("Instructors opens", async ({ page }) => {
    await visit(page, "/instructors");
  });
  test("Messages opens", async ({ page }) => {
    await visit(page, "/messages");
  });
  test("Posts opens", async ({ page }) => {
    await visit(page, "/posts");
  });
  test("My bookings opens", async ({ page }) => {
    await visit(page, "/my-bookings");
  });
  test("Admin opens", async ({ page }) => {
    await visit(page, "/admin");
  });
});

test.describe("signed in as member", () => {
  test.beforeEach(async ({ page }) => {
    await page.goto("/sign-in");
    await page.waitForLoadState("networkidle");
    await page.getByRole("button", { name: "Sign in as member" }).click();
    await page.waitForURL((url) => url.pathname !== "/sign-in");
  });

  test("My bookings opens", async ({ page }) => {
    await visit(page, "/my-bookings");
  });
});
"
`;

