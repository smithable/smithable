"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// The API's description in the OpenAPI format, with no key needed to read it: with a key, or
// signed in as someone who may open the users page (its download), all a program may call; otherwise what anyone may read
// or add, which in an app with nothing public is nothing (no model or field names to a stranger).
import { createFileRoute } from "@tanstack/react-router";
import { OPENAPI, VISITOR_OPENAPI } from "#/generated/api.server";
import { pageAccess } from "#/generated/pages";
import { allows } from "#/kit/access";
import { callerOf } from "#/kit/api.server";
import { currentViewer } from "#/lib/viewer.server";

export const Route = createFileRoute("/api/v1/openapi.json")({
  server: {
    handlers: {
      GET: async ({ request }) => {
        // A key; or signed in as someone who may open the users page, where keys are made.
        const session = await currentViewer();
        const whole = callerOf(request).viewer || (session && allows(pageAccess["team"], session));
        return Response.json(whole ? OPENAPI : VISITOR_OPENAPI);
      },
    },
  },
});
"
`;

exports[`../../../examples/status/smithable.yml > file list and generated code > src/routes/components/$id.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, Link, notFound, useNavigate } from "@tanstack/react-router";
import { createServerFn } from "@tanstack/react-start";
import { and, desc, eq } from "drizzle-orm";
import { db } from "#/db";
import { apiKey, auditLog, user } from "#/db/schema";
import { app } from "#/generated/app";
import { pageAccess } from "#/generated/pages";
import { componentUi, deleteComponent, getComponent, updateComponent } from "#/generated/component";
import { componentSchema } from "#/generated/component.schema";
import { buttonVariants } from "#/components/ui/button";
import { incidentUi } from "#/generated/incident";
import { guardPage } from "#/kit/access";
import { ActivityLog } from "#/kit/ActivityLog";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";
import { w } from "#/kit/words";
import { currentViewer } from "#/lib/viewer.server";
import { ModelTable } from "#/kit/ModelTable";

/** The record's lines in the audit log, newest first: administrators only, nobody else. */
const getHistory = createServerFn()
  .validator((id: number) => id)
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    if (viewer?.role !== "admin") return null;
    const people = new Map(db.select({ id: user.id, name: user.name }).from(user).all().map((p) => [p.id, p.name]));
    // A key's lines name the key ("key:3" is the key made as "Uptime monitor").
    for (const k of db.select({ id: apiKey.id, name: apiKey.name }).from(apiKey).all())
      people.set(\`key:\${k.id}\`, \`key "\${k.name}"\`);
    return db
      .select()
      .from(auditLog)
      .where(and(eq(auditLog.model, "Component"), eq(auditLog.recordId, id)))
      .orderBy(desc(auditLog.id))
      .limit(50)
      .all()
      .map((r) => ({
        id: r.id,
        at: r.at,
        who: r.who === "visitor" || r.who === "the app" ? r.who : (people.get(r.who) ?? (r.who.startsWith("key:") ? w.aKey(r.who.slice(4)) : w.aRemovedUser(r.who))),
        action: r.action,
        fields: r.fields,
        details: r.details ? Object.fromEntries(Object.entries(r.details).map(([k, v]) => [k, String(v)])) : null,
      }));
  });

export const Route = createFileRoute("/components/$id")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["components"], context.viewer, location.href),
  head: () => ({ meta: [{"title":"Components · Northwind Status"}] }),
  loader: async ({ params }) => {
    const found = await getComponent({ data: Number(params.id) });
    if (!found) throw notFound();
    return { ...found, history: await getHistory({ data: Number(params.id) }) };
  },
  component: ComponentPage,
});

function ComponentPage() {
  const { row, canWrite, canDelete, canAdd, history } = Route.useLoaderData();
  const navigate = useNavigate();
  const back = () => navigate({ to: "/components" });
  return (
    <>
      <PageHeader title={row.name || \`Component #\${row.id}\`} />
      <ModelForm
        key={String(row.updatedAt)}
        ui={componentUi}
        app={app}
        schema={componentSchema}
        initial={row}
        readOnly={!canWrite}
        submitLabel={w.saveChanges}
        onSubmit={async (values) => {
          await updateComponent({ data: { id: row.id, values } });
          await back();
        }}
        onCancel={back}
        onDelete={
          canDelete
            ? async (together?: boolean) => {
                await deleteComponent({ data: { id: row.id, together } });
                await back();
              }
            : undefined
        }
      />
      <section className="mt-10">
        <div className="mb-3 flex items-center justify-between gap-3">
          <h2 className="text-lg font-semibold">Incidents</h2>
          {row.incidents.length > 0 && canAdd?.incidents && (
              <Link to="/incidents/new" search={{ component: row.id }} className={buttonVariants({ variant: "outline" })}>
                {w.addOne("incident")}
              </Link>
            )}
        </div>
        <ModelTable
          ui={incidentUi}
          app={app}
          rows={row.incidents}
          hide={["componentId"]}
          onOpen={(item) => navigate({ to: "/incidents/$id", params: { id: String(item.id) } })}
          emptyAction={canAdd?.incidents && (
              <Link to="/incidents/new" search={{ component: row.id }} className={buttonVariants({ variant: "outline" })}>
                {w.addOne("incident")}
              </Link>
            )}
          emptyMessage={canAdd?.incidents ? undefined : w.noneYet("incidents")}
        />
      </section>
      {history && history.length > 0 && (
        <section className="mt-10 max-w-3xl">
          <h2 className="mb-3 text-lg font-semibold">{w.history}</h2>
          <ActivityLog lines={history} app={app} />
        </section>
      )}
    </>
  );
}
"
`;

exports[`../../../examples/status/smithable.yml > file list and generated code > src/routes/components/index.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, Link, useNavigate, useRouter } from "@tanstack/react-router";
import { pageAccess } from "#/generated/pages";
import { guardPage, allows } from "#/kit/access";
import { createServerFn } from "@tanstack/react-start";
import { componentAccess, componentData } from "#/generated/component.server";
import { currentViewer } from "#/lib/viewer.server";
import { type Search, count, listQuery, optional } from "#/kit/params";
import { buttonVariants } from "#/components/ui/button";
import { useState } from "react";
import { SelectionBar } from "#/kit/SelectionBar";
import { csvName, csvOf, download } from "#/kit/csv";
import { deleteComponents, componentDeleteRule, componentUi } from "#/generated/component";
import { app } from "#/generated/app";
import { w } from "#/kit/words";
import { PageHeader } from "#/kit/AppShell";
import { ModelTable } from "#/kit/ModelTable";

/** A page of the components the viewer may read. */
const listComponents = createServerFn()
  .validator(listQuery)
  .handler(async ({ data }) => {
    const viewer = await currentViewer();
    return { ...(await componentData.page(viewer, undefined, undefined, data.all ? 1 : data.page, data.all ? (viewer ? 10000 : 500) : undefined)), canCreate: allows(componentAccess.create, viewer) };
  });

export const Route = createFileRoute("/components/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["components"], context.viewer, location.href),
  head: () => ({ meta: [{"title":"Components · Northwind Status"}] }),
  validateSearch: (s: Search) => optional({ page: count(s.page) }),
  loaderDeps: ({ search }) => ({ page: search.page }),
  loader: ({ deps }) => listComponents({ data: { page: deps.page } }),
  component: ComponentsPage,
});

function ComponentsPage() {
  const { rows, canCreate, total, page: at, size } = Route.useLoaderData();
  const { viewer } = Route.useRouteContext();
  const navigate = useNavigate({ from: "/components/" });
  const router = useRouter();
  // The chosen rows, offered when the viewer may do something to at least one row.
  const [selected, setSelected] = useState<Set<number>>(new Set());
  const chosen = rows.filter((row) => selected.has(row.id));
  const selectable = rows.some((row) => allows(componentDeleteRule, viewer, row.ownerId));
  const newButton = canCreate && (
    <Link to="/components/new" className={buttonVariants()}>
      {w.newOne("component")}
    </Link>
  );
  return (
    <>
      <PageHeader
        page="components"
        title="Components"
        actions={newButton}
      />
      {selectable && (
        <SelectionBar
          count={chosen.length}
          noun={["component", "components"]}
          app={app}
          titleOf={(id) => String(rows.find((row) => row.id === id)?.name ?? id)}
          actions={[]}
          deletable={chosen.filter((row) => allows(componentDeleteRule, viewer, row.ownerId)).length}
          onDelete={(together) => deleteComponents({ data: { ids: chosen.map((row) => row.id), together } })}
          onDone={async () => {
            setSelected(new Set());
            await router.invalidate();
          }}
          onExport={() => download(csvName(componentUi), csvOf(componentUi, chosen))}
        />
      )}
      <ModelTable
        ui={componentUi}
        page="components"
        paging={{ page: at, size, total, to: (next) => navigate({ to: "/components", search: (prev) => ({ ...prev, page: next > 1 ? next : undefined }) }) }}
        app={app}
        exportRows={async () => (await listComponents({ data: { all: true } })).rows}
        rows={rows}
        selection={selectable ? { ids: selected, onChange: setSelected } : undefined}
        emptyAction={newButton || undefined}
        onOpen={(row) => navigate({ to: "/components/$id", params: { id: String(row.id) } })}
      />
    </>
  );
}
"
`;

exports[`../../../examples/status/smithable.yml > file list and generated code > src/routes/components/new.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
