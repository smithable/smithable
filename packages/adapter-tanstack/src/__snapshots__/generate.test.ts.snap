          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "Project",
                "Task",
                "Note"
              ]
            }
          }
        },
        "annotations": {
          "readOnlyHint": true,
          "destructiveHint": false
        }
      }
    ],
    "describe": {
      "Project": "Project\\nFields:\\n- name*: Name.\\n- description: Description.",
      "Task": "Task\\nFields:\\n- title*: Title.\\n- project* -> Project: Project.\\n- status* (todo | doing | done): Status. Starts as todo.\\n- dueDate (date): Due date.\\n- assignee -> User: Assignee.\\n- details: Details.\\nActions:\\n- complete: Mark a task as done. Only when status is todo or doing.\\n- reopen: Open a finished task again. Only when status is done.",
      "Note": "Note\\nFields:\\n- title*: Title.\\n- project* -> Project: Project.\\n- body: Body.\\n- attachment (document): Attachment."
    }
  },
  "visitor": {
    "summary": "Team Tasks: nothing is offered to a visitor, without a key.",
    "tools": [],
    "describe": {}
  }
};

/** The offer for a caller; a role the app does not know gets nothing. */
export function offerFor(viewer: Viewer | null): Offer & { describe: Record<string, string> } {
  const caller = viewer?.role ?? "visitor";
  return Object.hasOwn(OFFERS, caller) ? OFFERS[caller] : { summary: "", tools: [], describe: {} };
}

/** Each kind's data functions and conversions, its title field, and its references' titles. */
const KINDS = {
  Project: { data: projectData, toApi: projectToApi, fromApi: projectFromApi, title: "name", refs: {}, searched: ["name","description"], lists: {"tasks":{"kind":"Task","ref":"project"},"notes":{"kind":"Note","ref":"project"}} as Record<string, { kind: string; ref: string }>, label: "project", named: (viewer: Viewer | null, text: string) => projectData.named(viewer, text) },
  Task: { data: taskData, toApi: taskToApi, fromApi: taskFromApi, title: "title", refs: {"project":"name","assignee":"name"}, searched: ["title","details"], lists: {} as Record<string, { kind: string; ref: string }>, label: "task", named: (viewer: Viewer | null, text: string) => taskData.named(viewer, text) },
  Note: { data: noteData, toApi: noteToApi, fromApi: noteFromApi, title: "title", refs: {"project":"name"}, searched: ["title","body"], lists: {} as Record<string, { kind: string; ref: string }>, label: "note", named: (viewer: Viewer | null, text: string) => noteData.named(viewer, text) },
};
type Kind = (typeof KINDS)[keyof typeof KINDS];

const kindOf = (args: Record<string, unknown>): Kind => {
  const kind = Object.hasOwn(KINDS, String(args.kind)) ? KINDS[args.kind as keyof typeof KINDS] : undefined;
  if (!kind) throw new BadInput(\`There is no kind "\${String(args.kind)}". Kinds: \${Object.keys(KINDS).join(", ")}.\`);
  return kind;
};

/**
 * A record the caller may use, by its id or by its title (an invoice's number): one that fits,
 * never a guess; "not there" and "not yours" are the same answer.
 */
async function found(kind: Kind, viewer: Viewer | null, id: unknown, verb = "read") {
  let key = Number.isInteger(id) ? (id as number) : /^\\d+$/.test(String(id)) ? Number(id) : undefined;
  if (key === undefined && typeof id === "string" && kind.named) {
    const fits = kind.named(viewer, id);
    const exact = fits.filter((r) => r.title.toLowerCase() === id.toLowerCase());
    const pick = exact.length === 1 ? exact : fits;
    if (pick.length > 1)
      throw new BadInput(\`"\${id}" fits several: \${pick.slice(0, 5).map((r) => \`\${r.title} (\${r.id})\`).join(", ")}. Give its whole \${titleWord(kind)} or its id.\`);
    key = pick[0]?.id;
  }
  const row = key === undefined ? null : await kind.data.get(viewer, key);
  if (!row) throw new NotFound(\`No \${kind.label} \${String(id)} that you may \${verb}; find it first.\`);
  return row;
}

/** The title's word in a sentence: a name of parts is the record's name. */
const titleWord = (kind: Kind) => (kind.title === "$name" ? "name" : kind.title);

/** A field's value in a row: a reference as its id and title, nothing else changed. */
function shown(kind: Kind, row: Record<string, unknown>, api: Record<string, unknown>, field: string): unknown {
  const title = (kind.refs as Record<string, string>)[field];
  const related = row[field] as Record<string, unknown> | null | undefined;
  // A name of parts, as the data functions set it on the rows they give (record-names.md).
  if (field === "$name") return row.$name ?? null;
  if (title && related && typeof related === "object")
    return related.deletedAt ? { id: related.id, inTrash: true } : { id: related.id, title: related[title] };
  if (!(field in api)) throw new BadInput(\`There is no field "\${field}". Fields: \${Object.keys(api).join(", ")}.\${field === "title" ? \` The title field is \${titleWord(kind)}.\` : ""}\`);
  return api[field];
}

/** "count", "sum total", "average total", "min …", "max …" as measure's own words. */
function measureOf(of: unknown): { how: "count" | "sum" | "average" | "smallest" | "largest"; field?: string } {
  const [word = "count", field] = String(of ?? "count").trim().split(/\\s+/);
  const how = ({ count: "count", sum: "sum", average: "average", min: "smallest", max: "largest" } as const)[word as "count"];
  if (!how) throw new BadInput('"of" is count, or sum, average, min or max with a number field, e.g. "sum total".');
  return { how, field };
}

/** An action is a key's: a visitor is never offered one, and is refused here too. */
const keyed = (viewer: Viewer | null): Viewer => {
  if (!viewer) throw new AccessDenied(false);
  return viewer;
};

/** A call's result, or its note when \`where\` names a value no record has. */
async function none<T>(call: () => Promise<T>): Promise<T | { none: string }> {
  try {
    return await call();
  } catch (error) {
    if (error instanceof NoSuchValue) return { none: error.message };
    throw error;
  }
}
const noted = (result: unknown): result is { none: string } =>
  typeof result === "object" && result !== null && "none" in result;

/** Why a call found none: a text no record has, or a search nothing fits, with the nearest. */
async function whyNone(kind: Kind, viewer: Viewer | null, args: Record<string, unknown>): Promise<string | undefined> {
  const text = kind.data.whyNone(viewer, args.where);
  if (text) return text;
  // None of the viewer's own: say how many there are without "mine" (ask-checks.md §6).
  const where = args.where as Record<string, unknown> | undefined;
  if (where && (where.mine === true || where.mine === "true")) {
    const { mine: _mine, ...rest } = where;
    const all = await kind.data.measure(viewer, "count", { where: rest, search: typeof args.search === "string" ? args.search : undefined });
    if (all) return \`None of your own; \${all} in all.\`;
  }
  if (typeof args.search !== "string") return undefined;
  // Nothing found by a search: say where it looked, the nearest titles, and how a reference is matched instead.
  const refs = Object.keys(kind.refs);
  const near = "titles" in kind.data ? nearest(args.search, kind.data.titles(viewer)) : [];
  return \`Nothing has every word of "\${args.search}" in \${kind.searched.join(", ") || "the texts"}.\${near.length ? \` The nearest \${titleWord(kind)}s: \${near.join(", ")}.\` : ""}\${refs.length ? \` A \${refs[0]} is matched with where, e.g. {"\${refs[0]}": "…"}.\` : ""}\`;
}

/** Calls one tool as the key's role, or as a visitor without a key. */
export async function callTool(viewer: Viewer | null, name: string, args: Record<string, unknown>): Promise<unknown> {
  switch (name) {
    case "find": {
      const kind = kindOf(args);
      const limit = Math.min(50, Math.max(1, Number(args.limit) || 10));
      const page = Math.max(1, Number(args.page) || 1);
      const asked = Array.isArray(args.fields) ? args.fields.map(String) : [];
      const columns = [...new Set(["id", kind.title, ...asked])];
      // A value no record has is none, with what there is (docs/design/ask-checks.md §2).
      const result = await none<{ items: unknown[]; total: number }>(() =>
        kind.data.find(viewer, {
          where: args.where,
          search: typeof args.search === "string" ? args.search : undefined,
          sort: typeof args.sort === "string" ? args.sort : undefined,
          limit,
          offset: (page - 1) * limit,
        }),
      );
      if (noted(result)) return { columns, rows: [], total: 0, note: result.none };
      const { items, total } = result;
      const rows = items.map((row) => {
        const api = kind.toApi(row as Record<string, any>) as Record<string, unknown>;
        return columns.map((field) => shown(kind, row as Record<string, unknown>, api, field));
      });
      if (total) return { columns, rows, total };
      const why = await whyNone(kind, viewer, args);
      return why ? { columns, rows, total, note: why } : { columns, rows, total };
    }
    case "measure": {
      const kind = kindOf(args);
      const { how, field } = measureOf(args.of);
      const options = { field, where: args.where, search: typeof args.search === "string" ? args.search : undefined };
      const key = how === "count" ? "total" : how;
      if (typeof args.by === "string") {
        const by = args.by;
        const rows = await none(() => kind.data.measureBy(viewer, how, by, options));
        if (noted(rows)) return { by, rows: [], note: rows.none };
        // A top shared by several is said, so one is not given as the winner.
        const top = rows[0]?.number;
        const tied = rows.filter((r) => r.number === top);
        return tied.length > 1 && top !== null && top !== undefined
          ? { by, rows, note: \`\${tied.map((r) => r.title ?? String(r.value)).join(", ")} share the top, with \${top} each.\` }
          : { by, rows };
      }
      const value = await none(() => kind.data.measure(viewer, how, options));
      if (noted(value)) return { [key]: how === "count" ? 0 : null, note: value.none };
      // The smallest or largest: which record holds it.
      if ((how === "smallest" || how === "largest") && value !== null)
        return { [how]: value, of: await kind.data.holder(viewer, how, options) };
      const why = !value ? await whyNone(kind, viewer, args) : undefined;
      return why ? { [key]: value, note: why } : { [key]: value };
    }
    case "read": {
      const kind = kindOf(args);
      const row = await found(kind, viewer, args.id);
      // With its lists, as its page shows them: an invoice with its lines (twenty of each at most).
      const lists: Record<string, unknown> = {};
      for (const [field, list] of Object.entries(kind.lists)) {
        const related = KINDS[list.kind as keyof typeof KINDS] as Kind;
        const find = related.data.find.bind(related.data) as (viewer: Viewer | null, options: { where: unknown; limit: number }) => Promise<{ items: unknown[]; total: number }>;
        const shown = await find(viewer, { where: { [list.ref]: row.id }, limit: 20 }).catch(() => undefined);
        if (shown) lists[field] = { rows: shown.items.map((r) => related.toApi(r as Record<string, any>)), total: shown.total };
      }
      return { ...kind.toApi(row as Record<string, any>), ...lists };
    }
    case "add": {
      const kind = kindOf(args);
      return kind.toApi(await kind.data.create(viewer, kind.fromApi(args.values ?? {}) as never));
    }
    case "change": {
      const kind = kindOf(args);
      const row = await found(kind, viewer, args.id, "change");
      return kind.toApi(await kind.data.update(viewer, row.id, kind.fromApi(args.values ?? {}, row as Record<string, unknown>) as never));
    }
    case "delete": {
      const kind = kindOf(args);
      const row = await found(kind, viewer, args.id, "delete");
      await kind.data.remove(viewer, row.id, args.together === true);
      return { deleted: row.id };
    }
    case "describe":
      kindOf(args);
      return { description: offerFor(viewer).describe[args.kind as string] };
    case "run":
      switch (args.action) {
    case "complete": {
      const row = await found(KINDS.Task, viewer, args.id, "change");
      return taskToApi(await runComplete(keyed(viewer), row.id));
    }
    case "reopen": {
      const row = await found(KINDS.Task, viewer, args.id, "change");
      return taskToApi(await runReopen(keyed(viewer), row.id));
    }
        default:
          throw new NotFound(\`There is no action "\${String(args.action)}".\`);
      }
    default:
      throw new NotFound(\`There is no tool "\${name}".\`);
  }
}
"
`;

exports[`../../../examples/api/smithable.yml > file list and generated code > src/generated/note.schema.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createInsertSchema } from "drizzle-zod";
import { z } from "zod";
import * as schema from "#/db/schema";
import { w } from "#/kit/words";

/** What a note may be given: a form's values and what the app fills (an action's set). */
export const noteSettable = createInsertSchema(schema.notes, {
  title: (s) => s.trim().min(1, w.required).max(200, w.atMostCharacters(200)),
  body: (s) => s.max(10000, w.atMostCharacters(10000)),
  attachment: z.object({ file: z.string().regex(/^note\\/[a-f0-9]{24}\\.[a-z0-9]{2,4}$/), name: z.string().max(200), type: z.string().max(100), size: z.int().nonnegative(), receipt: z.string().max(64).optional() }).nullish(),
}).omit({ id: true, ownerId: true, createdAt: true, updatedAt: true });
/** What a note's form sends, checked. */
export const noteSchema = noteSettable;

export type NoteSettable = z.output<typeof noteSettable>;
export type NoteValues = z.output<typeof noteSchema>;
"
`;

exports[`../../../examples/api/smithable.yml > file list and generated code > src/generated/note.server.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { type AnyColumn, and, asc, avg, count, desc, eq, inArray, isNotNull, max, min, sql, sum, type SQL } from "drizzle-orm";
import { db } from "#/db";
import * as schema from "#/db/schema";
import { AccessDenied, allows, check, Conflict, type ModelAccess, personOf, readScope, type Viewer } from "#/kit/access";
import { audit, changedFields } from "#/kit/audit.server";
import { refusal } from "#/kit/log.server";
import { contains } from "#/kit/search";
import { BadInput } from "#/kit/refusal";
import { aggregate, type Filterable, nearest, sortOf, whereOf, wordsOf } from "#/kit/where";
import { deleteFile } from "#/kit/uploads";
import { acceptFiles } from "#/kit/receipts.server";
import { afterChange, afterDelete } from "./hooks";
import { projectData } from "./project.server";
import { type NoteSettable } from "./note";

/** Who may read, create, change and delete notes. */
export const noteAccess: ModelAccess = {
  read: { public: false, roles: ["admin", "member", "assistant"], owner: false },
  create: { public: false, roles: ["admin", "member", "assistant"], owner: false },
  write: { public: false, roles: ["admin", "member", "assistant"], owner: true },
  delete: { public: false, roles: ["admin", "member"], owner: true },
};

/** A record as the viewer gets it: who owns it only for its owner and roles that read every record. */
function shownTo<R extends { ownerId: string | null }>(viewer: Viewer | null, row: R): R {
  if ((viewer && row.ownerId === viewer.id) || (!!viewer && (!!viewer.system || noteAccess.read.roles.includes(viewer.role)))) return row;
  return { ...row, ownerId: null };
}


/** What \`where\` may name, and how: the stored fields, by kind. */
const FILTERABLE: Record<string, Filterable> = {
  title: { kind: "text", column: schema.notes.title },
  project: { kind: "reference", column: schema.notes.projectId },
  body: { kind: "text", column: schema.notes.body },
};

/** What the records can be sorted by. */
const SORTABLE = { id: schema.notes.id, title: schema.notes.title, body: schema.notes.body, createdAt: schema.notes.createdAt };

/** The number fields \`measure\` adds up; amounts are stored in cents. */
const NUMBERS: Record<string, AnyColumn> = {  };
const MONEY: string[] = [];

/** Computed number fields \`measure\` adds up from the records themselves. */
const COMPUTED: string[] = [];

/** The titles of the referenced records \`measureBy\` splits by, to name its groups. */
function titlesOf(viewer: Viewer | null, by: string, ids: number[]): Map<unknown, string> {
  switch (by) {
    case "project":
      return new Map(db.select({ id: schema.projects.id, title: schema.projects.name }).from(schema.projects).where(and(inArray(schema.projects.id, ids), projectData.readable(viewer))).all().map((r) => [r.id, String(r.title)]));
    default:
      return new Map();
  }
}

/** What \`measureBy\` may split by: choices, yes/no, references, and dates by month. */
const BY: string[] = ["project"];


/** Each picture or document new to the record must come with the receipt its upload gave the viewer (src/kit/receipts.server.ts); the receipts are not kept. */
function checkFiles<V extends Partial<NoteSettable>>(viewer: Viewer | null, values: V, before?: Record<string, unknown>): V {
  return {
    ...values,
    ...("attachment" in values ? { attachment: acceptFiles(viewer, "note", "attachment", values.attachment, before?.attachment) } : {}),
  };
}

/** Checks that the viewer may read the records the values refer to. */
function checkReferences(viewer: Viewer | null, values: Partial<NoteSettable>): void {
  if (values.projectId != null && !projectData.canRead(viewer, values.projectId))
    throw new AccessDenied(viewer !== null);
}

/** \`rows\` with each \`field\` reference \`readable\` leaves out set to nothing (only its id stays). */
function hideRefs<R extends Record<string, unknown>>(rows: R[], field: string, readable: (ids: number[]) => number[]): R[] {
  const idOf = (row: R) => (row[field] as { id?: unknown } | null | undefined)?.id;
  const ids = [...new Set(rows.map(idOf).filter((id): id is number => typeof id === "number"))];
  if (!ids.length) return rows;
  const shown = new Set(readable(ids));
  return rows.map((row) => {
    const id = idOf(row);
    return typeof id === "number" && !shown.has(id) ? { ...row, [field]: null } : row;
  });
}

export const noteData = {
  shownTo,
  /** The rows with each reference to a record the viewer may not read set to nothing: a related record's title is shown only to who may read it (only its id stays). */
  shownRefs<R extends Record<string, unknown>>(viewer: Viewer | null, rows: R[]): R[] {
    return hideRefs(rows, "project", (ids, c = projectData.readable(viewer)) => (c ? db.select({ id: schema.projects.id }).from(schema.projects).where(and(inArray(schema.projects.id, ids), c)).all().map((r) => r.id) : ids));
  },

  /** Whether a stored picture or document is on any record (the trash too): a file no record has may go. */
  uses(file: string): boolean {
    return !!db.select({ id: schema.notes.id }).from(schema.notes).where(sql\`\${schema.notes.attachment} like \${\`%"file":"\${file}"%\`}\`).get();
  },

  /** A condition for the notes the viewer may read. */
  readable(viewer: Viewer | null) {
    const scope = readScope(noteAccess.read, viewer);
    if (scope === "all") return undefined;
    return scope === "own" && viewer ? eq(schema.notes.ownerId, viewer.id) : sql\`false\`;
  },

  canRead(viewer: Viewer | null, id: number): boolean {
    const found = db
      .select({ id: schema.notes.id })
      .from(schema.notes)
      .where(and(eq(schema.notes.id, id), noteData.readable(viewer)))
      .get();
    return found !== undefined;
  },

  /** The notes the viewer may read; \`where\` narrows them, e.g. to a search; \`limit\` keeps the newest (a data page). */
  async list(viewer: Viewer | null, where?: SQL, limit?: number) {
    if (readScope(noteAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const found = noteData.shownRefs(viewer, await db.query.notes.findMany({
      where: and(noteData.readable(viewer), where),
      with: { project: { columns: { id: true, name: true } } },
      orderBy: (t, { desc }) => [desc(t.id)],
      limit,
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return rows;
  },

  /**
   * The notes the viewer may read that fit \`where\` and \`search\`, in \`sort\`'s order (else newest
   * first), a page of them and how many there are: for the API and the assistants' tools.
   */
  async find(
    viewer: Viewer | null,
    options: { where?: unknown; search?: string; sort?: string; limit?: number; offset?: number } = {},
  ) {
    if (readScope(noteAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = noteData.fitting(viewer, options.where, options.search);
    const order = sortOf(SORTABLE, options.sort);
    const total = db.select({ n: count() }).from(schema.notes).where(condition).get()?.n ?? 0;
    const found = noteData.shownRefs(viewer, await db.query.notes.findMany({
      where: condition,
      with: { project: { columns: { id: true, name: true } } },
      orderBy: (t, { desc }) => [...(order ? [order] : []), desc(t.id)],
      limit: options.limit ?? 100,
      offset: options.offset ?? 0,
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return { items: rows, total };
  },

  /**
   * A number from the notes the viewer may read that fit \`where\`: how many, or the sum,
   * average, smallest or largest of a number field.
   */
  async measure(
    viewer: Viewer | null,
    how: "count" | "sum" | "average" | "smallest" | "largest",
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<number | null> {
    if (readScope(noteAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = noteData.fitting(viewer, options.where, options.search);
    if (how === "count")
      return db.select({ n: count() }).from(schema.notes).where(condition).get()?.n ?? 0;
    const field = options.field ?? "";
    const money = MONEY.includes(field);
    if (COMPUTED.includes(field)) {
      const rows = await noteData.computedRows(condition);
      const value = aggregate(rows.map((row) => row[field]), how);
      return value === null ? null : money ? value / 100 : value;
    }
    const column = Object.hasOwn(NUMBERS, field) ? NUMBERS[field] : undefined;
    if (!column)
      throw new BadInput(
        \`\${how} needs a number field: \${[...Object.keys(NUMBERS), ...COMPUTED].join(", ") || "there are none"}.\`,
      );
    const pick = { sum, average: avg, smallest: min, largest: max }[how];
    const value = db.select({ v: pick(column) }).from(schema.notes).where(condition).get()?.v;
    if (value === null || value === undefined) return null;
    return money ? Number(value) / 100 : Number(value);
  },

  /** Which record holds the smallest or largest value of a number field (the first of a tie). */
  async holder(
    viewer: Viewer | null,
    how: "smallest" | "largest",
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<{ id: number; title: string } | null> {
    const condition = noteData.fitting(viewer, options.where, options.search);
    const field = options.field ?? "";
    if (COMPUTED.includes(field)) {
      let best: Record<string, unknown> | undefined;
      for (const row of await noteData.computedRows(condition)) {
        const v = row[field];
        if (typeof v !== "number") continue;
        if (!best || (how === "largest" ? v > (best[field] as number) : v < (best[field] as number))) best = row;
      }
      return best ? { id: best.id as number, title: String(best.title) } : null;
    }
    const column = Object.hasOwn(NUMBERS, field) ? NUMBERS[field] : undefined;
    if (!column) return null;
    const row = db
      .select({ id: schema.notes.id, title: schema.notes.title })
      .from(schema.notes)
      .where(and(condition, isNotNull(column)))
      .orderBy(how === "largest" ? desc(column) : asc(column), asc(schema.notes.id))
      .limit(1)
      .get();
    return row ? { id: row.id, title: String(row.title) } : null;
  },

  /**
   * The same number per value of a field (a choice, yes/no, a reference) or per month of a date:
   * \`[{ value, number }]\`, the most first.
   */
  async measureBy(
    viewer: Viewer | null,
    how: "count" | "sum" | "average" | "smallest" | "largest",
    by: string,
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<{ value: unknown; title?: string; number: number | null }[]> {
    if (readScope(noteAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const split = Object.hasOwn(FILTERABLE, by) ? FILTERABLE[by] : undefined;
    if (!split || split.kind === "text" || split.kind === "number" || split.kind === "money")
      throw new BadInput(\`There is no field "\${by}" to split by. Fields: \${BY.join(", ")}.\`);
    const field = options.field ?? "";
    const money = MONEY.includes(field);
    const condition = noteData.fitting(viewer, options.where, options.search);
    const amount = (n: number | null) => (n === null ? null : money ? n / 100 : n);
    const most = (a: { number: number | null }, b: { number: number | null }) => (b.number ?? 0) - (a.number ?? 0);
    // A reference's groups carry the referenced record's title beside its id.
    const named = (rows: { value: unknown; number: number | null }[]) => {
      if (split.kind !== "reference") return rows;
      const titles = titlesOf(viewer, by, rows.map((r) => r.value).filter((v): v is number => typeof v === "number"));
      return rows.map((r) => (titles.has(r.value) ? { value: r.value, title: titles.get(r.value), number: r.number } : r));
    };
    if (COMPUTED.includes(field)) {
      // Each record's month or value, then the computed numbers added up per group.
      const groups = new Map<unknown, unknown[]>();
      for (const row of await noteData.computedRows(condition)) {
        const raw = row[split.kind === "reference" ? \`\${by}Id\` : by];
        const value = split.kind === "date" ? String(raw ?? "").slice(0, 7) || null : split.kind === "instant" ? (raw instanceof Date ? raw.toISOString().slice(0, 7) : null) : raw;
        groups.set(value, [...(groups.get(value) ?? []), row[field]]);
      }
      return named([...groups].map(([value, numbers]) => ({ value, number: amount(aggregate(numbers, how)) })).sort(most));
    }
    const key = split.kind === "date" ? sql<string>\`substr(\${split.column}, 1, 7)\` : split.kind === "instant" ? sql<string>\`strftime('%Y-%m', \${split.column} / 1000, 'unixepoch')\` : sql\`\${split.column}\`;
    const column = Object.hasOwn(NUMBERS, field) ? NUMBERS[field] : undefined;
    if (how !== "count" && !column)
      throw new BadInput(\`\${how} needs a number field: \${[...Object.keys(NUMBERS), ...COMPUTED].join(", ") || "there are none"}.\`);
    const pick = how === "count" || !column ? count() : { sum, average: avg, smallest: min, largest: max }[how](column);
    return named(
      db
        .select({ value: key, number: pick })
        .from(schema.notes)
        .where(condition)
        .groupBy(key)
        .all()
        .map((r) => ({ value: r.value, number: r.number === null ? null : amount(Number(r.number)) }))
        .sort(most),
    );
  },

  /**
   * The records that fit, with their computed fields worked out: for adding those up. At most
   * 10,000, so one call never reads a whole large table; more are refused with how to narrow them.
   */
  async computedRows(condition: SQL | undefined): Promise<Record<string, unknown>[]> {
    const rows = await db.query.notes.findMany({ where: condition, with: { project: { columns: { id: true, name: true } } }, limit: 10001 });
    if (rows.length > 10000)
      throw new BadInput("More than 10,000 records to add up a computed field over: narrow them with where.");
    return rows.map((row) => row as Record<string, unknown>);
  },

  /** The notes the viewer may read whose title has the text: a few, for naming one. */
  named(viewer: Viewer | null, text: string): { id: number; title: string }[] {
    return db
      .select({ id: schema.notes.id, title: schema.notes.title })
      .from(schema.notes)
      .where(and(noteData.readable(viewer), contains([schema.notes.title], text)))
      .limit(6)
      .all()
      .map((row) => ({ id: row.id, title: String(row.title) }));
  },

  /** Every title the viewer may read (at most 2,000): the nearest when a name fits none. */
  titles(viewer: Viewer | null): string[] {
    return db
      .select({ title: schema.notes.title })
      .from(schema.notes)
      .where(noteData.readable(viewer))
      .limit(2000)
      .all()
      .map((row) => String(row.title));
  },

  /** Why \`where\` found none when it names a text no record has: the field's nearest values. */
  whyNone(viewer: Viewer | null, where: unknown): string | undefined {
    if (!where || typeof where !== "object") return undefined;
    for (const [name, v] of Object.entries(where)) {
      const field = Object.hasOwn(FILTERABLE, name) ? FILTERABLE[name] : undefined;
      if (field?.kind !== "text" || (typeof v !== "string" && typeof v !== "number")) continue;
      const values = db
        .selectDistinct({ v: sql<string>\`\${field.column}\` })
        .from(schema.notes)
        .where(and(noteData.readable(viewer), isNotNull(field.column)))
        .limit(2000)
        .all()
        .map((row) => String(row.v));
      const asked = String(v);
      if (values.length && !values.some((x) => x.toLowerCase().includes(asked.toLowerCase())))
        return \`No note has "\${asked}" in \${name}; the nearest: \${nearest(asked, values).join(", ")}.\`;
    }
    return undefined;
  },

  /** The condition for records the viewer may read that fit \`where\` and \`search\`. */
  fitting(viewer: Viewer | null, where?: unknown, search?: string) {
    return and(
      noteData.readable(viewer),
      whereOf(FILTERABLE, where, viewer ? eq(schema.notes.ownerId, viewer.id) : undefined, viewer?.id, {project: { find: (text: string) => projectData.named(viewer, text), titles: () => projectData.titles(viewer) }}),
      // Every word somewhere in the texts ("ship lamp" finds "ship's lamp").
      ...wordsOf(search).map((word) => contains([schema.notes.title, schema.notes.body], word)),
    );
  },

  /** How many notes the viewer may read, for a data page's overview; none to read: null. */
  count(viewer: Viewer | null): number | null {
    if (readScope(noteAccess.read, viewer) === "none") return null;
    return db.select({ n: count() }).from(schema.notes).where(noteData.readable(viewer)).get()?.n ?? 0;
  },

  async get(viewer: Viewer | null, id: number) {
    const fetched = await db.query.notes.findFirst({
      where: and(eq(schema.notes.id, id), noteData.readable(viewer)),
      with: { project: { columns: { id: true, name: true } } },
    });
    const found = fetched && noteData.shownRefs(viewer, [fetched])[0];
    const row = found && shownTo(viewer, found);
    return row ? row : null;
  },

  async create(viewer: Viewer | null, values: NoteSettable) {
    check(noteAccess.create, viewer);
    values = checkFiles(viewer, values);
    checkReferences(viewer, values);
    let row: typeof schema.notes.$inferSelect;
    try {
      row = db.transaction((tx) => {
        const made = tx.insert(schema.notes).values({ ...values, ownerId: personOf(viewer) }).returning().get();
        audit(tx, viewer, { action: "created", model: "Note", record: made.id });
        return made;
      });
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterCreate", "Note", row, viewer);
    return row;
  },

  /** Changes the record; \`what\` names the change in the audit log (an action's name). */
  /** Changes the fields given; what names the action ("changed" for a form), frees the fields it may change although locked (its own set). */
  async update(viewer: Viewer | null, id: number, values: Partial<NoteSettable>, what = "changed", _frees: readonly string[] = []) {
    const row = db
      .select({ ownerId: schema.notes.ownerId, attachment: schema.notes.attachment })
      .from(schema.notes)
      .where(and(eq(schema.notes.id, id), noteData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    // A form's change needs write on the record; an action (what names it) checked its own access
    // first, which includes the roles its grant names (docs/design/actions.md, Access).
    if (what === "changed") check(noteAccess.write, viewer, row.ownerId);
    values = checkFiles(viewer, values, db.select({ attachment: schema.notes.attachment }).from(schema.notes).where(eq(schema.notes.id, id)).get());
    checkReferences(viewer, values);
    let changed: typeof schema.notes.$inferSelect;
    const updated = values;
    try {
      changed = db.transaction((tx) => {
        // Read again in the change itself: a record that left the viewer's reach meanwhile is refused.
        const before = tx.select().from(schema.notes).where(and(eq(schema.notes.id, id), noteData.readable(viewer))).get();
        if (!before) throw new AccessDenied(viewer !== null);
        const after = tx.update(schema.notes).set(updated).where(eq(schema.notes.id, id)).returning().get();
        audit(tx, viewer, { action: what, model: "Note", record: id, fields: before && changedFields(before, after, Object.keys(updated)) });
        return after;
      });
    } catch (error) {
      throw refusal(error);
    }
    if (row.attachment && row.attachment.file !== changed.attachment?.file) deleteFile(row.attachment, !!db.select({ id: schema.notes.id }).from(schema.notes).where(sql\`\${schema.notes.attachment} like \${\`%"file":"\${row.attachment.file}"%\`}\`).get());
    await afterChange("afterUpdate", "Note", changed, viewer);
    return changed;
  },

  /** Deletes the record; \`together\` takes the records that point to it along to the trash (delete-together.md). */
  async remove(viewer: Viewer | null, id: number, _together = false): Promise<void> {
    const row = db
      .select({ ownerId: schema.notes.ownerId, attachment: schema.notes.attachment })
      .from(schema.notes)
      .where(and(eq(schema.notes.id, id), noteData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(noteAccess.delete, viewer, row.ownerId);
    try {
      db.transaction((tx) => {
        // Read again in the change itself: a record that left the viewer's reach meanwhile is refused.
        if (!tx.select({ id: schema.notes.id }).from(schema.notes).where(and(eq(schema.notes.id, id), noteData.readable(viewer))).get())
          throw new AccessDenied(viewer !== null);
        const gone = tx.delete(schema.notes).where(eq(schema.notes.id, id)).returning().get();
        if (gone) {
          audit(tx, viewer, { action: "deleted", model: "Note", record: id, title: gone.title });
        }
      });
    } catch (error) {
      throw refusal(error);
    }
    if (row.attachment && row.attachment.file !== undefined) deleteFile(row.attachment, !!db.select({ id: schema.notes.id }).from(schema.notes).where(sql\`\${schema.notes.attachment} like \${\`%"file":"\${row.attachment.file}"%\`}\`).get());
    await afterDelete("Note", id, viewer);
  },

  /**
   * Deletes the chosen records the viewer may delete, all or none (one still in use stops them
   * all, and is named); the others are skipped.
   */
  async removeMany(viewer: Viewer | null, ids: number[], _together = false): Promise<{ deleted: number; skipped: number }> {
    const rows = db
      .select({ id: schema.notes.id, ownerId: schema.notes.ownerId, attachment: schema.notes.attachment })
      .from(schema.notes)
      .where(and(inArray(schema.notes.id, ids), noteData.readable(viewer)))
      .all()
      .filter((row) => allows(noteAccess.delete, viewer, row.ownerId));
    db.transaction((tx) => {
      for (const row of rows)
        try {
          const gone = tx.delete(schema.notes).where(eq(schema.notes.id, row.id)).returning().get();
          if (gone) {
            audit(tx, viewer, { action: "deleted", model: "Note", record: row.id, title: gone.title });
          }
        } catch (error) {
          const refused = refusal(error);
          throw refused instanceof Conflict && refused.message === "in-use" ? new Conflict(\`in-use:\${row.id}\`) : refused;
        }
    });
    for (const row of rows) {
      if (row.attachment && row.attachment.file !== undefined) deleteFile(row.attachment, !!db.select({ id: schema.notes.id }).from(schema.notes).where(sql\`\${schema.notes.attachment} like \${\`%"file":"\${row.attachment.file}"%\`}\`).get());
      await afterDelete("Note", row.id, viewer);
    }
    return { deleted: rows.length, skipped: new Set(ids).size - rows.length };
  },
};
"
`;

exports[`../../../examples/api/smithable.yml > file list and generated code > src/generated/note.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { z } from "zod";
import type * as schema from "#/db/schema";
import { allows, type Rule } from "#/kit/access";
import type { RecordUi } from "#/kit/model";
import { bindFile } from "#/kit/FileInput";
import { noteAccess, noteData } from "./note.server";
import { writeAllowed } from "#/kit/limit";
import { currentViewer } from "#/lib/viewer.server";
import { noteSchema } from "./note.schema";

export type { NoteSettable, NoteValues } from "./note.schema";

/** The viewer about to write, counted against how often one may (see src/kit/limit.ts). */
async function writer() {
  const viewer = await currentViewer();
  writeAllowed(viewer, getRequestHeaders());
  return viewer;
}

/** Note records as the kit reads them. */
export type NoteRow = typeof schema.notes.$inferSelect & {
  project?: { id: number; name: string } | null;
};

export const noteUi: RecordUi<NoteRow> = {
  model: "Note",
  label: "Note",
  pluralLabel: "Notes",
  titleField: "title",
  columns: ["title", "projectId"],
  fields: [
    {
      name: "title",
      label: "Title",
      kind: "string",
      required: true,
      get: (row) => row.title,
    },
    {
      name: "projectId",
      label: "Project",
      kind: "relation",
      required: true,
      relation: { key: "project", titleField: "name" },
      get: (row) => row.project?.name ?? null,
    },
    {
      name: "body",
      label: "Body",
      kind: "text",
      required: false,
      get: (row) => row.body,
    },
    {
      name: "attachment",
      label: "Attachment",
      kind: "file",
      required: false,
      input: bindFile("note", "attachment"),
      get: (row) => row.attachment,
    },
  ],
};

/** Who may delete notes: a list's selection offers Delete by it (the server checks again). */
export const noteDeleteRule: Rule = { public: false, roles: ["admin", "member"], owner: true };


export const listNotes = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return { rows: await noteData.list(viewer), canCreate: allows(noteAccess.create, viewer) };
});

export const getNote = createServerFn()
  .validator(z.number().int())
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    const row = await noteData.get(viewer, id);
    if (!row) return null;
    return {
      row,
      canWrite: allows(noteAccess.write, viewer, row.ownerId),
      canDelete: allows(noteAccess.delete, viewer, row.ownerId),
    };
  });

export const createNote = createServerFn({ method: "POST" })
  .validator(noteSchema)
  .handler(async ({ data }) => noteData.create(await writer(), data));

export const updateNote = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), values: noteSchema }))
  .handler(async ({ data }) => noteData.update(await writer(), data.id, data.values));

/** Deletes a note; \`together\` takes what points to it along (docs/design/delete-together.md). */
export const deleteNote = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), together: z.boolean().optional() }))
  .handler(async ({ data }) => noteData.remove(await writer(), data.id, data.together));

/** Deletes the chosen notes, all or none (at most 1,000 at once). */
export const deleteNotes = createServerFn({ method: "POST" })
  .validator(z.object({ ids: z.array(z.number().int()).max(1000), together: z.boolean().optional() }))
  .handler(async ({ data }) => noteData.removeMany(await writer(), data.ids, data.together));
"
`;

