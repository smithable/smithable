"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createInsertSchema } from "drizzle-zod";
import { z } from "zod";
import * as schema from "#/db/schema";
import { w } from "#/kit/words";

/** What a customer may be given: a form's values and what the app fills (an action's set). */
export const customerSettable = createInsertSchema(schema.customers, {
  name: (s) => s.trim().min(1, w.required).max(200, w.atMostCharacters(200)),
  email: z.email(w.enterValidEmail).nullish(),
  phone: (s) => s.regex(/^\\+?[0-9 ()-]{5,20}$/, w.enterValidPhone),
  creditLimit: (s) => s.min(0),
  notes: (s) => s.max(10000, w.atMostCharacters(10000)),
}).omit({ id: true, createdAt: true, updatedAt: true });
/** What a customer's form sends, checked. */
export const customerSchema = customerSettable;

export type CustomerSettable = z.output<typeof customerSettable>;
export type CustomerValues = z.output<typeof customerSchema>;
"
`;

