describe("the decline action", () => {
  test("admin", async () => {
    const viewer = signedIn("admin");
    const ask = () => {
      const n = next();
      return { "reason": \`Order reason \${n}\` };
    };
    const others = insertOrder(stranger.id, {"status":"new"});
    const own = insertOrder(viewer.id, {"status":"new"});
    expect({
      others: await can(() => runDecline(viewer, others.id, ask())),
      own: await can(() => runDecline(viewer, own.id, ask())),
    }).toEqual({ others: true, own: true });
  });

  test("staff", async () => {
    const viewer = signedIn("staff");
    const ask = () => {
      const n = next();
      return { "reason": \`Order reason \${n}\` };
    };
    const others = insertOrder(stranger.id, {"status":"new"});
