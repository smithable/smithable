import { contains } from "#/kit/search";
import { inArray, and, eq, or, isNull, asc } from "drizzle-orm";
import { db } from "#/db";
import { inRange, orderOf } from "#/kit/filter";
import { currentViewer } from "#/lib/viewer.server";
import { type Search, count, listQuery, optional, text } from "#/kit/params";
import { buttonVariants } from "#/components/ui/button";
import { assignToMe, assignToMeAccess, assignToMeFits, assignToMeMany } from "#/generated/actions/assign-to-me";
import { assignTo, assignToAccess, assignToFits, assignToAskUi, assignToAsks, assignToAskOptions, assignToMany } from "#/generated/actions/assign-to";
import { startWork, startWorkAccess, startWorkFits, startWorkAskUi, startWorkAsks, startWorkAskOptions, startWorkMany } from "#/generated/actions/start-work";
import { close, closeAccess, closeFits, closeAskUi, closeAsks, closeAskOptions, closeMany } from "#/generated/actions/close";
import { reopen, reopenAccess, reopenFits, reopenMany } from "#/generated/actions/reopen";
import { ActionButton } from "#/kit/ActionButton";
import { Overflow } from "#/kit/Overflow";
import { useState } from "react";
import { SelectionBar } from "#/kit/SelectionBar";
import { csvName, csvOf, download } from "#/kit/csv";
import { deleteSupportCases, supportCaseDeleteRule, supportCaseUi } from "#/generated/support-case";
import { app } from "#/generated/app";
import { w } from "#/kit/words";
import { PageHeader } from "#/kit/AppShell";
import { ModelTable } from "#/kit/ModelTable";
import { SearchBox } from "#/kit/SearchBox";
import { Filters } from "#/kit/Filters";

/** The support cases matching the search and the filters, among those the viewer may read. */
const searchSupportCases = createServerFn()
  .validator(listQuery)
  .handler(async ({ data }) => {
    const viewer = await currentViewer();
    const where = and(
      data.q ? contains([schema.supportCases.subject, schema.supportCases.customerEmail], data.q) : undefined,
      data.f?.status ? inArray(schema.supportCases.status, data.f?.status.split(",").filter((v) => ["open", "inProgress", "closed", "reopened"].includes(v)) as ("open" | "inProgress" | "closed" | "reopened")[]) : undefined,
      data.f?.priority ? inRange(schema.supportCases.priority, data.f?.priority, "number") : undefined,
      data.f?.assignee ? or(...data.f?.assignee.split(",").map((v) => (v === "me" ? eq(schema.supportCases.assigneeId, viewer?.id ?? "") : v === "none" ? isNull(schema.supportCases.assigneeId) : eq(schema.supportCases.assigneeId, v)))) : undefined,
    );
    // The order the viewer chose, among the fields the page offers; else the newest first.
    const order = orderOf({ priority: schema.supportCases.priority, createdAt: schema.supportCases.createdAt }, data.sort);
    return {
      ...(await supportCaseData.page(viewer, where, order, data.all ? 1 : data.page, data.all ? (viewer ? 10000 : 500) : undefined)),
      canCreate: allows(supportCaseAccess.create, viewer),
      options: { assignee: viewer ? db.select({ value: schema.user.id, label: schema.user.name }).from(schema.user).orderBy(asc(schema.user.name)).all() : [] },
    };
  });

export const Route = createFileRoute("/cases/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["cases"], context.viewer, location.href),
  head: () => pageHead("cases"),
  validateSearch: (s: Search) => optional({ q: text(s.q), sort: text(s.sort), status: text(s.status), priority: text(s.priority), assignee: text(s.assignee), page: count(s.page) }),
  loaderDeps: ({ search }) => search,
  loader: ({ deps: { q, sort, page, ...f } }) => searchSupportCases({ data: { q, sort, f, page } }),
  // While a search or filter loads, the page stays (and its controls keep their focus).
  pendingMs: Number.POSITIVE_INFINITY,
  gcTime: 0,
  component: CasesPage,
});

function CasesPage() {
  const { rows, canCreate, total, page: at, size, options } = Route.useLoaderData();
  const { q, sort, page: _page, ...values } = Route.useSearch();
  const { viewer } = Route.useRouteContext();
  const navigate = useNavigate({ from: "/cases/" });
  const router = useRouter();
  // The chosen rows, offered when the viewer may do something to at least one row.
  const [selected, setSelected] = useState<Set<number>>(new Set());
  const chosen = rows.filter((row) => selected.has(row.id));
  const selectable = rows.some((row) => allows(assignToMeAccess, viewer, row.ownerId) && assignToMeFits(row, viewer) || allows(assignToAccess, viewer, row.ownerId) && assignToFits(row, viewer) || allows(startWorkAccess, viewer, row.ownerId) && startWorkFits(row, viewer) || allows(closeAccess, viewer, row.ownerId) && closeFits(row, viewer) || allows(reopenAccess, viewer, row.ownerId) && reopenFits(row, viewer) || allows(supportCaseDeleteRule, viewer, row.ownerId));
  const newButton = canCreate && (
    <Link to="/cases/new" className={buttonVariants()}>
      {w.newOne("support case")}
    </Link>
  );
  return (
    <>
      <PageHeader
        page="cases"
        title={pageUi["cases"].title}
        actions={newButton}
      />
      <SearchBox
        value={q ?? ""}
        placeholder="Search by subject or customer email"
        onSearch={(text) => navigate({ to: "/cases", search: (prev) => ({ ...prev, q: text || undefined, page: undefined }), replace: true, resetScroll: false })}
      />
      <Filters
        filters={[
  {
    name: "status",
    label: "Status",
    kind: "chips",
    options: supportCaseUi.fields.find((f) => f.name === "status")?.choices,
  },
  { name: "priority", label: "Priority", kind: "range", input: "number" },
  {
    name: "assignee",
    label: "Assignee",
    kind: "person",
    options: options.assignee,
  },
]}
        values={values}
        sorts={[
  { value: "priority", label: "Priority, low to high" },
  { value: "-priority", label: "Priority, high to low" },
  { value: "createdAt", label: "Added, oldest first" },
  { value: "-createdAt", label: "Added, newest first" },
]}
        sort={sort}
        onChange={(next) => navigate({ to: "/cases", search: { q, ...next }, replace: true, resetScroll: false })}
      />
      {selectable && (
        <SelectionBar
          count={chosen.length}
          noun={["support case", "support cases"]}
          app={app}
          titleOf={(id) => String(rows.find((row) => row.id === id)?.subject ?? id)}
          actions={[
            {
              label: "Assign to me",
              concept: "action:assignToMe",
              applies: chosen.filter((row) => allows(assignToMeAccess, viewer, row.ownerId) && assignToMeFits(row, viewer)).length,
              run: () => assignToMeMany({ data: { ids: chosen.map((row) => row.id) } }),
            },
            {
              label: "Assign to",
              concept: "action:assignTo",
              applies: chosen.filter((row) => allows(assignToAccess, viewer, row.ownerId) && assignToFits(row, viewer)).length,
              ask: { ui: assignToAskUi, schema: assignToAsks, loadOptions: assignToAskOptions },
              run: (values) => assignToMany({ data: { ids: chosen.map((row) => row.id), values: values as never } }),
            },
            {
              label: "Start work",
              concept: "action:startWork",
              applies: chosen.filter((row) => allows(startWorkAccess, viewer, row.ownerId) && startWorkFits(row, viewer)).length,
              ask: { ui: startWorkAskUi, schema: startWorkAsks, loadOptions: startWorkAskOptions },
              run: (values) => startWorkMany({ data: { ids: chosen.map((row) => row.id), values: values as never } }),
            },
            {
              label: "Close",
              concept: "action:close",
              applies: chosen.filter((row) => allows(closeAccess, viewer, row.ownerId) && closeFits(row, viewer)).length,
              ask: { ui: closeAskUi, schema: closeAsks, loadOptions: closeAskOptions },
              run: (values) => closeMany({ data: { ids: chosen.map((row) => row.id), values: values as never } }),
            },
            {
              label: "Reopen",
              concept: "action:reopen",
              applies: chosen.filter((row) => allows(reopenAccess, viewer, row.ownerId) && reopenFits(row, viewer)).length,
              run: () => reopenMany({ data: { ids: chosen.map((row) => row.id) } }),
            },
          ]}
          deletable={chosen.filter((row) => allows(supportCaseDeleteRule, viewer, row.ownerId)).length}
          onDelete={(together) => deleteSupportCases({ data: { ids: chosen.map((row) => row.id), together } })}
          onDone={async () => {
            setSelected(new Set());
            await router.invalidate();
          }}
          onExport={() => download(csvName(supportCaseUi), csvOf(supportCaseUi, chosen))}
        />
      )}
      <ModelTable
        ui={supportCaseUi}
        page="cases"
        paging={{ page: at, size, total, to: (next) => navigate({ to: "/cases", search: (prev) => ({ ...prev, page: next > 1 ? next : undefined }) }) }}
        app={app}
        exportRows={async () => (await searchSupportCases({ data: { q, sort, f: values, all: true } })).rows}
        rows={rows}
        sorting={{ keys: { priority: "priority" }, value: sort, onChange: (next) => navigate({ to: "/cases", search: (prev) => ({ ...prev, sort: next, page: undefined }), replace: true, resetScroll: false }) }}
        selection={selectable ? { ids: selected, onChange: setSelected } : undefined}
        rowActions={(row) => (
          <Overflow inRow>
            {allows(assignToMeAccess, viewer, row.ownerId) && assignToMeFits(row, viewer) && (
              <ActionButton
                label="Assign to me"
                concept="action:assignToMe"
                onRun={async () => {
                  await assignToMe({ data: row.id });
                  await router.invalidate();
                }}
              />
            )}
            {allows(assignToAccess, viewer, row.ownerId) && assignToFits(row, viewer) && (
              <ActionButton
                label="Assign to"
                concept="action:assignTo"
                ask={{ ui: assignToAskUi, schema: assignToAsks, initial: row, app, loadOptions: assignToAskOptions }}
                onRun={async (values) => {
                  await assignTo({ data: { id: row.id, values: values as never } });
                  await router.invalidate();
                }}
              />
            )}
            {allows(startWorkAccess, viewer, row.ownerId) && startWorkFits(row, viewer) && (
              <ActionButton
                label="Start work"
                concept="action:startWork"
                ask={{ ui: startWorkAskUi, schema: startWorkAsks, initial: row, app, loadOptions: startWorkAskOptions }}
                onRun={async (values) => {
                  await startWork({ data: { id: row.id, values: values as never } });
                  await router.invalidate();
                }}
              />
            )}
            {allows(closeAccess, viewer, row.ownerId) && closeFits(row, viewer) && (
              <ActionButton
                label="Close"
                concept="action:close"
                ask={{ ui: closeAskUi, schema: closeAsks, initial: row, app, loadOptions: closeAskOptions }}
                onRun={async (values) => {
                  await close({ data: { id: row.id, values: values as never } });
                  await router.invalidate();
                }}
              />
            )}
            {allows(reopenAccess, viewer, row.ownerId) && reopenFits(row, viewer) && (
              <ActionButton
                label="Reopen"
                concept="action:reopen"
                onRun={async () => {
                  await reopen({ data: row.id });
                  await router.invalidate();
                }}
              />
            )}
          </Overflow>
        )}
        emptyMessage={q || Object.values(values).some(Boolean) ? "No support cases match the search and filters." : undefined}
        emptyAction={newButton || undefined}
        onOpen={(row) => navigate({ to: "/cases/$id", params: { id: String(row.id) } })}
      />
    </>
  );
}
"
`;

