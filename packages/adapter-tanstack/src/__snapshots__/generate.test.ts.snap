"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createInsertSchema } from "drizzle-zod";
import type { z } from "zod";
import * as schema from "#/db/schema";
import { w } from "#/kit/words";

/** What a invoice line may be given: a form's values and what the app fills (an action's set). */
export const invoiceLineSettable = createInsertSchema(schema.invoiceLines, {
  description: (s) => s.trim().min(1, w.required).max(200, w.atMostCharacters(200)),
}).omit({ id: true, ownerId: true, createdAt: true, updatedAt: true });
/** What a invoice line's form sends, checked. */
export const invoiceLineSchema = invoiceLineSettable;

export type InvoiceLineSettable = z.output<typeof invoiceLineSettable>;
export type InvoiceLineValues = z.output<typeof invoiceLineSchema>;
"
`;

exports[`../../../examples/invoicing/smithable.yml > file list and generated code > src/generated/invoice-line.server.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { type AnyColumn, and, asc, avg, count, desc, eq, inArray, isNotNull, max, min, sql, sum, type SQL } from "drizzle-orm";
import { db } from "#/db";
import * as schema from "#/db/schema";
import { AccessDenied, allows, check, Conflict, type ModelAccess, personOf, readScope, type Viewer } from "#/kit/access";
import { audit, changedFields } from "#/kit/audit.server";
import { refusal } from "#/kit/log.server";
import { contains } from "#/kit/search";
import { BadInput } from "#/kit/refusal";
import { aggregate, type Filterable, nearest, sortOf, whereOf, wordsOf } from "#/kit/where";
import { afterChange, afterDelete } from "./hooks";
import { invoiceData } from "./invoice.server";
import { type InvoiceLineSettable } from "./invoice-line";
import { withInvoiceLineFormulas } from "./invoice-line.formulas";
import "./timers.server";

/** Who may read, create, change and delete invoice lines. */
export const invoiceLineAccess: ModelAccess = {
  read: { public: false, roles: ["admin"], owner: true },
  create: { public: false, roles: ["admin", "member"], owner: false },
  write: { public: false, roles: ["admin"], owner: true },
  delete: { public: false, roles: ["admin"], owner: true },
};

/** A record as the viewer gets it: who owns it only for its owner and roles that read every record. */
function shownTo<R extends { ownerId: string | null }>(viewer: Viewer | null, row: R): R {
  if ((viewer && row.ownerId === viewer.id) || (!!viewer && (!!viewer.system || invoiceLineAccess.read.roles.includes(viewer.role)))) return row;
  return { ...row, ownerId: null };
}


/** What \`where\` may name, and how: the stored fields, by kind. */
const FILTERABLE: Record<string, Filterable> = {
  invoice: { kind: "reference", column: schema.invoiceLines.invoiceId },
  description: { kind: "text", column: schema.invoiceLines.description },
  quantity: { kind: "number", column: schema.invoiceLines.quantity },
  unitPrice: { kind: "money", column: schema.invoiceLines.unitPrice },
};

/** What the records can be sorted by. */
const SORTABLE = { id: schema.invoiceLines.id, description: schema.invoiceLines.description, quantity: schema.invoiceLines.quantity, unitPrice: schema.invoiceLines.unitPrice, createdAt: schema.invoiceLines.createdAt };

/** The number fields \`measure\` adds up; amounts are stored in cents. */
const NUMBERS: Record<string, AnyColumn> = { quantity: schema.invoiceLines.quantity, unitPrice: schema.invoiceLines.unitPrice };
const MONEY: string[] = ["unitPrice","amount"];

/** Computed number fields \`measure\` adds up from the records themselves. */
const COMPUTED: string[] = ["amount"];

/** The titles of the referenced records \`measureBy\` splits by, to name its groups. */
function titlesOf(viewer: Viewer | null, by: string, ids: number[]): Map<unknown, string> {
  switch (by) {
    case "invoice":
      return new Map(db.select({ id: schema.invoices.id, title: schema.invoices.number }).from(schema.invoices).where(and(inArray(schema.invoices.id, ids), invoiceData.readable(viewer))).all().map((r) => [r.id, String(r.title)]));
    default:
      return new Map();
  }
}

/** What \`measureBy\` may split by: choices, yes/no, references, and dates by month. */
const BY: string[] = ["invoice"];


/** Checks that the viewer may read the records the values refer to. */
function checkReferences(viewer: Viewer | null, values: Partial<InvoiceLineSettable>): void {
  if (values.invoiceId != null && !invoiceData.canRead(viewer, values.invoiceId))
    throw new AccessDenied(viewer !== null);
}

/** \`rows\` with each \`field\` reference \`readable\` leaves out set to nothing (only its id stays). */
function hideRefs<R extends Record<string, unknown>>(rows: R[], field: string, readable: (ids: number[]) => number[]): R[] {
  const idOf = (row: R) => (row[field] as { id?: unknown } | null | undefined)?.id;
  const ids = [...new Set(rows.map(idOf).filter((id): id is number => typeof id === "number"))];
  if (!ids.length) return rows;
  const shown = new Set(readable(ids));
  return rows.map((row) => {
    const id = idOf(row);
    return typeof id === "number" && !shown.has(id) ? { ...row, [field]: null } : row;
  });
}

export const invoiceLineData = {
  shownTo,
  /** The rows with each reference to a record the viewer may not read set to nothing: a related record's title is shown only to who may read it (only its id stays). */
  shownRefs<R extends Record<string, unknown>>(viewer: Viewer | null, rows: R[]): R[] {
    return hideRefs(rows, "invoice", (ids, c = invoiceData.readable(viewer)) => (c ? db.select({ id: schema.invoices.id }).from(schema.invoices).where(and(inArray(schema.invoices.id, ids), c)).all().map((r) => r.id) : ids));
  },

  /** A condition for the invoice lines the viewer may read. */
  readable(viewer: Viewer | null) {
    const scope = readScope(invoiceLineAccess.read, viewer);
    if (scope === "all") return undefined;
    return scope === "own" && viewer ? eq(schema.invoiceLines.ownerId, viewer.id) : sql\`false\`;
  },

  canRead(viewer: Viewer | null, id: number): boolean {
    const found = db
      .select({ id: schema.invoiceLines.id })
      .from(schema.invoiceLines)
      .where(and(eq(schema.invoiceLines.id, id), invoiceLineData.readable(viewer)))
      .get();
    return found !== undefined;
  },

  /** The invoice lines the viewer may read; \`where\` narrows them, e.g. to a search. */
  async list(viewer: Viewer | null, where?: SQL) {
    if (readScope(invoiceLineAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const found = invoiceLineData.shownRefs(viewer, await db.query.invoiceLines.findMany({
      where: and(invoiceLineData.readable(viewer), where),
      with: { invoice: { columns: { id: true, number: true } } },
      orderBy: (t, { desc }) => [desc(t.id)],
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return rows.map(withInvoiceLineFormulas);
  },

  /**
   * A page of the invoice lines the viewer may read that fit \`where\`, newest first (or in
   * \`order\`), and how many fit in all: for a list page. A page past the end is the last one.
   */
  async page(viewer: Viewer | null, where?: SQL, order?: SQL, page = 1, size = 50) {
    if (readScope(invoiceLineAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = and(invoiceLineData.readable(viewer), where);
    const total = db.select({ n: count() }).from(schema.invoiceLines).where(condition).get()?.n ?? 0;
    const at = Math.min(Math.max(1, Math.trunc(page)), Math.max(1, Math.ceil(total / size)));
    const found = invoiceLineData.shownRefs(viewer, await db.query.invoiceLines.findMany({
      where: condition,
      with: { invoice: { columns: { id: true, number: true } } },
      orderBy: (t, { desc }) => [...(order ? [order] : []), desc(t.id)],
      limit: size,
      offset: (at - 1) * size,
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return { rows: rows.map(withInvoiceLineFormulas), total, page: at, size };
  },

  /**
   * The invoice lines the viewer may read that fit \`where\` and \`search\`, in \`sort\`'s order (else newest
   * first), a page of them and how many there are: for the API and the assistants' tools.
   */
  async find(
    viewer: Viewer | null,
    options: { where?: unknown; search?: string; sort?: string; limit?: number; offset?: number } = {},
  ) {
    if (readScope(invoiceLineAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = invoiceLineData.fitting(viewer, options.where, options.search);
    const order = sortOf(SORTABLE, options.sort);
    const total = db.select({ n: count() }).from(schema.invoiceLines).where(condition).get()?.n ?? 0;
    const found = invoiceLineData.shownRefs(viewer, await db.query.invoiceLines.findMany({
      where: condition,
      with: { invoice: { columns: { id: true, number: true } } },
      orderBy: (t, { desc }) => [...(order ? [order] : []), desc(t.id)],
      limit: options.limit ?? 100,
      offset: options.offset ?? 0,
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return { items: rows.map(withInvoiceLineFormulas), total };
  },

  /**
   * A number from the invoice lines the viewer may read that fit \`where\`: how many, or the sum,
   * average, smallest or largest of a number field.
   */
  async measure(
    viewer: Viewer | null,
    how: "count" | "sum" | "average" | "smallest" | "largest",
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<number | null> {
    if (readScope(invoiceLineAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = invoiceLineData.fitting(viewer, options.where, options.search);
    if (how === "count")
      return db.select({ n: count() }).from(schema.invoiceLines).where(condition).get()?.n ?? 0;
    const field = options.field ?? "";
    const money = MONEY.includes(field);
    if (COMPUTED.includes(field)) {
      const rows = await invoiceLineData.computedRows(condition);
      const value = aggregate(rows.map((row) => row[field]), how);
      return value === null ? null : money ? value / 100 : value;
    }
    const column = Object.hasOwn(NUMBERS, field) ? NUMBERS[field] : undefined;
    if (!column)
      throw new BadInput(
        \`\${how} needs a number field: \${[...Object.keys(NUMBERS), ...COMPUTED].join(", ") || "there are none"}.\`,
      );
    const pick = { sum, average: avg, smallest: min, largest: max }[how];
    const value = db.select({ v: pick(column) }).from(schema.invoiceLines).where(condition).get()?.v;
    if (value === null || value === undefined) return null;
    return money ? Number(value) / 100 : Number(value);
  },

  /** Which record holds the smallest or largest value of a number field (the first of a tie). */
  async holder(
    viewer: Viewer | null,
    how: "smallest" | "largest",
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<{ id: number; title: string } | null> {
    const condition = invoiceLineData.fitting(viewer, options.where, options.search);
    const field = options.field ?? "";
    if (COMPUTED.includes(field)) {
      let best: Record<string, unknown> | undefined;
      for (const row of await invoiceLineData.computedRows(condition)) {
        const v = row[field];
        if (typeof v !== "number") continue;
        if (!best || (how === "largest" ? v > (best[field] as number) : v < (best[field] as number))) best = row;
      }
      return best ? { id: best.id as number, title: String(best.description) } : null;
    }
    const column = Object.hasOwn(NUMBERS, field) ? NUMBERS[field] : undefined;
    if (!column) return null;
    const row = db
      .select({ id: schema.invoiceLines.id, title: schema.invoiceLines.description })
      .from(schema.invoiceLines)
      .where(and(condition, isNotNull(column)))
      .orderBy(how === "largest" ? desc(column) : asc(column), asc(schema.invoiceLines.id))
      .limit(1)
      .get();
    return row ? { id: row.id, title: String(row.title) } : null;
  },

  /**
   * The same number per value of a field (a choice, yes/no, a reference) or per month of a date:
   * \`[{ value, number }]\`, the most first.
   */
  async measureBy(
    viewer: Viewer | null,
    how: "count" | "sum" | "average" | "smallest" | "largest",
    by: string,
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<{ value: unknown; title?: string; number: number | null }[]> {
    if (readScope(invoiceLineAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const split = Object.hasOwn(FILTERABLE, by) ? FILTERABLE[by] : undefined;
    if (!split || split.kind === "text" || split.kind === "number" || split.kind === "money")
      throw new BadInput(\`There is no field "\${by}" to split by. Fields: \${BY.join(", ")}.\`);
    const field = options.field ?? "";
    const money = MONEY.includes(field);
    const condition = invoiceLineData.fitting(viewer, options.where, options.search);
    const amount = (n: number | null) => (n === null ? null : money ? n / 100 : n);
    const most = (a: { number: number | null }, b: { number: number | null }) => (b.number ?? 0) - (a.number ?? 0);
    // A reference's groups carry the referenced record's title beside its id.
    const named = (rows: { value: unknown; number: number | null }[]) => {
      if (split.kind !== "reference") return rows;
      const titles = titlesOf(viewer, by, rows.map((r) => r.value).filter((v): v is number => typeof v === "number"));
      return rows.map((r) => (titles.has(r.value) ? { value: r.value, title: titles.get(r.value), number: r.number } : r));
    };
    if (COMPUTED.includes(field)) {
      // Each record's month or value, then the computed numbers added up per group.
      const groups = new Map<unknown, unknown[]>();
      for (const row of await invoiceLineData.computedRows(condition)) {
        const raw = row[split.kind === "reference" ? \`\${by}Id\` : by];
        const value = split.kind === "date" ? String(raw ?? "").slice(0, 7) || null : split.kind === "instant" ? (raw instanceof Date ? raw.toISOString().slice(0, 7) : null) : raw;
        groups.set(value, [...(groups.get(value) ?? []), row[field]]);
      }
      return named([...groups].map(([value, numbers]) => ({ value, number: amount(aggregate(numbers, how)) })).sort(most));
    }
    const key = split.kind === "date" ? sql<string>\`substr(\${split.column}, 1, 7)\` : split.kind === "instant" ? sql<string>\`strftime('%Y-%m', \${split.column} / 1000, 'unixepoch')\` : sql\`\${split.column}\`;
    const column = Object.hasOwn(NUMBERS, field) ? NUMBERS[field] : undefined;
    if (how !== "count" && !column)
      throw new BadInput(\`\${how} needs a number field: \${[...Object.keys(NUMBERS), ...COMPUTED].join(", ") || "there are none"}.\`);
    const pick = how === "count" || !column ? count() : { sum, average: avg, smallest: min, largest: max }[how](column);
    return named(
      db
        .select({ value: key, number: pick })
        .from(schema.invoiceLines)
        .where(condition)
        .groupBy(key)
        .all()
        .map((r) => ({ value: r.value, number: r.number === null ? null : amount(Number(r.number)) }))
        .sort(most),
    );
  },

  /**
   * The records that fit, with their computed fields worked out: for adding those up. At most
   * 10,000, so one call never reads a whole large table; more are refused with how to narrow them.
   */
  async computedRows(condition: SQL | undefined): Promise<Record<string, unknown>[]> {
    const rows = await db.query.invoiceLines.findMany({ where: condition, with: { invoice: { columns: { id: true, number: true } } }, limit: 10001 });
    if (rows.length > 10000)
      throw new BadInput("More than 10,000 records to add up a computed field over: narrow them with where.");
    return rows.map((row) => withInvoiceLineFormulas(row as never) as Record<string, unknown>);
  },

  /** The invoice lines the viewer may read whose description has the text: a few, for naming one. */
  named(viewer: Viewer | null, text: string): { id: number; title: string }[] {
    return db
      .select({ id: schema.invoiceLines.id, title: schema.invoiceLines.description })
      .from(schema.invoiceLines)
      .where(and(invoiceLineData.readable(viewer), contains([schema.invoiceLines.description], text)))
      .limit(6)
      .all()
      .map((row) => ({ id: row.id, title: String(row.title) }));
  },

  /** Every description the viewer may read (at most 2,000): the nearest when a name fits none. */
  titles(viewer: Viewer | null): string[] {
    return db
      .select({ title: schema.invoiceLines.description })
      .from(schema.invoiceLines)
      .where(invoiceLineData.readable(viewer))
      .limit(2000)
      .all()
      .map((row) => String(row.title));
  },

  /** Why \`where\` found none when it names a text no record has: the field's nearest values. */
  whyNone(viewer: Viewer | null, where: unknown): string | undefined {
    if (!where || typeof where !== "object") return undefined;
    for (const [name, v] of Object.entries(where)) {
      const field = Object.hasOwn(FILTERABLE, name) ? FILTERABLE[name] : undefined;
      if (field?.kind !== "text" || (typeof v !== "string" && typeof v !== "number")) continue;
      const values = db
        .selectDistinct({ v: sql<string>\`\${field.column}\` })
        .from(schema.invoiceLines)
        .where(and(invoiceLineData.readable(viewer), isNotNull(field.column)))
        .limit(2000)
        .all()
        .map((row) => String(row.v));
      const asked = String(v);
      if (values.length && !values.some((x) => x.toLowerCase().includes(asked.toLowerCase())))
        return \`No invoice line has "\${asked}" in \${name}; the nearest: \${nearest(asked, values).join(", ")}.\`;
    }
    return undefined;
  },

  /** The condition for records the viewer may read that fit \`where\` and \`search\`. */
  fitting(viewer: Viewer | null, where?: unknown, search?: string) {
    return and(
      invoiceLineData.readable(viewer),
      whereOf(FILTERABLE, where, viewer ? eq(schema.invoiceLines.ownerId, viewer.id) : undefined, viewer?.id, {invoice: { find: (text: string) => invoiceData.named(viewer, text), titles: () => invoiceData.titles(viewer) }}),
      // Every word somewhere in the texts ("ship lamp" finds "ship's lamp").
      ...wordsOf(search).map((word) => contains([schema.invoiceLines.description], word)),
    );
  },

  async get(viewer: Viewer | null, id: number) {
    const fetched = await db.query.invoiceLines.findFirst({
      where: and(eq(schema.invoiceLines.id, id), invoiceLineData.readable(viewer)),
      with: { invoice: { columns: { id: true, number: true } } },
    });
    const found = fetched && invoiceLineData.shownRefs(viewer, [fetched])[0];
    const row = found && shownTo(viewer, found);
    return row ? withInvoiceLineFormulas(row) : null;
  },

  async create(viewer: Viewer | null, values: InvoiceLineSettable) {
    check(invoiceLineAccess.create, viewer);
    checkReferences(viewer, values);
    let row: typeof schema.invoiceLines.$inferSelect;
    try {
      row = db.transaction((tx) => {
        const made = tx.insert(schema.invoiceLines).values({ ...values, ownerId: personOf(viewer) }).returning().get();
        audit(tx, viewer, { action: "created", model: "InvoiceLine", record: made.id });
        return made;
      });
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterCreate", "InvoiceLine", row, viewer);
    return row;
  },

  /** Changes the record; \`what\` names the change in the audit log (an action's name). */
  /** Changes the fields given; what names the action ("changed" for a form), frees the fields it may change although locked (its own set). */
  async update(viewer: Viewer | null, id: number, values: Partial<InvoiceLineSettable>, what = "changed", _frees: readonly string[] = []) {
    const row = db
      .select({ ownerId: schema.invoiceLines.ownerId })
      .from(schema.invoiceLines)
      .where(and(eq(schema.invoiceLines.id, id), invoiceLineData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    // A form's change needs write on the record; an action (what names it) checked its own access
    // first, which includes the roles its grant names (docs/design/actions.md, Access).
    if (what === "changed") check(invoiceLineAccess.write, viewer, row.ownerId);
    checkReferences(viewer, values);
    let changed: typeof schema.invoiceLines.$inferSelect;
    const updated = values;
    try {
      changed = db.transaction((tx) => {
        // Read again in the change itself: a record that left the viewer's reach meanwhile is refused.
        const before = tx.select().from(schema.invoiceLines).where(and(eq(schema.invoiceLines.id, id), invoiceLineData.readable(viewer))).get();
        if (!before) throw new AccessDenied(viewer !== null);
        const after = tx.update(schema.invoiceLines).set(updated).where(eq(schema.invoiceLines.id, id)).returning().get();
        audit(tx, viewer, { action: what, model: "InvoiceLine", record: id, fields: before && changedFields(before, after, Object.keys(updated).filter((k) => !["amount"].includes(k))) });
        return after;
      });
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterUpdate", "InvoiceLine", changed, viewer);
    return changed;
  },

  /** Deletes the record; \`together\` takes the records that point to it along to the trash (delete-together.md). */
  async remove(viewer: Viewer | null, id: number, _together = false): Promise<void> {
    const row = db
      .select({ ownerId: schema.invoiceLines.ownerId })
      .from(schema.invoiceLines)
      .where(and(eq(schema.invoiceLines.id, id), invoiceLineData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(invoiceLineAccess.delete, viewer, row.ownerId);
    try {
      db.transaction((tx) => {
        // Read again in the change itself: a record that left the viewer's reach meanwhile is refused.
        if (!tx.select({ id: schema.invoiceLines.id }).from(schema.invoiceLines).where(and(eq(schema.invoiceLines.id, id), invoiceLineData.readable(viewer))).get())
          throw new AccessDenied(viewer !== null);
        const gone = tx.delete(schema.invoiceLines).where(eq(schema.invoiceLines.id, id)).returning().get();
        if (gone) {
          audit(tx, viewer, { action: "deleted", model: "InvoiceLine", record: id, title: gone.description });
        }
      });
    } catch (error) {
      throw refusal(error);
    }
    await afterDelete("InvoiceLine", id, viewer);
  },

  /**
   * Deletes the chosen records the viewer may delete, all or none (one still in use stops them
   * all, and is named); the others are skipped.
   */
  async removeMany(viewer: Viewer | null, ids: number[], _together = false): Promise<{ deleted: number; skipped: number }> {
    const rows = db
      .select({ id: schema.invoiceLines.id, ownerId: schema.invoiceLines.ownerId })
      .from(schema.invoiceLines)
      .where(and(inArray(schema.invoiceLines.id, ids), invoiceLineData.readable(viewer)))
      .all()
      .filter((row) => allows(invoiceLineAccess.delete, viewer, row.ownerId));
    db.transaction((tx) => {
      for (const row of rows)
        try {
          const gone = tx.delete(schema.invoiceLines).where(eq(schema.invoiceLines.id, row.id)).returning().get();
          if (gone) {
            audit(tx, viewer, { action: "deleted", model: "InvoiceLine", record: row.id, title: gone.description });
          }
        } catch (error) {
          const refused = refusal(error);
          throw refused instanceof Conflict && refused.message === "in-use" ? new Conflict(\`in-use:\${row.id}\`) : refused;
        }
    });
    for (const row of rows) {
      await afterDelete("InvoiceLine", row.id, viewer);
    }
    return { deleted: rows.length, skipped: new Set(ids).size - rows.length };
  },
};
"
`;

