exports[`../../../examples/booking/smithable.yml > file list and generated code > src/routes/index.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute } from "@tanstack/react-router";
import { pageAccess, pageUi, pageHead } from "#/generated/pages";
import { guardPage } from "#/kit/access";
import { LandingLayout, Hero, RecordCards, Section, CallToAction, Contact } from "#/kit/Landing";
import { w } from "#/kit/words";
import { site } from "#/generated/site";
import { listClassTypes, classTypeUi } from "#/generated/class-type";
import { listPosts, postUi } from "#/generated/post";
import { Calendar, BookOpen } from "lucide-react";
import { Calculator } from "#/kit/Calculator";
import { homeEstimateCalculatorUi } from "#/generated/home-estimate-calculator";
import { app } from "#/generated/app";
import { createMessage, messageUi } from "#/generated/message";
import { messageSchema } from "#/generated/message.schema";
import { ModelForm } from "#/kit/ModelForm";

export const Route = createFileRoute("/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["home"], context.viewer, location.href),
  head: () => pageHead("home"),
  loader: async () => ({ classTypes: (await listClassTypes()).rows, posts: (await listPosts()).rows }),
  component: HomePage,
});

function HomePage() {
  const data = Route.useLoaderData();
  const { viewer } = Route.useRouteContext();
  return (
    <LandingLayout appName={app.name} link={viewer ? { to: "/schedule", label: w.openApp(app.name) } : { to: "/sign-in", label: w.signIn }} footer={{ links: [], texts: "pages.home.footer" }} site={site} viewer={viewer}>
      <Hero
          texts="pages.home.hero"
          title="Stillwater Yoga"
          subtitle="Class schedule and online booking for a small yoga studio."
          link={{ to: "/schedule", label: "Get started" }}
          shortcuts={[{ to: "/schedule", label: pageUi["schedule"].title, icon: Calendar }, { to: "/blog", label: pageUi["blog"].title, icon: BookOpen }]}
          more
        />
      <RecordCards
          texts="pages.home.classes"
          id="classes"
          title={classTypeUi.pluralLabel}
          cards={data.classTypes.slice(0, 6).map((row) => ({
            key: row.id,
            title: String(row.name),
            text: row.summary ?? undefined,
            badge: classTypeUi.fields.find((f) => f.name === "level")?.choices?.find((c) => c.value === row.level)?.label,
          }))}
        />
      <Section
          texts="pages.home.estimate"
          id="estimate"
        >
          <Calculator ui={homeEstimateCalculatorUi} app={app} />
        </Section>
      <CallToAction
          texts="pages.home.callToAction"
          title="Ready to get started?"
          link={{ to: "/schedule", label: "Get started" }}
        />
      <RecordCards
          texts="pages.home.news"
          id="news"
          icon={BookOpen}
          title={postUi.pluralLabel}
          cards={data.posts.slice(0, 6).map((row) => ({
            key: row.id,
            title: String(row.title),
            href: \`/blog/\${encodeURIComponent(row.address || String(row.id))}\`,
            picture: row.cover ? { src: \`/files/post/\${row.id}/cover\`, alt: row.cover.alt, width: row.cover.width, height: row.cover.height, generated: row.cover.generated } : undefined,
            text: row.summary ?? undefined,
            badge: postUi.fields.find((f) => f.name === "status")?.choices?.find((c) => c.value === row.status)?.label,
          }))}
        />
      <Contact
          texts="pages.home.contact"
          form={(sent, human) => (
            <ModelForm
              ui={messageUi}
              app={app}
              schema={messageSchema}
              submitLabel="Send"
              onSubmit={async (values) => {
                if (human()) await createMessage({ data: values });
                sent();
              }}
            />
          )}
        />
    </LandingLayout>
  );
}
"
`;

exports[`../../../examples/booking/smithable.yml > file list and generated code > src/routes/instructors/$id.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, Link, notFound, useNavigate } from "@tanstack/react-router";
import { createServerFn } from "@tanstack/react-start";
import { and, desc, eq } from "drizzle-orm";
import { db } from "#/db";
import { auditLog, user } from "#/db/schema";
import { app } from "#/generated/app";
import { pageAccess, pageHead } from "#/generated/pages";
import { deleteInstructor, getInstructor, instructorUi, updateInstructor } from "#/generated/instructor";
import { instructorSchema } from "#/generated/instructor.schema";
import { buttonVariants } from "#/components/ui/button";
import { sessionUi } from "#/generated/session";
import { guardPage } from "#/kit/access";
import { ActivityLog } from "#/kit/ActivityLog";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";
import { w } from "#/kit/words";
import { currentViewer } from "#/lib/viewer.server";
import { ModelTable } from "#/kit/ModelTable";

/** The record's lines in the audit log, newest first: administrators only, nobody else. */
const getHistory = createServerFn()
  .validator((id: number) => id)
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    if (viewer?.role !== "admin") return null;
    const people = new Map(db.select({ id: user.id, name: user.name }).from(user).all().map((p) => [p.id, p.name]));
    return db
      .select()
      .from(auditLog)
      .where(and(eq(auditLog.model, "Instructor"), eq(auditLog.recordId, id)))
      .orderBy(desc(auditLog.id))
      .limit(50)
      .all()
      .map((r) => ({
        id: r.id,
        at: r.at,
        who: r.who === "visitor" || r.who === "the app" ? r.who : (people.get(r.who) ?? (r.who.startsWith("key:") ? w.aKey(r.who.slice(4)) : r.who.startsWith("timer:") ? w.byTimer(r.who.slice(6)) : w.aRemovedUser(r.who))),
        action: r.action,
        fields: r.fields,
        details: r.details ? Object.fromEntries(Object.entries(r.details).map(([k, v]) => [k, String(v)])) : null,
      }));
  });

export const Route = createFileRoute("/instructors/$id")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["instructors"], context.viewer, location.href),
  head: () => pageHead("instructors"),
  loader: async ({ params }) => {
    const found = await getInstructor({ data: Number(params.id) });
    if (!found) throw notFound();
    return { ...found, history: await getHistory({ data: Number(params.id) }) };
  },
  component: InstructorPage,
});

function InstructorPage() {
  const { row, canWrite, canDelete, canAdd, history } = Route.useLoaderData();
  const navigate = useNavigate();
  const back = () => navigate({ to: "/instructors" });
  return (
    <>
      <PageHeader title={row.name || \`Instructor #\${row.id}\`} />
      <ModelForm
        key={String(row.updatedAt)}
        ui={instructorUi}
        app={app}
        schema={instructorSchema}
        initial={row}
        readOnly={!canWrite}
        submitLabel={w.saveChanges}
        onSubmit={async (values) => {
          await updateInstructor({ data: { id: row.id, values } });
          await back();
        }}
        onCancel={back}
        onDelete={
          canDelete
            ? async (together?: boolean) => {
                await deleteInstructor({ data: { id: row.id, together } });
                await back();
              }
            : undefined
        }
      />
      <section className="mt-10">
        <div className="mb-3 flex items-center justify-between gap-3">
          <h2 className="text-lg font-semibold">Sessions</h2>
          {row.sessions.length > 0 && canAdd?.sessions && (
              <Link to="/sessions/new" search={{ instructor: row.id }} className={buttonVariants({ variant: "outline" })}>
                {w.addOne("session")}
              </Link>
            )}
        </div>
        <ModelTable
          ui={sessionUi}
          app={app}
          rows={row.sessions}
          hide={["instructorId"]}
          onOpen={(item) => navigate({ to: "/sessions/$id", params: { id: String(item.id) } })}
          emptyAction={canAdd?.sessions && (
              <Link to="/sessions/new" search={{ instructor: row.id }} className={buttonVariants({ variant: "outline" })}>
                {w.addOne("session")}
              </Link>
            )}
          emptyMessage={canAdd?.sessions ? undefined : w.noneYet("sessions")}
        />
      </section>
      {history && history.length > 0 && (
        <section className="mt-10 max-w-3xl">
          <h2 className="mb-3 text-lg font-semibold">{w.history}</h2>
          <ActivityLog lines={history} app={app} />
        </section>
      )}
    </>
  );
}
"
`;

