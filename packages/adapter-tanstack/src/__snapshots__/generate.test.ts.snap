"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// Sample data for development. Run with \`pnpm db:seed\`; tables that already have rows are left alone.
import { db } from "./index";
import { classTypes, instructors, sessions, posts, messages } from "./schema";
import { samplePicture } from "#/kit/uploads";
import { app } from "#/generated/app";
import { instantOf, wallTime } from "#/kit/zoned";

/**
 * A sample moved to this week (0) or the next (1) in the app's time zone, as a wall time
 * ("2026-09-30T09:00"): the same weekday, and the clock time the sample is written with.
 */
function aroundToday(sample: Date, week: number): string {
  const today = Date.parse(\`\${wallTime(new Date(), app.timeZone).slice(0, 10)}T00:00:00Z\`);
  const monday = today - ((new Date(today).getUTCDay() + 6) % 7) * 86_400_000;
  const day = (sample.getUTCDay() + 6) % 7;
  const moved = new Date(monday + (week * 7 + day) * 86_400_000).toISOString().slice(0, 10);
  return \`\${moved}T\${sample.toISOString().slice(11, 16)}\`;
}

if (db.select().from(classTypes).limit(1).all().length === 0) {
  db.insert(classTypes)
    .values([
    { name: "Vinyasa", summary: "A short description of Vinyasa.", level: "beginner", durationMinutes: 45 },
    { name: "Yin", summary: "A short description of Yin.", level: "allLevels", durationMinutes: 60 },
    { name: "Hatha", summary: "A short description of Hatha.", level: "advanced", durationMinutes: 75 },
    { name: "Foundations", summary: "A short description of Foundations.", level: "beginner", durationMinutes: 90 },
    { name: "Vinyasa 2", summary: "A short description of Vinyasa 2.", level: "allLevels", durationMinutes: 45 },
    { name: "Yin 2", summary: "A short description of Yin 2.", level: "advanced", durationMinutes: 60 },
    { name: "Hatha 2", summary: "A short description of Hatha 2.", level: "beginner", durationMinutes: 75 },
    { name: "Foundations 2", summary: "A short description of Foundations 2.", level: "allLevels", durationMinutes: 90 },
    ])
    .run();
}

if (db.select().from(instructors).limit(1).all().length === 0) {
  db.insert(instructors)
    .values([
    { name: "Emma Lindqvist", bio: "A short description of **Emma Lindqvist**.\\n\\n- What it is\\n- Who it is for", portrait: samplePicture("instructor", 0, "A picture of Emma Lindqvist") },
    { name: "Oskar Nieminen", bio: "A short description of **Oskar Nieminen**.\\n\\n- What it is\\n- Who it is for", portrait: samplePicture("instructor", 1, "A picture of Oskar Nieminen") },
    { name: "Sofia Andersson", bio: "A short description of **Sofia Andersson**.\\n\\n- What it is\\n- Who it is for", portrait: samplePicture("instructor", 2, "A picture of Sofia Andersson") },
    { name: "Leo Virtanen", bio: "A short description of **Leo Virtanen**.\\n\\n- What it is\\n- Who it is for", portrait: samplePicture("instructor", 0, "A picture of Leo Virtanen") },
    { name: "Aino Karlsson", bio: "A short description of **Aino Karlsson**.\\n\\n- What it is\\n- Who it is for", portrait: samplePicture("instructor", 1, "A picture of Aino Karlsson") },
    { name: "Elias Johansson", bio: "A short description of **Elias Johansson**.\\n\\n- What it is\\n- Who it is for", portrait: samplePicture("instructor", 2, "A picture of Elias Johansson") },
    { name: "Maja Korhonen", bio: "A short description of **Maja Korhonen**.\\n\\n- What it is\\n- Who it is for", portrait: samplePicture("instructor", 0, "A picture of Maja Korhonen") },
    { name: "William Berg", bio: "A short description of **William Berg**.\\n\\n- What it is\\n- Who it is for", portrait: samplePicture("instructor", 1, "A picture of William Berg") },
    ])
    .run();
}

if (db.select().from(sessions).limit(1).all().length === 0) {
  db.insert(sessions)
    .values([
    { classTypeId: 1, instructorId: 1, startsAt: instantOf(aroundToday(new Date("2026-09-01T08:00:00.000Z"), 0), app.timeZone), capacity: 8 },
    { classTypeId: 2, instructorId: 2, startsAt: instantOf(aroundToday(new Date("2026-09-02T10:00:00.000Z"), 1), app.timeZone), capacity: 12 },
    { classTypeId: 3, instructorId: 3, startsAt: instantOf(aroundToday(new Date("2026-09-03T12:00:00.000Z"), 0), app.timeZone), capacity: 16 },
    { classTypeId: 4, instructorId: 4, startsAt: instantOf(aroundToday(new Date("2026-09-04T08:00:00.000Z"), 1), app.timeZone), capacity: 8 },
    { classTypeId: 5, instructorId: 5, startsAt: instantOf(aroundToday(new Date("2026-09-05T10:00:00.000Z"), 0), app.timeZone), capacity: 12 },
    { classTypeId: 6, instructorId: 6, startsAt: instantOf(aroundToday(new Date("2026-09-06T12:00:00.000Z"), 1), app.timeZone), capacity: 16 },
    { classTypeId: 7, instructorId: 7, startsAt: instantOf(aroundToday(new Date("2026-09-07T08:00:00.000Z"), 0), app.timeZone), capacity: 8 },
    { classTypeId: 8, instructorId: 8, startsAt: instantOf(aroundToday(new Date("2026-09-08T10:00:00.000Z"), 1), app.timeZone), capacity: 12 },
    ])
    .run();
}

if (db.select().from(posts).limit(1).all().length === 0) {
  db.insert(posts)
    .values([
    { title: "Post 1", address: "address 1", summary: "A short description of Post 1.", cover: samplePicture("post", 0, "A picture of Post 1"), body: "A short description of **Post 1**.\\n\\n- What it is\\n- Who it is for", publishedOn: "2026-04-15", status: "draft" },
    { title: "Post 2", address: "address 2", summary: "A short description of Post 2.", cover: samplePicture("post", 1, "A picture of Post 2"), body: "A short description of **Post 2**.\\n\\n- What it is\\n- Who it is for", publishedOn: "2026-05-08", status: "published" },
    { title: "Post 3", address: "address 3", summary: "A short description of Post 3.", cover: samplePicture("post", 2, "A picture of Post 3"), body: "A short description of **Post 3**.\\n\\n- What it is\\n- Who it is for", publishedOn: "2026-05-31", status: "draft" },
    { title: "Post 4", address: "address 4", summary: "A short description of Post 4.", cover: samplePicture("post", 0, "A picture of Post 4"), body: "A short description of **Post 4**.\\n\\n- What it is\\n- Who it is for", publishedOn: "2026-06-23", status: "published" },
    { title: "Post 5", address: "address 5", summary: "A short description of Post 5.", cover: samplePicture("post", 1, "A picture of Post 5"), body: "A short description of **Post 5**.\\n\\n- What it is\\n- Who it is for", publishedOn: "2026-07-16", status: "draft" },
    { title: "Post 6", address: "address 6", summary: "A short description of Post 6.", cover: samplePicture("post", 2, "A picture of Post 6"), body: "A short description of **Post 6**.\\n\\n- What it is\\n- Who it is for", publishedOn: "2026-08-08", status: "published" },
    { title: "Post 7", address: "address 7", summary: "A short description of Post 7.", cover: samplePicture("post", 0, "A picture of Post 7"), body: "A short description of **Post 7**.\\n\\n- What it is\\n- Who it is for", publishedOn: "2026-08-31", status: "draft" },
    { title: "Post 8", address: "address 8", summary: "A short description of Post 8.", cover: samplePicture("post", 1, "A picture of Post 8"), body: "A short description of **Post 8**.\\n\\n- What it is\\n- Who it is for", publishedOn: "2026-09-23", status: "published" },
    ])
    .run();
}

if (db.select().from(messages).limit(1).all().length === 0) {
  db.insert(messages)
    .values([
    { name: "Message 1", email: "message.1@example.com", message: "A short description of Message 1." },
