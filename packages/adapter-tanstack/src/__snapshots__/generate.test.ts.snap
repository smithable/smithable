"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createInsertSchema } from "drizzle-zod";
import type { z } from "zod";
import * as schema from "#/db/schema";
import { w } from "#/kit/words";

/** What a component may be given: a form's values and what the app fills (an action's set). */
export const componentSettable = createInsertSchema(schema.components, {
  name: (s) => s.trim().min(1, w.required).max(200, w.atMostCharacters(200)),
  description: (s) => s.max(10000, w.atMostCharacters(10000)),
}).omit({ id: true, ownerId: true, createdAt: true, updatedAt: true });
/** What a component's form sends, checked. */
export const componentSchema = componentSettable;

export type ComponentSettable = z.output<typeof componentSettable>;
export type ComponentValues = z.output<typeof componentSchema>;
"
`;

