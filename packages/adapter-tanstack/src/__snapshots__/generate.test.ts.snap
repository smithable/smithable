exports[`../../../examples/status/smithable.yml > file list and generated code > src/generated/api.server.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// The API's conversions (docs/design/integrations.md §2): records as programs read them (the
// spec's field names, amounts as decimal texts, times as ISO texts) and their values back, checked
// by each model's own schema, as a form's are.
import { BadInput } from "#/kit/api.server";
import { componentSchema } from "#/generated/component.schema";
import { incidentSchema } from "#/generated/incident.schema";

const whole = (v: unknown, field: string) => {
  if (Number.isInteger(v)) return v as number;
  throw new BadInput(\`"\${field}" must be a record's id, a whole number.\`);
};
const moment = (v: unknown, field: string) => {
  const d = typeof v === "string" ? new Date(v) : undefined;
  if (d && !Number.isNaN(d.getTime())) return d;
  throw new BadInput(\`"\${field}" must be a date and time, like "2026-10-04T09:30:00Z".\`);
};

/** The body as an object of known fields, or a refusal naming the first unknown one. */
function fieldsOf(body: unknown, known: readonly string[]): Record<string, unknown> {
  if (!body || typeof body !== "object" || Array.isArray(body)) throw new BadInput("The body must be a JSON object.");
  const unknown = Object.keys(body).find((k) => !known.includes(k));
  if (unknown) throw new BadInput(\`There is no field "\${unknown}" to set. Fields: \${known.join(", ")}.\`);
  return body as Record<string, unknown>;
}

/** A component as the API gives it. */
export function componentToApi(row: Record<string, any>) {
  return {
    id: row.id as number,
    name: row.name ?? null,
    status: row.status ?? null,
    description: row.description ?? null,
    createdAt: row.createdAt instanceof Date ? row.createdAt.toISOString() : row.createdAt,
    updatedAt: row.updatedAt instanceof Date ? row.updatedAt.toISOString() : row.updatedAt,
  };
}

/** A component's values from a body: all of them, or a change to \`current\`. */
export function componentFromApi(body: unknown, current?: Record<string, unknown>) {
  const given = fieldsOf(body, ["name", "status", "description"]);
  const values: Record<string, unknown> = { ...current };
  for (const [key, v] of Object.entries(given))
    switch (key) {
      case "name":
        values.name = v;
        break;
      case "status":
        values.status = v;
        break;
      case "description":
        values.description = v;
        break;
    }
  return componentSchema.parse(values);
}

/** A incident as the API gives it. */
export function incidentToApi(row: Record<string, any>) {
  return {
    id: row.id as number,
    title: row.title ?? null,
    status: row.status ?? null,
    component: row.componentId ?? null,
    detectedAt: row.detectedAt instanceof Date ? row.detectedAt.toISOString() : (row.detectedAt ?? null),
    resolvedAt: row.resolvedAt instanceof Date ? row.resolvedAt.toISOString() : (row.resolvedAt ?? null),
    summary: row.summary ?? null,
    createdAt: row.createdAt instanceof Date ? row.createdAt.toISOString() : row.createdAt,
    updatedAt: row.updatedAt instanceof Date ? row.updatedAt.toISOString() : row.updatedAt,
  };
}

/** A incident's values from a body: all of them, or a change to \`current\`. */
export function incidentFromApi(body: unknown, current?: Record<string, unknown>) {
  const given = fieldsOf(body, ["title", "status", "component", "detectedAt", "resolvedAt", "summary"]);
  const values: Record<string, unknown> = { ...current };
  for (const [key, v] of Object.entries(given))
    switch (key) {
      case "title":
        values.title = v;
        break;
      case "status":
        values.status = v;
        break;
      case "component":
        values.componentId = v === null ? null : whole(v, "component");
        break;
      case "detectedAt":
        values.detectedAt = v === null ? null : moment(v, "detectedAt");
        break;
      case "resolvedAt":
        values.resolvedAt = v === null ? null : moment(v, "resolvedAt");
        break;
      case "summary":
        values.summary = v;
        break;
    }
  return incidentSchema.parse(values);
}

/** The whole API in the OpenAPI format, for tools and agents. */
export const OPENAPI = {
