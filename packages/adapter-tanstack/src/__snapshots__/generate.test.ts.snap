exports[`../../../examples/booking/smithable.yml > file list and generated code > src/generated/access.test.ts 1`] = `
"// Generated by Smithable from smithable.yml and smithable.auth.yml. Do not edit: this file is overwritten on every change.
// For every model and role: which records a user can read, create, change and delete.
// "Own" records are owned by the user; "others" by someone else.
import { describe, expect, test } from "vitest";
import { db } from "#/db";
import { classTypes, instructors, sessions, user } from "#/db/schema";
import { AccessDenied, type Viewer } from "#/kit/access";
import { classTypeData } from "./class-type.server";
import { instructorData } from "./instructor.server";
import { sessionData } from "./session.server";

let counter = 0;
const next = () => ++counter;

/** A new signed-in user with the role. */
function signedIn(role: string): Viewer {
  const n = next();
  const viewer = { id: \`test-user-\${n}\`, name: \`Test \${role} \${n}\`, email: \`user\${n}@example.com\`, role };
  db.insert(user).values(viewer).run();
  return viewer;
}

/** Owns the records that are someone else's. */
const stranger = signedIn("member");

/** Whether the action is allowed; any other failure fails the test. */
async function can(action: () => unknown): Promise<boolean> {
  try {
    await action();
    return true;
  } catch (error) {
    if (error instanceof AccessDenied) return false;
    throw error;
  }
}

/** Whether the viewer can open the record and sees it in the list. */
async function reads(
  data: { get(viewer: never, id: number): Promise<unknown>; list(viewer: never): Promise<{ id: number }[]> },
  viewer: unknown,
  id: number,
): Promise<boolean> {
  const listed = await data.list(viewer as never).then(
    (rows) => rows.some((row) => row.id === id),
    (error) => {
      if (error instanceof AccessDenied) return false;
      throw error;
    },
  );
  return listed && (await data.get(viewer as never, id)) !== null;
}

function classTypeValues(_owner: string | null) {
  const n = next();
  return { name: \`ClassType name \${n}\`, summary: null, level: "beginner", durationMinutes: n } as const;
}

function insertClassType(owner: string | null) {
  return db
    .insert(classTypes)
    .values({ ...classTypeValues(owner), ownerId: owner })
    .returning()
    .get();
}

function instructorValues(_owner: string | null) {
  const n = next();
  return { name: \`Instructor name \${n}\`, bio: null } as const;
}

function insertInstructor(owner: string | null) {
  return db
    .insert(instructors)
    .values({ ...instructorValues(owner), ownerId: owner })
    .returning()
    .get();
}

function sessionValues(owner: string | null) {
  const n = next();
  return { classTypeId: insertClassType(owner).id, instructorId: insertInstructor(owner).id, startsAt: new Date("2026-01-15T10:00:00Z"), capacity: n } as const;
}

function insertSession(owner: string | null) {
  return db
    .insert(sessions)
    .values({ ...sessionValues(owner), ownerId: owner })
    .returning()
    .get();
}

describe("ClassType", () => {
  test("admin", async () => {
    const viewer = signedIn("admin");
    const others = insertClassType(stranger.id);
    const own = insertClassType(viewer.id);
    expect({
      readOthers: await reads(classTypeData, viewer, others.id),
      readOwn: await reads(classTypeData, viewer, own.id),
      create: await can(() => classTypeData.create(viewer, classTypeValues(viewer.id))),
      changeOthers: await can(() => classTypeData.update(viewer, others.id, classTypeValues(viewer.id))),
      changeOwn: await can(() => classTypeData.update(viewer, own.id, classTypeValues(viewer.id))),
      deleteOthers: await can(() => classTypeData.remove(viewer, others.id)),
      deleteOwn: await can(() => classTypeData.remove(viewer, own.id)),
    }).toEqual({
      readOthers: true,
      readOwn: true,
      create: true,
      changeOthers: true,
      changeOwn: true,
      deleteOthers: true,
      deleteOwn: true,
    });
  });

  test("member", async () => {
    const viewer = signedIn("member");
    const others = insertClassType(stranger.id);
    const own = insertClassType(viewer.id);
    expect({
      readOthers: await reads(classTypeData, viewer, others.id),
      readOwn: await reads(classTypeData, viewer, own.id),
      create: await can(() => classTypeData.create(viewer, classTypeValues(viewer.id))),
      changeOthers: await can(() => classTypeData.update(viewer, others.id, classTypeValues(viewer.id))),
      changeOwn: await can(() => classTypeData.update(viewer, own.id, classTypeValues(viewer.id))),
      deleteOthers: await can(() => classTypeData.remove(viewer, others.id)),
      deleteOwn: await can(() => classTypeData.remove(viewer, own.id)),
    }).toEqual({
      readOthers: true,
      readOwn: true,
      create: false,
      changeOthers: false,
      changeOwn: true,
      deleteOthers: false,
      deleteOwn: true,
    });
  });

  test("a visitor who has not signed in", async () => {
    const viewer = null;
    const others = insertClassType(stranger.id);
    expect({
      readOthers: await reads(classTypeData, viewer, others.id),
      readOwn: false,
      create: await can(() => classTypeData.create(viewer, classTypeValues(null))),
      changeOthers: await can(() => classTypeData.update(viewer, others.id, classTypeValues(null))),
      changeOwn: false,
      deleteOthers: await can(() => classTypeData.remove(viewer, others.id)),
      deleteOwn: false,
    }).toEqual({
      readOthers: true,
      readOwn: false,
      create: false,
      changeOthers: false,
      changeOwn: false,
      deleteOthers: false,
      deleteOwn: false,
    });
  });
});

describe("Instructor", () => {
  test("admin", async () => {
    const viewer = signedIn("admin");
    const others = insertInstructor(stranger.id);
    const own = insertInstructor(viewer.id);
    expect({
      readOthers: await reads(instructorData, viewer, others.id),
      readOwn: await reads(instructorData, viewer, own.id),
      create: await can(() => instructorData.create(viewer, instructorValues(viewer.id))),
      changeOthers: await can(() => instructorData.update(viewer, others.id, instructorValues(viewer.id))),
      changeOwn: await can(() => instructorData.update(viewer, own.id, instructorValues(viewer.id))),
      deleteOthers: await can(() => instructorData.remove(viewer, others.id)),
      deleteOwn: await can(() => instructorData.remove(viewer, own.id)),
    }).toEqual({
      readOthers: true,
      readOwn: true,
      create: true,
      changeOthers: true,
      changeOwn: true,
      deleteOthers: true,
      deleteOwn: true,
    });
  });

  test("member", async () => {
    const viewer = signedIn("member");
    const others = insertInstructor(stranger.id);
    const own = insertInstructor(viewer.id);
    expect({
      readOthers: await reads(instructorData, viewer, others.id),
      readOwn: await reads(instructorData, viewer, own.id),
      create: await can(() => instructorData.create(viewer, instructorValues(viewer.id))),
      changeOthers: await can(() => instructorData.update(viewer, others.id, instructorValues(viewer.id))),
      changeOwn: await can(() => instructorData.update(viewer, own.id, instructorValues(viewer.id))),
      deleteOthers: await can(() => instructorData.remove(viewer, others.id)),
      deleteOwn: await can(() => instructorData.remove(viewer, own.id)),
    }).toEqual({
      readOthers: true,
      readOwn: true,
      create: false,
      changeOthers: false,
      changeOwn: true,
      deleteOthers: false,
      deleteOwn: true,
    });
  });

  test("a visitor who has not signed in", async () => {
    const viewer = null;
    const others = insertInstructor(stranger.id);
    expect({
      readOthers: await reads(instructorData, viewer, others.id),
      readOwn: false,
      create: await can(() => instructorData.create(viewer, instructorValues(null))),
      changeOthers: await can(() => instructorData.update(viewer, others.id, instructorValues(null))),
      changeOwn: false,
      deleteOthers: await can(() => instructorData.remove(viewer, others.id)),
      deleteOwn: false,
    }).toEqual({
      readOthers: true,
      readOwn: false,
      create: false,
      changeOthers: false,
      changeOwn: false,
      deleteOthers: false,
      deleteOwn: false,
    });
  });
});

describe("Session", () => {
  test("admin", async () => {
    const viewer = signedIn("admin");
    const others = insertSession(stranger.id);
    const own = insertSession(viewer.id);
    expect({
      readOthers: await reads(sessionData, viewer, others.id),
      readOwn: await reads(sessionData, viewer, own.id),
      create: await can(() => sessionData.create(viewer, sessionValues(viewer.id))),
      changeOthers: await can(() => sessionData.update(viewer, others.id, sessionValues(viewer.id))),
      changeOwn: await can(() => sessionData.update(viewer, own.id, sessionValues(viewer.id))),
      deleteOthers: await can(() => sessionData.remove(viewer, others.id)),
      deleteOwn: await can(() => sessionData.remove(viewer, own.id)),
    }).toEqual({
      readOthers: true,
      readOwn: true,
      create: true,
      changeOthers: true,
      changeOwn: true,
      deleteOthers: true,
      deleteOwn: true,
    });
  });

  test("member", async () => {
    const viewer = signedIn("member");
    const others = insertSession(stranger.id);
    const own = insertSession(viewer.id);
    expect({
      readOthers: await reads(sessionData, viewer, others.id),
      readOwn: await reads(sessionData, viewer, own.id),
      create: await can(() => sessionData.create(viewer, sessionValues(viewer.id))),
      changeOthers: await can(() => sessionData.update(viewer, others.id, sessionValues(viewer.id))),
      changeOwn: await can(() => sessionData.update(viewer, own.id, sessionValues(viewer.id))),
      deleteOthers: await can(() => sessionData.remove(viewer, others.id)),
      deleteOwn: await can(() => sessionData.remove(viewer, own.id)),
    }).toEqual({
      readOthers: true,
      readOwn: true,
      create: false,
      changeOthers: false,
      changeOwn: true,
      deleteOthers: false,
      deleteOwn: true,
    });
  });

  test("a visitor who has not signed in", async () => {
    const viewer = null;
    const others = insertSession(stranger.id);
    expect({
      readOthers: await reads(sessionData, viewer, others.id),
      readOwn: false,
      create: await can(() => sessionData.create(viewer, sessionValues(null))),
      changeOthers: await can(() => sessionData.update(viewer, others.id, sessionValues(null))),
      changeOwn: false,
      deleteOthers: await can(() => sessionData.remove(viewer, others.id)),
      deleteOwn: false,
    }).toEqual({
      readOthers: true,
      readOwn: false,
      create: false,
      changeOthers: false,
      changeOwn: false,
      deleteOthers: false,
      deleteOwn: false,
    });
  });
});
"
