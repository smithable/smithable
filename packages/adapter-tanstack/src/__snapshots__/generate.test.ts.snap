    expect(JSON.stringify(db.select().from(schema.orders).where(eq(schema.orders.id, others.id)).get())).toBe(othersBefore);
  });

  test("refused on a record where status is not new or accepted", async () => {
    const ask = () => {
      const n = next();
      return { "reason": \`Order reason \${n}\` };
    };
    const viewer = signedIn("admin");
    const record = insertOrder(viewer.id, {"status":"ready"});
    await expect(runDecline(viewer, record.id, ask())).rejects.toThrow("This cannot be done now.");
  });

  test("over chosen records, only those it fits and may run on change", async () => {
    const ask = () => {
      const n = next();
      return { "reason": \`Order reason \${n}\` };
    };
    const viewer = signedIn("admin");
    const fitting = insertOrder(viewer.id, {"status":"new"});
    const notFitting = insertOrder(viewer.id, {"status":"ready"});
    const notFittingBefore = JSON.stringify(db.select().from(schema.orders).where(eq(schema.orders.id, notFitting.id)).get());
    expect(await runDeclineMany(viewer, [fitting.id, fitting.id, notFitting.id], ask())).toEqual({ changed: 1, skipped: 1 });
    expect(JSON.stringify(db.select().from(schema.orders).where(eq(schema.orders.id, notFitting.id)).get())).toBe(notFittingBefore);
    const again = insertOrder(viewer.id, {"status":"new"});
