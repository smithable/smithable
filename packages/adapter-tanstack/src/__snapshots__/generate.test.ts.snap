"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { and, asc, count, eq, inArray, isNull, max, sql, type SQL } from "drizzle-orm";
import { db } from "#/db";
import * as schema from "#/db/schema";
import { AccessDenied, allows, check, Conflict, type ModelAccess, personOf, readScope, type Viewer } from "#/kit/access";
import { audit, changedFields } from "#/kit/audit.server";
import { refusal } from "#/kit/log.server";
import { outgoing } from "#/generated/outgoing.server";
import { contains } from "#/kit/search";
import { BadInput } from "#/kit/refusal";
import { afterChange, afterDelete } from "./hooks";
import { dishData } from "./dish.server";
import { orderLineData } from "./order-line.server";
import { orderLineUi } from "./order-line";
import { orderUi, type OrderSettable } from "./order";
import { withOrderFormulas } from "./order.formulas";
import { nextInSequence } from "#/kit/sequence.server";

/** A transaction, as the group's functions are called inside one (docs/design/delete-together.md). */
type Tx = Parameters<Parameters<typeof db.transaction>[0]>[0];

/**
 * What points to a order (docs/design/delete-together.md): the records that would go with it
 * to the trash, by model, and those that would show no order; nothing when nothing does.
 */
function usedBy(tx: Tx, id: number, title: string) {
  const pointing: { model: string; from: string; label: string; plural: string; depth: number; count: number | null }[] = [
    { model: "OrderLine", label: orderLineUi.label, plural: orderLineUi.pluralLabel, from: "Order", depth: 1, count: tx.select({ n: count() }).from(schema.orderLines).where(and(eq(schema.orderLines.orderId, id))).get()?.n ?? 0 },
  ];
  // A deeper member is named when its parent has records ("and what belongs to them").
  const with_: typeof pointing = [];
  for (const e of pointing)
    if (e.count === null ? with_.some((p) => p.model === e.from) : e.count > 0) with_.push(e);
  if (!with_.length) return undefined;
  const loose = [] as { model: string; label: string; plural: string; count: number }[];
  return { id, title, model: "Order", label: orderUi.label, with: with_, loose, together: false, missing: [orderUi.label, orderLineUi.label] };
}

/** Who may read, create, change and delete orders. */
export const orderAccess: ModelAccess = {
  read: { public: false, roles: ["admin", "staff"], owner: false },
  create: { public: true, roles: ["admin", "staff"], owner: false },
  write: { public: false, roles: ["admin", "staff"], owner: true },
  delete: { public: false, roles: ["admin"], owner: true },
};

/** A record as the viewer gets it: who owns it only for its owner and roles that read every record. */
function shownTo<R extends { ownerId: string | null }>(viewer: Viewer | null, row: R): R {
  if ((viewer && row.ownerId === viewer.id) || (!!viewer && (!!viewer.system || orderAccess.read.roles.includes(viewer.role)))) return row;
  return { ...row, ownerId: null };
}



export const orderData = {
  shownTo,
  /** The rows with each reference to a record the viewer may not read set to nothing: a related record's title is shown only to who may read it (only its id stays). */
  shownRefs<R extends Record<string, unknown>>(_viewer: Viewer | null, rows: R[]): R[] {
    return rows;
  },

  /** A condition for the orders the viewer may read. */
  readable(viewer: Viewer | null) {
    const scope = readScope(orderAccess.read, viewer);
    if (scope === "all") return undefined;
    return scope === "own" && viewer ? eq(schema.orders.ownerId, viewer.id) : sql\`false\`;
  },

  canRead(viewer: Viewer | null, id: number): boolean {
    const found = db
      .select({ id: schema.orders.id })
      .from(schema.orders)
      .where(and(eq(schema.orders.id, id), orderData.readable(viewer)))
      .get();
    return found !== undefined;
  },

  /** The orders the viewer may read; \`where\` narrows them, e.g. to a search; \`order\` sorts them before the newest-first rest. */
  async list(viewer: Viewer | null, where?: SQL, order?: SQL) {
    if (readScope(orderAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const found = orderData.shownRefs(viewer, await db.query.orders.findMany({
      where: and(orderData.readable(viewer), where),
      with: { lines: true },
      orderBy: (t, { desc }) => [...(order ? [order] : []), desc(t.id)],
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    // The related records are here for the totals only: some may not be the viewer's to read.
    return rows.map((row) => {
      const { lines, ...listed } = withOrderFormulas(row);
      return listed;
    });
  },

  /**
   * A page of the orders the viewer may read that fit \`where\`, newest first (or in
   * \`order\`), and how many fit in all: for a list page. A page past the end is the last one.
   */
  async page(viewer: Viewer | null, where?: SQL, order?: SQL, page = 1, size = 50) {
    if (readScope(orderAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = and(orderData.readable(viewer), where);
    const total = db.select({ n: count() }).from(schema.orders).where(condition).get()?.n ?? 0;
    const at = Math.min(Math.max(1, Math.trunc(page)), Math.max(1, Math.ceil(total / size)));
    const found = orderData.shownRefs(viewer, await db.query.orders.findMany({
      where: condition,
      with: { lines: true },
      orderBy: (t, { desc }) => [...(order ? [order] : []), desc(t.id)],
      limit: size,
      offset: (at - 1) * size,
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    // The related records are here for the totals only: some may not be the viewer's to read.
    return { rows: rows.map((row) => {
      const { lines, ...listed } = withOrderFormulas(row);
      return listed;
    }), total, page: at, size };
  },

  async get(viewer: Viewer | null, id: number) {
    const fetched = await db.query.orders.findFirst({
      where: and(eq(schema.orders.id, id), orderData.readable(viewer)),
      with: { lines: { where: orderLineData.readable(viewer), with: { dish: { columns: { id: true, name: true } } } } },
    });
    const found = fetched && orderData.shownRefs(viewer, [{ ...fetched, lines: orderLineData.shownRefs(viewer, fetched.lines) }])[0];
    const row = found && { ...shownTo(viewer, found), lines: found.lines.map((r) => orderLineData.shownTo(viewer, r)) };
    return row ? withOrderFormulas(row) : null;
  },

  async create(viewer: Viewer | null, values: OrderSettable, lines?: { id: number; quantity: number }[]) {
    check(orderAccess.create, viewer);
    // Visitors add these without an account: at most 10,000 of theirs, so a flood stops here.
    const made = db.select({ n: count() }).from(schema.orders).where(isNull(schema.orders.ownerId)).get();
    if (viewer === null && (made?.n ?? 0) >= 10000) throw new AccessDenied(false);
    let row: typeof schema.orders.$inferSelect;
    try {
      row = db.transaction((tx) => {
        const made = tx.insert(schema.orders).values({ ...values, ownerId: personOf(viewer), number: nextInSequence(tx, "Order.number", tx.select({ n: max(schema.orders.number) }).from(schema.orders).get()?.n ?? 0) }).returning().get();
        for (const chosen of lines ?? []) {
          const item = tx.select().from(schema.dishes).where(and(eq(schema.dishes.id, chosen.id), dishData.readable(viewer))).get();
          if (!item) throw new BadInput("order-item");
          if (item.available === false) throw new Conflict(\`sold-out:\${item.name}\`);
          tx.insert(schema.orderLines).values({ orderId: made.id, dishId: item.id, quantity: chosen.quantity, unitPrice: item.price, ownerId: personOf(viewer) }).run();
