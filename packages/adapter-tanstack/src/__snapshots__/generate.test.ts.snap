exports[`../../../examples/invoicing/smithable.yml > file list and generated code > src/routes/clients/$id.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, notFound, useNavigate } from "@tanstack/react-router";
import { app } from "#/generated/app";
import { clientSchema, clientUi, deleteClient, getClient, updateClient } from "#/generated/client";
import { invoiceUi } from "#/generated/invoice";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";
import { ModelTable } from "#/kit/ModelTable";

export const Route = createFileRoute("/clients/$id")({
  loader: async ({ params }) => {
    const row = await getClient({ data: Number(params.id) });
    if (!row) throw notFound();
    return { row };
  },
  component: ClientPage,
});

function ClientPage() {
  const { row } = Route.useLoaderData();
  const navigate = useNavigate();
  const back = () => navigate({ to: "/clients" });
  return (
    <>
      <PageHeader title={row.name || \`Client #\${row.id}\`} />
      <ModelForm
        ui={clientUi}
        app={app}
        schema={clientSchema}
        initial={row}
        submitLabel="Save changes"
        onSubmit={async (values) => {
          await updateClient({ data: { id: row.id, values } });
          await back();
        }}
        onCancel={back}
        onDelete={async () => {
          await deleteClient({ data: row.id });
          await back();
        }}
      />
      <section className="mt-10">
        <h2 className="mb-3 text-lg font-semibold tracking-tight">Invoices</h2>
        <ModelTable
          ui={invoiceUi}
          app={app}
          rows={row.invoices}
          hide={["clientId"]}
          onOpen={(item) => navigate({ to: "/invoices/$id", params: { id: String(item.id) } })}
        />
      </section>
    </>
  );
}
"
`;

