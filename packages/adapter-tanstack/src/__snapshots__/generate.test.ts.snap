                "Booking",
                "Post",
                "Message"
              ]
            },
            "id": {
              "type": "integer"
            }
          }
        },
        "annotations": {
          "readOnlyHint": true,
          "destructiveHint": false
        }
      },
      {
        "name": "describe",
        "description": "What a kind of record means: its fields, rules and actions in full. Only when the summary is not enough.",
        "inputSchema": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "ClassType",
                "Instructor",
                "Session",
                "Booking",
                "Post",
                "Message"
              ]
            }
          }
        },
        "annotations": {
          "readOnlyHint": true,
          "destructiveHint": false
        }
      }
    ],
    "describe": {
      "ClassType": "ClassType: A kind of class the studio offers, such as Vinyasa, Yin, Hatha or Foundations.\\nFields:\\n- name*: Name.\\n- summary: Summary.\\n- level* (beginner | allLevels | advanced): Level. Starts as allLevels.\\n- durationMinutes* (number): Duration minutes. Starts as 60.",
      "Instructor": "Instructor\\nFields:\\n- name*: Name.\\n- bio: Bio.\\n- portrait (picture): Portrait.",
      "Session": "Session: One scheduled occurrence of a class.\\nFields:\\n- classType* -> ClassType: Class type.\\n- instructor* -> Instructor: Instructor.\\n- startsAt* (datetime): Starts at.\\n- capacity* (number): Capacity. Starts as 12.\\n- placesLeft (number, computed): Places left.",
      "Booking": "Booking: A member's place in a session.\\nFields:\\n- session* -> Session: Session. Unique.\\n- attendee -> User: Attendee.\\nA record belongs to its attendee.",
      "Post": "Post: News and articles on the studio's blog.\\nFields:\\n- title*: Title.\\n- address: Address. Unique.\\n- summary: Summary.\\n- cover (picture): Cover.\\n- body*: Body.\\n- publishedOn (date): Published on.\\n- status* (draft | published): Status. Starts as draft.",
      "Message": "Message: A question a visitor sends from the contact form on the home page.\\nFields:\\n- name*: Name.\\n- email*: Email.\\n- message*: Message."
    }
  }
};

/** The offer for a caller; a role the app does not know gets nothing. */
export function offerFor(viewer: Viewer | null): Offer & { describe: Record<string, string> } {
  const caller = viewer?.role ?? "visitor";
  return Object.hasOwn(OFFERS, caller) ? OFFERS[caller] : { summary: "", tools: [], describe: {} };
}

/** Each kind's data functions and conversions, its title field, and its references' titles. */
const KINDS = {
  ClassType: { data: classTypeData, toApi: classTypeToApi, fromApi: classTypeFromApi, title: "name", refs: {}, searched: ["name","summary"], lists: {"sessions":{"kind":"Session","ref":"classType"}} as Record<string, { kind: string; ref: string }>, label: "class type", named: (viewer: Viewer | null, text: string) => classTypeData.named(viewer, text) },
  Instructor: { data: instructorData, toApi: instructorToApi, fromApi: instructorFromApi, title: "name", refs: {}, searched: ["name","bio"], lists: {"sessions":{"kind":"Session","ref":"instructor"}} as Record<string, { kind: string; ref: string }>, label: "instructor", named: (viewer: Viewer | null, text: string) => instructorData.named(viewer, text) },
  Session: { data: sessionData, toApi: sessionToApi, fromApi: sessionFromApi, title: "$name", refs: {"classType":"name","instructor":"name"}, searched: [], lists: {"bookings":{"kind":"Booking","ref":"session"}} as Record<string, { kind: string; ref: string }>, label: "session", named: undefined },
  Booking: { data: bookingData, toApi: bookingToApi, fromApi: bookingFromApi, title: "$name", refs: {"session":"$name","attendee":"name"}, searched: [], lists: {} as Record<string, { kind: string; ref: string }>, label: "booking", named: undefined },
  Post: { data: postData, toApi: postToApi, fromApi: postFromApi, title: "title", refs: {}, searched: ["title","address","summary","body"], lists: {} as Record<string, { kind: string; ref: string }>, label: "post", named: (viewer: Viewer | null, text: string) => postData.named(viewer, text) },
  Message: { data: messageData, toApi: messageToApi, fromApi: messageFromApi, title: "name", refs: {}, searched: ["name","email","message"], lists: {} as Record<string, { kind: string; ref: string }>, label: "message", named: (viewer: Viewer | null, text: string) => messageData.named(viewer, text) },
};
type Kind = (typeof KINDS)[keyof typeof KINDS];

const kindOf = (args: Record<string, unknown>): Kind => {
  const kind = Object.hasOwn(KINDS, String(args.kind)) ? KINDS[args.kind as keyof typeof KINDS] : undefined;
  if (!kind) throw new BadInput(\`There is no kind "\${String(args.kind)}". Kinds: \${Object.keys(KINDS).join(", ")}.\`);
  return kind;
};

/**
 * A record the caller may use, by its id or by its title (an invoice's number): one that fits,
 * never a guess; "not there" and "not yours" are the same answer.
 */
async function found(kind: Kind, viewer: Viewer | null, id: unknown, verb = "read") {
  let key = Number.isInteger(id) ? (id as number) : /^\\d+$/.test(String(id)) ? Number(id) : undefined;
  if (key === undefined && typeof id === "string" && kind.named) {
    const fits = kind.named(viewer, id);
    const exact = fits.filter((r) => r.title.toLowerCase() === id.toLowerCase());
    const pick = exact.length === 1 ? exact : fits;
    if (pick.length > 1)
      throw new BadInput(\`"\${id}" fits several: \${pick.slice(0, 5).map((r) => \`\${r.title} (\${r.id})\`).join(", ")}. Give its whole \${titleWord(kind)} or its id.\`);
    key = pick[0]?.id;
  }
  const row = key === undefined ? null : await kind.data.get(viewer, key);
  if (!row) throw new NotFound(\`No \${kind.label} \${String(id)} that you may \${verb}; find it first.\`);
  return row;
}

/** The title's word in a sentence: a name of parts is the record's name. */
const titleWord = (kind: Kind) => (kind.title === "$name" ? "name" : kind.title);

/** A field's value in a row: a reference as its id and title, nothing else changed. */
function shown(kind: Kind, row: Record<string, unknown>, api: Record<string, unknown>, field: string): unknown {
  const title = (kind.refs as Record<string, string>)[field];
  const related = row[field] as Record<string, unknown> | null | undefined;
  // A name of parts, as the data functions set it on the rows they give (record-names.md).
  if (field === "$name") return row.$name ?? null;
  if (title && related && typeof related === "object")
    return related.deletedAt ? { id: related.id, inTrash: true } : { id: related.id, title: related[title] };
  if (!(field in api)) throw new BadInput(\`There is no field "\${field}". Fields: \${Object.keys(api).join(", ")}.\${field === "title" ? \` The title field is \${titleWord(kind)}.\` : ""}\`);
  return api[field];
}

/** "count", "sum total", "average total", "min …", "max …" as measure's own words. */
function measureOf(of: unknown): { how: "count" | "sum" | "average" | "smallest" | "largest"; field?: string } {
  const [word = "count", field] = String(of ?? "count").trim().split(/\\s+/);
  const how = ({ count: "count", sum: "sum", average: "average", min: "smallest", max: "largest" } as const)[word as "count"];
  if (!how) throw new BadInput('"of" is count, or sum, average, min or max with a number field, e.g. "sum total".');
  return { how, field };
}

/** An action is a key's: a visitor is never offered one, and is refused here too. */
const keyed = (viewer: Viewer | null): Viewer => {
  if (!viewer) throw new AccessDenied(false);
  return viewer;
};

/** A call's result, or its note when \`where\` names a value no record has. */
async function none<T>(call: () => Promise<T>): Promise<T | { none: string }> {
  try {
    return await call();
  } catch (error) {
    if (error instanceof NoSuchValue) return { none: error.message };
    throw error;
  }
}
const noted = (result: unknown): result is { none: string } =>
  typeof result === "object" && result !== null && "none" in result;

/** Why a call found none: a text no record has, or a search nothing fits, with the nearest. */
async function whyNone(kind: Kind, viewer: Viewer | null, args: Record<string, unknown>): Promise<string | undefined> {
  const text = kind.data.whyNone(viewer, args.where);
  if (text) return text;
  // None of the viewer's own: say how many there are without "mine" (ask-checks.md §6).
  const where = args.where as Record<string, unknown> | undefined;
  if (where && (where.mine === true || where.mine === "true")) {
    const { mine: _mine, ...rest } = where;
    const all = await kind.data.measure(viewer, "count", { where: rest, search: typeof args.search === "string" ? args.search : undefined });
    if (all) return \`None of your own; \${all} in all.\`;
  }
  if (typeof args.search !== "string") return undefined;
  // Nothing found by a search: say where it looked, the nearest titles, and how a reference is matched instead.
  const refs = Object.keys(kind.refs);
  const near = "titles" in kind.data ? nearest(args.search, kind.data.titles(viewer)) : [];
  return \`Nothing has every word of "\${args.search}" in \${kind.searched.join(", ") || "the texts"}.\${near.length ? \` The nearest \${titleWord(kind)}s: \${near.join(", ")}.\` : ""}\${refs.length ? \` A \${refs[0]} is matched with where, e.g. {"\${refs[0]}": "…"}.\` : ""}\`;
}

/** Calls one tool as the key's role, or as a visitor without a key. */
export async function callTool(viewer: Viewer | null, name: string, args: Record<string, unknown>): Promise<unknown> {
  switch (name) {
    case "find": {
      const kind = kindOf(args);
      const limit = Math.min(50, Math.max(1, Number(args.limit) || 10));
      const page = Math.max(1, Number(args.page) || 1);
      const asked = Array.isArray(args.fields) ? args.fields.map(String) : [];
      const columns = [...new Set(["id", kind.title, ...asked])];
      // A value no record has is none, with what there is (docs/design/ask-checks.md §2).
      const result = await none<{ items: unknown[]; total: number }>(() =>
        kind.data.find(viewer, {
          where: args.where,
          search: typeof args.search === "string" ? args.search : undefined,
          sort: typeof args.sort === "string" ? args.sort : undefined,
          limit,
          offset: (page - 1) * limit,
        }),
      );
      if (noted(result)) return { columns, rows: [], total: 0, note: result.none };
      const { items, total } = result;
      const rows = items.map((row) => {
        const api = kind.toApi(row as Record<string, any>) as Record<string, unknown>;
        return columns.map((field) => shown(kind, row as Record<string, unknown>, api, field));
      });
      if (total) return { columns, rows, total };
      const why = await whyNone(kind, viewer, args);
      return why ? { columns, rows, total, note: why } : { columns, rows, total };
    }
    case "measure": {
      const kind = kindOf(args);
      const { how, field } = measureOf(args.of);
      const options = { field, where: args.where, search: typeof args.search === "string" ? args.search : undefined };
      const key = how === "count" ? "total" : how;
      if (typeof args.by === "string") {
        const by = args.by;
        const rows = await none(() => kind.data.measureBy(viewer, how, by, options));
        if (noted(rows)) return { by, rows: [], note: rows.none };
        // A top shared by several is said, so one is not given as the winner.
        const top = rows[0]?.number;
        const tied = rows.filter((r) => r.number === top);
        return tied.length > 1 && top !== null && top !== undefined
          ? { by, rows, note: \`\${tied.map((r) => r.title ?? String(r.value)).join(", ")} share the top, with \${top} each.\` }
          : { by, rows };
      }
      const value = await none(() => kind.data.measure(viewer, how, options));
      if (noted(value)) return { [key]: how === "count" ? 0 : null, note: value.none };
      // The smallest or largest: which record holds it.
      if ((how === "smallest" || how === "largest") && value !== null)
        return { [how]: value, of: await kind.data.holder(viewer, how, options) };
      const why = !value ? await whyNone(kind, viewer, args) : undefined;
      return why ? { [key]: value, note: why } : { [key]: value };
    }
    case "read": {
      const kind = kindOf(args);
      const row = await found(kind, viewer, args.id);
      // With its lists, as its page shows them: an invoice with its lines (twenty of each at most).
      const lists: Record<string, unknown> = {};
      for (const [field, list] of Object.entries(kind.lists)) {
        const related = KINDS[list.kind as keyof typeof KINDS] as Kind;
        const find = related.data.find.bind(related.data) as (viewer: Viewer | null, options: { where: unknown; limit: number }) => Promise<{ items: unknown[]; total: number }>;
        const shown = await find(viewer, { where: { [list.ref]: row.id }, limit: 20 }).catch(() => undefined);
        if (shown) lists[field] = { rows: shown.items.map((r) => related.toApi(r as Record<string, any>)), total: shown.total };
      }
      return { ...kind.toApi(row as Record<string, any>), ...lists };
    }
    case "add": {
      const kind = kindOf(args);
      return kind.toApi(await kind.data.create(viewer, kind.fromApi(args.values ?? {}) as never));
    }
    case "change": {
      const kind = kindOf(args);
      const row = await found(kind, viewer, args.id, "change");
      return kind.toApi(await kind.data.update(viewer, row.id, kind.fromApi(args.values ?? {}, row as Record<string, unknown>) as never));
    }
    case "delete": {
      const kind = kindOf(args);
      const row = await found(kind, viewer, args.id, "delete");
      await kind.data.remove(viewer, row.id, args.together === true);
      return { deleted: row.id };
    }
    case "describe":
      kindOf(args);
      return { description: offerFor(viewer).describe[args.kind as string] };
    case "run":
      switch (args.action) {
    case "publish": {
      const row = await found(KINDS.Post, viewer, args.id, "change");
      return postToApi(await runPublish(keyed(viewer), row.id));
    }
        default:
          throw new NotFound(\`There is no action "\${String(args.action)}".\`);
      }
    default:
      throw new NotFound(\`There is no tool "\${name}".\`);
  }
}

/** How each caller is answered: the rules, then the host's model; a visitor by the rules only. */
const ASKS: Record<string, string> = {"admin":"model","member":"model"};

/** A kind's words for the wording rules, read from its module: the fields the caller reads. */
function kindWords(ui: ModelUi, fields: string[], filters: AskFilter[], numbers: string[], by: string[]): AskKind {
  const field = (name: string) => ui.fields.find((f) => f.name === name || f.relation?.key === name);
  return {
    model: ui.model ?? "",
    label: ui.label,
    pluralLabel: ui.pluralLabel,
    fields: fields.map((name) => ({ name, label: field(name)?.label ?? name })),
    filters: filters.map((f) =>
      f.by === "value"
        ? { ...f, labels: Object.fromEntries((field(f.field)?.choices ?? []).map((c) => [c.value, c.label])) }
        : f,
    ),
    numbers,
    by,
  };
}

/** Each caller's kinds of record in the words people use, for the wording rules (read when asked, in the language then). */
const WORDS: Record<string, () => AskKind[]> = {
  "admin": () => [
    kindWords(classTypeUi, ["name","summary","level","durationMinutes"], [{"field":"name","by":"text"},{"field":"level","by":"value","values":["beginner","allLevels","advanced"]},{"field":"durationMinutes","by":"number"}], ["durationMinutes"], ["level"]),
    kindWords(instructorUi, ["name","bio","portrait"], [{"field":"name","by":"text"}], [], []),
    kindWords(sessionUi, ["classType","instructor","startsAt","capacity"], [{"field":"classType","by":"reference","model":"ClassType"},{"field":"instructor","by":"reference","model":"Instructor"},{"field":"startsAt","by":"date"},{"field":"capacity","by":"number"}], ["capacity"], ["classType","instructor","startsAt"]),
    kindWords(bookingUi, ["session","attendee"], [{"field":"session","by":"reference","model":"Session"},{"field":"attendee","by":"reference","model":"User"}], [], ["session","attendee"]),
    kindWords(postUi, ["title","address","summary","cover","body","publishedOn","status"], [{"field":"title","by":"text"},{"field":"address","by":"text"},{"field":"publishedOn","by":"date"},{"field":"status","by":"value","values":["draft","published"]}], [], ["publishedOn","status"]),
    kindWords(messageUi, ["name","email","message"], [{"field":"name","by":"text"},{"field":"email","by":"text"}], [], []),
  ],
  "member": () => [
    kindWords(classTypeUi, ["name","summary","level","durationMinutes"], [{"field":"name","by":"text"},{"field":"level","by":"value","values":["beginner","allLevels","advanced"]},{"field":"durationMinutes","by":"number"}], ["durationMinutes"], ["level"]),
    kindWords(instructorUi, ["name","bio","portrait"], [{"field":"name","by":"text"}], [], []),
    kindWords(sessionUi, ["classType","instructor","startsAt","capacity"], [{"field":"classType","by":"reference","model":"ClassType"},{"field":"instructor","by":"reference","model":"Instructor"},{"field":"startsAt","by":"date"},{"field":"capacity","by":"number"}], ["capacity"], ["classType","instructor","startsAt"]),
    kindWords(bookingUi, ["session","attendee"], [{"field":"session","by":"reference","model":"Session"},{"field":"attendee","by":"reference","model":"User"}], [], ["session","attendee"]),
    kindWords(postUi, ["title","address","summary","cover","body","publishedOn","status"], [{"field":"title","by":"text"},{"field":"address","by":"text"},{"field":"publishedOn","by":"date"},{"field":"status","by":"value","values":["draft","published"]}], [], ["publishedOn","status"]),
    kindWords(messageUi, ["name","email","message"], [{"field":"name","by":"text"},{"field":"email","by":"text"}], [], []),
  ],
};

/** Whether the viewer gets "Ask": a role the assistant block names, or a visitor when it says anyone. */
export function asks(viewer: Viewer | null): boolean {
  return Object.hasOwn(ASKS, viewer?.role ?? "visitor");
}

/** A question answered as the person asking (or a visitor), with what they may read and do. */
export async function ask(viewer: Viewer | null, question: string, turns: Turn[] = []): Promise<Answer> {
  const caller = viewer?.role ?? "visitor";
  if (!Object.hasOwn(ASKS, caller)) throw new AccessDenied(viewer !== null);
  return answer(question, {
    offer: offerFor(viewer),
    kinds: WORDS[caller]?.() ?? [],
    call: (tool, args) => callTool(viewer, tool, args),
    turns,
    model: viewer && ASKS[caller] === "model" ? hostModel(viewer.id) : undefined,
    // A visitor is never answered by a model; a person signed in is told in the kit's words.
    unread: viewer
      ? undefined
      : 'The app answers questions it can read by itself, like "how many … are there?" or "show the … that …".',
    voice: "plain",
  });
}
"
`;

exports[`../../../examples/booking/smithable.yml > file list and generated code > src/generated/booking.name.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { nameOf } from "#/kit/format";
import { sessionName } from "./session.name";

/**
 * A booking's name: session (smithable.yml's namedBy). \`leave\`: parts a
 * page already shows another way (a calendar's start), left out.
 */
export function bookingName(row: Record<string, unknown>, leave: readonly string[] = []): string {
  const parts: [string, string][] = [
    ["session", (row.session as Record<string, unknown> | null | undefined) ? String(((row.session as Record<string, unknown> | null | undefined) as Record<string, unknown>).$name ?? sessionName((row.session as Record<string, unknown> | null | undefined) as Record<string, unknown>)) : ""],
  ];
  return nameOf(
    parts.filter(([part]) => !leave.includes(part)).map(([, words]) => words),
    \`Booking #\${row.id}\`,
  );
}
"
`;

exports[`../../../examples/booking/smithable.yml > file list and generated code > src/generated/booking.schema.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createInsertSchema } from "drizzle-zod";
