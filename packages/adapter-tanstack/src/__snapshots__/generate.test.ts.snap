exports[`../../../examples/crm/smithable.yml > file list and generated code > src/generated/customer.server.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { and, asc, eq, sql, type SQL } from "drizzle-orm";
import { db } from "#/db";
import { customers } from "#/db/schema";
import { AccessDenied, check, type ModelAccess, readScope, refusal, type Viewer } from "#/kit/access";
import { contains } from "#/kit/search";
import { afterChange, afterDelete } from "./hooks";
import { orderData } from "./order.server";
import type { CustomerValues } from "./customer";

/** Who may read, create, change and delete customers. */
export const customerAccess: ModelAccess = {
  read: { public: false, roles: ["admin", "sales"], owner: false },
  create: { public: false, roles: ["admin", "sales"], owner: false },
  write: { public: false, roles: ["admin", "sales"], owner: false },
  delete: { public: false, roles: ["admin"], owner: false },
};

/**
 * Whose record it is: anyone's for a role that may change everyone's, otherwise the viewer's
 * own, whatever the form sent.
 */
function ownerFor(viewer: Viewer | null, given: string | null | undefined): string | null {
  if (viewer && customerAccess.write.roles.includes(viewer.role)) return given ?? viewer.id;
  return viewer?.id ?? null;
}

export const customerData = {
  /** A condition for the customers the viewer may read. */
  readable(viewer: Viewer | null) {
    const scope = readScope(customerAccess.read, viewer);
    if (scope === "all") return undefined;
    return scope === "own" && viewer ? eq(customers.accountManagerId, viewer.id) : sql\`false\`;
  },

  canRead(viewer: Viewer | null, id: number): boolean {
    const found = db
      .select({ id: customers.id })
      .from(customers)
      .where(and(eq(customers.id, id), customerData.readable(viewer)))
      .get();
    return found !== undefined;
  },

  /** The customers the viewer may read; \`where\` narrows them, e.g. to a search. */
  async list(viewer: Viewer | null, where?: SQL) {
    if (readScope(customerAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const rows = await db.query.customers.findMany({
      where: and(customerData.readable(viewer), where),
      with: { accountManager: { columns: { id: true, name: true } } },
      orderBy: (t, { desc }) => [desc(t.id)],
    });
    return rows;
  },

  async get(viewer: Viewer | null, id: number) {
    const row = await db.query.customers.findFirst({
      where: and(eq(customers.id, id), customerData.readable(viewer)),
      with: { accountManager: { columns: { id: true, name: true } }, orders: { where: orderData.readable(viewer) } },
    });
    return row ? row : null;
  },

  async create(viewer: Viewer | null, values: CustomerValues) {
    check(customerAccess.create, viewer);
    let row: typeof customers.$inferSelect;
    try {
      row = db.insert(customers).values({ ...values, accountManagerId: ownerFor(viewer, values.accountManagerId) }).returning().get();
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterCreate", "Customer", row, viewer);
    return row;
  },

  async update(viewer: Viewer | null, id: number, values: CustomerValues) {
    const row = db
      .select({ accountManagerId: customers.accountManagerId })
      .from(customers)
      .where(and(eq(customers.id, id), customerData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(customerAccess.write, viewer, row.accountManagerId);
    let changed: typeof customers.$inferSelect;
    const updated = { ...values, accountManagerId: ownerFor(viewer, values.accountManagerId ?? row.accountManagerId) };
    try {
      changed = db.update(customers).set(updated).where(eq(customers.id, id)).returning().get();
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterUpdate", "Customer", changed, viewer);
    return changed;
  },

  async remove(viewer: Viewer | null, id: number): Promise<void> {
    const row = db
      .select({ accountManagerId: customers.accountManagerId })
      .from(customers)
      .where(and(eq(customers.id, id), customerData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(customerAccess.delete, viewer, row.accountManagerId);
    try {
      db.delete(customers).where(eq(customers.id, id)).run();
    } catch (error) {
      throw refusal(error);
    }
    await afterDelete("Customer", id, viewer);
  },

  /**
   * The customers the viewer may read whose name contains the text: a search of records that
   * refer to them finds them only among these.
   */
  titled(viewer: Viewer | null, text: string): number[] {
    return db
      .select({ id: customers.id })
      .from(customers)
      .where(and(contains([customers.name], text), customerData.readable(viewer)))
      .all()
      .map((row) => row.id);
  },

  /** Choices for fields that refer to a customer: the ones the viewer may read. */
  options(viewer: Viewer | null) {
    if (readScope(customerAccess.read, viewer) === "none") return [];
    return db
      .select({ value: customers.id, label: customers.name })
      .from(customers)
      .where(customerData.readable(viewer))
      .orderBy(asc(customers.name))
      .all();
  },
};
"
`;

exports[`../../../examples/crm/smithable.yml > file list and generated code > src/generated/customer.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { createInsertSchema } from "drizzle-zod";
import { z } from "zod";
import { customers } from "#/db/schema";
import { allows } from "#/kit/access";
import type { RecordUi } from "#/kit/model";
import { customerAccess, customerData } from "./customer.server";
import { writeAllowed } from "#/kit/limit";
import { currentViewer } from "#/lib/viewer.server";

/** The viewer about to write, counted against how often one may (see src/kit/limit.ts). */
async function writer() {
  const viewer = await currentViewer();
  writeAllowed(viewer, getRequestHeaders());
  return viewer;
}

/** Customer records as the kit reads them. */
export type CustomerRow = typeof customers.$inferSelect & {
  accountManager?: { id: string; name: string } | null;
};

export const customerUi: RecordUi<CustomerRow> = {
  model: "Customer",
  label: "Customer",
  pluralLabel: "Customers",
  titleField: "name",
  columns: ["name", "segment", "email", "phone", "creditLimit"],
  fields: [
    {
      name: "name",
      label: "Name",
      kind: "string",
      required: true,
      get: (row) => row.name,
    },
    {
      name: "email",
      label: "Email",
      kind: "email",
      required: false,
      get: (row) => row.email,
    },
    {
      name: "phone",
      label: "Phone",
      kind: "phone",
      required: false,
      get: (row) => row.phone,
    },
    {
      name: "segment",
      label: "Segment",
      kind: "choice",
      required: true,
      choices: [
        { value: "smb", label: "Smb" },
        { value: "enterprise", label: "Enterprise" },
        { value: "government", label: "Government" },
      ],
      default: "smb",
      get: (row) => row.segment,
    },
    {
      name: "creditLimit",
      label: "Credit limit",
      kind: "money",
      required: false,
      min: 0,
      get: (row) => row.creditLimit,
    },
    {
      name: "notes",
      label: "Notes",
      kind: "text",
      required: false,
      get: (row) => row.notes,
    },
    {
      name: "accountManagerId",
      label: "Account manager",
      kind: "user",
      required: false,
      relation: { key: "accountManager", titleField: "name" },
      get: (row) => row.accountManager?.name ?? null,
    },
  ],
};

export const customerSchema = createInsertSchema(customers, {
  name: (s) => s.trim().min(1, "Required").max(200, "At most 200 characters"),
  email: z.email("Enter a valid email address").nullish(),
  phone: (s) => s.regex(/^\\+?[0-9 ()-]{5,20}$/, "Enter a valid phone number"),
  creditLimit: (s) => s.min(0),
  notes: (s) => s.max(10000, "At most 10,000 characters"),
}).omit({ id: true, createdAt: true, updatedAt: true });

export type CustomerValues = z.output<typeof customerSchema>;

export const listCustomers = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return { rows: await customerData.list(viewer), canCreate: allows(customerAccess.create, viewer) };
});

export const getCustomer = createServerFn()
  .validator(z.number().int())
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    const row = await customerData.get(viewer, id);
    if (!row) return null;
    return {
      row,
      canWrite: allows(customerAccess.write, viewer, row.accountManagerId),
      canDelete: allows(customerAccess.delete, viewer, row.accountManagerId),
    };
  });

/** Choices for fields that refer to a customer. */
export const customerOptions = createServerFn().handler(async () =>
  customerData.options(await currentViewer()),
);

export const createCustomer = createServerFn({ method: "POST" })
  .validator(customerSchema)
  .handler(async ({ data }) => customerData.create(await writer(), data));

export const updateCustomer = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), values: customerSchema }))
  .handler(async ({ data }) => customerData.update(await writer(), data.id, data.values));

export const deleteCustomer = createServerFn({ method: "POST" })
  .validator(z.number().int())
  .handler(async ({ data: id }) => customerData.remove(await writer(), id));
"
`;

exports[`../../../examples/crm/smithable.yml > file list and generated code > src/generated/hooks.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// Where the app reacts to changes: after a record is created, changed or deleted, and once a
// day. Your reactions go in src/custom/hooks.ts (send an email, update another record, call a
// service); a plugin's in its own hooks file. A hook runs on the server, in the request that
// made the change and with the viewer who made it, after the change is saved; a hook that
// throws fails that request. Daily jobs run in production, a day after the server started.
import type { customers, orders } from "#/db/schema";
import type { Viewer } from "#/kit/access";
import * as custom from "#/custom/hooks";

export type Hook<Row> = (row: Row, viewer: Viewer | null) => void | Promise<void>;

/** Each model's record as it is stored. */
export interface Rows {
  Customer: typeof customers.$inferSelect;
  Order: typeof orders.$inferSelect;
}

export interface Hooks {
  /** After a record is created, by model. */
  afterCreate?: { [M in keyof Rows]?: Hook<Rows[M]> };
  /** After a record is changed, with its new values. */
  afterUpdate?: { [M in keyof Rows]?: Hook<Rows[M]> };
  /** After a record is deleted; only its id is left. */
  afterDelete?: { [M in keyof Rows]?: Hook<{ id: number }> };
  /** Once a day. */
  daily?: (() => void | Promise<void>)[];
}

// Read when a hook runs, not when this module loads: custom code may import the data functions,
// which import this file.
const sources = (): Hooks[] => [custom.hooks];

export async function afterChange<M extends keyof Rows>(
  event: "afterCreate" | "afterUpdate",
  model: M,
  row: Rows[M],
  viewer: Viewer | null,
): Promise<void> {
  for (const source of sources()) {
    // One model's hook at a time: TypeScript cannot narrow the lookup by a generic key.
    const hook = source[event]?.[model] as Hook<Rows[M]> | undefined;
    await hook?.(row, viewer);
  }
}

export async function afterDelete<M extends keyof Rows>(
  model: M,
  id: number,
  viewer: Viewer | null,
): Promise<void> {
  for (const source of sources()) {
    const hook = source.afterDelete?.[model] as Hook<{ id: number }> | undefined;
    await hook?.({ id }, viewer);
  }
}

/** Every daily job, in order; a failing one is reported and the rest still run. */
export async function runDaily(): Promise<void> {
  for (const source of sources())
    for (const job of source.daily ?? []) {
      try {
        await job();
      } catch (error) {
        console.error("A daily job failed:", error);
      }
    }
}

// In production, once a day, starting a day after the server started (pnpm start). The timer
// never keeps the process alive by itself, so the server still stops when asked to.
if (import.meta.env.SSR && import.meta.env.PROD) {
  const day = 24 * 60 * 60 * 1000;
  const tick = () => setTimeout(() => runDaily().finally(tick), day).unref();
  tick();
}
"
`;

