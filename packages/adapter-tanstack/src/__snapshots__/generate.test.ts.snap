  client?: { id: number; name: string } | null;
  total?: unknown;
};

export const invoiceUi: RecordUi<InvoiceRow> = {
  model: "Invoice",
  label: "Invoice",
  pluralLabel: "Invoices",
  titleField: "number",
  columns: ["number", "clientId", "issuedOn", "dueOn", "status"],
  fields: [
    {
      name: "number",
      label: "Number",
      kind: "string",
      required: true,
      get: (row) => row.number,
    },
    {
      name: "clientId",
      label: "Client",
      kind: "relation",
      required: true,
      relation: { key: "client", titleField: "name" },
      get: (row) => row.client?.name ?? null,
    },
    {
      name: "issuedOn",
      label: "Issued on",
      kind: "date",
      required: true,
      get: (row) => row.issuedOn,
    },
    {
