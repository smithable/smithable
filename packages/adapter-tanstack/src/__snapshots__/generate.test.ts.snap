describe("Booking", () => {
  test("admin", async () => {
    const viewer = signedIn("admin");
    const others = insertBooking(stranger.id);
    const own = insertBooking(viewer.id);
    expect({
      readOthers: await reads(bookingData, viewer, others.id),
      readOwn: await reads(bookingData, viewer, own.id),
      create: await can(() => bookingData.create(viewer, bookingValues(viewer.id))),
      changeOthers: await can(() => bookingData.update(viewer, others.id, bookingValues(viewer.id))),
      changeOwn: await can(() => bookingData.update(viewer, own.id, bookingValues(viewer.id))),
      deleteOthers: await can(() => bookingData.remove(viewer, others.id)),
      deleteOwn: await can(() => bookingData.remove(viewer, own.id)),
    }).toEqual({
      readOthers: true,
      readOwn: true,
      create: true,
      changeOthers: true,
      changeOwn: true,
      deleteOthers: true,
      deleteOwn: true,
    });
  });

  test("member", async () => {
    const viewer = signedIn("member");
    const others = insertBooking(stranger.id);
    const own = insertBooking(viewer.id);
    expect({
      readOthers: await reads(bookingData, viewer, others.id),
      readOwn: await reads(bookingData, viewer, own.id),
      create: await can(() => bookingData.create(viewer, bookingValues(viewer.id))),
      changeOthers: await can(() => bookingData.update(viewer, others.id, bookingValues(viewer.id))),
      changeOwn: await can(() => bookingData.update(viewer, own.id, bookingValues(viewer.id))),
      deleteOthers: await can(() => bookingData.remove(viewer, others.id)),
      deleteOwn: await can(() => bookingData.remove(viewer, own.id)),
    }).toEqual({
      readOthers: false,
      readOwn: true,
      create: true,
      changeOthers: false,
      changeOwn: true,
      deleteOthers: false,
      deleteOwn: true,
    });
  });

  test("a visitor who has not signed in", async () => {
    const viewer = null;
    const others = insertBooking(stranger.id);
    expect({
      readOthers: await reads(bookingData, viewer, others.id),
      readOwn: false,
      create: await can(() => bookingData.create(viewer, bookingValues(null))),
      changeOthers: await can(() => bookingData.update(viewer, others.id, bookingValues(null))),
      changeOwn: false,
      deleteOthers: await can(() => bookingData.remove(viewer, others.id)),
      deleteOwn: false,
    }).toEqual({
      readOthers: false,
      readOwn: false,
      create: false,
      changeOthers: false,
      changeOwn: false,
      deleteOthers: false,
      deleteOwn: false,
    });
  });

  test("a capacity: at most 1 per session, and the number cannot go below what is taken", async () => {
    const viewer = signedIn("admin");
    const place = db.insert(sessions).values({ ...{ ...sessionValues(viewer.id), capacity: 1 }, ownerId: viewer.id }).returning().get();
    for (let i = 0; i < 1; i++)
      await bookingData.create(signedIn("admin"), { ...bookingValues(viewer.id), sessionId: place.id });
    await expect(bookingData.create(signedIn("admin"), { ...bookingValues(viewer.id), sessionId: place.id })).rejects.toThrow("full");
    await expect(sessionData.update(signedIn("admin"), place.id, { ...{ ...sessionValues(viewer.id), capacity: 1 }, capacity: 0 })).rejects.toThrow("booked:1");
  });
});

describe("Post", () => {
  test("admin", async () => {
    const viewer = signedIn("admin");
    const others = insertPost(stranger.id, {"status":"published"});
    const own = insertPost(viewer.id, {"status":"published"});
    expect({
      readOthers: await reads(postData, viewer, others.id),
      readOwn: await reads(postData, viewer, own.id),
      create: await can(() => postData.create(viewer, postValues(viewer.id))),
      changeOthers: await can(() => postData.update(viewer, others.id, postValues(viewer.id))),
      changeOwn: await can(() => postData.update(viewer, own.id, postValues(viewer.id))),
      deleteOthers: await can(() => postData.remove(viewer, others.id)),
      deleteOwn: await can(() => postData.remove(viewer, own.id)),
    }).toEqual({
      readOthers: true,
      readOwn: true,
      create: true,
      changeOthers: true,
      changeOwn: true,
      deleteOthers: true,
      deleteOwn: true,
    });
  });

  test("member", async () => {
    const viewer = signedIn("member");
    const others = insertPost(stranger.id, {"status":"published"});
    const own = insertPost(viewer.id, {"status":"published"});
    expect({
      readOthers: await reads(postData, viewer, others.id),
      readOwn: await reads(postData, viewer, own.id),
      create: await can(() => postData.create(viewer, postValues(viewer.id))),
      changeOthers: await can(() => postData.update(viewer, others.id, postValues(viewer.id))),
      changeOwn: await can(() => postData.update(viewer, own.id, postValues(viewer.id))),
      deleteOthers: await can(() => postData.remove(viewer, others.id)),
      deleteOwn: await can(() => postData.remove(viewer, own.id)),
    }).toEqual({
      readOthers: true,
      readOwn: true,
      create: false,
      changeOthers: false,
      changeOwn: false,
      deleteOthers: false,
      deleteOwn: false,
    });
  });

  test("a visitor who has not signed in", async () => {
    const viewer = null;
    const others = insertPost(stranger.id, {"status":"published"});
    expect({
      readOthers: await reads(postData, viewer, others.id),
      readOwn: false,
      create: await can(() => postData.create(viewer, postValues(null))),
      changeOthers: await can(() => postData.update(viewer, others.id, postValues(null))),
      changeOwn: false,
      deleteOthers: await can(() => postData.remove(viewer, others.id)),
      deleteOwn: false,
    }).toEqual({
      readOthers: true,
      readOwn: false,
      create: false,
      changeOthers: false,
      changeOwn: false,
      deleteOthers: false,
      deleteOwn: false,
    });
  });

  test("visitors read only post records where status is published", async () => {
    const fitting = insertPost(stranger.id, {"status":"published"});
    const hidden = insertPost(stranger.id, {"status":"draft"});
    expect(await reads(postData, null, fitting.id)).toBe(true);
    expect(await reads(postData, null, hidden.id)).toBe(false);
    expect((await postData.list(null)).map((r) => r.id)).not.toContain(hidden.id);
    expect(await reads(postData, signedIn("admin"), hidden.id)).toBe(true);
  });
});

