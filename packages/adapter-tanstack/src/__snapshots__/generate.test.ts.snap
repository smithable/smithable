  count(viewer: Viewer | null): number | null {
    if (readScope(instructorAccess.read, viewer) === "none") return null;
    return db.select({ n: count() }).from(instructors).where(instructorData.readable(viewer)).get()?.n ?? 0;
  },

  async get(viewer: Viewer | null, id: number) {
    const row = await db.query.instructors.findFirst({
      where: and(eq(instructors.id, id), instructorData.readable(viewer)),
    });
    return row ? row : null;
  },

  async create(viewer: Viewer | null, values: InstructorValues) {
    check(instructorAccess.create, viewer);
    let row: typeof instructors.$inferSelect;
    try {
      row = db.insert(instructors).values({ ...values, ownerId: viewer?.id ?? null }).returning().get();
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterCreate", "Instructor", row, viewer);
    return row;
  },

  async update(viewer: Viewer | null, id: number, values: InstructorValues) {
    const row = db
      .select({ ownerId: instructors.ownerId, portrait: instructors.portrait })
      .from(instructors)
      .where(and(eq(instructors.id, id), instructorData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(instructorAccess.write, viewer, row.ownerId);
    let changed: typeof instructors.$inferSelect;
    const updated = values;
    try {
      changed = db.update(instructors).set(updated).where(eq(instructors.id, id)).returning().get();
    } catch (error) {
      throw refusal(error);
    }
    if (row.portrait && row.portrait.file !== changed.portrait?.file) deletePicture(row.portrait, !!db.select({ id: instructors.id }).from(instructors).where(sql\`\${instructors.portrait} like \${\`%"file":"\${row.portrait.file}"%\`}\`).get());
    await afterChange("afterUpdate", "Instructor", changed, viewer);
    return changed;
  },

  async remove(viewer: Viewer | null, id: number): Promise<void> {
    const row = db
      .select({ ownerId: instructors.ownerId, portrait: instructors.portrait })
      .from(instructors)
      .where(and(eq(instructors.id, id), instructorData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(instructorAccess.delete, viewer, row.ownerId);
    try {
      db.delete(instructors).where(eq(instructors.id, id)).run();
    } catch (error) {
      throw refusal(error);
    }
    if (row.portrait && row.portrait.file !== undefined) deletePicture(row.portrait, !!db.select({ id: instructors.id }).from(instructors).where(sql\`\${instructors.portrait} like \${\`%"file":"\${row.portrait.file}"%\`}\`).get());
    await afterDelete("Instructor", id, viewer);
  },

  /**
   * The instructors the viewer may read whose name contains the text: a search of records that
   * refer to them finds them only among these.
   */
  titled(viewer: Viewer | null, text: string): number[] {
    return db
      .select({ id: instructors.id })
      .from(instructors)
      .where(and(contains([instructors.name], text), instructorData.readable(viewer)))
      .all()
      .map((row) => row.id);
  },

  /** Choices for fields that refer to a instructor: the ones the viewer may read. */
  options(viewer: Viewer | null) {
    if (readScope(instructorAccess.read, viewer) === "none") return [];
    return db
      .select({ value: instructors.id, label: instructors.name })
      .from(instructors)
      .where(instructorData.readable(viewer))
      .orderBy(asc(instructors.name))
      .all();
  },
};
"
`;

