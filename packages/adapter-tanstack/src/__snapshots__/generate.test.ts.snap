/** The offer for a caller; a role the app does not know gets nothing. */
export function offerFor(viewer: Viewer | null): Offer & { describe: Record<string, string> } {
  const caller = viewer?.role ?? "visitor";
  return Object.hasOwn(OFFERS, caller) ? OFFERS[caller] : { summary: "", tools: [], describe: {} };
}

/** Each kind's data functions and conversions, its title field, and its references' titles. */
const KINDS = {
  ClassType: { data: classTypeData, toApi: classTypeToApi, fromApi: classTypeFromApi, title: "name", refs: {}, searched: ["name","summary"], label: "class type", named: (viewer: Viewer | null, text: string) => classTypeData.named(viewer, text) },
  Instructor: { data: instructorData, toApi: instructorToApi, fromApi: instructorFromApi, title: "name", refs: {}, searched: ["name","bio"], label: "instructor", named: (viewer: Viewer | null, text: string) => instructorData.named(viewer, text) },
  Session: { data: sessionData, toApi: sessionToApi, fromApi: sessionFromApi, title: "id", refs: {"classType":"name","instructor":"name"}, searched: [], label: "session", named: undefined },
  Booking: { data: bookingData, toApi: bookingToApi, fromApi: bookingFromApi, title: "id", refs: {"session":"id"}, searched: [], label: "booking", named: undefined },
  Post: { data: postData, toApi: postToApi, fromApi: postFromApi, title: "title", refs: {}, searched: ["title","address","summary","body"], label: "post", named: (viewer: Viewer | null, text: string) => postData.named(viewer, text) },
  Message: { data: messageData, toApi: messageToApi, fromApi: messageFromApi, title: "name", refs: {}, searched: ["name","email","message"], label: "message", named: (viewer: Viewer | null, text: string) => messageData.named(viewer, text) },
};
type Kind = (typeof KINDS)[keyof typeof KINDS];

const kindOf = (args: Record<string, unknown>): Kind => {
  const kind = KINDS[args.kind as keyof typeof KINDS];
  if (!kind) throw new BadInput(\`There is no kind "\${String(args.kind)}". Kinds: \${Object.keys(KINDS).join(", ")}.\`);
  return kind;
};

/**
 * A record the caller may use, by its id or by its title (an invoice's number): one that fits,
 * never a guess; "not there" and "not yours" are the same answer.
 */
async function found(kind: Kind, viewer: Viewer | null, id: unknown, verb = "read") {
  let key = Number.isInteger(id) ? (id as number) : /^\\d+$/.test(String(id)) ? Number(id) : undefined;
  if (key === undefined && typeof id === "string" && kind.named) {
    const fits = kind.named(viewer, id);
    const exact = fits.filter((r) => r.title.toLowerCase() === id.toLowerCase());
    const pick = exact.length === 1 ? exact : fits;
    if (pick.length > 1)
      throw new BadInput(\`"\${id}" fits several: \${pick.slice(0, 5).map((r) => \`\${r.title} (\${r.id})\`).join(", ")}. Give its whole \${kind.title} or its id.\`);
    key = pick[0]?.id;
  }
  const row = key === undefined ? null : await kind.data.get(viewer, key);
  if (!row) throw new NotFound(\`No \${kind.label} \${String(id)} that you may \${verb}; find it first.\`);
  return row;
}

/** A field's value in a row: a reference as its id and title, nothing else changed. */
function shown(kind: Kind, row: Record<string, unknown>, api: Record<string, unknown>, field: string): unknown {
  const title = (kind.refs as Record<string, string>)[field];
  const related = row[field] as Record<string, unknown> | null | undefined;
  if (title && related && typeof related === "object")
    return related.deletedAt ? { id: related.id, inTrash: true } : { id: related.id, title: related[title] };
  if (!(field in api)) throw new BadInput(\`There is no field "\${field}". Fields: \${Object.keys(api).join(", ")}.\${field === "title" ? \` The title field is \${kind.title}.\` : ""}\`);
  return api[field];
}

/** "count", "sum total", "average total", "min …", "max …" as measure's own words. */
function measureOf(of: unknown): { how: "count" | "sum" | "average" | "smallest" | "largest"; field?: string } {
  const [word = "count", field] = String(of ?? "count").trim().split(/\\s+/);
  const how = ({ count: "count", sum: "sum", average: "average", min: "smallest", max: "largest" } as const)[word as "count"];
  if (!how) throw new BadInput('"of" is count, or sum, average, min or max with a number field, e.g. "sum total".');
  return { how, field };
}

/** Calls one tool as the key's role, or as a visitor without a key. */
export async function callTool(viewer: Viewer | null, name: string, args: Record<string, unknown>): Promise<unknown> {
  switch (name) {
    case "find": {
      const kind = kindOf(args);
      const limit = Math.min(50, Math.max(1, Number(args.limit) || 10));
      const page = Math.max(1, Number(args.page) || 1);
      const { items, total } = await kind.data.find(viewer, {
        where: args.where,
        search: typeof args.search === "string" ? args.search : undefined,
        sort: typeof args.sort === "string" ? args.sort : undefined,
        limit,
        offset: (page - 1) * limit,
      });
      const asked = Array.isArray(args.fields) ? args.fields.map(String) : [];
      const columns = [...new Set(["id", kind.title, ...asked])];
      const rows = items.map((row) => {
        const api = kind.toApi(row as Record<string, any>) as Record<string, unknown>;
        return columns.map((field) => shown(kind, row as Record<string, unknown>, api, field));
      });
      // Nothing found by a search: say where it looked, and how a reference is matched instead.
      const refs = Object.keys(kind.refs);
      if (!total && typeof args.search === "string")
        return {
          columns,
          rows,
          total,
          note: \`Nothing has every word of "\${args.search}" in \${kind.searched.join(", ") || "the texts"}.\${refs.length ? \` A \${refs[0]} is matched with where, e.g. {"\${refs[0]}": "…"}.\` : ""}\`,
        };
      return { columns, rows, total };
    }
    case "measure": {
      const kind = kindOf(args);
      const { how, field } = measureOf(args.of);
      const options = { field, where: args.where, search: typeof args.search === "string" ? args.search : undefined };
      if (typeof args.by === "string") return { by: args.by, rows: await kind.data.measureBy(viewer, how, args.by, options) };
      const value = await kind.data.measure(viewer, how, options);
      // The smallest or largest: which record holds it.
      if ((how === "smallest" || how === "largest") && value !== null)
        return { [how]: value, of: await kind.data.holder(viewer, how, options) };
      return { [how === "count" ? "total" : how]: value };
    }
    case "read": {
      const kind = kindOf(args);
      return kind.toApi((await found(kind, viewer, args.id)) as Record<string, any>);
    }
    case "add": {
      const kind = kindOf(args);
      return kind.toApi(await kind.data.create(viewer, kind.fromApi(args.values ?? {}) as never));
    }
    case "change": {
      const kind = kindOf(args);
      const row = await found(kind, viewer, args.id, "change");
      return kind.toApi(await kind.data.update(viewer, row.id, kind.fromApi(args.values ?? {}, row as Record<string, unknown>) as never));
    }
    case "delete": {
      const kind = kindOf(args);
      const row = await found(kind, viewer, args.id, "delete");
      await kind.data.remove(viewer, row.id, args.together === true);
      return { deleted: row.id };
    }
    case "describe":
      kindOf(args);
      return { description: offerFor(viewer).describe[args.kind as string] };
    case "run":
      switch (args.action) {

        default:
          throw new NotFound(\`There is no action "\${String(args.action)}".\`);
      }
    default:
      throw new NotFound(\`There is no tool "\${name}".\`);
  }
}

/** How each caller is answered: the rules, then the host's model; a visitor by the rules only. */
const ASKS: Record<string, string> = {"admin":"model","member":"model"};

/** Each caller's kinds of record in the words people use, for the wording rules. */
const WORDS: Record<string, AskKind[]> = {"admin":[{"model":"ClassType","label":"Class type","pluralLabel":"Class types","fields":[{"name":"name","label":"Name"},{"name":"summary","label":"Summary"},{"name":"level","label":"Level"},{"name":"durationMinutes","label":"Duration minutes"}],"filters":[{"field":"name","by":"text"},{"field":"level","by":"value","values":["beginner","allLevels","advanced"]},{"field":"durationMinutes","by":"number"}],"numbers":["durationMinutes"],"by":["level"]},{"model":"Instructor","label":"Instructor","pluralLabel":"Instructors","fields":[{"name":"name","label":"Name"},{"name":"bio","label":"Bio"},{"name":"portrait","label":"Portrait"}],"filters":[{"field":"name","by":"text"}],"numbers":[],"by":[]},{"model":"Session","label":"Session","pluralLabel":"Sessions","fields":[{"name":"classType","label":"Class type"},{"name":"instructor","label":"Instructor"},{"name":"startsAt","label":"Starts at"},{"name":"capacity","label":"Capacity"}],"filters":[{"field":"classType","by":"reference","model":"ClassType"},{"field":"instructor","by":"reference","model":"Instructor"},{"field":"startsAt","by":"date"},{"field":"capacity","by":"number"}],"numbers":["capacity"],"by":["classType","instructor","startsAt"]},{"model":"Booking","label":"Booking","pluralLabel":"Bookings","fields":[{"name":"session","label":"Session"}],"filters":[{"field":"session","by":"reference","model":"Session"}],"numbers":[],"by":["session"]},{"model":"Post","label":"Post","pluralLabel":"Posts","fields":[{"name":"title","label":"Title"},{"name":"address","label":"Address"},{"name":"summary","label":"Summary"},{"name":"cover","label":"Cover"},{"name":"body","label":"Body"},{"name":"publishedOn","label":"Published on"},{"name":"status","label":"Status"}],"filters":[{"field":"title","by":"text"},{"field":"address","by":"text"},{"field":"publishedOn","by":"date"},{"field":"status","by":"value","values":["draft","published"]}],"numbers":[],"by":["publishedOn","status"]},{"model":"Message","label":"Message","pluralLabel":"Messages","fields":[{"name":"name","label":"Name"},{"name":"email","label":"Email"},{"name":"message","label":"Message"}],"filters":[{"field":"name","by":"text"},{"field":"email","by":"text"}],"numbers":[],"by":[]}],"member":[{"model":"ClassType","label":"Class type","pluralLabel":"Class types","fields":[{"name":"name","label":"Name"},{"name":"summary","label":"Summary"},{"name":"level","label":"Level"},{"name":"durationMinutes","label":"Duration minutes"}],"filters":[{"field":"name","by":"text"},{"field":"level","by":"value","values":["beginner","allLevels","advanced"]},{"field":"durationMinutes","by":"number"}],"numbers":["durationMinutes"],"by":["level"]},{"model":"Instructor","label":"Instructor","pluralLabel":"Instructors","fields":[{"name":"name","label":"Name"},{"name":"bio","label":"Bio"},{"name":"portrait","label":"Portrait"}],"filters":[{"field":"name","by":"text"}],"numbers":[],"by":[]},{"model":"Session","label":"Session","pluralLabel":"Sessions","fields":[{"name":"classType","label":"Class type"},{"name":"instructor","label":"Instructor"},{"name":"startsAt","label":"Starts at"},{"name":"capacity","label":"Capacity"}],"filters":[{"field":"classType","by":"reference","model":"ClassType"},{"field":"instructor","by":"reference","model":"Instructor"},{"field":"startsAt","by":"date"},{"field":"capacity","by":"number"}],"numbers":["capacity"],"by":["classType","instructor","startsAt"]},{"model":"Booking","label":"Booking","pluralLabel":"Bookings","fields":[{"name":"session","label":"Session"}],"filters":[{"field":"session","by":"reference","model":"Session"}],"numbers":[],"by":["session"]},{"model":"Post","label":"Post","pluralLabel":"Posts","fields":[{"name":"title","label":"Title"},{"name":"address","label":"Address"},{"name":"summary","label":"Summary"},{"name":"cover","label":"Cover"},{"name":"body","label":"Body"},{"name":"publishedOn","label":"Published on"},{"name":"status","label":"Status"}],"filters":[{"field":"title","by":"text"},{"field":"address","by":"text"},{"field":"publishedOn","by":"date"},{"field":"status","by":"value","values":["draft","published"]}],"numbers":[],"by":["publishedOn","status"]},{"model":"Message","label":"Message","pluralLabel":"Messages","fields":[{"name":"name","label":"Name"},{"name":"email","label":"Email"},{"name":"message","label":"Message"}],"filters":[{"field":"name","by":"text"},{"field":"email","by":"text"}],"numbers":[],"by":[]}]};

/** Whether the viewer gets "Ask": a role the assistant block names, or a visitor when it says anyone. */
export function asks(viewer: Viewer | null): boolean {
  return Object.hasOwn(ASKS, viewer?.role ?? "visitor");
}

/** A question answered as the person asking (or a visitor), with what they may read and do. */
export async function ask(viewer: Viewer | null, question: string): Promise<Answer> {
  const caller = viewer?.role ?? "visitor";
  if (!Object.hasOwn(ASKS, caller)) throw new AccessDenied(viewer !== null);
  return answer(question, {
    offer: offerFor(viewer),
    kinds: WORDS[caller],
    call: (tool, args) => callTool(viewer, tool, args),
    model: viewer && ASKS[caller] === "model" ? hostModel(viewer.id) : undefined,
    // A visitor is never answered by a model; a person signed in is told in the kit's words.
    unread: viewer
      ? undefined
      : 'The app answers questions it can read by itself, like "how many … are there?" or "show the … that …".',
    voice: "plain",
  });
}
"
`;

exports[`../../../examples/booking/smithable.yml > file list and generated code > src/generated/booking.schema.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createInsertSchema } from "drizzle-zod";
import type { z } from "zod";
import * as schema from "#/db/schema";

/** What a booking's form sends, checked. */
export const bookingSchema = createInsertSchema(schema.bookings).omit({ id: true, ownerId: true, createdAt: true, updatedAt: true });

export type BookingValues = z.output<typeof bookingSchema>;
"
`;

exports[`../../../examples/booking/smithable.yml > file list and generated code > src/generated/booking.server.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { type AnyColumn, and, asc, avg, count, desc, eq, inArray, isNotNull, max, min, ne, sql, sum, type SQL } from "drizzle-orm";
import { db } from "#/db";
import * as schema from "#/db/schema";
import { AccessDenied, allows, check, Conflict, type ModelAccess, personOf, readScope, type Viewer } from "#/kit/access";
import { audit, changedFields } from "#/kit/audit.server";
import { refusal } from "#/kit/log.server";
import { outgoing } from "#/generated/outgoing.server";
import { BadInput } from "#/kit/refusal";
import { aggregate, type Filterable, sortOf, whereOf, wordsOf } from "#/kit/where";
import { afterChange, afterDelete } from "./hooks";
import { sessionData } from "./session.server";
import type { BookingValues } from "./booking";

/** Who may read, create, change and delete bookings. */
export const bookingAccess: ModelAccess = {
  read: { public: false, roles: ["admin"], owner: true },
  create: { public: false, roles: ["admin", "member"], owner: false },
  write: { public: false, roles: ["admin"], owner: true },
  delete: { public: false, roles: ["admin"], owner: true },
};

/** A record as the viewer gets it: who owns it only for its owner and roles that read every record. */
function shownTo<R extends { ownerId: string | null }>(viewer: Viewer | null, row: R): R {
  if (viewer && (row.ownerId === viewer.id || bookingAccess.read.roles.includes(viewer.role))) return row;
  return { ...row, ownerId: null };
}


/** What \`where\` may name, and how: the stored fields, by kind. */
const FILTERABLE: Record<string, Filterable> = {
  session: { kind: "reference", column: schema.bookings.sessionId },
};

/** What the records can be sorted by. */
const SORTABLE = { id: schema.bookings.id, createdAt: schema.bookings.createdAt };

/** The number fields \`measure\` adds up; amounts are stored in cents. */
const NUMBERS: Record<string, AnyColumn> = {  };
const MONEY: string[] = [];

/** Computed number fields \`measure\` adds up from the records themselves. */
const COMPUTED: string[] = [];

/** The titles of the referenced records \`measureBy\` splits by, to name its groups. */
function titlesOf(_viewer: Viewer | null, _by: string, _ids: number[]): Map<unknown, string> {
  switch (_by) {
    default:
      return new Map();
  }
}

/** What \`measureBy\` may split by: choices, yes/no, references, and dates by month. */
const BY: string[] = ["session"];


/** Checks that the viewer may read the records the values refer to. */
function checkReferences(viewer: Viewer | null, values: BookingValues): void {
  if (values.sessionId != null && !sessionData.canRead(viewer, values.sessionId))
    throw new AccessDenied(viewer !== null);
}

/** \`rows\` with each \`field\` reference \`readable\` leaves out set to nothing (only its id stays). */
function hideRefs<R extends Record<string, unknown>>(rows: R[], field: string, readable: (ids: number[]) => number[]): R[] {
  const idOf = (row: R) => (row[field] as { id?: unknown } | null | undefined)?.id;
  const ids = [...new Set(rows.map(idOf).filter((id): id is number => typeof id === "number"))];
  if (!ids.length) return rows;
  const shown = new Set(readable(ids));
  return rows.map((row) => {
    const id = idOf(row);
    return typeof id === "number" && !shown.has(id) ? { ...row, [field]: null } : row;
  });
}

export const bookingData = {
  shownTo,
  /** The rows with each reference to a record the viewer may not read set to nothing: a related record's title is shown only to who may read it (only its id stays). */
  shownRefs<R extends Record<string, unknown>>(viewer: Viewer | null, rows: R[]): R[] {
    return hideRefs(rows, "session", (ids, c = sessionData.readable(viewer)) => (c ? db.select({ id: schema.sessions.id }).from(schema.sessions).where(and(inArray(schema.sessions.id, ids), c)).all().map((r) => r.id) : ids));
  },

  /** A condition for the bookings the viewer may read. */
  readable(viewer: Viewer | null) {
    const scope = readScope(bookingAccess.read, viewer);
    if (scope === "all") return undefined;
    return scope === "own" && viewer ? eq(schema.bookings.ownerId, viewer.id) : sql\`false\`;
  },

  canRead(viewer: Viewer | null, id: number): boolean {
    const found = db
      .select({ id: schema.bookings.id })
      .from(schema.bookings)
      .where(and(eq(schema.bookings.id, id), bookingData.readable(viewer)))
      .get();
    return found !== undefined;
  },

  /** The bookings the viewer may read; \`where\` narrows them, e.g. to a search; \`limit\` keeps the newest (a data page). */
  async list(viewer: Viewer | null, where?: SQL, limit?: number) {
    if (readScope(bookingAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const found = bookingData.shownRefs(viewer, await db.query.bookings.findMany({
      where: and(bookingData.readable(viewer), where),
      with: { session: { columns: { id: true } } },
      orderBy: (t, { desc }) => [desc(t.id)],
      limit,
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return rows;
  },

  /**
   * A page of the bookings the viewer may read that fit \`where\`, newest first (or in
   * \`order\`), and how many fit in all: for a list page. A page past the end is the last one.
   */
  async page(viewer: Viewer | null, where?: SQL, order?: SQL, page = 1, size = 50) {
    if (readScope(bookingAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = and(bookingData.readable(viewer), where);
    const total = db.select({ n: count() }).from(schema.bookings).where(condition).get()?.n ?? 0;
    const at = Math.min(Math.max(1, Math.trunc(page)), Math.max(1, Math.ceil(total / size)));
    const found = bookingData.shownRefs(viewer, await db.query.bookings.findMany({
      where: condition,
      with: { session: { columns: { id: true } } },
      orderBy: (t, { desc }) => [...(order ? [order] : []), desc(t.id)],
      limit: size,
      offset: (at - 1) * size,
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return { rows: rows, total, page: at, size };
  },

  /**
   * The bookings the viewer may read that fit \`where\` and \`search\`, in \`sort\`'s order (else newest
   * first), a page of them and how many there are: for the API and the assistants' tools.
   */
  async find(
    viewer: Viewer | null,
    options: { where?: unknown; search?: string; sort?: string; limit?: number; offset?: number } = {},
  ) {
    if (readScope(bookingAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = bookingData.fitting(viewer, options.where, options.search);
    const order = sortOf(SORTABLE, options.sort);
    const total = db.select({ n: count() }).from(schema.bookings).where(condition).get()?.n ?? 0;
    const found = bookingData.shownRefs(viewer, await db.query.bookings.findMany({
      where: condition,
      with: { session: { columns: { id: true } } },
      orderBy: (t, { desc }) => [...(order ? [order] : []), desc(t.id)],
      limit: options.limit ?? 100,
      offset: options.offset ?? 0,
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return { items: rows, total };
  },

  /**
   * A number from the bookings the viewer may read that fit \`where\`: how many, or the sum,
   * average, smallest or largest of a number field.
   */
  async measure(
    viewer: Viewer | null,
    how: "count" | "sum" | "average" | "smallest" | "largest",
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<number | null> {
    if (readScope(bookingAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = bookingData.fitting(viewer, options.where, options.search);
    if (how === "count")
      return db.select({ n: count() }).from(schema.bookings).where(condition).get()?.n ?? 0;
    const field = options.field ?? "";
    const money = MONEY.includes(field);
    if (COMPUTED.includes(field)) {
      const rows = await bookingData.computedRows(condition);
      const value = aggregate(rows.map((row) => row[field]), how);
      return value === null ? null : money ? value / 100 : value;
    }
    const column = NUMBERS[field];
    if (!column)
      throw new BadInput(
        \`\${how} needs a number field: \${[...Object.keys(NUMBERS), ...COMPUTED].join(", ") || "there are none"}.\`,
      );
    const pick = { sum, average: avg, smallest: min, largest: max }[how];
    const value = db.select({ v: pick(column) }).from(schema.bookings).where(condition).get()?.v;
    if (value === null || value === undefined) return null;
    return money ? Number(value) / 100 : Number(value);
  },

  /** Which record holds the smallest or largest value of a number field (the first of a tie). */
  async holder(
    viewer: Viewer | null,
    how: "smallest" | "largest",
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<{ id: number; title: string } | null> {
    const condition = bookingData.fitting(viewer, options.where, options.search);
    const field = options.field ?? "";
    if (COMPUTED.includes(field)) {
      let best: Record<string, unknown> | undefined;
      for (const row of await bookingData.computedRows(condition)) {
        const v = row[field];
        if (typeof v !== "number") continue;
        if (!best || (how === "largest" ? v > (best[field] as number) : v < (best[field] as number))) best = row;
      }
      return best ? { id: best.id as number, title: String(best.id) } : null;
    }
    const column = NUMBERS[field];
    if (!column) return null;
    const row = db
      .select({ id: schema.bookings.id, title: schema.bookings.id })
      .from(schema.bookings)
      .where(and(condition, isNotNull(column)))
      .orderBy(how === "largest" ? desc(column) : asc(column), asc(schema.bookings.id))
      .limit(1)
      .get();
    return row ? { id: row.id, title: String(row.title) } : null;
  },

  /**
   * The same number per value of a field (a choice, yes/no, a reference) or per month of a date:
   * \`[{ value, number }]\`, the most first.
   */
  async measureBy(
    viewer: Viewer | null,
    how: "count" | "sum" | "average" | "smallest" | "largest",
    by: string,
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<{ value: unknown; title?: string; number: number | null }[]> {
    if (readScope(bookingAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const split = FILTERABLE[by];
    if (!split || split.kind === "text" || split.kind === "number" || split.kind === "money")
      throw new BadInput(\`There is no field "\${by}" to split by. Fields: \${BY.join(", ")}.\`);
    const field = options.field ?? "";
    const money = MONEY.includes(field);
    const condition = bookingData.fitting(viewer, options.where, options.search);
    const amount = (n: number | null) => (n === null ? null : money ? n / 100 : n);
    const most = (a: { number: number | null }, b: { number: number | null }) => (b.number ?? 0) - (a.number ?? 0);
    // A reference's groups carry the referenced record's title beside its id.
    const named = (rows: { value: unknown; number: number | null }[]) => {
      if (split.kind !== "reference") return rows;
      const titles = titlesOf(viewer, by, rows.map((r) => r.value).filter((v): v is number => typeof v === "number"));
      return rows.map((r) => (titles.has(r.value) ? { value: r.value, title: titles.get(r.value), number: r.number } : r));
    };
    if (COMPUTED.includes(field)) {
      // Each record's month or value, then the computed numbers added up per group.
      const groups = new Map<unknown, unknown[]>();
      for (const row of await bookingData.computedRows(condition)) {
        const raw = row[split.kind === "reference" ? \`\${by}Id\` : by];
        const value = split.kind === "date" ? String(raw ?? "").slice(0, 7) || null : split.kind === "instant" ? (raw instanceof Date ? raw.toISOString().slice(0, 7) : null) : raw;
        groups.set(value, [...(groups.get(value) ?? []), row[field]]);
      }
      return named([...groups].map(([value, numbers]) => ({ value, number: amount(aggregate(numbers, how)) })).sort(most));
    }
    const key = split.kind === "date" ? sql<string>\`substr(\${split.column}, 1, 7)\` : split.kind === "instant" ? sql<string>\`strftime('%Y-%m', \${split.column} / 1000, 'unixepoch')\` : sql\`\${split.column}\`;
    const column = NUMBERS[field];
    if (how !== "count" && !column)
      throw new BadInput(\`\${how} needs a number field: \${[...Object.keys(NUMBERS), ...COMPUTED].join(", ") || "there are none"}.\`);
    const pick = how === "count" || !column ? count() : { sum, average: avg, smallest: min, largest: max }[how](column);
    return named(
      db
        .select({ value: key, number: pick })
        .from(schema.bookings)
        .where(condition)
        .groupBy(key)
        .all()
        .map((r) => ({ value: r.value, number: r.number === null ? null : amount(Number(r.number)) }))
        .sort(most),
    );
  },

  /**
   * The records that fit, with their computed fields worked out: for adding those up. At most
   * 10,000, so one call never reads a whole large table; more are refused with how to narrow them.
   */
  async computedRows(condition: SQL | undefined): Promise<Record<string, unknown>[]> {
    const rows = await db.query.bookings.findMany({ where: condition, with: { session: { columns: { id: true } } }, limit: 10001 });
    if (rows.length > 10000)
      throw new BadInput("More than 10,000 records to add up a computed field over: narrow them with where.");
    return rows.map((row) => row as Record<string, unknown>);
  },

  /** The condition for records the viewer may read that fit \`where\` and \`search\`. */
  fitting(viewer: Viewer | null, where?: unknown, search?: string) {
    return and(
      bookingData.readable(viewer),
      whereOf(FILTERABLE, where, viewer ? eq(schema.bookings.ownerId, viewer.id) : undefined, viewer?.id, {}),
      // Every word somewhere in the texts ("ship lamp" finds "ship's lamp").
      ...wordsOf(search).map(() => sql\`false\`),
    );
  },

  /** How many bookings the viewer may read, for a data page's overview; none to read: null. */
  count(viewer: Viewer | null): number | null {
    if (readScope(bookingAccess.read, viewer) === "none") return null;
    return db.select({ n: count() }).from(schema.bookings).where(bookingData.readable(viewer)).get()?.n ?? 0;
  },

  /** How many of a session's places are taken, and how many it has: numbers only, never whose. */
  places(sessionId: number): { taken: number; max: number } {
    const taken = db.select({ n: count() }).from(schema.bookings).where(and(eq(schema.bookings.sessionId, sessionId))).get()?.n ?? 0;
    return { taken, max: (db.select({ n: schema.sessions.capacity }).from(schema.sessions).where(eq(schema.sessions.id, sessionId)).get()?.n ?? 0) };
  },

  /** The viewer's own booking for a session, if they have one. */
  mine(viewer: Viewer, sessionId: number): number | undefined {
    return db.select({ id: schema.bookings.id }).from(schema.bookings).where(and(eq(schema.bookings.sessionId, sessionId), eq(schema.bookings.ownerId, viewer.id))).get()?.id;
  },

  async get(viewer: Viewer | null, id: number) {
    const fetched = await db.query.bookings.findFirst({
      where: and(eq(schema.bookings.id, id), bookingData.readable(viewer)),
      with: { session: { columns: { id: true } } },
    });
    const found = fetched && bookingData.shownRefs(viewer, [fetched])[0];
    const row = found && shownTo(viewer, found);
    return row ? row : null;
  },

  async create(viewer: Viewer | null, values: BookingValues) {
    check(bookingAccess.create, viewer);
    checkReferences(viewer, values);
    let row: typeof schema.bookings.$inferSelect;
    try {
      // The count and the insert in one transaction: two people cannot both take the last place.
      row = db.transaction((tx) => {
      const taken = tx.select({ n: count() }).from(schema.bookings).where(and(eq(schema.bookings.sessionId, values.sessionId))).get()?.n ?? 0;
      if (taken >= (tx.select({ n: schema.sessions.capacity }).from(schema.sessions).where(eq(schema.sessions.id, values.sessionId)).get()?.n ?? 0)) throw new Conflict("full");
        const made = tx.insert(schema.bookings).values({ ...values, ownerId: personOf(viewer) }).returning().get();
        audit(tx, viewer, { action: "created", model: "Booking", record: made.id });
        outgoing(tx, viewer, "Booking", "created", made);
        return made;
      });
    } catch (error) {
      throw error instanceof Conflict ? error : refusal(error);
    }
    await afterChange("afterCreate", "Booking", row, viewer);
    return row;
  },

  /** Changes the record; \`what\` names the change in the audit log (an action's name). */
  async update(viewer: Viewer | null, id: number, values: BookingValues, what = "changed") {
    const row = db
      .select({ ownerId: schema.bookings.ownerId })
      .from(schema.bookings)
      .where(and(eq(schema.bookings.id, id), bookingData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(bookingAccess.write, viewer, row.ownerId);
    checkReferences(viewer, values);
    let changed: typeof schema.bookings.$inferSelect;
    const updated = values;
    try {
      changed = db.transaction((tx) => {
      const taken = tx.select({ n: count() }).from(schema.bookings).where(and(eq(schema.bookings.sessionId, values.sessionId), ne(schema.bookings.id, id))).get()?.n ?? 0;
      if (taken >= (tx.select({ n: schema.sessions.capacity }).from(schema.sessions).where(eq(schema.sessions.id, values.sessionId)).get()?.n ?? 0)) throw new Conflict("full");
        const before = tx.select().from(schema.bookings).where(eq(schema.bookings.id, id)).get();
        const after = tx.update(schema.bookings).set(updated).where(eq(schema.bookings.id, id)).returning().get();
        audit(tx, viewer, { action: what, model: "Booking", record: id, fields: before && changedFields(before, after, Object.keys(updated)) });
        outgoing(tx, viewer, "Booking", what, after, before);
        return after;
      });
    } catch (error) {
      throw error instanceof Conflict ? error : refusal(error);
    }
    await afterChange("afterUpdate", "Booking", changed, viewer);
    return changed;
  },

  /** Deletes the record; \`together\` takes the records that point to it along to the trash (delete-together.md). */
  async remove(viewer: Viewer | null, id: number, _together = false): Promise<void> {
    const row = db
      .select({ ownerId: schema.bookings.ownerId })
      .from(schema.bookings)
      .where(and(eq(schema.bookings.id, id), bookingData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(bookingAccess.delete, viewer, row.ownerId);
    try {
      db.transaction((tx) => {
        const gone = tx.delete(schema.bookings).where(eq(schema.bookings.id, id)).returning().get();
        if (gone) {
          audit(tx, viewer, { action: "deleted", model: "Booking", record: id, title: gone.id });
          outgoing(tx, viewer, "Booking", "deleted", gone);
        }
      });
    } catch (error) {
      throw refusal(error);
    }
    await afterDelete("Booking", id, viewer);
  },

  /**
   * Deletes the chosen records the viewer may delete, all or none (one still in use stops them
   * all, and is named); the others are skipped.
   */
  async removeMany(viewer: Viewer | null, ids: number[], _together = false): Promise<{ deleted: number; skipped: number }> {
    const rows = db
      .select({ id: schema.bookings.id, ownerId: schema.bookings.ownerId })
      .from(schema.bookings)
      .where(and(inArray(schema.bookings.id, ids), bookingData.readable(viewer)))
      .all()
      .filter((row) => allows(bookingAccess.delete, viewer, row.ownerId));
    db.transaction((tx) => {
      for (const row of rows)
        try {
          const gone = tx.delete(schema.bookings).where(eq(schema.bookings.id, row.id)).returning().get();
          if (gone) {
            audit(tx, viewer, { action: "deleted", model: "Booking", record: row.id, title: gone.id });
            outgoing(tx, viewer, "Booking", "deleted", gone);
          }
        } catch (error) {
          const refused = refusal(error);
          throw refused instanceof Conflict && refused.message === "in-use" ? new Conflict(\`in-use:\${row.id}\`) : refused;
        }
    });
    for (const row of rows) {
      await afterDelete("Booking", row.id, viewer);
    }
    return { deleted: rows.length, skipped: new Set(ids).size - rows.length };
  },
};
"
`;

exports[`../../../examples/booking/smithable.yml > file list and generated code > src/generated/booking.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { z } from "zod";
import type * as schema from "#/db/schema";
import { allows, type Rule } from "#/kit/access";
import type { RecordUi } from "#/kit/model";
import { bookingAccess, bookingData } from "./booking.server";
import { sessionData } from "./session.server";
import { writeAllowed } from "#/kit/limit";
import { currentViewer } from "#/lib/viewer.server";
import { bookingSchema, type BookingValues } from "./booking.schema";

export type { BookingValues } from "./booking.schema";

/** The viewer about to write, counted against how often one may (see src/kit/limit.ts). */
async function writer() {
  const viewer = await currentViewer();
  writeAllowed(viewer, getRequestHeaders());
  return viewer;
}

/** Booking records as the kit reads them. */
export type BookingRow = typeof schema.bookings.$inferSelect & {
  session?: { id: number } | null;
};

export const bookingUi: RecordUi<BookingRow> = {
  model: "Booking",
  label: "Booking",
  pluralLabel: "Bookings",
  titleField: "id",
  columns: ["sessionId"],
  fields: [
    {
      name: "sessionId",
      label: "Session",
      kind: "relation",
      required: true,
      relation: { key: "session", titleField: "id" },
      get: (row) => (row.session ? \`#\${row.session.id}\` : null),
    },
  ],
};

/** Who may delete bookings: a list's selection offers Delete by it (the server checks again). */
export const bookingDeleteRule: Rule = { public: false, roles: ["admin"], owner: true };


export const listBookings = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return { rows: await bookingData.list(viewer), canCreate: allows(bookingAccess.create, viewer) };
});

export const getBooking = createServerFn()
  .validator(z.number().int())
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    const row = await bookingData.get(viewer, id);
    if (!row) return null;
    return {
      row,
      canWrite: allows(bookingAccess.write, viewer, row.ownerId),
      canDelete: allows(bookingAccess.delete, viewer, row.ownerId),
    };
  });

export const createBooking = createServerFn({ method: "POST" })
  .validator(bookingSchema)
  .handler(async ({ data }) => bookingData.create(await writer(), data));

export const updateBooking = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), values: bookingSchema }))
  .handler(async ({ data }) => bookingData.update(await writer(), data.id, data.values));

/** Deletes a booking; \`together\` takes what points to it along (docs/design/delete-together.md). */
export const deleteBooking = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), together: z.boolean().optional() }))
  .handler(async ({ data }) => bookingData.remove(await writer(), data.id, data.together));

/** Deletes the chosen bookings, all or none (at most 1,000 at once). */
export const deleteBookings = createServerFn({ method: "POST" })
  .validator(z.object({ ids: z.array(z.number().int()).max(1000), together: z.boolean().optional() }))
  .handler(async ({ data }) => bookingData.removeMany(await writer(), data.ids, data.together));

/** A session's places for the reservation block: how many are left, and the viewer's own. */
export const bookingPlaces = createServerFn()
  .validator(z.number().int())
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    if (!sessionData.canRead(viewer, id)) return null;
    const { taken, max } = bookingData.places(id);
    return {
      left: Math.max(0, max - taken),
      max,
      mine: viewer ? bookingData.mine(viewer, id) : undefined,
      canBook: allows(bookingAccess.create, viewer),
      signedIn: viewer !== null,
    };
  });

/** Takes a place in one step: the other fields have their defaults. */
export const reserveBooking = createServerFn({ method: "POST" })
  .validator(z.number().int())
  .handler(async ({ data: id }) =>
    bookingData.create(await writer(), { sessionId: id } as BookingValues),
  );
"
`;

