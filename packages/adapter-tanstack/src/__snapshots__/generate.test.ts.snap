"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { type AnyColumn, and, asc, avg, count, desc, eq, inArray, isNotNull, max, min, sql, sum, type SQL } from "drizzle-orm";
import { db } from "#/db";
import * as schema from "#/db/schema";
import { AccessDenied, allows, check, Conflict, type ModelAccess, personOf, readScope, type Viewer } from "#/kit/access";
import { audit, changedFields } from "#/kit/audit.server";
import { refusal } from "#/kit/log.server";
import { contains } from "#/kit/search";
import { BadInput } from "#/kit/refusal";
import { aggregate, type Filterable, sortOf, whereOf, wordsOf } from "#/kit/where";
import { afterChange, afterDelete } from "./hooks";
import { incidentUpdateData } from "./incident-update.server";
import { componentData } from "./component.server";
import type { IncidentValues } from "./incident";

/** A transaction, as the group's functions are called inside one (docs/design/delete-together.md). */
type Tx = Parameters<Parameters<typeof db.transaction>[0]>[0];

/**
 * What points to a incident (docs/design/delete-together.md): the records that would go with it
 * to the trash, by model, and those that would show no incident; nothing when nothing does.
 */
function usedBy(tx: Tx, id: number, title: string) {
  const pointing: { model: string; from: string; label: string; plural: string; depth: number; count: number | null }[] = [
    { model: "IncidentUpdate", label: "Incident update", plural: "Incident updates", from: "Incident", depth: 1, count: tx.select({ n: count() }).from(schema.incidentUpdates).where(and(eq(schema.incidentUpdates.incidentId, id))).get()?.n ?? 0 },
  ];
  // A deeper member is named when its parent has records ("and what belongs to them").
  const with_: typeof pointing = [];
  for (const e of pointing)
    if (e.count === null ? with_.some((p) => p.model === e.from) : e.count > 0) with_.push(e);
  if (!with_.length) return undefined;
  const loose = [] as { model: string; label: string; plural: string; count: number }[];
  return { id, title, model: "Incident", label: "Incident", with: with_, loose, together: false, missing: ["Incident","Incident update"] };
}

/** Who may read, create, change and delete incidents. */
export const incidentAccess: ModelAccess = {
  read: {
    public: true,
    roles: ["admin", "staff"],
    owner: false,
    where: { status: ["investigating", "identified", "monitoring", "resolved"] },
  },
  create: { public: false, roles: ["admin", "staff"], owner: false },
  write: { public: false, roles: ["admin", "staff"], owner: true },
  delete: { public: false, roles: ["admin"], owner: true },
};

/** A record as the viewer gets it: who owns it only for its owner and roles that read every record. */
function shownTo<R extends { ownerId: string | null }>(viewer: Viewer | null, row: R): R {
  if (viewer && (row.ownerId === viewer.id || incidentAccess.read.roles.includes(viewer.role))) return row;
  return { ...row, ownerId: null };
}


/** What \`where\` may name, and how: the stored fields, by kind. */
const FILTERABLE: Record<string, Filterable> = {
  title: { kind: "text", column: schema.incidents.title },
  status: { kind: "choice", column: schema.incidents.status, values: ["investigating","identified","monitoring","resolved"] },
  component: { kind: "reference", column: schema.incidents.componentId, title: { table: schema.components, column: schema.components.name } },
  detectedAt: { kind: "instant", column: schema.incidents.detectedAt },
  resolvedAt: { kind: "instant", column: schema.incidents.resolvedAt },
  summary: { kind: "text", column: schema.incidents.summary },
};

/** What the records can be sorted by. */
const SORTABLE = { id: schema.incidents.id, title: schema.incidents.title, status: schema.incidents.status, detectedAt: schema.incidents.detectedAt, resolvedAt: schema.incidents.resolvedAt, summary: schema.incidents.summary, createdAt: schema.incidents.createdAt };

/** The number fields \`measure\` adds up; amounts are stored in cents. */
const NUMBERS: Record<string, AnyColumn> = {  };
const MONEY: string[] = [];

/** Computed number fields \`measure\` adds up from the records themselves. */
const COMPUTED: string[] = [];

/** The titles of the referenced records \`measureBy\` splits by, to name its groups. */
function titlesOf(viewer: Viewer | null, by: string, ids: number[]): Map<unknown, string> {
  switch (by) {
    case "component":
      return new Map(db.select({ id: schema.components.id, title: schema.components.name }).from(schema.components).where(and(inArray(schema.components.id, ids), componentData.readable(viewer))).all().map((r) => [r.id, String(r.title)]));
    default:
      return new Map();
  }
}

/** What \`measureBy\` may split by: choices, yes/no, references, and dates by month. */
const BY: string[] = ["status","component","detectedAt","resolvedAt"];


/** Checks that the viewer may read the records the values refer to. */
function checkReferences(viewer: Viewer | null, values: IncidentValues): void {
  if (values.componentId != null && !componentData.canRead(viewer, values.componentId))
    throw new AccessDenied(viewer !== null);
}

/** \`rows\` with each \`field\` reference \`readable\` leaves out set to nothing (only its id stays). */
function hideRefs<R extends Record<string, unknown>>(rows: R[], field: string, readable: (ids: number[]) => number[]): R[] {
  const idOf = (row: R) => (row[field] as { id?: unknown } | null | undefined)?.id;
  const ids = [...new Set(rows.map(idOf).filter((id): id is number => typeof id === "number"))];
  if (!ids.length) return rows;
  const shown = new Set(readable(ids));
  return rows.map((row) => {
    const id = idOf(row);
    return typeof id === "number" && !shown.has(id) ? { ...row, [field]: null } : row;
  });
}

export const incidentData = {
  shownTo,
  /** The rows with each reference to a record the viewer may not read set to nothing: a related record's title is shown only to who may read it (only its id stays). */
  shownRefs<R extends Record<string, unknown>>(viewer: Viewer | null, rows: R[]): R[] {
    return hideRefs(rows, "component", (ids, c = componentData.readable(viewer)) => (c ? db.select({ id: schema.components.id }).from(schema.components).where(and(inArray(schema.components.id, ids), c)).all().map((r) => r.id) : ids));
  },

  /** A condition for the incidents the viewer may read. */
  readable(viewer: Viewer | null) {
    const scope = readScope(incidentAccess.read, viewer);
    if (scope === "all") return undefined;
    if (scope === "public") return and(inArray(schema.incidents.status, ["investigating","identified","monitoring","resolved"]));
    return scope === "own" && viewer ? eq(schema.incidents.ownerId, viewer.id) : sql\`false\`;
  },

  canRead(viewer: Viewer | null, id: number): boolean {
    const found = db
      .select({ id: schema.incidents.id })
      .from(schema.incidents)
      .where(and(eq(schema.incidents.id, id), incidentData.readable(viewer)))
      .get();
    return found !== undefined;
  },

  /** The incidents the viewer may read; \`where\` narrows them, e.g. to a search. */
  async list(viewer: Viewer | null, where?: SQL) {
    if (readScope(incidentAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const found = incidentData.shownRefs(viewer, await db.query.incidents.findMany({
      where: and(incidentData.readable(viewer), where),
      with: { component: { columns: { id: true, name: true } } },
      orderBy: (t, { desc }) => [desc(t.id)],
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return rows;
  },

  /**
   * A page of the incidents the viewer may read that fit \`where\`, newest first (or in
   * \`order\`), and how many fit in all: for a list page. A page past the end is the last one.
   */
  async page(viewer: Viewer | null, where?: SQL, order?: SQL, page = 1, size = 50) {
    if (readScope(incidentAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = and(incidentData.readable(viewer), where);
    const total = db.select({ n: count() }).from(schema.incidents).where(condition).get()?.n ?? 0;
    const at = Math.min(Math.max(1, Math.trunc(page)), Math.max(1, Math.ceil(total / size)));
    const found = incidentData.shownRefs(viewer, await db.query.incidents.findMany({
      where: condition,
      with: { component: { columns: { id: true, name: true } } },
      orderBy: (t, { desc }) => [...(order ? [order] : []), desc(t.id)],
      limit: size,
      offset: (at - 1) * size,
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return { rows: rows, total, page: at, size };
  },

  /**
   * The incidents the viewer may read that fit \`where\` and \`search\`, in \`sort\`'s order (else newest
   * first), a page of them and how many there are: for the API and the assistants' tools.
   */
  async find(
    viewer: Viewer | null,
    options: { where?: unknown; search?: string; sort?: string; limit?: number; offset?: number } = {},
  ) {
    if (readScope(incidentAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = incidentData.fitting(viewer, options.where, options.search);
    const order = sortOf(SORTABLE, options.sort);
    const total = db.select({ n: count() }).from(schema.incidents).where(condition).get()?.n ?? 0;
    const found = incidentData.shownRefs(viewer, await db.query.incidents.findMany({
      where: condition,
      with: { component: { columns: { id: true, name: true } } },
      orderBy: (t, { desc }) => [...(order ? [order] : []), desc(t.id)],
      limit: options.limit ?? 100,
      offset: options.offset ?? 0,
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return { items: rows, total };
  },

  /**
   * A number from the incidents the viewer may read that fit \`where\`: how many, or the sum,
   * average, smallest or largest of a number field.
   */
  async measure(
    viewer: Viewer | null,
    how: "count" | "sum" | "average" | "smallest" | "largest",
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<number | null> {
    if (readScope(incidentAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = incidentData.fitting(viewer, options.where, options.search);
    if (how === "count")
      return db.select({ n: count() }).from(schema.incidents).where(condition).get()?.n ?? 0;
    const field = options.field ?? "";
    const money = MONEY.includes(field);
    if (COMPUTED.includes(field)) {
      const rows = await incidentData.computedRows(condition);
      const value = aggregate(rows.map((row) => row[field]), how);
      return value === null ? null : money ? value / 100 : value;
    }
    const column = NUMBERS[field];
    if (!column)
      throw new BadInput(
        \`\${how} needs a number field: \${[...Object.keys(NUMBERS), ...COMPUTED].join(", ") || "there are none"}.\`,
      );
    const pick = { sum, average: avg, smallest: min, largest: max }[how];
    const value = db.select({ v: pick(column) }).from(schema.incidents).where(condition).get()?.v;
    if (value === null || value === undefined) return null;
    return money ? Number(value) / 100 : Number(value);
  },

  /** Which record holds the smallest or largest value of a number field (the first of a tie). */
  async holder(
    viewer: Viewer | null,
    how: "smallest" | "largest",
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<{ id: number; title: string } | null> {
    const condition = incidentData.fitting(viewer, options.where, options.search);
    const field = options.field ?? "";
    if (COMPUTED.includes(field)) {
      let best: Record<string, unknown> | undefined;
      for (const row of await incidentData.computedRows(condition)) {
        const v = row[field];
        if (typeof v !== "number") continue;
        if (!best || (how === "largest" ? v > (best[field] as number) : v < (best[field] as number))) best = row;
      }
      return best ? { id: best.id as number, title: String(best.title) } : null;
    }
    const column = NUMBERS[field];
    if (!column) return null;
    const row = db
      .select({ id: schema.incidents.id, title: schema.incidents.title })
      .from(schema.incidents)
      .where(and(condition, isNotNull(column)))
      .orderBy(how === "largest" ? desc(column) : asc(column), asc(schema.incidents.id))
      .limit(1)
      .get();
    return row ? { id: row.id, title: String(row.title) } : null;
  },

  /**
   * The same number per value of a field (a choice, yes/no, a reference) or per month of a date:
   * \`[{ value, number }]\`, the most first.
   */
  async measureBy(
    viewer: Viewer | null,
    how: "count" | "sum" | "average" | "smallest" | "largest",
    by: string,
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<{ value: unknown; title?: string; number: number | null }[]> {
    if (readScope(incidentAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const split = FILTERABLE[by];
    if (!split || split.kind === "text" || split.kind === "number" || split.kind === "money")
      throw new BadInput(\`There is no field "\${by}" to split by. Fields: \${BY.join(", ")}.\`);
    const field = options.field ?? "";
    const money = MONEY.includes(field);
    const condition = incidentData.fitting(viewer, options.where, options.search);
    const amount = (n: number | null) => (n === null ? null : money ? n / 100 : n);
    const most = (a: { number: number | null }, b: { number: number | null }) => (b.number ?? 0) - (a.number ?? 0);
    // A reference's groups carry the referenced record's title beside its id.
    const named = (rows: { value: unknown; number: number | null }[]) => {
      if (split.kind !== "reference") return rows;
      const titles = titlesOf(viewer, by, rows.map((r) => r.value).filter((v): v is number => typeof v === "number"));
      return rows.map((r) => (titles.has(r.value) ? { value: r.value, title: titles.get(r.value), number: r.number } : r));
    };
    if (COMPUTED.includes(field)) {
      // Each record's month or value, then the computed numbers added up per group.
      const groups = new Map<unknown, unknown[]>();
      for (const row of await incidentData.computedRows(condition)) {
        const raw = row[split.kind === "reference" ? \`\${by}Id\` : by];
        const value = split.kind === "date" ? String(raw ?? "").slice(0, 7) || null : split.kind === "instant" ? (raw instanceof Date ? raw.toISOString().slice(0, 7) : null) : raw;
        groups.set(value, [...(groups.get(value) ?? []), row[field]]);
      }
      return named([...groups].map(([value, numbers]) => ({ value, number: amount(aggregate(numbers, how)) })).sort(most));
    }
    const key = split.kind === "date" ? sql<string>\`substr(\${split.column}, 1, 7)\` : split.kind === "instant" ? sql<string>\`strftime('%Y-%m', \${split.column} / 1000, 'unixepoch')\` : sql\`\${split.column}\`;
    const column = NUMBERS[field];
    if (how !== "count" && !column)
      throw new BadInput(\`\${how} needs a number field: \${[...Object.keys(NUMBERS), ...COMPUTED].join(", ") || "there are none"}.\`);
    const pick = how === "count" || !column ? count() : { sum, average: avg, smallest: min, largest: max }[how](column);
    return named(
      db
        .select({ value: key, number: pick })
        .from(schema.incidents)
        .where(condition)
        .groupBy(key)
        .all()
        .map((r) => ({ value: r.value, number: r.number === null ? null : amount(Number(r.number)) }))
        .sort(most),
    );
  },

  /**
   * The records that fit, with their computed fields worked out: for adding those up. At most
   * 10,000, so one call never reads a whole large table; more are refused with how to narrow them.
   */
  async computedRows(condition: SQL | undefined): Promise<Record<string, unknown>[]> {
    const rows = await db.query.incidents.findMany({ where: condition, with: { component: { columns: { id: true, name: true } } }, limit: 10001 });
    if (rows.length > 10000)
      throw new BadInput("More than 10,000 records to add up a computed field over: narrow them with where.");
    return rows.map((row) => row as Record<string, unknown>);
  },

  /** The incidents the viewer may read whose title has the text: a few, for naming one. */
  named(viewer: Viewer | null, text: string): { id: number; title: string }[] {
    return db
      .select({ id: schema.incidents.id, title: schema.incidents.title })
      .from(schema.incidents)
      .where(and(incidentData.readable(viewer), contains([schema.incidents.title], text)))
      .limit(6)
      .all()
      .map((row) => ({ id: row.id, title: String(row.title) }));
  },

  /** The condition for records the viewer may read that fit \`where\` and \`search\`. */
  fitting(viewer: Viewer | null, where?: unknown, search?: string) {
    return and(
      incidentData.readable(viewer),
      whereOf(FILTERABLE, where, viewer ? eq(schema.incidents.ownerId, viewer.id) : undefined, viewer?.id, {component: (text: string) => componentData.named(viewer, text)}),
      // Every word somewhere in the texts ("ship lamp" finds "ship's lamp").
      ...wordsOf(search).map((word) => contains([schema.incidents.title, schema.incidents.summary], word)),
    );
  },

  async get(viewer: Viewer | null, id: number) {
    const fetched = await db.query.incidents.findFirst({
      where: and(eq(schema.incidents.id, id), incidentData.readable(viewer)),
      with: { component: { columns: { id: true, name: true } }, updates: { where: incidentUpdateData.readable(viewer) } },
    });
    const found = fetched && incidentData.shownRefs(viewer, [fetched])[0];
    const row = found && { ...shownTo(viewer, found), updates: found.updates.map((r) => incidentUpdateData.shownTo(viewer, r)) };
    return row ? row : null;
  },

  async create(viewer: Viewer | null, values: IncidentValues) {
    check(incidentAccess.create, viewer);
    checkReferences(viewer, values);
    let row: typeof schema.incidents.$inferSelect;
    try {
      row = db.transaction((tx) => {
        const made = tx.insert(schema.incidents).values({ ...values, ownerId: personOf(viewer) }).returning().get();
        audit(tx, viewer, { action: "created", model: "Incident", record: made.id });
        return made;
      });
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterCreate", "Incident", row, viewer);
    return row;
  },

  /** Changes the record; \`what\` names the change in the audit log (an action's name). */
  async update(viewer: Viewer | null, id: number, values: IncidentValues, what = "changed") {
    const row = db
      .select({ ownerId: schema.incidents.ownerId })
      .from(schema.incidents)
      .where(and(eq(schema.incidents.id, id), incidentData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(incidentAccess.write, viewer, row.ownerId);
    checkReferences(viewer, values);
    let changed: typeof schema.incidents.$inferSelect;
    const updated = values;
    try {
      changed = db.transaction((tx) => {
        const before = tx.select().from(schema.incidents).where(eq(schema.incidents.id, id)).get();
        const after = tx.update(schema.incidents).set(updated).where(eq(schema.incidents.id, id)).returning().get();
        audit(tx, viewer, { action: what, model: "Incident", record: id, fields: before && changedFields(before, after, Object.keys(updated)) });
        return after;
      });
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterUpdate", "Incident", changed, viewer);
    return changed;
  },

  /** Deletes the record; \`together\` takes the records that point to it along to the trash (delete-together.md). */
  async remove(viewer: Viewer | null, id: number, _together = false): Promise<void> {
    const row = db
      .select({ title: schema.incidents.title, ownerId: schema.incidents.ownerId })
      .from(schema.incidents)
      .where(and(eq(schema.incidents.id, id), incidentData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(incidentAccess.delete, viewer, row.ownerId);
    try {
      db.transaction((tx) => {
        const used = usedBy(tx, id, String(row.title ?? id));
        if (used) throw new Conflict(\`in-use:\${JSON.stringify(used)}\`);
        const gone = tx.delete(schema.incidents).where(eq(schema.incidents.id, id)).returning().get();
        if (gone) {
          audit(tx, viewer, { action: "deleted", model: "Incident", record: id, title: gone.title });
        }
      });
    } catch (error) {
      throw refusal(error);
    }
    await afterDelete("Incident", id, viewer);
  },

  /**
   * Deletes the chosen records the viewer may delete, all or none (one still in use stops them
   * all, and is named); the others are skipped.
   */
  async removeMany(viewer: Viewer | null, ids: number[], _together = false): Promise<{ deleted: number; skipped: number }> {
    const rows = db
      .select({ id: schema.incidents.id, title: schema.incidents.title, ownerId: schema.incidents.ownerId })
      .from(schema.incidents)
      .where(and(inArray(schema.incidents.id, ids), incidentData.readable(viewer)))
      .all()
      .filter((row) => allows(incidentAccess.delete, viewer, row.ownerId));
    db.transaction((tx) => {
      for (const row of rows)
        try {
          const used = usedBy(tx, row.id, String(row.title ?? row.id));
          if (used) throw new Conflict(\`in-use:\${JSON.stringify(used)}\`);
          const gone = tx.delete(schema.incidents).where(eq(schema.incidents.id, row.id)).returning().get();
          if (gone) {
            audit(tx, viewer, { action: "deleted", model: "Incident", record: row.id, title: gone.title });
          }
        } catch (error) {
          const refused = refusal(error);
          throw refused instanceof Conflict && refused.message === "in-use" ? new Conflict(\`in-use:\${row.id}\`) : refused;
        }
    });
    for (const row of rows) {
      await afterDelete("Incident", row.id, viewer);
    }
    return { deleted: rows.length, skipped: new Set(ids).size - rows.length };
  },

  /**
   * The incidents the viewer may read whose title contains the text: a search of records that
   * refer to them finds them only among these.
   */
  titled(viewer: Viewer | null, text: string): number[] {
    return db
      .select({ id: schema.incidents.id })
      .from(schema.incidents)
      .where(and(contains([schema.incidents.title], text), incidentData.readable(viewer)))
      .all()
      .map((row) => row.id);
  },

  /** Choices for fields that refer to a incident: the ones the viewer may read. */
  options(viewer: Viewer | null) {
    if (readScope(incidentAccess.read, viewer) === "none") return [];
    return db
      .select({ value: schema.incidents.id, label: schema.incidents.title })
      .from(schema.incidents)
      .where(incidentData.readable(viewer))
      .orderBy(asc(schema.incidents.title))
      .all();
  },
};
"
`;

exports[`../../../examples/status/smithable.yml > file list and generated code > src/generated/incident.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { z } from "zod";
import type * as schema from "#/db/schema";
import { allows, type Rule } from "#/kit/access";
import type { RecordUi } from "#/kit/model";
import { MarkdownEditor, MarkdownText } from "#/kit/Markdown";
import { incidentAccess, incidentData } from "./incident.server";
import { incidentUpdateAccess } from "./incident-update.server";
import { writeAllowed } from "#/kit/limit";
import { currentViewer } from "#/lib/viewer.server";
import { incidentSchema } from "./incident.schema";

export type { IncidentValues } from "./incident.schema";

/** The viewer about to write, counted against how often one may (see src/kit/limit.ts). */
async function writer() {
  const viewer = await currentViewer();
  writeAllowed(viewer, getRequestHeaders());
  return viewer;
}

/** Incident records as the kit reads them. */
export type IncidentRow = typeof schema.incidents.$inferSelect & {
  component?: { id: number; name: string } | null;
};

export const incidentUi: RecordUi<IncidentRow> = {
  model: "Incident",
  label: "Incident",
  pluralLabel: "Incidents",
  titleField: "title",
  descriptionField: "summary",
  columns: ["title", "status", "detectedAt", "componentId", "resolvedAt"],
  fields: [
    {
      name: "title",
      label: "Title",
      kind: "string",
      required: true,
      get: (row) => row.title,
    },
    {
      name: "status",
      label: "Status",
      kind: "choice",
      required: true,
      choices: [
        { value: "investigating", label: "Investigating" },
        { value: "identified", label: "Identified" },
        { value: "monitoring", label: "Monitoring" },
        { value: "resolved", label: "Resolved" },
      ],
      default: "investigating",
      get: (row) => row.status,
    },
    {
      name: "componentId",
      label: "Component",
      kind: "relation",
      required: false,
      relation: { key: "component", titleField: "name" },
      get: (row) => row.component?.name ?? null,
    },
    {
      name: "detectedAt",
      label: "Detected at",
      kind: "datetime",
      required: true,
      get: (row) => row.detectedAt,
    },
    {
      name: "resolvedAt",
      label: "Resolved at",
      kind: "datetime",
      required: false,
      get: (row) => row.resolvedAt,
    },
    {
      name: "summary",
      label: "Summary",
      kind: "markdown",
      required: false,
      input: MarkdownEditor,
      view: MarkdownText,
      get: (row) => row.summary,
    },
  ],
};

/** Who may delete incidents: a list's selection offers Delete by it (the server checks again). */
export const incidentDeleteRule: Rule = { public: false, roles: ["admin"], owner: true };


export const listIncidents = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return { rows: await incidentData.list(viewer), canCreate: allows(incidentAccess.create, viewer) };
});

export const getIncident = createServerFn()
  .validator(z.number().int())
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    const row = await incidentData.get(viewer, id);
    if (!row) return null;
    return {
      row,
      canWrite: allows(incidentAccess.write, viewer, row.ownerId),
      canDelete: allows(incidentAccess.delete, viewer, row.ownerId),
      // Who may add to its related lists from here ("Add line" on an invoice).
      canAdd: { updates: allows(incidentUpdateAccess.create, viewer) },
    };
  });

/** Choices for fields that refer to a incident. */
export const incidentOptions = createServerFn().handler(async () =>
  incidentData.options(await currentViewer()),
);

export const createIncident = createServerFn({ method: "POST" })
  .validator(incidentSchema)
  .handler(async ({ data }) => incidentData.create(await writer(), data));

export const updateIncident = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), values: incidentSchema }))
  .handler(async ({ data }) => incidentData.update(await writer(), data.id, data.values));

/** Deletes a incident; \`together\` takes what points to it along (docs/design/delete-together.md). */
export const deleteIncident = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), together: z.boolean().optional() }))
  .handler(async ({ data }) => incidentData.remove(await writer(), data.id, data.together));

/** Deletes the chosen incidents, all or none (at most 1,000 at once). */
export const deleteIncidents = createServerFn({ method: "POST" })
  .validator(z.object({ ids: z.array(z.number().int()).max(1000), together: z.boolean().optional() }))
  .handler(async ({ data }) => incidentData.removeMany(await writer(), data.ids, data.together));
"
`;

