"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// Who has access: the users and the open invitations, and what an administrator does with them.
// Server-only. The users page's server functions pass the viewer; nothing here trusts the client.
import { randomBytes, randomUUID } from "node:crypto";
import { getRequestUrl } from "@tanstack/react-start/server";
import { asc, eq } from "drizzle-orm";
import { db } from "#/db";
import { invitation, user } from "#/db/schema";
import * as schema from "#/db/schema";
import { app } from "#/generated/app";
import { pageAccess } from "#/generated/pages";
import { ROLE_LABELS } from "#/generated/roles";
import { AccessDenied, check, personOf, type Viewer } from "#/kit/access";
import { audit } from "#/kit/audit.server";
import { sendMail } from "#/kit/mail";
import { w } from "#/kit/words";

export const ROLES = ["admin", "staff"] as const;
export type Role = (typeof ROLES)[number];
/** How long an invitation can be accepted. */
export const INVITATION_DAYS = 14;

/** Who may manage users: the team page's rule (administrators always). */
const RULE = pageAccess["team"];

export interface UserRow {
  id: string;
  name: string;
  email: string;
  role: string;
}

export interface InvitationRow {
  id: string;
  email: string;
  role: string;
  expiresAt: Date;
  link: string;
}

/** Where invitation links point: the app's public address, or the address this request used. */
export const origin = () => process.env.BETTER_AUTH_URL ?? getRequestUrl().origin;

/** Who may manage users: a person with the page's role; an API key never, whatever its role. */
function manager(viewer: Viewer | null): Viewer {
  check(RULE, viewer);
  if (!personOf(viewer)) throw new AccessDenied(true);
  return viewer as Viewer;
}

const link = (origin: string, token: string) => \`\${origin}/sign-in?invite=\${token}\`;

const row = (i: typeof invitation.$inferSelect, origin: string): InvitationRow => ({
  id: i.id,
  email: i.email,
  role: i.role,
  expiresAt: i.expiresAt,
  link: link(origin, i.token),
});

/** Everyone with access, and the invitations not yet accepted. */
export async function listUsers(
  viewer: Viewer | null,
  origin: string,
): Promise<{ users: UserRow[]; invitations: InvitationRow[] }> {
  manager(viewer);
  return {
    users: db
      .select({ id: user.id, name: user.name, email: user.email, role: user.role })
      .from(user)
      .orderBy(asc(user.name))
      .all(),
    invitations: db
      .select()
      .from(invitation)
      .orderBy(asc(invitation.email))
      .all()
      .map((i) => row(i, origin)),
  };
}

/** Invites an address with a role, replacing an open invitation to it, and sends the mail. */
export async function invite(
  viewer: Viewer | null,
  email: string,
  role: Role,
  origin: string,
): Promise<InvitationRow> {
  const by = manager(viewer);
  const address = email.trim().toLowerCase();
  if (db.select({ id: user.id }).from(user).where(eq(user.email, address)).get())
    throw new Error(\`\${address} already has access.\`);
  const created = db.transaction((tx) => {
    tx.delete(invitation).where(eq(invitation.email, address)).run();
    audit(tx, by, { action: "invited", model: "User", details: { email: address, role } });
    return tx
      .insert(invitation)
      .values({
        id: randomUUID(),
        email: address,
        role,
        token: randomBytes(24).toString("base64url"),
        invitedById: by.id,
        expiresAt: new Date(Date.now() + INVITATION_DAYS * 86_400_000),
      })
      .returning()
      .get();
  });
  const result = row(created, origin);
  await sendInvitation(by, result);
  return result;
}

/** Sends an open invitation again, and gives it the full time to be accepted once more. */
export async function resendInvitation(
  viewer: Viewer | null,
  invitationId: string,
  origin: string,
): Promise<void> {
  const by = manager(viewer);
  const renewed = db.transaction((tx) => {
    const sent = tx
      .update(invitation)
      .set({ expiresAt: new Date(Date.now() + INVITATION_DAYS * 86_400_000) })
      .where(eq(invitation.id, invitationId))
      .returning()
      .get();
    if (sent)
      audit(tx, by, { action: "invitation sent again", model: "User", details: { email: sent.email, role: sent.role } });
    return sent;
  });
  if (!renewed) throw new Error("This invitation no longer exists.");
  await sendInvitation(by, row(renewed, origin));
}

export async function withdrawInvitation(viewer: Viewer | null, invitationId: string): Promise<void> {
  const by = manager(viewer);
  db.transaction((tx) => {
    const gone = tx.delete(invitation).where(eq(invitation.id, invitationId)).returning().get();
    if (gone)
      audit(tx, by, { action: "invitation withdrawn", model: "User", details: { email: gone.email, role: gone.role } });
  });
}

/** Gives a user another role; never your own, and the last administrator stays one. */
export async function setRole(viewer: Viewer | null, userId: string, role: Role): Promise<void> {
  const by = manager(viewer);
  if (userId === by.id) throw new Error("You cannot change your own role.");
  const target = db.select({ role: user.role, name: user.name }).from(user).where(eq(user.id, userId)).get();
  if (!target) throw new Error("This user no longer exists.");
  if (target.role === "admin" && role !== "admin" && admins() === 1)
    throw new Error("The last administrator stays an administrator.");
  db.transaction((tx) => {
    tx.update(user).set({ role }).where(eq(user.id, userId)).run();
    // What touches security keeps its values: who, what they were and what they became.
    audit(tx, by, { action: "role changed", model: "User", details: { user: userId, from: target.role, to: role } });
  });
}

/** What names a person: how many records of each kind, live or in the trash, by the column. */
export interface UserUse {
  model: string;
  /** The reference's label ("assignee"); null for the records that are the person's own. */
  field: string | null;
  noun: [string, string];
  /** A required reference: removing the person needs someone to give these to. */
  required: boolean;
  count: number;
}

/** The records that name a person, for the remove dialog. */
export function usesOf(viewer: Viewer | null, userId: string): UserUse[] {
  manager(viewer);
  const uses: UserUse[] = [
    { model: "Dish", field: null, noun: ["dish", "dishes"], required: false, count: db.select({ id: schema.dishes.id }).from(schema.dishes).where(eq(schema.dishes.ownerId, userId)).all().length },
    { model: "Order", field: null, noun: ["order", "orders"], required: false, count: db.select({ id: schema.orders.id }).from(schema.orders).where(eq(schema.orders.ownerId, userId)).all().length },
    { model: "OrderLine", field: null, noun: ["order line", "order lines"], required: false, count: db.select({ id: schema.orderLines.id }).from(schema.orderLines).where(eq(schema.orderLines.ownerId, userId)).all().length },
    { model: "Stop", field: null, noun: ["stop", "stops"], required: false, count: db.select({ id: schema.stops.id }).from(schema.stops).where(eq(schema.stops.ownerId, userId)).all().length },
  ];
  return uses.filter((use) => use.count > 0);
}

/**
 * Removes a user: they can no longer sign in and their sessions end. What names them (a
 * reference, the records that are theirs, in the trash too) goes to the heir, another member,
 * in the same transaction; without one, what may be empty is cleared and a required reference
 * (a record they are the account manager of, say) refuses the removal. Never yourself or the
 * last administrator.
 */
export async function removeUser(viewer: Viewer | null, userId: string, heirId?: string): Promise<void> {
  const by = manager(viewer);
  if (userId === by.id) throw new Error("You cannot remove yourself.");
  const heir = heirId ? db.select({ id: user.id }).from(user).where(eq(user.id, heirId)).get() : undefined;
  if (heirId && (!heir || heirId === userId)) throw new Error("Choose someone on the team to give them to.");
  const target = db
    .select({ role: user.role, name: user.name, email: user.email })
    .from(user)
    .where(eq(user.id, userId))
    .get();
  if (!target) return;
  if (target.role === "admin" && admins() === 1)
    throw new Error("The last administrator cannot be removed.");
  try {
    db.transaction((tx) => {

      {
        const moved = tx.update(schema.dishes).set({ ownerId: heir?.id ?? null }).where(eq(schema.dishes.ownerId, userId)).returning({ id: schema.dishes.id }).all();
        if (moved.length) audit(tx, by, { action: heir ? "records reassigned" : "records cleared", model: "Dish", details: { column: "ownerId", user: userId, to: heir?.id ?? null, records: moved.map((r) => r.id) } });
      }
      {
        const moved = tx.update(schema.orders).set({ ownerId: heir?.id ?? null }).where(eq(schema.orders.ownerId, userId)).returning({ id: schema.orders.id }).all();
        if (moved.length) audit(tx, by, { action: heir ? "records reassigned" : "records cleared", model: "Order", details: { column: "ownerId", user: userId, to: heir?.id ?? null, records: moved.map((r) => r.id) } });
      }
      {
        const moved = tx.update(schema.orderLines).set({ ownerId: heir?.id ?? null }).where(eq(schema.orderLines.ownerId, userId)).returning({ id: schema.orderLines.id }).all();
        if (moved.length) audit(tx, by, { action: heir ? "records reassigned" : "records cleared", model: "OrderLine", details: { column: "ownerId", user: userId, to: heir?.id ?? null, records: moved.map((r) => r.id) } });
      }
      {
        const moved = tx.update(schema.stops).set({ ownerId: heir?.id ?? null }).where(eq(schema.stops.ownerId, userId)).returning({ id: schema.stops.id }).all();
        if (moved.length) audit(tx, by, { action: heir ? "records reassigned" : "records cleared", model: "Stop", details: { column: "ownerId", user: userId, to: heir?.id ?? null, records: moved.map((r) => r.id) } });
      }
      tx.delete(user).where(eq(user.id, userId)).run();
      audit(tx, by, { action: "user removed", model: "User", title: target.name, details: { user: userId, email: target.email, role: target.role } });
    });
  } catch (error) {
    if (error instanceof Error && error.message.includes("FOREIGN KEY constraint failed"))
      throw new Error(\`\${target.name} is still named in records: choose someone to give them to.\`);
    throw error;
  }
}

function admins(): number {
  return db.select({ id: user.id }).from(user).where(eq(user.role, "admin")).all().length;
}

async function sendInvitation(by: Viewer, invited: InvitationRow): Promise<void> {
  const until = invited.expiresAt.toISOString().slice(0, 10);
  await sendMail({
    to: invited.email,
    subject: w.invitationSubject(app.name),
    text: w.invitationText(by.name, app.name, ROLE_LABELS[invited.role] ?? invited.role, invited.email, invited.link, until),
  });
}
"
`;

exports[`../../../examples/kiosk/smithable.yml > file list and generated code > src/generated/users.test.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// Invitations and user management: who gets in, with which role, and what an administrator may
// not do to their own account. Against the test database, like access.test.ts.
import { eq } from "drizzle-orm";
import { expect, test } from "vitest";
import { db } from "#/db";
import { auditLog, invitation, user } from "#/db/schema";
import { AccessDenied } from "#/kit/access";
import { forgetInLog } from "#/kit/audit.server";
import { outbox } from "#/kit/mail";
import { auth } from "#/lib/auth";
import { pageAccess } from "#/generated/pages";
import { invite, listUsers, removeUser, resendInvitation, ROLES, setRole, withdrawInvitation } from "./users.server";

const ORIGIN = "https://team.example";
/** The audit log's lines of one kind, oldest first. */
const audited = (action: string) =>
  db.select().from(auditLog).where(eq(auditLog.action, action)).all();
const admin = { id: "users-test-admin", name: "Users test admin", email: "users-test-admin@example.com", role: "admin" };
db.insert(user).values(admin).run();

/** A person's first sign-in: their user made the way any sign-in makes one, through the auth hooks. */
async function signUp(email: string) {
  const context = await auth.$context;
  const made = await context.internalAdapter.createUser({ email, name: email.split("@")[0] ?? email, emailVerified: true }, { method: "admin" });
  return db.select().from(user).where(eq(user.id, made.id)).get();
}

test("an invited address signs up with the invited role, and the invitation is used up", async () => {
  const before = outbox().length;
  const invited = await invite(admin, "Users-Test-Invited@example.com", "staff", ORIGIN);
  expect(invited.email).toBe("users-test-invited@example.com");
  expect(invited.link).toMatch(new RegExp(\`^\${ORIGIN}/sign-in\\\\?invite=[A-Za-z0-9_-]+$\`));
  const mail = outbox().at(-1);
  expect(outbox().length).toBe(before + 1);
  expect(mail).toMatchObject({ to: "users-test-invited@example.com", subject: "Invitation to Kiosken" });
  expect(mail?.text).toContain(invited.link);
  const listed = await listUsers(admin, ORIGIN);
  expect(listed.invitations.map((i) => i.email)).toContain("users-test-invited@example.com");

  const created = await signUp("users-test-invited@example.com");
  expect(created?.role).toBe("staff");
  expect(db.select().from(invitation).where(eq(invitation.email, "users-test-invited@example.com")).get()).toBeUndefined();
  // The audit log has both ends, with their values: who was invited as what, and who accepted.
  expect(audited("invited").at(-1)).toMatchObject({ who: admin.id, details: { email: "users-test-invited@example.com", role: "staff" } });
  expect(audited("invitation accepted").at(-1)).toMatchObject({ who: created?.id, details: { role: "staff" } });
});

test("with sign-up closed, an address nobody invited is refused", async () => {
  await expect(signUp("users-test-stranger@example.com")).rejects.toThrow(/invited/);
  expect(db.select().from(user).where(eq(user.email, "users-test-stranger@example.com")).get()).toBeUndefined();
});

test("a role the team page does not give, and a key whatever its role, is refused every change to who has access", async () => {
  const rule = pageAccess["team"];
  const pending = await invite(admin, "users-test-target@example.com", "staff", ORIGIN);
  const outsiders = [
    ...ROLES.filter((role) => role !== "admin" && !rule.roles.includes(role)).map((role) => ({
      id: \`users-test-\${role}\`,
      name: role,
      email: \`users-test-\${role}@example.com\`,
      role,
    })),
    // An API key with the administrator's role is still no person.
    { id: "key:users-test", name: "A key", email: "", role: "admin" },
  ];
  for (const outsider of outsiders) {
    await expect(listUsers(outsider, ORIGIN)).rejects.toThrow(AccessDenied);
    await expect(invite(outsider, "users-test-sneak@example.com", "admin", ORIGIN)).rejects.toThrow(AccessDenied);
    await expect(setRole(outsider, admin.id, "staff")).rejects.toThrow(AccessDenied);
    await expect(removeUser(outsider, admin.id)).rejects.toThrow(AccessDenied);
    await expect(resendInvitation(outsider, pending.id, ORIGIN)).rejects.toThrow(AccessDenied);
    await expect(withdrawInvitation(outsider, pending.id)).rejects.toThrow(AccessDenied);
  }
  // Nothing changed: the administrator, the invitation, and no new one.
  expect(db.select({ role: user.role }).from(user).where(eq(user.id, admin.id)).get()?.role).toBe("admin");
  const open = (await listUsers(admin, ORIGIN)).invitations.map((i) => i.email);
  expect(open).toContain("users-test-target@example.com");
  expect(open).not.toContain("users-test-sneak@example.com");
  await withdrawInvitation(admin, pending.id);
});

test("only the page's roles manage users; an administrator cannot change or remove themselves", async () => {
  const outsider = await signUp("users-test-outsider@example.com").catch(() => undefined);
  if (outsider && outsider.role !== "admin")
    await expect(listUsers(outsider, ORIGIN)).rejects.toThrow(AccessDenied);
  await expect(setRole(admin, admin.id, "staff")).rejects.toThrow(/own role/);
  await expect(removeUser(admin, admin.id)).rejects.toThrow(/yourself/);

  const colleague = db
    .insert(user)
    .values({ id: "users-test-colleague", name: "Colleague", email: "users-test-colleague@example.com", role: "staff" })
    .returning()
    .get();
  await setRole(admin, colleague.id, "admin");
  expect(db.select({ role: user.role }).from(user).where(eq(user.id, colleague.id)).get()?.role).toBe("admin");
  await removeUser(admin, colleague.id);
  expect(db.select().from(user).where(eq(user.id, colleague.id)).get()).toBeUndefined();
  // What touches security keeps its values in the audit log: from what to what, and who.
  expect(audited("role changed").at(-1)).toMatchObject({ who: admin.id, role: "admin", details: { user: colleague.id, from: "staff", to: "admin" } });
  expect(audited("user removed").at(-1)).toMatchObject({ who: admin.id, details: { user: colleague.id, email: "users-test-colleague@example.com" } });
  // Forget in the log: every line naming them goes blank, by id or by address (an invitation).
  db.insert(auditLog).values({ who: admin.id, action: "invited", details: { email: "users-test-colleague@example.com", role: "admin" } }).run();
  forgetInLog(admin, { user: colleague.id });
  expect(JSON.stringify(db.select().from(auditLog).all())).not.toContain("users-test-colleague@");

  const pending = await invite(admin, "users-test-pending@example.com", "admin", ORIGIN);
  await withdrawInvitation(admin, pending.id);
  expect((await listUsers(admin, ORIGIN)).invitations.map((i) => i.id)).not.toContain(pending.id);
  // A withdrawn invitation lets nobody in.
  await expect(signUp("users-test-pending@example.com")).rejects.toThrow(/invited/);
});
"
`;

exports[`../../../examples/kiosk/smithable.yml > file list and generated code > src/lib/auth.ts 1`] = `
"// Generated by Smithable from smithable.auth.yml. Do not edit: this file is overwritten on every change.
import { betterAuth } from "better-auth";
import { drizzleAdapter } from "better-auth/adapters/drizzle";
import { APIError, createAuthMiddleware } from "better-auth/api";
import { emailOTP } from "better-auth/plugins";
import { tanstackStartCookies } from "better-auth/tanstack-start";
import { eq } from "drizzle-orm";
import { db } from "#/db";
import { account, invitation, session, user, verification } from "#/db/schema";
import { app } from "#/generated/app";
import { ADDRESS_HEADER } from "#/kit/address.server";
import { audit } from "#/kit/audit.server";
import { codeAllowed } from "#/kit/limit";
import { log } from "#/kit/log.server";
import { mailConfigured, sendMail } from "#/kit/mail";
import { w } from "#/kit/words";

/** Sign-in providers in button order; each needs its keys in the environment (see the README). */
export const PROVIDERS = ["email"];

/** Who a session is for, as the audit log names them. */
function signedInAs(userId: string) {
  return db.select({ id: user.id, role: user.role }).from(user).where(eq(user.id, userId)).get() ?? null;
}
/** These addresses become admins when they first sign in. */
const ADMINS: string[] = ["owner@kiosken.example"];
/** A user a sign-in provider made with an address it has not confirmed (a code by mail confirms it). */
const unconfirmed = (path: string | undefined, verified: unknown) =>
  /^\\/(callback|sign-in\\/social|oauth2)(\\/|$)/.test(path ?? "") && verified !== true;
const socialProviders = {

};

/** The providers whose keys are set (email needs none: its codes go out by mail). */
export const configuredProviders = () => PROVIDERS.filter((p) => p === "email" || p in socialProviders);

/** Whether sign-in codes can leave the machine: mail settings, or development's outbox. */
export const codesReachPeople = () => import.meta.env.DEV || mailConfigured();
/** A mail stays in the outbox (the preview, or an app without mail settings): pages say so. */
export const mailKept = () => !mailConfigured();

/** The invitation for an address, if there is one (it may have expired). */
function invitationOf(email: string) {
  return db.select().from(invitation).where(eq(invitation.email, email)).get();
}

/** The invitation for an address that is still open. */
function openInvitation(email: string) {
  const invited = invitationOf(email);
  return invited && invited.expiresAt.getTime() > Date.now() ? invited : undefined;
}

/** Why an address may not have an account here, or nothing when it may. */
function joinRefusal(email: string): string | undefined {
  // The admins may always sign in, whatever the domains or the invitations say.
  if (ADMINS.includes(email)) return undefined;
  const invited = invitationOf(email);
  if (
    !(invited && invited.expiresAt.getTime() > Date.now()) &&
    !ADMINS.includes(email) &&
    !(import.meta.env.DEV && email.startsWith("dev-")) &&
    !(demoSignIn && email.startsWith("demo-"))
  )
    return invited
      ? "Your invitation has expired. Ask an administrator for a new one."
      : \`Only invited people can sign in to \${app.name}. Ask an administrator for an invitation.\`;
  return undefined;
}


/**
 * A demo (DEMO_SIGN_IN=1 in the environment): the sign-in page offers every role without a
 * provider, as development does, and the data is reset by whoever runs the demo. Never set it
 * on a real app.
 */
export const demoSignIn = process.env.DEMO_SIGN_IN === "1";

const NO_TOKENS = {
  accessToken: null,
  refreshToken: null,
  idToken: null,
  accessTokenExpiresAt: null,
  refreshTokenExpiresAt: null,
};

// Production needs both: without a secret sessions could be forged, without the address
// sign-in breaks. Better to refuse to start than to run like that.
if (!import.meta.env.DEV && (!process.env.BETTER_AUTH_SECRET || !process.env.BETTER_AUTH_URL))
  throw new Error("Set BETTER_AUTH_SECRET and BETTER_AUTH_URL: in production the app does not start without them.");

/** The app is served over https: its cookies can take the __Host- prefix, which needs Secure. */
const hostCookies = (process.env.BETTER_AUTH_URL ?? "").startsWith("https://");

export const auth = betterAuth({
  // In development the app runs on port 3000 (pnpm dev); set BETTER_AUTH_URL in production.
  baseURL: process.env.BETTER_AUTH_URL ?? (import.meta.env.DEV ? "http://localhost:3000" : undefined),
  // In development the app may run on any local port (the preview, the tests).
  ...(import.meta.env.DEV ? { trustedOrigins: ["http://localhost:*", "http://127.0.0.1:*"] } : {}),
  database: drizzleAdapter(db, { provider: "sqlite", schema: { account, session, user, verification } }),
  socialProviders,
  // A sign-in code is counted before the plugin makes one: a request past its limit gets the same
  // answer as any other and leaves the code already sent working.
  hooks: {
    before: createAuthMiddleware(async (ctx) => {
      if (ctx.path !== "/email-otp/send-verification-otp" || ctx.body?.type !== "sign-in" || !codesReachPeople()) return;
      try {
        codeAllowed(String(ctx.body?.email ?? "").trim().toLowerCase(), ctx.headers ?? new Headers());
      } catch {
        return ctx.json({ success: true });
      }
    }),
  },
  // Its limits count per address from the one header the auth route sets (src/kit/address.server.ts),
  // never from an X-Forwarded-For the visitor could make up.
  // Over https the cookies are named so only this app's own address can set them (__Host-: Secure,
  // Path=/, no Domain), not a sibling app on the same domain.
  advanced: {
    ipAddress: { ipAddressHeaders: [ADDRESS_HEADER] },
    ...(hostCookies
      ? {
          useSecureCookies: false,
          // Every other cookie it makes stays Secure too (a sign-in's state).
          // A __Host- cookie must say Path=/ itself: a browser refuses one that does not.
          defaultCookieAttributes: { secure: true, path: "/" },
          cookies: Object.fromEntries(
            ["session_token", "session_data", "dont_remember", "state"].map((name) => [
              name,
              { name: \`__Host-better-auth.\${name}\`, attributes: { secure: true, path: "/" } },
            ]),
          ),
        }
      : {}),
  },
  // On in every production build, not only where NODE_ENV says so (Better Auth's default).
  rateLimit: { enabled: !import.meta.env.DEV },
  // Email and password only serve the development sign-in; production builds leave it off. Nobody
  // signs up with a password: the development sign-in makes its users on the server.
  emailAndPassword: { enabled: import.meta.env.DEV || demoSignIn, disableSignUp: true },
  user: {
    additionalFields: {
      role: { type: "string", required: true, defaultValue: "staff", input: false },
    },
  },
  databaseHooks: {
    user: {
      create: {
        before: async (newUser, ctx) => {
          const email = newUser.email.toLowerCase();
          // A provider's sign-in proves the address only when the provider confirmed it (a code by
          // mail proves it by itself): unconfirmed, it gets no role beyond the default.
          const proven = !unconfirmed(ctx?.path, newUser.emailVerified);
          const refused = proven ? joinRefusal(email) : "Your sign-in provider has not confirmed this address.";
          if (refused) {
            audit(db, null, { action: "sign-in refused", model: "User", details: { email, reason: refused } });
            throw new APIError("FORBIDDEN", { message: refused });
          }
          return { data: { ...newUser, role: proven && ADMINS.includes(email) ? "admin" : proven ? openInvitation(email)?.role ?? "staff" : "staff" } };
        },
        after: async (created, ctx) => {
          const who = { id: created.id, role: String(created.role) };
          const email = created.email.toLowerCase();
          // A role the address would have had but was not given says why (create.before).
          const withheld =
            unconfirmed(ctx?.path, created.emailVerified) && (ADMINS.includes(email) || Boolean(openInvitation(email)))
              ? "the sign-in provider has not confirmed the address"
              : undefined;
          // Only an invitation still open was accepted (under open sign-up an expired one is not);
          // one whose role was withheld stays for whoever does own the address.
          const used = openInvitation(email);
          if (!(used && withheld)) {
            if (used)
              audit(db, who, { action: "invitation accepted", model: "User", details: { role: used.role } });
            // The invitation is used up: the user is the record from now on.
            db.delete(invitation).where(eq(invitation.email, email)).run();
          }
          audit(db, who, { action: "account created", model: "User", details: { role: who.role, ...(withheld ? { withheld } : {}) } });
        },
      },
    },
    // Signing in and out are in the audit log, as the person who did it.
    session: {
      create: {
        after: async (session) => audit(db, signedInAs(session.userId), { action: "signed in" }),
      },
      // A session also ends when it expires or its user is removed: only a sign-out says so.
      delete: {
        after: async (session, ctx) => {
          if (ctx?.path === "/sign-out") audit(db, signedInAs(session.userId), { action: "signed out" });
        },
      },
    },
    // The app only signs people in with a provider and never calls it afterwards, so the
    // provider's tokens are not kept: not in the database, its backups or its exports.
    account: {
      create: { before: async (account) => ({ data: { ...account, ...NO_TOKENS } }) },
      update: { before: async (account) => ({ data: { ...account, ...NO_TOKENS } }) },
    },
  },
  plugins: [
    // Sign-in by a six-digit code by mail: good for ten minutes, five tries, stored hashed.
    emailOTP({
      otpLength: 6,
      expiresIn: 600,
      allowedAttempts: 5,
      storeOTP: "hashed",
      async sendVerificationOTP({ email, otp, type }) {
        // Without mail settings a production app keeps no codes: nobody would get them.
        if (type !== "sign-in" || !codesReachPeople()) return;
        // Too many codes were refused before the plugin made this one (hooks.before).
        const address = email.toLowerCase();
        // Who may not join gets no mail, and the page says the same either way.
        const known = db.select({ id: user.id }).from(user).where(eq(user.email, address)).get();
        if (!known && joinRefusal(address)) return;
        // Not awaited, so the answer takes as long whether or not a mail goes out.
        void sendMail({
          to: address,
          subject: w.codeSubject(app.name),
          text: w.codeText(app.name, \`\${otp.slice(0, 3)} \${otp.slice(3)}\`),
        }).catch((error) => log.error("A sign-in code could not be sent", { error }));
      },
    }),
    tanstackStartCookies(),
  ],
});
"
`;

exports[`../../../examples/kiosk/smithable.yml > file list and generated code > src/lib/viewer.server.ts 1`] = `
"// Generated by Smithable from smithable.auth.yml. Do not edit: this file is overwritten on every change.
import { getRequestHeaders } from "@tanstack/react-start/server";
import type { Viewer } from "#/kit/access";
import { traceWho } from "#/kit/trace.server";
import { auth } from "#/lib/auth";

/** The signed-in user of the current request, or null; the access line names them. */
export async function currentViewer(): Promise<Viewer | null> {
  const session = await auth.api.getSession({ headers: getRequestHeaders() });
  if (!session) return null;
  const { id, name, email, role } = session.user;
  traceWho(id, role);
  return { id, name, email, role };
}
"
`;

exports[`../../../examples/kiosk/smithable.yml > file list and generated code > src/routes/__root.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createRootRoute, HeadContent, Scripts, ScriptOnce, useRouter, useRouterState } from "@tanstack/react-router";
import { createServerFn } from "@tanstack/react-start";
import { useEffect, useState } from "react";
import { History, List, ShoppingCart, Users } from "lucide-react";
import { app } from "#/generated/app";
import { pageAccess, pageUi } from "#/generated/pages";
import { currentViewer } from "#/lib/viewer.server";
import { APPEARANCE_SCRIPT } from "#/kit/appearance";
import { AppShell, ErrorNotice, type MenuUi } from "#/kit/AppShell";
import { LandingLayout } from "#/kit/Landing";
import { site } from "#/generated/site";
import { Consent } from "#/kit/Consent";
import { pageHeaders } from "#/kit/security";
import { w } from "#/kit/words";
import { authClient } from "#/lib/auth-client";
import appCss from "#/styles.css?url";

const menus: MenuUi[] = [
  {
    name: "main",
    items: [
      {
        to: "/orders",
        label: pageUi["orders"].title,
        icon: ShoppingCart,
        access: pageAccess["orders"],
      },
      {
        to: "/dishes",
        label: pageUi["dishes"].title,
        icon: List,
        access: pageAccess["dishes"],
      },
      {
        to: "/stops",
        label: pageUi["stops"].title,
        icon: List,
        access: pageAccess["stops"],
      },
    ],
  },
  {
    name: "admin",
    label: w.admin,
    items: [
      {
        to: "/team",
        label: pageUi["team"].title,
        icon: Users,
        access: pageAccess["team"],
      },
      {
        to: "/team/activity",
        label: w.activity,
        icon: History,
        access: pageAccess["team"],
      },
    ],
  },
];

const landingRoutes = ["/where"];
/** Public pages that visitors see in the site's frame (signed in, the app's). */
const visitorRoutes = ["/", "/sign-in"];

/** Each page's route and name, longest route first. */
const pageRoutes: [string, string][] = [
  ["/dishes", "dishes"],
  ["/orders", "orders"],
  ["/stops", "stops"],
  ["/where", "where"],
  ["/team", "team"],
  ["/", "menu"],
];

/** The page a path is on, e.g. "customers" for /customers/12 (see data-page, src/custom/styles.css). */
function pageOf(path: string): string | undefined {
  return pageRoutes.find(([route]) => path === route || path.startsWith(route === "/" ? "/" : \`\${route}/\`))?.[1];
}


// Who is signed in, and, when a hosting service runs a copy of the app's data from an earlier
// time to look at (DATA_AS_OF), that time.
const getViewer = createServerFn().handler(async () => ({
  viewer: await currentViewer(),
  asOf: process.env.DATA_AS_OF,
  demo: process.env.DEMO_SIGN_IN === "1",
}));

export const Route = createRootRoute({
  // Every page knows who is signed in; pages check their access with it.
  beforeLoad: () => getViewer(),
  headers: ({ ssr }) => pageHeaders(ssr?.nonce),
  head: () => ({
    meta: [
      { charSet: "utf-8" },
      { name: "viewport", content: "width=device-width, initial-scale=1" },
      { title: app.name },
    ],
    links: [
      { rel: "stylesheet", href: appCss },
      { rel: "icon", href: "/favicon.svg", type: "image/svg+xml" },
    ],
  }),
  shellComponent: RootDocument,
  errorComponent: ({ error }) => (
    <ErrorNotice title={w.errorTitle} message={error instanceof Error ? error.message : undefined} />
  ),
  notFoundComponent: () => (
    <ErrorNotice kind="not-found" title={w.notFound} message={w.notFoundNote} />
  ),
});

function RootDocument({ children }: { children: React.ReactNode }) {
  const { viewer, asOf, demo } = Route.useRouteContext();
  const pathname = useRouterState({ select: (state) => state.location.pathname });
  // Set once React has taken over the page in the browser, for tests that must not type or
  // click before the page's handlers are attached (body[data-hydrated]).
  const [hydrated, setHydrated] = useState(false);
  useEffect(() => setHydrated(true), []);
  const router = useRouter();
  const signOut = async () => {
    await authClient.signOut();
    await router.invalidate();
  };
  const rename = async (name: string) => {
    const { error } = await authClient.updateUser({ name });
    if (error) throw new Error(error.message);
    await router.invalidate();
  };
  return (
    // data-appearance is set by the head's script before React takes over (src/kit/appearance.ts).
    <html lang="en" suppressHydrationWarning>
      <head>
        <ScriptOnce children={APPEARANCE_SCRIPT} />
        <HeadContent />
      </head>
      <body data-page={pageOf(pathname)} data-hydrated={hydrated ? "true" : undefined}>
        {asOf && (
          <p role="status" className="bg-warning px-4 py-2 text-center text-sm text-warning-foreground">
            A copy of this app's data as of {asOf.slice(0, 16).replace("T", " ")} UTC: changes made here are not kept.
          </p>
        )}
        {demo && (
          <p role="status" className="bg-warning px-4 py-2 text-center text-sm text-warning-foreground">
            This is a demo: sign in as anyone and try things; the data is reset every hour.
          </p>
        )}
        {landingRoutes.includes(pathname) ? (
          children
        ) : !viewer && visitorRoutes.some((r) => pathname === r || pathname.startsWith(\`\${r}/\`)) ? (
          <LandingLayout appName={app.name} link={{ to: "/sign-in", label: w.signIn }} site={site}>
            <div className="mx-auto max-w-6xl px-5 py-10">{children}</div>
          </LandingLayout>
        ) : (
          <AppShell appName={app.name} home={{ to: "/", access: pageAccess["menu"] }} menus={menus} viewer={viewer} onSignOut={signOut} onRename={rename}>
            {children}
          </AppShell>
        )}
        <Consent />
        <Scripts />
      </body>
    </html>
  );
}
"
`;

exports[`../../../examples/kiosk/smithable.yml > file list and generated code > src/routes/dishes/$id.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, notFound, useNavigate, useRouter } from "@tanstack/react-router";
import { createServerFn } from "@tanstack/react-start";
import { and, desc, eq } from "drizzle-orm";
import { db } from "#/db";
import { auditLog, user } from "#/db/schema";
import { app } from "#/generated/app";
import { pageAccess, pageHead } from "#/generated/pages";
import { deleteDish, dishUi, getDish, updateDish } from "#/generated/dish";
import { dishSchema } from "#/generated/dish.schema";
import { soldOut, soldOutAccess, soldOutFits } from "#/generated/actions/sold-out";
import { backOn, backOnAccess, backOnFits } from "#/generated/actions/back-on";
import { allows, guardPage } from "#/kit/access";
import { ActionButton } from "#/kit/ActionButton";
import { ActivityLog } from "#/kit/ActivityLog";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";
import { w } from "#/kit/words";
import { currentViewer } from "#/lib/viewer.server";

/** The record's lines in the audit log, newest first: administrators only, nobody else. */
const getHistory = createServerFn()
  .validator((id: number) => id)
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    if (viewer?.role !== "admin") return null;
    const people = new Map(db.select({ id: user.id, name: user.name }).from(user).all().map((p) => [p.id, p.name]));
    return db
      .select()
      .from(auditLog)
      .where(and(eq(auditLog.model, "Dish"), eq(auditLog.recordId, id)))
      .orderBy(desc(auditLog.id))
      .limit(50)
      .all()
      .map((r) => ({
        id: r.id,
        at: r.at,
        who: r.who === "visitor" || r.who === "the app" ? r.who : (people.get(r.who) ?? (r.who.startsWith("key:") ? w.aKey(r.who.slice(4)) : r.who.startsWith("timer:") ? w.byTimer(r.who.slice(6)) : w.aRemovedUser(r.who))),
        action: r.action,
        fields: r.fields,
        details: r.details ? Object.fromEntries(Object.entries(r.details).map(([k, v]) => [k, String(v)])) : null,
      }));
  });

export const Route = createFileRoute("/dishes/$id")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["dishes"], context.viewer, location.href),
  head: () => pageHead("dishes"),
  loader: async ({ params }) => {
    const found = await getDish({ data: Number(params.id) });
    if (!found) throw notFound();
    return { ...found, history: await getHistory({ data: Number(params.id) }) };
  },
  component: DishPage,
});

function DishPage() {
  const { row, canWrite, canDelete, history } = Route.useLoaderData();
  const { viewer } = Route.useRouteContext();
  const navigate = useNavigate();
  const router = useRouter();
  const back = () => navigate({ to: "/dishes" });
  return (
    <>
      <PageHeader
        title={row.name || \`Dish #\${row.id}\`}
        actions={
          <>
            {allows(soldOutAccess, viewer, row.ownerId) && soldOutFits(row, viewer) && (
              <ActionButton
                label="Sold out"
                concept="action:soldOut"
                onRun={async () => {
                  await soldOut({ data: row.id });
                  await router.invalidate();
                }}
              />
            )}
            {allows(backOnAccess, viewer, row.ownerId) && backOnFits(row, viewer) && (
              <ActionButton
                label="Back on"
                concept="action:backOn"
                onRun={async () => {
                  await backOn({ data: row.id });
                  await router.invalidate();
                }}
              />
            )}
          </>
        }
      />
      <ModelForm
        key={String(row.updatedAt)}
        ui={dishUi}
        app={app}
        schema={dishSchema}
        initial={row}
        readOnly={!canWrite}
        submitLabel={w.saveChanges}
        onSubmit={async (values) => {
          await updateDish({ data: { id: row.id, values } });
          await back();
        }}
        onCancel={back}
        onDelete={
          canDelete
            ? async (together?: boolean) => {
                await deleteDish({ data: { id: row.id, together } });
                await back();
              }
            : undefined
        }
      />

      {history && history.length > 0 && (
        <section className="mt-10 max-w-3xl">
          <h2 className="mb-3 text-lg font-semibold">{w.history}</h2>
          <ActivityLog lines={history} app={app} />
        </section>
      )}
    </>
  );
}
"
`;

exports[`../../../examples/kiosk/smithable.yml > file list and generated code > src/routes/dishes/index.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, Link, useNavigate, useRouter } from "@tanstack/react-router";
import { pageAccess, pageUi, pageHead } from "#/generated/pages";
import { guardPage, allows } from "#/kit/access";
import { createServerFn } from "@tanstack/react-start";
import * as schema from "#/db/schema";
import { dishAccess, dishData } from "#/generated/dish.server";
import { inArray, and, eq } from "drizzle-orm";
import { currentViewer } from "#/lib/viewer.server";
import { type Search, count, listQuery, optional, text } from "#/kit/params";
import { buttonVariants } from "#/components/ui/button";
import { soldOut, soldOutAccess, soldOutFits, soldOutMany } from "#/generated/actions/sold-out";
import { backOn, backOnAccess, backOnFits, backOnMany } from "#/generated/actions/back-on";
import { ActionButton } from "#/kit/ActionButton";
import { useState } from "react";
import { SelectionBar } from "#/kit/SelectionBar";
import { csvName, csvOf, download } from "#/kit/csv";
import { deleteDishes, dishDeleteRule, dishUi } from "#/generated/dish";
import { app } from "#/generated/app";
import { w } from "#/kit/words";
import { PageHeader } from "#/kit/AppShell";
import { ModelTable } from "#/kit/ModelTable";
import { Filters } from "#/kit/Filters";
import { List } from "lucide-react";

/** The dishes matching the search and the filters, among those the viewer may read. */
const searchDishes = createServerFn()
  .validator(listQuery)
  .handler(async ({ data }) => {
    const viewer = await currentViewer();
    const where = and(
      undefined,
      data.f?.section ? inArray(schema.dishes.section, data.f?.section.split(",").filter((v) => ["starters", "mains", "drinks", "sweets"].includes(v)) as ("starters" | "mains" | "drinks" | "sweets")[]) : undefined,
      data.f?.available === "true" || data.f?.available === "false" ? eq(schema.dishes.available, data.f?.available === "true") : undefined,
    );
    return {
      ...(await dishData.page(viewer, where, undefined, data.all ? 1 : data.page, data.all ? (viewer ? 10000 : 500) : undefined)),
      canCreate: allows(dishAccess.create, viewer),
      options: {  },
    };
  });

export const Route = createFileRoute("/dishes/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["dishes"], context.viewer, location.href),
  head: () => pageHead("dishes"),
  validateSearch: (s: Search) => optional({ q: text(s.q), sort: text(s.sort), section: text(s.section), available: text(s.available), page: count(s.page) }),
  loaderDeps: ({ search }) => search,
  loader: ({ deps: { q, sort, page, ...f } }) => searchDishes({ data: { q, sort, f, page } }),
  // While a search or filter loads, the page stays (and its controls keep their focus).
  pendingMs: Number.POSITIVE_INFINITY,
  gcTime: 0,
  component: DishesPage,
});

function DishesPage() {
  const { rows, canCreate, total, page: at, size } = Route.useLoaderData();
  const { q, sort, page: _page, ...values } = Route.useSearch();
  const { viewer } = Route.useRouteContext();
  const navigate = useNavigate({ from: "/dishes/" });
  const router = useRouter();
  // The chosen rows, offered when the viewer may do something to at least one row.
  const [selected, setSelected] = useState<Set<number>>(new Set());
  const chosen = rows.filter((row) => selected.has(row.id));
  const selectable = rows.some((row) => allows(soldOutAccess, viewer, row.ownerId) && soldOutFits(row, viewer) || allows(backOnAccess, viewer, row.ownerId) && backOnFits(row, viewer) || allows(dishDeleteRule, viewer, row.ownerId));
  const newButton = canCreate && (
    <Link to="/dishes/new" className={buttonVariants()}>
      {w.newOne("dish")}
    </Link>
  );
  return (
    <>
      <PageHeader
        page="dishes"
        title={pageUi["dishes"].title}
        actions={newButton}
      />
      <Filters
        filters={[
  {
    name: "section",
    label: "Section",
    kind: "chips",
    options: dishUi.fields.find((f) => f.name === "section")?.choices,
  },
  { name: "available", label: "Available", kind: "toggle" },
]}
        values={values}
        onChange={(next) => navigate({ to: "/dishes", search: { q, ...next }, replace: true, resetScroll: false })}
      />
      {selectable && (
        <SelectionBar
          count={chosen.length}
          noun={["dish", "dishes"]}
          app={app}
          titleOf={(id) => String(rows.find((row) => row.id === id)?.name ?? id)}
          actions={[
            {
              label: "Sold out",
              concept: "action:soldOut",
              applies: chosen.filter((row) => allows(soldOutAccess, viewer, row.ownerId) && soldOutFits(row, viewer)).length,
              run: () => soldOutMany({ data: { ids: chosen.map((row) => row.id) } }),
            },
            {
              label: "Back on",
              concept: "action:backOn",
              applies: chosen.filter((row) => allows(backOnAccess, viewer, row.ownerId) && backOnFits(row, viewer)).length,
              run: () => backOnMany({ data: { ids: chosen.map((row) => row.id) } }),
            },
          ]}
          deletable={chosen.filter((row) => allows(dishDeleteRule, viewer, row.ownerId)).length}
          onDelete={(together) => deleteDishes({ data: { ids: chosen.map((row) => row.id), together } })}
          onDone={async () => {
            setSelected(new Set());
            await router.invalidate();
          }}
          onExport={() => download(csvName(dishUi), csvOf(dishUi, chosen))}
        />
      )}
      <ModelTable
        ui={dishUi}
        page="dishes"
        paging={{ page: at, size, total, to: (next) => navigate({ to: "/dishes", search: (prev) => ({ ...prev, page: next > 1 ? next : undefined }) }) }}
        app={app}
        exportRows={async () => (await searchDishes({ data: { q, sort, f: values, all: true } })).rows}
        rows={rows}
        icon={List}
        selection={selectable ? { ids: selected, onChange: setSelected } : undefined}
        rowActions={(row) => (
          <>
            {allows(soldOutAccess, viewer, row.ownerId) && soldOutFits(row, viewer) && (
              <ActionButton
                label="Sold out"
                concept="action:soldOut"
                onRun={async () => {
                  await soldOut({ data: row.id });
                  await router.invalidate();
                }}
              />
            )}
            {allows(backOnAccess, viewer, row.ownerId) && backOnFits(row, viewer) && (
              <ActionButton
                label="Back on"
                concept="action:backOn"
                onRun={async () => {
                  await backOn({ data: row.id });
                  await router.invalidate();
                }}
              />
            )}
          </>
        )}
        emptyMessage={q || Object.values(values).some(Boolean) ? "No dishes match the search and filters." : undefined}
        emptyAction={newButton || undefined}
        onOpen={(row) => navigate({ to: "/dishes/$id", params: { id: String(row.id) } })}
      />
    </>
  );
}
"
`;

exports[`../../../examples/kiosk/smithable.yml > file list and generated code > src/routes/dishes/new.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, useNavigate } from "@tanstack/react-router";
import { app } from "#/generated/app";
import { pageAccess, pageHead } from "#/generated/pages";
import { createDish, dishUi } from "#/generated/dish";
