"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { and, count, eq, inArray, sql, type SQL } from "drizzle-orm";
import { db } from "#/db";
import * as schema from "#/db/schema";
import { AccessDenied, allows, check, Conflict, type ModelAccess, personOf, readScope, type Viewer } from "#/kit/access";
import { audit, changedFields } from "#/kit/audit.server";
import { refusal } from "#/kit/log.server";
import { afterChange, afterDelete } from "./hooks";
import { barberData } from "./barber.server";
import { type TimeOffSettable } from "./time-off";

/** Who may read, create, change and delete time offs. */
export const timeOffAccess: ModelAccess = {
  read: { public: false, roles: ["admin"], owner: true },
  create: { public: false, roles: ["admin"], owner: false },
  write: { public: false, roles: ["admin"], owner: true },
  delete: { public: false, roles: ["admin"], owner: true },
};

/** A record as the viewer gets it: who owns it only for its owner and roles that read every record. */
function shownTo<R extends { ownerId: string | null }>(viewer: Viewer | null, row: R): R {
  if ((viewer && row.ownerId === viewer.id) || (!!viewer && (!!viewer.system || timeOffAccess.read.roles.includes(viewer.role)))) return row;
  return { ...row, ownerId: null };
}



/** Checks that the viewer may read the records the values refer to. */
function checkReferences(viewer: Viewer | null, values: Partial<TimeOffSettable>): void {
  if (values.barberId != null && !barberData.canRead(viewer, values.barberId))
    throw new AccessDenied(viewer !== null);
}

/** \`rows\` with each \`field\` reference \`readable\` leaves out set to nothing (only its id stays). */
function hideRefs<R extends Record<string, unknown>>(rows: R[], field: string, readable: (ids: number[]) => number[]): R[] {
  const idOf = (row: R) => (row[field] as { id?: unknown } | null | undefined)?.id;
  const ids = [...new Set(rows.map(idOf).filter((id): id is number => typeof id === "number"))];
  if (!ids.length) return rows;
  const shown = new Set(readable(ids));
  return rows.map((row) => {
    const id = idOf(row);
    return typeof id === "number" && !shown.has(id) ? { ...row, [field]: null } : row;
  });
}

export const timeOffData = {
  shownTo,
  /** The rows with each reference to a record the viewer may not read set to nothing: a related record's title is shown only to who may read it (only its id stays). */
  shownRefs<R extends Record<string, unknown>>(viewer: Viewer | null, rows: R[]): R[] {
    return hideRefs(rows, "barber", (ids, c = barberData.readable(viewer)) => (c ? db.select({ id: schema.barbers.id }).from(schema.barbers).where(and(inArray(schema.barbers.id, ids), c)).all().map((r) => r.id) : ids));
  },

  /** A condition for the time offs the viewer may read. */
  readable(viewer: Viewer | null) {
    const scope = readScope(timeOffAccess.read, viewer);
    if (scope === "all") return undefined;
    return scope === "own" && viewer ? eq(schema.timeOffs.ownerId, viewer.id) : sql\`false\`;
  },

  canRead(viewer: Viewer | null, id: number): boolean {
    const found = db
      .select({ id: schema.timeOffs.id })
      .from(schema.timeOffs)
      .where(and(eq(schema.timeOffs.id, id), timeOffData.readable(viewer)))
      .get();
    return found !== undefined;
  },

  /** The time offs the viewer may read; \`where\` narrows them, e.g. to a search. */
  async list(viewer: Viewer | null, where?: SQL) {
    if (readScope(timeOffAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const found = timeOffData.shownRefs(viewer, await db.query.timeOffs.findMany({
      where: and(timeOffData.readable(viewer), where),
      with: { barber: { columns: { id: true, name: true } } },
      orderBy: (t, { desc }) => [desc(t.id)],
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return rows;
  },

  /**
   * A page of the time offs the viewer may read that fit \`where\`, newest first (or in
   * \`order\`), and how many fit in all: for a list page. A page past the end is the last one.
   */
  async page(viewer: Viewer | null, where?: SQL, order?: SQL, page = 1, size = 50) {
    if (readScope(timeOffAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = and(timeOffData.readable(viewer), where);
    const total = db.select({ n: count() }).from(schema.timeOffs).where(condition).get()?.n ?? 0;
    const at = Math.min(Math.max(1, Math.trunc(page)), Math.max(1, Math.ceil(total / size)));
    const found = timeOffData.shownRefs(viewer, await db.query.timeOffs.findMany({
      where: condition,
      with: { barber: { columns: { id: true, name: true } } },
      orderBy: (t, { desc }) => [...(order ? [order] : []), desc(t.id)],
      limit: size,
      offset: (at - 1) * size,
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return { rows: rows, total, page: at, size };
  },

  async get(viewer: Viewer | null, id: number) {
    const fetched = await db.query.timeOffs.findFirst({
      where: and(eq(schema.timeOffs.id, id), timeOffData.readable(viewer)),
      with: { barber: { columns: { id: true, name: true } } },
    });
    const found = fetched && timeOffData.shownRefs(viewer, [fetched])[0];
    const row = found && shownTo(viewer, found);
    return row ? row : null;
  },

  async create(viewer: Viewer | null, values: TimeOffSettable) {
    check(timeOffAccess.create, viewer);
    checkReferences(viewer, values);
    let row: typeof schema.timeOffs.$inferSelect;
    try {
      row = db.transaction((tx) => {
        const made = tx.insert(schema.timeOffs).values({ ...values, ownerId: personOf(viewer) }).returning().get();
        audit(tx, viewer, { action: "created", model: "TimeOff", record: made.id });
        return made;
      });
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterCreate", "TimeOff", row, viewer);
    return row;
  },

  /** Changes the record; \`what\` names the change in the audit log (an action's name). */
  /** Changes the fields given; what names the action ("changed" for a form), frees the fields it may change although locked (its own set). */
  async update(viewer: Viewer | null, id: number, values: Partial<TimeOffSettable>, what = "changed", _frees: readonly string[] = []) {
    const row = db
      .select({ ownerId: schema.timeOffs.ownerId })
      .from(schema.timeOffs)
      .where(and(eq(schema.timeOffs.id, id), timeOffData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    // A form's change needs write on the record; an action (what names it) checked its own access
    // first, which includes the roles its grant names (docs/design/actions.md, Access).
    if (what === "changed") check(timeOffAccess.write, viewer, row.ownerId);
    checkReferences(viewer, values);
    let changed: typeof schema.timeOffs.$inferSelect;
    const updated = values;
    try {
      changed = db.transaction((tx) => {
        // Read again in the change itself: a record that left the viewer's reach meanwhile is refused.
        const before = tx.select().from(schema.timeOffs).where(and(eq(schema.timeOffs.id, id), timeOffData.readable(viewer))).get();
        if (!before) throw new AccessDenied(viewer !== null);
        const after = tx.update(schema.timeOffs).set(updated).where(eq(schema.timeOffs.id, id)).returning().get();
        audit(tx, viewer, { action: what, model: "TimeOff", record: id, fields: before && changedFields(before, after, Object.keys(updated)) });
        return after;
      });
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterUpdate", "TimeOff", changed, viewer);
    return changed;
  },

  /** Deletes the record; \`together\` takes the records that point to it along to the trash (delete-together.md). */
  async remove(viewer: Viewer | null, id: number, _together = false): Promise<void> {
    const row = db
      .select({ ownerId: schema.timeOffs.ownerId })
      .from(schema.timeOffs)
      .where(and(eq(schema.timeOffs.id, id), timeOffData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(timeOffAccess.delete, viewer, row.ownerId);
    try {
      db.transaction((tx) => {
        // Read again in the change itself: a record that left the viewer's reach meanwhile is refused.
        if (!tx.select({ id: schema.timeOffs.id }).from(schema.timeOffs).where(and(eq(schema.timeOffs.id, id), timeOffData.readable(viewer))).get())
          throw new AccessDenied(viewer !== null);
        const gone = tx.delete(schema.timeOffs).where(eq(schema.timeOffs.id, id)).returning().get();
        if (gone) {
          audit(tx, viewer, { action: "deleted", model: "TimeOff", record: id, title: gone.note });
        }
      });
    } catch (error) {
      throw refusal(error);
    }
    await afterDelete("TimeOff", id, viewer);
  },

  /**
   * Deletes the chosen records the viewer may delete, all or none (one still in use stops them
   * all, and is named); the others are skipped.
   */
  async removeMany(viewer: Viewer | null, ids: number[], _together = false): Promise<{ deleted: number; skipped: number }> {
    const rows = db
      .select({ id: schema.timeOffs.id, ownerId: schema.timeOffs.ownerId })
      .from(schema.timeOffs)
      .where(and(inArray(schema.timeOffs.id, ids), timeOffData.readable(viewer)))
      .all()
      .filter((row) => allows(timeOffAccess.delete, viewer, row.ownerId));
    db.transaction((tx) => {
      for (const row of rows)
        try {
          const gone = tx.delete(schema.timeOffs).where(eq(schema.timeOffs.id, row.id)).returning().get();
          if (gone) {
            audit(tx, viewer, { action: "deleted", model: "TimeOff", record: row.id, title: gone.note });
          }
        } catch (error) {
          const refused = refusal(error);
          throw refused instanceof Conflict && refused.message === "in-use" ? new Conflict(\`in-use:\${row.id}\`) : refused;
        }
    });
    for (const row of rows) {
      await afterDelete("TimeOff", row.id, viewer);
    }
    return { deleted: rows.length, skipped: new Set(ids).size - rows.length };
  },
};
"
`;

exports[`../../../examples/barbers/smithable.yml > file list and generated code > src/generated/time-off.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { z } from "zod";
import type * as schema from "#/db/schema";
import { allows, type Rule } from "#/kit/access";
import type { RecordUi } from "#/kit/model";
import { timeOffAccess, timeOffData } from "./time-off.server";
import { writeAllowed } from "#/kit/limit";
import { currentViewer } from "#/lib/viewer.server";
import { timeOffSchema } from "./time-off.schema";

export type { TimeOffSettable, TimeOffValues } from "./time-off.schema";

/** The viewer about to write, counted against how often one may (see src/kit/limit.ts). */
async function writer() {
  const viewer = await currentViewer();
  writeAllowed(viewer, getRequestHeaders());
  return viewer;
}

/** TimeOff records as the kit reads them. */
export type TimeOffRow = typeof schema.timeOffs.$inferSelect & {
  barber?: { id: number; name: string } | null;
};

export const timeOffUi: RecordUi<TimeOffRow> = {
  model: "TimeOff",
  label: "Time off",
  pluralLabel: "Time offs",
  titleField: "note",
  columns: ["note", "barberId", "from", "until"],
  fields: [
    {
      name: "barberId",
      label: "Barber",
      kind: "relation",
      required: true,
      relation: { key: "barber", titleField: "name" },
      get: (row) => row.barber?.name ?? null,
    },
    {
      name: "from",
      label: "From",
      kind: "datetime",
      required: true,
      get: (row) => row.from,
    },
    {
      name: "until",
      label: "Until",
      kind: "datetime",
      required: true,
      get: (row) => row.until,
    },
    {
      name: "note",
      label: "Note",
      kind: "string",
      required: false,
      get: (row) => row.note,
    },
  ],
};

/** Who may delete time offs: a list's selection offers Delete by it (the server checks again). */
export const timeOffDeleteRule: Rule = { public: false, roles: ["admin"], owner: true };


export const listTimeOffs = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return { rows: await timeOffData.list(viewer), canCreate: allows(timeOffAccess.create, viewer) };
});

export const getTimeOff = createServerFn()
  .validator(z.number().int())
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    const row = await timeOffData.get(viewer, id);
    if (!row) return null;
    return {
      row,
      canWrite: allows(timeOffAccess.write, viewer, row.ownerId),
      canDelete: allows(timeOffAccess.delete, viewer, row.ownerId),
    };
  });

export const createTimeOff = createServerFn({ method: "POST" })
  .validator(timeOffSchema)
  .handler(async ({ data }) => timeOffData.create(await writer(), data));

export const updateTimeOff = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), values: timeOffSchema }))
  .handler(async ({ data }) => timeOffData.update(await writer(), data.id, data.values));

/** Deletes a time off; \`together\` takes what points to it along (docs/design/delete-together.md). */
export const deleteTimeOff = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), together: z.boolean().optional() }))
  .handler(async ({ data }) => timeOffData.remove(await writer(), data.id, data.together));

/** Deletes the chosen time offs, all or none (at most 1,000 at once). */
export const deleteTimeOffs = createServerFn({ method: "POST" })
  .validator(z.object({ ids: z.array(z.number().int()).max(1000), together: z.boolean().optional() }))
  .handler(async ({ data }) => timeOffData.removeMany(await writer(), data.ids, data.together));
"
`;

