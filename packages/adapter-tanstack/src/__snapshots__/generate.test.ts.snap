exports[`../../../examples/booking/smithable.yml > file list and generated code > src/generated/session.formulas.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { F } from "#/kit/formula";

type Row = Record<string, unknown>;

/** Computed fields of Session, on records as stored (money in cents). */
export const sessionFormulas = {
  placesLeft: (r: Row): number => (F.n(r.capacity) - F.list(r.bookings).length),
};

/** Values suggested when a Session is created. */
export const sessionDefaults = {

};

/** The record with its computed fields. */
export function withSessionFormulas<T extends Row>(row: T): T & { placesLeft: number } {
  return { ...row, placesLeft: sessionFormulas.placesLeft(row) };
}
"
`;

exports[`../../../examples/booking/smithable.yml > file list and generated code > src/generated/session.server.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { and, count, eq, sql, type SQL } from "drizzle-orm";
import { db } from "#/db";
import { bookings, sessions } from "#/db/schema";
import { AccessDenied, check, Conflict, type ModelAccess, readScope, refusal, type Viewer } from "#/kit/access";
import { afterChange, afterDelete } from "./hooks";
import { bookingData } from "./booking.server";
import { classTypeData } from "./class-type.server";
import { instructorData } from "./instructor.server";
import type { SessionValues } from "./session";
import { withSessionFormulas } from "./session.formulas";

/** Who may read, create, change and delete sessions. */
export const sessionAccess: ModelAccess = {
  read: { public: true, roles: ["admin"], owner: true },
  create: { public: false, roles: ["admin"], owner: false },
  write: { public: false, roles: ["admin"], owner: true },
  delete: { public: false, roles: ["admin"], owner: true },
};

/** Checks that the viewer may read the records the values refer to. */
function checkReferences(viewer: Viewer | null, values: SessionValues): void {
  if (values.classTypeId != null && !classTypeData.canRead(viewer, values.classTypeId))
    throw new AccessDenied(viewer !== null);
  if (values.instructorId != null && !instructorData.canRead(viewer, values.instructorId))
    throw new AccessDenied(viewer !== null);
}

export const sessionData = {
  /** A condition for the sessions the viewer may read. */
  readable(viewer: Viewer | null) {
    const scope = readScope(sessionAccess.read, viewer);
    if (scope === "all") return undefined;
    return scope === "own" && viewer ? eq(sessions.ownerId, viewer.id) : sql\`false\`;
  },

  canRead(viewer: Viewer | null, id: number): boolean {
    const found = db
      .select({ id: sessions.id })
      .from(sessions)
      .where(and(eq(sessions.id, id), sessionData.readable(viewer)))
      .get();
    return found !== undefined;
  },

  /** The sessions the viewer may read; \`where\` narrows them, e.g. to a search; \`limit\` keeps the newest (a data page). */
  async list(viewer: Viewer | null, where?: SQL, limit?: number) {
    if (readScope(sessionAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const rows = await db.query.sessions.findMany({
      where: and(sessionData.readable(viewer), where),
      with: { classType: { columns: { id: true, name: true } }, instructor: { columns: { id: true, name: true } }, bookings: true },
      orderBy: (t, { desc }) => [desc(t.id)],
      limit,
    });
    // The related records are here for the totals only: some may not be the viewer's to read.
    return rows.map((row) => {
      const { bookings, ...listed } = withSessionFormulas(row);
      return listed;
    });
  },

  /** How many sessions the viewer may read, for a data page's overview; none to read: null. */
  count(viewer: Viewer | null): number | null {
    if (readScope(sessionAccess.read, viewer) === "none") return null;
    return db.select({ n: count() }).from(sessions).where(sessionData.readable(viewer)).get()?.n ?? 0;
  },

  async get(viewer: Viewer | null, id: number) {
    const row = await db.query.sessions.findFirst({
      where: and(eq(sessions.id, id), sessionData.readable(viewer)),
      with: { classType: { columns: { id: true, name: true } }, instructor: { columns: { id: true, name: true } }, bookings: { where: bookingData.readable(viewer) } },
    });
    if (!row) return null;
    // Totals count every related record, as in lists; the related records shown are the viewer's.
    const all = await db.query.sessions.findFirst({ where: eq(sessions.id, id), with: { bookings: true } });
    return { ...withSessionFormulas({ ...row, bookings: all?.bookings ?? [] }), bookings: row.bookings };
  },

  async create(viewer: Viewer | null, values: SessionValues) {
    check(sessionAccess.create, viewer);
    checkReferences(viewer, values);
    let row: typeof sessions.$inferSelect;
    try {
      row = db.insert(sessions).values({ ...values, ownerId: viewer?.id ?? null }).returning().get();
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterCreate", "Session", row, viewer);
    return row;
  },

  async update(viewer: Viewer | null, id: number, values: SessionValues) {
    const row = db
      .select({ ownerId: sessions.ownerId })
      .from(sessions)
      .where(and(eq(sessions.id, id), sessionData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(sessionAccess.write, viewer, row.ownerId);
    checkReferences(viewer, values);
    let changed: typeof sessions.$inferSelect;
    const updated = values;
    try {
      changed = db.transaction((tx) => {
      if (values.capacity != null) {
        const booked = tx.select({ n: count() }).from(bookings).where(and(eq(bookings.sessionId, id))).get()?.n ?? 0;
        if (values.capacity < booked) throw new Conflict(\`booked:\${booked}\`);
      }
        return tx.update(sessions).set(updated).where(eq(sessions.id, id)).returning().get();
      });
    } catch (error) {
      throw error instanceof Conflict ? error : refusal(error);
    }
    await afterChange("afterUpdate", "Session", changed, viewer);
    return changed;
  },

  async remove(viewer: Viewer | null, id: number): Promise<void> {
    const row = db
      .select({ ownerId: sessions.ownerId })
      .from(sessions)
      .where(and(eq(sessions.id, id), sessionData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(sessionAccess.delete, viewer, row.ownerId);
    try {
      db.delete(sessions).where(eq(sessions.id, id)).run();
    } catch (error) {
      throw refusal(error);
    }
    await afterDelete("Session", id, viewer);
  },

  /** Choices for fields that refer to a session: the ones the viewer may read. */
  options(viewer: Viewer | null) {
    if (readScope(sessionAccess.read, viewer) === "none") return [];
    return db
      .select({ value: sessions.id, label: sql<string>\`'Session #' || \${sessions.id}\` })
      .from(sessions)
      .where(sessionData.readable(viewer))
      .orderBy(sessions.id)
      .all();
  },
};
"
`;

exports[`../../../examples/booking/smithable.yml > file list and generated code > src/generated/session.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { createInsertSchema } from "drizzle-zod";
import { z } from "zod";
import { sessions } from "#/db/schema";
import { allows } from "#/kit/access";
import type { RecordUi } from "#/kit/model";
import { sessionDefaults, withSessionFormulas } from "./session.formulas";
import { sessionAccess, sessionData } from "./session.server";
import { writeAllowed } from "#/kit/limit";
import { currentViewer } from "#/lib/viewer.server";

/** The viewer about to write, counted against how often one may (see src/kit/limit.ts). */
async function writer() {
  const viewer = await currentViewer();
  writeAllowed(viewer, getRequestHeaders());
  return viewer;
}

/** Session records as the kit reads them. */
export type SessionRow = typeof sessions.$inferSelect & {
  classType?: { id: number; name: string } | null;
  instructor?: { id: number; name: string } | null;
  placesLeft?: unknown;
};

export const sessionUi: RecordUi<SessionRow> = {
  model: "Session",
  label: "Session",
  pluralLabel: "Sessions",
  titleField: "id",
  columns: ["classTypeId", "instructorId", "startsAt", "capacity", "placesLeft"],
  fields: [
    {
      name: "classTypeId",
      label: "Class type",
      kind: "relation",
      required: true,
      relation: { key: "classType", titleField: "name" },
      get: (row) => row.classType?.name ?? null,
    },
    {
      name: "instructorId",
      label: "Instructor",
      kind: "relation",
      required: true,
      relation: { key: "instructor", titleField: "name" },
      get: (row) => row.instructor?.name ?? null,
    },
    {
      name: "startsAt",
      label: "Starts at",
      kind: "datetime",
      required: true,
      get: (row) => row.startsAt,
    },
    {
      name: "capacity",
      label: "Capacity",
      kind: "int",
      required: true,
      default: 12,
      get: (row) => row.capacity,
    },
    {
      name: "placesLeft",
      label: "Places left",
      kind: "int",
      required: false,
      computed: true,
      get: (row) => row.placesLeft,
    },
  ],
  compute: withSessionFormulas,
  defaults: sessionDefaults,
};

export const sessionSchema = createInsertSchema(sessions).omit({ id: true, ownerId: true, createdAt: true, updatedAt: true });

export type SessionValues = z.output<typeof sessionSchema>;

export const listSessions = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return { rows: await sessionData.list(viewer), canCreate: allows(sessionAccess.create, viewer) };
});

export const getSession = createServerFn()
  .validator(z.number().int())
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    const row = await sessionData.get(viewer, id);
    if (!row) return null;
    return {
      row,
      canWrite: allows(sessionAccess.write, viewer, row.ownerId),
      canDelete: allows(sessionAccess.delete, viewer, row.ownerId),
    };
  });

/** Choices for fields that refer to a session. */
export const sessionOptions = createServerFn().handler(async () =>
  sessionData.options(await currentViewer()),
);

export const createSession = createServerFn({ method: "POST" })
  .validator(sessionSchema)
  .handler(async ({ data }) => sessionData.create(await writer(), data));

export const updateSession = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), values: sessionSchema }))
  .handler(async ({ data }) => sessionData.update(await writer(), data.id, data.values));

export const deleteSession = createServerFn({ method: "POST" })
  .validator(z.number().int())
  .handler(async ({ data: id }) => sessionData.remove(await writer(), id));
"
`;

