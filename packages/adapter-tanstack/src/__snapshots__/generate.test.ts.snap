/** The offer for a caller; a role the app does not know gets nothing. */
export function offerFor(viewer: Viewer | null): Offer & { describe: Record<string, string> } {
  const caller = viewer?.role ?? "visitor";
  return Object.hasOwn(OFFERS, caller) ? OFFERS[caller] : { summary: "", tools: [], describe: {} };
}

/** Each kind's data functions and conversions, its title field, and its references' titles. */
const KINDS = {
  BusinessProfile: { data: businessProfileData, toApi: businessProfileToApi, fromApi: businessProfileFromApi, title: "businessName", refs: {}, searched: ["businessName","vatNumber","iban","invoiceFooter"], lists: {} as Record<string, { kind: string; ref: string }>, label: "business profile", named: (viewer: Viewer | null, text: string) => businessProfileData.named(viewer, text) },
  Client: { data: clientData, toApi: clientToApi, fromApi: clientFromApi, title: "name", refs: {}, searched: ["name","email","address","vatNumber"], lists: {"invoices":{"kind":"Invoice","ref":"client"}} as Record<string, { kind: string; ref: string }>, label: "client", named: (viewer: Viewer | null, text: string) => clientData.named(viewer, text) },
  Invoice: { data: invoiceData, toApi: invoiceToApi, fromApi: invoiceFromApi, title: "number", refs: {"client":"name"}, searched: ["number"], lists: {"lines":{"kind":"InvoiceLine","ref":"invoice"}} as Record<string, { kind: string; ref: string }>, label: "invoice", named: (viewer: Viewer | null, text: string) => invoiceData.named(viewer, text) },
  InvoiceLine: { data: invoiceLineData, toApi: invoiceLineToApi, fromApi: invoiceLineFromApi, title: "description", refs: {"invoice":"number"}, searched: ["description"], lists: {} as Record<string, { kind: string; ref: string }>, label: "invoice line", named: (viewer: Viewer | null, text: string) => invoiceLineData.named(viewer, text) },
};
type Kind = (typeof KINDS)[keyof typeof KINDS];

const kindOf = (args: Record<string, unknown>): Kind => {
  const kind = Object.hasOwn(KINDS, String(args.kind)) ? KINDS[args.kind as keyof typeof KINDS] : undefined;
  if (!kind) throw new BadInput(\`There is no kind "\${String(args.kind)}". Kinds: \${Object.keys(KINDS).join(", ")}.\`);
  return kind;
};

/**
 * A record the caller may use, by its id or by its title (an invoice's number): one that fits,
 * never a guess; "not there" and "not yours" are the same answer.
 */
async function found(kind: Kind, viewer: Viewer | null, id: unknown, verb = "read") {
  let key = Number.isInteger(id) ? (id as number) : /^\\d+$/.test(String(id)) ? Number(id) : undefined;
  if (key === undefined && typeof id === "string" && kind.named) {
    const fits = kind.named(viewer, id);
    const exact = fits.filter((r) => r.title.toLowerCase() === id.toLowerCase());
    const pick = exact.length === 1 ? exact : fits;
    if (pick.length > 1)
      throw new BadInput(\`"\${id}" fits several: \${pick.slice(0, 5).map((r) => \`\${r.title} (\${r.id})\`).join(", ")}. Give its whole \${titleWord(kind)} or its id.\`);
    key = pick[0]?.id;
  }
  const row = key === undefined ? null : await kind.data.get(viewer, key);
  if (!row) throw new NotFound(\`No \${kind.label} \${String(id)} that you may \${verb}; find it first.\`);
  return row;
}

/** The title's word in a sentence: a name of parts is the record's name. */
const titleWord = (kind: Kind) => (kind.title === "$name" ? "name" : kind.title);

/** A field's value in a row: a reference as its id and title, nothing else changed. */
function shown(kind: Kind, row: Record<string, unknown>, api: Record<string, unknown>, field: string): unknown {
  const title = (kind.refs as Record<string, string>)[field];
  const related = row[field] as Record<string, unknown> | null | undefined;
  // A name of parts, as the data functions set it on the rows they give (record-names.md).
  if (field === "$name") return row.$name ?? null;
  if (title && related && typeof related === "object")
    return related.deletedAt ? { id: related.id, inTrash: true } : { id: related.id, title: related[title] };
  if (!(field in api)) throw new BadInput(\`There is no field "\${field}". Fields: \${Object.keys(api).join(", ")}.\${field === "title" ? \` The title field is \${titleWord(kind)}.\` : ""}\`);
  return api[field];
}

/** "count", "sum total", "average total", "min …", "max …" as measure's own words. */
function measureOf(of: unknown): { how: "count" | "sum" | "average" | "smallest" | "largest"; field?: string } {
  const [word = "count", field] = String(of ?? "count").trim().split(/\\s+/);
  const how = ({ count: "count", sum: "sum", average: "average", min: "smallest", max: "largest" } as const)[word as "count"];
  if (!how) throw new BadInput('"of" is count, or sum, average, min or max with a number field, e.g. "sum total".');
  return { how, field };
}

/** An action is a key's: a visitor is never offered one, and is refused here too. */
const keyed = (viewer: Viewer | null): Viewer => {
  if (!viewer) throw new AccessDenied(false);
  return viewer;
};

/** A call's result, or its note when \`where\` names a value no record has. */
async function none<T>(call: () => Promise<T>): Promise<T | { none: string }> {
  try {
    return await call();
  } catch (error) {
    if (error instanceof NoSuchValue) return { none: error.message };
    throw error;
  }
}
const noted = (result: unknown): result is { none: string } =>
  typeof result === "object" && result !== null && "none" in result;

/** Why a call found none: a text no record has, or a search nothing fits, with the nearest. */
async function whyNone(kind: Kind, viewer: Viewer | null, args: Record<string, unknown>): Promise<string | undefined> {
  const text = kind.data.whyNone(viewer, args.where);
  if (text) return text;
  // None of the viewer's own: say how many there are without "mine" (ask-checks.md §6).
  const where = args.where as Record<string, unknown> | undefined;
  if (where && (where.mine === true || where.mine === "true")) {
    const { mine: _mine, ...rest } = where;
    const all = await kind.data.measure(viewer, "count", { where: rest, search: typeof args.search === "string" ? args.search : undefined });
    if (all) return \`None of your own; \${all} in all.\`;
  }
  if (typeof args.search !== "string") return undefined;
  // Nothing found by a search: say where it looked, the nearest titles, and how a reference is matched instead.
  const refs = Object.keys(kind.refs);
  const near = "titles" in kind.data ? nearest(args.search, kind.data.titles(viewer)) : [];
  return \`Nothing has every word of "\${args.search}" in \${kind.searched.join(", ") || "the texts"}.\${near.length ? \` The nearest \${titleWord(kind)}s: \${near.join(", ")}.\` : ""}\${refs.length ? \` A \${refs[0]} is matched with where, e.g. {"\${refs[0]}": "…"}.\` : ""}\`;
}

/** Calls one tool as the key's role, or as a visitor without a key. */
export async function callTool(viewer: Viewer | null, name: string, args: Record<string, unknown>): Promise<unknown> {
  switch (name) {
    case "find": {
      const kind = kindOf(args);
      const limit = Math.min(50, Math.max(1, Number(args.limit) || 10));
      const page = Math.max(1, Number(args.page) || 1);
      const asked = Array.isArray(args.fields) ? args.fields.map(String) : [];
      const columns = [...new Set(["id", kind.title, ...asked])];
      // A value no record has is none, with what there is (docs/design/ask-checks.md §2).
      const result = await none<{ items: unknown[]; total: number }>(() =>
        kind.data.find(viewer, {
          where: args.where,
          search: typeof args.search === "string" ? args.search : undefined,
          sort: typeof args.sort === "string" ? args.sort : undefined,
          limit,
          offset: (page - 1) * limit,
        }),
      );
      if (noted(result)) return { columns, rows: [], total: 0, note: result.none };
      const { items, total } = result;
      const rows = items.map((row) => {
        const api = kind.toApi(row as Record<string, any>) as Record<string, unknown>;
        return columns.map((field) => shown(kind, row as Record<string, unknown>, api, field));
      });
      if (total) return { columns, rows, total };
      const why = await whyNone(kind, viewer, args);
      return why ? { columns, rows, total, note: why } : { columns, rows, total };
    }
    case "measure": {
      const kind = kindOf(args);
      const { how, field } = measureOf(args.of);
      const options = { field, where: args.where, search: typeof args.search === "string" ? args.search : undefined };
      const key = how === "count" ? "total" : how;
      if (typeof args.by === "string") {
        const by = args.by;
        const rows = await none(() => kind.data.measureBy(viewer, how, by, options));
        if (noted(rows)) return { by, rows: [], note: rows.none };
        // A top shared by several is said, so one is not given as the winner.
        const top = rows[0]?.number;
        const tied = rows.filter((r) => r.number === top);
        return tied.length > 1 && top !== null && top !== undefined
          ? { by, rows, note: \`\${tied.map((r) => r.title ?? String(r.value)).join(", ")} share the top, with \${top} each.\` }
          : { by, rows };
      }
      const value = await none(() => kind.data.measure(viewer, how, options));
      if (noted(value)) return { [key]: how === "count" ? 0 : null, note: value.none };
      // The smallest or largest: which record holds it.
      if ((how === "smallest" || how === "largest") && value !== null)
        return { [how]: value, of: await kind.data.holder(viewer, how, options) };
      const why = !value ? await whyNone(kind, viewer, args) : undefined;
      return why ? { [key]: value, note: why } : { [key]: value };
    }
    case "read": {
      const kind = kindOf(args);
      const row = await found(kind, viewer, args.id);
      // With its lists, as its page shows them: an invoice with its lines (twenty of each at most).
      const lists: Record<string, unknown> = {};
      for (const [field, list] of Object.entries(kind.lists)) {
        const related = KINDS[list.kind as keyof typeof KINDS] as Kind;
        const find = related.data.find.bind(related.data) as (viewer: Viewer | null, options: { where: unknown; limit: number }) => Promise<{ items: unknown[]; total: number }>;
        const shown = await find(viewer, { where: { [list.ref]: row.id }, limit: 20 }).catch(() => undefined);
        if (shown) lists[field] = { rows: shown.items.map((r) => related.toApi(r as Record<string, any>)), total: shown.total };
      }
      return { ...kind.toApi(row as Record<string, any>), ...lists };
    }
    case "add": {
      const kind = kindOf(args);
      return kind.toApi(await kind.data.create(viewer, kind.fromApi(args.values ?? {}) as never));
    }
    case "change": {
      const kind = kindOf(args);
      const row = await found(kind, viewer, args.id, "change");
      return kind.toApi(await kind.data.update(viewer, row.id, kind.fromApi(args.values ?? {}, row as Record<string, unknown>) as never));
    }
    case "delete": {
      const kind = kindOf(args);
      const row = await found(kind, viewer, args.id, "delete");
      await kind.data.remove(viewer, row.id, args.together === true);
      return { deleted: row.id };
    }
    case "describe":
      kindOf(args);
      return { description: offerFor(viewer).describe[args.kind as string] };
    case "run":
      switch (args.action) {
    case "markSent": {
      const row = await found(KINDS.Invoice, viewer, args.id, "change");
      return invoiceToApi(await runMarkSent(keyed(viewer), row.id));
    }
    case "markPaid": {
      const row = await found(KINDS.Invoice, viewer, args.id, "change");
      return invoiceToApi(await runMarkPaid(keyed(viewer), row.id));
    }
    case "markOverdue": {
      const row = await found(KINDS.Invoice, viewer, args.id, "change");
      return invoiceToApi(await runMarkOverdue(keyed(viewer), row.id));
    }
        default:
          throw new NotFound(\`There is no action "\${String(args.action)}".\`);
      }
    default:
      throw new NotFound(\`There is no tool "\${name}".\`);
  }
}

/** How each caller is answered: the rules, then the host's model; a visitor by the rules only. */
const ASKS: Record<string, string> = {"admin":"model","member":"model"};

/** A kind's words for the wording rules, read from its module: the fields the caller reads. */
function kindWords(ui: ModelUi, fields: string[], filters: AskFilter[], numbers: string[], by: string[]): AskKind {
  const field = (name: string) => ui.fields.find((f) => f.name === name || f.relation?.key === name);
  return {
    model: ui.model ?? "",
    label: ui.label,
    pluralLabel: ui.pluralLabel,
    fields: fields.map((name) => ({ name, label: field(name)?.label ?? name })),
    filters: filters.map((f) =>
      f.by === "value"
        ? { ...f, labels: Object.fromEntries((field(f.field)?.choices ?? []).map((c) => [c.value, c.label])) }
        : f,
    ),
    numbers,
    by,
  };
}

/** Each caller's kinds of record in the words people use, for the wording rules (read when asked, in the language then). */
const WORDS: Record<string, () => AskKind[]> = {
  "admin": () => [
    kindWords(businessProfileUi, ["businessName","vatNumber","iban","paymentTermDays","invoiceFooter"], [{"field":"businessName","by":"text"},{"field":"vatNumber","by":"text"},{"field":"iban","by":"text"},{"field":"paymentTermDays","by":"number"}], ["paymentTermDays"], []),
    kindWords(clientUi, ["name","email","address","vatNumber"], [{"field":"name","by":"text"},{"field":"email","by":"text"},{"field":"vatNumber","by":"text"}], [], []),
    kindWords(invoiceUi, ["number","client","issuedOn","dueOn","status","contract"], [{"field":"number","by":"text"},{"field":"client","by":"reference","model":"Client"},{"field":"issuedOn","by":"date"},{"field":"dueOn","by":"date"},{"field":"status","by":"value","values":["draft","sent","paid","overdue"]}], [], ["client","issuedOn","dueOn","status"]),
    kindWords(invoiceLineUi, ["invoice","description","quantity","unitPrice"], [{"field":"invoice","by":"reference","model":"Invoice"},{"field":"description","by":"text"},{"field":"quantity","by":"number"},{"field":"unitPrice","by":"number"}], ["quantity","unitPrice"], ["invoice"]),
  ],
  "member": () => [
    kindWords(businessProfileUi, ["businessName","vatNumber","iban","paymentTermDays","invoiceFooter"], [{"field":"businessName","by":"text"},{"field":"vatNumber","by":"text"},{"field":"iban","by":"text"},{"field":"paymentTermDays","by":"number"}], ["paymentTermDays"], []),
    kindWords(clientUi, ["name","email","address","vatNumber"], [{"field":"name","by":"text"},{"field":"email","by":"text"},{"field":"vatNumber","by":"text"}], [], []),
    kindWords(invoiceUi, ["number","client","issuedOn","dueOn","status","contract"], [{"field":"number","by":"text"},{"field":"client","by":"reference","model":"Client"},{"field":"issuedOn","by":"date"},{"field":"dueOn","by":"date"},{"field":"status","by":"value","values":["draft","sent","paid","overdue"]}], [], ["client","issuedOn","dueOn","status"]),
    kindWords(invoiceLineUi, ["invoice","description","quantity","unitPrice"], [{"field":"invoice","by":"reference","model":"Invoice"},{"field":"description","by":"text"},{"field":"quantity","by":"number"},{"field":"unitPrice","by":"number"}], ["quantity","unitPrice"], ["invoice"]),
  ],
};

/** Whether the viewer gets "Ask": a role the assistant block names, or a visitor when it says anyone. */
export function asks(viewer: Viewer | null): boolean {
  return Object.hasOwn(ASKS, viewer?.role ?? "visitor");
}

/** A question answered as the person asking (or a visitor), with what they may read and do. */
export async function ask(viewer: Viewer | null, question: string, turns: Turn[] = []): Promise<Answer> {
  const caller = viewer?.role ?? "visitor";
  if (!Object.hasOwn(ASKS, caller)) throw new AccessDenied(viewer !== null);
  return answer(question, {
    offer: offerFor(viewer),
    kinds: WORDS[caller]?.() ?? [],
    call: (tool, args) => callTool(viewer, tool, args),
    turns,
    model: viewer && ASKS[caller] === "model" ? hostModel(viewer.id) : undefined,
    // A visitor is never answered by a model; a person signed in is told in the kit's words.
    unread: viewer
      ? undefined
      : 'The app answers questions it can read by itself, like "how many … are there?" or "show the … that …".',
    voice: "plain",
  });
}
"
`;

exports[`../../../examples/invoicing/smithable.yml > file list and generated code > src/generated/business-profile.schema.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createInsertSchema } from "drizzle-zod";
import type { z } from "zod";
import * as schema from "#/db/schema";
import { w } from "#/kit/words";

/** What a business profile may be given: a form's values and what the app fills (an action's set). */
export const businessProfileSettable = createInsertSchema(schema.businessProfiles, {
  businessName: (s) => s.trim().min(1, w.required).max(200, w.atMostCharacters(200)),
  vatNumber: (s) => s.max(200, w.atMostCharacters(200)),
  iban: (s) => s.max(200, w.atMostCharacters(200)),
  invoiceFooter: (s) => s.max(10000, w.atMostCharacters(10000)),
}).omit({ id: true, ownerId: true, createdAt: true, updatedAt: true });
/** What a business profile's form sends, checked. */
export const businessProfileSchema = businessProfileSettable;

export type BusinessProfileSettable = z.output<typeof businessProfileSettable>;
export type BusinessProfileValues = z.output<typeof businessProfileSchema>;
"
`;

exports[`../../../examples/invoicing/smithable.yml > file list and generated code > src/generated/business-profile.server.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { type AnyColumn, and, asc, avg, count, desc, eq, inArray, isNotNull, max, min, sql, sum, type SQL } from "drizzle-orm";
import { db } from "#/db";
import * as schema from "#/db/schema";
import { AccessDenied, allows, check, Conflict, type ModelAccess, personOf, readScope, type Viewer } from "#/kit/access";
import { audit, changedFields } from "#/kit/audit.server";
import { refusal } from "#/kit/log.server";
import { contains } from "#/kit/search";
import { BadInput } from "#/kit/refusal";
import { aggregate, type Filterable, nearest, sortOf, whereOf, wordsOf } from "#/kit/where";
import { afterChange, afterDelete } from "./hooks";
import { type BusinessProfileSettable } from "./business-profile";
import "./timers.server";

/** Who may read, create, change and delete business profiles. */
export const businessProfileAccess: ModelAccess = {
  read: { public: false, roles: ["admin"], owner: true },
  create: { public: false, roles: ["admin", "member"], owner: false },
  write: { public: false, roles: ["admin"], owner: true },
  delete: { public: false, roles: ["admin"], owner: true },
};

/** A record as the viewer gets it: who owns it only for its owner and roles that read every record. */
function shownTo<R extends { ownerId: string | null }>(viewer: Viewer | null, row: R): R {
  if ((viewer && row.ownerId === viewer.id) || (!!viewer && (!!viewer.system || businessProfileAccess.read.roles.includes(viewer.role)))) return row;
  return { ...row, ownerId: null };
}


/** What \`where\` may name, and how: the stored fields, by kind. */
const FILTERABLE: Record<string, Filterable> = {
  businessName: { kind: "text", column: schema.businessProfiles.businessName },
  vatNumber: { kind: "text", column: schema.businessProfiles.vatNumber },
  iban: { kind: "text", column: schema.businessProfiles.iban },
  paymentTermDays: { kind: "number", column: schema.businessProfiles.paymentTermDays },
  invoiceFooter: { kind: "text", column: schema.businessProfiles.invoiceFooter },
};

/** What the records can be sorted by. */
const SORTABLE = { id: schema.businessProfiles.id, businessName: schema.businessProfiles.businessName, vatNumber: schema.businessProfiles.vatNumber, iban: schema.businessProfiles.iban, paymentTermDays: schema.businessProfiles.paymentTermDays, invoiceFooter: schema.businessProfiles.invoiceFooter, createdAt: schema.businessProfiles.createdAt };

/** The number fields \`measure\` adds up; amounts are stored in cents. */
const NUMBERS: Record<string, AnyColumn> = { paymentTermDays: schema.businessProfiles.paymentTermDays };
const MONEY: string[] = [];

/** Computed number fields \`measure\` adds up from the records themselves. */
const COMPUTED: string[] = [];

/** The titles of the referenced records \`measureBy\` splits by, to name its groups. */
function titlesOf(_viewer: Viewer | null, _by: string, _ids: number[]): Map<unknown, string> {
  switch (_by) {
    default:
      return new Map();
  }
}

/** What \`measureBy\` may split by: choices, yes/no, references, and dates by month. */
const BY: string[] = [];


export const businessProfileData = {
  shownTo,
  /** The rows with each reference to a record the viewer may not read set to nothing: a related record's title is shown only to who may read it (only its id stays). */
  shownRefs<R extends Record<string, unknown>>(_viewer: Viewer | null, rows: R[]): R[] {
    return rows;
  },

  /** A condition for the business profiles the viewer may read. */
  readable(viewer: Viewer | null) {
    const scope = readScope(businessProfileAccess.read, viewer);
    if (scope === "all") return undefined;
    return scope === "own" && viewer ? eq(schema.businessProfiles.ownerId, viewer.id) : sql\`false\`;
  },

  canRead(viewer: Viewer | null, id: number): boolean {
    const found = db
      .select({ id: schema.businessProfiles.id })
      .from(schema.businessProfiles)
      .where(and(eq(schema.businessProfiles.id, id), businessProfileData.readable(viewer)))
      .get();
    return found !== undefined;
  },

  /** The business profiles the viewer may read; \`where\` narrows them, e.g. to a search. */
  async list(viewer: Viewer | null, where?: SQL) {
    if (readScope(businessProfileAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const found = businessProfileData.shownRefs(viewer, await db.query.businessProfiles.findMany({
      where: and(businessProfileData.readable(viewer), where),
      orderBy: (t, { desc }) => [desc(t.id)],
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return rows;
  },

  /**
   * The business profiles the viewer may read that fit \`where\` and \`search\`, in \`sort\`'s order (else newest
   * first), a page of them and how many there are: for the API and the assistants' tools.
   */
  async find(
    viewer: Viewer | null,
    options: { where?: unknown; search?: string; sort?: string; limit?: number; offset?: number } = {},
  ) {
    if (readScope(businessProfileAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = businessProfileData.fitting(viewer, options.where, options.search);
    const order = sortOf(SORTABLE, options.sort);
    const total = db.select({ n: count() }).from(schema.businessProfiles).where(condition).get()?.n ?? 0;
    const found = businessProfileData.shownRefs(viewer, await db.query.businessProfiles.findMany({
      where: condition,
      orderBy: (t, { desc }) => [...(order ? [order] : []), desc(t.id)],
      limit: options.limit ?? 100,
      offset: options.offset ?? 0,
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return { items: rows, total };
  },

  /**
   * A number from the business profiles the viewer may read that fit \`where\`: how many, or the sum,
   * average, smallest or largest of a number field.
   */
  async measure(
    viewer: Viewer | null,
    how: "count" | "sum" | "average" | "smallest" | "largest",
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<number | null> {
    if (readScope(businessProfileAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = businessProfileData.fitting(viewer, options.where, options.search);
    if (how === "count")
      return db.select({ n: count() }).from(schema.businessProfiles).where(condition).get()?.n ?? 0;
    const field = options.field ?? "";
    const money = MONEY.includes(field);
    if (COMPUTED.includes(field)) {
      const rows = await businessProfileData.computedRows(condition);
      const value = aggregate(rows.map((row) => row[field]), how);
      return value === null ? null : money ? value / 100 : value;
    }
    const column = Object.hasOwn(NUMBERS, field) ? NUMBERS[field] : undefined;
    if (!column)
      throw new BadInput(
        \`\${how} needs a number field: \${[...Object.keys(NUMBERS), ...COMPUTED].join(", ") || "there are none"}.\`,
      );
    const pick = { sum, average: avg, smallest: min, largest: max }[how];
    const value = db.select({ v: pick(column) }).from(schema.businessProfiles).where(condition).get()?.v;
    if (value === null || value === undefined) return null;
    return money ? Number(value) / 100 : Number(value);
  },

  /** Which record holds the smallest or largest value of a number field (the first of a tie). */
  async holder(
    viewer: Viewer | null,
    how: "smallest" | "largest",
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<{ id: number; title: string } | null> {
    const condition = businessProfileData.fitting(viewer, options.where, options.search);
    const field = options.field ?? "";
    if (COMPUTED.includes(field)) {
      let best: Record<string, unknown> | undefined;
      for (const row of await businessProfileData.computedRows(condition)) {
        const v = row[field];
        if (typeof v !== "number") continue;
        if (!best || (how === "largest" ? v > (best[field] as number) : v < (best[field] as number))) best = row;
      }
      return best ? { id: best.id as number, title: String(best.businessName) } : null;
    }
    const column = Object.hasOwn(NUMBERS, field) ? NUMBERS[field] : undefined;
    if (!column) return null;
    const row = db
      .select({ id: schema.businessProfiles.id, title: schema.businessProfiles.businessName })
      .from(schema.businessProfiles)
      .where(and(condition, isNotNull(column)))
      .orderBy(how === "largest" ? desc(column) : asc(column), asc(schema.businessProfiles.id))
      .limit(1)
      .get();
    return row ? { id: row.id, title: String(row.title) } : null;
  },

  /**
   * The same number per value of a field (a choice, yes/no, a reference) or per month of a date:
   * \`[{ value, number }]\`, the most first.
   */
  async measureBy(
    viewer: Viewer | null,
    how: "count" | "sum" | "average" | "smallest" | "largest",
    by: string,
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<{ value: unknown; title?: string; number: number | null }[]> {
    if (readScope(businessProfileAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const split = Object.hasOwn(FILTERABLE, by) ? FILTERABLE[by] : undefined;
    if (!split || split.kind === "text" || split.kind === "number" || split.kind === "money")
      throw new BadInput(\`There is no field "\${by}" to split by. Fields: \${BY.join(", ")}.\`);
    const field = options.field ?? "";
    const money = MONEY.includes(field);
    const condition = businessProfileData.fitting(viewer, options.where, options.search);
    const amount = (n: number | null) => (n === null ? null : money ? n / 100 : n);
    const most = (a: { number: number | null }, b: { number: number | null }) => (b.number ?? 0) - (a.number ?? 0);
    // A reference's groups carry the referenced record's title beside its id.
    const named = (rows: { value: unknown; number: number | null }[]) => {
      if (split.kind !== "reference") return rows;
      const titles = titlesOf(viewer, by, rows.map((r) => r.value).filter((v): v is number => typeof v === "number"));
      return rows.map((r) => (titles.has(r.value) ? { value: r.value, title: titles.get(r.value), number: r.number } : r));
    };
    if (COMPUTED.includes(field)) {
      // Each record's month or value, then the computed numbers added up per group.
      const groups = new Map<unknown, unknown[]>();
      for (const row of await businessProfileData.computedRows(condition)) {
        const raw = row[split.kind === "reference" ? \`\${by}Id\` : by];
        const value = split.kind === "date" ? String(raw ?? "").slice(0, 7) || null : split.kind === "instant" ? (raw instanceof Date ? raw.toISOString().slice(0, 7) : null) : raw;
        groups.set(value, [...(groups.get(value) ?? []), row[field]]);
      }
      return named([...groups].map(([value, numbers]) => ({ value, number: amount(aggregate(numbers, how)) })).sort(most));
    }
    const key = split.kind === "date" ? sql<string>\`substr(\${split.column}, 1, 7)\` : split.kind === "instant" ? sql<string>\`strftime('%Y-%m', \${split.column} / 1000, 'unixepoch')\` : sql\`\${split.column}\`;
    const column = Object.hasOwn(NUMBERS, field) ? NUMBERS[field] : undefined;
    if (how !== "count" && !column)
      throw new BadInput(\`\${how} needs a number field: \${[...Object.keys(NUMBERS), ...COMPUTED].join(", ") || "there are none"}.\`);
    const pick = how === "count" || !column ? count() : { sum, average: avg, smallest: min, largest: max }[how](column);
    return named(
      db
        .select({ value: key, number: pick })
        .from(schema.businessProfiles)
        .where(condition)
        .groupBy(key)
        .all()
        .map((r) => ({ value: r.value, number: r.number === null ? null : amount(Number(r.number)) }))
        .sort(most),
    );
  },

  /**
   * The records that fit, with their computed fields worked out: for adding those up. At most
   * 10,000, so one call never reads a whole large table; more are refused with how to narrow them.
   */
  async computedRows(condition: SQL | undefined): Promise<Record<string, unknown>[]> {
    const rows = await db.query.businessProfiles.findMany({ where: condition, limit: 10001 });
    if (rows.length > 10000)
      throw new BadInput("More than 10,000 records to add up a computed field over: narrow them with where.");
    return rows.map((row) => row as Record<string, unknown>);
  },

  /** The business profiles the viewer may read whose businessName has the text: a few, for naming one. */
  named(viewer: Viewer | null, text: string): { id: number; title: string }[] {
    return db
      .select({ id: schema.businessProfiles.id, title: schema.businessProfiles.businessName })
      .from(schema.businessProfiles)
      .where(and(businessProfileData.readable(viewer), contains([schema.businessProfiles.businessName], text)))
      .limit(6)
      .all()
      .map((row) => ({ id: row.id, title: String(row.title) }));
  },

  /** Every businessName the viewer may read (at most 2,000): the nearest when a name fits none. */
  titles(viewer: Viewer | null): string[] {
    return db
      .select({ title: schema.businessProfiles.businessName })
      .from(schema.businessProfiles)
      .where(businessProfileData.readable(viewer))
      .limit(2000)
      .all()
      .map((row) => String(row.title));
  },

  /** Why \`where\` found none when it names a text no record has: the field's nearest values. */
  whyNone(viewer: Viewer | null, where: unknown): string | undefined {
    if (!where || typeof where !== "object") return undefined;
    for (const [name, v] of Object.entries(where)) {
      const field = Object.hasOwn(FILTERABLE, name) ? FILTERABLE[name] : undefined;
      if (field?.kind !== "text" || (typeof v !== "string" && typeof v !== "number")) continue;
      const values = db
        .selectDistinct({ v: sql<string>\`\${field.column}\` })
        .from(schema.businessProfiles)
        .where(and(businessProfileData.readable(viewer), isNotNull(field.column)))
        .limit(2000)
        .all()
        .map((row) => String(row.v));
      const asked = String(v);
      if (values.length && !values.some((x) => x.toLowerCase().includes(asked.toLowerCase())))
        return \`No business profile has "\${asked}" in \${name}; the nearest: \${nearest(asked, values).join(", ")}.\`;
    }
    return undefined;
  },

  /** The condition for records the viewer may read that fit \`where\` and \`search\`. */
  fitting(viewer: Viewer | null, where?: unknown, search?: string) {
    return and(
      businessProfileData.readable(viewer),
      whereOf(FILTERABLE, where, viewer ? eq(schema.businessProfiles.ownerId, viewer.id) : undefined, viewer?.id, {}),
      // Every word somewhere in the texts ("ship lamp" finds "ship's lamp").
      ...wordsOf(search).map((word) => contains([schema.businessProfiles.businessName, schema.businessProfiles.vatNumber, schema.businessProfiles.iban, schema.businessProfiles.invoiceFooter], word)),
    );
