exports[`../../../examples/api/smithable.yml > file list and generated code > src/lib/auth.ts 1`] = `
"// Generated by Smithable from smithable.auth.yml. Do not edit: this file is overwritten on every change.
import { betterAuth } from "better-auth";
import { drizzleAdapter } from "better-auth/adapters/drizzle";
import { APIError } from "better-auth/api";
import { emailOTP } from "better-auth/plugins";
import { tanstackStartCookies } from "better-auth/tanstack-start";
import { eq } from "drizzle-orm";
import { db } from "#/db";
import { account, invitation, session, user, verification } from "#/db/schema";
import { ADDRESS_HEADER } from "#/kit/address.server";
import { audit } from "#/kit/audit.server";
import { codeAllowed } from "#/kit/limit";
import { log } from "#/kit/log.server";
import { mailConfigured, sendMail } from "#/kit/mail";
import { w } from "#/kit/words";

/** Sign-in providers in button order; each needs its keys in the environment (see the README). */
export const PROVIDERS = ["email"];

/** Who a session is for, as the audit log names them. */
function signedInAs(userId: string) {
  return db.select({ id: user.id, role: user.role }).from(user).where(eq(user.id, userId)).get() ?? null;
}
/** These addresses become admins when they first sign in. */
const ADMINS: string[] = ["admin@team-tasks.example"];
const APP_NAME = "Team Tasks";

const socialProviders = {

};

/** The providers whose keys are set (email needs none: its codes go out by mail). */
export const configuredProviders = () => PROVIDERS.filter((p) => p === "email" || p in socialProviders);

/** Whether sign-in codes can leave the machine: mail settings, or development's outbox. */
export const codesReachPeople = () => import.meta.env.DEV || mailConfigured();
/** A mail stays in the outbox (the preview, or an app without mail settings): pages say so. */
export const mailKept = () => !mailConfigured();

/** The invitation for an address, if there is one (it may have expired). */
function invitationOf(email: string) {
  return db.select().from(invitation).where(eq(invitation.email, email)).get();
}

/** The invitation for an address that is still open. */
function openInvitation(email: string) {
  const invited = invitationOf(email);
  return invited && invited.expiresAt.getTime() > Date.now() ? invited : undefined;
}

/** Why an address may not have an account here, or nothing when it may. */
function joinRefusal(email: string): string | undefined {
  // The admins may always sign in, whatever the domains or the invitations say.
  if (ADMINS.includes(email)) return undefined;
  const invited = invitationOf(email);
  if (
    !(invited && invited.expiresAt.getTime() > Date.now()) &&
    !ADMINS.includes(email) &&
    !(import.meta.env.DEV && email.startsWith("dev-")) &&
    !(demoSignIn && email.startsWith("demo-"))
  )
    return invited
      ? "Your invitation has expired. Ask an administrator for a new one."
      : \`Only invited people can sign in to \${APP_NAME}. Ask an administrator for an invitation.\`;
  return undefined;
}


/**
 * A demo (DEMO_SIGN_IN=1 in the environment): the sign-in page offers every role without a
 * provider, as development does, and the data is reset by whoever runs the demo. Never set it
 * on a real app.
 */
export const demoSignIn = process.env.DEMO_SIGN_IN === "1";

const NO_TOKENS = {
  accessToken: null,
  refreshToken: null,
  idToken: null,
  accessTokenExpiresAt: null,
  refreshTokenExpiresAt: null,
};

// Production needs both: without a secret sessions could be forged, without the address
// sign-in breaks. Better to refuse to start than to run like that.
if (!import.meta.env.DEV && (!process.env.BETTER_AUTH_SECRET || !process.env.BETTER_AUTH_URL))
  throw new Error("Set BETTER_AUTH_SECRET and BETTER_AUTH_URL: in production the app does not start without them.");

/** The app is served over https: its cookies can take the __Host- prefix, which needs Secure. */
const hostCookies = (process.env.BETTER_AUTH_URL ?? "").startsWith("https://");

export const auth = betterAuth({
  // In development the app runs on port 3000 (pnpm dev); set BETTER_AUTH_URL in production.
  baseURL: process.env.BETTER_AUTH_URL ?? (import.meta.env.DEV ? "http://localhost:3000" : undefined),
  // In development the app may run on any local port (the preview, the tests).
  ...(import.meta.env.DEV ? { trustedOrigins: ["http://localhost:*", "http://127.0.0.1:*"] } : {}),
  database: drizzleAdapter(db, { provider: "sqlite", schema: { account, session, user, verification } }),
  socialProviders,
  // Its limits count per address from the one header the auth route sets (src/kit/address.server.ts),
  // never from an X-Forwarded-For the visitor could make up.
  // Over https the cookies are named so only this app's own address can set them (__Host-: Secure,
  // Path=/, no Domain), not a sibling app on the same domain.
  advanced: {
    ipAddress: { ipAddressHeaders: [ADDRESS_HEADER] },
    ...(hostCookies
      ? {
          useSecureCookies: false,
          // Every other cookie it makes stays Secure too (a sign-in's state).
          defaultCookieAttributes: { secure: true },
          cookies: Object.fromEntries(
            ["session_token", "session_data", "dont_remember", "state"].map((name) => [
              name,
              { name: \`__Host-better-auth.\${name}\`, attributes: { secure: true } },
            ]),
          ),
        }
      : {}),
  },
  // On in every production build, not only where NODE_ENV says so (Better Auth's default).
  rateLimit: { enabled: !import.meta.env.DEV },
  // Email and password only serve the development sign-in; production builds leave it off.
  emailAndPassword: { enabled: import.meta.env.DEV || demoSignIn },
  user: {
    additionalFields: {
      role: { type: "string", required: true, defaultValue: "member", input: false },
    },
  },
  databaseHooks: {
    user: {
      create: {
        before: async (newUser) => {
          const email = newUser.email.toLowerCase();
          const refused = joinRefusal(email);
          if (refused) {
            audit(db, null, { action: "sign-in refused", model: "User", details: { email, reason: refused } });
            throw new APIError("FORBIDDEN", { message: refused });
          }
          return { data: { ...newUser, role: ADMINS.includes(email) ? "admin" : openInvitation(email)?.role ?? "member" } };
        },
        after: async (created) => {
          const who = { id: created.id, role: String(created.role) };
          const email = created.email.toLowerCase();
          // Only an invitation still open was accepted (under open sign-up an expired one is not).
          const used = openInvitation(email);
          if (used)
            audit(db, who, { action: "invitation accepted", model: "User", details: { role: used.role } });
          // The invitation is used up: the user is the record from now on.
          db.delete(invitation).where(eq(invitation.email, email)).run();
          audit(db, who, { action: "account created", model: "User", details: { role: who.role } });
        },
      },
    },
    // Signing in and out are in the audit log, as the person who did it.
    session: {
      create: {
        after: async (session) => audit(db, signedInAs(session.userId), { action: "signed in" }),
      },
      // A session also ends when it expires or its user is removed: only a sign-out says so.
      delete: {
        after: async (session, ctx) => {
          if (ctx?.path === "/sign-out") audit(db, signedInAs(session.userId), { action: "signed out" });
        },
      },
    },
    // The app only signs people in with a provider and never calls it afterwards, so the
    // provider's tokens are not kept: not in the database, its backups or its exports.
    account: {
      create: { before: async (account) => ({ data: { ...account, ...NO_TOKENS } }) },
      update: { before: async (account) => ({ data: { ...account, ...NO_TOKENS } }) },
    },
  },
  plugins: [
    // Sign-in by a six-digit code by mail: good for ten minutes, five tries, stored hashed.
    emailOTP({
      otpLength: 6,
      expiresIn: 600,
      allowedAttempts: 5,
      storeOTP: "hashed",
      async sendVerificationOTP({ email, otp, type }, ctx) {
        // Without mail settings a production app keeps no codes: nobody would get them.
        if (type !== "sign-in" || !codesReachPeople()) return;
        const address = email.toLowerCase();
        // Too many codes for the address (or from the network address): no mail. The plugin sends
        // in the background, so the page's answer is the same either way.
        try {
          codeAllowed(address, ctx?.request?.headers ?? new Headers());
        } catch {
          return;
        }
        // Who may not join gets no mail, and the page says the same either way.
        const known = db.select({ id: user.id }).from(user).where(eq(user.email, address)).get();
        if (!known && joinRefusal(address)) return;
        // Not awaited, so the answer takes as long whether or not a mail goes out.
        void sendMail({
          to: address,
          subject: w.codeSubject(APP_NAME),
          text: w.codeText(APP_NAME, \`\${otp.slice(0, 3)} \${otp.slice(3)}\`),
        }).catch((error) => log.error("A sign-in code could not be sent", { error }));
      },
    }),
    tanstackStartCookies(),
  ],
});
"
`;

exports[`../../../examples/api/smithable.yml > file list and generated code > src/lib/viewer.server.ts 1`] = `
"// Generated by Smithable from smithable.auth.yml. Do not edit: this file is overwritten on every change.
import { getRequestHeaders } from "@tanstack/react-start/server";
import type { Viewer } from "#/kit/access";
import { traceWho } from "#/kit/trace.server";
import { auth } from "#/lib/auth";

/** The signed-in user of the current request, or null; the access line names them. */
export async function currentViewer(): Promise<Viewer | null> {
  const session = await auth.api.getSession({ headers: getRequestHeaders() });
  if (!session) return null;
  const { id, name, email, role } = session.user;
  traceWho(id, role);
  return { id, name, email, role };
}
"
`;

exports[`../../../examples/api/smithable.yml > file list and generated code > src/routes/__root.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createRootRoute, HeadContent, Scripts, useRouter, useRouterState } from "@tanstack/react-router";
import { createServerFn } from "@tanstack/react-start";
import { useEffect, useState } from "react";
import { History, Layers, Users } from "lucide-react";
import { app } from "#/generated/app";
import { pageAccess } from "#/generated/pages";
import { currentViewer } from "#/lib/viewer.server";
import { AppShell, ErrorNotice, type MenuUi } from "#/kit/AppShell";
import { Ask } from "#/kit/Ask";
import { field } from "#/kit/params";
import { ask, asks } from "#/generated/ask.server";
import { Consent } from "#/kit/Consent";
import { pageHeaders } from "#/kit/security";
import { w } from "#/kit/words";
import { authClient } from "#/lib/auth-client";
import appCss from "#/styles.css?url";

const menus: MenuUi[] = [
  {
    name: "main",
    items: [
      {
        to: "/admin",
        label: "Admin",
        icon: Layers,
        access: pageAccess["admin"],
      },
    ],
  },
  {
    name: "admin",
    label: w.admin,
    items: [
      {
        to: "/team",
        label: "Team",
        icon: Users,
        access: pageAccess["team"],
      },
      {
        to: "/team/activity",
        label: w.activity,
        icon: History,
        access: pageAccess["team"],
      },
    ],
  },
];

/** Each page's route and name, longest route first. */
const pageRoutes: [string, string][] = [["/admin", "admin"], ["/team", "team"]];

/** The page a path is on, e.g. "customers" for /customers/12 (see data-page, src/custom/styles.css). */
function pageOf(path: string): string | undefined {
  return pageRoutes.find(([route]) => path === route || path.startsWith(route === "/" ? "/" : \`\${route}/\`))?.[1];
}


// Who is signed in, and, when a hosting service runs a copy of the app's data from an earlier
// time to look at (DATA_AS_OF), that time.
const getViewer = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return {
    viewer,
    asOf: process.env.DATA_AS_OF,
    demo: process.env.DEMO_SIGN_IN === "1",
    asks: asks(viewer),
  };
});

/** A question to "Ask", answered as the person signed in (or a visitor), with what they may read. */
const askApp = createServerFn({ method: "POST" })
  .validator((data: unknown) => ({ question: field(data, "question", 500) }))
  .handler(async ({ data }) => ask(await currentViewer(), data.question));

export const Route = createRootRoute({
  // Every page knows who is signed in; pages check their access with it.
  beforeLoad: () => getViewer(),
  headers: ({ ssr }) => pageHeaders(ssr?.nonce),
  head: () => ({
    meta: [
      { charSet: "utf-8" },
      { name: "viewport", content: "width=device-width, initial-scale=1" },
      { title: app.name },
    ],
    links: [
      { rel: "stylesheet", href: appCss },
      { rel: "icon", href: "/favicon.svg", type: "image/svg+xml" },
    ],
  }),
  shellComponent: RootDocument,
  errorComponent: ({ error }) => (
    <ErrorNotice title={w.errorTitle} message={error instanceof Error ? error.message : undefined} />
  ),
  notFoundComponent: () => (
    <ErrorNotice title={w.notFound} message={w.notFoundNote} />
  ),
});

function RootDocument({ children }: { children: React.ReactNode }) {
  const { viewer, asOf, demo, asks } = Route.useRouteContext();
  const pathname = useRouterState({ select: (state) => state.location.pathname });
  // Set once React has taken over the page in the browser, for tests that must not type or
  // click before the page's handlers are attached (body[data-hydrated]).
  const [hydrated, setHydrated] = useState(false);
  useEffect(() => setHydrated(true), []);
  const router = useRouter();
  const signOut = async () => {
    await authClient.signOut();
    await router.invalidate();
  };
  const rename = async (name: string) => {
    const { error } = await authClient.updateUser({ name });
    if (error) throw new Error(error.message);
    await router.invalidate();
  };
  return (
    <html lang="en">
      <head>
        <HeadContent />
      </head>
      <body data-page={pageOf(pathname)} data-hydrated={hydrated ? "true" : undefined}>
        {asOf && (
          <p role="status" className="bg-warning px-4 py-2 text-center text-sm text-warning-foreground">
            A copy of this app's data as of {asOf.slice(0, 16).replace("T", " ")} UTC: changes made here are not kept.
          </p>
        )}
        {demo && (
          <p role="status" className="bg-warning px-4 py-2 text-center text-sm text-warning-foreground">
            This is a demo: sign in as anyone and try things; the data is reset every hour.
          </p>
        )}
        <AppShell appName={app.name} menus={menus} viewer={viewer} onSignOut={signOut} onRename={rename}>
          {children}
        </AppShell>
        {asks && <Ask ask={(question) => askApp({ data: { question } })} />}
        <Consent />
        <Scripts />
      </body>
    </html>
  );
}
"
`;

exports[`../../../examples/api/smithable.yml > file list and generated code > src/routes/admin/activity.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, useNavigate, useRouter } from "@tanstack/react-router";
import { createServerFn } from "@tanstack/react-start";
import { and, desc, eq, gte, inArray, lt } from "drizzle-orm";
import { z } from "zod";
import { db } from "#/db";
import { apiKey, auditLog, user } from "#/db/schema";
import * as schema from "#/db/schema";
import { app } from "#/generated/app";
import { pageAccess } from "#/generated/pages";
import { AccessDenied, guardPage } from "#/kit/access";
import { ActivityLog } from "#/kit/ActivityLog";
import { PageHeader } from "#/kit/AppShell";
import { forgetInLog } from "#/kit/audit.server";
import { count, optional, type Search, text } from "#/kit/params";
import { w } from "#/kit/words";
import { currentViewer } from "#/lib/viewer.server";

/** The activity's filters, from the address. */
const filters = (s: Search) => optional({
  who: text(s.who),
  model: text(s.model),
  record: count(s.record),
  action: text(s.action),
  from: text(s.from),
  to: text(s.to),
});

/** Each model's label, for the filter and the lines. */
const LABELS: Record<string, string> = { Project: "Project", Task: "Task", Note: "Note" };

/** The newest lines that match, named for people (administrators only). */
const getActivity = createServerFn()
  .validator(filters)
  .handler(async ({ data }) => {
    const viewer = await currentViewer();
    if (viewer?.role !== "admin") throw new AccessDenied(viewer !== null);
    const day = 24 * 60 * 60 * 1000;
    const rows = db
      .select()
      .from(auditLog)
      .where(
        and(
          data.who ? eq(auditLog.who, data.who) : undefined,
          data.model ? eq(auditLog.model, data.model) : undefined,
          data.record ? eq(auditLog.recordId, data.record) : undefined,
          data.action ? eq(auditLog.action, data.action) : undefined,
          data.from ? gte(auditLog.at, new Date(data.from)) : undefined,
          data.to ? lt(auditLog.at, new Date(new Date(data.to).getTime() + day)) : undefined,
        ),
      )
      .orderBy(desc(auditLog.id))
      .limit(200)
      .all();
    const people = db.select({ id: user.id, name: user.name }).from(user).orderBy(user.name).all();
    const named = new Map(people.map((p) => [p.id, p.name]));
    // A record by its title now; a deleted one keeps the title its delete line has, or its id.
    const ids = (model: string) => [
      ...new Set(rows.filter((r) => r.model === model && r.recordId != null).map((r) => r.recordId as number)),
    ];
    const titles = new Map<string, Map<number, string>>([
      [
        "Project",
        new Map(
          db
            .select({ id: schema.projects.id, title: schema.projects.name })
            .from(schema.projects)
            .where(inArray(schema.projects.id, ids("Project")))
            .all()
            .map((r) => [r.id, String(r.title ?? r.id)]),
        ),
      ],
      [
        "Task",
        new Map(
          db
            .select({ id: schema.tasks.id, title: schema.tasks.title })
            .from(schema.tasks)
            .where(inArray(schema.tasks.id, ids("Task")))
            .all()
            .map((r) => [r.id, String(r.title ?? r.id)]),
        ),
      ],
      [
        "Note",
        new Map(
          db
            .select({ id: schema.notes.id, title: schema.notes.title })
            .from(schema.notes)
            .where(inArray(schema.notes.id, ids("Note")))
            .all()
            .map((r) => [r.id, String(r.title ?? r.id)]),
        ),
      ],
    ]);
    // A key's lines name the key ("key:3" is the key made as "Uptime monitor").
    for (const k of db.select({ id: apiKey.id, name: apiKey.name }).from(apiKey).all())
      named.set(\`key:\${k.id}\`, w.keyNamed(k.name));
    // A key's line once keys are gone from the app (the API turned off) still says it was a key.
    const removedUser = (id: string) =>
      named.get(id) ?? (id.startsWith("key:") ? w.aKey(id.slice(4)) : w.aRemovedUser(id));
    const lines = rows.map((r) => {
      const label = r.model ? LABELS[r.model] : undefined;
      const now = r.model && r.recordId != null ? titles.get(r.model)?.get(r.recordId) : undefined;
      const gone = label && r.recordId != null && now === undefined;
      const removed = r.action === "user removed" ? String(r.details?.user ?? "") : "";
      return {
        id: r.id,
        at: r.at,
        who: r.who === "visitor" || r.who === "the app" ? r.who : (removedUser(r.who) ?? r.who),
        action: r.action,
        record: now
          ? \`\${label} "\${now}"\`
          : gone
            ? r.title
              ? w.deletedNamed(label ?? "", r.title)
              : w.aDeletedOne(label ?? "", String(r.recordId))
            : undefined,
        fields: r.fields,
        // As text: what touches security, by name and value.
        details: r.details ? Object.fromEntries(Object.entries(r.details).map(([k, v]) => [k, String(v)])) : null,
        forget:
          gone && r.action === "deleted" && r.model
            ? { model: r.model, record: r.recordId as number }
            : removed && !named.has(removed)
              ? { user: removed }
              : undefined,
      };
    });
    const actions = db.selectDistinct({ action: auditLog.action }).from(auditLog).all().map((a) => a.action).sort();
    return { lines, people, actions };
  });

const forget = createServerFn({ method: "POST" })
  .validator(z.union([z.object({ model: z.string(), record: z.number().int() }), z.object({ user: z.string() })]))
  .handler(async ({ data }) => forgetInLog(await currentViewer(), data));

export const Route = createFileRoute("/admin/activity")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["admin"], context.viewer, location.href),
  validateSearch: filters,
  loaderDeps: ({ search }) => search,
  loader: ({ deps }) => getActivity({ data: deps }),
  component: ActivityPage,
});

function ActivityPage() {
  const { lines, people, actions } = Route.useLoaderData();
  const search = Route.useSearch();
  const navigate = useNavigate();
  const router = useRouter();
  return (
    <>
      <PageHeader page="admin" title={w.activity} subtitle={w.activityLead} />
      <ActivityLog
        lines={lines}
        filters={search}
        people={people}
        models={Object.entries(LABELS).map(([name, label]) => ({ name, label }))}
        actions={actions}
        app={app}
        onFilter={(next) => navigate({ to: "/admin/activity", search: next, replace: true, resetScroll: false })}
        onForget={async (target) => {
          await forget({ data: target });
          await router.invalidate();
        }}
      />
    </>
  );
}
"
`;

exports[`../../../examples/api/smithable.yml > file list and generated code > src/routes/admin/ask.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute } from "@tanstack/react-router";
import { createServerFn } from "@tanstack/react-start";
import { z } from "zod";
import { callTool, offerFor } from "#/generated/mcp.server";
import { pageAccess } from "#/generated/pages";
import { AccessDenied, guardPage, type Viewer } from "#/kit/access";
import { PageHeader } from "#/kit/AppShell";
import type { AskKind } from "#/kit/ask";
import { answer, hostModel } from "#/kit/assistant.server";
import { Inspector } from "#/kit/Inspector";
import { w } from "#/kit/words";
import { currentViewer } from "#/lib/viewer.server";

/** Each caller's kinds of record in the words people use, for the wording rules. */
const KINDS: Record<string, AskKind[]> = {"admin":[{"model":"Project","label":"Project","pluralLabel":"Projects","fields":[{"name":"name","label":"Name"},{"name":"description","label":"Description"}],"filters":[{"field":"name","by":"text"}],"numbers":[],"by":[]},{"model":"Task","label":"Task","pluralLabel":"Tasks","fields":[{"name":"title","label":"Title"},{"name":"project","label":"Project"},{"name":"status","label":"Status"},{"name":"dueDate","label":"Due date"},{"name":"assignee","label":"Assignee"},{"name":"details","label":"Details"}],"filters":[{"field":"title","by":"text"},{"field":"project","by":"reference","model":"Project"},{"field":"status","by":"value","values":["todo","doing","done"]},{"field":"dueDate","by":"date"},{"field":"assignee","by":"reference","model":"User"}],"numbers":[],"by":["project","status","dueDate","assignee"]},{"model":"Note","label":"Note","pluralLabel":"Notes","fields":[{"name":"title","label":"Title"},{"name":"project","label":"Project"},{"name":"body","label":"Body"},{"name":"attachment","label":"Attachment"}],"filters":[{"field":"title","by":"text"},{"field":"project","by":"reference","model":"Project"}],"numbers":[],"by":["project"]}],"member":[{"model":"Project","label":"Project","pluralLabel":"Projects","fields":[{"name":"name","label":"Name"},{"name":"description","label":"Description"}],"filters":[{"field":"name","by":"text"}],"numbers":[],"by":[]},{"model":"Task","label":"Task","pluralLabel":"Tasks","fields":[{"name":"title","label":"Title"},{"name":"project","label":"Project"},{"name":"status","label":"Status"},{"name":"dueDate","label":"Due date"},{"name":"assignee","label":"Assignee"},{"name":"details","label":"Details"}],"filters":[{"field":"title","by":"text"},{"field":"project","by":"reference","model":"Project"},{"field":"status","by":"value","values":["todo","doing","done"]},{"field":"dueDate","by":"date"},{"field":"assignee","by":"reference","model":"User"}],"numbers":[],"by":["project","status","dueDate","assignee"]},{"model":"Note","label":"Note","pluralLabel":"Notes","fields":[{"name":"title","label":"Title"},{"name":"project","label":"Project"},{"name":"body","label":"Body"},{"name":"attachment","label":"Attachment"}],"filters":[{"field":"title","by":"text"},{"field":"project","by":"reference","model":"Project"}],"numbers":[],"by":["project"]}],"assistant":[{"model":"Project","label":"Project","pluralLabel":"Projects","fields":[{"name":"name","label":"Name"},{"name":"description","label":"Description"}],"filters":[{"field":"name","by":"text"}],"numbers":[],"by":[]},{"model":"Task","label":"Task","pluralLabel":"Tasks","fields":[{"name":"title","label":"Title"},{"name":"project","label":"Project"},{"name":"status","label":"Status"},{"name":"dueDate","label":"Due date"},{"name":"assignee","label":"Assignee"},{"name":"details","label":"Details"}],"filters":[{"field":"title","by":"text"},{"field":"project","by":"reference","model":"Project"},{"field":"status","by":"value","values":["todo","doing","done"]},{"field":"dueDate","by":"date"},{"field":"assignee","by":"reference","model":"User"}],"numbers":[],"by":["project","status","dueDate","assignee"]},{"model":"Note","label":"Note","pluralLabel":"Notes","fields":[{"name":"title","label":"Title"},{"name":"project","label":"Project"},{"name":"body","label":"Body"},{"name":"attachment","label":"Attachment"}],"filters":[{"field":"title","by":"text"},{"field":"project","by":"reference","model":"Project"}],"numbers":[],"by":["project"]}],"visitor":[]};

const ROLES = [
  { value: "admin", label: "Admin" },
  { value: "member", label: "Member" },
  { value: "assistant", label: "Assistant" },
  { value: "visitor", label: "A visitor, without a key" },
];

/** A question answered as the role chosen, as its key would be (administrators only). */
const askAs = createServerFn({ method: "POST" })
  .validator(z.object({ question: z.string().trim().min(1).max(500), role: z.string() }))
  .handler(async ({ data }) => {
    const me = await currentViewer();
    if (me?.role !== "admin") throw new AccessDenied(me !== null);
    if (!Object.hasOwn(KINDS, data.role)) throw new AccessDenied(true);
    // As a key of that role would be (a key's id): it owns nothing, so "mine" is nobody's.
    const viewer: Viewer | null =
      data.role === "visitor" ? null : { id: \`key:inspector:\${me.id}\`, name: me.name, email: "", role: data.role };
    return answer(data.question, {
      offer: offerFor(viewer),
      kinds: KINDS[data.role],
      call: (tool, args) => callTool(viewer, tool, args),
      model: hostModel(me.id),
    });
  });

/** The page is the administrator's alone, whoever else may open the data page. */
const adminOnly = createServerFn().handler(async () => {
  const me = await currentViewer();
  if (me?.role !== "admin") throw new AccessDenied(me !== null);
  return null;
});

export const Route = createFileRoute("/admin/ask")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["admin"], context.viewer, location.href),
  loader: () => adminOnly(),
  component: AskPage,
});

function AskPage() {
  return (
    <>
      <PageHeader page="admin" title={w.askTheApp} />
      <p className="mb-4 max-w-prose text-sm text-muted-foreground">
        What an assistant gets with a key of each role: ask as that role, and see the answer and every
        tool it took. Changes are only shown, never made here.
      </p>
      <Inspector roles={ROLES} ask={(question, role) => askAs({ data: { question, role } })} />
    </>
  );
}
"
`;

exports[`../../../examples/api/smithable.yml > file list and generated code > src/routes/admin/index.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, Link } from "@tanstack/react-router";
import { createServerFn } from "@tanstack/react-start";
import { pageAccess } from "#/generated/pages";
import { projectData } from "#/generated/project.server";
import { taskData } from "#/generated/task.server";
import { noteData } from "#/generated/note.server";
import { guardPage } from "#/kit/access";
import { PageHeader } from "#/kit/AppShell";
import { w } from "#/kit/words";
import { currentViewer } from "#/lib/viewer.server";

/**
 * How many records of each model the viewer may read (null where they may read none), and,
 * when a hosting service runs the app, its page for restoring data to an earlier time.
 */
const getCounts = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return {
    counts: {
      "projects": projectData.count(viewer),
      "tasks": taskData.count(viewer),
      "notes": noteData.count(viewer),
    },
    restore: process.env.HOST_PAGE_URL ? \`\${process.env.HOST_PAGE_URL}/data\` : undefined,
    admin: viewer?.role === "admin",
  };
});

const MODELS = [
  { key: "projects", label: "Projects", to: "/admin/projects" },
  { key: "tasks", label: "Tasks", to: "/admin/tasks" },
  { key: "notes", label: "Notes", to: "/admin/notes" },
] as const;

export const Route = createFileRoute("/admin/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["admin"], context.viewer, location.href),
  head: () => ({ meta: [{"title":"Admin · Team Tasks"}] }),
  loader: () => getCounts(),
  component: AdminPage,
});

function AdminPage() {
  const { counts, restore, admin } = Route.useLoaderData();
  return (
    <>
      <PageHeader
        page="admin"
        title="Admin"
        actions={
          <>
            <Link to="/admin/activity" className="text-sm font-medium text-primary">{w.activity}</Link>
            {admin && <Link to="/admin/ask" className="text-sm font-medium text-primary">{w.ask}</Link>}
            {restore && <a href={restore} className="text-sm font-medium text-primary">{w.restoreData}</a>}
          </>
        }
      />
      <ul className="divide-y divide-border rounded-lg border border-border bg-card">
        {MODELS.filter((m) => counts[m.key] !== null).map((m) => (
          <li key={m.key}>
            <Link to={m.to} className="flex items-center justify-between gap-4 px-4 py-3 hover:bg-muted">
              <span className="font-medium">{m.label}</span>
              <span className="text-muted-foreground tabular-nums">{counts[m.key]}</span>
            </Link>
          </li>
        ))}
      </ul>
    </>
  );
}
"
`;

exports[`../../../examples/api/smithable.yml > file list and generated code > src/routes/admin/notes/$id.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, notFound, useNavigate } from "@tanstack/react-router";
import { app } from "#/generated/app";
import { pageAccess } from "#/generated/pages";
import { deleteNote, getNote, noteUi, updateNote } from "#/generated/note";
import { noteSchema } from "#/generated/note.schema";
import { projectOptions } from "#/generated/project";
import { guardPage } from "#/kit/access";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";
import { w } from "#/kit/words";

export const Route = createFileRoute("/admin/notes/$id")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["admin"], context.viewer, location.href),
  head: () => ({ meta: [{"title":"Admin · Team Tasks"}] }),
  loader: async ({ params }) => {
    const found = await getNote({ data: Number(params.id) });
    if (!found) throw notFound();
    return { ...found, options: { projectId: await projectOptions() } };
  },
  component: NotePage,
});

function NotePage() {
  const { row, canWrite, canDelete, options } = Route.useLoaderData();
  const navigate = useNavigate();
  const back = () => navigate({ to: "/admin/notes" });
  return (
    <>
      <PageHeader title={row.title || \`Note #\${row.id}\`} />
      <ModelForm
        key={String(row.updatedAt)}
        ui={noteUi}
        app={app}
        schema={noteSchema}
        initial={row}
        readOnly={!canWrite}
        options={options}
        submitLabel={w.saveChanges}
        onSubmit={async (values) => {
          await updateNote({ data: { id: row.id, values } });
          await back();
        }}
        onCancel={back}
        onDelete={
          canDelete
            ? async (together?: boolean) => {
                await deleteNote({ data: { id: row.id, together } });
                await back();
              }
            : undefined
        }
      />

    </>
  );
}
"
`;

exports[`../../../examples/api/smithable.yml > file list and generated code > src/routes/admin/notes/index.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, Link, useNavigate } from "@tanstack/react-router";
import { pageAccess } from "#/generated/pages";
import { guardPage, allows } from "#/kit/access";
import { createServerFn } from "@tanstack/react-start";
import * as schema from "#/db/schema";
import { noteAccess, noteData } from "#/generated/note.server";
import { contains } from "#/kit/search";
import { currentViewer } from "#/lib/viewer.server";
import { type Search, listQuery, optional, text } from "#/kit/params";
import { buttonVariants } from "#/components/ui/button";
import { app } from "#/generated/app";
import { noteUi } from "#/generated/note";
import { w } from "#/kit/words";
import { PageHeader } from "#/kit/AppShell";
import { ModelTable } from "#/kit/ModelTable";
import { SearchBox } from "#/kit/SearchBox";

/** The notes matching the search, among those the viewer may read. */
const searchNotes = createServerFn()
  .validator(listQuery)
  .handler(async ({ data }) => {
    const viewer = await currentViewer();
    const where = data.q ? contains([schema.notes.title, schema.notes.body], data.q) : undefined;
    const rows = await noteData.list(viewer, where, 501);
    return {
      rows: rows.slice(0, 500),
      more: rows.length > 500,
      canCreate: allows(noteAccess.create, viewer),
    };
  });

export const Route = createFileRoute("/admin/notes/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["admin"], context.viewer, location.href),
  head: () => ({ meta: [{"title":"Admin · Team Tasks"}] }),
  validateSearch: (s: Search) => optional({ q: text(s.q) }),
  loaderDeps: ({ search }) => ({ q: search.q }),
  loader: ({ deps }) => searchNotes({ data: { q: deps.q } }),  component: AdminNotesPage,
});

function AdminNotesPage() {
  const { rows, canCreate, more } = Route.useLoaderData();
  const { q } = Route.useSearch();
  const navigate = useNavigate();
  const newButton = canCreate && (
    <Link to="/admin/notes/new" className={buttonVariants()}>
      {w.newOne("note")}
    </Link>
  );
  return (
    <>
      <PageHeader
        title="Notes"
        actions={newButton}
      />
      <SearchBox
        value={q ?? ""}
        placeholder="Search by title or body"
        onSearch={(text) => navigate({ to: "/admin/notes", search: { q: text || undefined }, replace: true, resetScroll: false })}
      />
      {more && (
        <p className="text-sm text-muted-foreground">The newest 500 are shown; search to find the others.</p>
      )}
      <ModelTable
        ui={noteUi}
        app={app}
        rows={rows}
        emptyMessage={q ? \`No notes match “\${q}”.\` : undefined}
        emptyAction={newButton || undefined}
        onOpen={(row) => navigate({ to: "/admin/notes/$id", params: { id: String(row.id) } })}
      />
    </>
  );
}
"
`;

