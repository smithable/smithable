exports[`../../../examples/marketplace/smithable.yml > file list and generated code > src/routes/sign-in.tsx 1`] = `
"// Generated by Smithable from smithable.auth.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, useRouter } from "@tanstack/react-router";
import { createServerFn } from "@tanstack/react-start";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { eq } from "drizzle-orm";
import { db } from "#/db";
import { user } from "#/db/schema";
import { oneOf, optional, type Search, shaped } from "#/kit/params";
import { app } from "#/generated/app";
import { SignIn } from "#/kit/SignIn";
import { w } from "#/kit/words";
import { auth, codesReachPeople, configuredProviders, demoSignIn, mailKept, PROVIDERS } from "#/lib/auth";
import { authClient } from "#/lib/auth-client";

const ROLES = ["admin","member"] as const;

const signInOptions = createServerFn().handler(() => {
  const providers = configuredProviders();
  return { providers, missing: PROVIDERS.filter((p) => !providers.includes(p)), demo: demoSignIn, codes: codesReachPeople(), kept: mailKept() };
});

/** The development sign-in's passwords, by address, for this process only. */
const devPasswords = new Map<string, string>();

/** Development, or a demo: signs in as a user with the role, without a provider. */
const devSignIn = createServerFn({ method: "POST" })
  .validator((role: unknown) => {
    const known = oneOf(role, ROLES);
    if (!known) throw new Error("No such role.");
    return known;
  })
  .handler(async ({ data: role }) => {
    if (!import.meta.env.DEV && !demoSignIn) throw new Error(w.developmentOnlyNote);
    const prefix = demoSignIn && !import.meta.env.DEV ? "demo" : "dev";
    const email = \`\${prefix}-\${role}@example.com\`;
    // One password per user while this process runs, never a known one: nobody signs in as them
    // without this button, and two tabs signing in at once (Studio and its guide) use the same.
    const password = devPasswords.get(email) ?? crypto.randomUUID() + crypto.randomUUID();
    devPasswords.set(email, password);
    const context = await auth.$context;
    const made = () => db.select({ id: user.id }).from(user).where(eq(user.email, email)).get();
    if (!made()) {
      // Two tabs signing in at once (Studio and its guide): the other may make the user first.
      try {
        const created = await context.internalAdapter.createUser({ email, name: \`\${prefix === "demo" ? "Demo" : "Dev"} \${role}\`, emailVerified: true }, { method: "admin" });
        await context.internalAdapter.linkAccount({ providerId: "credential", accountId: created.id, password: await context.password.hash(password), userId: created.id });
      } catch (error) {
        if (!made()) throw error;
      }
    }
    db.update(user).set({ role }).where(eq(user.email, email)).run();
    const signIn = () => auth.api.signInEmail({ body: { email, password }, headers: getRequestHeaders() });
    // After a restart (or a password someone changed) the user's is another one: set anew.
    await signIn().catch(async () => {
      await context.internalAdapter.updatePassword(made()?.id as string, await context.password.hash(password));
      await signIn();
    });
  });

export const Route = createFileRoute("/sign-in")({
  // Only paths within the app, so the page cannot send anyone elsewhere.
  validateSearch: (s: Search) => optional({
    redirect: shaped(s.redirect, /^\\/(?!\\/)/),
  }),
  loader: () => signInOptions(),
  component: SignInPage,
});

function SignInPage() {
  const { providers, missing, demo, codes, kept } = Route.useLoaderData();
  const { redirect = "/" } = Route.useSearch();
  const router = useRouter();
  return (
    <SignIn
      appName={app.name}
      providers={providers}
      missing={missing}
      devRoles={import.meta.env.DEV || demo ? [...ROLES] : undefined}
      demo={demo}
      onProvider={async (provider) => {
        const { error } = await authClient.signIn.social({ provider, callbackURL: redirect });
        if (error) throw new Error(error.message);
      }}
      codes={codes}
      kept={kept}
      onSendCode={async (address) => {
        const { error } = await authClient.emailOtp.sendVerificationOtp({ email: address, type: "sign-in" });
        if (error) throw new Error(error.message);
      }}
      onCode={async (address, code) => {
        const { error } = await authClient.signIn.emailOtp({ email: address, otp: code.replace(/\\s/g, "") });
        if (error) throw new Error(error.message);
        await router.invalidate();
        await router.navigate({ href: redirect });
      }}
      onDevRole={async (role) => {
        await devSignIn({ data: role as (typeof ROLES)[number] });
        await router.invalidate();
        await router.navigate({ href: redirect });
      }}
    />
  );
}
"
`;

exports[`../../../examples/marketplace/smithable.yml > file list and generated code > src/routes/sitemap[.]xml.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute } from "@tanstack/react-router";
import { originOf } from "#/kit/origin";

const PAGES = ["/welcome","/"];

const escape = (s: string) =>
  s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&apos;");

export const Route = createFileRoute("/sitemap.xml")({
  server: {
    handlers: {
      GET: async ({ request }) => {
        const origin = originOf(request);
        const entries: { loc: string; lastmod?: string | Date | null }[] = [
          ...PAGES.map((route) => ({ loc: route })),

        ];
        const body = \`<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
\${entries
  .map(
    (e) =>
      \`  <url><loc>\${escape(origin + e.loc)}</loc>\${e.lastmod ? \`<lastmod>\${new Date(e.lastmod).toISOString().slice(0, 10)}</lastmod>\` : ""}</url>\`,
  )
  .join("\\n")}
</urlset>
\`;
        return new Response(body, { headers: { "Content-Type": "application/xml; charset=utf-8" } });
      },
    },
  },
});
"
`;

exports[`../../../examples/marketplace/smithable.yml > file list and generated code > src/routes/welcome/index.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute } from "@tanstack/react-router";
import { pageAccess, pageHead } from "#/generated/pages";
import { guardPage } from "#/kit/access";
import { LandingLayout, Hero, RecordCards } from "#/kit/Landing";
import { w } from "#/kit/words";
import { site } from "#/generated/site";
import { listItems, itemUi } from "#/generated/item";
import { app } from "#/generated/app";
import { Package } from "lucide-react";

export const Route = createFileRoute("/welcome/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["home"], context.viewer, location.href),
  head: () => pageHead("home"),
  loader: async () => ({ items: (await listItems()).rows }),
  component: HomePage,
});

function HomePage() {
  const data = Route.useLoaderData();
  const { viewer } = Route.useRouteContext();
  return (
    <LandingLayout appName={app.name} link={viewer ? { to: "/", label: w.openApp(app.name) } : { to: "/sign-in", label: w.signIn }} footer={{ links: [], texts: "pages.home.footer" }} site={site} viewer={viewer}>
      <Hero
          texts="pages.home.hero"
          title="Torget"
          subtitle="Buy and sell second-hand things in your neighborhood."
          link={{ to: "/", label: "Get started" }}
          more
        />
      <RecordCards
          texts="pages.home.latest"
          id="latest"
          icon={Package}
          door={{
  to: "/",
  search: { label: "Search items", placeholder: "Search by title, description or place" },
  chips: [
    {
      name: "category",
      label: "Category",
      options: [
        { value: "furniture", label: "Furniture" },
        { value: "bikes", label: "Bikes" },
        { value: "electronics", label: "Electronics" },
        { value: "sports", label: "Sports" },
        { value: "kids", label: "Kids" },
        { value: "other", label: "Other" },
      ],
    },
  ],
}}
          title={itemUi.pluralLabel}
          cards={data.items.slice(0, 6).map((row) => ({
            key: row.id,
            title: String(row.title),
            href: \`/\${row.id}\`,
            picture: row.photos?.[0] ? { src: \`/files/item/\${row.id}/photos/0\`, alt: row.photos[0].alt, width: row.photos[0].width, height: row.photos[0].height, generated: row.photos[0].generated } : undefined,
            text: row.description ?? undefined,
            badge: itemUi.fields.find((f) => f.name === "category")?.choices?.find((c) => c.value === row.category)?.label,
            amount: row.price == null ? undefined : new Intl.NumberFormat(undefined, { style: "currency", currency: app.currency }).format(row.price / 100),
          }))}
        />
    </LandingLayout>
  );
}
"
`;

