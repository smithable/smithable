  --heading-weight: 700;
  --heading-tracking: -0.02em;
  --heading-scale: 1;
  --heading-case: none;
  --card-shadow: 0 1px 2px rgb(0 0 0 / 0.05);
  --card-border: 1px;
  --card-border-color: var(--border);
  --section-background: transparent;
  --section-border: 0;
  --section-gap: 0;
  --divider: var(--border);
  --button-radius: calc(var(--radius) - 2px);
  --button-weight: 600;
  --picture-radius: initial;
  --picture-frame: 0;
  --table-numbers: normal;
  --row-divider: var(--divider);
  --row-stripe: transparent;
  --hover: color-mix(in oklch, var(--foreground) 7%, transparent);
  --primary-hover: color-mix(in oklch, var(--primary), black 20%);
  --destructive-hover: color-mix(in oklch, var(--destructive), black 20%);
}

/* Touch screens get 44 px targets whatever the density. */
@media (pointer: coarse) {
  :root {
    --control-height: 2.75rem;
  }
}

/* A visitor who asks for less motion gets none, whatever the theme says. */
@media (prefers-reduced-motion: reduce) {
  :root {
    --motion-fast: 0ms;
    --motion-slow: 0ms;
    --motion-distance: 0px;
    --landing-motion: none;
    --hero-motion: none;
  }
}

@media (prefers-color-scheme: dark) {
  :root {
    --background: oklch(0.197469 0.027449 267.7258);
    --foreground: oklch(0.961159 0.018238 269.0896);
    --card: oklch(0.252521 0.036704 263.5855);
    --primary: oklch(0.785298 0.104135 274.7134);
    --muted: oklch(0.316145 0.041249 261.3162);
    --muted-foreground: oklch(0.798846 0.035640 261.9366);
    --border: oklch(0.602795 0.045880 259.5915);
    --accent: oklch(0.355372 0.067178 272.4771);
    --sidebar: oklch(0.227222 0.031160 264.8059);
    --card-foreground: oklch(0.961159 0.018238 269.0896);
    --primary-foreground: oklch(0.197469 0.027449 267.7258);
    --secondary: oklch(0.316145 0.041249 261.3162);
    --secondary-foreground: oklch(0.961159 0.018238 269.0896);
    --accent-foreground: oklch(0.961159 0.018238 269.0896);
    --input: oklch(0.602795 0.045880 259.5915);
    --ring: oklch(0.785298 0.104135 274.7134);
    --sidebar-foreground: oklch(0.961159 0.018238 269.0896);
    --destructive: oklch(0.809664 0.106109 11.6385);
    --success: oklch(0.871163 0.136267 154.4491);
    --warning: oklch(0.924277 0.115127 95.7459);
    --destructive-foreground: oklch(0.197469 0.027449 267.7258);
    --success-foreground: oklch(0.197469 0.027449 267.7258);
    --warning-foreground: oklch(0.197469 0.027449 267.7258);
    --chart-1: oklch(0.785298 0.104135 274.7134);
    --chart-2: oklch(0.854882 0.125075 181.0707);
    --chart-3: oklch(0.836861 0.164422 84.4286);
    --chart-4: oklch(0.833033 0.132193 321.4337);
    --chart-5: oklch(0.809664 0.106109 11.6385);
