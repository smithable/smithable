"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { createInsertSchema } from "drizzle-zod";
import { z } from "zod";
import { posts } from "#/db/schema";
import { allows } from "#/kit/access";
import type { RecordUi } from "#/kit/model";
import { MarkdownEditor } from "#/kit/Markdown";
import { bindPicture } from "#/kit/PictureInput";
import { postAccess, postData } from "./post.server";
import { writeAllowed } from "#/kit/limit";
import { currentViewer } from "#/lib/viewer.server";

/** The viewer about to write, counted against how often one may (see src/kit/limit.ts). */
async function writer() {
  const viewer = await currentViewer();
  writeAllowed(viewer, getRequestHeaders());
  return viewer;
}

/** Post records as the kit reads them. */
export type PostRow = typeof posts.$inferSelect;

export const postUi: RecordUi<PostRow> = {
  model: "Post",
  label: "Post",
  pluralLabel: "Posts",
  titleField: "title",
  descriptionField: "summary",
  columns: ["title", "cover", "status", "address", "publishedOn"],
  fields: [
    {
      name: "title",
      label: "Title",
      kind: "string",
      required: true,
      get: (row) => row.title,
    },
    {
      name: "address",
      label: "Address",
      kind: "string",
      required: false,
      get: (row) => row.address,
    },
    {
      name: "summary",
      label: "Summary",
      kind: "text",
      required: false,
      get: (row) => row.summary,
    },
    {
      name: "cover",
      label: "Cover",
      kind: "picture",
      required: false,
      input: bindPicture("post", "cover"),
      get: (row) => row.cover,
    },
    {
      name: "body",
      label: "Body",
      kind: "markdown",
      required: true,
      input: MarkdownEditor,
      get: (row) => row.body,
    },
    {
      name: "publishedOn",
      label: "Published on",
      kind: "date",
      required: false,
      get: (row) => row.publishedOn,
    },
    {
      name: "status",
      label: "Status",
      kind: "choice",
      required: true,
      choices: [{ value: "draft", label: "Draft" }, { value: "published", label: "Published" }],
      default: "draft",
      get: (row) => row.status,
    },
  ],
};

export const postSchema = createInsertSchema(posts, {
  title: (s) => s.trim().min(1, "Required").max(200, "At most 200 characters"),
  address: (s) => s.max(200, "At most 200 characters"),
  summary: (s) => s.max(10000, "At most 10,000 characters"),
  cover: z.object({ file: z.string().max(100), alt: z.string().trim().max(200), width: z.int().positive(), height: z.int().positive() }).nullish(),
  body: (s) => s.trim().min(1, "Required").max(50000, "At most 50,000 characters"),
  publishedOn: (s) => s.regex(/^\\d{4}-\\d{2}-\\d{2}$/, "Enter a valid date"),
}).omit({ id: true, ownerId: true, createdAt: true, updatedAt: true });

export type PostValues = z.output<typeof postSchema>;

export const listPosts = createServerFn().handler(async () => {
  const viewer = await currentViewer();
