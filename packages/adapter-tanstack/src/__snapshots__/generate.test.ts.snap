exports[`../../../examples/kiosk/smithable.yml > file list and generated code > src/db/schema.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { relations } from "drizzle-orm";
import { index, integer, sqliteTable, text } from "drizzle-orm/sqlite-core";
import type { Picture } from "#/kit/uploads";

export const user = sqliteTable("user", {
  id: text().primaryKey(),
  name: text().notNull(),
  email: text().notNull().unique(),
  emailVerified: integer({ mode: "boolean" }).default(false).notNull(),
  image: text(),
  role: text().notNull().default("staff"),
  createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
  updatedAt: integer({ mode: "timestamp_ms" })
    .notNull()
    .$defaultFn(() => new Date())
    .$onUpdate(() => new Date()),
});

export const session = sqliteTable(
  "session",
  {
    id: text().primaryKey(),
    expiresAt: integer({ mode: "timestamp_ms" }).notNull(),
    token: text().notNull().unique(),
    createdAt: integer({ mode: "timestamp_ms" }).notNull(),
    updatedAt: integer({ mode: "timestamp_ms" }).notNull(),
    ipAddress: text(),
    userAgent: text(),
    userId: text()
      .notNull()
      .references(() => user.id, { onDelete: "cascade" }),
  },
  (t) => [index("session_user_id_idx").on(t.userId)],
);

export const account = sqliteTable(
  "account",
  {
    id: text().primaryKey(),
    accountId: text().notNull(),
    providerId: text().notNull(),
    userId: text()
      .notNull()
      .references(() => user.id, { onDelete: "cascade" }),
    accessToken: text(),
    refreshToken: text(),
    idToken: text(),
    accessTokenExpiresAt: integer({ mode: "timestamp_ms" }),
    refreshTokenExpiresAt: integer({ mode: "timestamp_ms" }),
    scope: text(),
    password: text(),
    createdAt: integer({ mode: "timestamp_ms" }).notNull(),
    updatedAt: integer({ mode: "timestamp_ms" }).notNull(),
  },
  (t) => [index("account_user_id_idx").on(t.userId)],
);

export const verification = sqliteTable(
  "verification",
  {
    id: text().primaryKey(),
    identifier: text().notNull(),
    value: text().notNull(),
    expiresAt: integer({ mode: "timestamp_ms" }).notNull(),
    createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
    updatedAt: integer({ mode: "timestamp_ms" })
      .notNull()
      .$defaultFn(() => new Date())
      .$onUpdate(() => new Date()),
  },
  (t) => [index("verification_identifier_idx").on(t.identifier)],
);

export const invitation = sqliteTable("invitation", {
  id: text().primaryKey(),
  email: text().notNull().unique(),
  role: text().notNull(),
  token: text().notNull().unique(),
  invitedById: text().references(() => user.id, { onDelete: "set null" }),
  createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
  expiresAt: integer({ mode: "timestamp_ms" }).notNull(),
});

export const auditLog = sqliteTable(
  "audit_log",
  {
    id: integer().primaryKey({ autoIncrement: true }),
    at: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
    trace: text(),
    /** A user's id, a key's name, "visitor", or "the app" for its own work. */
    who: text().notNull(),
    role: text(),
    address: text(),
    browser: text(),
    /** created, changed, deleted, copied, or an action's name. */
    action: text().notNull(),
    model: text(),
    recordId: integer(),
    title: text(),
    fields: text({ mode: "json" }).$type<string[]>(),
    details: text({ mode: "json" }).$type<Record<string, unknown>>(),
  },
  (t) => [index("audit_log_at").on(t.at), index("audit_log_record").on(t.model, t.recordId)],
);

export const uploads = sqliteTable(
  "uploads",
  {
    id: integer().primaryKey({ autoIncrement: true }),
    /** The stored file's name under uploads/ (src/kit/uploads.ts). */
    file: text().notNull(),
    model: text().notNull(),
    field: text().notNull(),
    /** Who uploaded it; nothing for a visitor. */
    uploader: text(),
    receipt: text().notNull(),
    at: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
  },
  (t) => [index("uploads_receipt").on(t.receipt), index("uploads_at").on(t.at)],
);

export const outgoingMail = sqliteTable(
  "outgoing_mail",
  {
    id: integer().primaryKey({ autoIncrement: true }),
    createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
    /** The outgoing entry's name in smithable.yml. */
    entry: text().notNull(),
    model: text().notNull(),
    recordId: integer().notNull(),
    to: text().notNull(),
    subject: text().notNull(),
    text: text().notNull(),
    /** A thread mail's headers (docs/design/mail-threads.md §4): its own id, what it answers, the thread. */
    messageId: text(),
    inReplyTo: text(),
    references: text(),
    replyTo: text(),
    tries: integer().notNull().default(0),
    nextAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
    sentAt: integer({ mode: "timestamp_ms" }),
    /** Given up after a day of tries; "Send again" in Activity clears it. */
    failedAt: integer({ mode: "timestamp_ms" }),
    error: text(),
  },
  (t) => [index("outgoing_mail_due").on(t.sentAt, t.failedAt, t.nextAt)],
);

export const outgoingCall = sqliteTable(
  "outgoing_call",
  {
    id: integer().primaryKey({ autoIncrement: true }),
    createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
    entry: text().notNull(),
    model: text().notNull(),
    recordId: integer().notNull(),
    /** The target's name; its address and secret are OUTGOING_<TARGET>_URL and _SECRET. */
    target: text().notNull(),
    body: text().notNull(),
    tries: integer().notNull().default(0),
    nextAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
    sentAt: integer({ mode: "timestamp_ms" }),
    failedAt: integer({ mode: "timestamp_ms" }),
    /** The answer's status, or why there was none. */
    status: integer(),
    error: text(),
  },
  (t) => [index("outgoing_call_due").on(t.sentAt, t.failedAt, t.nextAt)],
);

export const sequences = sqliteTable("sequences", {
  /** "Order.number", or "Order.number:<owner id>" where the number is unique per owner. */
  key: text().primaryKey(),
  /** The last number given. */
  last: integer().notNull(),
});

export const dishes = sqliteTable("dishes", {
  id: integer().primaryKey({ autoIncrement: true }),
  name: text().notNull(),
  description: text(),
  price: integer().notNull(),
  section: text({ enum: ["starters", "mains", "drinks", "sweets"] }).notNull().default("starters"),
  picture: text({ mode: "json" }).$type<Picture>(),
  diet: text({ enum: ["none", "vegetarian", "vegan"] }).notNull().default("none"),
  allergens: text(),
  available: integer({ mode: "boolean" }).default(true),
  ownerId: text().references(() => user.id, { onDelete: "set null" }),
  createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
  updatedAt: integer({ mode: "timestamp_ms" })
    .notNull()
    .$defaultFn(() => new Date())
    .$onUpdate(() => new Date()),
});

export const orders = sqliteTable("orders", {
  id: integer().primaryKey({ autoIncrement: true }),
  number: integer().notNull().unique(),
  name: text().notNull(),
  phone: text().notNull(),
  email: text(),
  wanted: integer({ mode: "timestamp_ms" }),
  note: text(),
  status: text({ enum: ["new", "accepted", "ready", "collected", "declined"] }).notNull().default("new"),
  reason: text(),
  total: integer(),
  ownerId: text().references(() => user.id, { onDelete: "set null" }),
  createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
  updatedAt: integer({ mode: "timestamp_ms" })
    .notNull()
    .$defaultFn(() => new Date())
    .$onUpdate(() => new Date()),
});

export const orderLines = sqliteTable("order_lines", {
  id: integer().primaryKey({ autoIncrement: true }),
  orderId: integer().notNull().references(() => orders.id, { onDelete: "restrict" }),
  dishId: integer().notNull().references(() => dishes.id, { onDelete: "restrict" }),
  quantity: integer().notNull().default(1),
  unitPrice: integer().notNull(),
  amount: integer(),
  ownerId: text().references(() => user.id, { onDelete: "set null" }),
  createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
  updatedAt: integer({ mode: "timestamp_ms" })
    .notNull()
    .$defaultFn(() => new Date())
    .$onUpdate(() => new Date()),
});

export const stops = sqliteTable("stops", {
  id: integer().primaryKey({ autoIncrement: true }),
  place: text().notNull(),
  day: text().notNull(),
  hours: text().notNull(),
  note: text(),
  ownerId: text().references(() => user.id, { onDelete: "set null" }),
  createdAt: integer({ mode: "timestamp_ms" }).notNull().$defaultFn(() => new Date()),
  updatedAt: integer({ mode: "timestamp_ms" })
    .notNull()
    .$defaultFn(() => new Date())
    .$onUpdate(() => new Date()),
});

export const ordersRelations = relations(orders, ({ many }) => ({
  lines: many(orderLines),
}));

export const orderLinesRelations = relations(orderLines, ({ one }) => ({
  order: one(orders, { fields: [orderLines.orderId], references: [orders.id] }),
  dish: one(dishes, { fields: [orderLines.dishId], references: [dishes.id] }),
}));
"
`;

exports[`../../../examples/kiosk/smithable.yml > file list and generated code > src/db/seed.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// Sample data for development. Run with \`pnpm db:seed\`; tables that already have rows are left alone.
import { db } from "./index";
import * as schema from "./schema";
import { samplePicture } from "#/kit/uploads";

if (db.select().from(schema.dishes).limit(1).all().length === 0) {
  db.insert(schema.dishes)
    .values([
    { name: "Dish 1", description: "A short description of Dish 1.", price: 12000, section: "starters", picture: samplePicture("dish", 0, "A picture of Dish 1"), diet: "none", allergens: "allergens 1", available: false },
    { name: "Dish 2", description: "A short description of Dish 2.", price: 48000, section: "mains", picture: samplePicture("dish", 1, "A picture of Dish 2"), diet: "vegetarian", allergens: "allergens 2", available: true },
    { name: "Dish 3", description: "A short description of Dish 3.", price: 125000, section: "drinks", picture: samplePicture("dish", 2, "A picture of Dish 3"), diet: "vegan", allergens: "allergens 3", available: true },
    { name: "Dish 4", description: "A short description of Dish 4.", price: 230000, section: "sweets", picture: samplePicture("dish", 0, "A picture of Dish 4"), diet: "none", allergens: "allergens 4", available: false },
    { name: "Dish 5", description: "A short description of Dish 5.", price: 7500, section: "starters", picture: samplePicture("dish", 1, "A picture of Dish 5"), diet: "vegetarian", allergens: "allergens 5", available: true },
    { name: "Dish 6", description: "A short description of Dish 6.", price: 96000, section: "mains", picture: samplePicture("dish", 2, "A picture of Dish 6"), diet: "vegan", allergens: "allergens 6", available: true },
    { name: "Dish 7", description: "A short description of Dish 7.", price: 340000, section: "drinks", picture: samplePicture("dish", 0, "A picture of Dish 7"), diet: "none", allergens: "allergens 7", available: false },
    { name: "Dish 8", description: "A short description of Dish 8.", price: 64000, section: "sweets", picture: samplePicture("dish", 1, "A picture of Dish 8"), diet: "vegetarian", allergens: "allergens 8", available: true },
    ])
    .run();
}

if (db.select().from(schema.orders).limit(1).all().length === 0) {
  db.insert(schema.orders)
    .values([
    { number: 1, name: "Order 1", phone: "+358 40 120 1000", email: "order.1@example.com", wanted: new Date("2026-09-01T08:00:00.000Z"), note: "A short description of Order 1.", status: "new", reason: "A short description of Order 1." },
    { number: 8, name: "Order 2", phone: "+358 40 127 1037", email: "order.2@example.com", wanted: new Date("2026-09-02T10:00:00.000Z"), note: "A short description of Order 2.", status: "accepted", reason: "A short description of Order 2." },
