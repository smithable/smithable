exports[`../../../examples/invoicing/smithable.yml > file list and generated code > src/generated/invoice.formulas.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { F } from "#/kit/formula";
import { invoiceLineFormulas } from "./invoice-line.formulas";

type Row = Record<string, unknown>;

/** Computed fields of Invoice, on records as stored (money in cents). */
export const invoiceFormulas = {
  total: (r: Row): number => F.toCents(F.SUM(F.list(r.lines).map((x1) => F.fromCents(invoiceLineFormulas.amount(x1))))),
};

/** Values suggested when a Invoice is created. */
export const invoiceDefaults = {
  issuedOn: (_r: Row): string => F.TODAY(),
  dueOn: (r: Row): string => F.DATEADD(F.d(r.issuedOn), 30, "day"),
};

/** The record with its computed fields. */
export function withInvoiceFormulas<T extends Row>(row: T): T & { total: number } {
  return { ...row, total: invoiceFormulas.total(row) };
}
"
`;

exports[`../../../examples/invoicing/smithable.yml > file list and generated code > src/generated/invoice.server.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { and, asc, eq, sql, type SQL } from "drizzle-orm";
import { db } from "#/db";
import { invoices } from "#/db/schema";
import { AccessDenied, check, type ModelAccess, readScope, type Viewer } from "#/kit/access";
import { invoiceLineData } from "./invoice-line.server";
import { clientData } from "./client.server";
import type { InvoiceValues } from "./invoice";
import { withInvoiceFormulas } from "./invoice.formulas";

/** Who may read, create, change and delete invoices. */
export const invoiceAccess: ModelAccess = {
  read: { public: false, roles: ["admin"], owner: true },
  create: { public: false, roles: ["admin", "member"], owner: false },
  write: { public: false, roles: ["admin"], owner: true },
  delete: { public: false, roles: ["admin"], owner: true },
};

/** Checks that the viewer may read the records the values refer to. */
function checkReferences(viewer: Viewer | null, values: InvoiceValues): void {
  if (values.clientId != null && !clientData.canRead(viewer, values.clientId))
    throw new AccessDenied(viewer !== null);
}

export const invoiceData = {
  /** A condition for the invoices the viewer may read. */
  readable(viewer: Viewer | null) {
    const scope = readScope(invoiceAccess.read, viewer);
    if (scope === "all") return undefined;
    return scope === "own" && viewer ? eq(invoices.ownerId, viewer.id) : sql\`false\`;
  },

  canRead(viewer: Viewer | null, id: number): boolean {
    const found = db
      .select({ id: invoices.id })
      .from(invoices)
      .where(and(eq(invoices.id, id), invoiceData.readable(viewer)))
      .get();
    return found !== undefined;
  },

  /** The invoices the viewer may read; \`where\` narrows them, e.g. to a search. */
  async list(viewer: Viewer | null, where?: SQL) {
    if (readScope(invoiceAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const rows = await db.query.invoices.findMany({
      where: and(invoiceData.readable(viewer), where),
      with: { client: { columns: { id: true, name: true } }, lines: true },
      orderBy: (t, { desc }) => [desc(t.id)],
    });
    return rows.map(withInvoiceFormulas);
  },

  async get(viewer: Viewer | null, id: number) {
    const row = await db.query.invoices.findFirst({
      where: and(eq(invoices.id, id), invoiceData.readable(viewer)),
      with: { client: { columns: { id: true, name: true } }, lines: { where: invoiceLineData.readable(viewer) } },
    });
    return row ? withInvoiceFormulas(row) : null;
  },

  create(viewer: Viewer | null, values: InvoiceValues) {
    check(invoiceAccess.create, viewer);
    checkReferences(viewer, values);
    return db.insert(invoices).values({ ...values, ownerId: viewer?.id ?? null }).returning().get();
  },

  update(viewer: Viewer | null, id: number, values: InvoiceValues) {
    const row = db
      .select({ ownerId: invoices.ownerId })
      .from(invoices)
      .where(and(eq(invoices.id, id), invoiceData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(invoiceAccess.write, viewer, row.ownerId);
    checkReferences(viewer, values);
    return db.update(invoices).set(values).where(eq(invoices.id, id)).returning().get();
  },

  remove(viewer: Viewer | null, id: number): void {
    const row = db
      .select({ ownerId: invoices.ownerId })
      .from(invoices)
      .where(and(eq(invoices.id, id), invoiceData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(invoiceAccess.delete, viewer, row.ownerId);
    db.delete(invoices).where(eq(invoices.id, id)).run();
  },

  /** Choices for fields that refer to a invoice: the ones the viewer may read. */
  options(viewer: Viewer | null) {
    if (readScope(invoiceAccess.read, viewer) === "none") return [];
    return db
      .select({ value: invoices.id, label: invoices.number })
      .from(invoices)
      .where(invoiceData.readable(viewer))
      .orderBy(asc(invoices.number))
      .all();
  },
};
"
`;

