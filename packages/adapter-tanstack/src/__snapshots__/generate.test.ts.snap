"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createInsertSchema } from "drizzle-zod";
import type { z } from "zod";
import * as schema from "#/db/schema";
import { w } from "#/kit/words";

/** What a incident may be given: a form's values and what the app fills (an action's set). */
export const incidentSettable = createInsertSchema(schema.incidents, {
  title: (s) => s.trim().min(1, w.required).max(200, w.atMostCharacters(200)),
  summary: (s) => s.max(50000, w.atMostCharacters(50000)),
}).omit({ id: true, ownerId: true, createdAt: true, updatedAt: true });
/** What a incident's form sends, checked. */
export const incidentSchema = incidentSettable;

export type IncidentSettable = z.output<typeof incidentSettable>;
export type IncidentValues = z.output<typeof incidentSchema>;
"
`;

