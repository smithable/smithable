const getOverview = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  const incidents = await incidentData.list(viewer);
  return {
    open: incidents.filter((row) => ["investigating","identified","monitoring"].includes(row.status)).length,
    perMonth: byMonth(incidents, (row) => row.detectedAt, () => 1),
    latest: latest(incidents, 5),
  };
});

export const Route = createFileRoute("/overview/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["overview"], context.viewer, location.href),
  head: () => ({ meta: [{"title":"Overview · Northwind Status"}] }),
