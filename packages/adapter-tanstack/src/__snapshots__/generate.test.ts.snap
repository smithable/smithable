describe("the soldOut action", () => {
  test("admin", async () => {
    const viewer = signedIn("admin");
    const others = insertDish(stranger.id, {"available":true});
    const own = insertDish(viewer.id, {"available":true});
    expect({
      others: await can(() => runSoldOut(viewer, others.id)),
      own: await can(() => runSoldOut(viewer, own.id)),
    }).toEqual({ others: true, own: true });
  });

  test("staff", async () => {
    const viewer = signedIn("staff");
    const others = insertDish(stranger.id, {"available":true});
    const own = insertDish(viewer.id, {"available":true});
    expect({
      others: await can(() => runSoldOut(viewer, others.id)),
      own: await can(() => runSoldOut(viewer, own.id)),
    }).toEqual({ others: true, own: true });
  });

  test("a visitor who has not signed in", async () => {
    const viewer = null;
    const others = insertDish(stranger.id, {"available":true});
    const othersBefore = JSON.stringify(db.select().from(schema.dishes).where(eq(schema.dishes.id, others.id)).get());
    expect({
      others: await can(() => runSoldOut(viewer, others.id)),
      own: false,
    }).toEqual({ others: false, own: false });
    expect(JSON.stringify(db.select().from(schema.dishes).where(eq(schema.dishes.id, others.id)).get())).toBe(othersBefore);
  });

  test("refused on a record where available is not true", async () => {
    const viewer = signedIn("admin");
    const record = insertDish(viewer.id, {"available":false});
    await expect(runSoldOut(viewer, record.id)).rejects.toThrow("This cannot be done now.");
  });

  test("over chosen records, only those it fits and may run on change", async () => {
    const viewer = signedIn("admin");
    const fitting = insertDish(viewer.id, {"available":true});
    const notFitting = insertDish(viewer.id, {"available":false});
    const notFittingBefore = JSON.stringify(db.select().from(schema.dishes).where(eq(schema.dishes.id, notFitting.id)).get());
    expect(await runSoldOutMany(viewer, [fitting.id, fitting.id, notFitting.id])).toEqual({ changed: 1, skipped: 1 });
    expect(JSON.stringify(db.select().from(schema.dishes).where(eq(schema.dishes.id, notFitting.id)).get())).toBe(notFittingBefore);
    const again = insertDish(viewer.id, {"available":true});
    const againBefore = JSON.stringify(db.select().from(schema.dishes).where(eq(schema.dishes.id, again.id)).get());
    await runSoldOutMany(null, [again.id]).catch(() => undefined);
    expect(JSON.stringify(db.select().from(schema.dishes).where(eq(schema.dishes.id, again.id)).get())).toBe(againBefore);
  });
});

