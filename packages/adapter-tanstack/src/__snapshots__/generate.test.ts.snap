/** What the records can be sorted by. */
const SORTABLE = { id: schema.incidentUpdates.id, at: schema.incidentUpdates.at, status: schema.incidentUpdates.status, message: schema.incidentUpdates.message, createdAt: schema.incidentUpdates.createdAt };

