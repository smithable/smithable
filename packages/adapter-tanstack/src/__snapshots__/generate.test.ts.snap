"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createInsertSchema } from "drizzle-zod";
import { z } from "zod";
import * as schema from "#/db/schema";
import { w } from "#/kit/words";

/** What a support case may be given: a form's values and what the app fills (an action's set). */
export const supportCaseSettable = createInsertSchema(schema.supportCases, {
  subject: (s) => s.trim().min(1, w.required).max(200, w.atMostCharacters(200)),
  customerEmail: z.email(w.enterValidEmail),
  priority: (s) => s.min(1).max(5),
  body: (s) => s.max(10000, w.atMostCharacters(10000)),
  attachments: z.array(z.object({ file: z.string().regex(/^support-case\\/[a-f0-9]{24}\\.[a-z0-9]{2,4}$/), name: z.string().max(200), type: z.string().max(100), size: z.int().nonnegative(), receipt: z.string().max(64).optional() })).max(10).nullish(),
}).omit({ id: true, ownerId: true, createdAt: true, updatedAt: true });
/** What a support case's form sends, checked. */
export const supportCaseSchema = supportCaseSettable;

export type SupportCaseSettable = z.output<typeof supportCaseSettable>;
export type SupportCaseValues = z.output<typeof supportCaseSchema>;
"
`;

exports[`../../../examples/support/smithable.yml > file list and generated code > src/generated/support-case.server.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { type AnyColumn, and, asc, avg, count, desc, eq, inArray, isNotNull, max, min, sql, sum, type SQL } from "drizzle-orm";
import { db } from "#/db";
import * as schema from "#/db/schema";
import { AccessDenied, allows, check, Conflict, type ModelAccess, personOf, readScope, type Viewer } from "#/kit/access";
import { audit, changedFields } from "#/kit/audit.server";
import { refusal } from "#/kit/log.server";
import { outgoing } from "#/generated/outgoing.server";
import { contains } from "#/kit/search";
import { BadInput } from "#/kit/refusal";
import { fits } from "#/kit/model";
import { aggregate, type Filterable, nearest, sortOf, whereOf, wordsOf } from "#/kit/where";
import { w } from "#/kit/words";
import { deleteFile } from "#/kit/uploads";
import { acceptFiles } from "#/kit/receipts.server";
import { afterChange, afterDelete } from "./hooks";
import { messageData } from "./message.server";
import { messageUi } from "./message";
import { supportCaseUi, type SupportCaseSettable } from "./support-case";

/** A transaction, as the group's functions are called inside one (docs/design/delete-together.md). */
type Tx = Parameters<Parameters<typeof db.transaction>[0]>[0];

/**
 * What points to a support case (docs/design/delete-together.md): the records that would go with it
 * to the trash, by model, and those that would show no support case; nothing when nothing does.
 */
function usedBy(tx: Tx, id: number, title: string) {
  const pointing: { model: string; from: string; label: string; plural: string; depth: number; count: number | null }[] = [
    { model: "Message", label: messageUi.label, plural: messageUi.pluralLabel, from: "SupportCase", depth: 1, count: tx.select({ n: count() }).from(schema.messages).where(and(eq(schema.messages.supportCaseId, id))).get()?.n ?? 0 },
  ];
  // A deeper member is named when its parent has records ("and what belongs to them").
  const with_: typeof pointing = [];
  for (const e of pointing)
    if (e.count === null ? with_.some((p) => p.model === e.from) : e.count > 0) with_.push(e);
  if (!with_.length) return undefined;
  const loose = [] as { model: string; label: string; plural: string; count: number }[];
  return { id, title, model: "SupportCase", label: supportCaseUi.label, with: with_, loose, together: false, missing: [supportCaseUi.label, messageUi.label] };
}

/** Who may read, create, change and delete support cases. */
export const supportCaseAccess: ModelAccess = {
  read: { public: false, roles: ["admin", "agent"], owner: false },
  create: { public: false, roles: ["admin", "agent"], owner: false },
  write: { public: false, roles: ["admin", "agent"], owner: true },
  delete: { public: false, roles: ["admin"], owner: true },
};

/** A record as the viewer gets it: who owns it only for its owner and roles that read every record. */
function shownTo<R extends { ownerId: string | null }>(viewer: Viewer | null, row: R): R {
  if ((viewer && row.ownerId === viewer.id) || (!!viewer && (!!viewer.system || supportCaseAccess.read.roles.includes(viewer.role)))) return row;
  return { ...row, ownerId: null };
}


/** What \`where\` may name, and how: the stored fields, by kind. */
const FILTERABLE: Record<string, Filterable> = {
  subject: { kind: "text", column: schema.supportCases.subject },
  customerEmail: { kind: "text", column: schema.supportCases.customerEmail },
  status: { kind: "choice", column: schema.supportCases.status, values: ["open","inProgress","closed","reopened"] },
  priority: { kind: "number", column: schema.supportCases.priority },
  assignee: { kind: "reference", column: schema.supportCases.assigneeId, title: { table: schema.user, column: schema.user.name } },
  body: { kind: "text", column: schema.supportCases.body },
};

/** What the records can be sorted by. */
const SORTABLE = { id: schema.supportCases.id, subject: schema.supportCases.subject, customerEmail: schema.supportCases.customerEmail, status: schema.supportCases.status, priority: schema.supportCases.priority, body: schema.supportCases.body, createdAt: schema.supportCases.createdAt };

/** The number fields \`measure\` adds up; amounts are stored in cents. */
const NUMBERS: Record<string, AnyColumn> = { priority: schema.supportCases.priority };
const MONEY: string[] = [];

/** Computed number fields \`measure\` adds up from the records themselves. */
const COMPUTED: string[] = [];

/** The titles of the referenced records \`measureBy\` splits by, to name its groups. */
function titlesOf(_viewer: Viewer | null, _by: string, _ids: number[]): Map<unknown, string> {
  switch (_by) {
    default:
      return new Map();
  }
}

/** What \`measureBy\` may split by: choices, yes/no, references, and dates by month. */
const BY: string[] = ["status","assignee"];


/** Each picture or document new to the record must come with the receipt its upload gave the viewer (src/kit/receipts.server.ts); the receipts are not kept. */
function checkFiles<V extends Partial<SupportCaseSettable>>(viewer: Viewer | null, values: V, before?: Record<string, unknown>): V {
  return {
    ...values,
    ...("attachments" in values ? { attachments: acceptFiles(viewer, "support-case", "attachments", values.attachments, before?.attachments) } : {}),
  };
}

export const supportCaseData = {
  shownTo,
  /** The rows with each reference to a record the viewer may not read set to nothing: a related record's title is shown only to who may read it (only its id stays). */
  shownRefs<R extends Record<string, unknown>>(_viewer: Viewer | null, rows: R[]): R[] {
    return rows;
  },

  /** Whether a stored picture or document is on any record (the trash too): a file no record has may go. */
  uses(file: string): boolean {
    return !!db.select({ id: schema.supportCases.id }).from(schema.supportCases).where(sql\`\${schema.supportCases.attachments} like \${\`%"file":"\${file}"%\`}\`).get();
  },

  /** A condition for the support cases the viewer may read. */
  readable(viewer: Viewer | null) {
    const scope = readScope(supportCaseAccess.read, viewer);
    if (scope === "all") return undefined;
    return scope === "own" && viewer ? eq(schema.supportCases.ownerId, viewer.id) : sql\`false\`;
  },

  canRead(viewer: Viewer | null, id: number): boolean {
    const found = db
      .select({ id: schema.supportCases.id })
      .from(schema.supportCases)
      .where(and(eq(schema.supportCases.id, id), supportCaseData.readable(viewer)))
      .get();
    return found !== undefined;
  },

  /** The support cases the viewer may read; \`where\` narrows them, e.g. to a search; \`order\` sorts them before the newest-first rest. */
  async list(viewer: Viewer | null, where?: SQL, order?: SQL) {
    if (readScope(supportCaseAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const found = supportCaseData.shownRefs(viewer, await db.query.supportCases.findMany({
      where: and(supportCaseData.readable(viewer), where),
      with: { assignee: { columns: { id: true, name: true } } },
      orderBy: (t, { desc }) => [...(order ? [order] : []), desc(t.id)],
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return rows;
  },

  /**
   * A page of the support cases the viewer may read that fit \`where\`, newest first (or in
   * \`order\`), and how many fit in all: for a list page. A page past the end is the last one.
   */
  async page(viewer: Viewer | null, where?: SQL, order?: SQL, page = 1, size = 50) {
    if (readScope(supportCaseAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = and(supportCaseData.readable(viewer), where);
    const total = db.select({ n: count() }).from(schema.supportCases).where(condition).get()?.n ?? 0;
    const at = Math.min(Math.max(1, Math.trunc(page)), Math.max(1, Math.ceil(total / size)));
    const found = supportCaseData.shownRefs(viewer, await db.query.supportCases.findMany({
      where: condition,
      with: { assignee: { columns: { id: true, name: true } } },
      orderBy: (t, { desc }) => [...(order ? [order] : []), desc(t.id)],
      limit: size,
      offset: (at - 1) * size,
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return { rows: rows, total, page: at, size };
  },

  /**
   * The support cases the viewer may read that fit \`where\` and \`search\`, in \`sort\`'s order (else newest
   * first), a page of them and how many there are: for the API and the assistants' tools.
   */
  async find(
    viewer: Viewer | null,
    options: { where?: unknown; search?: string; sort?: string; limit?: number; offset?: number } = {},
  ) {
    if (readScope(supportCaseAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = supportCaseData.fitting(viewer, options.where, options.search);
    const order = sortOf(SORTABLE, options.sort);
    const total = db.select({ n: count() }).from(schema.supportCases).where(condition).get()?.n ?? 0;
    const found = supportCaseData.shownRefs(viewer, await db.query.supportCases.findMany({
      where: condition,
      with: { assignee: { columns: { id: true, name: true } } },
      orderBy: (t, { desc }) => [...(order ? [order] : []), desc(t.id)],
      limit: options.limit ?? 100,
      offset: options.offset ?? 0,
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return { items: rows, total };
  },

  /**
   * A number from the support cases the viewer may read that fit \`where\`: how many, or the sum,
   * average, smallest or largest of a number field.
   */
  async measure(
    viewer: Viewer | null,
    how: "count" | "sum" | "average" | "smallest" | "largest",
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<number | null> {
    if (readScope(supportCaseAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = supportCaseData.fitting(viewer, options.where, options.search);
    if (how === "count")
      return db.select({ n: count() }).from(schema.supportCases).where(condition).get()?.n ?? 0;
    const field = options.field ?? "";
    const money = MONEY.includes(field);
    if (COMPUTED.includes(field)) {
      const rows = await supportCaseData.computedRows(condition);
      const value = aggregate(rows.map((row) => row[field]), how);
      return value === null ? null : money ? value / 100 : value;
    }
    const column = Object.hasOwn(NUMBERS, field) ? NUMBERS[field] : undefined;
    if (!column)
      throw new BadInput(
        \`\${how} needs a number field: \${[...Object.keys(NUMBERS), ...COMPUTED].join(", ") || "there are none"}.\`,
      );
    const pick = { sum, average: avg, smallest: min, largest: max }[how];
    const value = db.select({ v: pick(column) }).from(schema.supportCases).where(condition).get()?.v;
    if (value === null || value === undefined) return null;
    return money ? Number(value) / 100 : Number(value);
  },

  /** Which record holds the smallest or largest value of a number field (the first of a tie). */
  async holder(
    viewer: Viewer | null,
    how: "smallest" | "largest",
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<{ id: number; title: string } | null> {
    const condition = supportCaseData.fitting(viewer, options.where, options.search);
    const field = options.field ?? "";
    if (COMPUTED.includes(field)) {
      let best: Record<string, unknown> | undefined;
      for (const row of await supportCaseData.computedRows(condition)) {
        const v = row[field];
        if (typeof v !== "number") continue;
        if (!best || (how === "largest" ? v > (best[field] as number) : v < (best[field] as number))) best = row;
      }
      return best ? { id: best.id as number, title: String(best.subject) } : null;
    }
    const column = Object.hasOwn(NUMBERS, field) ? NUMBERS[field] : undefined;
    if (!column) return null;
    const row = db
      .select({ id: schema.supportCases.id, title: schema.supportCases.subject })
      .from(schema.supportCases)
      .where(and(condition, isNotNull(column)))
      .orderBy(how === "largest" ? desc(column) : asc(column), asc(schema.supportCases.id))
      .limit(1)
      .get();
    return row ? { id: row.id, title: String(row.title) } : null;
  },

  /**
   * The same number per value of a field (a choice, yes/no, a reference) or per month of a date:
   * \`[{ value, number }]\`, the most first.
   */
  async measureBy(
    viewer: Viewer | null,
    how: "count" | "sum" | "average" | "smallest" | "largest",
    by: string,
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<{ value: unknown; title?: string; number: number | null }[]> {
    if (readScope(supportCaseAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const split = Object.hasOwn(FILTERABLE, by) ? FILTERABLE[by] : undefined;
    if (!split || split.kind === "text" || split.kind === "number" || split.kind === "money")
      throw new BadInput(\`There is no field "\${by}" to split by. Fields: \${BY.join(", ")}.\`);
    const field = options.field ?? "";
    const money = MONEY.includes(field);
    const condition = supportCaseData.fitting(viewer, options.where, options.search);
    const amount = (n: number | null) => (n === null ? null : money ? n / 100 : n);
    const most = (a: { number: number | null }, b: { number: number | null }) => (b.number ?? 0) - (a.number ?? 0);
    // A reference's groups carry the referenced record's title beside its id.
    const named = (rows: { value: unknown; number: number | null }[]) => {
      if (split.kind !== "reference") return rows;
      const titles = titlesOf(viewer, by, rows.map((r) => r.value).filter((v): v is number => typeof v === "number"));
      return rows.map((r) => (titles.has(r.value) ? { value: r.value, title: titles.get(r.value), number: r.number } : r));
    };
    if (COMPUTED.includes(field)) {
      // Each record's month or value, then the computed numbers added up per group.
      const groups = new Map<unknown, unknown[]>();
      for (const row of await supportCaseData.computedRows(condition)) {
        const raw = row[split.kind === "reference" ? \`\${by}Id\` : by];
        const value = split.kind === "date" ? String(raw ?? "").slice(0, 7) || null : split.kind === "instant" ? (raw instanceof Date ? raw.toISOString().slice(0, 7) : null) : raw;
        groups.set(value, [...(groups.get(value) ?? []), row[field]]);
      }
      return named([...groups].map(([value, numbers]) => ({ value, number: amount(aggregate(numbers, how)) })).sort(most));
    }
    const key = split.kind === "date" ? sql<string>\`substr(\${split.column}, 1, 7)\` : split.kind === "instant" ? sql<string>\`strftime('%Y-%m', \${split.column} / 1000, 'unixepoch')\` : sql\`\${split.column}\`;
    const column = Object.hasOwn(NUMBERS, field) ? NUMBERS[field] : undefined;
    if (how !== "count" && !column)
      throw new BadInput(\`\${how} needs a number field: \${[...Object.keys(NUMBERS), ...COMPUTED].join(", ") || "there are none"}.\`);
    const pick = how === "count" || !column ? count() : { sum, average: avg, smallest: min, largest: max }[how](column);
    return named(
      db
        .select({ value: key, number: pick })
        .from(schema.supportCases)
        .where(condition)
        .groupBy(key)
        .all()
        .map((r) => ({ value: r.value, number: r.number === null ? null : amount(Number(r.number)) }))
        .sort(most),
    );
  },

  /**
   * The records that fit, with their computed fields worked out: for adding those up. At most
   * 10,000, so one call never reads a whole large table; more are refused with how to narrow them.
   */
  async computedRows(condition: SQL | undefined): Promise<Record<string, unknown>[]> {
    const rows = await db.query.supportCases.findMany({ where: condition, with: { assignee: { columns: { id: true, name: true } } }, limit: 10001 });
    if (rows.length > 10000)
      throw new BadInput("More than 10,000 records to add up a computed field over: narrow them with where.");
    return rows.map((row) => row as Record<string, unknown>);
  },

  /** The support cases the viewer may read whose subject has the text: a few, for naming one. */
  named(viewer: Viewer | null, text: string): { id: number; title: string }[] {
    return db
      .select({ id: schema.supportCases.id, title: schema.supportCases.subject })
      .from(schema.supportCases)
      .where(and(supportCaseData.readable(viewer), contains([schema.supportCases.subject], text)))
      .limit(6)
      .all()
      .map((row) => ({ id: row.id, title: String(row.title) }));
  },

  /** Every subject the viewer may read (at most 2,000): the nearest when a name fits none. */
  titles(viewer: Viewer | null): string[] {
    return db
      .select({ title: schema.supportCases.subject })
      .from(schema.supportCases)
      .where(supportCaseData.readable(viewer))
      .limit(2000)
      .all()
      .map((row) => String(row.title));
  },

  /** Why \`where\` found none when it names a text no record has: the field's nearest values. */
  whyNone(viewer: Viewer | null, where: unknown): string | undefined {
    if (!where || typeof where !== "object") return undefined;
    for (const [name, v] of Object.entries(where)) {
      const field = Object.hasOwn(FILTERABLE, name) ? FILTERABLE[name] : undefined;
      if (field?.kind !== "text" || (typeof v !== "string" && typeof v !== "number")) continue;
      const values = db
        .selectDistinct({ v: sql<string>\`\${field.column}\` })
        .from(schema.supportCases)
        .where(and(supportCaseData.readable(viewer), isNotNull(field.column)))
        .limit(2000)
        .all()
        .map((row) => String(row.v));
      const asked = String(v);
      if (values.length && !values.some((x) => x.toLowerCase().includes(asked.toLowerCase())))
        return \`No support case has "\${asked}" in \${name}; the nearest: \${nearest(asked, values).join(", ")}.\`;
    }
    return undefined;
  },

  /** The condition for records the viewer may read that fit \`where\` and \`search\`. */
  fitting(viewer: Viewer | null, where?: unknown, search?: string) {
    return and(
      supportCaseData.readable(viewer),
      whereOf(FILTERABLE, where, viewer ? eq(schema.supportCases.ownerId, viewer.id) : undefined, viewer?.id, {}),
      // Every word somewhere in the texts ("ship lamp" finds "ship's lamp").
      ...wordsOf(search).map((word) => contains([schema.supportCases.subject, schema.supportCases.customerEmail, schema.supportCases.body], word)),
    );
  },

  async get(viewer: Viewer | null, id: number) {
    const fetched = await db.query.supportCases.findFirst({
      where: and(eq(schema.supportCases.id, id), supportCaseData.readable(viewer)),
      with: { assignee: { columns: { id: true, name: true } }, messages: { where: messageData.readable(viewer), with: { agent: { columns: { id: true, name: true } } } } },
    });
    const found = fetched && supportCaseData.shownRefs(viewer, [{ ...fetched, messages: messageData.shownRefs(viewer, fetched.messages) }])[0];
    const row = found && { ...shownTo(viewer, found), messages: found.messages.map((r) => messageData.shownTo(viewer, r)) };
    return row ? row : null;
  },

  async create(viewer: Viewer | null, values: SupportCaseSettable) {
    check(supportCaseAccess.create, viewer);
    values = checkFiles(viewer, values);
    const next: Record<string, unknown> = { status: "open", ...values };
    if (fits({ status: ["inProgress", "closed"] }, next) && (next.assigneeId ?? "") === "") throw new BadInput(w.requiredNow("Assignee"));
    let row: typeof schema.supportCases.$inferSelect;
    try {
      row = db.transaction((tx) => {
        const made = tx.insert(schema.supportCases).values({ ...values, ownerId: personOf(viewer) }).returning().get();
        audit(tx, viewer, { action: "created", model: "SupportCase", record: made.id });
        outgoing(tx, viewer, "SupportCase", "created", made);
        return made;
      });
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterCreate", "SupportCase", row, viewer);
    return row;
  },

  /** Changes the record; \`what\` names the change in the audit log (an action's name). */
  /** Changes the fields given; what names the action ("changed" for a form), frees the fields it may change although locked (its own set). */
  async update(viewer: Viewer | null, id: number, values: Partial<SupportCaseSettable>, what = "changed", frees: readonly string[] = []) {
    const row = db
      .select({ ownerId: schema.supportCases.ownerId, attachments: schema.supportCases.attachments })
      .from(schema.supportCases)
      .where(and(eq(schema.supportCases.id, id), supportCaseData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    // A form's change needs write on the record; an action (what names it) checked its own access
    // first, which includes the roles its grant names (docs/design/actions.md, Access).
    if (what === "changed") check(supportCaseAccess.write, viewer, row.ownerId);
    values = checkFiles(viewer, values, db.select({ attachments: schema.supportCases.attachments }).from(schema.supportCases).where(eq(schema.supportCases.id, id)).get());
    let changed: typeof schema.supportCases.$inferSelect;
    const updated = values;
    try {
      changed = db.transaction((tx) => {
        // Read again in the change itself: a record that left the viewer's reach meanwhile is refused.
        const before = tx.select().from(schema.supportCases).where(and(eq(schema.supportCases.id, id), supportCaseData.readable(viewer))).get();
        if (!before) throw new AccessDenied(viewer !== null);
        if (before) {
          const given: Record<string, unknown> = updated;
          const was: Record<string, unknown> = before;
          if ((what === "changed" || !frees.includes("customerEmail")) && "customerEmail" in given && JSON.stringify(given.customerEmail ?? null) !== JSON.stringify(before.customerEmail ?? null)) throw new BadInput(w.cannotChangeNow("Customer email"));
          const next: Record<string, unknown> = { ...was, ...given };
          if (fits({ status: ["inProgress", "closed"] }, next) && (next.assigneeId ?? "") === "") throw new BadInput(w.requiredNow("Assignee"));
        }
        const after = tx.update(schema.supportCases).set(updated).where(eq(schema.supportCases.id, id)).returning().get();
        audit(tx, viewer, { action: what, model: "SupportCase", record: id, fields: before && changedFields(before, after, Object.keys(updated)) });
        outgoing(tx, viewer, "SupportCase", what, after, before);
        return after;
      });
    } catch (error) {
      throw refusal(error);
    }
    for (const p of row.attachments ?? []) if (!(changed.attachments ?? []).map((p) => p.file).includes(p.file)) deleteFile(p, !!db.select({ id: schema.supportCases.id }).from(schema.supportCases).where(sql\`\${schema.supportCases.attachments} like \${\`%"file":"\${p.file}"%\`}\`).get());
    await afterChange("afterUpdate", "SupportCase", changed, viewer);
    return changed;
  },

  /** Deletes the record; \`together\` takes the records that point to it along to the trash (delete-together.md). */
  async remove(viewer: Viewer | null, id: number, _together = false): Promise<void> {
    const row = db
      .select({ subject: schema.supportCases.subject, ownerId: schema.supportCases.ownerId, attachments: schema.supportCases.attachments })
      .from(schema.supportCases)
      .where(and(eq(schema.supportCases.id, id), supportCaseData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(supportCaseAccess.delete, viewer, row.ownerId);
    try {
      db.transaction((tx) => {
        // Read again in the change itself: a record that left the viewer's reach meanwhile is refused.
        if (!tx.select({ id: schema.supportCases.id }).from(schema.supportCases).where(and(eq(schema.supportCases.id, id), supportCaseData.readable(viewer))).get())
          throw new AccessDenied(viewer !== null);
        const used = usedBy(tx, id, String(row.subject ?? id));
        if (used) throw new Conflict(\`in-use:\${JSON.stringify(used)}\`);
        const gone = tx.delete(schema.supportCases).where(eq(schema.supportCases.id, id)).returning().get();
        if (gone) {
          audit(tx, viewer, { action: "deleted", model: "SupportCase", record: id, title: gone.subject });
          outgoing(tx, viewer, "SupportCase", "deleted", gone);
        }
      });
    } catch (error) {
      throw refusal(error);
    }
    for (const p of row.attachments ?? []) if (!([] as string[]).includes(p.file)) deleteFile(p, !!db.select({ id: schema.supportCases.id }).from(schema.supportCases).where(sql\`\${schema.supportCases.attachments} like \${\`%"file":"\${p.file}"%\`}\`).get());
    await afterDelete("SupportCase", id, viewer);
  },

  /**
   * Deletes the chosen records the viewer may delete, all or none (one still in use stops them
   * all, and is named); the others are skipped.
   */
  async removeMany(viewer: Viewer | null, ids: number[], _together = false): Promise<{ deleted: number; skipped: number }> {
    const rows = db
      .select({ id: schema.supportCases.id, subject: schema.supportCases.subject, ownerId: schema.supportCases.ownerId, attachments: schema.supportCases.attachments })
      .from(schema.supportCases)
      .where(and(inArray(schema.supportCases.id, ids), supportCaseData.readable(viewer)))
      .all()
      .filter((row) => allows(supportCaseAccess.delete, viewer, row.ownerId));
    db.transaction((tx) => {
      for (const row of rows)
        try {
          const used = usedBy(tx, row.id, String(row.subject ?? row.id));
          if (used) throw new Conflict(\`in-use:\${JSON.stringify(used)}\`);
          const gone = tx.delete(schema.supportCases).where(eq(schema.supportCases.id, row.id)).returning().get();
          if (gone) {
            audit(tx, viewer, { action: "deleted", model: "SupportCase", record: row.id, title: gone.subject });
            outgoing(tx, viewer, "SupportCase", "deleted", gone);
          }
        } catch (error) {
          const refused = refusal(error);
          throw refused instanceof Conflict && refused.message === "in-use" ? new Conflict(\`in-use:\${row.id}\`) : refused;
        }
    });
    for (const row of rows) {
      for (const p of row.attachments ?? []) if (!([] as string[]).includes(p.file)) deleteFile(p, !!db.select({ id: schema.supportCases.id }).from(schema.supportCases).where(sql\`\${schema.supportCases.attachments} like \${\`%"file":"\${p.file}"%\`}\`).get());
      await afterDelete("SupportCase", row.id, viewer);
    }
    return { deleted: rows.length, skipped: new Set(ids).size - rows.length };
  },

  /**
   * The support cases the viewer may read whose subject contains the text: a search of records that
   * refer to them finds them only among these.
   */
  titled(viewer: Viewer | null, text: string): number[] {
    return db
      .select({ id: schema.supportCases.id })
      .from(schema.supportCases)
      .where(and(contains([schema.supportCases.subject], text), supportCaseData.readable(viewer)))
      .all()
      .map((row) => row.id);
  },

  /** Choices for fields that refer to a support case: the ones the viewer may read. */
  options(viewer: Viewer | null) {
    if (readScope(supportCaseAccess.read, viewer) === "none") return [];
    return db
      .select({ value: schema.supportCases.id, label: schema.supportCases.subject })
      .from(schema.supportCases)
      .where(supportCaseData.readable(viewer))
      .orderBy(asc(schema.supportCases.subject))
      .all();
  },
};
"
`;

