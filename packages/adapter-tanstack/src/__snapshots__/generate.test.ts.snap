"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// The records' pictures and documents: which data function and access each one goes through (src/routes/files/).
import type { ModelAccess, Viewer } from "#/kit/access";
import { supportCaseAccess, supportCaseData } from "./support-case.server";
import { messageAccess, messageData } from "./message.server";

export interface UploadField {
  kind: "picture" | "file";
  data: { get(viewer: Viewer | null, id: number): Promise<unknown>; uses(file: string): boolean };
  access: ModelAccess;
  /** The field's key in a record. */
  key: string;
}

export const UPLOADS: Record<string, Record<string, UploadField>> = {
  "support-case": {
    "attachments": { kind: "file", data: supportCaseData, access: supportCaseAccess, key: "attachments" },
  },
