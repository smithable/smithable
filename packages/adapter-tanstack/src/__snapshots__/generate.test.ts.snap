    }
    if (row.cover && row.cover.file !== undefined) deletePicture(row.cover, !!db.select({ id: posts.id }).from(posts).where(sql\`\${posts.cover} like \${\`%"file":"\${row.cover.file}"%\`}\`).get());
    await afterDelete("Post", id, viewer);
