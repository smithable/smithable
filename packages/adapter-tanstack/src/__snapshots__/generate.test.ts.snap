export const Route = createFileRoute("/incidents/new")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["incidents"], context.viewer, location.href),
  head: () => pageHead("incidents"),
  validateSearch: (s: Search) => optional({ component: count(s.component) }),
  loader: async () => ({ options: { componentId: await componentOptions() } }),
  component: NewIncidentPage,
});

function NewIncidentPage() {
  const { options } = Route.useLoaderData();
  const search = Route.useSearch();
  const navigate = useNavigate();
  const back = () => search.component ? navigate({ to: "/components/$id", params: { id: String(search.component) } }) : navigate({ to: "/incidents" });
  return (
    <>
      <PageHeader title={w.newOne("incident")} />
      <ModelForm
        ui={incidentUi}
        app={app}
        schema={incidentSchema}
        preset={{ ...(search.component ? { componentId: search.component } : {}) }}
        fixed={[...(search.component ? ["componentId"] : [])]}
        options={options}
        submitLabel={w.createOne("incident")}
        onSubmit={async (values) => {
          await createIncident({ data: values });
          await back();
        }}
        onCancel={back}
      />
    </>
  );
}
"
