exports[`../../../examples/crm/smithable.yml > file list and generated code > src/generated/ask.server.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// "Ask" in the app (docs/design/assistant.md §6): the seven tools over everything the person
// may read, as core describes them for each role the assistant block names, and ask(), which
// answers a question as the signed-in person: the wording rules first, then the host's model
// (visitors: the rules only). Every call goes through the data functions, as a page's do.
import { AccessDenied, type Viewer } from "#/kit/access";
import type { AskKind } from "#/kit/ask";
import { type Answer, answer, hostModel } from "#/kit/assistant.server";
import { BadInput, NotFound } from "#/kit/refusal";
import type { Offer } from "#/kit/tools";

import { customerData } from "./customer.server";
import { orderData } from "./order.server";

import { customerSchema } from "#/generated/customer.schema";
import { orderSchema } from "#/generated/order.schema";

const whole = (v: unknown, field: string) => {
  if (Number.isInteger(v)) return v as number;
  throw new BadInput(\`"\${field}" must be a record's id, a whole number.\`);
};
const amount = (v: unknown, field: string) => {
  const n = typeof v === "number" ? v : typeof v === "string" ? Number(v.trim()) : Number.NaN;
  if (Number.isFinite(n)) return n;
  throw new BadInput(\`"\${field}" must be an amount, like "12.50".\`);
};
const moment = (v: unknown, field: string) => {
  const d = typeof v === "string" ? new Date(v) : undefined;
  if (d && !Number.isNaN(d.getTime())) return d;
  throw new BadInput(\`"\${field}" must be a date and time, like "2026-10-04T09:30:00Z".\`);
};

/** The body as an object of known fields, or a refusal naming the first unknown one. */
function fieldsOf(body: unknown, known: readonly string[]): Record<string, unknown> {
  if (!body || typeof body !== "object" || Array.isArray(body)) throw new BadInput("The body must be a JSON object.");
  const unknown = Object.keys(body).find((k) => !known.includes(k));
  if (unknown) throw new BadInput(\`There is no field "\${unknown}" to set. Fields: \${known.join(", ")}.\`);
  return body as Record<string, unknown>;
}

/** A customer as the API gives it. */
export function customerToApi(row: Record<string, any>) {
  return {
    id: row.id as number,
    name: row.name ?? null,
    email: row.email ?? null,
    phone: row.phone ?? null,
    segment: row.segment ?? null,
    creditLimit: row.creditLimit == null ? null : (Number(row.creditLimit) / 100).toFixed(2),
    notes: row.notes ?? null,
    accountManager: row.accountManagerId ?? null,
    createdAt: row.createdAt instanceof Date ? row.createdAt.toISOString() : row.createdAt,
    updatedAt: row.updatedAt instanceof Date ? row.updatedAt.toISOString() : row.updatedAt,
  };
}

/** A customer's values from a body: all of them, or a change to \`current\`. */
export function customerFromApi(body: unknown, current?: Record<string, unknown>) {
  const given = fieldsOf(body, ["name", "email", "phone", "segment", "creditLimit", "notes", "accountManager"]);
  const values: Record<string, unknown> = { ...current };
  for (const [key, v] of Object.entries(given))
    switch (key) {
      case "name":
        values.name = v;
        break;
      case "email":
        values.email = v;
        break;
      case "phone":
        values.phone = v;
        break;
      case "segment":
        values.segment = v;
        break;
      case "creditLimit":
        values.creditLimit = v === null ? null : Math.round(amount(v, "creditLimit") * 100);
        break;
      case "notes":
        values.notes = v;
        break;
      case "accountManager":
        values.accountManagerId = v === null ? null : whole(v, "accountManager");
        break;
    }
  return customerSchema.parse(values);
}

/** A order as the API gives it. */
export function orderToApi(row: Record<string, any>) {
  return {
    id: row.id as number,
    number: row.number ?? null,
    customer: row.customerId ?? null,
    status: row.status ?? null,
    total: row.total == null ? null : (Number(row.total) / 100).toFixed(2),
    shippingMethod: row.shippingMethod ?? null,
    shippingCost: row.shippingCost == null ? null : (Number(row.shippingCost) / 100).toFixed(2),
    placedAt: row.placedAt instanceof Date ? row.placedAt.toISOString() : (row.placedAt ?? null),
    createdAt: row.createdAt instanceof Date ? row.createdAt.toISOString() : row.createdAt,
    updatedAt: row.updatedAt instanceof Date ? row.updatedAt.toISOString() : row.updatedAt,
  };
}

/** A order's values from a body: all of them, or a change to \`current\`. */
export function orderFromApi(body: unknown, current?: Record<string, unknown>) {
  const given = fieldsOf(body, ["number", "customer", "status", "total", "shippingMethod", "placedAt"]);
  const values: Record<string, unknown> = { ...current };
  for (const [key, v] of Object.entries(given))
    switch (key) {
      case "number":
        values.number = v;
        break;
      case "customer":
        values.customerId = v === null ? null : whole(v, "customer");
        break;
      case "status":
        values.status = v;
        break;
      case "total":
        values.total = v === null ? null : Math.round(amount(v, "total") * 100);
        break;
      case "shippingMethod":
        values.shippingMethod = v;
        break;
      case "placedAt":
        values.placedAt = v === null ? null : moment(v, "placedAt");
        break;
    }
  return orderSchema.parse(values);
}

