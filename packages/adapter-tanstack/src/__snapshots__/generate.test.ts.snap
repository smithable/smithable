      label: "Amount",
      kind: "money",
      required: false,
      computed: true,
      get: (row) => row.amount,
    },
  ],
  compute: withOrderLineFormulas,
  defaults: orderLineDefaults,
};

/** Who may delete order lines: a list's selection offers Delete by it (the server checks again). */
export const orderLineDeleteRule: Rule = { public: false, roles: ["admin"], owner: true };


export const listOrderLines = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return { rows: await orderLineData.list(viewer), canCreate: allows(orderLineAccess.create, viewer) };
});

export const getOrderLine = createServerFn()
  .validator(z.number().int())
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    const row = await orderLineData.get(viewer, id);
    if (!row) return null;
    return {
      row,
      canWrite: allows(orderLineAccess.write, viewer, row.ownerId),
      canDelete: allows(orderLineAccess.delete, viewer, row.ownerId),
    };
  });

export const createOrderLine = createServerFn({ method: "POST" })
  .validator(orderLineSchema)
  .handler(async ({ data }) => orderLineData.create(await writer(), data));

export const updateOrderLine = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), values: orderLineSchema }))
  .handler(async ({ data }) => orderLineData.update(await writer(), data.id, data.values));

/** Deletes a order line; \`together\` takes what points to it along (docs/design/delete-together.md). */
export const deleteOrderLine = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), together: z.boolean().optional() }))
  .handler(async ({ data }) => orderLineData.remove(await writer(), data.id, data.together));

/** Deletes the chosen order lines, all or none (at most 1,000 at once). */
export const deleteOrderLines = createServerFn({ method: "POST" })
  .validator(z.object({ ids: z.array(z.number().int()).max(1000), together: z.boolean().optional() }))
  .handler(async ({ data }) => orderLineData.removeMany(await writer(), data.ids, data.together));
"
`;

exports[`../../../examples/kiosk/smithable.yml > file list and generated code > src/generated/outgoing.server.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { eq, type SQL } from "drizzle-orm";
import type { db } from "#/db";
import * as schema from "#/db/schema";
import { app } from "#/generated/app";
import type { Viewer } from "#/kit/access";
import { formatValue } from "#/kit/format";
import { counts } from "#/kit/outgoing";
import { type Happening, queueCall, queueMail, type Recipient } from "#/kit/outgoing.server";

type Tx = Pick<typeof db, "select" | "insert">;
type Row = Record<string, unknown>;

/** The users that fit, with their addresses. */
function people(tx: Tx, where: SQL): Recipient[] {
  return tx.select({ id: schema.user.id, email: schema.user.email }).from(schema.user).where(where).all();
}

/** Each model's record as a mail shows it: the subject, its fields, its page. */
const SHOWN: Record<string, (tx: Tx, r: Row) => Omit<Happening, "entry" | "model" | "record">> = {
  "Order": (_tx, r) => ({
    subject: \`Order: \${String(r.name ?? r.id)}\`,
    fields: [
      ["Number", formatValue({ name: "number", label: "Number", kind: "int", required: false }, r.number, app)],
      ["Name", formatValue({ name: "name", label: "Name", kind: "string", required: false }, r.name, app)],
      ["Phone", formatValue({ name: "phone", label: "Phone", kind: "phone", required: false }, r.phone, app)],
      ["Email", formatValue({ name: "email", label: "Email", kind: "email", required: false }, r.email, app)],
      ["Wanted", formatValue({ name: "wanted", label: "Wanted", kind: "datetime", required: false }, r.wanted, app)],
      ["Note", formatValue({ name: "note", label: "Note", kind: "text", required: false }, r.note, app)],
      ["Status", formatValue({
  name: "status",
  label: "Status",
  kind: "choice",
  required: false,
  choices: [
    { value: "new", label: "New" },
    { value: "accepted", label: "Accepted" },
    { value: "ready", label: "Ready" },
    { value: "collected", label: "Collected" },
    { value: "declined", label: "Declined" },
  ],
}, r.status, app)],
      ["Reason", formatValue({ name: "reason", label: "Reason", kind: "text", required: false }, r.reason, app)],
    ],
    link: \`/orders/\${r.id}\`,
  }),
};

/** Each model's record as a call sends it: as the API gives it. */
const SENT: Record<string, (row: Row) => Row> = {
  "Order": (row) => ({
    id: row.id,
    number: row.number ?? null,
    name: row.name ?? null,
    phone: row.phone ?? null,
    email: row.email ?? null,
    wanted: row.wanted instanceof Date ? row.wanted.toISOString() : (row.wanted ?? null),
    note: row.note ?? null,
    status: row.status ?? null,
    reason: row.reason ?? null,
    createdAt: row.createdAt instanceof Date ? row.createdAt.toISOString() : row.createdAt,
    updatedAt: row.updatedAt instanceof Date ? row.updatedAt.toISOString() : row.updatedAt,
  }),
};

/** The entries of smithable.yml's outgoing section, with their texts. */
const ENTRIES: {
  name: string;
  model: string;
  when: string;
  fits?: (r: Row) => boolean;
  /** For a change: only one of these fields changing counts. */
  fields?: string[];
  subject?: string;
  text?: string;
  to?: (tx: Tx, r: Row) => Recipient[];
  /** A target whose address and secret are settings (OUTGOING_<TARGET>_URL, _SECRET). */
  target?: string;
}[] = [
  {
    name: "orderPlaced",
    model: "Order",
    when: "created",
    to: (tx, _r) => people(tx, eq(schema.user.role, "admin")),
  },
  {
    name: "orderAccepted",
    model: "Order",
    when: "accept",
    to: (_tx, r) => [{ email: r.email as string | null }],
  },
  {
    name: "orderReady",
    model: "Order",
    when: "ready",
    to: (_tx, r) => [{ email: r.email as string | null }],
  },
  {
    name: "toKitchen",
    model: "Order",
    when: "created",
    target: "kitchen",
  },
];

/**
 * Queues what a change asks for, in its transaction: \`what\` is created, changed, deleted or the
 * action's name; \`record\` the record after (a deleted one as it was), \`before\` before a change.
 */
export function outgoing(tx: Tx, viewer: Viewer | null, model: string, what: string, record: Row, before?: Row): void {
  for (const entry of ENTRIES) {
    if (entry.model !== model || !counts(entry.when, what, entry.fits, record, before, entry.fields)) continue;
    if (entry.target) {
      const sent = SENT[model]?.(record);
      if (sent)
        queueCall(tx, {
          entry: entry.name,
          model,
          record: record.id as number,
          target: entry.target,
          body: JSON.stringify({ event: entry.name, model, happened: what, at: new Date().toISOString(), record: sent }),
        });
      continue;
    }
    const shown = SHOWN[model]?.(tx, record);
    if (!shown || !entry.to) continue;
    queueMail(
      tx,
      viewer,
      { ...shown, ...(entry.subject ? { subject: entry.subject } : {}), ...(entry.text ? { text: entry.text } : {}), entry: entry.name, model, record: record.id as number },
      entry.to(tx, record),
      entry.when === "created",
    );
  }
}
"
`;

exports[`../../../examples/kiosk/smithable.yml > file list and generated code > src/generated/pages.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import type { Rule } from "#/kit/access";
import { app } from "#/generated/app";

/** Who may open each page. */
export const pageAccess = {
  menu: { public: true, roles: ["admin", "staff"], owner: false },
  orders: { public: false, roles: ["admin", "staff"], owner: false },
  dishes: { public: false, roles: ["admin", "staff"], owner: false },
  stops: { public: false, roles: ["admin", "staff"], owner: false },
  where: { public: true, roles: ["admin", "staff"], owner: false },
  team: { public: false, roles: ["admin"], owner: false },
} satisfies Record<string, Rule>;

interface PageUi {
  title: string;
  subtitle?: string;
  description?: string;
}

/** Each page's words: the menus, its header and its tab read them here. */
export const pageUi = {
  menu: { title: "Menu" },
  orders: { title: "Orders" },
  dishes: { title: "Dishes" },
  stops: { title: "Stops" },
  where: { title: "Where" },
  team: { title: "Team" },
} satisfies Record<string, PageUi>;

/** A route's head: the tab's title ("<page> · <app>", the page at / the app's name alone), and the description search engines show. */
export function pageHead(page: keyof typeof pageUi) {
  const ui: PageUi = pageUi[page];
  const title = page === "menu" ? app.name : \`\${ui.title} · \${app.name}\`;
  const described = ui.description ? [{ name: "description", content: ui.description }] : [];
  return { meta: [{ title }, ...described] };
}
"
`;

