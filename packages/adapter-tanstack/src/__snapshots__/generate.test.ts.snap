exports[`../../../examples/invoicing/smithable.yml > file list and generated code > src/routes/overview/index.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, useNavigate } from "@tanstack/react-router";
import { createServerFn } from "@tanstack/react-start";
import { pageAccess } from "#/generated/pages";
import { guardPage } from "#/kit/access";
import { currentViewer } from "#/lib/viewer.server";
import { invoiceData } from "#/generated/invoice.server";
import { sum, byMonth, latest } from "#/kit/aggregate";
import { app } from "#/generated/app";
import { PageHeader } from "#/kit/AppShell";
import { StatCard, formatNumber, BarChart } from "#/kit/Dashboard";
import { invoiceUi } from "#/generated/invoice";
import { ModelTable } from "#/kit/ModelTable";

const getOverview = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  const invoices = await invoiceData.list(viewer);
  return {
    outstanding: sum(invoices.filter((row) => row.status === "sent"), (row) => row.total),
    overdue: sum(invoices.filter((row) => row.status === "overdue"), (row) => row.total),
    paid: sum(invoices.filter((row) => row.status === "paid"), (row) => row.total),
    invoiced: byMonth(invoices, (row) => row.issuedOn, (row) => Number(row.total) || 0),
    latest: latest(invoices, 5),
  };
});

export const Route = createFileRoute("/overview/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["overview"], context.viewer, location.href),
  loader: () => getOverview(),
  component: OverviewPage,
});

function OverviewPage() {
  const data = Route.useLoaderData();
  const navigate = useNavigate();
  return (
    <>
      <PageHeader page="overview" title="Overview" />
      <div data-kit="dashboard" className="space-y-6">
      <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <StatCard label="Outstanding" value={formatNumber("money", data.outstanding, app)} />
        <StatCard label="Overdue" value={formatNumber("money", data.overdue, app)} />
        <StatCard label="Paid" value={formatNumber("money", data.paid, app)} />
      </div>
      <BarChart label="Invoiced" kind="money" app={app} bars={data.invoiced} />
      <section aria-labelledby="latest-title" className="space-y-3">
        <h2 id="latest-title" className="font-semibold">Latest</h2>
        <ModelTable
          ui={invoiceUi}
          app={app}
          rows={data.latest}
          onOpen={(row) => navigate({ to: "/invoices/$id", params: { id: String(row.id) } })}
        />
      </section>
      </div>
    </>
  );
}
"
`;

exports[`../../../examples/invoicing/smithable.yml > file list and generated code > src/routes/settings/index.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, useRouter } from "@tanstack/react-router";
import { createServerFn } from "@tanstack/react-start";
import { app } from "#/generated/app";
import { pageAccess } from "#/generated/pages";
import { createBusinessProfile, businessProfileSchema, businessProfileUi, updateBusinessProfile } from "#/generated/business-profile";
import { businessProfileAccess, businessProfileData } from "#/generated/business-profile.server";
import { allows, guardPage } from "#/kit/access";
import { ModelForm } from "#/kit/ModelForm";
import { currentViewer } from "#/lib/viewer.server";
import { useState } from "react";
import { PageHeader } from "#/kit/AppShell";

/** The viewer's business profile: the first one they may read. */
const getSettings = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  const row = (await businessProfileData.list(viewer)).at(-1) ?? null;
  return {
    row,
    canSave: row ? allows(businessProfileAccess.write, viewer, row.ownerId) : allows(businessProfileAccess.create, viewer),
  };
});

export const Route = createFileRoute("/settings/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["settings"], context.viewer, location.href),
  loader: () => getSettings(),
  component: SettingsPage,
});

function SettingsPage() {
  const { row, canSave } = Route.useLoaderData();
  const router = useRouter();
  const [saved, setSaved] = useState(false);
  return (
    <>
      <PageHeader page="settings" title="Settings" />
      <ModelForm
        key={row?.id ?? "new"}
        ui={businessProfileUi}
        app={app}
        schema={businessProfileSchema}
        initial={row ?? undefined}
        readOnly={!canSave}
        submitLabel="Save changes"
        onSubmit={async (values) => {
          setSaved(false);
          if (row) await updateBusinessProfile({ data: { id: row.id, values } });
          else await createBusinessProfile({ data: values });
          await router.invalidate();
          setSaved(true);
        }}
      />
      <p role="status" className="mt-4 text-sm font-semibold">
        {saved ? "Saved." : ""}
      </p>
    </>
  );
}
"
`;

exports[`../../../examples/invoicing/smithable.yml > file list and generated code > src/routes/sign-in.tsx 1`] = `
"// Generated by Smithable from smithable.auth.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, useRouter } from "@tanstack/react-router";
import { createServerFn } from "@tanstack/react-start";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { eq } from "drizzle-orm";
import { z } from "zod";
import { db } from "#/db";
import { user } from "#/db/schema";
import { app } from "#/generated/app";
import { SignIn } from "#/kit/SignIn";
import { auth, configuredProviders, demoSignIn, PROVIDERS } from "#/lib/auth";
import { authClient } from "#/lib/auth-client";

const ROLES = ["admin","member"] as const;

const signInOptions = createServerFn().handler(() => {
  const providers = configuredProviders();
  return { providers, missing: PROVIDERS.filter((p) => !providers.includes(p)), demo: demoSignIn };
});

/** Development, or a demo: signs in as a user with the role, without a provider. */
const devSignIn = createServerFn({ method: "POST" })
  .validator(z.enum(ROLES))
  .handler(async ({ data: role }) => {
    if (!import.meta.env.DEV && !demoSignIn) throw new Error("Only available in development.");
    const prefix = demoSignIn && !import.meta.env.DEV ? "demo" : "dev";
    const email = \`\${prefix}-\${role}@example.com\`;
    const password = \`\${prefix}-password\`;
    if (!db.select({ id: user.id }).from(user).where(eq(user.email, email)).get()) {
      await auth.api.signUpEmail({ body: { email, password, name: \`\${prefix === "demo" ? "Demo" : "Dev"} \${role}\` } });
    }
    db.update(user).set({ role }).where(eq(user.email, email)).run();
    await auth.api.signInEmail({ body: { email, password }, headers: getRequestHeaders() });
  });

export const Route = createFileRoute("/sign-in")({
  // Only paths within the app, so the page cannot send anyone elsewhere.
  validateSearch: z.object({
    redirect: z.string().regex(/^\\/(?!\\/)/).optional().catch(undefined),
  }),
  loader: () => signInOptions(),
  component: SignInPage,
});

function SignInPage() {
  const { providers, missing, demo } = Route.useLoaderData();
  const { redirect = "/welcome" } = Route.useSearch();
  const router = useRouter();
  return (
    <SignIn
      appName={app.name}
      providers={providers}
      missing={missing}
      devRoles={import.meta.env.DEV || demo ? [...ROLES] : undefined}
      demo={demo}
      onProvider={async (provider) => {
        const { error } = await authClient.signIn.social({ provider, callbackURL: redirect });
        if (error) throw new Error(error.message);
      }}
      onDevRole={async (role) => {
        await devSignIn({ data: role as (typeof ROLES)[number] });
        await router.invalidate();
        await router.navigate({ href: redirect });
      }}
    />
  );
}
"
`;

exports[`../../../examples/invoicing/smithable.yml > file list and generated code > src/routes/welcome/index.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, Link, redirect, useNavigate } from "@tanstack/react-router";
import { createServerFn } from "@tanstack/react-start";
import { app } from "#/generated/app";
import { pageAccess } from "#/generated/pages";
import { createBusinessProfile, businessProfileSchema, businessProfileUi, type BusinessProfileValues } from "#/generated/business-profile";
import { businessProfileAccess, businessProfileData } from "#/generated/business-profile.server";
import { allows, guardPage } from "#/kit/access";
import { ModelForm } from "#/kit/ModelForm";
import { currentViewer } from "#/lib/viewer.server";
import { useState } from "react";
import { OnboardingLayout } from "#/kit/Onboarding";

/** The viewer's business profile: the first one they may read. */
const getWelcome = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  const row = (await businessProfileData.list(viewer)).at(-1) ?? null;
  return {
    row,
    canSave: row ? allows(businessProfileAccess.write, viewer, row.ownerId) : allows(businessProfileAccess.create, viewer),
  };
});

const steps = [
  {
    title: "Business",
    fields: ["businessName", "vatNumber"],
    schema: businessProfileSchema.pick({ businessName: true, vatNumber: true }),
  },
  {
    title: "Payment",
    fields: ["iban", "paymentTermDays"],
    schema: businessProfileSchema.pick({ iban: true, paymentTermDays: true }),
  },
];

export const Route = createFileRoute("/welcome/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["welcome"], context.viewer, location.href),
  loader: async () => {
    const found = await getWelcome();
    // Set up already: on to the app.
    if (found.row) throw redirect({ to: "/overview" });
    return found;
  },
  component: WelcomePage,
});

function WelcomePage() {
  const navigate = useNavigate();
  const [step, setStep] = useState(0);
  const [values, setValues] = useState<Partial<BusinessProfileValues>>({});
  const current = steps[step] as (typeof steps)[number];
  return (
    <OnboardingLayout
      title="Welcome to Invoicely"
      step={step}
      count={steps.length}
      stepTitle={current.title}
      footer={
        <Link to="/overview" className="font-semibold underline-offset-4 hover:underline">
          Do this later
        </Link>
      }
    >
      <ModelForm
        key={step}
        ui={{ ...businessProfileUi, fields: businessProfileUi.fields.filter((f) => current.fields.includes(f.name)) }}
        app={app}
        schema={current.schema}
        initial={current.fields.some((f) => f in values) ? values : undefined}
        submitLabel={step === steps.length - 1 ? "Finish" : "Continue"}
        onSubmit={async (stepValues) => {
          const all = { ...values, ...stepValues };
          if (step < steps.length - 1) {
            setValues(all);
            setStep(step + 1);
            return;
          }
          // Every required field is asked for in some step (smithable validate checks it).
          await createBusinessProfile({ data: all as BusinessProfileValues });
          await navigate({ to: "/overview" });
        }}
        onCancel={step > 0 ? () => setStep(step - 1) : undefined}
        cancelLabel="Back"
      />
    </OnboardingLayout>
  );
}
"
`;

