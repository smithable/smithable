exports[`../../../examples/booking/smithable.yml > file list and generated code > src/routes/schedule/index.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, useNavigate } from "@tanstack/react-router";
import { createServerFn } from "@tanstack/react-start";
import { and, gte, lt } from "drizzle-orm";
import { z } from "zod";
import { count, optional, type Search, shaped } from "#/kit/params";
import * as schema from "#/db/schema";
import { app } from "#/generated/app";
import { pageAccess, pageUi, pageHead } from "#/generated/pages";
import { sessionAccess, sessionData } from "#/generated/session.server";
import { allows, guardPage } from "#/kit/access";
import { PageHeader } from "#/kit/AppShell";
import { Calendar, calendarRange } from "#/kit/Calendar";
import { w } from "#/kit/words";
import { currentViewer } from "#/lib/viewer.server";
import { bookingPlaces, reserveBooking, deleteBooking } from "#/generated/booking";
import { Reserve } from "#/kit/Reserve";
import { classTypeData } from "#/generated/class-type.server";
import { sessionName } from "#/generated/session.name";

/** The sessions whose start falls in the range shown, among those the viewer may read. */
const getRange = createServerFn()
  // A real range, and no longer than a month view needs (six weeks and a day on each side).
  .validator(
    z
      .object({ from: z.iso.datetime(), to: z.iso.datetime() })
      .refine((r) => Date.parse(r.from) < Date.parse(r.to) && Date.parse(r.to) - Date.parse(r.from) <= 44 * 86_400_000, "The range is not a week or a month."),
  )
  .handler(async ({ data }) => {
    const viewer = await currentViewer();
    const rows = await sessionData.list(viewer, and(gte(schema.sessions.startsAt, new Date(data.from)), lt(schema.sessions.startsAt, new Date(data.to))));
    // How long each ClassType lasts, among those the viewer may read.
    const minutes = new Map((await classTypeData.list(viewer)).map((r) => [r.id, r.durationMinutes]));
    return {
      items: rows.map((row) => ({
        id: row.id,
        start: row.startsAt,
        end: new Date(row.startsAt.getTime() + (minutes.get(row.classTypeId) ?? 60) * 60_000),
        title: sessionName(row as Record<string, unknown>, ["startsAt"]),
      })),
      // Records are made on their page: the viewer must be able to open it, too.
      canCreate: allows(sessionAccess.create, viewer) && allows(pageAccess["sessions"], viewer),
      canOpen: allows(pageAccess["sessions"], viewer),
    };
  });

export const Route = createFileRoute("/schedule/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["schedule"], context.viewer, location.href),
  head: () => pageHead("schedule"),
  validateSearch: (s: Search) => optional({
    week: shaped(s.week, /^\\d{4}-W\\d{2}$/),
    month: shaped(s.month, /^\\d{4}-\\d{2}$/),
    // The record whose panel is open, so a sign-in or a link returns to it.
    open: count(s.open),
  }),
  // The period shown decides what is loaded; opening a record's panel loads nothing again.
  loaderDeps: ({ search: { open: _open, ...period } }) => period,
  loader: ({ deps }) => {
    const range = calendarRange(deps, app.timeZone);
    return getRange({ data: { from: range.from.toISOString(), to: range.to.toISOString() } });
  },
  component: SchedulePage,
});

function SchedulePage() {
  const { items, canCreate, canOpen } = Route.useLoaderData();
  const search = Route.useSearch();
  const navigate = useNavigate();
  return (
    <>
      <PageHeader page="schedule" title={pageUi["schedule"].title} />
      <Calendar
        search={search}
        items={items}
        timeZone={app.timeZone}
        dateOnly={false}
        newLabel={w.newOne("session")}
        details={(id) => <Reserve id={id} load={bookingPlaces} book={reserveBooking} cancel={deleteBooking} timeZone={app.timeZone} />}
        onNavigate={(next, replace) => navigate({ to: "/schedule", search: next, replace })}
        onOpen={canOpen ? (id) => navigate({ to: "/sessions/$id", params: { id: String(id) } }) : undefined}
        onCreate={
          canCreate
            ? (start) => navigate({ to: "/sessions/new", search: { startsAt: start } })
            : undefined
        }
      />
    </>
  );
}
"
`;

exports[`../../../examples/booking/smithable.yml > file list and generated code > src/routes/sessions/$id.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, Link, notFound, useNavigate } from "@tanstack/react-router";
import { createServerFn } from "@tanstack/react-start";
import { and, desc, eq } from "drizzle-orm";
import { db } from "#/db";
import { auditLog, user } from "#/db/schema";
import { app } from "#/generated/app";
import { pageAccess, pageHead } from "#/generated/pages";
import { deleteSession, getSession, sessionUi, updateSession } from "#/generated/session";
import { sessionSchema } from "#/generated/session.schema";
import { sessionName } from "#/generated/session.name";
import { bookingPlaces, bookingUi, deleteBooking, reserveBooking } from "#/generated/booking";
import { Reserve } from "#/kit/Reserve";
import { buttonVariants } from "#/components/ui/button";
import { classTypeOptions } from "#/generated/class-type";
import { instructorOptions } from "#/generated/instructor";
import { guardPage } from "#/kit/access";
import { ActivityLog } from "#/kit/ActivityLog";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";
import { w } from "#/kit/words";
import { currentViewer } from "#/lib/viewer.server";
import { ModelTable } from "#/kit/ModelTable";

/** The record's lines in the audit log, newest first: administrators only, nobody else. */
const getHistory = createServerFn()
  .validator((id: number) => id)
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    if (viewer?.role !== "admin") return null;
    const people = new Map(db.select({ id: user.id, name: user.name }).from(user).all().map((p) => [p.id, p.name]));
    return db
      .select()
      .from(auditLog)
      .where(and(eq(auditLog.model, "Session"), eq(auditLog.recordId, id)))
      .orderBy(desc(auditLog.id))
      .limit(50)
      .all()
      .map((r) => ({
        id: r.id,
        at: r.at,
        who: r.who === "visitor" || r.who === "the app" ? r.who : (people.get(r.who) ?? (r.who.startsWith("key:") ? w.aKey(r.who.slice(4)) : r.who.startsWith("timer:") ? w.byTimer(r.who.slice(6)) : w.aRemovedUser(r.who))),
        action: r.action,
        fields: r.fields,
        details: r.details ? Object.fromEntries(Object.entries(r.details).map(([k, v]) => [k, String(v)])) : null,
      }));
  });

export const Route = createFileRoute("/sessions/$id")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["sessions"], context.viewer, location.href),
  head: () => pageHead("sessions"),
  loader: async ({ params }) => {
    const found = await getSession({ data: Number(params.id) });
    if (!found) throw notFound();
    return { ...found, options: { classTypeId: await classTypeOptions(), instructorId: await instructorOptions() }, history: await getHistory({ data: Number(params.id) }) };
  },
  component: SessionPage,
});

function SessionPage() {
  const { row, canWrite, canDelete, canAdd, options, history } = Route.useLoaderData();
  const navigate = useNavigate();
  const back = () => navigate({ to: "/sessions" });
  return (
    <>
      <PageHeader title={sessionName(row as Record<string, unknown>)} />
      <ModelForm
        key={String(row.updatedAt)}
        ui={sessionUi}
        app={app}
        schema={sessionSchema}
        initial={row}
        readOnly={!canWrite}
        tells={[{"fields":["startsAt"],"list":"bookings","label":"Bookings"}]}
        options={options}
        submitLabel={w.saveChanges}
        onSubmit={async (values) => {
          await updateSession({ data: { id: row.id, values } });
          await back();
        }}
        onCancel={back}
        onDelete={
          canDelete
            ? async (together?: boolean) => {
                await deleteSession({ data: { id: row.id, together } });
                await back();
              }
            : undefined
        }
      />
      <section className="mt-10 max-w-3xl">
        <Reserve id={row.id} load={bookingPlaces} book={reserveBooking} cancel={deleteBooking} timeZone={app.timeZone} />
      </section>
      <section className="mt-10">
        <div className="mb-3 flex items-center justify-between gap-3">
          <h2 className="text-lg font-semibold">Bookings</h2>
          {row.bookings.length > 0 && canAdd?.bookings && (
              <Link to="/my-bookings/new" search={{ session: row.id }} className={buttonVariants({ variant: "outline" })}>
                {w.addOne("booking")}
              </Link>
            )}
        </div>
        <ModelTable
          ui={bookingUi}
          app={app}
          rows={row.bookings}
          hide={["sessionId"]}
          onOpen={(item) => navigate({ to: "/my-bookings/$id", params: { id: String(item.id) } })}
          emptyAction={canAdd?.bookings && (
              <Link to="/my-bookings/new" search={{ session: row.id }} className={buttonVariants({ variant: "outline" })}>
                {w.addOne("booking")}
              </Link>
            )}
          emptyMessage={canAdd?.bookings ? undefined : w.noneYet("bookings")}
        />
      </section>
      {history && history.length > 0 && (
        <section className="mt-10 max-w-3xl">
          <h2 className="mb-3 text-lg font-semibold">{w.history}</h2>
          <ActivityLog lines={history} app={app} />
        </section>
      )}
    </>
  );
}
"
`;

exports[`../../../examples/booking/smithable.yml > file list and generated code > src/routes/sessions/index.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, Link, useNavigate, useRouter } from "@tanstack/react-router";
import { pageAccess, pageUi, pageHead } from "#/generated/pages";
import { guardPage, allows } from "#/kit/access";
import { createServerFn } from "@tanstack/react-start";
import * as schema from "#/db/schema";
import { sessionAccess, sessionData } from "#/generated/session.server";
import { inArray, and } from "drizzle-orm";
import { inRange, orderOf } from "#/kit/filter";
import { app } from "#/generated/app";
import { withDefaults, type Search, count, listQuery, optional, text } from "#/kit/params";
import { classTypeData } from "#/generated/class-type.server";
import { instructorData } from "#/generated/instructor.server";
import { currentViewer } from "#/lib/viewer.server";
import { buttonVariants } from "#/components/ui/button";
import { useState } from "react";
import { SelectionBar } from "#/kit/SelectionBar";
import { csvName, csvOf, download } from "#/kit/csv";
import { deleteSessions, sessionDeleteRule, sessionUi } from "#/generated/session";
import { w } from "#/kit/words";
import { PageHeader } from "#/kit/AppShell";
import { ModelTable } from "#/kit/ModelTable";
import { Filters } from "#/kit/Filters";

/** The sessions matching the search and the filters, among those the viewer may read. */
const searchSessions = createServerFn()
  .validator(listQuery)
  .handler(async ({ data: given }) => {
    // The page's default filters, where the address says nothing ("all" clears one).
    const data = { ...given, f: withDefaults(given.f ?? {}, { startsAt: "upcoming" }) };
    const viewer = await currentViewer();
    const where = and(
      undefined,
      data.f?.classType ? inArray(schema.sessions.classTypeId, data.f?.classType.split(",").map(Number).filter(Number.isInteger)) : undefined,
      data.f?.instructor ? inArray(schema.sessions.instructorId, data.f?.instructor.split(",").map(Number).filter(Number.isInteger)) : undefined,
      data.f?.startsAt ? inRange(schema.sessions.startsAt, data.f?.startsAt, "instant", 1, app.timeZone) : undefined,
    );
    // The order the viewer chose, among the fields the page offers; else the newest first.
    const order = orderOf({ startsAt: schema.sessions.startsAt, capacity: schema.sessions.capacity }, data.sort);
    return {
      ...(await sessionData.page(viewer, where, order, data.all ? 1 : data.page, data.all ? (viewer ? 10000 : 500) : undefined)),
      canCreate: allows(sessionAccess.create, viewer),
      options: { classType: (await classTypeData.list(viewer)).map((r) => ({ value: String(r.id), label: String(r.name) })), instructor: (await instructorData.list(viewer)).map((r) => ({ value: String(r.id), label: String(r.name) })) },
    };
  });

export const Route = createFileRoute("/sessions/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["sessions"], context.viewer, location.href),
  head: () => pageHead("sessions"),
  validateSearch: (s: Search) => optional({ q: text(s.q), sort: text(s.sort), classType: text(s.classType), instructor: text(s.instructor), startsAt: text(s.startsAt), page: count(s.page) }),
  loaderDeps: ({ search }) => search,
  loader: ({ deps: { q, sort, page, ...f } }) => searchSessions({ data: { q, sort, f, page } }),
  // While a search or filter loads, the page stays (and its controls keep their focus).
  pendingMs: Number.POSITIVE_INFINITY,
  gcTime: 0,
  component: SessionsPage,
});

function SessionsPage() {
  const { rows, canCreate, total, page: at, size, options } = Route.useLoaderData();
  const { q, sort, page: _page, ...values } = Route.useSearch();
  const { viewer } = Route.useRouteContext();
  const navigate = useNavigate({ from: "/sessions/" });
  const router = useRouter();
  // The chosen rows, offered when the viewer may do something to at least one row.
  const [selected, setSelected] = useState<Set<number>>(new Set());
  const chosen = rows.filter((row) => selected.has(row.id));
  const selectable = rows.some((row) => allows(sessionDeleteRule, viewer, row.ownerId));
  const newButton = canCreate && (
    <Link to="/sessions/new" className={buttonVariants()}>
      {w.newOne("session")}
    </Link>
  );
  return (
    <>
      <PageHeader
        page="sessions"
        title={pageUi["sessions"].title}
        actions={newButton}
      />
      <Filters
        filters={[
  {
    name: "classType",
    label: "Class type",
    kind: "chips",
    options: options.classType,
  },
  {
    name: "instructor",
    label: "Instructor",
    kind: "chips",
    options: options.instructor,
  },
  { name: "startsAt", label: "Starts at", kind: "range", input: "date" },
]}
        values={values}
        defaults={{ startsAt: "upcoming" }}
        sorts={[
  { value: "startsAt", label: "Starts at, oldest first" },
  { value: "-startsAt", label: "Starts at, newest first" },
  { value: "capacity", label: "Capacity, low to high" },
  { value: "-capacity", label: "Capacity, high to low" },
]}
        sort={sort}
        onChange={(next) => navigate({ to: "/sessions", search: { q, ...next }, replace: true, resetScroll: false })}
      />
      {selectable && (
        <SelectionBar
          count={chosen.length}
          noun={["session", "sessions"]}
          app={app}
          titleOf={(id) => String(rows.find((row) => row.id === id)?.id ?? id)}
          actions={[]}
          deletable={chosen.filter((row) => allows(sessionDeleteRule, viewer, row.ownerId)).length}
          onDelete={(together) => deleteSessions({ data: { ids: chosen.map((row) => row.id), together } })}
          onDone={async () => {
            setSelected(new Set());
            await router.invalidate();
          }}
          onExport={() => download(csvName(sessionUi), csvOf(sessionUi, chosen))}
        />
      )}
      <ModelTable
        ui={sessionUi}
        page="sessions"
        paging={{ page: at, size, total, to: (next) => navigate({ to: "/sessions", search: (prev) => ({ ...prev, page: next > 1 ? next : undefined }) }) }}
        app={app}
        exportRows={async () => (await searchSessions({ data: { q, sort, f: values, all: true } })).rows}
        rows={rows}
        sorting={{ keys: { startsAt: "startsAt", capacity: "capacity" }, value: sort, onChange: (next) => navigate({ to: "/sessions", search: (prev) => ({ ...prev, sort: next, page: undefined }), replace: true, resetScroll: false }) }}
        selection={selectable ? { ids: selected, onChange: setSelected } : undefined}
        emptyMessage={q || Object.values(values).some(Boolean) ? "No sessions match the search and filters." : undefined}
        emptyAction={newButton || undefined}
        onOpen={(row) => navigate({ to: "/sessions/$id", params: { id: String(row.id) } })}
      />
    </>
  );
}
"
`;

exports[`../../../examples/booking/smithable.yml > file list and generated code > src/routes/sessions/new.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, useNavigate } from "@tanstack/react-router";
import { app } from "#/generated/app";
import { pageAccess, pageHead } from "#/generated/pages";
import { createSession, sessionUi } from "#/generated/session";
import { sessionSchema } from "#/generated/session.schema";
import { classTypeOptions } from "#/generated/class-type";
import { instructorOptions } from "#/generated/instructor";
import { guardPage } from "#/kit/access";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";
import { w } from "#/kit/words";
import { instantOf } from "#/kit/zoned";
import { count, optional, type Search, text } from "#/kit/params";

export const Route = createFileRoute("/sessions/new")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["sessions"], context.viewer, location.href),
  head: () => pageHead("sessions"),
  validateSearch: (s: Search) => optional({ startsAt: text(s.startsAt, 40), classType: count(s.classType), instructor: count(s.instructor) }),
  loader: async () => ({ options: { classTypeId: await classTypeOptions(), instructorId: await instructorOptions() } }),
  component: NewSessionPage,
});

function NewSessionPage() {
  const { options } = Route.useLoaderData();
  const search = Route.useSearch();
  const navigate = useNavigate();
  const back = () => search.classType ? navigate({ to: "/class-types/$id", params: { id: String(search.classType) } }) : search.instructor ? navigate({ to: "/instructors/$id", params: { id: String(search.instructor) } }) : navigate({ to: "/sessions" });
  return (
    <>
      <PageHeader title={w.newOne("session")} />
      <ModelForm
        ui={sessionUi}
        app={app}
        schema={sessionSchema}
        preset={{ ...(search.startsAt ? { startsAt: instantOf(search.startsAt, app.timeZone) } : {}), ...(search.classType ? { classTypeId: search.classType } : {}), ...(search.instructor ? { instructorId: search.instructor } : {}) }}
        fixed={[...(search.classType ? ["classTypeId"] : []), ...(search.instructor ? ["instructorId"] : [])]}
        options={options}
        submitLabel={w.createOne("session")}
        onSubmit={async (values) => {
          await createSession({ data: values });
          await back();
        }}
        onCancel={back}
      />
    </>
  );
}
"
`;

exports[`../../../examples/booking/smithable.yml > file list and generated code > src/routes/sign-in.tsx 1`] = `
"// Generated by Smithable from smithable.auth.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, useRouter } from "@tanstack/react-router";
import { createServerFn } from "@tanstack/react-start";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { eq } from "drizzle-orm";
import { db } from "#/db";
import { user } from "#/db/schema";
import { oneOf, optional, type Search, shaped } from "#/kit/params";
import { app } from "#/generated/app";
import { SignIn } from "#/kit/SignIn";
import { w } from "#/kit/words";
import { auth, codesReachPeople, configuredProviders, demoSignIn, mailKept, PROVIDERS } from "#/lib/auth";
import { authClient } from "#/lib/auth-client";

const ROLES = ["admin","member"] as const;

const signInOptions = createServerFn().handler(() => {
  const providers = configuredProviders();
  return { providers, missing: PROVIDERS.filter((p) => !providers.includes(p)), demo: demoSignIn, codes: codesReachPeople(), kept: mailKept() };
});

/** The development sign-in's passwords, by address, for this process only. */
const devPasswords = new Map<string, string>();

/** Development, or a demo: signs in as a user with the role, without a provider. */
const devSignIn = createServerFn({ method: "POST" })
  .validator((role: unknown) => {
    const known = oneOf(role, ROLES);
    if (!known) throw new Error("No such role.");
    return known;
  })
  .handler(async ({ data: role }) => {
    if (!import.meta.env.DEV && !demoSignIn) throw new Error(w.developmentOnlyNote);
    const prefix = demoSignIn && !import.meta.env.DEV ? "demo" : "dev";
    const email = \`\${prefix}-\${role}@example.com\`;
    // One password per user while this process runs, never a known one: nobody signs in as them
    // without this button, and two tabs signing in at once (Studio and its guide) use the same.
    const password = devPasswords.get(email) ?? crypto.randomUUID() + crypto.randomUUID();
    devPasswords.set(email, password);
    const context = await auth.$context;
    const made = () => db.select({ id: user.id }).from(user).where(eq(user.email, email)).get();
    if (!made()) {
      // Two tabs signing in at once (Studio and its guide): the other may make the user first.
      try {
        const created = await context.internalAdapter.createUser({ email, name: \`\${prefix === "demo" ? "Demo" : "Dev"} \${role}\`, emailVerified: true }, { method: "admin" });
        await context.internalAdapter.linkAccount({ providerId: "credential", accountId: created.id, password: await context.password.hash(password), userId: created.id });
      } catch (error) {
        if (!made()) throw error;
      }
    }
    db.update(user).set({ role }).where(eq(user.email, email)).run();
    const signIn = () => auth.api.signInEmail({ body: { email, password }, headers: getRequestHeaders() });
    // After a restart (or a password someone changed) the user's is another one: set anew.
    await signIn().catch(async () => {
      await context.internalAdapter.updatePassword(made()?.id as string, await context.password.hash(password));
      await signIn();
    });
  });

export const Route = createFileRoute("/sign-in")({
  // Only paths within the app, so the page cannot send anyone elsewhere.
  validateSearch: (s: Search) => optional({
    redirect: shaped(s.redirect, /^\\/(?!\\/)/),
  }),
  loader: () => signInOptions(),
  component: SignInPage,
});

function SignInPage() {
  const { providers, missing, demo, codes, kept } = Route.useLoaderData();
  const { redirect = "/" } = Route.useSearch();
  const router = useRouter();
  return (
    <SignIn
      appName={app.name}
      providers={providers}
      missing={missing}
      devRoles={import.meta.env.DEV || demo ? [...ROLES] : undefined}
      demo={demo}
      onProvider={async (provider) => {
        const { error } = await authClient.signIn.social({ provider, callbackURL: redirect });
        if (error) throw new Error(error.message);
      }}
      codes={codes}
      kept={kept}
      onSendCode={async (address) => {
        const { error } = await authClient.emailOtp.sendVerificationOtp({ email: address, type: "sign-in" });
        if (error) throw new Error(error.message);
      }}
      onCode={async (address, code) => {
        const { error } = await authClient.signIn.emailOtp({ email: address, otp: code.replace(/\\s/g, "") });
        if (error) throw new Error(error.message);
        await router.invalidate();
        await router.navigate({ href: redirect });
      }}
      onDevRole={async (role) => {
        await devSignIn({ data: role as (typeof ROLES)[number] });
        await router.invalidate();
        await router.navigate({ href: redirect });
      }}
    />
  );
}
"
`;

exports[`../../../examples/booking/smithable.yml > file list and generated code > src/routes/sitemap[.]xml.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute } from "@tanstack/react-router";
import { originOf } from "#/kit/origin";
import { postData } from "#/generated/post.server";

const PAGES = ["/","/schedule","/blog","/about","/privacy"];

const escape = (s: string) =>
  s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&apos;");

export const Route = createFileRoute("/sitemap.xml")({
  server: {
    handlers: {
      GET: async ({ request }) => {
        const origin = originOf(request);
        const entries: { loc: string; lastmod?: string | Date | null }[] = [
          ...PAGES.map((route) => ({ loc: route })),
    ...(await postData.list(null)).map((row) => ({ loc: \`/blog/\${encodeURIComponent(String(row.address || row.id))}\`, lastmod: row.updatedAt })),
        ];
        const body = \`<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
\${entries
  .map(
    (e) =>
      \`  <url><loc>\${escape(origin + e.loc)}</loc>\${e.lastmod ? \`<lastmod>\${new Date(e.lastmod).toISOString().slice(0, 10)}</lastmod>\` : ""}</url>\`,
  )
  .join("\\n")}
</urlset>
\`;
        return new Response(body, { headers: { "Content-Type": "application/xml; charset=utf-8" } });
      },
    },
  },
});
"
`;

