"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, notFound, useNavigate } from "@tanstack/react-router";
import { app } from "#/generated/app";
import { pageAccess } from "#/generated/pages";
import { bookingSchema, bookingUi, deleteBooking, getBooking, updateBooking } from "#/generated/booking";
import { sessionOptions } from "#/generated/session";
import { guardPage } from "#/kit/access";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";

export const Route = createFileRoute("/admin/bookings/$id")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["admin"], context.viewer, location.href),
  loader: async ({ params }) => {
    const found = await getBooking({ data: Number(params.id) });
    if (!found) throw notFound();
    return { ...found, options: { sessionId: await sessionOptions() } };
  },
  component: BookingPage,
});

function BookingPage() {
  const { row, canWrite, canDelete, options } = Route.useLoaderData();
  const navigate = useNavigate();
  const back = () => navigate({ to: "/admin/bookings" });
  return (
    <>
      <PageHeader title={\`Booking #\${row.id}\`} />
      <ModelForm
        ui={bookingUi}
        app={app}
        schema={bookingSchema}
        initial={row}
        readOnly={!canWrite}
        options={options}
        submitLabel="Save changes"
        onSubmit={async (values) => {
          await updateBooking({ data: { id: row.id, values } });
          await back();
        }}
        onCancel={back}
        onDelete={
          canDelete
            ? async () => {
                await deleteBooking({ data: row.id });
                await back();
              }
            : undefined
        }
      />

    </>
  );
}
"
`;

