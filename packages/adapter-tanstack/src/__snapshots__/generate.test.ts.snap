"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { z } from "zod";
import type * as schema from "#/db/schema";
import { allows, type Rule } from "#/kit/access";
import type { RecordUi } from "#/kit/model";
import { invoiceLineDefaults, withInvoiceLineFormulas } from "./invoice-line.formulas";
import { invoiceLineAccess, invoiceLineData } from "./invoice-line.server";
import { writeAllowed } from "#/kit/limit";
import { currentViewer } from "#/lib/viewer.server";
import { invoiceLineSchema } from "./invoice-line.schema";

export type { InvoiceLineSettable, InvoiceLineValues } from "./invoice-line.schema";

/** The viewer about to write, counted against how often one may (see src/kit/limit.ts). */
async function writer() {
  const viewer = await currentViewer();
  writeAllowed(viewer, getRequestHeaders());
  return viewer;
}

/** InvoiceLine records as the kit reads them. */
export type InvoiceLineRow = typeof schema.invoiceLines.$inferSelect & {
  invoice?: { id: number; number: string } | null;
  amount?: unknown;
};

export const invoiceLineUi: RecordUi<InvoiceLineRow> = {
  model: "InvoiceLine",
  label: "Invoice line",
  pluralLabel: "Invoice lines",
  titleField: "description",
  columns: ["description", "invoiceId", "quantity", "unitPrice", "amount"],
  fields: [
    {
      name: "invoiceId",
      label: "Invoice",
      kind: "relation",
      required: true,
      relation: { key: "invoice", titleField: "number" },
      get: (row) => row.invoice?.number ?? null,
    },
    {
      name: "description",
      label: "Description",
      kind: "string",
      required: true,
      get: (row) => row.description,
    },
    {
      name: "quantity",
      label: "Quantity",
      kind: "decimal",
      required: true,
      default: 1,
      get: (row) => row.quantity,
    },
    {
      name: "unitPrice",
      label: "Unit price",
      kind: "money",
      required: true,
      get: (row) => row.unitPrice,
    },
    {
      name: "amount",
      label: "Amount",
      kind: "money",
      required: false,
      computed: true,
      get: (row) => row.amount,
    },
  ],
  compute: withInvoiceLineFormulas,
  defaults: invoiceLineDefaults,
};

/** Who may delete invoice lines: a list's selection offers Delete by it (the server checks again). */
export const invoiceLineDeleteRule: Rule = { public: false, roles: ["admin"], owner: true };


export const listInvoiceLines = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return { rows: await invoiceLineData.list(viewer), canCreate: allows(invoiceLineAccess.create, viewer) };
});

export const getInvoiceLine = createServerFn()
  .validator(z.number().int())
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    const row = await invoiceLineData.get(viewer, id);
    if (!row) return null;
    return {
      row,
      canWrite: allows(invoiceLineAccess.write, viewer, row.ownerId),
      canDelete: allows(invoiceLineAccess.delete, viewer, row.ownerId),
    };
  });

export const createInvoiceLine = createServerFn({ method: "POST" })
  .validator(invoiceLineSchema)
  .handler(async ({ data }) => invoiceLineData.create(await writer(), data));

export const updateInvoiceLine = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), values: invoiceLineSchema }))
  .handler(async ({ data }) => invoiceLineData.update(await writer(), data.id, data.values));

/** Deletes a invoice line; \`together\` takes what points to it along (docs/design/delete-together.md). */
export const deleteInvoiceLine = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), together: z.boolean().optional() }))
  .handler(async ({ data }) => invoiceLineData.remove(await writer(), data.id, data.together));

/** Deletes the chosen invoice lines, all or none (at most 1,000 at once). */
export const deleteInvoiceLines = createServerFn({ method: "POST" })
  .validator(z.object({ ids: z.array(z.number().int()).max(1000), together: z.boolean().optional() }))
  .handler(async ({ data }) => invoiceLineData.removeMany(await writer(), data.ids, data.together));
"
`;

exports[`../../../examples/invoicing/smithable.yml > file list and generated code > src/generated/outgoing.server.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { eq } from "drizzle-orm";
import type { SQLiteColumn, SQLiteTable } from "drizzle-orm/sqlite-core";
import type { db } from "#/db";
import * as schema from "#/db/schema";
import { app } from "#/generated/app";
import type { Viewer } from "#/kit/access";
import { formatValue } from "#/kit/format";
import { counts } from "#/kit/outgoing";
import { type Happening, queueMail, type Recipient } from "#/kit/outgoing.server";

type Tx = Pick<typeof db, "select" | "insert">;
type Row = Record<string, unknown>;

/** One column of the record with the id, inside the transaction. */
function one(tx: Tx, table: SQLiteTable, id: SQLiteColumn, column: SQLiteColumn, value: unknown): unknown {
  if (value == null) return undefined;
  return tx.select({ v: column }).from(table).where(eq(id, value)).get()?.v;
}

/** Each model's record as a mail shows it: the subject, its fields, its page. */
const SHOWN: Record<string, (tx: Tx, r: Row) => Omit<Happening, "entry" | "model" | "record">> = {
  "Invoice": (tx, r) => ({
    subject: \`Invoice: \${String(r.number ?? r.id)}\`,
    fields: [
      ["Number", formatValue({ name: "number", label: "Number", kind: "string", required: false }, r.number, app)],
      ["Client", String(one(tx, schema.clients, schema.clients.id, schema.clients.name, r.clientId) ?? "—")],
      ["Issued on", formatValue({ name: "issuedOn", label: "Issued on", kind: "date", required: false }, r.issuedOn, app)],
      ["Due on", formatValue({ name: "dueOn", label: "Due on", kind: "date", required: false }, r.dueOn, app)],
      ["Status", formatValue({
  name: "status",
  label: "Status",
  kind: "choice",
  required: false,
  choices: [
    { value: "draft", label: "Draft" },
    { value: "sent", label: "Sent" },
    { value: "paid", label: "Paid" },
    { value: "overdue", label: "Overdue" },
  ],
}, r.status, app)],
    ],
    link: \`/invoices/\${r.id}\`,
  }),
};

/** The entries of smithable.yml's outgoing section, with their texts. */
const ENTRIES: {
  name: string;
  model: string;
  when: string;
  fits?: (r: Row) => boolean;
  /** For a change: only one of these fields changing counts. */
  fields?: string[];
  subject?: string;
  text?: string;
  to?: (tx: Tx, r: Row) => Recipient[];
}[] = [
  {
    name: "invoiceSent",
    model: "Invoice",
    when: "markSent",
    to: (tx, r) => [{ email: one(tx, schema.clients, schema.clients.id, schema.clients.email, r.clientId) as string | null }],
  },
];

/**
 * Queues what a change asks for, in its transaction: \`what\` is created, changed, deleted or the
 * action's name; \`record\` the record after (a deleted one as it was), \`before\` before a change.
 */
export function outgoing(tx: Tx, viewer: Viewer | null, model: string, what: string, record: Row, before?: Row): void {
  for (const entry of ENTRIES) {
    if (entry.model !== model || !counts(entry.when, what, entry.fits, record, before, entry.fields)) continue;
    const shown = SHOWN[model]?.(tx, record);
    if (!shown || !entry.to) continue;
    queueMail(
      tx,
      viewer,
      { ...shown, ...(entry.subject ? { subject: entry.subject } : {}), ...(entry.text ? { text: entry.text } : {}), entry: entry.name, model, record: record.id as number },
      entry.to(tx, record),
      entry.when === "created",
    );
  }
}
"
`;

