"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, useNavigate } from "@tanstack/react-router";
import { app } from "#/generated/app";
import { pageAccess, pageHead } from "#/generated/pages";
import { createSession, sessionUi } from "#/generated/session";
import { sessionSchema } from "#/generated/session.schema";
import { classTypeOptions } from "#/generated/class-type";
import { instructorOptions } from "#/generated/instructor";
import { guardPage } from "#/kit/access";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";
import { w } from "#/kit/words";
import { instantOf } from "#/kit/zoned";
import { count, optional, type Search, text } from "#/kit/params";

export const Route = createFileRoute("/admin/sessions/new")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["admin"], context.viewer, location.href),
  head: () => pageHead("admin"),
  validateSearch: (s: Search) => optional({ startsAt: text(s.startsAt, 40), classType: count(s.classType), instructor: count(s.instructor) }),
  loader: async () => ({ options: { classTypeId: await classTypeOptions(), instructorId: await instructorOptions() } }),
  component: NewSessionPage,
});

function NewSessionPage() {
  const { options } = Route.useLoaderData();
  const search = Route.useSearch();
  const navigate = useNavigate();
  const back = () => search.classType ? navigate({ to: "/class-types/$id", params: { id: String(search.classType) } }) : search.instructor ? navigate({ to: "/instructors/$id", params: { id: String(search.instructor) } }) : navigate({ to: "/admin/sessions" });
  return (
    <>
      <PageHeader title={w.newOne("session")} />
      <ModelForm
        ui={sessionUi}
        app={app}
        schema={sessionSchema}
        preset={{ ...(search.startsAt ? { startsAt: instantOf(search.startsAt, app.timeZone) } : {}), ...(search.classType ? { classTypeId: search.classType } : {}), ...(search.instructor ? { instructorId: search.instructor } : {}) }}
        fixed={[...(search.classType ? ["classTypeId"] : []), ...(search.instructor ? ["instructorId"] : [])]}
        options={options}
        submitLabel={w.createOne("session")}
        onSubmit={async (values) => {
          await createSession({ data: values });
          await back();
        }}
        onCancel={back}
      />
    </>
  );
}
"
`;

exports[`../../../examples/booking/smithable.yml > file list and generated code > src/routes/blog/$address.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { z } from "zod";
import { postAccess, postData } from "#/generated/post.server";
import { type PostRow } from "#/generated/post";
import { allows, guardPage } from "#/kit/access";
import { currentViewer } from "#/lib/viewer.server";
import { pageAccess } from "#/generated/pages";
import { createFileRoute, notFound } from "@tanstack/react-router";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { ArticleView } from "#/kit/Articles";
import { LandingLayout } from "#/kit/Landing";
import { app } from "#/generated/app";
import { site } from "#/generated/site";

// The row type from the model's module: a type of the data function would keep its server
// import in the page's code.
type Row = PostRow;

/** When an article appeared, for ordering: its publishedOn. */
const when = (row: Row) => (row.publishedOn ? new Date(\`\${row.publishedOn}T00:00:00Z\`).getTime() : 0);
const dateText = (row: Row) =>
  row.publishedOn ? new Intl.DateTimeFormat("en", { dateStyle: "long", timeZone: "UTC" }).format(new Date(\`\${row.publishedOn}T00:00:00Z\`)) : undefined;
/** An article's address under the page: its address. */
const addressOf = (row: Row) => row.address || String(row.id);
const hrefOf = (row: Row) => \`/blog/\${encodeURIComponent(addressOf(row))}\`;
/** The summary, else the body's first paragraph without its marks. */
const summaryOf = (row: Row) => {
  const first = (row.body ?? "").split(/\\n\\s*\\n/).find((b) => b.trim() && !b.trim().startsWith("#")) ?? "";
  const text = row.summary || first;
  const plain = text.replace(/[#*_\`>[\\]]|\\(https?:[^)]*\\)/g, "").trim();
  return plain.length > 200 ? \`\${plain.slice(0, 199)}…\` : plain || undefined;
};
const cardOf = (row: Row) => ({
  href: hrefOf(row),
  title: String(row.title ?? ""),
  summary: summaryOf(row),
  date: dateText(row),
  picture: row.cover ? { src: \`/files/post/\${row.id}/cover\`, alt: row.cover.alt, width: row.cover.width, height: row.cover.height, generated: row.cover.generated } : undefined,
});

/** Newest first: by when they appeared, then by creation. */
const newestFirst = (rows: Row[]) => [...rows].sort((a, b) => when(b) - when(a) || b.id - a.id);

const getArticle = createServerFn()
  .validator(z.string().max(200))
  .handler(async ({ data: address }) => {
    // In the handler: the data function is the server's alone.
    const viewer = await currentViewer();
    const rows = newestFirst(await postData.list(viewer));
    const i = rows.findIndex((row) => addressOf(row) === address);
    const row = rows[i];
    if (!row) return null;
    const newer = rows[i - 1];
    const older = rows[i + 1];
    // The site's address, for the picture in links shared elsewhere (og:image).
    const headers = getRequestHeaders();
    const origin = \`\${headers.get("x-forwarded-proto") ?? "http"}://\${headers.get("x-forwarded-host") ?? headers.get("host")}\`;
    return {
      origin,
      article: {
        ...cardOf(row),
        body: String(row.body ?? ""),
        author: undefined,
      },
      previous: older ? { href: hrefOf(older), title: String(older.title ?? "") } : undefined,
      next: newer ? { href: hrefOf(newer), title: String(newer.title ?? "") } : undefined,
      edit: allows(postAccess.write, viewer, row.ownerId) && allows(pageAccess["posts"], viewer) ? \`/posts/\${row.id}\` : undefined,
    };
  });

export const Route = createFileRoute("/blog/$address")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["blog"], context.viewer, location.href),
  loader: async ({ params }) => {
    const found = await getArticle({ data: params.address });
    if (!found) throw notFound();
    return found;
  },
  // What a link to the article shows in chat apps and search: its title, summary and picture.
  head: ({ loaderData }) => ({
    meta: loaderData
      ? [
          { title: loaderData.article.title },
          ...(loaderData.article.summary ? [{ name: "description", content: loaderData.article.summary }] : []),
          { property: "og:title", content: loaderData.article.title },
          ...(loaderData.article.picture
            ? [{ property: "og:image", content: loaderData.origin + loaderData.article.picture.src }]
            : []),
        ]
      : [],
  }),
  component: ArticlePage,
});

function ArticlePage() {
  const { article, previous, next, edit } = Route.useLoaderData();
  const view = (
    <ArticleView
      title={article.title}
      date={article.date}
      author={article.author}
      picture={article.picture}
      body={article.body}
      previous={previous}
      next={next}
      edit={edit}
    />
  );
  return (
    <LandingLayout appName={app.name} site={site}>
      <div className="px-5 py-12">{view}</div>
    </LandingLayout>
  );
}
"
`;

exports[`../../../examples/booking/smithable.yml > file list and generated code > src/routes/blog/index.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { z } from "zod";
import { postAccess, postData } from "#/generated/post.server";
import { type PostRow } from "#/generated/post";
import { allows, guardPage } from "#/kit/access";
import { currentViewer } from "#/lib/viewer.server";
import { pageAccess, pageUi, pageHead } from "#/generated/pages";
import { createFileRoute } from "@tanstack/react-router";
import { ArticleList } from "#/kit/Articles";
import { count, optional, type Search } from "#/kit/params";
import { LandingLayout } from "#/kit/Landing";
import { app } from "#/generated/app";
import { site } from "#/generated/site";

// The row type from the model's module: a type of the data function would keep its server
// import in the page's code.
type Row = PostRow;

/** When an article appeared, for ordering: its publishedOn. */
const when = (row: Row) => (row.publishedOn ? new Date(\`\${row.publishedOn}T00:00:00Z\`).getTime() : 0);
const dateText = (row: Row) =>
  row.publishedOn ? new Intl.DateTimeFormat("en", { dateStyle: "long", timeZone: "UTC" }).format(new Date(\`\${row.publishedOn}T00:00:00Z\`)) : undefined;
/** An article's address under the page: its address. */
const addressOf = (row: Row) => row.address || String(row.id);
const hrefOf = (row: Row) => \`/blog/\${encodeURIComponent(addressOf(row))}\`;
/** The summary, else the body's first paragraph without its marks. */
const summaryOf = (row: Row) => {
  const first = (row.body ?? "").split(/\\n\\s*\\n/).find((b) => b.trim() && !b.trim().startsWith("#")) ?? "";
  const text = row.summary || first;
  const plain = text.replace(/[#*_\`>[\\]]|\\(https?:[^)]*\\)/g, "").trim();
  return plain.length > 200 ? \`\${plain.slice(0, 199)}…\` : plain || undefined;
};
const cardOf = (row: Row) => ({
  href: hrefOf(row),
  title: String(row.title ?? ""),
  summary: summaryOf(row),
  date: dateText(row),
  picture: row.cover ? { src: \`/files/post/\${row.id}/cover\`, alt: row.cover.alt, width: row.cover.width, height: row.cover.height, generated: row.cover.generated } : undefined,
});

/** Newest first: by when they appeared, then by creation. */
const newestFirst = (rows: Row[]) => [...rows].sort((a, b) => when(b) - when(a) || b.id - a.id);

const getArticles = createServerFn()
  .validator(z.number().int().min(1))
  .handler(async ({ data: page }) => {
    // In the handler: the data function is the server's alone.
    const viewer = await currentViewer();
    const rows = newestFirst(await postData.list(viewer));
    const start = (page - 1) * 12;
    return {
      items: rows.slice(start, start + 12).map(cardOf),
      more: rows.length > start + 12,
      canCreate: allows(postAccess.create, viewer),
    };
  });

export const Route = createFileRoute("/blog/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["blog"], context.viewer, location.href),
  head: () => pageHead("blog"),
  validateSearch: (s: Search) => optional({ page: count(s.page) }),
  loaderDeps: ({ search }) => ({ page: search.page ?? 1 }),
  loader: ({ deps }) => getArticles({ data: deps.page }),
  component: ArticlesPage,
});

function ArticlesPage() {
  const { items, more } = Route.useLoaderData();
  const { page = 1 } = Route.useSearch();
  const list = (
    <ArticleList
      items={items}
      older={more ? \`?page=\${page + 1}\` : undefined}
      newer={page > 1 ? (page === 2 ? "/blog" : \`?page=\${page - 1}\`) : undefined}
    />
  );
  return (
    <LandingLayout appName={app.name} site={site}>
      <div className="mx-auto max-w-6xl px-5 py-12">
        <h1 className="mb-6 text-3xl font-bold">{pageUi["blog"].title}</h1>
        {list}
      </div>
    </LandingLayout>
  );
}
"
`;

exports[`../../../examples/booking/smithable.yml > file list and generated code > src/routes/class-types/$id.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, Link, notFound, useNavigate } from "@tanstack/react-router";
import { createServerFn } from "@tanstack/react-start";
import { and, desc, eq } from "drizzle-orm";
import { db } from "#/db";
import { auditLog, user } from "#/db/schema";
import { app } from "#/generated/app";
import { pageAccess, pageHead } from "#/generated/pages";
import { classTypeUi, deleteClassType, getClassType, updateClassType } from "#/generated/class-type";
import { classTypeSchema } from "#/generated/class-type.schema";
import { buttonVariants } from "#/components/ui/button";
import { sessionUi } from "#/generated/session";
import { guardPage } from "#/kit/access";
import { ActivityLog } from "#/kit/ActivityLog";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";
import { w } from "#/kit/words";
import { currentViewer } from "#/lib/viewer.server";
import { ModelTable } from "#/kit/ModelTable";

/** The record's lines in the audit log, newest first: administrators only, nobody else. */
const getHistory = createServerFn()
  .validator((id: number) => id)
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    if (viewer?.role !== "admin") return null;
    const people = new Map(db.select({ id: user.id, name: user.name }).from(user).all().map((p) => [p.id, p.name]));
    return db
      .select()
      .from(auditLog)
      .where(and(eq(auditLog.model, "ClassType"), eq(auditLog.recordId, id)))
      .orderBy(desc(auditLog.id))
      .limit(50)
      .all()
      .map((r) => ({
        id: r.id,
        at: r.at,
        who: r.who === "visitor" || r.who === "the app" ? r.who : (people.get(r.who) ?? (r.who.startsWith("key:") ? w.aKey(r.who.slice(4)) : r.who.startsWith("timer:") ? w.byTimer(r.who.slice(6)) : w.aRemovedUser(r.who))),
        action: r.action,
        fields: r.fields,
        details: r.details ? Object.fromEntries(Object.entries(r.details).map(([k, v]) => [k, String(v)])) : null,
      }));
  });

export const Route = createFileRoute("/class-types/$id")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["class-types"], context.viewer, location.href),
  head: () => pageHead("class-types"),
  loader: async ({ params }) => {
    const found = await getClassType({ data: Number(params.id) });
    if (!found) throw notFound();
    return { ...found, history: await getHistory({ data: Number(params.id) }) };
  },
  component: ClassTypePage,
});

function ClassTypePage() {
  const { row, canWrite, canDelete, canAdd, history } = Route.useLoaderData();
  const navigate = useNavigate();
  const back = () => navigate({ to: "/class-types" });
  return (
    <>
      <PageHeader title={row.name || \`Class type #\${row.id}\`} />
      <ModelForm
        key={String(row.updatedAt)}
        ui={classTypeUi}
        app={app}
        schema={classTypeSchema}
        initial={row}
        readOnly={!canWrite}
        submitLabel={w.saveChanges}
        onSubmit={async (values) => {
          await updateClassType({ data: { id: row.id, values } });
          await back();
        }}
        onCancel={back}
        onDelete={
          canDelete
            ? async (together?: boolean) => {
                await deleteClassType({ data: { id: row.id, together } });
                await back();
              }
            : undefined
        }
      />
      <section className="mt-10">
        <div className="mb-3 flex items-center justify-between gap-3">
          <h2 className="text-lg font-semibold">Sessions</h2>
          {row.sessions.length > 0 && canAdd?.sessions && (
              <Link to="/sessions/new" search={{ classType: row.id }} className={buttonVariants({ variant: "outline" })}>
                {w.addOne("session")}
              </Link>
            )}
        </div>
        <ModelTable
          ui={sessionUi}
          app={app}
          rows={row.sessions}
          hide={["classTypeId"]}
          onOpen={(item) => navigate({ to: "/sessions/$id", params: { id: String(item.id) } })}
          emptyAction={canAdd?.sessions && (
              <Link to="/sessions/new" search={{ classType: row.id }} className={buttonVariants({ variant: "outline" })}>
                {w.addOne("session")}
              </Link>
            )}
          emptyMessage={canAdd?.sessions ? undefined : w.noneYet("sessions")}
        />
      </section>
      {history && history.length > 0 && (
        <section className="mt-10 max-w-3xl">
          <h2 className="mb-3 text-lg font-semibold">{w.history}</h2>
          <ActivityLog lines={history} app={app} />
        </section>
      )}
    </>
  );
}
"
`;

exports[`../../../examples/booking/smithable.yml > file list and generated code > src/routes/class-types/index.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, Link, useNavigate, useRouter } from "@tanstack/react-router";
import { pageAccess, pageUi, pageHead } from "#/generated/pages";
import { guardPage, allows } from "#/kit/access";
import { createServerFn } from "@tanstack/react-start";
import * as schema from "#/db/schema";
import { classTypeAccess, classTypeData } from "#/generated/class-type.server";
import { inArray, and } from "drizzle-orm";
import { currentViewer } from "#/lib/viewer.server";
import { type Search, count, listQuery, optional, text } from "#/kit/params";
import { buttonVariants } from "#/components/ui/button";
import { useState } from "react";
import { SelectionBar } from "#/kit/SelectionBar";
import { csvName, csvOf, download } from "#/kit/csv";
import { deleteClassTypes, classTypeDeleteRule, classTypeUi } from "#/generated/class-type";
import { app } from "#/generated/app";
import { w } from "#/kit/words";
import { PageHeader } from "#/kit/AppShell";
import { ModelTable } from "#/kit/ModelTable";
import { Filters } from "#/kit/Filters";

/** The class types matching the search and the filters, among those the viewer may read. */
const searchClassTypes = createServerFn()
  .validator(listQuery)
  .handler(async ({ data }) => {
    const viewer = await currentViewer();
    const where = and(
      undefined,
      data.f?.level ? inArray(schema.classTypes.level, data.f?.level.split(",").filter((v) => ["beginner", "allLevels", "advanced"].includes(v)) as ("beginner" | "allLevels" | "advanced")[]) : undefined,
    );
    return {
      ...(await classTypeData.page(viewer, where, undefined, data.all ? 1 : data.page, data.all ? (viewer ? 10000 : 500) : undefined)),
      canCreate: allows(classTypeAccess.create, viewer),
      options: {  },
    };
  });

export const Route = createFileRoute("/class-types/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["class-types"], context.viewer, location.href),
  head: () => pageHead("class-types"),
  validateSearch: (s: Search) => optional({ q: text(s.q), sort: text(s.sort), level: text(s.level), page: count(s.page) }),
  loaderDeps: ({ search }) => search,
  loader: ({ deps: { q, sort, page, ...f } }) => searchClassTypes({ data: { q, sort, f, page } }),
  // While a search or filter loads, the page stays (and its controls keep their focus).
  pendingMs: Number.POSITIVE_INFINITY,
  gcTime: 0,
  component: ClassTypesPage,
});

function ClassTypesPage() {
  const { rows, canCreate, total, page: at, size } = Route.useLoaderData();
  const { q, sort, page: _page, ...values } = Route.useSearch();
  const { viewer } = Route.useRouteContext();
  const navigate = useNavigate({ from: "/class-types/" });
  const router = useRouter();
  // The chosen rows, offered when the viewer may do something to at least one row.
  const [selected, setSelected] = useState<Set<number>>(new Set());
  const chosen = rows.filter((row) => selected.has(row.id));
  const selectable = rows.some((row) => allows(classTypeDeleteRule, viewer, row.ownerId));
  const newButton = canCreate && (
    <Link to="/class-types/new" className={buttonVariants()}>
      {w.newOne("class type")}
    </Link>
  );
  return (
    <>
      <PageHeader
        page="class-types"
        title={pageUi["class-types"].title}
        actions={newButton}
      />
      <Filters
        filters={[
  {
    name: "level",
    label: "Level",
    kind: "chips",
    options: classTypeUi.fields.find((f) => f.name === "level")?.choices,
  },
]}
        values={values}
        onChange={(next) => navigate({ to: "/class-types", search: { q, ...next }, replace: true, resetScroll: false })}
      />
      {selectable && (
        <SelectionBar
          count={chosen.length}
          noun={["class type", "class types"]}
          app={app}
          titleOf={(id) => String(rows.find((row) => row.id === id)?.name ?? id)}
          actions={[]}
          deletable={chosen.filter((row) => allows(classTypeDeleteRule, viewer, row.ownerId)).length}
          onDelete={(together) => deleteClassTypes({ data: { ids: chosen.map((row) => row.id), together } })}
          onDone={async () => {
            setSelected(new Set());
            await router.invalidate();
          }}
          onExport={() => download(csvName(classTypeUi), csvOf(classTypeUi, chosen))}
        />
      )}
      <ModelTable
        ui={classTypeUi}
        page="class-types"
        paging={{ page: at, size, total, to: (next) => navigate({ to: "/class-types", search: (prev) => ({ ...prev, page: next > 1 ? next : undefined }) }) }}
        app={app}
        exportRows={async () => (await searchClassTypes({ data: { q, sort, f: values, all: true } })).rows}
        rows={rows}
        selection={selectable ? { ids: selected, onChange: setSelected } : undefined}
        emptyMessage={q || Object.values(values).some(Boolean) ? "No class types match the search and filters." : undefined}
        emptyAction={newButton || undefined}
        onOpen={(row) => navigate({ to: "/class-types/$id", params: { id: String(row.id) } })}
      />
    </>
  );
}
"
`;

