exports[`../../../examples/support/smithable.yml > file list and generated code > src/routes/incoming/support.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// Incoming call "support" (smithable.yml incoming): another service calls this address
// with its secret; the secret is the setting INCOMING_SUPPORT_SECRET.
import { createHash, timingSafeEqual } from "node:crypto";
import { createFileRoute } from "@tanstack/react-router";
import { and, desc, eq, gt, inArray } from "drizzle-orm";
import { db } from "#/db";
import { incomingSeen, mailThreads } from "#/db/schema";
import { AccessDenied, type Viewer } from "#/kit/access";
import { supportCaseData } from "#/generated/support-case.server";
import { supportCaseSchema } from "#/generated/support-case.schema";
import { messageData } from "#/generated/message.server";
import { messageSchema } from "#/generated/message.schema";
import { fromMail } from "#/generated/outgoing.server";
import { BadFile, deleteFile, FILE_MAX_BYTES, roomFor, saveFile, scanned, type StoredFile } from "#/kit/uploads";

const NAME = "support";
const DAY = 86_400_000;
/** The call acts as this role; nothing it adds is anyone's own (a "key:" id owns nothing, as a key's). */
const caller: Viewer = { id: "key:incoming-support", name: NAME, email: "", role: "admin" };

const answer = (status: number, body: unknown) =>
  new Response(JSON.stringify(body), { status, headers: { "content-type": "application/json" } });
// Both sides hashed first: the same length whatever was sent, so the compare tells nothing of it.
const digest = (s: string) => createHash("sha256").update(s).digest();
const same = (a: string, b: string) => timingSafeEqual(digest(a), digest(b));

/** The mail a host passes on: from, to, subject, text, html, attachments ({ name, type, data }). */
type Mail = { from?: unknown; to?: unknown; subject?: unknown; text?: unknown; html?: unknown; attachments?: unknown; messageId?: unknown; inReplyTo?: unknown; references?: unknown; autoSubmitted?: unknown };
const text = (v: unknown) => (typeof v === "string" ? v : "");
/** "Ada <ada@example.com>" → ada@example.com. */
const address = (v: unknown) => (/<([^<>]+)>/.exec(text(v))?.[1] ?? text(v)).trim();
/** The mail's text, or its HTML without the tags when it has no text. */
const bodyOf = (mail: Mail) =>
  text(mail.text) || text(mail.html).replace(/<script\\b[^>]*>[\\s\\S]*?<\\/script>/gi, " ").replace(/<style\\b[^>]*>[\\s\\S]*?<\\/style>/gi, " ").replace(/<[^>]*>/g, " ").replace(/\\s+/g, " ").trim();
/** Each attachment checked and kept as an upload is; one too large or refused is the answer instead. */
async function saved(mail: Mail, model: string, uses: (file: string) => boolean): Promise<StoredFile[] | Response> {
  const files: StoredFile[] = [];
  const parts = Array.isArray(mail.attachments) ? mail.attachments : [];
  if (parts.length > 10) return answer(413, { error: "Too many attachments (over 10)." });
  for (const one of parts) {
    const { name, data } = one as { name?: unknown; data?: unknown };
    const bytes = Buffer.from(text(data), "base64");
    if (bytes.byteLength === 0) continue;
    if (bytes.byteLength > FILE_MAX_BYTES || !roomFor(bytes.byteLength)) {
      for (const f of files) deleteFile(f, uses(f.file));
      return answer(413, { error: \`\${text(name) || "An attachment"} is too large or storage is full.\` });
    }
    try {
      await scanned(bytes);
      files.push(saveFile(model, bytes, text(name) || "attachment"));
    } catch (error) {
      for (const f of files) deleteFile(f, uses(f.file));
      if (error instanceof BadFile) return answer(422, { error: error.message });
      throw error;
    }
  }
  return files;
}
/** The mail's own id, kept in its record's thread so an answer to it finds the record. */
function keeper(mailId: string) {
  return (record: number) => {
    if (!mailId) return;
    const kept = db.select({ id: mailThreads.id }).from(mailThreads).where(and(eq(mailThreads.model, "SupportCase"), eq(mailThreads.messageId, mailId))).get();
    if (!kept) db.insert(mailThreads).values({ model: "SupportCase", recordId: record, messageId: mailId, received: true }).run();
  };
}

export const Route = createFileRoute("/incoming/support")({
  server: {
    handlers: {
      POST: async ({ request }) => {
        const secret = process.env.INCOMING_SUPPORT_SECRET;
        if (!secret) {
          console.error("Incoming call failed: INCOMING_SUPPORT_SECRET is not set.");
          return answer(401, { error: "Wrong secret or signature." });
        }
        const raw = await request.text();
        const given = request.headers.get("authorization") ?? "";
        const expected = \`Bearer \${secret}\`;
        if (!same(given, expected)) return answer(401, { error: "Wrong secret or signature." });
        let body: unknown;
        try {
          body = raw ? JSON.parse(raw) : {};
        } catch {
          return answer(400, { error: "The body is not JSON." });
        }
        // A call seen in the last day is answered as received and not acted on again.
        const key = request.headers.get("idempotency-key") ?? "";
        if (key) {
          const seen = db
            .select()
            .from(incomingSeen)
            .where(and(eq(incomingSeen.name, NAME), eq(incomingSeen.key, key), gt(incomingSeen.at, new Date(Date.now() - DAY))))
            .get();
          if (seen) return answer(200, { received: true, repeat: true });
        }
        const done = () => {
          if (key) db.insert(incomingSeen).values({ name: NAME, key }).run();
        };
        const mail = body as Mail;
        // A mail of a record's thread: by the ids it answers, else by the [app #id] tag.
        const mailId = text(mail.messageId);
        const keep = keeper(mailId);
        const automatic = !["", "no"].includes(text(mail.autoSubmitted).toLowerCase());
        const answers = [text(mail.inReplyTo), ...(Array.isArray(mail.references) ? mail.references.map(text) : [])].filter(Boolean);
        let thread = answers.length
          ? db.select({ id: mailThreads.recordId }).from(mailThreads).where(and(eq(mailThreads.model, "SupportCase"), inArray(mailThreads.messageId, answers))).orderBy(desc(mailThreads.at)).get()?.id
          : undefined;
        if (thread === undefined) {
          const tagged = /\\[[^[\\]]*#(\\d+)\\]/.exec(text(mail.subject))?.[1];
          if (tagged) thread = Number(tagged);
        }
        // A record that is gone (or never was) has no thread: the mail is a new one.
        if (thread !== undefined && !(await supportCaseData.get(caller, thread))) thread = undefined;
        if (thread !== undefined) {
          const files = await saved(mail, "message", messageData.uses);
          if (files instanceof Response) return files;
          const joining = messageSchema.safeParse({
            supportCaseId: thread,
            sender: "customer",
            fromEmail: address(mail.from),
            content: bodyOf(mail),
            attachments: files,
          });
          if (!joining.success) {
            for (const f of files) deleteFile(f, messageData.uses(f.file));
            return answer(422, { error: joining.error.issues.map((i) => \`\${i.path.join(".")}: \${i.message}\`).join("; ") });
          }
          const to = thread;
          try {
            const made = await fromMail({ messageId: mailId || undefined, quiet: automatic }, async () => {
              const added = await messageData.create(caller, joining.data);
              return added;
            });
            keep(to);
            done();
            return answer(201, { id: made.id, thread: to });
          } catch (error) {
            for (const f of files) deleteFile(f, messageData.uses(f.file));
            if (error instanceof AccessDenied) return answer(403, { error: "This call's role may not add one." });
            console.error("Incoming call failed:", error);
            return answer(422, { error: error instanceof Error && !/SQLITE_|Drizzle|Failed query/i.test(error.message) ? error.message : "The call was refused." });
          }
        }
        const files = await saved(mail, "support-case", supportCaseData.uses);
        if (files instanceof Response) return files;
        const parsed = supportCaseSchema.safeParse({
                status: "open",
          customerEmail: address(mail.from),
          subject: text(mail.subject),
          body: bodyOf(mail),
          attachments: files,
      });
      if (!parsed.success) {
                for (const f of files) deleteFile(f, supportCaseData.uses(f.file));
          return answer(422, { error: parsed.error.issues.map((i) => \`\${i.path.join(".")}: \${i.message}\`).join("; ") });
      }
      try {
        const made = await fromMail({ messageId: mailId || undefined, quiet: automatic }, () => supportCaseData.create(caller, parsed.data));
        keep(made.id);
        done();
        return answer(201, { id: made.id });
      } catch (error) {
                for (const f of files) deleteFile(f, supportCaseData.uses(f.file));
          if (error instanceof AccessDenied) return answer(403, { error: "This call's role may not add one." });
        console.error("Incoming call failed:", error);
        return answer(422, { error: error instanceof Error && !/SQLITE_|Drizzle|Failed query/i.test(error.message) ? error.message : "The call was refused." });
      }
      },
    },
  },
});
"
`;

