exports[`../../../examples/invoicing/smithable.yml > file list and generated code > src/routes/invoices/$id.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, notFound, useNavigate } from "@tanstack/react-router";
import { app } from "#/generated/app";
import { deleteInvoice, getInvoice, invoiceSchema, invoiceUi, updateInvoice } from "#/generated/invoice";
import { invoiceLineUi } from "#/generated/invoice-line";
import { clientOptions } from "#/generated/client";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";
import { ModelTable } from "#/kit/ModelTable";

export const Route = createFileRoute("/invoices/$id")({
  loader: async ({ params }) => {
    const row = await getInvoice({ data: Number(params.id) });
    if (!row) throw notFound();
    return { row, options: { clientId: await clientOptions() } };
  },
  component: InvoicePage,
});

function InvoicePage() {
  const { row, options } = Route.useLoaderData();
  const navigate = useNavigate();
  const back = () => navigate({ to: "/invoices" });
  return (
    <>
      <PageHeader title={row.number || \`Invoice #\${row.id}\`} />
      <ModelForm
        ui={invoiceUi}
        app={app}
        schema={invoiceSchema}
        initial={row}
        options={options}
        submitLabel="Save changes"
        onSubmit={async (values) => {
          await updateInvoice({ data: { id: row.id, values } });
          await back();
        }}
        onCancel={back}
        onDelete={async () => {
          await deleteInvoice({ data: row.id });
          await back();
        }}
      />
      <section className="mt-10">
        <h2 className="mb-3 text-lg font-semibold tracking-tight">Lines</h2>
        <ModelTable
          ui={invoiceLineUi}
          app={app}
          rows={row.lines}
          hide={["invoiceId"]}
          onOpen={(item) => navigate({ to: "/invoice-lines/$id", params: { id: String(item.id) } })}
        />
      </section>
    </>
  );
}
"
`;

