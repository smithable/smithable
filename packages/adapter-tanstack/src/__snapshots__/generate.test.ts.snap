exports[`../../../examples/marketplace/smithable.yml > file list and generated code > src/lib/auth.ts 1`] = `
"// Generated by Smithable from smithable.auth.yml. Do not edit: this file is overwritten on every change.
import { betterAuth } from "better-auth";
import { drizzleAdapter } from "better-auth/adapters/drizzle";
import { emailOTP } from "better-auth/plugins";
import { tanstackStartCookies } from "better-auth/tanstack-start";
import { eq } from "drizzle-orm";
import { db } from "#/db";
import { account, session, user, verification } from "#/db/schema";
import { ADDRESS_HEADER } from "#/kit/address.server";
import { audit } from "#/kit/audit.server";
import { codeAllowed } from "#/kit/limit";
import { log } from "#/kit/log.server";
import { mailConfigured, sendMail } from "#/kit/mail";
import { w } from "#/kit/words";

/** Sign-in providers in button order; each needs its keys in the environment (see the README). */
export const PROVIDERS = ["email"];

/** Who a session is for, as the audit log names them. */
function signedInAs(userId: string) {
  return db.select({ id: user.id, role: user.role }).from(user).where(eq(user.id, userId)).get() ?? null;
}
/** These addresses become admins when they first sign in. */
const ADMINS: string[] = ["owner@torget.example"];
const APP_NAME = "Torget";

const socialProviders = {

};

/** The providers whose keys are set (email needs none: its codes go out by mail). */
export const configuredProviders = () => PROVIDERS.filter((p) => p === "email" || p in socialProviders);

/** Whether sign-in codes can leave the machine: mail settings, or development's outbox. */
export const codesReachPeople = () => import.meta.env.DEV || mailConfigured();
/** A mail stays in the outbox (the preview, or an app without mail settings): pages say so. */
export const mailKept = () => !mailConfigured();


/**
 * A demo (DEMO_SIGN_IN=1 in the environment): the sign-in page offers every role without a
 * provider, as development does, and the data is reset by whoever runs the demo. Never set it
 * on a real app.
 */
export const demoSignIn = process.env.DEMO_SIGN_IN === "1";

const NO_TOKENS = {
  accessToken: null,
  refreshToken: null,
  idToken: null,
  accessTokenExpiresAt: null,
  refreshTokenExpiresAt: null,
};

// Production needs both: without a secret sessions could be forged, without the address
// sign-in breaks. Better to refuse to start than to run like that.
if (!import.meta.env.DEV && (!process.env.BETTER_AUTH_SECRET || !process.env.BETTER_AUTH_URL))
  throw new Error("Set BETTER_AUTH_SECRET and BETTER_AUTH_URL: in production the app does not start without them.");

/** The app is served over https: its cookies can take the __Host- prefix, which needs Secure. */
const hostCookies = (process.env.BETTER_AUTH_URL ?? "").startsWith("https://");

export const auth = betterAuth({
  // In development the app runs on port 3000 (pnpm dev); set BETTER_AUTH_URL in production.
  baseURL: process.env.BETTER_AUTH_URL ?? (import.meta.env.DEV ? "http://localhost:3000" : undefined),
  // In development the app may run on any local port (the preview, the tests).
  ...(import.meta.env.DEV ? { trustedOrigins: ["http://localhost:*", "http://127.0.0.1:*"] } : {}),
  database: drizzleAdapter(db, { provider: "sqlite", schema: { account, session, user, verification } }),
  socialProviders,
  // Its limits count per address from the one header the auth route sets (src/kit/address.server.ts),
  // never from an X-Forwarded-For the visitor could make up.
  // Over https the cookies are named so only this app's own address can set them (__Host-: Secure,
  // Path=/, no Domain), not a sibling app on the same domain.
  advanced: {
    ipAddress: { ipAddressHeaders: [ADDRESS_HEADER] },
    ...(hostCookies
      ? {
          useSecureCookies: false,
          // Every other cookie it makes stays Secure too (a sign-in's state).
          defaultCookieAttributes: { secure: true },
          cookies: Object.fromEntries(
            ["session_token", "session_data", "dont_remember", "state"].map((name) => [
              name,
              { name: \`__Host-better-auth.\${name}\`, attributes: { secure: true } },
            ]),
          ),
        }
      : {}),
  },
  // On in every production build, not only where NODE_ENV says so (Better Auth's default).
  rateLimit: { enabled: !import.meta.env.DEV },
  // Email and password only serve the development sign-in; production builds leave it off.
  emailAndPassword: { enabled: import.meta.env.DEV || demoSignIn },
  user: {
    additionalFields: {
      role: { type: "string", required: true, defaultValue: "member", input: false },
    },
  },
  databaseHooks: {
    user: {
      create: {
        before: async (newUser) => {
          const email = newUser.email.toLowerCase();
          return { data: { ...newUser, role: ADMINS.includes(email) ? "admin" : "member" } };
        },
        after: async (created) => {
          const who = { id: created.id, role: String(created.role) };
          audit(db, who, { action: "account created", model: "User", details: { role: who.role } });
        },
      },
    },
    // Signing in and out are in the audit log, as the person who did it.
    session: {
      create: {
        after: async (session) => audit(db, signedInAs(session.userId), { action: "signed in" }),
      },
      // A session also ends when it expires or its user is removed: only a sign-out says so.
      delete: {
        after: async (session, ctx) => {
          if (ctx?.path === "/sign-out") audit(db, signedInAs(session.userId), { action: "signed out" });
        },
      },
    },
    // The app only signs people in with a provider and never calls it afterwards, so the
    // provider's tokens are not kept: not in the database, its backups or its exports.
    account: {
      create: { before: async (account) => ({ data: { ...account, ...NO_TOKENS } }) },
      update: { before: async (account) => ({ data: { ...account, ...NO_TOKENS } }) },
    },
  },
  plugins: [
    // Sign-in by a six-digit code by mail: good for ten minutes, five tries, stored hashed.
    emailOTP({
      otpLength: 6,
      expiresIn: 600,
      allowedAttempts: 5,
      storeOTP: "hashed",
      async sendVerificationOTP({ email, otp, type }, ctx) {
        // Without mail settings a production app keeps no codes: nobody would get them.
        if (type !== "sign-in" || !codesReachPeople()) return;
        const address = email.toLowerCase();
        // Too many codes for the address (or from the network address): no mail. The plugin sends
        // in the background, so the page's answer is the same either way.
        try {
          codeAllowed(address, ctx?.request?.headers ?? new Headers());
        } catch {
          return;
        }
        // Not awaited, so the answer takes as long whether or not a mail goes out.
        void sendMail({
          to: address,
          subject: w.codeSubject(APP_NAME),
          text: w.codeText(APP_NAME, \`\${otp.slice(0, 3)} \${otp.slice(3)}\`),
        }).catch((error) => log.error("A sign-in code could not be sent", { error }));
      },
    }),
    tanstackStartCookies(),
  ],
});
"
`;

exports[`../../../examples/marketplace/smithable.yml > file list and generated code > src/lib/viewer.server.ts 1`] = `
"// Generated by Smithable from smithable.auth.yml. Do not edit: this file is overwritten on every change.
import { getRequestHeaders } from "@tanstack/react-start/server";
import type { Viewer } from "#/kit/access";
import { traceWho } from "#/kit/trace.server";
import { auth } from "#/lib/auth";

/** The signed-in user of the current request, or null; the access line names them. */
export async function currentViewer(): Promise<Viewer | null> {
  const session = await auth.api.getSession({ headers: getRequestHeaders() });
  if (!session) return null;
  const { id, name, email, role } = session.user;
  traceWho(id, role);
  return { id, name, email, role };
}
"
`;

exports[`../../../examples/marketplace/smithable.yml > file list and generated code > src/routes/$id.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, notFound, useNavigate, useRouter } from "@tanstack/react-router";
import { and, desc } from "drizzle-orm";
import { auditLog } from "#/db/schema";
import { app } from "#/generated/app";
import { pageAccess } from "#/generated/pages";
import { deleteItem, getItem, itemUi, toggleSavedItem, updateItem } from "#/generated/item";
import { itemSchema } from "#/generated/item.schema";
import { ReviewNotice } from "#/kit/Review";
import { guardPage } from "#/kit/access";
import { ActivityLog } from "#/kit/ActivityLog";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";
import { w } from "#/kit/words";
import { SaveButton } from "#/kit/ModelTable";
import { createServerFn } from "@tanstack/react-start";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { eq } from "drizzle-orm";
import { z } from "zod";
import { db } from "#/db";
import { user } from "#/db/schema";
import { itemData } from "#/generated/item.server";
import { ContactOwner } from "#/kit/ContactOwner";
import { writeAllowed } from "#/kit/limit";
import { mailConfigured, sendMail } from "#/kit/mail";
import { currentViewer } from "#/lib/viewer.server";


/** A message about this item to its owner, by mail; their address stays here. */
const contactItem = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.int(), name: z.string().trim().min(1).max(200), email: z.email().max(200), message: z.string().trim().min(1).max(2000) }))
  .handler(async ({ data }) => {
    const viewer = await currentViewer();
    writeAllowed(viewer, getRequestHeaders());
    const row = await itemData.get(viewer, data.id);
    if (!row) throw new Error("This item is not there any more.");
    const recipient = itemData.ownerOf(viewer, row.id);
    const to = recipient ? db.select({ email: user.email }).from(user).where(eq(user.id, recipient)).get() : undefined;
    if (!to?.email) throw new Error("The owner cannot be reached.");
    const sender = viewer ? { name: viewer.name, email: viewer.email, message: data.message } : data;
    const name = String(row.title);
    const link = \`\${process.env.BETTER_AUTH_URL ?? ""}/\${row.id}\`;
    await sendMail({
      to: to.email,
      replyTo: \`\${sender.name} <\${sender.email}>\`,
      subject: \`About “\${name}”\`,
      text: \`\${sender.name} (\${sender.email}) wrote about “\${name}”:\\n\\n\${sender.message}\\n\\n\${link}\\n\`,
    });
    return { sent: true, kept: !mailConfigured() };
  });

/** The record's lines in the audit log, newest first: administrators only, nobody else. */
const getHistory = createServerFn()
  .validator((id: number) => id)
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    if (viewer?.role !== "admin") return null;
    const people = new Map(db.select({ id: user.id, name: user.name }).from(user).all().map((p) => [p.id, p.name]));
    return db
      .select()
      .from(auditLog)
      .where(and(eq(auditLog.model, "Item"), eq(auditLog.recordId, id)))
      .orderBy(desc(auditLog.id))
      .limit(50)
      .all()
      .map((r) => ({
        id: r.id,
        at: r.at,
        who: r.who === "visitor" || r.who === "the app" ? r.who : (people.get(r.who) ?? (r.who.startsWith("key:") ? w.aKey(r.who.slice(4)) : w.aRemovedUser(r.who))),
        action: r.action,
        fields: r.fields,
        details: r.details ? Object.fromEntries(Object.entries(r.details).map(([k, v]) => [k, String(v)])) : null,
      }));
  });

export const Route = createFileRoute("/$id")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["catalog"], context.viewer, location.href),
  head: () => ({ meta: [{"title":"Torget"}] }),
  loader: async ({ params }) => {
    const found = await getItem({ data: Number(params.id) });
    if (!found) throw notFound();
    return { ...found, history: await getHistory({ data: Number(params.id) }) };
  },
  component: ItemPage,
});

function ItemPage() {
  const { row, canWrite, canDelete, review, saved, history } = Route.useLoaderData();
  const { viewer } = Route.useRouteContext();
  const navigate = useNavigate();
  const router = useRouter();
  const back = () => navigate({ to: "/" });
  // The heart saves the record for the viewer; a visitor signs in first and comes back.
  const toggleSaved = async () => {
    if (!viewer) {
      await navigate({ to: "/sign-in", search: { redirect: location.pathname } });
      return;
    }
    await toggleSavedItem({ data: row.id });
    await router.invalidate();
  };
  return (
    <>
      <PageHeader
        title={row.title || \`Item #\${row.id}\`}
        actions={<SaveButton saved={saved} label={String(row.title || \`Item #\${row.id}\`)} onToggle={toggleSaved} />}
      />
      <ReviewNotice notes={review} labels={{"photos":"Photos"}} />
      <ModelForm
        key={String(row.updatedAt)}
        ui={itemUi}
        app={app}
        schema={itemSchema}
        initial={row}
        readOnly={!canWrite}
        submitLabel={w.saveChanges}
        onSubmit={async (values) => {
          await updateItem({ data: { id: row.id, values } });
          await back();
        }}
        onCancel={back}
        onDelete={
          canDelete
            ? async (together?: boolean) => {
                await deleteItem({ data: { id: row.id, together } });
                await back();
              }
            : undefined
        }
      />
      <ContactOwner
        recipient="owner"
        viewer={viewer}
        onSend={(values) => contactItem({ data: { id: row.id, ...values } })}
      />

      {history && history.length > 0 && (
        <section className="mt-10 max-w-3xl">
          <h2 className="mb-3 text-lg font-semibold">{w.history}</h2>
          <ActivityLog lines={history} app={app} />
        </section>
      )}
    </>
  );
}
"
`;

exports[`../../../examples/marketplace/smithable.yml > file list and generated code > src/routes/__root.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createRootRoute, HeadContent, Scripts, useRouter, useRouterState } from "@tanstack/react-router";
import { createServerFn } from "@tanstack/react-start";
import { useEffect, useState } from "react";
import { Package, Shield } from "lucide-react";
import { app } from "#/generated/app";
import { pageAccess } from "#/generated/pages";
import { currentViewer } from "#/lib/viewer.server";
import { AppShell, ErrorNotice, type MenuUi } from "#/kit/AppShell";
import { Ask } from "#/kit/Ask";
import { field } from "#/kit/params";
import { ask, asks } from "#/generated/ask.server";
import { LandingLayout } from "#/kit/Landing";
import { site } from "#/generated/site";
import { Consent } from "#/kit/Consent";
import { pageHeaders } from "#/kit/security";
import { waitingCount } from "#/generated/review.server";
import { w } from "#/kit/words";
import { authClient } from "#/lib/auth-client";
import appCss from "#/styles.css?url";

const menus: MenuUi[] = [
  {
    name: "main",
    items: [
      {
        to: "/",
        label: "Catalog",
        icon: Package,
        access: pageAccess["catalog"],
      },
      {
        to: "/my-items",
        label: "My items",
        icon: Package,
        access: pageAccess["myItems"],
      },
      {
        to: "/saved",
        label: "Saved",
        icon: Package,
        access: pageAccess["saved"],
      },
      {
        to: "/review",
        label: "Review",
        icon: Shield,
        access: pageAccess["review"],
      },
    ],
  },
];

const landingRoutes = ["/welcome"];
/** Public pages that visitors see in the site's frame (signed in, the app's). */
const visitorRoutes = ["/", "/sign-in"];

/** Each page's route and name, longest route first. */
const pageRoutes: [string, string][] = [
  ["/my-items", "myItems"],
  ["/welcome", "home"],
  ["/review", "review"],
  ["/saved", "saved"],
  ["/", "catalog"],
];

/** The page a path is on, e.g. "customers" for /customers/12 (see data-page, src/custom/styles.css). */
function pageOf(path: string): string | undefined {
  return pageRoutes.find(([route]) => path === route || path.startsWith(route === "/" ? "/" : \`\${route}/\`))?.[1];
}


// Who is signed in, and, when a hosting service runs a copy of the app's data from an earlier
// time to look at (DATA_AS_OF), that time.
const getViewer = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return {
    viewer,
    asOf: process.env.DATA_AS_OF,
    demo: process.env.DEMO_SIGN_IN === "1",
    asks: asks(viewer),
    counts: { "/review": waitingCount(viewer, ["Item"]) },
  };
});

/** A question to "Ask", answered as the person signed in (or a visitor), with what they may read. */
const askApp = createServerFn({ method: "POST" })
  .validator((data: unknown) => ({ question: field(data, "question", 500) }))
  .handler(async ({ data }) => ask(await currentViewer(), data.question));

export const Route = createRootRoute({
  // Every page knows who is signed in; pages check their access with it.
  beforeLoad: () => getViewer(),
  headers: ({ ssr }) => pageHeaders(ssr?.nonce),
  head: () => ({
    meta: [
      { charSet: "utf-8" },
      { name: "viewport", content: "width=device-width, initial-scale=1" },
      { title: app.name },
    ],
    links: [
      { rel: "stylesheet", href: appCss },
      { rel: "icon", href: "/favicon.svg", type: "image/svg+xml" },
    ],
  }),
  shellComponent: RootDocument,
  errorComponent: ({ error }) => (
    <ErrorNotice title={w.errorTitle} message={error instanceof Error ? error.message : undefined} />
  ),
  notFoundComponent: () => (
    <ErrorNotice title={w.notFound} message={w.notFoundNote} />
  ),
});

function RootDocument({ children }: { children: React.ReactNode }) {
  const { viewer, asOf, demo, asks, counts } = Route.useRouteContext();
  const pathname = useRouterState({ select: (state) => state.location.pathname });
  // Set once React has taken over the page in the browser, for tests that must not type or
  // click before the page's handlers are attached (body[data-hydrated]).
  const [hydrated, setHydrated] = useState(false);
  useEffect(() => setHydrated(true), []);
  const router = useRouter();
  const signOut = async () => {
    await authClient.signOut();
    await router.invalidate();
  };
  const rename = async (name: string) => {
    const { error } = await authClient.updateUser({ name });
    if (error) throw new Error(error.message);
    await router.invalidate();
  };
  return (
    <html lang="en">
      <head>
        <HeadContent />
      </head>
      <body data-page={pageOf(pathname)} data-hydrated={hydrated ? "true" : undefined}>
        {asOf && (
          <p role="status" className="bg-warning px-4 py-2 text-center text-sm text-warning-foreground">
            A copy of this app's data as of {asOf.slice(0, 16).replace("T", " ")} UTC: changes made here are not kept.
          </p>
        )}
        {demo && (
          <p role="status" className="bg-warning px-4 py-2 text-center text-sm text-warning-foreground">
            This is a demo: sign in as anyone and try things; the data is reset every hour.
          </p>
        )}
        {landingRoutes.includes(pathname) ? (
          children
        ) : !viewer && visitorRoutes.some((r) => pathname === r || (r === "/" ? /^\\/(new|\\d+)$/.test(pathname) : pathname.startsWith(\`\${r}/\`))) ? (
          <LandingLayout appName={app.name} link={{ to: "/sign-in", label: w.signIn }} site={site}>
            <div className="mx-auto max-w-6xl px-5 py-10">{children}</div>
          </LandingLayout>
        ) : (
          <AppShell appName={app.name} home={{ to: "/", access: pageAccess["catalog"] }} menus={menus} viewer={viewer} onSignOut={signOut} onRename={rename} counts={counts}>
            {children}
          </AppShell>
        )}
        {asks && <Ask ask={(question) => askApp({ data: { question } })} />}
        <Consent />
        <Scripts />
      </body>
    </html>
  );
}
"
`;

exports[`../../../examples/marketplace/smithable.yml > file list and generated code > src/routes/index.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, Link, useNavigate, useRouter } from "@tanstack/react-router";
import { pageAccess } from "#/generated/pages";
import { guardPage, allows } from "#/kit/access";
import { createServerFn } from "@tanstack/react-start";
import * as schema from "#/db/schema";
import { itemAccess, itemData } from "#/generated/item.server";
import { contains } from "#/kit/search";
import { inArray, and, eq } from "drizzle-orm";
import { inRange, orderOf } from "#/kit/filter";
import { currentViewer } from "#/lib/viewer.server";
import { type Search, count, listQuery, oneOf, optional, text } from "#/kit/params";
import { buttonVariants } from "#/components/ui/button";
import { useState } from "react";
import { SelectionBar } from "#/kit/SelectionBar";
import { csvName, csvOf, download } from "#/kit/csv";
import { deleteItems, itemDeleteRule, itemUi, toggleSavedItem } from "#/generated/item";
import { app } from "#/generated/app";
import { w } from "#/kit/words";
import { PageHeader } from "#/kit/AppShell";
import { ModelTable } from "#/kit/ModelTable";
import { SearchBox } from "#/kit/SearchBox";
import { Filters, SavedTabs } from "#/kit/Filters";
import { Package } from "lucide-react";

/** The items matching the search and the filters, among those the viewer may read. */
const searchItems = createServerFn()
  .validator(listQuery)
  .handler(async ({ data }) => {
    const viewer = await currentViewer();
    const saved = itemData.saved(viewer);
    const where = and(
      data.q ? contains([schema.items.title, schema.items.description, schema.items.place], data.q) : undefined,
      data.view === "saved" ? inArray(schema.items.id, saved) : undefined,
      data.f?.category ? inArray(schema.items.category, data.f?.category.split(",").filter((v) => ["furniture", "bikes", "electronics", "sports", "kids", "other"].includes(v)) as ("furniture" | "bikes" | "electronics" | "sports" | "kids" | "other")[]) : undefined,
      data.f?.price ? inRange(schema.items.price, data.f?.price, "number", 100) : undefined,
      data.f?.condition ? inArray(schema.items.condition, data.f?.condition.split(",").filter((v) => ["likeNew", "good", "worn"].includes(v)) as ("likeNew" | "good" | "worn")[]) : undefined,
      data.f?.available === "true" || data.f?.available === "false" ? eq(schema.items.available, data.f?.available === "true") : undefined,
    );
    // The order the viewer chose, among the fields the page offers; else the newest first.
    const order = orderOf({ price: schema.items.price, createdAt: schema.items.createdAt }, data.sort);
    return {
      ...(await itemData.page(viewer, where, order, data.all ? 1 : data.page, data.all ? (viewer ? 10000 : 500) : undefined)),
      canCreate: allows(itemAccess.create, viewer),
      options: {  },
      saved,
    };
  });

export const Route = createFileRoute("/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["catalog"], context.viewer, location.href),
  head: () => ({ meta: [{"title":"Torget"}] }),
  validateSearch: (s: Search) => optional({ q: text(s.q), sort: text(s.sort), category: text(s.category), price: text(s.price), condition: text(s.condition), available: text(s.available), view: oneOf(s.view, ["saved"] as const), page: count(s.page) }),
  loaderDeps: ({ search }) => search,
  loader: ({ deps: { q, sort, view, page, ...f } }) => searchItems({ data: { q, sort, view, f, page } }),
  // While a search or filter loads, the page stays (and its controls keep their focus).
  pendingMs: Number.POSITIVE_INFINITY,
  gcTime: 0,
  component: CatalogPage,
});

function CatalogPage() {
  const { rows, canCreate, total, page: at, size, saved } = Route.useLoaderData();
  const { q, sort, view, page: _page, ...values } = Route.useSearch();
  const { viewer } = Route.useRouteContext();
  const navigate = useNavigate({ from: "/" });
  const router = useRouter();
  // The chosen rows, offered when the viewer may do something to at least one row.
  const [selected, setSelected] = useState<Set<number>>(new Set());
  const chosen = rows.filter((row) => selected.has(row.id));
  const selectable = rows.some((row) => allows(itemDeleteRule, viewer, row.ownerId));
  // A heart saves the record for the viewer; a visitor signs in first and comes back.
  const toggleSaved = async (id: number) => {
    if (!viewer) {
      await navigate({ to: "/sign-in", search: { redirect: location.pathname + location.search } });
      return;
    }
    await toggleSavedItem({ data: id });
    await router.invalidate();
  };
  const newButton = canCreate && (
    <Link to="/new" className={buttonVariants()}>
      {w.newOne("item")}
    </Link>
  );
  return (
    <>
      <PageHeader
        page="catalog"
        title="Catalog"
        actions={newButton}
      />
      <SearchBox
        value={q ?? ""}
        placeholder="Search by title, description or place"
        onSearch={(text) => navigate({ to: "/", search: (prev) => ({ ...prev, q: text || undefined, page: undefined }), replace: true, resetScroll: false })}
      />
      {viewer && (
        <SavedTabs
          saved={view === "saved"}
          onChange={(saved) => navigate({ to: "/", search: (prev) => ({ ...prev, view: saved ? "saved" : undefined, page: undefined }), replace: true, resetScroll: false })}
        />
      )}
      <Filters
        filters={[
  {
    name: "category",
    label: "Category",
    kind: "chips",
    options: [
      { value: "furniture", label: "Furniture" },
      { value: "bikes", label: "Bikes" },
      { value: "electronics", label: "Electronics" },
      { value: "sports", label: "Sports" },
      { value: "kids", label: "Kids" },
      { value: "other", label: "Other" },
    ],
  },
  { name: "price", label: "Price", kind: "range", input: "number" },
  {
    name: "condition",
    label: "Condition",
    kind: "chips",
    options: [
      { value: "likeNew", label: "Like new" },
      { value: "good", label: "Good" },
      { value: "worn", label: "Worn" },
    ],
  },
  { name: "available", label: "Available", kind: "toggle" },
]}
        values={values}
        sorts={[
  { value: "price", label: "Price, low to high" },
  { value: "-price", label: "Price, high to low" },
  { value: "createdAt", label: "Added, oldest first" },
  { value: "-createdAt", label: "Added, newest first" },
]}
        sort={sort}
        onChange={(next) => navigate({ to: "/", search: { q, view, ...next }, replace: true, resetScroll: false })}
      />
      {selectable && (
        <SelectionBar
          count={chosen.length}
          noun={["item", "items"]}
          app={app}
          titleOf={(id) => String(rows.find((row) => row.id === id)?.title ?? id)}
          actions={[]}
          deletable={chosen.filter((row) => allows(itemDeleteRule, viewer, row.ownerId)).length}
          onDelete={(together) => deleteItems({ data: { ids: chosen.map((row) => row.id), together } })}
          onDone={async () => {
            setSelected(new Set());
            await router.invalidate();
          }}
          onExport={() => download(csvName(itemUi), csvOf(itemUi, chosen))}
        />
      )}
      <ModelTable
        ui={itemUi}
        page="catalog"
        paging={{ page: at, size, total, to: (next) => navigate({ to: "/", search: (prev) => ({ ...prev, page: next > 1 ? next : undefined }) }) }}
        app={app}
        exportRows={async () => (await searchItems({ data: { q, sort, view, f: values, all: true } })).rows}
        rows={rows}
        icon={Package}
        saved={{ ids: saved, onToggle: toggleSaved }}
        selection={selectable ? { ids: selected, onChange: setSelected } : undefined}
        emptyMessage={q || Object.values(values).some(Boolean) ? "No items match the search and filters." : view === "saved" ? "No saved items yet: the heart on one saves it." : undefined}
        emptyAction={newButton || undefined}
        onOpen={(row) => navigate({ to: "/$id", params: { id: String(row.id) } })}
      />
    </>
  );
}
"
`;

exports[`../../../examples/marketplace/smithable.yml > file list and generated code > src/routes/my-items/$id.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, notFound, useNavigate } from "@tanstack/react-router";
import { createServerFn } from "@tanstack/react-start";
import { and, desc, eq } from "drizzle-orm";
import { db } from "#/db";
import { auditLog, user } from "#/db/schema";
import { app } from "#/generated/app";
import { pageAccess } from "#/generated/pages";
import { deleteItem, getItem, itemUi, updateItem } from "#/generated/item";
import { itemSchema } from "#/generated/item.schema";
import { ReviewNotice } from "#/kit/Review";
import { guardPage } from "#/kit/access";
import { ActivityLog } from "#/kit/ActivityLog";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";
import { w } from "#/kit/words";
import { currentViewer } from "#/lib/viewer.server";

/** The record's lines in the audit log, newest first: administrators only, nobody else. */
const getHistory = createServerFn()
  .validator((id: number) => id)
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    if (viewer?.role !== "admin") return null;
    const people = new Map(db.select({ id: user.id, name: user.name }).from(user).all().map((p) => [p.id, p.name]));
    return db
      .select()
      .from(auditLog)
      .where(and(eq(auditLog.model, "Item"), eq(auditLog.recordId, id)))
      .orderBy(desc(auditLog.id))
      .limit(50)
      .all()
      .map((r) => ({
        id: r.id,
        at: r.at,
        who: r.who === "visitor" || r.who === "the app" ? r.who : (people.get(r.who) ?? (r.who.startsWith("key:") ? w.aKey(r.who.slice(4)) : w.aRemovedUser(r.who))),
        action: r.action,
        fields: r.fields,
        details: r.details ? Object.fromEntries(Object.entries(r.details).map(([k, v]) => [k, String(v)])) : null,
      }));
  });

export const Route = createFileRoute("/my-items/$id")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["myItems"], context.viewer, location.href),
  head: () => ({ meta: [{"title":"My items · Torget"}] }),
  loader: async ({ params }) => {
    const found = await getItem({ data: Number(params.id) });
    if (!found) throw notFound();
    return { ...found, history: await getHistory({ data: Number(params.id) }) };
  },
  component: ItemPage,
});

function ItemPage() {
  const { row, canWrite, canDelete, review, history } = Route.useLoaderData();
  const navigate = useNavigate();
  const back = () => navigate({ to: "/my-items" });
  return (
    <>
      <PageHeader title={row.title || \`Item #\${row.id}\`} />
      <ReviewNotice notes={review} labels={{"photos":"Photos"}} />
      <ModelForm
        key={String(row.updatedAt)}
        ui={itemUi}
        app={app}
        schema={itemSchema}
        initial={row}
        readOnly={!canWrite}
        submitLabel={w.saveChanges}
        onSubmit={async (values) => {
          await updateItem({ data: { id: row.id, values } });
          await back();
        }}
        onCancel={back}
        onDelete={
          canDelete
            ? async (together?: boolean) => {
                await deleteItem({ data: { id: row.id, together } });
                await back();
              }
            : undefined
        }
      />

      {history && history.length > 0 && (
        <section className="mt-10 max-w-3xl">
          <h2 className="mb-3 text-lg font-semibold">{w.history}</h2>
          <ActivityLog lines={history} app={app} />
        </section>
      )}
    </>
  );
}
"
`;

