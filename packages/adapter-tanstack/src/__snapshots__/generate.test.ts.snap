import { runAssignTo } from "./actions/assign-to.server";
import { assignToAsks } from "./actions/assign-to";
import { runStartWork } from "./actions/start-work.server";
import { startWorkAsks } from "./actions/start-work";
import { runClose } from "./actions/close.server";
import { closeAsks } from "./actions/close";
import { runReopen } from "./actions/reopen.server";
import { supportCaseSchema } from "#/generated/support-case.schema";
import { messageSchema } from "#/generated/message.schema";

const whole = (v: unknown, field: string) => {
  if (Number.isInteger(v)) return v as number;
  throw new BadInput(\`"\${field}" must be a record's id, a whole number.\`);
};

/** The body as an object of known fields, or a refusal naming the first unknown one. */
function fieldsOf(body: unknown, known: readonly string[]): Record<string, unknown> {
  if (!body || typeof body !== "object" || Array.isArray(body)) throw new BadInput("The body must be a JSON object.");
  const unknown = Object.keys(body).find((k) => !known.includes(k));
  if (unknown) throw new BadInput(\`There is no field "\${unknown}" to set. Fields: \${known.join(", ")}.\`);
  return body as Record<string, unknown>;
}

/** A support case as the API gives it. */
export function supportCaseToApi(row: Record<string, any>) {
  return {
    id: row.id as number,
    subject: row.subject ?? null,
    customerEmail: row.customerEmail ?? null,
    status: row.status ?? null,
    priority: row.priority ?? null,
    assignee: row.assigneeId ?? null,
    body: row.body ?? null,
    createdAt: row.createdAt instanceof Date ? row.createdAt.toISOString() : row.createdAt,
    updatedAt: row.updatedAt instanceof Date ? row.updatedAt.toISOString() : row.updatedAt,
  };
}

/** A support case's values from a body: all of them, or a change to \`current\`. */
export function supportCaseFromApi(body: unknown, current?: Record<string, unknown>) {
  const given = fieldsOf(body, ["subject", "customerEmail", "status", "priority", "assignee", "body"]);
  const values: Record<string, unknown> = { ...current };
  for (const [key, v] of Object.entries(given))
    switch (key) {
      case "subject":
        values.subject = v;
        break;
      case "customerEmail":
        values.customerEmail = v;
        break;
      case "status":
        values.status = v;
        break;
      case "priority":
        values.priority = v;
        break;
      case "assignee":
        values.assigneeId = v === null ? null : whole(v, "assignee");
        break;
      case "body":
        values.body = v;
        break;
    }
  return supportCaseSchema.parse(values);
}

/** A message as the API gives it. */
export function messageToApi(row: Record<string, any>) {
  return {
    id: row.id as number,
    content: row.content ?? null,
    sender: row.sender ?? null,
    agent: row.agentId ?? null,
    fromEmail: row.fromEmail ?? null,
    supportCase: row.supportCaseId ?? null,
    createdAt: row.createdAt instanceof Date ? row.createdAt.toISOString() : row.createdAt,
    updatedAt: row.updatedAt instanceof Date ? row.updatedAt.toISOString() : row.updatedAt,
  };
}

/** A message's values from a body: all of them, or a change to \`current\`. */
export function messageFromApi(body: unknown, current?: Record<string, unknown>) {
  const given = fieldsOf(body, ["content", "sender", "agent", "fromEmail", "supportCase"]);
  const values: Record<string, unknown> = { ...current };
  for (const [key, v] of Object.entries(given))
    switch (key) {
      case "content":
        values.content = v;
        break;
      case "sender":
        values.sender = v;
        break;
      case "agent":
        values.agentId = v === null ? null : whole(v, "agent");
        break;
      case "fromEmail":
        values.fromEmail = v;
        break;
      case "supportCase":
        values.supportCaseId = v === null ? null : whole(v, "supportCase");
        break;
    }
  return messageSchema.parse(values);
}

