exports[`../../../examples/booking/smithable.yml > file list and generated code > src/generated/booking.server.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { type AnyColumn, and, asc, avg, count, desc, eq, inArray, isNotNull, max, min, ne, sql, sum, type SQL } from "drizzle-orm";
import { db } from "#/db";
import * as schema from "#/db/schema";
import { AccessDenied, allows, check, Conflict, type ModelAccess, personOf, readScope, type Viewer } from "#/kit/access";
import { audit, changedFields } from "#/kit/audit.server";
import { refusal } from "#/kit/log.server";
import { bookingName } from "./booking.name";
import { outgoing } from "#/generated/outgoing.server";
import { contains } from "#/kit/search";
import { BadInput } from "#/kit/refusal";
import { aggregate, type Filterable, nearest, sortOf, whereOf, wordsOf } from "#/kit/where";
import { afterChange, afterDelete } from "./hooks";
import { sessionData } from "./session.server";
import { classTypeData } from "./class-type.server";
import { type BookingSettable } from "./booking";
import "./timers.server";

/** Who may read, create, change and delete bookings. */
export const bookingAccess: ModelAccess = {
  read: { public: false, roles: ["admin"], owner: true },
  create: { public: false, roles: ["admin", "member"], owner: false },
  write: { public: false, roles: ["admin"], owner: true },
  delete: { public: false, roles: ["admin"], owner: true },
};


/** What \`where\` may name, and how: the stored fields, by kind. */
const FILTERABLE: Record<string, Filterable> = {
  session: { kind: "reference", column: schema.bookings.sessionId },
  attendee: { kind: "reference", column: schema.bookings.attendeeId, title: { table: schema.user, column: schema.user.name } },
};

/** What the records can be sorted by. */
const SORTABLE = { id: schema.bookings.id, createdAt: schema.bookings.createdAt };

/** The number fields \`measure\` adds up; amounts are stored in cents. */
const NUMBERS: Record<string, AnyColumn> = {  };
const MONEY: string[] = [];

/** Computed number fields \`measure\` adds up from the records themselves. */
const COMPUTED: string[] = [];

/** The titles of the referenced records \`measureBy\` splits by, to name its groups. */
function titlesOf(_viewer: Viewer | null, _by: string, _ids: number[]): Map<unknown, string> {
  switch (_by) {
    default:
      return new Map();
  }
}

/** What \`measureBy\` may split by: choices, yes/no, references, and dates by month. */
const BY: string[] = ["session","attendee"];


/**
 * Whose record it is: anyone's for a role that may change everyone's, otherwise the viewer's
 * own, whatever the form sent.
 */
function ownerFor(viewer: Viewer | null, given: string | null | undefined): string | null {
  if ((!!viewer && (!!viewer.system || bookingAccess.write.roles.includes(viewer.role)))) return given ?? personOf(viewer);
  return personOf(viewer);
}

/** Checks that the viewer may read the records the values refer to. */
function checkReferences(viewer: Viewer | null, values: Partial<BookingSettable>): void {
  if (values.sessionId != null && !sessionData.canRead(viewer, values.sessionId))
    throw new AccessDenied(viewer !== null);
}

/** \`rows\` with each \`field\` reference \`readable\` leaves out set to nothing (only its id stays). */
function hideRefs<R extends Record<string, unknown>>(rows: R[], field: string, readable: (ids: number[]) => number[]): R[] {
  const idOf = (row: R) => (row[field] as { id?: unknown } | null | undefined)?.id;
  const ids = [...new Set(rows.map(idOf).filter((id): id is number => typeof id === "number"))];
  if (!ids.length) return rows;
  const shown = new Set(readable(ids));
  return rows.map((row) => {
    const id = idOf(row);
    return typeof id === "number" && !shown.has(id) ? { ...row, [field]: null } : row;
  });
}

export const bookingData = {
  /** The rows with each reference to a record the viewer may not read set to nothing: a related record's title is shown only to who may read it (only its id stays). */
  shownRefs<R extends Record<string, unknown>>(viewer: Viewer | null, rows: R[]): R[] {
    return hideRefs(rows, "session", (ids, c = sessionData.readable(viewer)) => (c ? db.select({ id: schema.sessions.id }).from(schema.sessions).where(and(inArray(schema.sessions.id, ids), c)).all().map((r) => r.id) : ids)).map((row) => {
      // A referenced record named by its parts is shown as its own model shows it: its parts
      // the viewer may not read hidden too, one reference further.
      const shown = { ...row, session: row.session ? sessionData.shownRefs(viewer, [row.session as Record<string, unknown>])[0] : row.session };
      return { ...shown, $name: bookingName(shown) } as R;
    });
  },

  /** A condition for the bookings the viewer may read. */
  readable(viewer: Viewer | null) {
    const scope = readScope(bookingAccess.read, viewer);
    if (scope === "all") return undefined;
    return scope === "own" && viewer ? eq(schema.bookings.attendeeId, viewer.id) : sql\`false\`;
  },

  canRead(viewer: Viewer | null, id: number): boolean {
    const found = db
      .select({ id: schema.bookings.id })
      .from(schema.bookings)
      .where(and(eq(schema.bookings.id, id), bookingData.readable(viewer)))
      .get();
    return found !== undefined;
  },

  /** The bookings the viewer may read; \`where\` narrows them, e.g. to a search; \`limit\` keeps the newest (a data page). */
  async list(viewer: Viewer | null, where?: SQL, limit?: number) {
    if (readScope(bookingAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const rows = bookingData.shownRefs(viewer, await db.query.bookings.findMany({
      where: and(bookingData.readable(viewer), where),
      with: { session: { columns: { id: true, startsAt: true }, with: { classType: { columns: { id: true, name: true } } } }, attendee: { columns: { id: true, name: true } } },
      orderBy: (t, { desc }) => [desc(t.id)],
      limit,
    }));
    return rows;
  },

  /**
   * A page of the bookings the viewer may read that fit \`where\`, newest first (or in
   * \`order\`), and how many fit in all: for a list page. A page past the end is the last one.
   */
  async page(viewer: Viewer | null, where?: SQL, order?: SQL, page = 1, size = 50) {
    if (readScope(bookingAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = and(bookingData.readable(viewer), where);
    const total = db.select({ n: count() }).from(schema.bookings).where(condition).get()?.n ?? 0;
    const at = Math.min(Math.max(1, Math.trunc(page)), Math.max(1, Math.ceil(total / size)));
    const rows = bookingData.shownRefs(viewer, await db.query.bookings.findMany({
      where: condition,
      with: { session: { columns: { id: true, startsAt: true }, with: { classType: { columns: { id: true, name: true } } } }, attendee: { columns: { id: true, name: true } } },
      orderBy: (t, { desc }) => [...(order ? [order] : []), desc(t.id)],
      limit: size,
      offset: (at - 1) * size,
    }));
    return { rows: rows, total, page: at, size };
  },

  /**
   * The bookings the viewer may read that fit \`where\` and \`search\`, in \`sort\`'s order (else newest
   * first), a page of them and how many there are: for the API and the assistants' tools.
   */
  async find(
    viewer: Viewer | null,
    options: { where?: unknown; search?: string; sort?: string; limit?: number; offset?: number } = {},
  ) {
    if (readScope(bookingAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = bookingData.fitting(viewer, options.where, options.search);
    const order = sortOf(SORTABLE, options.sort);
    const total = db.select({ n: count() }).from(schema.bookings).where(condition).get()?.n ?? 0;
    const rows = bookingData.shownRefs(viewer, await db.query.bookings.findMany({
      where: condition,
      with: { session: { columns: { id: true, startsAt: true }, with: { classType: { columns: { id: true, name: true } } } }, attendee: { columns: { id: true, name: true } } },
      orderBy: (t, { desc }) => [...(order ? [order] : []), desc(t.id)],
      limit: options.limit ?? 100,
      offset: options.offset ?? 0,
    }));
    return { items: rows, total };
  },

  /**
   * A number from the bookings the viewer may read that fit \`where\`: how many, or the sum,
   * average, smallest or largest of a number field.
   */
  async measure(
    viewer: Viewer | null,
    how: "count" | "sum" | "average" | "smallest" | "largest",
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<number | null> {
    if (readScope(bookingAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = bookingData.fitting(viewer, options.where, options.search);
    if (how === "count")
      return db.select({ n: count() }).from(schema.bookings).where(condition).get()?.n ?? 0;
    const field = options.field ?? "";
    const money = MONEY.includes(field);
    if (COMPUTED.includes(field)) {
      const rows = await bookingData.computedRows(condition);
      const value = aggregate(rows.map((row) => row[field]), how);
      return value === null ? null : money ? value / 100 : value;
    }
    const column = Object.hasOwn(NUMBERS, field) ? NUMBERS[field] : undefined;
    if (!column)
      throw new BadInput(
        \`\${how} needs a number field: \${[...Object.keys(NUMBERS), ...COMPUTED].join(", ") || "there are none"}.\`,
      );
    const pick = { sum, average: avg, smallest: min, largest: max }[how];
    const value = db.select({ v: pick(column) }).from(schema.bookings).where(condition).get()?.v;
    if (value === null || value === undefined) return null;
    return money ? Number(value) / 100 : Number(value);
  },

  /** Which record holds the smallest or largest value of a number field (the first of a tie). */
  async holder(
    viewer: Viewer | null,
    how: "smallest" | "largest",
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<{ id: number; title: string } | null> {
    const condition = bookingData.fitting(viewer, options.where, options.search);
    const field = options.field ?? "";
    if (COMPUTED.includes(field)) {
      let best: Record<string, unknown> | undefined;
      for (const row of await bookingData.computedRows(condition)) {
        const v = row[field];
        if (typeof v !== "number") continue;
        if (!best || (how === "largest" ? v > (best[field] as number) : v < (best[field] as number))) best = row;
      }
      return best ? { id: best.id as number, title: String(best.id) } : null;
    }
    const column = Object.hasOwn(NUMBERS, field) ? NUMBERS[field] : undefined;
    if (!column) return null;
    const row = db
      .select({ id: schema.bookings.id, title: schema.bookings.id })
      .from(schema.bookings)
      .where(and(condition, isNotNull(column)))
      .orderBy(how === "largest" ? desc(column) : asc(column), asc(schema.bookings.id))
      .limit(1)
      .get();
    return row ? { id: row.id, title: String(row.title) } : null;
  },

  /**
   * The same number per value of a field (a choice, yes/no, a reference) or per month of a date:
   * \`[{ value, number }]\`, the most first.
   */
  async measureBy(
    viewer: Viewer | null,
    how: "count" | "sum" | "average" | "smallest" | "largest",
    by: string,
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<{ value: unknown; title?: string; number: number | null }[]> {
    if (readScope(bookingAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const split = Object.hasOwn(FILTERABLE, by) ? FILTERABLE[by] : undefined;
    if (!split || split.kind === "text" || split.kind === "number" || split.kind === "money")
      throw new BadInput(\`There is no field "\${by}" to split by. Fields: \${BY.join(", ")}.\`);
    const field = options.field ?? "";
    const money = MONEY.includes(field);
    const condition = bookingData.fitting(viewer, options.where, options.search);
    const amount = (n: number | null) => (n === null ? null : money ? n / 100 : n);
    const most = (a: { number: number | null }, b: { number: number | null }) => (b.number ?? 0) - (a.number ?? 0);
    // A reference's groups carry the referenced record's title beside its id.
    const named = (rows: { value: unknown; number: number | null }[]) => {
      if (split.kind !== "reference") return rows;
      const titles = titlesOf(viewer, by, rows.map((r) => r.value).filter((v): v is number => typeof v === "number"));
      return rows.map((r) => (titles.has(r.value) ? { value: r.value, title: titles.get(r.value), number: r.number } : r));
    };
    if (COMPUTED.includes(field)) {
      // Each record's month or value, then the computed numbers added up per group.
      const groups = new Map<unknown, unknown[]>();
      for (const row of await bookingData.computedRows(condition)) {
        const raw = row[split.kind === "reference" ? \`\${by}Id\` : by];
        const value = split.kind === "date" ? String(raw ?? "").slice(0, 7) || null : split.kind === "instant" ? (raw instanceof Date ? raw.toISOString().slice(0, 7) : null) : raw;
        groups.set(value, [...(groups.get(value) ?? []), row[field]]);
      }
      return named([...groups].map(([value, numbers]) => ({ value, number: amount(aggregate(numbers, how)) })).sort(most));
    }
    const key = split.kind === "date" ? sql<string>\`substr(\${split.column}, 1, 7)\` : split.kind === "instant" ? sql<string>\`strftime('%Y-%m', \${split.column} / 1000, 'unixepoch')\` : sql\`\${split.column}\`;
    const column = Object.hasOwn(NUMBERS, field) ? NUMBERS[field] : undefined;
    if (how !== "count" && !column)
      throw new BadInput(\`\${how} needs a number field: \${[...Object.keys(NUMBERS), ...COMPUTED].join(", ") || "there are none"}.\`);
    const pick = how === "count" || !column ? count() : { sum, average: avg, smallest: min, largest: max }[how](column);
    return named(
      db
        .select({ value: key, number: pick })
        .from(schema.bookings)
        .where(condition)
        .groupBy(key)
        .all()
        .map((r) => ({ value: r.value, number: r.number === null ? null : amount(Number(r.number)) }))
        .sort(most),
    );
  },

  /**
   * The records that fit, with their computed fields worked out: for adding those up. At most
   * 10,000, so one call never reads a whole large table; more are refused with how to narrow them.
   */
  async computedRows(condition: SQL | undefined): Promise<Record<string, unknown>[]> {
    const rows = await db.query.bookings.findMany({ where: condition, with: { session: { columns: { id: true, startsAt: true }, with: { classType: { columns: { id: true, name: true } } } }, attendee: { columns: { id: true, name: true } } }, limit: 10001 });
    if (rows.length > 10000)
      throw new BadInput("More than 10,000 records to add up a computed field over: narrow them with where.");
    return rows.map((row) => row as Record<string, unknown>);
  },

  /** Why \`where\` found none when it names a text no record has: the field's nearest values. */
  whyNone(viewer: Viewer | null, where: unknown): string | undefined {
    if (!where || typeof where !== "object") return undefined;
    for (const [name, v] of Object.entries(where)) {
      const field = Object.hasOwn(FILTERABLE, name) ? FILTERABLE[name] : undefined;
      if (field?.kind !== "text" || (typeof v !== "string" && typeof v !== "number")) continue;
      const values = db
        .selectDistinct({ v: sql<string>\`\${field.column}\` })
        .from(schema.bookings)
        .where(and(bookingData.readable(viewer), isNotNull(field.column)))
        .limit(2000)
        .all()
        .map((row) => String(row.v));
      const asked = String(v);
      if (values.length && !values.some((x) => x.toLowerCase().includes(asked.toLowerCase())))
        return \`No booking has "\${asked}" in \${name}; the nearest: \${nearest(asked, values).join(", ")}.\`;
    }
    return undefined;
  },

  /** The condition for records the viewer may read that fit \`where\` and \`search\`. */
  fitting(viewer: Viewer | null, where?: unknown, search?: string) {
    return and(
      bookingData.readable(viewer),
      whereOf(FILTERABLE, where, viewer ? eq(schema.bookings.attendeeId, viewer.id) : undefined, viewer?.id, {}),
      // Every word somewhere in the texts ("ship lamp" finds "ship's lamp").
      ...wordsOf(search).map((word) => inArray(schema.bookings.sessionId, db.select({ id: schema.sessions.id }).from(schema.sessions).where(and(inArray(schema.sessions.classTypeId, db.select({ id: schema.classTypes.id }).from(schema.classTypes).where(and(contains([schema.classTypes.name], word), classTypeData.readable(viewer)))), sessionData.readable(viewer))))),
    );
  },

  /** How many bookings the viewer may read, for a data page's overview; none to read: null. */
  count(viewer: Viewer | null): number | null {
    if (readScope(bookingAccess.read, viewer) === "none") return null;
    return db.select({ n: count() }).from(schema.bookings).where(bookingData.readable(viewer)).get()?.n ?? 0;
  },

  /** How many of a session's places are taken, and how many it has: numbers only, never whose. */
  places(sessionId: number): { taken: number; max: number; closesAt?: Date; cancelUntilAt?: Date } {
    const taken = db.select({ n: count() }).from(schema.bookings).where(and(eq(schema.bookings.sessionId, sessionId))).get()?.n ?? 0;
    return { taken, max: (db.select({ n: schema.sessions.capacity }).from(schema.sessions).where(eq(schema.sessions.id, sessionId)).get()?.n ?? 0), closesAt: (() => { const at = db.select({ t: schema.sessions.startsAt }).from(schema.sessions).where(eq(schema.sessions.id, sessionId)).get()?.t; return at ? new Date(at.getTime() - 0) : undefined; })(), cancelUntilAt: (() => { const at = db.select({ t: schema.sessions.startsAt }).from(schema.sessions).where(eq(schema.sessions.id, sessionId)).get()?.t; return at ? new Date(at.getTime() - 0) : undefined; })() };
  },

  /** The viewer's own booking for a session, if they have one. */
  mine(viewer: Viewer, sessionId: number): number | undefined {
    return db.select({ id: schema.bookings.id }).from(schema.bookings).where(and(eq(schema.bookings.sessionId, sessionId), eq(schema.bookings.attendeeId, viewer.id))).get()?.id;
  },

  async get(viewer: Viewer | null, id: number) {
    const fetched = await db.query.bookings.findFirst({
      where: and(eq(schema.bookings.id, id), bookingData.readable(viewer)),
      with: { session: { columns: { id: true, startsAt: true }, with: { classType: { columns: { id: true, name: true } } } }, attendee: { columns: { id: true, name: true } } },
    });
    const row = fetched && bookingData.shownRefs(viewer, [fetched])[0];
    return row ? row : null;
  },

  async create(viewer: Viewer | null, values: BookingSettable) {
    check(bookingAccess.create, viewer);
    checkReferences(viewer, values);
    let row: typeof schema.bookings.$inferSelect;
    try {
      // The count and the insert in one transaction: two people cannot both take the last place.
      row = db.transaction((tx) => {
      const taken = tx.select({ n: count() }).from(schema.bookings).where(and(eq(schema.bookings.sessionId, values.sessionId))).get()?.n ?? 0;
      if (taken >= (tx.select({ n: schema.sessions.capacity }).from(schema.sessions).where(eq(schema.sessions.id, values.sessionId)).get()?.n ?? 0)) throw new Conflict("full");
      if (!(!!viewer && (!!viewer.system || bookingAccess.write.roles.includes(viewer.role)))) {
        const closesAt = (() => { const at = tx.select({ t: schema.sessions.startsAt }).from(schema.sessions).where(eq(schema.sessions.id, values.sessionId)).get()?.t; return at ? new Date(at.getTime() - 0) : undefined; })();
        if (closesAt && Date.now() > closesAt.getTime()) throw new Conflict("closed");
      }
        const made = tx.insert(schema.bookings).values({ ...values, attendeeId: ownerFor(viewer, values.attendeeId) }).returning().get();
        audit(tx, viewer, { action: "created", model: "Booking", record: made.id });
        outgoing(tx, viewer, "Booking", "created", made);
        return made;
      });
    } catch (error) {
      throw error instanceof Conflict ? error : refusal(error);
    }
    await afterChange("afterCreate", "Booking", row, viewer);
    return row;
  },

  /** Changes the record; \`what\` names the change in the audit log (an action's name). */
  /** Changes the fields given; what names the action ("changed" for a form), frees the fields it may change although locked (its own set). */
  async update(viewer: Viewer | null, id: number, values: Partial<BookingSettable>, what = "changed", _frees: readonly string[] = []) {
    const row = db
      .select({ attendeeId: schema.bookings.attendeeId })
      .from(schema.bookings)
      .where(and(eq(schema.bookings.id, id), bookingData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    // A form's change needs write on the record; an action (what names it) checked its own access
    // first, which includes the roles its grant names (docs/design/actions.md, Access).
    if (what === "changed") check(bookingAccess.write, viewer, row.attendeeId);
    checkReferences(viewer, values);
    let changed: typeof schema.bookings.$inferSelect;
    const updated = { ...values, attendeeId: (!!viewer && (!!viewer.system || bookingAccess.write.roles.includes(viewer.role))) ? (values.attendeeId === undefined ? row.attendeeId : values.attendeeId) : personOf(viewer) };
    try {
      changed = db.transaction((tx) => {
        // Read again in the change itself: a record that left the viewer's reach meanwhile is refused.
        const before = tx.select().from(schema.bookings).where(and(eq(schema.bookings.id, id), bookingData.readable(viewer))).get();
        if (!before) throw new AccessDenied(viewer !== null);
        {
          const counted = (_r: Record<string, unknown>) => true;
          const perId = values.sessionId ?? before.sessionId;
          const moving = values.sessionId !== undefined && values.sessionId !== before.sessionId;
          const was = counted(before);
          const will = counted({ ...before, ...updated });
          if (will && (moving || !was)) {
            const taken = tx.select({ n: count() }).from(schema.bookings).where(and(eq(schema.bookings.sessionId, perId), ne(schema.bookings.id, id))).get()?.n ?? 0;
            if (taken >= (tx.select({ n: schema.sessions.capacity }).from(schema.sessions).where(eq(schema.sessions.id, perId)).get()?.n ?? 0)) throw new Conflict("full");
            if (!(!!viewer && (!!viewer.system || bookingAccess.write.roles.includes(viewer.role)))) {
              const closesAt = (() => { const at = tx.select({ t: schema.sessions.startsAt }).from(schema.sessions).where(eq(schema.sessions.id, perId)).get()?.t; return at ? new Date(at.getTime() - 0) : undefined; })();
              if (closesAt && Date.now() > closesAt.getTime()) throw new Conflict("closed");
            }
          }
          if (was && !will && !moving && !(!!viewer && (!!viewer.system || bookingAccess.write.roles.includes(viewer.role)))) {
            const cancelUntilAt = (() => { const at = tx.select({ t: schema.sessions.startsAt }).from(schema.sessions).where(eq(schema.sessions.id, perId)).get()?.t; return at ? new Date(at.getTime() - 0) : undefined; })();
            if (cancelUntilAt && Date.now() > cancelUntilAt.getTime()) throw new Conflict("cancel-closed");
          }
        }
        const after = tx.update(schema.bookings).set(updated).where(eq(schema.bookings.id, id)).returning().get();
        audit(tx, viewer, { action: what, model: "Booking", record: id, fields: before && changedFields(before, after, Object.keys(updated)) });
        outgoing(tx, viewer, "Booking", what, after, before);
        return after;
      });
    } catch (error) {
      throw error instanceof Conflict ? error : refusal(error);
    }
    await afterChange("afterUpdate", "Booking", changed, viewer);
    return changed;
  },

  /** Deletes the record; \`together\` takes the records that point to it along to the trash (delete-together.md). */
  async remove(viewer: Viewer | null, id: number, _together = false): Promise<void> {
    const row = db
      .select({ attendeeId: schema.bookings.attendeeId })
      .from(schema.bookings)
      .where(and(eq(schema.bookings.id, id), bookingData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(bookingAccess.delete, viewer, row.attendeeId);
    try {
      db.transaction((tx) => {
        // Read again in the change itself: a record that left the viewer's reach meanwhile is refused.
        if (!tx.select({ id: schema.bookings.id }).from(schema.bookings).where(and(eq(schema.bookings.id, id), bookingData.readable(viewer))).get())
          throw new AccessDenied(viewer !== null);
        // Past cancelUntil (docs/design/booking.md §6), only a role that deletes everyone's records does.
        if (!(!!viewer && (!!viewer.system || bookingAccess.delete.roles.includes(viewer.role)))) {
          const perId = tx.select({ p: schema.bookings.sessionId }).from(schema.bookings).where(eq(schema.bookings.id, id)).get()?.p;
          const cancelUntilAt = perId == null ? undefined : (() => { const at = tx.select({ t: schema.sessions.startsAt }).from(schema.sessions).where(eq(schema.sessions.id, perId)).get()?.t; return at ? new Date(at.getTime() - 0) : undefined; })();
          if (cancelUntilAt && Date.now() > cancelUntilAt.getTime()) throw new Conflict("cancel-closed");
        }
        const gone = tx.delete(schema.bookings).where(eq(schema.bookings.id, id)).returning().get();
        if (gone) {
          audit(tx, viewer, { action: "deleted", model: "Booking", record: id, title: gone.id });
          outgoing(tx, viewer, "Booking", "deleted", gone);
        }
      });
    } catch (error) {
      throw refusal(error);
    }
    await afterDelete("Booking", id, viewer);
  },

  /**
   * Deletes the chosen records the viewer may delete, all or none (one still in use stops them
   * all, and is named); the others are skipped.
   */
  async removeMany(viewer: Viewer | null, ids: number[], _together = false): Promise<{ deleted: number; skipped: number }> {
    const rows = db
      .select({ id: schema.bookings.id, attendeeId: schema.bookings.attendeeId })
      .from(schema.bookings)
      .where(and(inArray(schema.bookings.id, ids), bookingData.readable(viewer)))
      .all()
      .filter((row) => allows(bookingAccess.delete, viewer, row.attendeeId));
    db.transaction((tx) => {
      for (const row of rows)
        try {
          const gone = tx.delete(schema.bookings).where(eq(schema.bookings.id, row.id)).returning().get();
          if (gone) {
            audit(tx, viewer, { action: "deleted", model: "Booking", record: row.id, title: gone.id });
            outgoing(tx, viewer, "Booking", "deleted", gone);
          }
        } catch (error) {
          const refused = refusal(error);
          throw refused instanceof Conflict && refused.message === "in-use" ? new Conflict(\`in-use:\${row.id}\`) : refused;
        }
    });
    for (const row of rows) {
      await afterDelete("Booking", row.id, viewer);
    }
    return { deleted: rows.length, skipped: new Set(ids).size - rows.length };
  },
};
"
`;

exports[`../../../examples/booking/smithable.yml > file list and generated code > src/generated/booking.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { z } from "zod";
import type * as schema from "#/db/schema";
import { allows, type Rule } from "#/kit/access";
import type { RecordUi } from "#/kit/model";
import { bookingAccess, bookingData } from "./booking.server";
import { sessionData } from "./session.server";
import { writeAllowed } from "#/kit/limit";
import { userOptions } from "./users";
import { currentViewer } from "#/lib/viewer.server";
import { bookingSchema, type BookingValues } from "./booking.schema";

export type { BookingSettable, BookingValues } from "./booking.schema";

/** The viewer about to write, counted against how often one may (see src/kit/limit.ts). */
async function writer() {
  const viewer = await currentViewer();
  writeAllowed(viewer, getRequestHeaders());
  return viewer;
}

/** Booking records as the kit reads them. */
export type BookingRow = typeof schema.bookings.$inferSelect & {
  session?: { id: number; $name?: string } | null;
  attendee?: { id: string; name: string } | null;
  $name?: string;
};

export const bookingUi: RecordUi<BookingRow> = {
  model: "Booking",
  label: "Booking",
  pluralLabel: "Bookings",
  titleField: "$name",
  columns: ["sessionId", "attendeeId"],
  fields: [
    {
      name: "sessionId",
      label: "Session",
      kind: "relation",
      required: true,
      relation: { key: "session", titleField: "$name" },
      get: (row) => row.session?.$name ?? null,
    },
    {
      name: "attendeeId",
      label: "Attendee",
      kind: "user",
      required: false,
      relation: { key: "attendee", titleField: "name" },
      get: (row) => row.attendee?.name ?? null,
    },
  ],
};

/** Who may delete bookings: a list's selection offers Delete by it (the server checks again). */
export const bookingDeleteRule: Rule = { public: false, roles: ["admin"], owner: true };


export const listBookings = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return { rows: await bookingData.list(viewer), canCreate: allows(bookingAccess.create, viewer) };
});

export const getBooking = createServerFn()
  .validator(z.number().int())
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    const row = await bookingData.get(viewer, id);
    if (!row) return null;
    return {
      row,
      canWrite: allows(bookingAccess.write, viewer, row.attendeeId),
      canDelete: allows(bookingAccess.delete, viewer, row.attendeeId),
    };
  });

/** Whom a booking can be given to: null for a viewer who can only make their own. */
export const bookingOwnerOptions = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return (!!viewer && (!!viewer.system || bookingAccess.write.roles.includes(viewer.role))) ? userOptions() : null;
});

export const createBooking = createServerFn({ method: "POST" })
  .validator(bookingSchema)
  .handler(async ({ data }) => bookingData.create(await writer(), data));

export const updateBooking = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), values: bookingSchema }))
  .handler(async ({ data }) => bookingData.update(await writer(), data.id, data.values));

/** Deletes a booking; \`together\` takes what points to it along (docs/design/delete-together.md). */
export const deleteBooking = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), together: z.boolean().optional() }))
  .handler(async ({ data }) => bookingData.remove(await writer(), data.id, data.together));

/** Deletes the chosen bookings, all or none (at most 1,000 at once). */
export const deleteBookings = createServerFn({ method: "POST" })
  .validator(z.object({ ids: z.array(z.number().int()).max(1000), together: z.boolean().optional() }))
  .handler(async ({ data }) => bookingData.removeMany(await writer(), data.ids, data.together));

/** A session's places for the reservation block: how many are left, and the viewer's own. */
export const bookingPlaces = createServerFn()
  .validator(z.number().int())
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    if (!sessionData.canRead(viewer, id)) return null;
    const { taken, max, closesAt, cancelUntilAt } = bookingData.places(id);
    return {
      left: Math.max(0, max - taken),
      max,
      // The deadlines (docs/design/booking.md §6), for the block's words; null without one.
      closesAt: closesAt?.toISOString() ?? null,
      cancelUntilAt: cancelUntilAt?.toISOString() ?? null,
      mine: viewer ? bookingData.mine(viewer, id) : undefined,
      canBook: allows(bookingAccess.create, viewer),
      signedIn: viewer !== null,
    };
  });

/** Takes a place in one step: the other fields have their defaults. */
export const reserveBooking = createServerFn({ method: "POST" })
  .validator(z.number().int())
  .handler(async ({ data: id }) =>
    bookingData.create(await writer(), { sessionId: id } as BookingValues),
  );
"
`;

exports[`../../../examples/booking/smithable.yml > file list and generated code > src/generated/class-type.schema.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createInsertSchema } from "drizzle-zod";
import type { z } from "zod";
import * as schema from "#/db/schema";
import { w } from "#/kit/words";

/** What a class type may be given: a form's values and what the app fills (an action's set). */
export const classTypeSettable = createInsertSchema(schema.classTypes, {
  name: (s) => s.trim().min(1, w.required).max(200, w.atMostCharacters(200)),
  summary: (s) => s.max(10000, w.atMostCharacters(10000)),
}).omit({ id: true, ownerId: true, createdAt: true, updatedAt: true });
/** What a class type's form sends, checked. */
export const classTypeSchema = classTypeSettable;

export type ClassTypeSettable = z.output<typeof classTypeSettable>;
export type ClassTypeValues = z.output<typeof classTypeSchema>;
"
`;

exports[`../../../examples/booking/smithable.yml > file list and generated code > src/generated/class-type.server.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { type AnyColumn, and, asc, avg, count, desc, eq, inArray, isNotNull, max, min, sql, sum, type SQL } from "drizzle-orm";
import { db } from "#/db";
import * as schema from "#/db/schema";
import { AccessDenied, allows, check, Conflict, type ModelAccess, personOf, readScope, type Viewer } from "#/kit/access";
import { audit, changedFields } from "#/kit/audit.server";
import { refusal } from "#/kit/log.server";
import { contains } from "#/kit/search";
import { BadInput } from "#/kit/refusal";
import { aggregate, type Filterable, nearest, sortOf, whereOf, wordsOf } from "#/kit/where";
import { afterChange, afterDelete } from "./hooks";
import { sessionData } from "./session.server";
import { sessionUi } from "./session";
import { bookingUi } from "./booking";
import { classTypeUi, type ClassTypeSettable } from "./class-type";
import "./timers.server";

/** A transaction, as the group's functions are called inside one (docs/design/delete-together.md). */
type Tx = Parameters<Parameters<typeof db.transaction>[0]>[0];

/**
 * What points to a class type (docs/design/delete-together.md): the records that would go with it
 * to the trash, by model, and those that would show no class type; nothing when nothing does.
 */
function usedBy(tx: Tx, id: number, title: string) {
  const pointing: { model: string; from: string; label: string; plural: string; depth: number; count: number | null }[] = [
    { model: "Session", label: sessionUi.label, plural: sessionUi.pluralLabel, from: "ClassType", depth: 1, count: tx.select({ n: count() }).from(schema.sessions).where(and(eq(schema.sessions.classTypeId, id))).get()?.n ?? 0 },
    { model: "Booking", label: bookingUi.label, plural: bookingUi.pluralLabel, from: "Session", depth: 2, count: tx.select({ n: count() }).from(schema.bookings).innerJoin(schema.sessions, eq(schema.bookings.sessionId, schema.sessions.id)).where(and(eq(schema.sessions.classTypeId, id))).get()?.n ?? 0 },
  ];
  // A deeper member is named when its parent has records ("and what belongs to them").
  const with_: typeof pointing = [];
  for (const e of pointing)
    if (e.count === null ? with_.some((p) => p.model === e.from) : e.count > 0) with_.push(e);
  if (!with_.length) return undefined;
  const loose = [] as { model: string; label: string; plural: string; count: number }[];
  return { id, title, model: "ClassType", label: classTypeUi.label, with: with_, loose, together: false, missing: [classTypeUi.label, sessionUi.label, bookingUi.label] };
}

/** Who may read, create, change and delete class types. */
export const classTypeAccess: ModelAccess = {
  read: { public: true, roles: ["admin"], owner: true },
  create: { public: false, roles: ["admin"], owner: false },
  write: { public: false, roles: ["admin"], owner: true },
  delete: { public: false, roles: ["admin"], owner: true },
};

/** A record as the viewer gets it: who owns it only for its owner and roles that read every record. */
function shownTo<R extends { ownerId: string | null }>(viewer: Viewer | null, row: R): R {
  if ((viewer && row.ownerId === viewer.id) || (!!viewer && (!!viewer.system || classTypeAccess.read.roles.includes(viewer.role)))) return row;
  return { ...row, ownerId: null };
}


/** What \`where\` may name, and how: the stored fields, by kind. */
const FILTERABLE: Record<string, Filterable> = {
  name: { kind: "text", column: schema.classTypes.name },
  summary: { kind: "text", column: schema.classTypes.summary },
  level: { kind: "choice", column: schema.classTypes.level, values: ["beginner","allLevels","advanced"] },
  durationMinutes: { kind: "number", column: schema.classTypes.durationMinutes },
};

/** What the records can be sorted by. */
const SORTABLE = { id: schema.classTypes.id, name: schema.classTypes.name, summary: schema.classTypes.summary, level: schema.classTypes.level, durationMinutes: schema.classTypes.durationMinutes, createdAt: schema.classTypes.createdAt };

/** The number fields \`measure\` adds up; amounts are stored in cents. */
const NUMBERS: Record<string, AnyColumn> = { durationMinutes: schema.classTypes.durationMinutes };
const MONEY: string[] = [];

/** Computed number fields \`measure\` adds up from the records themselves. */
const COMPUTED: string[] = [];

/** The titles of the referenced records \`measureBy\` splits by, to name its groups. */
function titlesOf(_viewer: Viewer | null, _by: string, _ids: number[]): Map<unknown, string> {
  switch (_by) {
    default:
      return new Map();
  }
}

/** What \`measureBy\` may split by: choices, yes/no, references, and dates by month. */
const BY: string[] = ["level"];


export const classTypeData = {
  shownTo,
  /** The rows with each reference to a record the viewer may not read set to nothing: a related record's title is shown only to who may read it (only its id stays). */
  shownRefs<R extends Record<string, unknown>>(_viewer: Viewer | null, rows: R[]): R[] {
    return rows;
  },

  /** A condition for the class types the viewer may read. */
  readable(viewer: Viewer | null) {
    const scope = readScope(classTypeAccess.read, viewer);
    if (scope === "all") return undefined;
    return scope === "own" && viewer ? eq(schema.classTypes.ownerId, viewer.id) : sql\`false\`;
  },

  canRead(viewer: Viewer | null, id: number): boolean {
    const found = db
      .select({ id: schema.classTypes.id })
      .from(schema.classTypes)
      .where(and(eq(schema.classTypes.id, id), classTypeData.readable(viewer)))
      .get();
    return found !== undefined;
  },

  /** The class types the viewer may read; \`where\` narrows them, e.g. to a search; \`limit\` keeps the newest (a data page). */
  async list(viewer: Viewer | null, where?: SQL, limit?: number) {
    if (readScope(classTypeAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const found = classTypeData.shownRefs(viewer, await db.query.classTypes.findMany({
      where: and(classTypeData.readable(viewer), where),
      orderBy: (t, { desc }) => [desc(t.id)],
      limit,
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return rows;
  },

  /**
   * A page of the class types the viewer may read that fit \`where\`, newest first (or in
   * \`order\`), and how many fit in all: for a list page. A page past the end is the last one.
   */
  async page(viewer: Viewer | null, where?: SQL, order?: SQL, page = 1, size = 50) {
    if (readScope(classTypeAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = and(classTypeData.readable(viewer), where);
    const total = db.select({ n: count() }).from(schema.classTypes).where(condition).get()?.n ?? 0;
    const at = Math.min(Math.max(1, Math.trunc(page)), Math.max(1, Math.ceil(total / size)));
    const found = classTypeData.shownRefs(viewer, await db.query.classTypes.findMany({
      where: condition,
      orderBy: (t, { desc }) => [...(order ? [order] : []), desc(t.id)],
      limit: size,
      offset: (at - 1) * size,
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return { rows: rows, total, page: at, size };
  },

  /**
   * The class types the viewer may read that fit \`where\` and \`search\`, in \`sort\`'s order (else newest
   * first), a page of them and how many there are: for the API and the assistants' tools.
   */
  async find(
    viewer: Viewer | null,
    options: { where?: unknown; search?: string; sort?: string; limit?: number; offset?: number } = {},
  ) {
    if (readScope(classTypeAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = classTypeData.fitting(viewer, options.where, options.search);
    const order = sortOf(SORTABLE, options.sort);
    const total = db.select({ n: count() }).from(schema.classTypes).where(condition).get()?.n ?? 0;
    const found = classTypeData.shownRefs(viewer, await db.query.classTypes.findMany({
      where: condition,
      orderBy: (t, { desc }) => [...(order ? [order] : []), desc(t.id)],
      limit: options.limit ?? 100,
      offset: options.offset ?? 0,
    }));
    const rows = found.map((row) => shownTo(viewer, row));
    return { items: rows, total };
  },

  /**
   * A number from the class types the viewer may read that fit \`where\`: how many, or the sum,
   * average, smallest or largest of a number field.
   */
  async measure(
    viewer: Viewer | null,
    how: "count" | "sum" | "average" | "smallest" | "largest",
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<number | null> {
    if (readScope(classTypeAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const condition = classTypeData.fitting(viewer, options.where, options.search);
    if (how === "count")
      return db.select({ n: count() }).from(schema.classTypes).where(condition).get()?.n ?? 0;
    const field = options.field ?? "";
    const money = MONEY.includes(field);
    if (COMPUTED.includes(field)) {
      const rows = await classTypeData.computedRows(condition);
      const value = aggregate(rows.map((row) => row[field]), how);
      return value === null ? null : money ? value / 100 : value;
    }
    const column = Object.hasOwn(NUMBERS, field) ? NUMBERS[field] : undefined;
    if (!column)
      throw new BadInput(
        \`\${how} needs a number field: \${[...Object.keys(NUMBERS), ...COMPUTED].join(", ") || "there are none"}.\`,
      );
    const pick = { sum, average: avg, smallest: min, largest: max }[how];
    const value = db.select({ v: pick(column) }).from(schema.classTypes).where(condition).get()?.v;
    if (value === null || value === undefined) return null;
    return money ? Number(value) / 100 : Number(value);
  },

  /** Which record holds the smallest or largest value of a number field (the first of a tie). */
  async holder(
    viewer: Viewer | null,
    how: "smallest" | "largest",
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<{ id: number; title: string } | null> {
    const condition = classTypeData.fitting(viewer, options.where, options.search);
    const field = options.field ?? "";
    if (COMPUTED.includes(field)) {
      let best: Record<string, unknown> | undefined;
      for (const row of await classTypeData.computedRows(condition)) {
        const v = row[field];
        if (typeof v !== "number") continue;
        if (!best || (how === "largest" ? v > (best[field] as number) : v < (best[field] as number))) best = row;
      }
      return best ? { id: best.id as number, title: String(best.name) } : null;
    }
    const column = Object.hasOwn(NUMBERS, field) ? NUMBERS[field] : undefined;
    if (!column) return null;
    const row = db
      .select({ id: schema.classTypes.id, title: schema.classTypes.name })
      .from(schema.classTypes)
      .where(and(condition, isNotNull(column)))
      .orderBy(how === "largest" ? desc(column) : asc(column), asc(schema.classTypes.id))
      .limit(1)
      .get();
    return row ? { id: row.id, title: String(row.title) } : null;
  },

  /**
   * The same number per value of a field (a choice, yes/no, a reference) or per month of a date:
   * \`[{ value, number }]\`, the most first.
   */
  async measureBy(
    viewer: Viewer | null,
    how: "count" | "sum" | "average" | "smallest" | "largest",
    by: string,
    options: { field?: string; where?: unknown; search?: string } = {},
  ): Promise<{ value: unknown; title?: string; number: number | null }[]> {
    if (readScope(classTypeAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const split = Object.hasOwn(FILTERABLE, by) ? FILTERABLE[by] : undefined;
    if (!split || split.kind === "text" || split.kind === "number" || split.kind === "money")
      throw new BadInput(\`There is no field "\${by}" to split by. Fields: \${BY.join(", ")}.\`);
    const field = options.field ?? "";
    const money = MONEY.includes(field);
    const condition = classTypeData.fitting(viewer, options.where, options.search);
    const amount = (n: number | null) => (n === null ? null : money ? n / 100 : n);
    const most = (a: { number: number | null }, b: { number: number | null }) => (b.number ?? 0) - (a.number ?? 0);
    // A reference's groups carry the referenced record's title beside its id.
    const named = (rows: { value: unknown; number: number | null }[]) => {
      if (split.kind !== "reference") return rows;
      const titles = titlesOf(viewer, by, rows.map((r) => r.value).filter((v): v is number => typeof v === "number"));
      return rows.map((r) => (titles.has(r.value) ? { value: r.value, title: titles.get(r.value), number: r.number } : r));
    };
    if (COMPUTED.includes(field)) {
      // Each record's month or value, then the computed numbers added up per group.
      const groups = new Map<unknown, unknown[]>();
      for (const row of await classTypeData.computedRows(condition)) {
        const raw = row[split.kind === "reference" ? \`\${by}Id\` : by];
        const value = split.kind === "date" ? String(raw ?? "").slice(0, 7) || null : split.kind === "instant" ? (raw instanceof Date ? raw.toISOString().slice(0, 7) : null) : raw;
        groups.set(value, [...(groups.get(value) ?? []), row[field]]);
      }
      return named([...groups].map(([value, numbers]) => ({ value, number: amount(aggregate(numbers, how)) })).sort(most));
    }
    const key = split.kind === "date" ? sql<string>\`substr(\${split.column}, 1, 7)\` : split.kind === "instant" ? sql<string>\`strftime('%Y-%m', \${split.column} / 1000, 'unixepoch')\` : sql\`\${split.column}\`;
    const column = Object.hasOwn(NUMBERS, field) ? NUMBERS[field] : undefined;
    if (how !== "count" && !column)
      throw new BadInput(\`\${how} needs a number field: \${[...Object.keys(NUMBERS), ...COMPUTED].join(", ") || "there are none"}.\`);
    const pick = how === "count" || !column ? count() : { sum, average: avg, smallest: min, largest: max }[how](column);
    return named(
      db
        .select({ value: key, number: pick })
        .from(schema.classTypes)
        .where(condition)
        .groupBy(key)
        .all()
        .map((r) => ({ value: r.value, number: r.number === null ? null : amount(Number(r.number)) }))
        .sort(most),
    );
  },

  /**
   * The records that fit, with their computed fields worked out: for adding those up. At most
   * 10,000, so one call never reads a whole large table; more are refused with how to narrow them.
   */
  async computedRows(condition: SQL | undefined): Promise<Record<string, unknown>[]> {
    const rows = await db.query.classTypes.findMany({ where: condition, limit: 10001 });
    if (rows.length > 10000)
      throw new BadInput("More than 10,000 records to add up a computed field over: narrow them with where.");
    return rows.map((row) => row as Record<string, unknown>);
  },

  /** The class types the viewer may read whose name has the text: a few, for naming one. */
  named(viewer: Viewer | null, text: string): { id: number; title: string }[] {
    return db
      .select({ id: schema.classTypes.id, title: schema.classTypes.name })
      .from(schema.classTypes)
      .where(and(classTypeData.readable(viewer), contains([schema.classTypes.name], text)))
      .limit(6)
      .all()
      .map((row) => ({ id: row.id, title: String(row.title) }));
  },

  /** Every name the viewer may read (at most 2,000): the nearest when a name fits none. */
  titles(viewer: Viewer | null): string[] {
    return db
      .select({ title: schema.classTypes.name })
      .from(schema.classTypes)
      .where(classTypeData.readable(viewer))
      .limit(2000)
      .all()
      .map((row) => String(row.title));
  },

  /** Why \`where\` found none when it names a text no record has: the field's nearest values. */
  whyNone(viewer: Viewer | null, where: unknown): string | undefined {
    if (!where || typeof where !== "object") return undefined;
    for (const [name, v] of Object.entries(where)) {
      const field = Object.hasOwn(FILTERABLE, name) ? FILTERABLE[name] : undefined;
      if (field?.kind !== "text" || (typeof v !== "string" && typeof v !== "number")) continue;
      const values = db
        .selectDistinct({ v: sql<string>\`\${field.column}\` })
        .from(schema.classTypes)
        .where(and(classTypeData.readable(viewer), isNotNull(field.column)))
        .limit(2000)
        .all()
        .map((row) => String(row.v));
      const asked = String(v);
      if (values.length && !values.some((x) => x.toLowerCase().includes(asked.toLowerCase())))
        return \`No class type has "\${asked}" in \${name}; the nearest: \${nearest(asked, values).join(", ")}.\`;
    }
    return undefined;
  },

  /** The condition for records the viewer may read that fit \`where\` and \`search\`. */
  fitting(viewer: Viewer | null, where?: unknown, search?: string) {
    return and(
      classTypeData.readable(viewer),
      whereOf(FILTERABLE, where, viewer ? eq(schema.classTypes.ownerId, viewer.id) : undefined, viewer?.id, {}),
      // Every word somewhere in the texts ("ship lamp" finds "ship's lamp").
      ...wordsOf(search).map((word) => contains([schema.classTypes.name, schema.classTypes.summary], word)),
    );
  },

  /** How many class types the viewer may read, for a data page's overview; none to read: null. */
  count(viewer: Viewer | null): number | null {
    if (readScope(classTypeAccess.read, viewer) === "none") return null;
    return db.select({ n: count() }).from(schema.classTypes).where(classTypeData.readable(viewer)).get()?.n ?? 0;
  },

  async get(viewer: Viewer | null, id: number) {
    const fetched = await db.query.classTypes.findFirst({
      where: and(eq(schema.classTypes.id, id), classTypeData.readable(viewer)),
      with: { sessions: { where: sessionData.readable(viewer), with: { classType: { columns: { id: true, name: true } }, instructor: { columns: { id: true, name: true } } } } },
    });
    const found = fetched && classTypeData.shownRefs(viewer, [{ ...fetched, sessions: sessionData.shownRefs(viewer, fetched.sessions) }])[0];
    const row = found && { ...shownTo(viewer, found), sessions: found.sessions.map((r) => sessionData.shownTo(viewer, r)) };
    return row ? row : null;
  },

  async create(viewer: Viewer | null, values: ClassTypeSettable) {
    check(classTypeAccess.create, viewer);
    let row: typeof schema.classTypes.$inferSelect;
    try {
      row = db.transaction((tx) => {
        const made = tx.insert(schema.classTypes).values({ ...values, ownerId: personOf(viewer) }).returning().get();
        audit(tx, viewer, { action: "created", model: "ClassType", record: made.id });
        return made;
      });
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterCreate", "ClassType", row, viewer);
    return row;
  },

  /** Changes the record; \`what\` names the change in the audit log (an action's name). */
  /** Changes the fields given; what names the action ("changed" for a form), frees the fields it may change although locked (its own set). */
  async update(viewer: Viewer | null, id: number, values: Partial<ClassTypeSettable>, what = "changed", _frees: readonly string[] = []) {
    const row = db
      .select({ ownerId: schema.classTypes.ownerId })
      .from(schema.classTypes)
      .where(and(eq(schema.classTypes.id, id), classTypeData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    // A form's change needs write on the record; an action (what names it) checked its own access
    // first, which includes the roles its grant names (docs/design/actions.md, Access).
    if (what === "changed") check(classTypeAccess.write, viewer, row.ownerId);
    let changed: typeof schema.classTypes.$inferSelect;
    const updated = values;
    try {
      changed = db.transaction((tx) => {
        // Read again in the change itself: a record that left the viewer's reach meanwhile is refused.
        const before = tx.select().from(schema.classTypes).where(and(eq(schema.classTypes.id, id), classTypeData.readable(viewer))).get();
        if (!before) throw new AccessDenied(viewer !== null);
        const after = tx.update(schema.classTypes).set(updated).where(eq(schema.classTypes.id, id)).returning().get();
        audit(tx, viewer, { action: what, model: "ClassType", record: id, fields: before && changedFields(before, after, Object.keys(updated)) });
        return after;
      });
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterUpdate", "ClassType", changed, viewer);
    return changed;
  },

  /** Deletes the record; \`together\` takes the records that point to it along to the trash (delete-together.md). */
  async remove(viewer: Viewer | null, id: number, _together = false): Promise<void> {
    const row = db
      .select({ name: schema.classTypes.name, ownerId: schema.classTypes.ownerId })
      .from(schema.classTypes)
      .where(and(eq(schema.classTypes.id, id), classTypeData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(classTypeAccess.delete, viewer, row.ownerId);
    try {
      db.transaction((tx) => {
        // Read again in the change itself: a record that left the viewer's reach meanwhile is refused.
        if (!tx.select({ id: schema.classTypes.id }).from(schema.classTypes).where(and(eq(schema.classTypes.id, id), classTypeData.readable(viewer))).get())
          throw new AccessDenied(viewer !== null);
        const used = usedBy(tx, id, String(row.name ?? id));
        if (used) throw new Conflict(\`in-use:\${JSON.stringify(used)}\`);
        const gone = tx.delete(schema.classTypes).where(eq(schema.classTypes.id, id)).returning().get();
        if (gone) {
          audit(tx, viewer, { action: "deleted", model: "ClassType", record: id, title: gone.name });
        }
      });
    } catch (error) {
      throw refusal(error);
    }
    await afterDelete("ClassType", id, viewer);
  },

  /**
   * Deletes the chosen records the viewer may delete, all or none (one still in use stops them
   * all, and is named); the others are skipped.
   */
  async removeMany(viewer: Viewer | null, ids: number[], _together = false): Promise<{ deleted: number; skipped: number }> {
    const rows = db
      .select({ id: schema.classTypes.id, name: schema.classTypes.name, ownerId: schema.classTypes.ownerId })
      .from(schema.classTypes)
      .where(and(inArray(schema.classTypes.id, ids), classTypeData.readable(viewer)))
      .all()
      .filter((row) => allows(classTypeAccess.delete, viewer, row.ownerId));
    db.transaction((tx) => {
      for (const row of rows)
        try {
          const used = usedBy(tx, row.id, String(row.name ?? row.id));
          if (used) throw new Conflict(\`in-use:\${JSON.stringify(used)}\`);
          const gone = tx.delete(schema.classTypes).where(eq(schema.classTypes.id, row.id)).returning().get();
          if (gone) {
            audit(tx, viewer, { action: "deleted", model: "ClassType", record: row.id, title: gone.name });
          }
        } catch (error) {
          const refused = refusal(error);
          throw refused instanceof Conflict && refused.message === "in-use" ? new Conflict(\`in-use:\${row.id}\`) : refused;
        }
    });
    for (const row of rows) {
      await afterDelete("ClassType", row.id, viewer);
    }
    return { deleted: rows.length, skipped: new Set(ids).size - rows.length };
  },

  /**
   * The class types the viewer may read whose name contains the text: a search of records that
   * refer to them finds them only among these.
   */
  titled(viewer: Viewer | null, text: string): number[] {
    return db
      .select({ id: schema.classTypes.id })
      .from(schema.classTypes)
      .where(and(contains([schema.classTypes.name], text), classTypeData.readable(viewer)))
      .all()
      .map((row) => row.id);
  },

  /** Choices for fields that refer to a class type: the ones the viewer may read. */
  options(viewer: Viewer | null) {
    if (readScope(classTypeAccess.read, viewer) === "none") return [];
    return db
      .select({ value: schema.classTypes.id, label: schema.classTypes.name })
      .from(schema.classTypes)
      .where(classTypeData.readable(viewer))
      .orderBy(asc(schema.classTypes.name))
      .all();
  },
};
"
`;

