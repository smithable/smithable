exports[`../../../examples/barbers/smithable.yml > file list and generated code > src/routes/day/index.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, useNavigate } from "@tanstack/react-router";
import { createServerFn } from "@tanstack/react-start";
import { and, gte, lt } from "drizzle-orm";
import { z } from "zod";
import { count, optional, type Search, shaped } from "#/kit/params";
import * as schema from "#/db/schema";
import { app } from "#/generated/app";
import { pageAccess, pageUi, pageHead } from "#/generated/pages";
import { appointmentAccess, appointmentData } from "#/generated/appointment.server";
import { allows, guardPage } from "#/kit/access";
import { PageHeader } from "#/kit/AppShell";
import { Calendar, calendarRange } from "#/kit/Calendar";
import { w } from "#/kit/words";
import { currentViewer } from "#/lib/viewer.server";
import { serviceData } from "#/generated/service.server";
import { barberData } from "#/generated/barber.server";

/** The appointments whose start falls in the range shown, among those the viewer may read. */
const getRange = createServerFn()
  // A real range, and no longer than a month view needs (six weeks and a day on each side).
  .validator(
    z
      .object({ from: z.iso.datetime(), to: z.iso.datetime() })
      .refine((r) => Date.parse(r.from) < Date.parse(r.to) && Date.parse(r.to) - Date.parse(r.from) <= 44 * 86_400_000, "The range is not a week or a month."),
  )
  .handler(async ({ data }) => {
    const viewer = await currentViewer();
    const rows = await appointmentData.list(viewer, and(gte(schema.appointments.startsAt, new Date(data.from)), lt(schema.appointments.startsAt, new Date(data.to))));
    // How long each Service lasts, among those the viewer may read.
    const minutes = new Map((await serviceData.list(viewer)).map((r) => [r.id, r.minutes]));
    return {
      items: rows.map((row) => ({
        id: row.id,
        start: row.startsAt,
        end: new Date(row.startsAt.getTime() + (minutes.get(row.serviceId) ?? 60) * 60_000),
        title: String(row.name ?? ""),
        lane: row.barberId,
      })),
      // Whose time the records take, among those the viewer may read, in their order (as "anyone"
      // takes them): the day view's columns.
      lanes: (await barberData.list(viewer)).map((r) => ({ id: r.id, title: String(r.name ?? "") })).sort((a, b) => a.id - b.id),
      // Records are made on their page: the viewer must be able to open it, too.
      canCreate: allows(appointmentAccess.create, viewer) && allows(pageAccess["appointments"], viewer),
      canOpen: allows(pageAccess["appointments"], viewer),
    };
  });

export const Route = createFileRoute("/day/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["day"], context.viewer, location.href),
  head: () => pageHead("day"),
  validateSearch: (s: Search) => optional({
    day: shaped(s.day, /^\\d{4}-\\d{2}-\\d{2}$/),
    week: shaped(s.week, /^\\d{4}-W\\d{2}$/),
    month: shaped(s.month, /^\\d{4}-\\d{2}$/),
    // The record whose panel is open, so a sign-in or a link returns to it.
    open: count(s.open),
  }),
  // The period shown decides what is loaded; opening a record's panel loads nothing again.
  loaderDeps: ({ search: { open: _open, ...period } }) => period,
  loader: ({ deps }) => {
    const range = calendarRange(deps, app.timeZone);
    return getRange({ data: { from: range.from.toISOString(), to: range.to.toISOString() } });
  },
  component: DayPage,
});

function DayPage() {
  const { items, canCreate, canOpen, lanes } = Route.useLoaderData();
  const search = Route.useSearch();
  const navigate = useNavigate();
  return (
    <>
      <PageHeader page="day" title={pageUi["day"].title} />
      <Calendar
        search={search}
        items={items}
        timeZone={app.timeZone}
        dateOnly={false}
        lanes={lanes}
        newLabel={w.newOne("appointment")}
        onNavigate={(next, replace) => navigate({ to: "/day", search: next, replace })}
        onOpen={canOpen ? (id) => navigate({ to: "/appointments/$id", params: { id: String(id) } }) : undefined}
        onCreate={
          canCreate
            ? (start) => navigate({ to: "/appointments/new", search: { startsAt: start } })
            : undefined
        }
      />
    </>
  );
}
"
`;

