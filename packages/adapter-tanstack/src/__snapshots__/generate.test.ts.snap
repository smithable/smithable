"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createRootRoute, HeadContent, Scripts, useRouter, useRouterState } from "@tanstack/react-router";
import { createServerFn } from "@tanstack/react-start";
import { BookOpen, Calendar, Layers, Mail, Users } from "lucide-react";
import { app } from "#/generated/app";
import { pageAccess } from "#/generated/pages";
import { currentViewer } from "#/lib/viewer.server";
import { AppShell, ErrorNotice, type MenuUi } from "#/kit/AppShell";
import { LandingLayout } from "#/kit/Landing";
import { site } from "#/generated/site";
import { pageHeaders } from "#/kit/security";
import { authClient } from "#/lib/auth-client";
import appCss from "#/styles.css?url";

const menus: MenuUi[] = [
  {
    name: "main",
    items: [
      {
        to: "/schedule",
        label: "Schedule",
        icon: Calendar,
        access: pageAccess["schedule"],
      },
      {
        to: "/sessions",
        label: "Sessions",
        icon: Calendar,
        access: pageAccess["sessions"],
      },
      {
        to: "/class-types",
        label: "Class types",
        icon: Layers,
        access: pageAccess["class-types"],
      },
      {
        to: "/instructors",
        label: "Instructors",
        icon: Users,
        access: pageAccess["instructors"],
      },
      {
        to: "/messages",
        label: "Messages",
        icon: Mail,
        access: pageAccess["messages"],
      },
      {
        to: "/blog",
        label: "Blog",
        icon: BookOpen,
        access: pageAccess["blog"],
      },
      {
        to: "/posts",
        label: "Posts",
        icon: BookOpen,
        access: pageAccess["posts"],
      },
      {
        to: "/my-bookings",
        label: "My bookings",
        icon: Calendar,
        access: pageAccess["my-bookings"],
      },
      {
        to: "/admin",
        label: "Admin",
        icon: Layers,
        access: pageAccess["admin"],
      },
    ],
  },
];

const landingRoutes = ["/"];
/** Public articles: their list and each article have the site's frame. */
const siteRoutes = ["/blog"];
/** Public pages that visitors see in the site's frame (signed in, the app's). */
const visitorRoutes = ["/schedule"];

/** Each page's route and name, longest route first. */
const pageRoutes: [string, string][] = [
  ["/class-types", "class-types"],
  ["/instructors", "instructors"],
  ["/my-bookings", "my-bookings"],
  ["/messages", "messages"],
  ["/schedule", "schedule"],
  ["/sessions", "sessions"],
  ["/admin", "admin"],
  ["/posts", "posts"],
  ["/blog", "blog"],
  ["/", "home"],
];

/** The page a path is on, e.g. "customers" for /customers/12 (see data-page, src/custom/styles.css). */
function pageOf(path: string): string | undefined {
  return pageRoutes.find(([route]) => path === route || path.startsWith(route === "/" ? "/" : \`\${route}/\`))?.[1];
}


// Who is signed in, and, when a hosting service runs a copy of the app's data from an earlier
// time to look at (DATA_AS_OF), that time.
const getViewer = createServerFn().handler(async () => ({
  viewer: await currentViewer(),
  asOf: process.env.DATA_AS_OF,
  demo: process.env.DEMO_SIGN_IN === "1",
}));

export const Route = createRootRoute({
  // Every page knows who is signed in; pages check their access with it.
  beforeLoad: () => getViewer(),
  headers: ({ ssr }) => pageHeaders(ssr?.nonce),
  head: () => ({
    meta: [
      { charSet: "utf-8" },
      { name: "viewport", content: "width=device-width, initial-scale=1" },
      { title: app.name },
    ],
    links: [
      { rel: "stylesheet", href: appCss },
      { rel: "icon", href: "/favicon.svg", type: "image/svg+xml" },
    ],
  }),
  shellComponent: RootDocument,
  errorComponent: ({ error }) => (
    <ErrorNotice title="Something went wrong" message={error instanceof Error ? error.message : undefined} />
  ),
  notFoundComponent: () => (
    <ErrorNotice title="Not found" message="This page or record does not exist, or you cannot see it." />
  ),
});

function RootDocument({ children }: { children: React.ReactNode }) {
  const { viewer, asOf, demo } = Route.useRouteContext();
  const pathname = useRouterState({ select: (state) => state.location.pathname });
  const router = useRouter();
  const signOut = async () => {
    await authClient.signOut();
    await router.invalidate();
  };
  return (
    <html lang="en">
      <head>
        <HeadContent />
      </head>
      <body data-page={pageOf(pathname)}>
        {asOf && (
          <p role="status" className="bg-warning px-4 py-2 text-center text-sm text-warning-foreground">
            A copy of this app's data as of {asOf.slice(0, 16).replace("T", " ")} UTC: changes made here are not kept.
          </p>
        )}
        {demo && (
          <p role="status" className="bg-warning px-4 py-2 text-center text-sm text-warning-foreground">
            This is a demo: sign in as anyone and try things; the data is reset every hour.
          </p>
        )}
        {landingRoutes.includes(pathname) || siteRoutes.some((r) => pathname === r || pathname.startsWith(\`\${r}/\`)) ? (
          children
        ) : !viewer && visitorRoutes.some((r) => pathname === r || pathname.startsWith(\`\${r}/\`)) ? (
          <LandingLayout appName={app.name} link={{ to: "/sign-in", label: "Sign in" }} site={site}>
            <div className="mx-auto max-w-6xl px-5 py-10">{children}</div>
          </LandingLayout>
        ) : (
          <AppShell appName={app.name} home={{ to: "/", access: pageAccess["home"] }} menus={menus} viewer={viewer} onSignOut={signOut}>
            {children}
          </AppShell>
        )}
        <Scripts />
      </body>
    </html>
  );
}
"
`;

exports[`../../../examples/booking/smithable.yml > file list and generated code > src/routes/admin/bookings/$id.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, notFound, useNavigate } from "@tanstack/react-router";
import { app } from "#/generated/app";
import { pageAccess } from "#/generated/pages";
import { bookingSchema, bookingUi, deleteBooking, getBooking, updateBooking } from "#/generated/booking";
import { sessionOptions } from "#/generated/session";
import { guardPage } from "#/kit/access";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";

export const Route = createFileRoute("/admin/bookings/$id")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["admin"], context.viewer, location.href),
  loader: async ({ params }) => {
    const found = await getBooking({ data: Number(params.id) });
    if (!found) throw notFound();
    return { ...found, options: { sessionId: await sessionOptions() } };
  },
  component: BookingPage,
});

function BookingPage() {
  const { row, canWrite, canDelete, options } = Route.useLoaderData();
  const navigate = useNavigate();
  const back = () => navigate({ to: "/admin/bookings" });
  return (
    <>
      <PageHeader title={\`Booking #\${row.id}\`} />
      <ModelForm
        ui={bookingUi}
        app={app}
        schema={bookingSchema}
        initial={row}
        readOnly={!canWrite}
        options={options}
        submitLabel="Save changes"
        onSubmit={async (values) => {
          await updateBooking({ data: { id: row.id, values } });
          await back();
        }}
        onCancel={back}
        onDelete={
          canDelete
            ? async () => {
                await deleteBooking({ data: row.id });
                await back();
              }
            : undefined
        }
      />

    </>
  );
}
"
`;

