"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute } from "@tanstack/react-router";
import { pageAccess } from "#/generated/pages";
import { guardPage } from "#/kit/access";
import { LandingLayout, Hero, RecordCards, Section, CallToAction, Contact } from "#/kit/Landing";
import { w } from "#/kit/words";
import { site } from "#/generated/site";
import { listClassTypes } from "#/generated/class-type";
import { listPosts } from "#/generated/post";
import { Calendar, BookOpen } from "lucide-react";
import { Calculator } from "#/kit/Calculator";
import { homeEstimateCalculatorUi } from "#/generated/home-estimate-calculator";
import { app } from "#/generated/app";
import { createMessage, messageUi } from "#/generated/message";
import { messageSchema } from "#/generated/message.schema";
import { ModelForm } from "#/kit/ModelForm";

export const Route = createFileRoute("/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["home"], context.viewer, location.href),
  head: () => ({ meta: [{"title":"Stillwater Yoga"}] }),
  loader: async () => ({ classTypes: (await listClassTypes()).rows, posts: (await listPosts()).rows }),
  component: HomePage,
});

function HomePage() {
  const data = Route.useLoaderData();
  const { viewer } = Route.useRouteContext();
  return (
    <LandingLayout appName="Stillwater Yoga" link={viewer ? { to: "/schedule", label: w.openApp("Stillwater Yoga") } : { to: "/sign-in", label: w.signIn }} footer={{ links: [], texts: "pages.home.footer" }} site={site}>
      <Hero
          texts="pages.home.hero"
          title="Stillwater Yoga"
          subtitle="Class schedule and online booking for a small yoga studio."
          link={{ to: "/schedule", label: "Get started" }}
          shortcuts={[{ to: "/schedule", label: "Schedule", icon: Calendar }, { to: "/blog", label: "Blog", icon: BookOpen }]}
          more
        />
      <RecordCards
          texts="pages.home.classes"
          id="classes"
          title="Class types"
          cards={data.classTypes.slice(0, 6).map((row) => ({
            key: row.id,
            title: String(row.name),
            text: row.summary ?? undefined,
            badge: ({ beginner: "Beginner", allLevels: "All levels", advanced: "Advanced" } as Record<string, string>)[row.level],
          }))}
        />
      <Section
          texts="pages.home.estimate"
          id="estimate"
        >
          <Calculator ui={homeEstimateCalculatorUi} app={app} />
        </Section>
      <CallToAction
          texts="pages.home.callToAction"
          title="Ready to get started?"
          link={{ to: "/schedule", label: "Get started" }}
        />
      <RecordCards
          texts="pages.home.news"
          id="news"
          icon={BookOpen}
          title="Posts"
          cards={data.posts.slice(0, 6).map((row) => ({
            key: row.id,
            title: String(row.title),
            href: \`/blog/\${encodeURIComponent(row.address || String(row.id))}\`,
            picture: row.cover ? { src: \`/files/post/\${row.id}/cover\`, alt: row.cover.alt, width: row.cover.width, height: row.cover.height, generated: row.cover.generated } : undefined,
            text: row.summary ?? undefined,
            badge: ({ draft: "Draft", published: "Published" } as Record<string, string>)[row.status],
          }))}
        />
      <Contact
          texts="pages.home.contact"
          form={(sent, human) => (
            <ModelForm
              ui={messageUi}
              app={app}
              schema={messageSchema}
              submitLabel="Send"
              onSubmit={async (values) => {
                if (human()) await createMessage({ data: values });
                sent();
              }}
            />
          )}
        />
    </LandingLayout>
  );
}
"
`;

exports[`../../../examples/booking/smithable.yml > file list and generated code > src/routes/instructors/$id.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, notFound, useNavigate } from "@tanstack/react-router";
import { createServerFn } from "@tanstack/react-start";
import { and, desc, eq } from "drizzle-orm";
import { db } from "#/db";
import { auditLog, user } from "#/db/schema";
import { app } from "#/generated/app";
import { pageAccess } from "#/generated/pages";
import { deleteInstructor, getInstructor, instructorUi, updateInstructor } from "#/generated/instructor";
import { instructorSchema } from "#/generated/instructor.schema";
import { guardPage } from "#/kit/access";
import { ActivityLog } from "#/kit/ActivityLog";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";
import { w } from "#/kit/words";
import { currentViewer } from "#/lib/viewer.server";

/** The record's lines in the audit log, newest first: administrators only, nobody else. */
const getHistory = createServerFn()
  .validator((id: number) => id)
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    if (viewer?.role !== "admin") return null;
    const people = new Map(db.select({ id: user.id, name: user.name }).from(user).all().map((p) => [p.id, p.name]));
    return db
      .select()
      .from(auditLog)
      .where(and(eq(auditLog.model, "Instructor"), eq(auditLog.recordId, id)))
      .orderBy(desc(auditLog.id))
      .limit(50)
      .all()
      .map((r) => ({
        id: r.id,
        at: r.at,
        who: r.who === "visitor" || r.who === "the app" ? r.who : (people.get(r.who) ?? (r.who.startsWith("key:") ? w.aKey(r.who.slice(4)) : w.aRemovedUser(r.who))),
        action: r.action,
        fields: r.fields,
        details: r.details ? Object.fromEntries(Object.entries(r.details).map(([k, v]) => [k, String(v)])) : null,
      }));
  });

export const Route = createFileRoute("/instructors/$id")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["instructors"], context.viewer, location.href),
  head: () => ({ meta: [{"title":"Instructors · Stillwater Yoga"}] }),
  loader: async ({ params }) => {
    const found = await getInstructor({ data: Number(params.id) });
    if (!found) throw notFound();
    return { ...found, history: await getHistory({ data: Number(params.id) }) };
  },
  component: InstructorPage,
});

function InstructorPage() {
  const { row, canWrite, canDelete, history } = Route.useLoaderData();
  const navigate = useNavigate();
  const back = () => navigate({ to: "/instructors" });
  return (
    <>
      <PageHeader title={row.name || \`Instructor #\${row.id}\`} />
      <ModelForm
        key={String(row.updatedAt)}
        ui={instructorUi}
        app={app}
        schema={instructorSchema}
        initial={row}
        readOnly={!canWrite}
        submitLabel={w.saveChanges}
        onSubmit={async (values) => {
          await updateInstructor({ data: { id: row.id, values } });
          await back();
        }}
        onCancel={back}
        onDelete={
          canDelete
            ? async (together?: boolean) => {
                await deleteInstructor({ data: { id: row.id, together } });
                await back();
              }
            : undefined
        }
      />

      {history && history.length > 0 && (
        <section className="mt-10 max-w-3xl">
          <h2 className="mb-3 text-lg font-semibold">{w.history}</h2>
          <ActivityLog lines={history} app={app} />
        </section>
      )}
    </>
  );
}
"
`;

exports[`../../../examples/booking/smithable.yml > file list and generated code > src/routes/instructors/index.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, Link, useNavigate, useRouter } from "@tanstack/react-router";
import { pageAccess } from "#/generated/pages";
import { guardPage, allows } from "#/kit/access";
import { createServerFn } from "@tanstack/react-start";
import { instructorAccess, instructorData } from "#/generated/instructor.server";
import { currentViewer } from "#/lib/viewer.server";
import { type Search, count, listQuery, optional } from "#/kit/params";
import { buttonVariants } from "#/components/ui/button";
import { useState } from "react";
import { SelectionBar } from "#/kit/SelectionBar";
import { csvName, csvOf, download } from "#/kit/csv";
import { deleteInstructors, instructorDeleteRule, instructorUi } from "#/generated/instructor";
import { app } from "#/generated/app";
import { w } from "#/kit/words";
import { PageHeader } from "#/kit/AppShell";
import { ModelTable } from "#/kit/ModelTable";
import { Users } from "lucide-react";

/** A page of the instructors the viewer may read. */
const listInstructors = createServerFn()
  .validator(listQuery)
  .handler(async ({ data }) => {
    const viewer = await currentViewer();
    return { ...(await instructorData.page(viewer, undefined, undefined, data.all ? 1 : data.page, data.all ? (viewer ? 10000 : 500) : undefined)), canCreate: allows(instructorAccess.create, viewer) };
  });

export const Route = createFileRoute("/instructors/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["instructors"], context.viewer, location.href),
  head: () => ({ meta: [{"title":"Instructors · Stillwater Yoga"}] }),
  validateSearch: (s: Search) => optional({ page: count(s.page) }),
  loaderDeps: ({ search }) => ({ page: search.page }),
  loader: ({ deps }) => listInstructors({ data: { page: deps.page } }),
  component: InstructorsPage,
});

function InstructorsPage() {
  const { rows, canCreate, total, page: at, size } = Route.useLoaderData();
  const { viewer } = Route.useRouteContext();
  const navigate = useNavigate({ from: "/instructors/" });
  const router = useRouter();
  // The chosen rows, offered when the viewer may do something to at least one row.
  const [selected, setSelected] = useState<Set<number>>(new Set());
  const chosen = rows.filter((row) => selected.has(row.id));
  const selectable = rows.some((row) => allows(instructorDeleteRule, viewer, row.ownerId));
  const newButton = canCreate && (
    <Link to="/instructors/new" className={buttonVariants()}>
      {w.newOne("instructor")}
    </Link>
  );
  return (
    <>
      <PageHeader
        page="instructors"
        title="Instructors"
        actions={newButton}
      />
      {selectable && (
        <SelectionBar
          count={chosen.length}
          noun={["instructor", "instructors"]}
          app={app}
          titleOf={(id) => String(rows.find((row) => row.id === id)?.name ?? id)}
          actions={[]}
          deletable={chosen.filter((row) => allows(instructorDeleteRule, viewer, row.ownerId)).length}
          onDelete={(together) => deleteInstructors({ data: { ids: chosen.map((row) => row.id), together } })}
          onDone={async () => {
            setSelected(new Set());
            await router.invalidate();
          }}
          onExport={() => download(csvName(instructorUi), csvOf(instructorUi, chosen))}
        />
      )}
      <ModelTable
        ui={instructorUi}
        page="instructors"
        paging={{ page: at, size, total, to: (next) => navigate({ to: "/instructors", search: (prev) => ({ ...prev, page: next > 1 ? next : undefined }) }) }}
        app={app}
        exportRows={async () => (await listInstructors({ data: { all: true } })).rows}
        rows={rows}
        icon={Users}
        selection={selectable ? { ids: selected, onChange: setSelected } : undefined}
        emptyAction={newButton || undefined}
        onOpen={(row) => navigate({ to: "/instructors/$id", params: { id: String(row.id) } })}
      />
    </>
  );
}
"
`;

