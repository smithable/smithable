exports[`../../../examples/crm/smithable.yml > file list and generated code > src/generated/users.server.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// Who has access: the users and the open invitations, and what an administrator does with them.
// Server-only. The users page's server functions pass the viewer; nothing here trusts the client.
import { randomBytes, randomUUID } from "node:crypto";
import { getRequestUrl } from "@tanstack/react-start/server";
import { asc, eq } from "drizzle-orm";
import { db } from "#/db";
import { invitation, user } from "#/db/schema";
import { app } from "#/generated/app";
import { pageAccess } from "#/generated/pages";
import { check, type Viewer } from "#/kit/access";
import { sendMail } from "#/kit/mail";

export const ROLES = ["admin", "sales"] as const;
export type Role = (typeof ROLES)[number];
export const ROLE_LABELS: Record<string, string> = { admin: "Admin", sales: "Sales" };
/** How long an invitation can be accepted. */
export const INVITATION_DAYS = 14;

/** Who may manage users: the team page's rule (administrators always). */
const RULE = pageAccess["team"];

export interface UserRow {
  id: string;
  name: string;
  email: string;
  role: string;
}

export interface InvitationRow {
  id: string;
  email: string;
  role: string;
  expiresAt: Date;
  link: string;
}

/** Where invitation links point: the app's public address, or the address this request used. */
export const origin = () => process.env.BETTER_AUTH_URL ?? getRequestUrl().origin;

function manager(viewer: Viewer | null): Viewer {
  check(RULE, viewer);
  return viewer as Viewer;
}

const link = (origin: string, token: string) => \`\${origin}/sign-in?invite=\${token}\`;

const row = (i: typeof invitation.$inferSelect, origin: string): InvitationRow => ({
  id: i.id,
  email: i.email,
  role: i.role,
  expiresAt: i.expiresAt,
  link: link(origin, i.token),
});

/** Everyone with access, and the invitations not yet accepted. */
export async function listUsers(
  viewer: Viewer | null,
  origin: string,
): Promise<{ users: UserRow[]; invitations: InvitationRow[] }> {
  manager(viewer);
  return {
    users: db
      .select({ id: user.id, name: user.name, email: user.email, role: user.role })
      .from(user)
      .orderBy(asc(user.name))
      .all(),
    invitations: db
      .select()
      .from(invitation)
      .orderBy(asc(invitation.email))
      .all()
      .map((i) => row(i, origin)),
  };
}

/** Invites an address with a role, replacing an open invitation to it, and sends the mail. */
export async function invite(
  viewer: Viewer | null,
  email: string,
  role: Role,
  origin: string,
): Promise<InvitationRow> {
  const by = manager(viewer);
  const address = email.trim().toLowerCase();
  if (db.select({ id: user.id }).from(user).where(eq(user.email, address)).get())
    throw new Error(\`\${address} already has access.\`);
  db.delete(invitation).where(eq(invitation.email, address)).run();
  const created = db
    .insert(invitation)
    .values({
      id: randomUUID(),
      email: address,
      role,
      token: randomBytes(24).toString("base64url"),
      invitedById: by.id,
      expiresAt: new Date(Date.now() + INVITATION_DAYS * 86_400_000),
    })
    .returning()
    .get();
  const result = row(created, origin);
  await sendInvitation(by, result);
  return result;
}

/** Sends an open invitation again, and gives it the full time to be accepted once more. */
export async function resendInvitation(
  viewer: Viewer | null,
  invitationId: string,
  origin: string,
): Promise<void> {
  const by = manager(viewer);
  const renewed = db
    .update(invitation)
    .set({ expiresAt: new Date(Date.now() + INVITATION_DAYS * 86_400_000) })
    .where(eq(invitation.id, invitationId))
    .returning()
    .get();
  if (!renewed) throw new Error("This invitation no longer exists.");
  await sendInvitation(by, row(renewed, origin));
}

export async function withdrawInvitation(viewer: Viewer | null, invitationId: string): Promise<void> {
  manager(viewer);
  db.delete(invitation).where(eq(invitation.id, invitationId)).run();
}

/** Gives a user another role; never your own, and the last administrator stays one. */
export async function setRole(viewer: Viewer | null, userId: string, role: Role): Promise<void> {
  const by = manager(viewer);
  if (userId === by.id) throw new Error("You cannot change your own role.");
  const target = db.select({ role: user.role }).from(user).where(eq(user.id, userId)).get();
  if (!target) throw new Error("This user no longer exists.");
  if (target.role === "admin" && role !== "admin" && admins() === 1)
    throw new Error("The last administrator stays an administrator.");
  db.update(user).set({ role }).where(eq(user.id, userId)).run();
}

/**
 * Removes a user: they can no longer sign in, their sessions end, and what they created stays
 * without an owner. Never yourself or the last administrator; a required reference to them
 * (a record they are the account manager of, say) refuses the removal until it is reassigned.
 */
export async function removeUser(viewer: Viewer | null, userId: string): Promise<void> {
  const by = manager(viewer);
  if (userId === by.id) throw new Error("You cannot remove yourself.");
  const target = db.select({ role: user.role, name: user.name }).from(user).where(eq(user.id, userId)).get();
  if (!target) return;
  if (target.role === "admin" && admins() === 1)
    throw new Error("The last administrator cannot be removed.");
  try {
    db.delete(user).where(eq(user.id, userId)).run();
  } catch (error) {
    if (error instanceof Error && error.message.includes("FOREIGN KEY constraint failed"))
      throw new Error(\`\${target.name} is still named in records. Reassign them first.\`);
    throw error;
  }
}

function admins(): number {
  return db.select({ id: user.id }).from(user).where(eq(user.role, "admin")).all().length;
}

async function sendInvitation(by: Viewer, invited: InvitationRow): Promise<void> {
  const until = invited.expiresAt.toISOString().slice(0, 10);
  await sendMail({
    to: invited.email,
    subject: \`Invitation to \${app.name}\`,
    text: \`\${by.name} invited you to \${app.name} as \${ROLE_LABELS[invited.role] ?? invited.role}.

Sign in with \${invited.email} here:
\${invited.link}

The invitation is valid until \${until}.\`,
  });
}
"
`;

exports[`../../../examples/crm/smithable.yml > file list and generated code > src/generated/users.test.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// Invitations and user management: who gets in, with which role, and what an administrator may
// not do to their own account. Against the test database, like access.test.ts.
import { eq } from "drizzle-orm";
import { expect, test } from "vitest";
import { db } from "#/db";
import { invitation, user } from "#/db/schema";
import { AccessDenied } from "#/kit/access";
import { outbox } from "#/kit/mail";
import { auth } from "#/lib/auth";
import { invite, listUsers, removeUser, setRole, withdrawInvitation } from "./users.server";

const ORIGIN = "https://team.example";
const admin = { id: "users-test-admin", name: "Users test admin", email: "users-test-admin@acme.com", role: "admin" };
db.insert(user).values(admin).run();

async function signUp(email: string) {
  const result = await auth.api.signUpEmail({
    body: { email, password: "users-test-password", name: email.split("@")[0] ?? email },
  });
  return db.select().from(user).where(eq(user.id, result.user.id)).get();
}

test("an invited address signs up with the invited role, and the invitation is used up", async () => {
  const before = outbox().length;
  const invited = await invite(admin, "Users-Test-Invited@acme.com", "sales", ORIGIN);
  expect(invited.email).toBe("users-test-invited@acme.com");
  expect(invited.link).toMatch(new RegExp(\`^\${ORIGIN}/sign-in\\\\?invite=[A-Za-z0-9_-]+$\`));
  const mail = outbox().at(-1);
  expect(outbox().length).toBe(before + 1);
  expect(mail).toMatchObject({ to: "users-test-invited@acme.com", subject: "Invitation to Acme CRM" });
  expect(mail?.text).toContain(invited.link);
  const listed = await listUsers(admin, ORIGIN);
  expect(listed.invitations.map((i) => i.email)).toContain("users-test-invited@acme.com");

  const created = await signUp("users-test-invited@acme.com");
  expect(created?.role).toBe("sales");
  expect(db.select().from(invitation).where(eq(invitation.email, "users-test-invited@acme.com")).get()).toBeUndefined();
});

test("with sign-up closed, an address nobody invited is refused", async () => {
  await expect(signUp("users-test-stranger@acme.com")).rejects.toThrow(/invited/);
  expect(db.select().from(user).where(eq(user.email, "users-test-stranger@acme.com")).get()).toBeUndefined();
});

test("only the page's roles manage users; an administrator cannot change or remove themselves", async () => {
  const outsider = await signUp("users-test-outsider@acme.com").catch(() => undefined);
  if (outsider && outsider.role !== "admin")
    await expect(listUsers(outsider, ORIGIN)).rejects.toThrow(AccessDenied);
  await expect(setRole(admin, admin.id, "sales")).rejects.toThrow(/own role/);
  await expect(removeUser(admin, admin.id)).rejects.toThrow(/yourself/);

  const colleague = db
    .insert(user)
    .values({ id: "users-test-colleague", name: "Colleague", email: "users-test-colleague@acme.com", role: "sales" })
    .returning()
    .get();
  await setRole(admin, colleague.id, "admin");
  expect(db.select({ role: user.role }).from(user).where(eq(user.id, colleague.id)).get()?.role).toBe("admin");
  await removeUser(admin, colleague.id);
  expect(db.select().from(user).where(eq(user.id, colleague.id)).get()).toBeUndefined();

  const pending = await invite(admin, "users-test-pending@acme.com", "admin", ORIGIN);
  await withdrawInvitation(admin, pending.id);
  expect((await listUsers(admin, ORIGIN)).invitations.map((i) => i.id)).not.toContain(pending.id);
});
"
`;

