          app={app}
          rows={row.notes}
          hide={["projectId"]}
          onOpen={(item) => navigate({ to: "/admin/notes/$id", params: { id: String(item.id) } })}
          emptyMessage={w.noneYet("notes")}
        />
      </section>
    </>
  );
}
"
