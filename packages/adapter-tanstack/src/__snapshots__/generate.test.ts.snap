describe("the identified action", () => {
  test("admin", async () => {
    const viewer = signedIn("admin");
    const others = insertIncident(stranger.id, {"status":"investigating"});
    const own = insertIncident(viewer.id, {"status":"investigating"});
    expect({
      others: await can(() => runIdentified(viewer, others.id)),
      own: await can(() => runIdentified(viewer, own.id)),
    }).toEqual({ others: true, own: true });
  });

  test("staff", async () => {
    const viewer = signedIn("staff");
    const others = insertIncident(stranger.id, {"status":"investigating"});
    const own = insertIncident(viewer.id, {"status":"investigating"});
    expect({
      others: await can(() => runIdentified(viewer, others.id)),
      own: await can(() => runIdentified(viewer, own.id)),
    }).toEqual({ others: true, own: true });
  });

  test("a visitor who has not signed in", async () => {
    const viewer = null;
    const others = insertIncident(stranger.id, {"status":"investigating"});
    const othersBefore = JSON.stringify(db.select().from(schema.incidents).where(eq(schema.incidents.id, others.id)).get());
    expect({
      others: await can(() => runIdentified(viewer, others.id)),
      own: false,
    }).toEqual({ others: false, own: false });
    expect(JSON.stringify(db.select().from(schema.incidents).where(eq(schema.incidents.id, others.id)).get())).toBe(othersBefore);
  });

  test("refused on a record where status is not investigating", async () => {
    const viewer = signedIn("admin");
    const record = insertIncident(viewer.id, {"status":"identified"});
    await expect(runIdentified(viewer, record.id)).rejects.toThrow("This cannot be done now.");
  });

  test("over chosen records, only those it fits and may run on change", async () => {
    const viewer = signedIn("admin");
    const fitting = insertIncident(viewer.id, {"status":"investigating"});
    const notFitting = insertIncident(viewer.id, {"status":"identified"});
    const notFittingBefore = JSON.stringify(db.select().from(schema.incidents).where(eq(schema.incidents.id, notFitting.id)).get());
    expect(await runIdentifiedMany(viewer, [fitting.id, fitting.id, notFitting.id])).toEqual({ changed: 1, skipped: 1 });
    expect(JSON.stringify(db.select().from(schema.incidents).where(eq(schema.incidents.id, notFitting.id)).get())).toBe(notFittingBefore);
    const again = insertIncident(viewer.id, {"status":"investigating"});
    const againBefore = JSON.stringify(db.select().from(schema.incidents).where(eq(schema.incidents.id, again.id)).get());
    await runIdentifiedMany(null, [again.id]).catch(() => undefined);
    expect(JSON.stringify(db.select().from(schema.incidents).where(eq(schema.incidents.id, again.id)).get())).toBe(againBefore);
  });
});

