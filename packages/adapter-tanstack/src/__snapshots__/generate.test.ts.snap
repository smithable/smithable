/**
 * What each caller is offered (by the key's role, and for a visitor without a key): the tools,
 * the summary, and what describe answers per kind, as that caller may use it.
 */
const OFFERS: Record<string, Offer & { describe: Record<string, string> }> = {
  "admin": {
    "summary": "Northwind Status: Is it working? The state of our services, live.\\nComponent (components): name*, status* (operational | degraded | down | maintenance), description. Title: name.\\nIncident (incidents): title*, status* (investigating | identified | monitoring | resolved), component -> Component, detectedAt* (datetime), resolvedAt (datetime), summary. Title: title.\\nIncidentUpdate (incident updates): incident* -> Incident, at* (datetime), status* (investigating | identified | monitoring | resolved), message*. Title: message.\\nMaintenance (maintenances): title*, component -> Component, startsAt* (datetime), endsAt* (datetime), description. Title: title.\\n* required. You act as someone with the role admin.\\nAnswer with what a tool returned; a number, a name or \\"none\\" you did not get from a tool is not an answer.",
    "tools": [
      {
        "name": "find",
        "description": "Records of one kind the caller may read, newest first, as {columns, rows, total}. Ask only for the fields needed; id and title always come.",
        "inputSchema": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "Component",
                "Incident",
                "IncidentUpdate",
                "Maintenance"
              ]
            },
            "where": {
              "type": "object",
              "description": "Field values to match, e.g. {\\"status\\":\\"open\\"}; a list means any of them; a number or date takes {\\"from\\":…,\\"to\\":…}; a reference takes an id or the record's title (\\"me\\" for a user); {\\"mine\\":true} is the caller's own records."
            },
            "search": {
              "type": "string",
              "description": "Words to look for in the records' texts."
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "sort": {
              "type": "string",
              "description": "A field; \\"-field\\" for the largest first."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 10
            },
            "page": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "annotations": {
          "readOnlyHint": true,
          "destructiveHint": false
        }
      },
