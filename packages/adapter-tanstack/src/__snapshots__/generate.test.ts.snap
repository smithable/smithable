function ProjectPage() {
  const { row, canWrite, canDelete } = Route.useLoaderData();
  const navigate = useNavigate();
  const back = () => navigate({ to: "/admin/projects" });
  return (
    <>
      <PageHeader title={row.name || \`Project #\${row.id}\`} />
