"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createInsertSchema } from "drizzle-zod";
import { z } from "zod";
import * as schema from "#/db/schema";
import { w } from "#/kit/words";

/** What a dish may be given: a form's values and what the app fills (an action's set). */
export const dishSettable = createInsertSchema(schema.dishes, {
  name: (s) => s.trim().min(1, w.required).max(200, w.atMostCharacters(200)),
  description: (s) => s.max(10000, w.atMostCharacters(10000)),
  picture: z.object({ file: z.string().regex(/^dish\\/[a-f0-9]{24}\\.webp$/), alt: z.string().trim().max(200), width: z.int().positive(), height: z.int().positive(), generated: z.literal(true).optional(), receipt: z.string().max(64).optional() }).nullish(),
  allergens: (s) => s.max(200, w.atMostCharacters(200)),
}).omit({ id: true, ownerId: true, createdAt: true, updatedAt: true });
/** What a dish's form sends, checked. */
export const dishSchema = dishSettable;

export type DishSettable = z.output<typeof dishSettable>;
export type DishValues = z.output<typeof dishSchema>;
"
