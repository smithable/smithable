exports[`../../../examples/booking/smithable.yml > file list and generated code > src/routes/admin/index.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, Link } from "@tanstack/react-router";
import { createServerFn } from "@tanstack/react-start";
import { pageAccess, pageUi, pageHead } from "#/generated/pages";
import { classTypeData } from "#/generated/class-type.server";
import { classTypeUi } from "#/generated/class-type";
import { instructorData } from "#/generated/instructor.server";
import { instructorUi } from "#/generated/instructor";
import { sessionData } from "#/generated/session.server";
import { sessionUi } from "#/generated/session";
import { bookingData } from "#/generated/booking.server";
import { bookingUi } from "#/generated/booking";
import { postData } from "#/generated/post.server";
import { postUi } from "#/generated/post";
import { messageData } from "#/generated/message.server";
import { messageUi } from "#/generated/message";
import { guardPage } from "#/kit/access";
import { PageHeader } from "#/kit/AppShell";
import { w } from "#/kit/words";
import { currentViewer } from "#/lib/viewer.server";

/**
 * How many records of each model the viewer may read (null where they may read none), and,
 * when a hosting service runs the app, its page for restoring data to an earlier time.
 */
const getCounts = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return {
    counts: {
      "class-types": classTypeData.count(viewer),
      "instructors": instructorData.count(viewer),
      "sessions": sessionData.count(viewer),
      "bookings": bookingData.count(viewer),
      "posts": postData.count(viewer),
      "messages": messageData.count(viewer),
    },
    restore: process.env.HOST_PAGE_URL ? \`\${process.env.HOST_PAGE_URL}/data\` : undefined,
  };
});

const MODELS = [
  { key: "class-types", label: classTypeUi.pluralLabel, to: "/admin/class-types" },
  {
    key: "instructors",
    label: instructorUi.pluralLabel,
    to: "/admin/instructors",
  },
  { key: "sessions", label: sessionUi.pluralLabel, to: "/admin/sessions" },
  { key: "bookings", label: bookingUi.pluralLabel, to: "/admin/bookings" },
  { key: "posts", label: postUi.pluralLabel, to: "/admin/posts" },
  { key: "messages", label: messageUi.pluralLabel, to: "/admin/messages" },
] as const;

export const Route = createFileRoute("/admin/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["admin"], context.viewer, location.href),
  head: () => pageHead("admin"),
  loader: () => getCounts(),
  component: AdminPage,
});

function AdminPage() {
  const { counts, restore } = Route.useLoaderData();
  return (
    <>
      <PageHeader
        page="admin"
        title={pageUi["admin"].title}
        actions={
          <>
            <Link to="/admin/activity" className="text-sm font-medium text-primary">{w.activity}</Link>
            {restore && <a href={restore} className="text-sm font-medium text-primary">{w.restoreData}</a>}
          </>
        }
      />
      <ul className="divide-y divide-border rounded-lg border border-border bg-card">
        {MODELS.filter((m) => counts[m.key] !== null).map((m) => (
          <li key={m.key}>
            <Link to={m.to} className="flex items-center justify-between gap-4 px-4 py-3 hover:bg-muted">
              <span className="font-medium">{m.label}</span>
              <span className="text-muted-foreground tabular-nums">{counts[m.key]}</span>
            </Link>
          </li>
        ))}
      </ul>
    </>
  );
}
"
`;

exports[`../../../examples/booking/smithable.yml > file list and generated code > src/routes/admin/instructors/$id.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, notFound, useNavigate } from "@tanstack/react-router";
import { app } from "#/generated/app";
import { pageAccess, pageHead } from "#/generated/pages";
import { deleteInstructor, getInstructor, instructorUi, updateInstructor } from "#/generated/instructor";
import { instructorSchema } from "#/generated/instructor.schema";
import { sessionUi } from "#/generated/session";
import { guardPage } from "#/kit/access";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";
import { w } from "#/kit/words";
import { ModelTable } from "#/kit/ModelTable";

export const Route = createFileRoute("/admin/instructors/$id")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["admin"], context.viewer, location.href),
  head: () => pageHead("admin"),
  loader: async ({ params }) => {
    const found = await getInstructor({ data: Number(params.id) });
    if (!found) throw notFound();
    return { ...found };
  },
  component: InstructorPage,
});

function InstructorPage() {
  const { row, canWrite, canDelete } = Route.useLoaderData();
  const navigate = useNavigate();
  const back = () => navigate({ to: "/admin/instructors" });
  return (
    <>
      <PageHeader title={row.name || \`Instructor #\${row.id}\`} />
      <ModelForm
        key={String(row.updatedAt)}
        ui={instructorUi}
        app={app}
        schema={instructorSchema}
        initial={row}
        readOnly={!canWrite}
        submitLabel={w.saveChanges}
        onSubmit={async (values) => {
          await updateInstructor({ data: { id: row.id, values } });
          await back();
        }}
        onCancel={back}
        onDelete={
          canDelete
            ? async (together?: boolean) => {
                await deleteInstructor({ data: { id: row.id, together } });
                await back();
              }
            : undefined
        }
      />
      <section className="mt-10">
        <div className="mb-3 flex items-center justify-between gap-3">
          <h2 className="text-lg font-semibold">Sessions</h2>
          
        </div>
        <ModelTable
          ui={sessionUi}
          app={app}
          rows={row.sessions}
          hide={["instructorId"]}
          onOpen={(item) => navigate({ to: "/admin/sessions/$id", params: { id: String(item.id) } })}
          emptyMessage={w.noneYet("sessions")}
        />
      </section>
    </>
  );
}
"
`;

exports[`../../../examples/booking/smithable.yml > file list and generated code > src/routes/admin/instructors/index.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, Link, useNavigate } from "@tanstack/react-router";
import { pageAccess, pageHead } from "#/generated/pages";
import { guardPage, allows } from "#/kit/access";
import { createServerFn } from "@tanstack/react-start";
import * as schema from "#/db/schema";
import { instructorAccess, instructorData } from "#/generated/instructor.server";
import { contains } from "#/kit/search";
import { currentViewer } from "#/lib/viewer.server";
import { type Search, listQuery, optional, text } from "#/kit/params";
import { buttonVariants } from "#/components/ui/button";
import { app } from "#/generated/app";
import { instructorUi } from "#/generated/instructor";
import { w } from "#/kit/words";
import { PageHeader } from "#/kit/AppShell";
import { ModelTable } from "#/kit/ModelTable";
import { SearchBox } from "#/kit/SearchBox";
import { Users } from "lucide-react";

/** The instructors matching the search, among those the viewer may read. */
const searchInstructors = createServerFn()
  .validator(listQuery)
  .handler(async ({ data }) => {
    const viewer = await currentViewer();
    const where = data.q ? contains([schema.instructors.name, schema.instructors.bio], data.q) : undefined;
    const rows = await instructorData.list(viewer, where, 501);
    return {
      rows: rows.slice(0, 500),
      more: rows.length > 500,
      canCreate: allows(instructorAccess.create, viewer),
    };
  });

export const Route = createFileRoute("/admin/instructors/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["admin"], context.viewer, location.href),
  head: () => pageHead("admin"),
  validateSearch: (s: Search) => optional({ q: text(s.q) }),
  loaderDeps: ({ search }) => ({ q: search.q }),
  loader: ({ deps }) => searchInstructors({ data: { q: deps.q } }),  component: AdminInstructorsPage,
});

function AdminInstructorsPage() {
  const { rows, canCreate, more } = Route.useLoaderData();
  const { q } = Route.useSearch();
  const navigate = useNavigate();
  const newButton = canCreate && (
    <Link to="/admin/instructors/new" className={buttonVariants()}>
      {w.newOne("instructor")}
    </Link>
  );
  return (
    <>
      <PageHeader
        title={instructorUi.pluralLabel}
        actions={newButton}
      />
      <SearchBox
        value={q ?? ""}
        placeholder="Search by name or bio"
        onSearch={(text) => navigate({ to: "/admin/instructors", search: { q: text || undefined }, replace: true, resetScroll: false })}
      />
      {more && (
        <p className="text-sm text-muted-foreground">The newest 500 are shown; search to find the others.</p>
      )}
      <ModelTable
        ui={instructorUi}
        app={app}
        rows={rows}
        icon={Users}
        emptyMessage={q ? \`No instructors match “\${q}”.\` : undefined}
        emptyAction={newButton || undefined}
        onOpen={(row) => navigate({ to: "/admin/instructors/$id", params: { id: String(row.id) } })}
      />
    </>
  );
}
"
`;

