describe("the markSent action", () => {
  test("admin", async () => {
    const viewer = signedIn("admin");
    const others = insertInvoice(stranger.id, {"status":"draft"});
    const own = insertInvoice(viewer.id, {"status":"draft"});
    expect({
      others: await can(() => runMarkSent(viewer, others.id)),
      own: await can(() => runMarkSent(viewer, own.id)),
    }).toEqual({ others: true, own: true });
  });

  test("member", async () => {
    const viewer = signedIn("member");
    const others = insertInvoice(stranger.id, {"status":"draft"});
    const othersBefore = JSON.stringify(db.select().from(schema.invoices).where(eq(schema.invoices.id, others.id)).get());
    const own = insertInvoice(viewer.id, {"status":"draft"});
    expect({
      others: await can(() => runMarkSent(viewer, others.id)),
      own: await can(() => runMarkSent(viewer, own.id)),
    }).toEqual({ others: false, own: true });
    expect(JSON.stringify(db.select().from(schema.invoices).where(eq(schema.invoices.id, others.id)).get())).toBe(othersBefore);
  });

  test("a visitor who has not signed in", async () => {
    const viewer = null;
    const others = insertInvoice(stranger.id, {"status":"draft"});
    const othersBefore = JSON.stringify(db.select().from(schema.invoices).where(eq(schema.invoices.id, others.id)).get());
    expect({
      others: await can(() => runMarkSent(viewer, others.id)),
      own: false,
    }).toEqual({ others: false, own: false });
    expect(JSON.stringify(db.select().from(schema.invoices).where(eq(schema.invoices.id, others.id)).get())).toBe(othersBefore);
  });

  test("refused on a record where status is not draft", async () => {
    const viewer = signedIn("admin");
    const record = insertInvoice(viewer.id, {"status":"sent"});
    await expect(runMarkSent(viewer, record.id)).rejects.toThrow("This cannot be done now.");
  });

  test("over chosen records, only those it fits and may run on change", async () => {
    const viewer = signedIn("admin");
    const fitting = insertInvoice(viewer.id, {"status":"draft"});
    const notFitting = insertInvoice(viewer.id, {"status":"sent"});
    const notFittingBefore = JSON.stringify(db.select().from(schema.invoices).where(eq(schema.invoices.id, notFitting.id)).get());
    expect(await runMarkSentMany(viewer, [fitting.id, fitting.id, notFitting.id])).toEqual({ changed: 1, skipped: 1 });
    expect(JSON.stringify(db.select().from(schema.invoices).where(eq(schema.invoices.id, notFitting.id)).get())).toBe(notFittingBefore);
    const again = insertInvoice(viewer.id, {"status":"draft"});
    const againBefore = JSON.stringify(db.select().from(schema.invoices).where(eq(schema.invoices.id, again.id)).get());
    await runMarkSentMany(null, [again.id]).catch(() => undefined);
    expect(JSON.stringify(db.select().from(schema.invoices).where(eq(schema.invoices.id, again.id)).get())).toBe(againBefore);
  });
});

describe("the markPaid action", () => {
  test("admin", async () => {
    const viewer = signedIn("admin");
    const others = insertInvoice(stranger.id, {"status":"sent"});
    const own = insertInvoice(viewer.id, {"status":"sent"});
    expect({
      others: await can(() => runMarkPaid(viewer, others.id)),
      own: await can(() => runMarkPaid(viewer, own.id)),
    }).toEqual({ others: true, own: true });
  });

  test("member", async () => {
    const viewer = signedIn("member");
    const others = insertInvoice(stranger.id, {"status":"sent"});
    const othersBefore = JSON.stringify(db.select().from(schema.invoices).where(eq(schema.invoices.id, others.id)).get());
    const own = insertInvoice(viewer.id, {"status":"sent"});
    expect({
      others: await can(() => runMarkPaid(viewer, others.id)),
      own: await can(() => runMarkPaid(viewer, own.id)),
    }).toEqual({ others: false, own: true });
    expect(JSON.stringify(db.select().from(schema.invoices).where(eq(schema.invoices.id, others.id)).get())).toBe(othersBefore);
  });

  test("a visitor who has not signed in", async () => {
    const viewer = null;
    const others = insertInvoice(stranger.id, {"status":"sent"});
    const othersBefore = JSON.stringify(db.select().from(schema.invoices).where(eq(schema.invoices.id, others.id)).get());
    expect({
      others: await can(() => runMarkPaid(viewer, others.id)),
      own: false,
    }).toEqual({ others: false, own: false });
    expect(JSON.stringify(db.select().from(schema.invoices).where(eq(schema.invoices.id, others.id)).get())).toBe(othersBefore);
  });

  test("refused on a record where status is not sent or overdue", async () => {
    const viewer = signedIn("admin");
    const record = insertInvoice(viewer.id, {"status":"draft"});
    await expect(runMarkPaid(viewer, record.id)).rejects.toThrow("This cannot be done now.");
  });

  test("over chosen records, only those it fits and may run on change", async () => {
    const viewer = signedIn("admin");
    const fitting = insertInvoice(viewer.id, {"status":"sent"});
    const notFitting = insertInvoice(viewer.id, {"status":"draft"});
    const notFittingBefore = JSON.stringify(db.select().from(schema.invoices).where(eq(schema.invoices.id, notFitting.id)).get());
    expect(await runMarkPaidMany(viewer, [fitting.id, fitting.id, notFitting.id])).toEqual({ changed: 1, skipped: 1 });
    expect(JSON.stringify(db.select().from(schema.invoices).where(eq(schema.invoices.id, notFitting.id)).get())).toBe(notFittingBefore);
    const again = insertInvoice(viewer.id, {"status":"sent"});
    const againBefore = JSON.stringify(db.select().from(schema.invoices).where(eq(schema.invoices.id, again.id)).get());
    await runMarkPaidMany(null, [again.id]).catch(() => undefined);
    expect(JSON.stringify(db.select().from(schema.invoices).where(eq(schema.invoices.id, again.id)).get())).toBe(againBefore);
  });
});

describe("the markOverdue action", () => {
  test("admin", async () => {
    const viewer = signedIn("admin");
    const others = insertInvoice(stranger.id, {"status":"sent"});
    const own = insertInvoice(viewer.id, {"status":"sent"});
    expect({
      others: await can(() => runMarkOverdue(viewer, others.id)),
      own: await can(() => runMarkOverdue(viewer, own.id)),
    }).toEqual({ others: true, own: true });
  });

  test("member", async () => {
    const viewer = signedIn("member");
    const others = insertInvoice(stranger.id, {"status":"sent"});
    const othersBefore = JSON.stringify(db.select().from(schema.invoices).where(eq(schema.invoices.id, others.id)).get());
    const own = insertInvoice(viewer.id, {"status":"sent"});
    expect({
      others: await can(() => runMarkOverdue(viewer, others.id)),
      own: await can(() => runMarkOverdue(viewer, own.id)),
    }).toEqual({ others: false, own: true });
    expect(JSON.stringify(db.select().from(schema.invoices).where(eq(schema.invoices.id, others.id)).get())).toBe(othersBefore);
  });

  test("a visitor who has not signed in", async () => {
    const viewer = null;
    const others = insertInvoice(stranger.id, {"status":"sent"});
    const othersBefore = JSON.stringify(db.select().from(schema.invoices).where(eq(schema.invoices.id, others.id)).get());
    expect({
      others: await can(() => runMarkOverdue(viewer, others.id)),
      own: false,
    }).toEqual({ others: false, own: false });
    expect(JSON.stringify(db.select().from(schema.invoices).where(eq(schema.invoices.id, others.id)).get())).toBe(othersBefore);
  });

  test("refused on a record where status is not sent", async () => {
    const viewer = signedIn("admin");
    const record = insertInvoice(viewer.id, {"status":"draft"});
    await expect(runMarkOverdue(viewer, record.id)).rejects.toThrow("This cannot be done now.");
  });

  test("over chosen records, only those it fits and may run on change", async () => {
    const viewer = signedIn("admin");
    const fitting = insertInvoice(viewer.id, {"status":"sent"});
    const notFitting = insertInvoice(viewer.id, {"status":"draft"});
    const notFittingBefore = JSON.stringify(db.select().from(schema.invoices).where(eq(schema.invoices.id, notFitting.id)).get());
    expect(await runMarkOverdueMany(viewer, [fitting.id, fitting.id, notFitting.id])).toEqual({ changed: 1, skipped: 1 });
    expect(JSON.stringify(db.select().from(schema.invoices).where(eq(schema.invoices.id, notFitting.id)).get())).toBe(notFittingBefore);
    const again = insertInvoice(viewer.id, {"status":"sent"});
    const againBefore = JSON.stringify(db.select().from(schema.invoices).where(eq(schema.invoices.id, again.id)).get());
    await runMarkOverdueMany(null, [again.id]).catch(() => undefined);
    expect(JSON.stringify(db.select().from(schema.invoices).where(eq(schema.invoices.id, again.id)).get())).toBe(againBefore);
  });
});

describe("the audit log", () => {
  test("names who created, changed and deleted a record, and what changed", async () => {
    const viewer = signedIn("admin");
    const made = await businessProfileData.create(viewer, businessProfileValues(viewer.id));
    await businessProfileData.update(viewer, made.id, businessProfileValues(viewer.id));
    await businessProfileData.remove(viewer, made.id);
    const lines = db
      .select()
      .from(auditLog)
      .where(and(eq(auditLog.model, "BusinessProfile"), eq(auditLog.recordId, made.id)))
      .all();
    expect(lines.map((l) => [l.action, l.who, l.role])).toEqual([
      ["created", viewer.id, viewer.role],
      ["changed", viewer.id, viewer.role],
      ["deleted", viewer.id, viewer.role],
    ]);
    // Only the line that deleted it keeps the record's name (its title by then); no field's
    // value is stored.
    expect(lines.map((l) => Boolean(l.title))).toEqual([false, false, true]);
    expect(JSON.stringify(lines[1]?.fields ?? [])).not.toContain(":");

    // Forget in the log: administrators only; it blanks the deleted record's name and is logged by id.
    expect(() => forgetInLog(signedIn("member"), { model: "BusinessProfile", record: made.id })).toThrow(AccessDenied);
    forgetInLog(signedIn("admin"), { model: "BusinessProfile", record: made.id });
    const after = db.select().from(auditLog).where(and(eq(auditLog.model, "BusinessProfile"), eq(auditLog.recordId, made.id))).all();
    expect(after.map((l) => l.title)).toEqual([null, null, null]);
    const forgot = db.select().from(auditLog).where(eq(auditLog.action, "forgotten in the log")).all().at(-1);
    expect(forgot).toMatchObject({ title: null, details: { model: "BusinessProfile", record: made.id } });
  });

  test("keeps the client's details and a deleted record's name 90 days, and a line 12 months", () => {
    const day = 24 * 60 * 60 * 1000;
    const line = (daysAgo: number) =>
      db
        .insert(auditLog)
        .values({ at: new Date(Date.now() - daysAgo * day), who: "test", action: "deleted", title: "Old", address: "10.0.0.1", browser: "test" })
        .returning()
        .get();
    const recent = line(10);
    const older = line(100);
    const oldest = line(400);
    pruneAudit();
    const row = (id: number) => db.select().from(auditLog).where(eq(auditLog.id, id)).get();
    expect(row(recent.id)).toMatchObject({ title: "Old", address: "10.0.0.1" });
    expect(row(older.id)).toMatchObject({ title: null, address: null, browser: null, action: "deleted" });
    expect(row(oldest.id)).toBeUndefined();
  });
});
"
`;

