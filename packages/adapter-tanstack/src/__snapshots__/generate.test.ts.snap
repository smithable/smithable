"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, Link, useNavigate, useRouter } from "@tanstack/react-router";
import { pageAccess } from "#/generated/pages";
import { guardPage, allows } from "#/kit/access";
import { createServerFn } from "@tanstack/react-start";
import { clientAccess, clientData } from "#/generated/client.server";
import { currentViewer } from "#/lib/viewer.server";
import { type Search, count, listQuery, optional } from "#/kit/params";
import { buttonVariants } from "#/components/ui/button";
import { useState } from "react";
import { SelectionBar } from "#/kit/SelectionBar";
import { csvName, csvOf, download } from "#/kit/csv";
import { deleteClients, clientDeleteRule, clientUi } from "#/generated/client";
import { app } from "#/generated/app";
import { w } from "#/kit/words";
import { PageHeader } from "#/kit/AppShell";
import { ModelTable } from "#/kit/ModelTable";

/** A page of the clients the viewer may read. */
const listClients = createServerFn()
  .validator(listQuery)
  .handler(async ({ data }) => {
    const viewer = await currentViewer();
    return { ...(await clientData.page(viewer, undefined, undefined, data.all ? 1 : data.page, data.all ? (viewer ? 10000 : 500) : undefined)), canCreate: allows(clientAccess.create, viewer) };
  });

export const Route = createFileRoute("/clients/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["clients"], context.viewer, location.href),
  head: () => ({ meta: [{"title":"Clients · Invoicely"}] }),
  validateSearch: (s: Search) => optional({ page: count(s.page) }),
  loaderDeps: ({ search }) => ({ page: search.page }),
  loader: ({ deps }) => listClients({ data: { page: deps.page } }),
  component: ClientsPage,
});

function ClientsPage() {
  const { rows, canCreate, total, page: at, size } = Route.useLoaderData();
  const { viewer } = Route.useRouteContext();
  const navigate = useNavigate({ from: "/clients/" });
  const router = useRouter();
  // The chosen rows, offered when the viewer may do something to at least one row.
  const [selected, setSelected] = useState<Set<number>>(new Set());
  const chosen = rows.filter((row) => selected.has(row.id));
  const selectable = rows.some((row) => allows(clientDeleteRule, viewer, row.ownerId));
  const newButton = canCreate && (
    <Link to="/clients/new" className={buttonVariants()}>
      {w.newOne("client")}
    </Link>
  );
  return (
    <>
      <PageHeader
        page="clients"
        title="Clients"
        actions={newButton}
      />
      {selectable && (
        <SelectionBar
          count={chosen.length}
          noun={["client", "clients"]}
          app={app}
          titleOf={(id) => String(rows.find((row) => row.id === id)?.name ?? id)}
          actions={[]}
          deletable={chosen.filter((row) => allows(clientDeleteRule, viewer, row.ownerId)).length}
          onDelete={(together) => deleteClients({ data: { ids: chosen.map((row) => row.id), together } })}
          onDone={async () => {
            setSelected(new Set());
            await router.invalidate();
          }}
          onExport={() => download(csvName(clientUi), csvOf(clientUi, chosen))}
        />
      )}
      <ModelTable
        ui={clientUi}
        page="clients"
        paging={{ page: at, size, total, to: (next) => navigate({ to: "/clients", search: (prev) => ({ ...prev, page: next > 1 ? next : undefined }) }) }}
        app={app}
        exportRows={async () => (await listClients({ data: { all: true } })).rows}
        rows={rows}
        selection={selectable ? { ids: selected, onChange: setSelected } : undefined}
        emptyAction={newButton || undefined}
        onOpen={(row) => navigate({ to: "/clients/$id", params: { id: String(row.id) } })}
      />
    </>
  );
}
"
`;

