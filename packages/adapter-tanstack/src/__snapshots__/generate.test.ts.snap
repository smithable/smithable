exports[`../../../examples/crm/smithable.yml > file list and generated code > src/routes/sign-in.tsx 1`] = `
"// Generated by Smithable from smithable.auth.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, useRouter } from "@tanstack/react-router";
import { createServerFn } from "@tanstack/react-start";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { eq } from "drizzle-orm";
import { z } from "zod";
import { db } from "#/db";
import { invitation, user } from "#/db/schema";
import { app } from "#/generated/app";
import { SignIn } from "#/kit/SignIn";
import { auth, configuredProviders, PROVIDERS } from "#/lib/auth";
import { authClient } from "#/lib/auth-client";

const ROLES = ["admin","sales"] as const;
const ROLE_LABELS: Record<string, string> = { admin: "Admin", sales: "Sales" };

/** The sign-in choices, and whom an invitation link is for (by its token; never signs anyone in). */
const signInOptions = createServerFn()
  .validator(z.object({ invite: z.string().max(100).optional() }))
  .handler(({ data }) => {
    const providers = configuredProviders();
    const invited = data.invite
      ? db
          .select({ email: invitation.email, role: invitation.role, expiresAt: invitation.expiresAt })
          .from(invitation)
          .where(eq(invitation.token, data.invite))
          .get()
      : undefined;
    const open = invited && invited.expiresAt.getTime() > Date.now() ? invited : undefined;
    return {
      providers,
      missing: PROVIDERS.filter((p) => !providers.includes(p)),
      invitation: open ? { email: open.email, role: ROLE_LABELS[open.role] ?? open.role } : null,
    };
  });

/** Development only: signs in as a user with the role, without a provider. */
const devSignIn = createServerFn({ method: "POST" })
  .validator(z.enum(ROLES))
  .handler(async ({ data: role }) => {
    if (!import.meta.env.DEV) throw new Error("Only available in development.");
    const email = \`dev-\${role}@acme.com\`;
    const password = "dev-password";
    if (!db.select({ id: user.id }).from(user).where(eq(user.email, email)).get()) {
      await auth.api.signUpEmail({ body: { email, password, name: \`Dev \${role}\` } });
    }
    db.update(user).set({ role }).where(eq(user.email, email)).run();
    await auth.api.signInEmail({ body: { email, password }, headers: getRequestHeaders() });
  });

export const Route = createFileRoute("/sign-in")({
  // Only paths within the app, so the page cannot send anyone elsewhere.
  validateSearch: z.object({
    redirect: z.string().regex(/^\\/(?!\\/)/).optional().catch(undefined),
    invite: z.string().max(100).optional().catch(undefined),
  }),
  loaderDeps: ({ search }) => ({ invite: search.invite }),
  loader: ({ deps }) => signInOptions({ data: { invite: deps.invite } }),
  component: SignInPage,
});

function SignInPage() {
  const { providers, missing, invitation } = Route.useLoaderData();
  const { redirect = "/" } = Route.useSearch();
  const router = useRouter();
  return (
    <SignIn
      appName={app.name}
      providers={providers}
      missing={missing}
      invitation={invitation}
      devRoles={import.meta.env.DEV ? [...ROLES] : undefined}
      onProvider={async (provider) => {
        const { error } = await authClient.signIn.social({ provider, callbackURL: redirect });
        if (error) throw new Error(error.message);
      }}
      onDevRole={async (role) => {
        await devSignIn({ data: role as (typeof ROLES)[number] });
        await router.invalidate();
        await router.navigate({ href: redirect });
      }}
    />
  );
}
"
`;

exports[`../../../examples/crm/smithable.yml > file list and generated code > src/routes/team/index.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, useRouter } from "@tanstack/react-router";
import { createServerFn } from "@tanstack/react-start";
import { z } from "zod";
import { pageAccess } from "#/generated/pages";
import {
  invite,
  listUsers,
  origin,
  removeUser,
  resendInvitation,
  type Role,
  ROLES,
  setRole,
  withdrawInvitation,
} from "#/generated/users.server";
import { guardPage } from "#/kit/access";
import { PageHeader } from "#/kit/AppShell";
import { Users } from "#/kit/Users";
import { currentViewer } from "#/lib/viewer.server";

const ROLE_OPTIONS = [
  {
    value: "admin",
    label: "Admin",
    description: "Sales management. Full access.",
  },
  {
    value: "sales",
    label: "Sales",
    description: "Works with customers and orders.",
  },
];

const getUsers = createServerFn().handler(async () => listUsers(await currentViewer(), origin()));

const inviteUser = createServerFn({ method: "POST" })
  .validator(z.object({ email: z.email().max(200), role: z.enum(ROLES) }))
  .handler(async ({ data }) => {
    await invite(await currentViewer(), data.email, data.role, origin());
  });

const changeRole = createServerFn({ method: "POST" })
  .validator(z.object({ userId: z.string().max(100), role: z.enum(ROLES) }))
  .handler(async ({ data }) => {
    await setRole(await currentViewer(), data.userId, data.role);
  });

const remove = createServerFn({ method: "POST" })
  .validator(z.object({ userId: z.string().max(100) }))
  .handler(async ({ data }) => {
    await removeUser(await currentViewer(), data.userId);
  });

const resend = createServerFn({ method: "POST" })
  .validator(z.object({ invitationId: z.string().max(100) }))
  .handler(async ({ data }) => {
    await resendInvitation(await currentViewer(), data.invitationId, origin());
  });

const withdraw = createServerFn({ method: "POST" })
  .validator(z.object({ invitationId: z.string().max(100) }))
  .handler(async ({ data }) => {
    await withdrawInvitation(await currentViewer(), data.invitationId);
  });

export const Route = createFileRoute("/team/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["team"], context.viewer, location.href),
  loader: () => getUsers(),
  component: TeamPage,
});

function TeamPage() {
  const { users, invitations } = Route.useLoaderData();
  const { viewer } = Route.useRouteContext();
  const router = useRouter();
  const then = async (change: Promise<unknown>) => {
    await change;
    await router.invalidate();
  };
  return (
    <>
      <PageHeader page="team" title="Team" />
      <Users
        viewerId={viewer?.id}
        roles={ROLE_OPTIONS}
        users={users}
        invitations={invitations}
        onInvite={(email, role) => then(inviteUser({ data: { email, role: role as Role } }))}
        onSetRole={(userId, role) => then(changeRole({ data: { userId, role: role as Role } }))}
        onRemove={(userId) => then(remove({ data: { userId } }))}
        onResend={(invitationId) => then(resend({ data: { invitationId } }))}
        onWithdraw={(invitationId) => then(withdraw({ data: { invitationId } }))}
      />
    </>
  );
}
"
`;

