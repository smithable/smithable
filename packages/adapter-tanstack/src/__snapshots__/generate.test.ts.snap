"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { and, asc, count, eq, sql, type SQL } from "drizzle-orm";
import { db } from "#/db";
import { instructors } from "#/db/schema";
import { AccessDenied, check, type ModelAccess, readScope, refusal, type Viewer } from "#/kit/access";
import { contains } from "#/kit/search";
import { afterChange, afterDelete } from "./hooks";
import type { InstructorValues } from "./instructor";

/** Who may read, create, change and delete instructors. */
export const instructorAccess: ModelAccess = {
  read: { public: true, roles: ["admin"], owner: true },
  create: { public: false, roles: ["admin"], owner: false },
  write: { public: false, roles: ["admin"], owner: true },
  delete: { public: false, roles: ["admin"], owner: true },
};

export const instructorData = {
  /** A condition for the instructors the viewer may read. */
  readable(viewer: Viewer | null) {
    const scope = readScope(instructorAccess.read, viewer);
    if (scope === "all") return undefined;
    return scope === "own" && viewer ? eq(instructors.ownerId, viewer.id) : sql\`false\`;
  },

  canRead(viewer: Viewer | null, id: number): boolean {
    const found = db
      .select({ id: instructors.id })
      .from(instructors)
      .where(and(eq(instructors.id, id), instructorData.readable(viewer)))
      .get();
    return found !== undefined;
  },

  /** The instructors the viewer may read; \`where\` narrows them, e.g. to a search; \`limit\` keeps the newest (a data page). */
  async list(viewer: Viewer | null, where?: SQL, limit?: number) {
    if (readScope(instructorAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const rows = await db.query.instructors.findMany({
      where: and(instructorData.readable(viewer), where),
      orderBy: (t, { desc }) => [desc(t.id)],
      limit,
    });
    return rows;
  },

  /** How many instructors the viewer may read, for a data page's overview; none to read: null. */
  count(viewer: Viewer | null): number | null {
    if (readScope(instructorAccess.read, viewer) === "none") return null;
    return db.select({ n: count() }).from(instructors).where(instructorData.readable(viewer)).get()?.n ?? 0;
  },

  async get(viewer: Viewer | null, id: number) {
    const row = await db.query.instructors.findFirst({
      where: and(eq(instructors.id, id), instructorData.readable(viewer)),
    });
    return row ? row : null;
  },

  async create(viewer: Viewer | null, values: InstructorValues) {
    check(instructorAccess.create, viewer);
    let row: typeof instructors.$inferSelect;
    try {
      row = db.insert(instructors).values({ ...values, ownerId: viewer?.id ?? null }).returning().get();
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterCreate", "Instructor", row, viewer);
    return row;
  },

  async update(viewer: Viewer | null, id: number, values: InstructorValues) {
    const row = db
      .select({ ownerId: instructors.ownerId })
      .from(instructors)
      .where(and(eq(instructors.id, id), instructorData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(instructorAccess.write, viewer, row.ownerId);
    let changed: typeof instructors.$inferSelect;
    const updated = values;
    try {
      changed = db.update(instructors).set(updated).where(eq(instructors.id, id)).returning().get();
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterUpdate", "Instructor", changed, viewer);
    return changed;
  },

  async remove(viewer: Viewer | null, id: number): Promise<void> {
    const row = db
      .select({ ownerId: instructors.ownerId })
      .from(instructors)
      .where(and(eq(instructors.id, id), instructorData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(instructorAccess.delete, viewer, row.ownerId);
    try {
      db.delete(instructors).where(eq(instructors.id, id)).run();
    } catch (error) {
      throw refusal(error);
    }
    await afterDelete("Instructor", id, viewer);
  },

  /**
   * The instructors the viewer may read whose name contains the text: a search of records that
   * refer to them finds them only among these.
   */
  titled(viewer: Viewer | null, text: string): number[] {
    return db
      .select({ id: instructors.id })
      .from(instructors)
      .where(and(contains([instructors.name], text), instructorData.readable(viewer)))
      .all()
      .map((row) => row.id);
  },

  /** Choices for fields that refer to a instructor: the ones the viewer may read. */
  options(viewer: Viewer | null) {
    if (readScope(instructorAccess.read, viewer) === "none") return [];
    return db
      .select({ value: instructors.id, label: instructors.name })
      .from(instructors)
      .where(instructorData.readable(viewer))
      .orderBy(asc(instructors.name))
      .all();
  },
};
"
`;

