"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// The API's conversions (docs/design/integrations.md §2): records as programs read them (the
// spec's field names, amounts as decimal texts, times as ISO texts) and their values back, checked
// by each model's own schema, as a form's are.
import { BadInput } from "#/kit/api.server";
import { projectSchema } from "#/generated/project.schema";
import { taskSchema } from "#/generated/task.schema";
import { noteSchema } from "#/generated/note.schema";

const whole = (v: unknown, field: string) => {
  if (Number.isInteger(v)) return v as number;
  throw new BadInput(\`"\${field}" must be a record's id, a whole number.\`);
};

/** The body as an object of known fields, or a refusal naming the first unknown one. */
function fieldsOf(body: unknown, known: readonly string[]): Record<string, unknown> {
  if (!body || typeof body !== "object" || Array.isArray(body)) throw new BadInput("The body must be a JSON object.");
  const unknown = Object.keys(body).find((k) => !known.includes(k));
  if (unknown) throw new BadInput(\`There is no field "\${unknown}" to set. Fields: \${known.join(", ")}.\`);
  return body as Record<string, unknown>;
}

/** A project as the API gives it. */
export function projectToApi(row: Record<string, any>) {
  return {
    id: row.id as number,
    name: row.name ?? null,
    description: row.description ?? null,
    createdAt: row.createdAt instanceof Date ? row.createdAt.toISOString() : row.createdAt,
    updatedAt: row.updatedAt instanceof Date ? row.updatedAt.toISOString() : row.updatedAt,
  };
}

/** A project's values from a body: all of them, or a change to \`current\`. */
export function projectFromApi(body: unknown, current?: Record<string, unknown>) {
  const given = fieldsOf(body, ["name", "description"]);
  const values: Record<string, unknown> = { ...current };
  for (const [key, v] of Object.entries(given))
    switch (key) {
      case "name":
        values.name = v;
        break;
      case "description":
        values.description = v;
        break;
    }
  return projectSchema.parse(values);
}

/** A task as the API gives it. */
export function taskToApi(row: Record<string, any>) {
  return {
    id: row.id as number,
    title: row.title ?? null,
    project: row.projectId ?? null,
    status: row.status ?? null,
    dueDate: row.dueDate ?? null,
    assignee: row.assigneeId ?? null,
    details: row.details ?? null,
    createdAt: row.createdAt instanceof Date ? row.createdAt.toISOString() : row.createdAt,
    updatedAt: row.updatedAt instanceof Date ? row.updatedAt.toISOString() : row.updatedAt,
  };
}

/** A task's values from a body: all of them, or a change to \`current\`. */
export function taskFromApi(body: unknown, current?: Record<string, unknown>) {
  const given = fieldsOf(body, ["title", "project", "status", "dueDate", "assignee", "details"]);
  const values: Record<string, unknown> = { ...current };
  for (const [key, v] of Object.entries(given))
    switch (key) {
      case "title":
        values.title = v;
        break;
      case "project":
        values.projectId = v === null ? null : whole(v, "project");
        break;
      case "status":
        values.status = v;
        break;
      case "dueDate":
        values.dueDate = v;
        break;
      case "assignee":
        values.assigneeId = v === null ? null : whole(v, "assignee");
        break;
      case "details":
        values.details = v;
        break;
    }
  return taskSchema.parse(values);
}

/** A note as the API gives it. */
export function noteToApi(row: Record<string, any>) {
  return {
    id: row.id as number,
    title: row.title ?? null,
    project: row.projectId ?? null,
    body: row.body ?? null,
    createdAt: row.createdAt instanceof Date ? row.createdAt.toISOString() : row.createdAt,
    updatedAt: row.updatedAt instanceof Date ? row.updatedAt.toISOString() : row.updatedAt,
  };
}

/** A note's values from a body: all of them, or a change to \`current\`. */
export function noteFromApi(body: unknown, current?: Record<string, unknown>) {
  const given = fieldsOf(body, ["title", "project", "body"]);
  const values: Record<string, unknown> = { ...current };
  for (const [key, v] of Object.entries(given))
    switch (key) {
      case "title":
        values.title = v;
        break;
      case "project":
        values.projectId = v === null ? null : whole(v, "project");
        break;
      case "body":
        values.body = v;
        break;
    }
  return noteSchema.parse(values);
}

