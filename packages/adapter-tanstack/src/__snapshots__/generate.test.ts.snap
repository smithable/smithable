"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// The examples given for Order's formulas: each must give the expected value.
import { describe, expect, test } from "vitest";
import { orderFormulas } from "./order.formulas";

describe("Order.shippingCost", () => {
  test("total 150, shippingMethod standard gives 0", () => {
    expect(orderFormulas.shippingCost({ total: 15000, shippingMethod: "standard" })).toBe(0);
  });

  test("total 80, shippingMethod standard gives 5", () => {
    expect(orderFormulas.shippingCost({ total: 8000, shippingMethod: "standard" })).toBe(500);
  });

  test("total 150, shippingMethod express gives 15", () => {
    expect(orderFormulas.shippingCost({ total: 15000, shippingMethod: "express" })).toBe(1500);
  });
});
"
`;

exports[`../../../examples/crm/smithable.yml > file list and generated code > src/generated/order.formulas.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { F } from "#/kit/formula";

type Row = Record<string, unknown>;

/** Computed fields of Order, on records as stored (money in cents). */
export const orderFormulas = {
  shippingCost: (r: Row): number => F.toCents(((F.compare("=", F.t(r.shippingMethod), "standard") && F.compare(">", F.fromCents(r.total), 100)) ? 0 : (F.compare("=", F.t(r.shippingMethod), "express") ? 15 : 5))),
};

/** Values suggested when a Order is created. */
export const orderDefaults = {
  placedAt: (_r: Row): string => F.NOW(),
};

/** The record with its computed fields. */
export function withOrderFormulas<T extends Row>(row: T): T & { shippingCost: number } {
  return { ...row, shippingCost: orderFormulas.shippingCost(row) };
}
"
`;

exports[`../../../examples/crm/smithable.yml > file list and generated code > src/generated/order.server.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { and, eq, sql, type SQL } from "drizzle-orm";
import { db } from "#/db";
import { orders } from "#/db/schema";
import { AccessDenied, check, type ModelAccess, readScope, type Viewer } from "#/kit/access";
import { customerData } from "./customer.server";
import type { OrderValues } from "./order";
import { withOrderFormulas } from "./order.formulas";

/** Who may read, create, change and delete orders. */
export const orderAccess: ModelAccess = {
  read: { public: false, roles: ["admin", "sales"], owner: false },
  create: { public: false, roles: ["admin", "sales"], owner: false },
  write: { public: false, roles: ["admin", "sales"], owner: false },
  delete: { public: false, roles: ["admin"], owner: false },
};

/** Checks that the viewer may read the records the values refer to. */
function checkReferences(viewer: Viewer | null, values: OrderValues): void {
  if (values.customerId != null && !customerData.canRead(viewer, values.customerId))
    throw new AccessDenied(viewer !== null);
}

export const orderData = {
  /** A condition for the orders the viewer may read. */
  readable(viewer: Viewer | null) {
    const scope = readScope(orderAccess.read, viewer);
    if (scope === "all") return undefined;
    return scope === "own" && viewer ? eq(orders.ownerId, viewer.id) : sql\`false\`;
  },

  canRead(viewer: Viewer | null, id: number): boolean {
    const found = db
      .select({ id: orders.id })
      .from(orders)
      .where(and(eq(orders.id, id), orderData.readable(viewer)))
      .get();
    return found !== undefined;
  },

  /** The orders the viewer may read; \`where\` narrows them, e.g. to a search. */
  async list(viewer: Viewer | null, where?: SQL) {
    if (readScope(orderAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const rows = await db.query.orders.findMany({
      where: and(orderData.readable(viewer), where),
      with: { customer: { columns: { id: true, name: true } } },
      orderBy: (t, { desc }) => [desc(t.id)],
    });
    return rows.map(withOrderFormulas);
  },

  async get(viewer: Viewer | null, id: number) {
    const row = await db.query.orders.findFirst({
      where: and(eq(orders.id, id), orderData.readable(viewer)),
      with: { customer: { columns: { id: true, name: true } } },
    });
    return row ? withOrderFormulas(row) : null;
  },

  create(viewer: Viewer | null, values: OrderValues) {
    check(orderAccess.create, viewer);
    checkReferences(viewer, values);
    return db.insert(orders).values({ ...values, ownerId: viewer?.id ?? null }).returning().get();
  },

  update(viewer: Viewer | null, id: number, values: OrderValues) {
    const row = db
      .select({ ownerId: orders.ownerId })
      .from(orders)
      .where(and(eq(orders.id, id), orderData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(orderAccess.write, viewer, row.ownerId);
    checkReferences(viewer, values);
    return db.update(orders).set(values).where(eq(orders.id, id)).returning().get();
  },

  remove(viewer: Viewer | null, id: number): void {
    const row = db
      .select({ ownerId: orders.ownerId })
      .from(orders)
      .where(and(eq(orders.id, id), orderData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(orderAccess.delete, viewer, row.ownerId);
    db.delete(orders).where(eq(orders.id, id)).run();
  },
};
"
`;

