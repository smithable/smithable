"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { eq } from "drizzle-orm";
import { db } from "#/db";
import * as schema from "#/db/schema";
import { AccessDenied, allows, check, type Viewer } from "#/kit/access";
import { audit } from "#/kit/audit.server";
import { outgoing } from "#/generated/outgoing.server";
import { afterChange } from "#/generated/hooks";
import { invoiceSchema } from "#/generated/invoice.schema";
import { invoiceData } from "#/generated/invoice.server";
import { markSentAccess, markSentFits } from "./mark-sent";

type Row = NonNullable<Awaited<ReturnType<typeof invoiceData.get>>>;

/** The invoice's new values, worked out on it as it was. */
function plan(_viewer: Viewer | null, row: Row) {
  return {
    id: row.id,
    values: invoiceSchema.parse({
      ...row,
      status: "sent",
    }),

  };
}

/** Runs the "markSent" action on the invoice as the viewer. */
export async function runMarkSent(viewer: Viewer | null, id: number) {
  const row = await invoiceData.get(viewer, id);
  if (!row) throw new AccessDenied(viewer !== null);
  check(markSentAccess, viewer, row.ownerId);
  if (!markSentFits(row)) throw new Error("This cannot be done now.");
  const one = plan(viewer, row);
  return invoiceData.update(viewer, id, one.values, "markSent");
}

/**
 * Runs the "markSent" action on each chosen invoice it fits and the viewer may run it on
 * (docs/design/actions.md §9); the others are skipped. All or none: one that is refused stops
 * them all, and is named.
 */
export async function runMarkSentMany(viewer: Viewer | null, ids: number[]) {
  const plans: ReturnType<typeof plan>[] = [];
  // An id given twice is one record, run once.
  const unique = [...new Set(ids)];
  for (const id of unique) {
    const row = await invoiceData.get(viewer, id);
    if (!row || !allows(markSentAccess, viewer, row.ownerId) || !markSentFits(row)) continue;
    try {
      plans.push(plan(viewer, row));
    } catch (error) {
      const why = error instanceof Error ? error.message : String(error);
      throw new Error(\`Invoice "\${String(row.number ?? row.id)}": \${why}\`);
    }
  }
  const written = db.transaction((tx) => plans.map((p) => {
      const before = tx.select().from(schema.invoices).where(eq(schema.invoices.id, p.id)).get();
      const changed = tx.update(schema.invoices).set(p.values).where(eq(schema.invoices.id, p.id)).returning().get();
      audit(tx, viewer, { action: "markSent", model: "Invoice", record: changed.id, fields: ["status"] });
      outgoing(tx, viewer, "Invoice", "markSent", changed, before);
      const inserted = [

      ] as const;

      return { changed, inserted };
    }));
  for (const w of written) {
    await afterChange("afterUpdate", "Invoice", w.changed, viewer);

  }
  return { changed: plans.length, skipped: unique.length - plans.length };
}
"
`;

exports[`../../../examples/invoicing/smithable.yml > file list and generated code > src/generated/actions/mark-sent.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { z } from "zod";
import type { Rule } from "#/kit/access";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { writeAllowed } from "#/kit/limit";
import { currentViewer } from "#/lib/viewer.server";
import { runMarkSent, runMarkSentMany } from "./mark-sent.server";

/** Who may run the "markSent" action: whoever may edit the invoice. */
export const markSentAccess: Rule = { public: false, roles: ["admin"], owner: true };

/** Whether the "markSent" action fits the invoice: it is offered and allowed only then. */
export function markSentFits(row: { status?: unknown }): boolean {
  return row.status === "draft";
}

/** The viewer about to run it, counted against how often one may write (see src/kit/limit.ts). */
async function writer() {
  const viewer = await currentViewer();
  writeAllowed(viewer, getRequestHeaders());
  return viewer;
}

export const markSent = createServerFn({ method: "POST" })
  .validator(z.number().int())
  .handler(async ({ data }) => runMarkSent(await writer(), data));

/** The "markSent" action on the chosen invoices (at most 1,000 at once). */
export const markSentMany = createServerFn({ method: "POST" })
  .validator(z.object({ ids: z.array(z.number().int()).max(1000) }))
  .handler(async ({ data }) => runMarkSentMany(await writer(), data.ids));
"
`;

