"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { z } from "zod";
import type * as schema from "#/db/schema";
import { allows, type Rule } from "#/kit/access";
import type { RecordUi } from "#/kit/model";
import { bindFiles } from "#/kit/FileInput";
import { supportCaseAccess, supportCaseData } from "./support-case.server";
import { writeAllowed } from "#/kit/limit";
import { currentViewer } from "#/lib/viewer.server";
import { supportCaseSchema } from "./support-case.schema";

export type { SupportCaseSettable, SupportCaseValues } from "./support-case.schema";

/** The viewer about to write, counted against how often one may (see src/kit/limit.ts). */
async function writer() {
  const viewer = await currentViewer();
  writeAllowed(viewer, getRequestHeaders());
  return viewer;
}

/** SupportCase records as the kit reads them. */
export type SupportCaseRow = typeof schema.supportCases.$inferSelect & {
  assignee?: { id: string; name: string } | null;
};

export const supportCaseUi: RecordUi<SupportCaseRow> = {
  model: "SupportCase",
  label: "Support case",
  pluralLabel: "Support cases",
  titleField: "subject",
  columns: ["subject", "customerEmail", "status", "priority", "assigneeId"],
  fields: [
    {
      name: "subject",
      label: "Subject",
      kind: "string",
      required: true,
      get: (row) => row.subject,
    },
    {
      name: "customerEmail",
      label: "Customer email",
      kind: "email",
      required: true,
      locked: true,
      get: (row) => row.customerEmail,
    },
    {
      name: "status",
      label: "Status",
      kind: "choice",
      required: true,
      choices: [
        { value: "open", label: "Open" },
        { value: "inProgress", label: "In progress" },
        { value: "closed", label: "Closed" },
        { value: "reopened", label: "Reopened" },
      ],
      default: "open",
      get: (row) => row.status,
    },
    {
      name: "priority",
      label: "Priority",
      kind: "int",
      required: true,
      default: 3,
      min: 1,
      max: 5,
      get: (row) => row.priority,
    },
    {
      name: "assigneeId",
      label: "Assignee",
      kind: "user",
      required: false,
      requiredWhen: { status: ["inProgress", "closed"] },
      relation: { key: "assignee", titleField: "name" },
      get: (row) => row.assignee?.name ?? null,
    },
    {
      name: "body",
      label: "Body",
      kind: "text",
      required: false,
      get: (row) => row.body,
    },
    {
      name: "attachments",
      label: "Attachments",
      kind: "files",
      required: false,
      input: bindFiles("support-case", "attachments", 10),
      get: (row) => row.attachments,
    },
  ],
};

/** Who may delete support cases: a list's selection offers Delete by it (the server checks again). */
export const supportCaseDeleteRule: Rule = { public: false, roles: ["admin"], owner: true };


export const listSupportCases = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return { rows: await supportCaseData.list(viewer), canCreate: allows(supportCaseAccess.create, viewer) };
});

export const getSupportCase = createServerFn()
  .validator(z.number().int())
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    const row = await supportCaseData.get(viewer, id);
    if (!row) return null;
    return {
      row,
      canWrite: allows(supportCaseAccess.write, viewer, row.ownerId),
      canDelete: allows(supportCaseAccess.delete, viewer, row.ownerId),
    };
  });

/** Choices for fields that refer to a support case. */
export const supportCaseOptions = createServerFn().handler(async () =>
  supportCaseData.options(await currentViewer()),
);

export const createSupportCase = createServerFn({ method: "POST" })
  .validator(supportCaseSchema)
  .handler(async ({ data }) => supportCaseData.create(await writer(), data));

export const updateSupportCase = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), values: supportCaseSchema }))
  .handler(async ({ data }) => supportCaseData.update(await writer(), data.id, data.values));

/** Deletes a support case; \`together\` takes what points to it along (docs/design/delete-together.md). */
export const deleteSupportCase = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), together: z.boolean().optional() }))
  .handler(async ({ data }) => supportCaseData.remove(await writer(), data.id, data.together));

/** Deletes the chosen support cases, all or none (at most 1,000 at once). */
export const deleteSupportCases = createServerFn({ method: "POST" })
  .validator(z.object({ ids: z.array(z.number().int()).max(1000), together: z.boolean().optional() }))
  .handler(async ({ data }) => supportCaseData.removeMany(await writer(), data.ids, data.together));
"
`;

