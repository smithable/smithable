describe("the audit log", () => {
  test("names who created, changed and deleted a record, and what changed", async () => {
    const viewer = signedIn("admin");
    const made = await businessProfileData.create(viewer, businessProfileValues(viewer.id));
    await businessProfileData.update(viewer, made.id, businessProfileValues(viewer.id));
    await businessProfileData.remove(viewer, made.id);
    const lines = db
      .select()
      .from(auditLog)
      .where(and(eq(auditLog.model, "BusinessProfile"), eq(auditLog.recordId, made.id)))
      .all();
    expect(lines.map((l) => [l.action, l.who, l.role])).toEqual([
      ["created", viewer.id, viewer.role],
      ["changed", viewer.id, viewer.role],
      ["deleted", viewer.id, viewer.role],
    ]);
    // Only the line that deleted it keeps the record's name (its title by then); no field's
    // value is stored.
    expect(lines.map((l) => Boolean(l.title))).toEqual([false, false, true]);
    expect(JSON.stringify(lines[1]?.fields ?? [])).not.toContain(":");

    // Forget in the log: administrators only; it blanks the deleted record's name and is logged by id.
    expect(() => forgetInLog(signedIn("member"), { model: "BusinessProfile", record: made.id })).toThrow(AccessDenied);
    forgetInLog(signedIn("admin"), { model: "BusinessProfile", record: made.id });
    const after = db.select().from(auditLog).where(and(eq(auditLog.model, "BusinessProfile"), eq(auditLog.recordId, made.id))).all();
    expect(after.map((l) => l.title)).toEqual([null, null, null]);
    const forgot = db.select().from(auditLog).where(eq(auditLog.action, "forgotten in the log")).all().at(-1);
    expect(forgot).toMatchObject({ title: null, details: { model: "BusinessProfile", record: made.id } });
  });

  test("keeps the client's details and a deleted record's name 90 days, and a line 12 months", () => {
    const day = 24 * 60 * 60 * 1000;
    const line = (daysAgo: number) =>
      db
        .insert(auditLog)
        .values({ at: new Date(Date.now() - daysAgo * day), who: "test", action: "deleted", title: "Old", address: "10.0.0.1", browser: "test" })
        .returning()
        .get();
    const recent = line(10);
    const older = line(100);
    const oldest = line(400);
    pruneAudit();
    const row = (id: number) => db.select().from(auditLog).where(eq(auditLog.id, id)).get();
    expect(row(recent.id)).toMatchObject({ title: "Old", address: "10.0.0.1" });
    expect(row(older.id)).toMatchObject({ title: null, address: null, browser: null, action: "deleted" });
    expect(row(oldest.id)).toBeUndefined();
  });
});
"
`;

exports[`../../../examples/invoicing/smithable.yml > file list and generated code > src/generated/actions/mark-paid.server.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { eq } from "drizzle-orm";
import { db } from "#/db";
import * as schema from "#/db/schema";
import { AccessDenied, allows, check, type Viewer } from "#/kit/access";
import { audit } from "#/kit/audit.server";
import { outgoing } from "#/generated/outgoing.server";
import { afterChange } from "#/generated/hooks";
import { invoiceSchema } from "#/generated/invoice.schema";
import { invoiceData } from "#/generated/invoice.server";
import { markPaidAccess, markPaidFits } from "./mark-paid";

type Row = NonNullable<Awaited<ReturnType<typeof invoiceData.get>>>;

/** The invoice's new values, worked out on it as it was. */
function plan(_viewer: Viewer | null, row: Row) {
  return {
    id: row.id,
    values: invoiceSchema.parse({
      ...row,
      status: "paid",
    }),

  };
}

/** Runs the "markPaid" action on the invoice as the viewer. */
export async function runMarkPaid(viewer: Viewer | null, id: number) {
  const row = await invoiceData.get(viewer, id);
  if (!row) throw new AccessDenied(viewer !== null);
  check(markPaidAccess, viewer, row.ownerId);
  if (!markPaidFits(row)) throw new Error("This cannot be done now.");
  const one = plan(viewer, row);
  return invoiceData.update(viewer, id, one.values, "markPaid");
}

/**
 * Runs the "markPaid" action on each chosen invoice it fits and the viewer may run it on
 * (docs/design/actions.md §9); the others are skipped. All or none: one that is refused stops
 * them all, and is named.
 */
export async function runMarkPaidMany(viewer: Viewer | null, ids: number[]) {
  const plans: ReturnType<typeof plan>[] = [];
  // An id given twice is one record, run once.
  const unique = [...new Set(ids)];
  for (const id of unique) {
    const row = await invoiceData.get(viewer, id);
    if (!row || !allows(markPaidAccess, viewer, row.ownerId) || !markPaidFits(row)) continue;
    try {
      plans.push(plan(viewer, row));
    } catch (error) {
      const why = error instanceof Error ? error.message : String(error);
      throw new Error(\`Invoice "\${String(row.number ?? row.id)}": \${why}\`);
    }
  }
  const written = db.transaction((tx) => plans.map((p) => {
      const before = tx.select().from(schema.invoices).where(eq(schema.invoices.id, p.id)).get();
      const changed = tx.update(schema.invoices).set(p.values).where(eq(schema.invoices.id, p.id)).returning().get();
      audit(tx, viewer, { action: "markPaid", model: "Invoice", record: changed.id, fields: ["status"] });
      outgoing(tx, viewer, "Invoice", "markPaid", changed, before);
      const inserted = [

      ] as const;

      return { changed, inserted };
    }));
  for (const w of written) {
    await afterChange("afterUpdate", "Invoice", w.changed, viewer);

  }
  return { changed: plans.length, skipped: unique.length - plans.length };
}
"
`;

exports[`../../../examples/invoicing/smithable.yml > file list and generated code > src/generated/actions/mark-paid.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { z } from "zod";
import type { Rule } from "#/kit/access";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { writeAllowed } from "#/kit/limit";
import { currentViewer } from "#/lib/viewer.server";
import { runMarkPaid, runMarkPaidMany } from "./mark-paid.server";

/** Who may run the "markPaid" action: whoever may edit the invoice. */
export const markPaidAccess: Rule = { public: false, roles: ["admin"], owner: true };

/** Whether the "markPaid" action fits the invoice: it is offered and allowed only then. */
export function markPaidFits(row: { status?: unknown }): boolean {
  return ["sent","overdue"].includes(String(row.status));
}

/** The viewer about to run it, counted against how often one may write (see src/kit/limit.ts). */
async function writer() {
