describe("the publish action", () => {
  test("admin", async () => {
    const viewer = signedIn("admin");
    const others = insertPost(stranger.id, {"status":"draft"});
    const own = insertPost(viewer.id, {"status":"draft"});
    expect({
      others: await can(() => runPublish(viewer, others.id)),
      own: await can(() => runPublish(viewer, own.id)),
    }).toEqual({ others: true, own: true });
  });

  test("member", async () => {
    const viewer = signedIn("member");
    const others = insertPost(stranger.id, {"status":"draft"});
    const othersBefore = JSON.stringify(db.select().from(schema.posts).where(eq(schema.posts.id, others.id)).get());
    const own = insertPost(viewer.id, {"status":"draft"});
    expect({
      others: await can(() => runPublish(viewer, others.id)),
      own: await can(() => runPublish(viewer, own.id)),
    }).toEqual({ others: false, own: true });
    expect(JSON.stringify(db.select().from(schema.posts).where(eq(schema.posts.id, others.id)).get())).toBe(othersBefore);
  });

  test("a visitor who has not signed in", async () => {
    const viewer = null;
    const others = insertPost(stranger.id, {"status":"draft"});
    const othersBefore = JSON.stringify(db.select().from(schema.posts).where(eq(schema.posts.id, others.id)).get());
    expect({
      others: await can(() => runPublish(viewer, others.id)),
      own: false,
    }).toEqual({ others: false, own: false });
    expect(JSON.stringify(db.select().from(schema.posts).where(eq(schema.posts.id, others.id)).get())).toBe(othersBefore);
  });

  test("refused on a record where status is not draft", async () => {
    const viewer = signedIn("admin");
    const record = insertPost(viewer.id, {"status":"published"});
    await expect(runPublish(viewer, record.id)).rejects.toThrow("This cannot be done now.");
  });

  test("over chosen records, only those it fits and may run on change", async () => {
    const viewer = signedIn("admin");
    const fitting = insertPost(viewer.id, {"status":"draft"});
    const notFitting = insertPost(viewer.id, {"status":"published"});
    const notFittingBefore = JSON.stringify(db.select().from(schema.posts).where(eq(schema.posts.id, notFitting.id)).get());
    expect(await runPublishMany(viewer, [fitting.id, fitting.id, notFitting.id])).toEqual({ changed: 1, skipped: 1 });
    expect(JSON.stringify(db.select().from(schema.posts).where(eq(schema.posts.id, notFitting.id)).get())).toBe(notFittingBefore);
    const again = insertPost(viewer.id, {"status":"draft"});
    const againBefore = JSON.stringify(db.select().from(schema.posts).where(eq(schema.posts.id, again.id)).get());
    await runPublishMany(null, [again.id]).catch(() => undefined);
    expect(JSON.stringify(db.select().from(schema.posts).where(eq(schema.posts.id, again.id)).get())).toBe(againBefore);
  });
});

describe("the audit log", () => {
  test("names who created, changed and deleted a record, and what changed", async () => {
    const viewer = signedIn("admin");
    const made = await classTypeData.create(viewer, classTypeValues(viewer.id));
    await classTypeData.update(viewer, made.id, classTypeValues(viewer.id));
    await classTypeData.remove(viewer, made.id);
    const lines = db
      .select()
      .from(auditLog)
      .where(and(eq(auditLog.model, "ClassType"), eq(auditLog.recordId, made.id)))
      .all();
    expect(lines.map((l) => [l.action, l.who, l.role])).toEqual([
      ["created", viewer.id, viewer.role],
      ["changed", viewer.id, viewer.role],
      ["deleted", viewer.id, viewer.role],
    ]);
    // Only the line that deleted it keeps the record's name (its title by then); no field's
    // value is stored.
    expect(lines.map((l) => Boolean(l.title))).toEqual([false, false, true]);
    expect(JSON.stringify(lines[1]?.fields ?? [])).not.toContain(":");

    // Forget in the log: administrators only; it blanks the deleted record's name and is logged by id.
    expect(() => forgetInLog(signedIn("member"), { model: "ClassType", record: made.id })).toThrow(AccessDenied);
    forgetInLog(signedIn("admin"), { model: "ClassType", record: made.id });
    const after = db.select().from(auditLog).where(and(eq(auditLog.model, "ClassType"), eq(auditLog.recordId, made.id))).all();
    expect(after.map((l) => l.title)).toEqual([null, null, null]);
    const forgot = db.select().from(auditLog).where(eq(auditLog.action, "forgotten in the log")).all().at(-1);
    expect(forgot).toMatchObject({ title: null, details: { model: "ClassType", record: made.id } });
  });

  test("keeps the client's details and a deleted record's name 90 days, and a line 12 months", () => {
    const day = 24 * 60 * 60 * 1000;
    const line = (daysAgo: number) =>
      db
        .insert(auditLog)
        .values({ at: new Date(Date.now() - daysAgo * day), who: "test", action: "deleted", title: "Old", address: "10.0.0.1", browser: "test" })
        .returning()
        .get();
    const recent = line(10);
    const older = line(100);
    const oldest = line(400);
    pruneAudit();
    const row = (id: number) => db.select().from(auditLog).where(eq(auditLog.id, id)).get();
    expect(row(recent.id)).toMatchObject({ title: "Old", address: "10.0.0.1" });
    expect(row(older.id)).toMatchObject({ title: null, address: null, browser: null, action: "deleted" });
    expect(row(oldest.id)).toBeUndefined();
  });
});
