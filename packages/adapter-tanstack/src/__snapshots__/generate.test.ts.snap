  const navigate = useNavigate();
  const newButton = (
    <Link to="/invoice-lines/new" className={buttonVariants()}>
      New invoice line
    </Link>
  );
  return (
    <>
      <PageHeader
        title="Invoice lines"
        actions={newButton}
      />
      <ModelTable
        ui={invoiceLineUi}
        app={app}
        rows={rows}
        emptyAction={newButton}
        onOpen={(row) => navigate({ to: "/invoice-lines/$id", params: { id: String(row.id) } })}
      />
    </>
  );
}
"
`;

