describe("the complete action", () => {
  test("admin", async () => {
    const viewer = signedIn("admin");
    const others = insertTask(stranger.id, {"status":"todo"});
    const own = insertTask(viewer.id, {"status":"todo"});
    expect({
      others: await can(() => runComplete(viewer, others.id)),
      own: await can(() => runComplete(viewer, own.id)),
    }).toEqual({ others: true, own: true });
  });

  test("member", async () => {
    const viewer = signedIn("member");
    const others = insertTask(stranger.id, {"status":"todo"});
    const own = insertTask(viewer.id, {"status":"todo"});
    expect({
      others: await can(() => runComplete(viewer, others.id)),
      own: await can(() => runComplete(viewer, own.id)),
    }).toEqual({ others: true, own: true });
  });

  test("assistant", async () => {
    const viewer = signedIn("assistant");
    const others = insertTask(stranger.id, {"status":"todo"});
    const own = insertTask(viewer.id, {"status":"todo"});
    expect({
      others: await can(() => runComplete(viewer, others.id)),
      own: await can(() => runComplete(viewer, own.id)),
    }).toEqual({ others: true, own: true });
  });

  test("a visitor who has not signed in", async () => {
    const viewer = null;
    const others = insertTask(stranger.id, {"status":"todo"});
    const othersBefore = JSON.stringify(db.select().from(schema.tasks).where(eq(schema.tasks.id, others.id)).get());
    expect({
      others: await can(() => runComplete(viewer, others.id)),
      own: false,
    }).toEqual({ others: false, own: false });
    expect(JSON.stringify(db.select().from(schema.tasks).where(eq(schema.tasks.id, others.id)).get())).toBe(othersBefore);
  });

  test("refused on a record where status is not todo or doing", async () => {
    const viewer = signedIn("admin");
    const record = insertTask(viewer.id, {"status":"done"});
    await expect(runComplete(viewer, record.id)).rejects.toThrow("This cannot be done now.");
  });

  test("over chosen records, only those it fits and may run on change", async () => {
    const viewer = signedIn("admin");
    const fitting = insertTask(viewer.id, {"status":"todo"});
    const notFitting = insertTask(viewer.id, {"status":"done"});
    const notFittingBefore = JSON.stringify(db.select().from(schema.tasks).where(eq(schema.tasks.id, notFitting.id)).get());
    expect(await runCompleteMany(viewer, [fitting.id, fitting.id, notFitting.id])).toEqual({ changed: 1, skipped: 1 });
    expect(JSON.stringify(db.select().from(schema.tasks).where(eq(schema.tasks.id, notFitting.id)).get())).toBe(notFittingBefore);
    const again = insertTask(viewer.id, {"status":"todo"});
    const againBefore = JSON.stringify(db.select().from(schema.tasks).where(eq(schema.tasks.id, again.id)).get());
    await runCompleteMany(null, [again.id]).catch(() => undefined);
    expect(JSON.stringify(db.select().from(schema.tasks).where(eq(schema.tasks.id, again.id)).get())).toBe(againBefore);
  });
});

