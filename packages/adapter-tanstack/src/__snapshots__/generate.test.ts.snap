exports[`../../../examples/crm/smithable.yml > file list and generated code > src/lib/auth.ts 1`] = `
"// Generated by Smithable from smithable.auth.yml. Do not edit: this file is overwritten on every change.
import { betterAuth } from "better-auth";
import { drizzleAdapter } from "better-auth/adapters/drizzle";
import { APIError } from "better-auth/api";
import { tanstackStartCookies } from "better-auth/tanstack-start";
import { eq } from "drizzle-orm";
import { db } from "#/db";
import { account, invitation, session, user, verification } from "#/db/schema";

/** Sign-in providers in button order; each needs its keys in the environment (see the README). */
export const PROVIDERS = ["google"];
const ALLOWED_DOMAINS = ["acme.com"];
/** These addresses become admins when they first sign in. */
const ADMINS: string[] = ["owner@acme.com"];
const APP_NAME = "Acme CRM";

const socialProviders = {
  ...(process.env.GOOGLE_CLIENT_ID && process.env.GOOGLE_CLIENT_SECRET
    ? { google: { clientId: process.env.GOOGLE_CLIENT_ID, clientSecret: process.env.GOOGLE_CLIENT_SECRET, hd: "acme.com" } }
    : {}),
};

/** The providers whose keys are set. */
export const configuredProviders = () => PROVIDERS.filter((p) => p in socialProviders);

// Production needs both: without a secret sessions could be forged, without the address
// sign-in breaks. Better to refuse to start than to run like that.
if (!import.meta.env.DEV && (!process.env.BETTER_AUTH_SECRET || !process.env.BETTER_AUTH_URL))
  throw new Error("Set BETTER_AUTH_SECRET and BETTER_AUTH_URL: in production the app does not start without them.");

export const auth = betterAuth({
  // In development the app runs on port 3000 (pnpm dev); set BETTER_AUTH_URL in production.
  baseURL: process.env.BETTER_AUTH_URL ?? (import.meta.env.DEV ? "http://localhost:3000" : undefined),
  database: drizzleAdapter(db, { provider: "sqlite", schema: { account, session, user, verification } }),
  socialProviders,
  // Email and password only serve the development sign-in; production builds leave it off.
  emailAndPassword: { enabled: import.meta.env.DEV },
  user: {
    additionalFields: {
      role: { type: "string", required: true, defaultValue: "sales", input: false },
    },
  },
  databaseHooks: {
    user: {
      create: {
        before: async (newUser) => {
          const email = newUser.email.toLowerCase();
      if (!ALLOWED_DOMAINS.includes(email.split("@")[1] ?? "")) {
        throw new APIError("FORBIDDEN", {
          message: \`Only \${ALLOWED_DOMAINS.join(" and ")} accounts can sign in.\`,
        });
      }
          const invited = db.select().from(invitation).where(eq(invitation.email, email)).get();
          const open = invited && invited.expiresAt.getTime() > Date.now() ? invited : undefined;
          if (!open && !ADMINS.includes(email) && !(import.meta.env.DEV && email.startsWith("dev-"))) {
            throw new APIError("FORBIDDEN", {
              message: invited
                ? "Your invitation has expired. Ask an administrator for a new one."
                : \`Only invited people can sign in to \${APP_NAME}. Ask an administrator for an invitation.\`,
            });
          }
          return { data: { ...newUser, role: ADMINS.includes(email) ? "admin" : open?.role ?? "sales" } };
        },
        after: async (created) => {
          // The invitation is used up: the user is the record from now on.
          db.delete(invitation).where(eq(invitation.email, created.email.toLowerCase())).run();
        },
      },
    },
  },
  plugins: [tanstackStartCookies()],
});
"
`;

exports[`../../../examples/crm/smithable.yml > file list and generated code > src/lib/viewer.server.ts 1`] = `
"// Generated by Smithable from smithable.auth.yml. Do not edit: this file is overwritten on every change.
import { getRequestHeaders } from "@tanstack/react-start/server";
import type { Viewer } from "#/kit/access";
import { auth } from "#/lib/auth";

/** The signed-in user of the current request, or null. */
export async function currentViewer(): Promise<Viewer | null> {
  const session = await auth.api.getSession({ headers: getRequestHeaders() });
  if (!session) return null;
  const { id, name, email, role } = session.user;
  return { id, name, email, role };
}
"
`;

exports[`../../../examples/crm/smithable.yml > file list and generated code > src/routes/__root.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createRootRoute, HeadContent, Scripts, useRouter } from "@tanstack/react-router";
import { createServerFn } from "@tanstack/react-start";
import { ShoppingCart, Users } from "lucide-react";
import { app } from "#/generated/app";
import { pageAccess } from "#/generated/pages";
import { currentViewer } from "#/lib/viewer.server";
import { AppShell, ErrorNotice, type MenuUi } from "#/kit/AppShell";
import { pageHeaders } from "#/kit/security";
import { authClient } from "#/lib/auth-client";
import appCss from "#/styles.css?url";

const menus: MenuUi[] = [
  {
    name: "main",
    items: [
      {
        to: "/customers",
        label: "Customers",
        icon: Users,
        access: pageAccess["customers"],
      },
      {
        to: "/orders",
        label: "Orders",
        icon: ShoppingCart,
        access: pageAccess["orders"],
      },
      {
        to: "/team",
        label: "Team",
        icon: Users,
        access: pageAccess["team"],
      },
    ],
  },
];


const getViewer = createServerFn().handler(() => currentViewer());

export const Route = createRootRoute({
  // Every page knows who is signed in; pages check their access with it.
  beforeLoad: async () => ({ viewer: await getViewer() }),
  headers: ({ ssr }) => pageHeaders(ssr?.nonce),
  head: () => ({
    meta: [
      { charSet: "utf-8" },
      { name: "viewport", content: "width=device-width, initial-scale=1" },
      { title: app.name },
    ],
    links: [
      { rel: "stylesheet", href: appCss },
      { rel: "icon", href: "/favicon.svg", type: "image/svg+xml" },
    ],
  }),
  shellComponent: RootDocument,
  errorComponent: ({ error }) => (
    <ErrorNotice title="Something went wrong" message={error instanceof Error ? error.message : undefined} />
  ),
  notFoundComponent: () => (
    <ErrorNotice title="Not found" message="This page or record does not exist, or you cannot see it." />
  ),
});

function RootDocument({ children }: { children: React.ReactNode }) {
  const { viewer } = Route.useRouteContext();
  const router = useRouter();
  const signOut = async () => {
    await authClient.signOut();
    await router.invalidate();
  };
  return (
    <html lang="en">
      <head>
        <HeadContent />
      </head>
      <body>
        <AppShell appName={app.name} menus={menus} viewer={viewer} onSignOut={signOut}>
          {children}
        </AppShell>
        <Scripts />
      </body>
    </html>
  );
}
"
`;

exports[`../../../examples/crm/smithable.yml > file list and generated code > src/routes/customers/$id.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, notFound, useNavigate } from "@tanstack/react-router";
import { app } from "#/generated/app";
import { pageAccess } from "#/generated/pages";
import { customerSchema, customerUi, deleteCustomer, getCustomer, updateCustomer } from "#/generated/customer";
import { orderUi } from "#/generated/order";
import { userOptions } from "#/generated/users";
import { guardPage } from "#/kit/access";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";
import { ModelTable } from "#/kit/ModelTable";

export const Route = createFileRoute("/customers/$id")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["customers"], context.viewer, location.href),
  loader: async ({ params }) => {
    const found = await getCustomer({ data: Number(params.id) });
    if (!found) throw notFound();
    return { ...found, options: { accountManagerId: await userOptions() } };
  },
  component: CustomerPage,
});

function CustomerPage() {
  const { row, canWrite, canDelete, options } = Route.useLoaderData();
  const navigate = useNavigate();
  const back = () => navigate({ to: "/customers" });
  return (
    <>
      <PageHeader title={row.name || \`Customer #\${row.id}\`} />
      <ModelForm
        ui={customerUi}
        app={app}
        schema={customerSchema}
        initial={row}
        readOnly={!canWrite}
        options={options}
        submitLabel="Save changes"
        onSubmit={async (values) => {
          await updateCustomer({ data: { id: row.id, values } });
          await back();
        }}
        onCancel={back}
        onDelete={
          canDelete
            ? async () => {
                await deleteCustomer({ data: row.id });
                await back();
              }
            : undefined
        }
      />
      <section className="mt-10">
        <h2 className="mb-3 text-lg font-semibold">Orders</h2>
        <ModelTable
          ui={orderUi}
          app={app}
          rows={row.orders}
          hide={["customerId"]}
          onOpen={(item) => navigate({ to: "/orders/$id", params: { id: String(item.id) } })}
        />
      </section>
    </>
  );
}
"
`;

exports[`../../../examples/crm/smithable.yml > file list and generated code > src/routes/customers/actions/merge-customers.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, useNavigate } from "@tanstack/react-router";
import { app } from "#/generated/app";
import { mergeCustomers, mergeCustomersAccess, mergeCustomersInput, mergeCustomersUi } from "#/generated/actions/merge-customers";
import { customerOptions } from "#/generated/customer";
import { guardPage } from "#/kit/access";
import { PageHeader } from "#/kit/AppShell";
import { ModelForm } from "#/kit/ModelForm";

export const Route = createFileRoute("/customers/actions/merge-customers")({
  beforeLoad: ({ context, location }) => guardPage(mergeCustomersAccess, context.viewer, location.href),
  loader: async () => ({ options: { keep: await customerOptions(), duplicate: await customerOptions() } }),
  component: MergeCustomersPage,
});

function MergeCustomersPage() {
  const { options } = Route.useLoaderData();
  const navigate = useNavigate();
  const back = () => navigate({ to: "/customers" });
  return (
    <>
      <PageHeader title="Merge customers" />
      <ModelForm
        ui={mergeCustomersUi}
        app={app}
        schema={mergeCustomersInput}
        options={options}
        submitLabel="Merge customers"
        onSubmit={async (values) => {
          await mergeCustomers({ data: values });
          await back();
        }}
        onCancel={back}
      />
    </>
  );
}
"
`;

exports[`../../../examples/crm/smithable.yml > file list and generated code > src/routes/customers/index.tsx 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createFileRoute, Link, useNavigate } from "@tanstack/react-router";
import { pageAccess } from "#/generated/pages";
import { guardPage, allows } from "#/kit/access";
import { createServerFn } from "@tanstack/react-start";
import { z } from "zod";
import { customers } from "#/db/schema";
import { customerAccess, customerData } from "#/generated/customer.server";
import { contains } from "#/kit/search";
import { currentViewer } from "#/lib/viewer.server";
import { buttonVariants } from "#/components/ui/button";
import { mergeCustomersAccess } from "#/generated/actions/merge-customers";
import { app } from "#/generated/app";
import { customerUi } from "#/generated/customer";
import { PageHeader } from "#/kit/AppShell";
import { ModelTable } from "#/kit/ModelTable";
import { SearchBox } from "#/kit/SearchBox";

/** The customers matching the search, among those the viewer may read. */
const searchCustomers = createServerFn()
  .validator(z.object({ q: z.string().max(200).optional() }))
  .handler(async ({ data }) => {
    const viewer = await currentViewer();
    const where = data.q ? contains([customers.name, customers.email], data.q) : undefined;
    return { rows: await customerData.list(viewer, where), canCreate: allows(customerAccess.create, viewer) };
  });

export const Route = createFileRoute("/customers/")({
  beforeLoad: ({ context, location }) => guardPage(pageAccess["customers"], context.viewer, location.href),
  validateSearch: z.object({ q: z.string().optional().catch(undefined) }),
  loaderDeps: ({ search }) => ({ q: search.q }),
  loader: ({ deps }) => searchCustomers({ data: { q: deps.q } }),
  component: CustomersPage,
});

function CustomersPage() {
  const { rows, canCreate } = Route.useLoaderData();
  const { q } = Route.useSearch();
  const { viewer } = Route.useRouteContext();
  const navigate = useNavigate();
  const newButton = canCreate && (
    <Link to="/customers/new" className={buttonVariants()}>
      New customer
    </Link>
  );
  const mergeCustomersButton = allows(mergeCustomersAccess, viewer) && (
    <Link to="/customers/actions/merge-customers" className={buttonVariants({ variant: "outline" })}>
      Merge customers
    </Link>
  );
  return (
    <>
      <PageHeader
        page="customers"
        title="Customers"
        actions={<>{mergeCustomersButton}{newButton}</>}
      />
      <SearchBox
        value={q ?? ""}
        placeholder="Search by name or email"
        onSearch={(text) => navigate({ to: "/customers", search: { q: text || undefined }, replace: true })}
      />
      <ModelTable
        ui={customerUi}
        page="customers"
        app={app}
        rows={rows}
        emptyMessage={q ? \`No customers match “\${q}”.\` : undefined}
        emptyAction={newButton || undefined}
        onOpen={(row) => navigate({ to: "/customers/$id", params: { id: String(row.id) } })}
      />
    </>
  );
}
"
`;

