exports[`../../../examples/invoicing/smithable.yml > file list and generated code > src/generated/hooks.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
// Where the app reacts to changes: after a record is created, changed or deleted, and once a
// day. Your reactions go in src/custom/hooks.ts (send an email, update another record, call a
// service); a plugin's in its own hooks file. A hook runs on the server, in the request that
// made the change and with the viewer who made it, after the change is saved; a hook that
// throws fails that request. Daily jobs run in production, a day after the server started.
import type { businessProfiles, clients, invoiceLines, invoices } from "#/db/schema";
import type { Viewer } from "#/kit/access";
import * as custom from "#/custom/hooks";

export type Hook<Row> = (row: Row, viewer: Viewer | null) => void | Promise<void>;

/** Each model's record as it is stored. */
export interface Rows {
  BusinessProfile: typeof businessProfiles.$inferSelect;
  Client: typeof clients.$inferSelect;
  Invoice: typeof invoices.$inferSelect;
  InvoiceLine: typeof invoiceLines.$inferSelect;
}

export interface Hooks {
  /** After a record is created, by model. */
  afterCreate?: { [M in keyof Rows]?: Hook<Rows[M]> };
  /** After a record is changed, with its new values. */
  afterUpdate?: { [M in keyof Rows]?: Hook<Rows[M]> };
  /** After a record is deleted; only its id is left. */
  afterDelete?: { [M in keyof Rows]?: Hook<{ id: number }> };
  /** Once a day. */
  daily?: (() => void | Promise<void>)[];
}

// Read when a hook runs, not when this module loads: custom code may import the data functions,
// which import this file.
const sources = (): Hooks[] => [custom.hooks];

export async function afterChange<M extends keyof Rows>(
  event: "afterCreate" | "afterUpdate",
  model: M,
  row: Rows[M],
  viewer: Viewer | null,
): Promise<void> {
  for (const source of sources()) {
    // One model's hook at a time: TypeScript cannot narrow the lookup by a generic key.
    const hook = source[event]?.[model] as Hook<Rows[M]> | undefined;
    await hook?.(row, viewer);
  }
}

export async function afterDelete<M extends keyof Rows>(
  model: M,
  id: number,
  viewer: Viewer | null,
): Promise<void> {
  for (const source of sources()) {
    const hook = source.afterDelete?.[model] as Hook<{ id: number }> | undefined;
    await hook?.({ id }, viewer);
  }
}

/** Every daily job, in order; a failing one is reported and the rest still run. */
export async function runDaily(): Promise<void> {
  for (const source of sources())
    for (const job of source.daily ?? []) {
      try {
        await job();
      } catch (error) {
        console.error("A daily job failed:", error);
      }
    }
}

// In production, once a day, starting a day after the server started (pnpm start). The timer
// never keeps the process alive by itself, so the server still stops when asked to.
if (import.meta.env.SSR && import.meta.env.PROD) {
  const day = 24 * 60 * 60 * 1000;
  const tick = () => setTimeout(() => runDaily().finally(tick), day).unref();
  tick();
}
"
`;

exports[`../../../examples/invoicing/smithable.yml > file list and generated code > src/generated/invoice.formulas.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { F } from "#/kit/formula";
import { invoiceLineFormulas } from "./invoice-line.formulas";

type Row = Record<string, unknown>;

/** Computed fields of Invoice, on records as stored (money in cents). */
export const invoiceFormulas = {
  total: (r: Row): number => F.toCents(F.SUM(F.list(r.lines).map((x1) => F.fromCents(invoiceLineFormulas.amount(x1))))),
};

/** Values suggested when a Invoice is created. */
export const invoiceDefaults = {
  issuedOn: (_r: Row): string => F.TODAY(),
  dueOn: (r: Row): string => F.DATEADD(F.d(r.issuedOn), 30, "day"),
};

/** The record with its computed fields. */
export function withInvoiceFormulas<T extends Row>(row: T): T & { total: number } {
  return { ...row, total: invoiceFormulas.total(row) };
}
"
`;

exports[`../../../examples/invoicing/smithable.yml > file list and generated code > src/generated/invoice.server.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { and, asc, eq, sql, type SQL } from "drizzle-orm";
import { db } from "#/db";
import { invoices } from "#/db/schema";
import { AccessDenied, check, type ModelAccess, readScope, refusal, type Viewer } from "#/kit/access";
import { contains } from "#/kit/search";
import { afterChange, afterDelete } from "./hooks";
import { invoiceLineData } from "./invoice-line.server";
import { clientData } from "./client.server";
import type { InvoiceValues } from "./invoice";
import { withInvoiceFormulas } from "./invoice.formulas";

/** Who may read, create, change and delete invoices. */
export const invoiceAccess: ModelAccess = {
  read: { public: false, roles: ["admin"], owner: true },
  create: { public: false, roles: ["admin", "member"], owner: false },
  write: { public: false, roles: ["admin"], owner: true },
  delete: { public: false, roles: ["admin"], owner: true },
};

/** Checks that the viewer may read the records the values refer to. */
function checkReferences(viewer: Viewer | null, values: InvoiceValues): void {
  if (values.clientId != null && !clientData.canRead(viewer, values.clientId))
    throw new AccessDenied(viewer !== null);
}

export const invoiceData = {
  /** A condition for the invoices the viewer may read. */
  readable(viewer: Viewer | null) {
    const scope = readScope(invoiceAccess.read, viewer);
    if (scope === "all") return undefined;
    return scope === "own" && viewer ? eq(invoices.ownerId, viewer.id) : sql\`false\`;
  },

  canRead(viewer: Viewer | null, id: number): boolean {
    const found = db
      .select({ id: invoices.id })
      .from(invoices)
      .where(and(eq(invoices.id, id), invoiceData.readable(viewer)))
      .get();
    return found !== undefined;
  },

  /** The invoices the viewer may read; \`where\` narrows them, e.g. to a search. */
  async list(viewer: Viewer | null, where?: SQL) {
    if (readScope(invoiceAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const rows = await db.query.invoices.findMany({
      where: and(invoiceData.readable(viewer), where),
      with: { client: { columns: { id: true, name: true } }, lines: true },
      orderBy: (t, { desc }) => [desc(t.id)],
    });
    // The related records are here for the totals only: some may not be the viewer's to read.
    return rows.map((row) => {
      const { lines, ...listed } = withInvoiceFormulas(row);
      return listed;
    });
  },

  async get(viewer: Viewer | null, id: number) {
    const row = await db.query.invoices.findFirst({
      where: and(eq(invoices.id, id), invoiceData.readable(viewer)),
      with: { client: { columns: { id: true, name: true } }, lines: { where: invoiceLineData.readable(viewer) } },
    });
    if (!row) return null;
    // Totals count every related record, as in lists; the related records shown are the viewer's.
    const all = await db.query.invoices.findFirst({ where: eq(invoices.id, id), with: { lines: true } });
    return { ...withInvoiceFormulas({ ...row, lines: all?.lines ?? [] }), lines: row.lines };
  },

  async create(viewer: Viewer | null, values: InvoiceValues) {
    check(invoiceAccess.create, viewer);
    checkReferences(viewer, values);
    let row: typeof invoices.$inferSelect;
    try {
      row = db.insert(invoices).values({ ...values, ownerId: viewer?.id ?? null }).returning().get();
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterCreate", "Invoice", row, viewer);
    return row;
  },

  async update(viewer: Viewer | null, id: number, values: InvoiceValues) {
    const row = db
      .select({ ownerId: invoices.ownerId })
      .from(invoices)
      .where(and(eq(invoices.id, id), invoiceData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(invoiceAccess.write, viewer, row.ownerId);
    checkReferences(viewer, values);
    let changed: typeof invoices.$inferSelect;
    const updated = values;
    try {
      changed = db.update(invoices).set(updated).where(eq(invoices.id, id)).returning().get();
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterUpdate", "Invoice", changed, viewer);
    return changed;
  },

  async remove(viewer: Viewer | null, id: number): Promise<void> {
    const row = db
      .select({ ownerId: invoices.ownerId })
      .from(invoices)
      .where(and(eq(invoices.id, id), invoiceData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(invoiceAccess.delete, viewer, row.ownerId);
    try {
      db.delete(invoices).where(eq(invoices.id, id)).run();
    } catch (error) {
      throw refusal(error);
    }
    await afterDelete("Invoice", id, viewer);
  },

  /**
   * The invoices the viewer may read whose number contains the text: a search of records that
   * refer to them finds them only among these.
   */
  titled(viewer: Viewer | null, text: string): number[] {
    return db
      .select({ id: invoices.id })
      .from(invoices)
      .where(and(contains([invoices.number], text), invoiceData.readable(viewer)))
      .all()
      .map((row) => row.id);
  },

  /** Choices for fields that refer to a invoice: the ones the viewer may read. */
  options(viewer: Viewer | null) {
    if (readScope(invoiceAccess.read, viewer) === "none") return [];
    return db
      .select({ value: invoices.id, label: invoices.number })
      .from(invoices)
      .where(invoiceData.readable(viewer))
      .orderBy(asc(invoices.number))
      .all();
  },
};
"
`;

exports[`../../../examples/invoicing/smithable.yml > file list and generated code > src/generated/invoice.ts 1`] = `
"// Generated by Smithable from smithable.yml. Do not edit: this file is overwritten on every change.
import { createServerFn } from "@tanstack/react-start";
import { getRequestHeaders } from "@tanstack/react-start/server";
import { createInsertSchema } from "drizzle-zod";
import { z } from "zod";
import { invoices } from "#/db/schema";
import { allows } from "#/kit/access";
import type { RecordUi } from "#/kit/model";
import { invoiceDefaults, withInvoiceFormulas } from "./invoice.formulas";
import { invoiceAccess, invoiceData } from "./invoice.server";
import { writeAllowed } from "#/kit/limit";
import { currentViewer } from "#/lib/viewer.server";

/** The viewer about to write, counted against how often one may (see src/kit/limit.ts). */
async function writer() {
  const viewer = await currentViewer();
  writeAllowed(viewer, getRequestHeaders());
  return viewer;
}

/** Invoice records as the kit reads them. */
export type InvoiceRow = typeof invoices.$inferSelect & {
  client?: { id: number; name: string } | null;
  total?: unknown;
};

export const invoiceUi: RecordUi<InvoiceRow> = {
  model: "Invoice",
  label: "Invoice",
  pluralLabel: "Invoices",
  titleField: "number",
  columns: ["number", "clientId", "issuedOn", "dueOn", "status"],
  fields: [
    {
      name: "number",
      label: "Number",
      kind: "string",
      required: true,
      get: (row) => row.number,
    },
    {
      name: "clientId",
      label: "Client",
      kind: "relation",
      required: true,
      relation: { key: "client", titleField: "name" },
      get: (row) => row.client?.name ?? null,
    },
    {
      name: "issuedOn",
      label: "Issued on",
      kind: "date",
      required: true,
      get: (row) => row.issuedOn,
    },
    {
      name: "dueOn",
      label: "Due on",
      kind: "date",
      required: true,
      get: (row) => row.dueOn,
    },
    {
      name: "status",
      label: "Status",
      kind: "choice",
      required: true,
      choices: [
        { value: "draft", label: "Draft" },
        { value: "sent", label: "Sent" },
        { value: "paid", label: "Paid" },
        { value: "overdue", label: "Overdue" },
      ],
      default: "draft",
      get: (row) => row.status,
    },
    {
      name: "total",
      label: "Total",
      kind: "money",
      required: false,
      computed: true,
      get: (row) => row.total,
    },
  ],
  compute: withInvoiceFormulas,
  defaults: invoiceDefaults,
};

export const invoiceSchema = createInsertSchema(invoices, {
  number: (s) => s.trim().min(1, "Required").max(200, "At most 200 characters"),
  issuedOn: (s) => s.regex(/^\\d{4}-\\d{2}-\\d{2}$/, "Enter a valid date"),
  dueOn: (s) => s.regex(/^\\d{4}-\\d{2}-\\d{2}$/, "Enter a valid date"),
}).omit({ id: true, ownerId: true, createdAt: true, updatedAt: true });

export type InvoiceValues = z.output<typeof invoiceSchema>;

export const listInvoices = createServerFn().handler(async () => {
  const viewer = await currentViewer();
  return { rows: await invoiceData.list(viewer), canCreate: allows(invoiceAccess.create, viewer) };
});

export const getInvoice = createServerFn()
  .validator(z.number().int())
  .handler(async ({ data: id }) => {
    const viewer = await currentViewer();
    const row = await invoiceData.get(viewer, id);
    if (!row) return null;
    return {
      row,
      canWrite: allows(invoiceAccess.write, viewer, row.ownerId),
      canDelete: allows(invoiceAccess.delete, viewer, row.ownerId),
    };
  });

/** Choices for fields that refer to a invoice. */
export const invoiceOptions = createServerFn().handler(async () =>
  invoiceData.options(await currentViewer()),
);

export const createInvoice = createServerFn({ method: "POST" })
  .validator(invoiceSchema)
  .handler(async ({ data }) => invoiceData.create(await writer(), data));

export const updateInvoice = createServerFn({ method: "POST" })
  .validator(z.object({ id: z.number().int(), values: invoiceSchema }))
  .handler(async ({ data }) => invoiceData.update(await writer(), data.id, data.values));

export const deleteInvoice = createServerFn({ method: "POST" })
  .validator(z.number().int())
  .handler(async ({ data: id }) => invoiceData.remove(await writer(), id));
"
`;

