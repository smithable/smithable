exports[`../../../examples/booking/smithable.yml > file list and generated code > src/generated/access.test.ts 1`] = `
"// Generated by Smithable from smithable.yml and smithable.auth.yml. Do not edit: this file is overwritten on every change.
// For every model and role: which records a user can read, create, change and delete.
// "Own" records are owned by the user; "others" by someone else.
import { and, eq } from "drizzle-orm";
import { describe, expect, test } from "vitest";
import { db } from "#/db";
import { auditLog, user } from "#/db/schema";
import * as schema from "#/db/schema";
import { AccessDenied, type Viewer } from "#/kit/access";
import { forgetInLog, pruneAudit } from "#/kit/audit.server";
import { classTypeData } from "./class-type.server";
import { instructorData } from "./instructor.server";
import { sessionData } from "./session.server";
import { bookingData } from "./booking.server";
import { postData } from "./post.server";
import { messageData } from "./message.server";

let counter = 0;
const next = () => ++counter;

/** A new signed-in user with the role. */
function signedIn(role: string): Viewer {
  const n = next();
  const viewer = { id: \`test-user-\${n}\`, name: \`Test \${role} \${n}\`, email: \`user\${n}@example.com\`, role };
  db.insert(user).values(viewer).run();
  return viewer;
}

/** Owns the records that are someone else's. */
const stranger = signedIn("member");

/** Whether the action is allowed; any other failure fails the test. */
async function can(action: () => unknown): Promise<boolean> {
  try {
    await action();
    return true;
  } catch (error) {
    if (error instanceof AccessDenied) return false;
    throw error;
  }
}

/** Whether the viewer can open the record and sees it in the list. */
async function reads(
  data: { get(viewer: never, id: number): Promise<unknown>; list(viewer: never): Promise<{ id: number }[]> },
  viewer: unknown,
  id: number,
): Promise<boolean> {
  const listed = await data.list(viewer as never).then(
    (rows) => rows.some((row) => row.id === id),
    (error) => {
      if (error instanceof AccessDenied) return false;
      throw error;
    },
  );
  return listed && (await data.get(viewer as never, id)) !== null;
}

function classTypeValues(_owner: string | null) {
  const n = next();
  return { name: \`ClassType name \${n}\`, summary: null, level: "beginner", durationMinutes: n } as const;
}

function insertClassType(owner: string | null, values: Record<string, unknown> = {}) {
  return db
    .insert(schema.classTypes)
    .values({ ...classTypeValues(owner), ...values, ownerId: owner })
    .returning()
    .get();
}

function instructorValues(_owner: string | null) {
  const n = next();
  return { name: \`Instructor name \${n}\`, bio: null, portrait: null } as const;
}

function insertInstructor(owner: string | null, values: Record<string, unknown> = {}) {
  return db
    .insert(schema.instructors)
    .values({ ...instructorValues(owner), ...values, ownerId: owner })
    .returning()
    .get();
}

function sessionValues(owner: string | null) {
  const n = next();
  return { classTypeId: insertClassType(owner).id, instructorId: insertInstructor(owner).id, startsAt: new Date("2026-01-15T10:00:00Z"), capacity: n } as const;
}

function insertSession(owner: string | null, values: Record<string, unknown> = {}) {
  return db
    .insert(schema.sessions)
    .values({ ...sessionValues(owner), ...values, ownerId: owner })
    .returning()
    .get();
}

function bookingValues(owner: string | null) {
  return { sessionId: insertSession(owner).id } as const;
}

function insertBooking(owner: string | null, values: Record<string, unknown> = {}) {
  return db
    .insert(schema.bookings)
    .values({ ...bookingValues(owner), ...values, ownerId: owner })
    .returning()
    .get();
}

function postValues(_owner: string | null) {
  const n = next();
  return { title: \`Post title \${n}\`, address: \`Post address \${n}\`, summary: null, cover: null, body: \`Post body \${n}\`, publishedOn: null, status: "draft" } as const;
}

function insertPost(owner: string | null, values: Record<string, unknown> = {}) {
  return db
    .insert(schema.posts)
    .values({ ...postValues(owner), ...values, ownerId: owner })
    .returning()
    .get();
}

function messageValues(_owner: string | null) {
  const n = next();
  return { name: \`Message name \${n}\`, email: \`message\${n}@example.com\`, message: \`Message message \${n}\` } as const;
}

function insertMessage(owner: string | null, values: Record<string, unknown> = {}) {
  return db
    .insert(schema.messages)
    .values({ ...messageValues(owner), ...values, ownerId: owner })
    .returning()
    .get();
}

describe("ClassType", () => {
  test("admin", async () => {
    const viewer = signedIn("admin");
    const others = insertClassType(stranger.id);
    const own = insertClassType(viewer.id);
    expect({
      readOthers: await reads(classTypeData, viewer, others.id),
      readOwn: await reads(classTypeData, viewer, own.id),
      create: await can(() => classTypeData.create(viewer, classTypeValues(viewer.id))),
      changeOthers: await can(() => classTypeData.update(viewer, others.id, classTypeValues(stranger.id))),
      changeOwn: await can(() => classTypeData.update(viewer, own.id, classTypeValues(viewer.id))),
      deleteOthers: await can(() => classTypeData.remove(viewer, others.id)),
      deleteOwn: await can(() => classTypeData.remove(viewer, own.id)),
    }).toEqual({
      readOthers: true,
      readOwn: true,
      create: true,
      changeOthers: true,
      changeOwn: true,
      deleteOthers: true,
      deleteOwn: true,
    });
  });

  test("member", async () => {
    const viewer = signedIn("member");
    const others = insertClassType(stranger.id);
    const own = insertClassType(viewer.id);
    expect({
      readOthers: await reads(classTypeData, viewer, others.id),
      readOwn: await reads(classTypeData, viewer, own.id),
      create: await can(() => classTypeData.create(viewer, classTypeValues(viewer.id))),
      changeOthers: await can(() => classTypeData.update(viewer, others.id, classTypeValues(stranger.id))),
      changeOwn: await can(() => classTypeData.update(viewer, own.id, classTypeValues(viewer.id))),
      deleteOthers: await can(() => classTypeData.remove(viewer, others.id)),
      deleteOwn: await can(() => classTypeData.remove(viewer, own.id)),
    }).toEqual({
      readOthers: true,
      readOwn: true,
      create: false,
      changeOthers: false,
      changeOwn: true,
      deleteOthers: false,
      deleteOwn: true,
    });
  });

  test("a visitor who has not signed in", async () => {
    const viewer = null;
    const others = insertClassType(stranger.id);
    expect({
      readOthers: await reads(classTypeData, viewer, others.id),
      readOwn: false,
      create: await can(() => classTypeData.create(viewer, classTypeValues(null))),
      changeOthers: await can(() => classTypeData.update(viewer, others.id, classTypeValues(stranger.id))),
      changeOwn: false,
      deleteOthers: await can(() => classTypeData.remove(viewer, others.id)),
      deleteOwn: false,
    }).toEqual({
      readOthers: true,
      readOwn: false,
      create: false,
      changeOthers: false,
      changeOwn: false,
      deleteOthers: false,
      deleteOwn: false,
    });
  });
});

