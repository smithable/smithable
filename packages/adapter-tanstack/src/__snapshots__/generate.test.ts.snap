import { AccessDenied, check, type ModelAccess, readScope, refusal, type Viewer } from "#/kit/access";
import { deletePicture } from "#/kit/uploads";
import { afterChange, afterDelete } from "./hooks";
import type { PostValues } from "./post";

/** Who may read, create, change and delete posts. */
export const postAccess: ModelAccess = {
  read: { public: true, roles: ["admin"], owner: true, where: { status: "published" } },
  create: { public: false, roles: ["admin"], owner: false },
  write: { public: false, roles: ["admin"], owner: false },
  delete: { public: false, roles: ["admin"], owner: false },
};

export const postData = {
  /** A condition for the posts the viewer may read. */
  readable(viewer: Viewer | null) {
    const scope = readScope(postAccess.read, viewer);
    if (scope === "all") return undefined;
    if (scope === "public") return and(eq(posts.status, "published"));
    return scope === "own" && viewer ? or(eq(posts.ownerId, viewer.id), and(eq(posts.status, "published"))) : sql\`false\`;
  },

  canRead(viewer: Viewer | null, id: number): boolean {
    const found = db
      .select({ id: posts.id })
      .from(posts)
      .where(and(eq(posts.id, id), postData.readable(viewer)))
      .get();
    return found !== undefined;
  },

  /** The posts the viewer may read; \`where\` narrows them, e.g. to a search; \`limit\` keeps the newest (a data page). */
  async list(viewer: Viewer | null, where?: SQL, limit?: number) {
    if (readScope(postAccess.read, viewer) === "none") throw new AccessDenied(viewer !== null);
    const rows = await db.query.posts.findMany({
      where: and(postData.readable(viewer), where),
      orderBy: (t, { desc }) => [desc(t.id)],
      limit,
    });
    return rows;
  },

  /** How many posts the viewer may read, for a data page's overview; none to read: null. */
  count(viewer: Viewer | null): number | null {
    if (readScope(postAccess.read, viewer) === "none") return null;
    return db.select({ n: count() }).from(posts).where(postData.readable(viewer)).get()?.n ?? 0;
  },

  async get(viewer: Viewer | null, id: number) {
    const row = await db.query.posts.findFirst({
      where: and(eq(posts.id, id), postData.readable(viewer)),
    });
    return row ? row : null;
  },

  async create(viewer: Viewer | null, values: PostValues) {
    check(postAccess.create, viewer);
    let row: typeof posts.$inferSelect;
    try {
      row = db.insert(posts).values({ ...values, ownerId: viewer?.id ?? null }).returning().get();
    } catch (error) {
      throw refusal(error);
    }
    await afterChange("afterCreate", "Post", row, viewer);
    return row;
  },

  async update(viewer: Viewer | null, id: number, values: PostValues) {
    const row = db
      .select({ ownerId: posts.ownerId, cover: posts.cover })
      .from(posts)
      .where(and(eq(posts.id, id), postData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(postAccess.write, viewer, row.ownerId);
    let changed: typeof posts.$inferSelect;
    const updated = values;
    try {
      changed = db.update(posts).set(updated).where(eq(posts.id, id)).returning().get();
    } catch (error) {
      throw refusal(error);
    }
    if (row.cover && row.cover.file !== changed.cover?.file) deletePicture(row.cover, !!db.select({ id: posts.id }).from(posts).where(sql\`\${posts.cover} like \${\`%"file":"\${row.cover.file}"%\`}\`).get());
    await afterChange("afterUpdate", "Post", changed, viewer);
    return changed;
  },

  async remove(viewer: Viewer | null, id: number): Promise<void> {
    const row = db
      .select({ ownerId: posts.ownerId, cover: posts.cover })
      .from(posts)
      .where(and(eq(posts.id, id), postData.readable(viewer)))
      .get();
    if (!row) throw new AccessDenied(viewer !== null);
    check(postAccess.delete, viewer, row.ownerId);
    try {
      db.delete(posts).where(eq(posts.id, id)).run();
