"/* Generated by Smithable from smithable.ux.yml. Do not edit: this file is overwritten on every change. */
@import "@fontsource-variable/inter";
@import "@fontsource-variable/inter/wght-italic.css";

/* Theme: glassy, font Inter, comfortable, motion subtle */
:root {
  --background: #101218;
  --foreground: #eef0f5;
  --card: #191b21;
  --card-foreground: #eef0f5;
  --primary: #8fb4ff;
  --primary-foreground: #101522;
  --secondary: #1e2026;
  --secondary-foreground: #eef0f5;
  --muted: #1a1d23;
  --muted-foreground: #979a9f;
  --accent: #1f2533;
  --accent-foreground: #eef0f5;
  --border: #494b52;
  --input: #494b52;
  --ring: #8fb4ff;
  --sidebar: #191b21;
  --sidebar-foreground: #eef0f5;
  --destructive: #f08a80;
  --destructive-foreground: #101522;
  --success: #7fd39a;
  --success-foreground: #101522;
  --warning: #f2c66d;
  --warning-foreground: #101522;
  --chart-1: #8fb4ff;
  --chart-2: #d99bdf;
  --chart-3: #f59984;
  --chart-4: #c1b85c;
  --chart-5: #4acdbd;
  --picture-filter: none;
  --radius: 12px;
  --font-body: "Inter Variable", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  --control-height: 2.75rem;
  --row-height: 4rem;
  --cell-padding: 1rem;
  --card-padding: 1.5rem;
  --motion-fast: 120ms;
  --motion-slow: 180ms;
  --motion-ease: cubic-bezier(0.2, 0, 0, 1);
  --motion-distance: 6px;
  --landing-motion: none;
  --hero-motion: none;
  --font-heading: "Inter Variable", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  --font-labels: "Inter Variable", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  --label-case: none;
  --label-tracking: normal;
  --heading-weight: 700;
  --heading-tracking: -0.02em;
  --heading-scale: 1;
  --heading-case: none;
  --heading-align: start;
  --heading-inline: 0;
  --card-shadow: 0 1px 3px rgb(0 0 0 / 0.08), inset 0 1px 0 color-mix(in oklab, white 22%, transparent);
  --card-border: 1px;
  --card-border-color: color-mix(in oklab, var(--foreground) 12%, transparent);
  --card-surface: color-mix(in oklab, var(--card) 65%, transparent);
  --card-blur: blur(14px) saturate(1.2);
  --band-step: 12%;
  --texture: none;
  --section-background: transparent;
  --section-border: 0;
  --section-gap: 0;
  --divider: var(--border);
  --button-radius: calc(var(--radius) - 2px);
  --button-weight: 600;
  --picture-radius: initial;
  --picture-frame: 0;
  --table-numbers: normal;
  --row-divider: var(--divider);
  --row-stripe: transparent;
  --hover: color-mix(in oklab, var(--foreground) 7%, transparent);
  --primary-hover: color-mix(in oklch, var(--primary), black 20%);
  --destructive-hover: color-mix(in oklch, var(--destructive), black 20%);
}

/* Touch screens get 44 px targets whatever the density. */
@media (pointer: coarse) {
  :root {
    --control-height: 2.75rem;
  }
}

/* A visitor who asks for less motion gets none, whatever the theme says. */
@media (prefers-reduced-motion: reduce) {
  :root {
    --motion-fast: 0ms;
    --motion-slow: 0ms;
    --motion-distance: 0px;
    --landing-motion: none;
    --hero-motion: none;
  }
}

:root[data-appearance="dark"] {
  --background: #101218;
  --foreground: #eef0f5;
  --card: #191b21;
  --card-foreground: #eef0f5;
  --primary: #8fb4ff;
  --primary-foreground: #101522;
  --secondary: #1e2026;
  --secondary-foreground: #eef0f5;
  --muted: #1a1d23;
  --muted-foreground: #979a9f;
  --accent: #1f2533;
  --accent-foreground: #eef0f5;
  --border: #494b52;
  --input: #494b52;
  --ring: #8fb4ff;
  --sidebar: #191b21;
  --sidebar-foreground: #eef0f5;
  --destructive: #f08a80;
  --destructive-foreground: #101522;
  --success: #7fd39a;
  --success-foreground: #101522;
  --warning: #f2c66d;
  --warning-foreground: #101522;
  --chart-1: #8fb4ff;
  --chart-2: #d99bdf;
  --chart-3: #f59984;
  --chart-4: #c1b85c;
  --chart-5: #4acdbd;
  --picture-filter: none;
  --hover: color-mix(in oklab, var(--foreground) 10%, transparent);
  --primary-hover: color-mix(in oklch, var(--primary), white 30%);
  --destructive-hover: color-mix(in oklch, var(--destructive), white 30%);
}

/* The theme has one mode (modes: dark): no appearance to choose. */
[data-part="appearance"] {
  display: none;
}
"
`;

